    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה קרא עליו הנה בן נולד לבית דוד יאשיהו שמו וזבק עליך את כהני הבמות המקטירים עליך ועצמות ירבעם ישרכ עליך אין כת כאן אלא ועצמות אדם מלמד שחלק כבוד למלכות הקבה שנ והי כשמיע המלך ר הונא בשם ראידי אמ חם הקבה על כבודו של צריק יותר מרבורו ירבעם עימד ומהד יבלעא ולאיבשהיו כיון ששלח ידו ללהה ותיבש ידו אשר שלח אליו ותגן המלך ויאמר אל אישי האלהים הל נא את פני יי אלהיך התפלל בעדי תרין אמוראין חד אמ אלהיך ולא אלהיו וחרנא אמ באלו פנים יהיה קורא אלהיו אעלכ ויחל איש האלהים את פני יי ותשב יד המלך אליו ותהי כבראשונה מהו כבראשונה ר ברכיה אמ ור יהודה בר סימוק בשם ר יהושע בן לוי אם הכתוש את האויל במכתש כחמור של חרשים אין אתה מועיל ממנו כלום מה בראשונה עומד ומקריב לען אף באחרונה כן דא כסף נבחר לשון צדיק זה הקבה שהבחיר את עולמי למשה ואמ כי תשא את ראם בני ישראל מה כת למעלה מן הענין וכפר אהרן על קרנותיו אחת בשנה מה כת בתריה כי תשא את ראש"@he ;
    oa:hasSelector opp:unit_fol_89r_1_u1_selector ;
    oa:hasSource opp:passage_fol_89r_1 .

opp:unit_fol_90v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_90v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בנו לפדגיג והיה מציה אותו אומד לו אכל ברי שתה ברי אזל ברי לכי ספרא אתא ברי מבי ספרא כך הבה מתאוה להזכיר את ישראל בכל שעה אמ ר יהודה בר סימין משל לאחד שהיה יושב ועושה עטרה עבר אחד וראה חותו ואמ לו מה אתה עושה אמ לו עטרה למלך אמ לו כל מהד שאתה יכול לקבוע בה קבע אזמרגדים אבנים טובות ומרגליות שהיא עתידה להנתן בראשו של מלך כך אמ הקבה למשה משה כל מה שאתה יכול לשבח את ישרש לפני שבח לפארן פאר שאני עתיד להתפאר בם שנ ויאמר אלי עבדי אתה ישראל אשר בך אתפאר לפקודיהם אמ ר יהושע בר נחמיה אמ הקבה למשה מנה את ישראל אמ משה לפני הקבה רבונו של עולם כת והיה זרעך כעל הארץ והרביתי את זרעך ככוכבי השמים ואומ והיה מספר בני ישראל כחול הים אשר לח ימד ולא יספר ואתה אומר לי"@he ;
    oa:hasSelector opp:unit_fol_90v_1_u1_selector ;
    oa:hasSource opp:passage_fol_90v_1 .

opp:unit_fol_91r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_91r_1#u1" ;
    opp:closestWitness opp:work_Bamidbar_Rabbah,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והדין כי תשא את ראשבני ישראל ר מנחמא ור ביבי ור חייא רבה בשם ר אליעזר בן יעקב אומ נמשלו ישראל בחול מה החול הזה את עושה בו גומא מבערב ובשחרית אתה מוצא אותה שנתמלאת כך כל אלפים שחסרו ישראל בימי דוד אימתי נתמלאו במי שלמה שנ יהודה וישראל כחול אשר על שפת הים לרוב אובלים ושותים ושמחים ר אלעזד בשרר יוסי בן זמרא אמ כל זמן שנמנו ישראל לצירך לא חסרו שלא לצורך חסרו ובאי זה זמן נמנו לצורך בימי משה שלא לצורך בימי דוד אמ ר שמואל בר נחמני בשם ר יונתן ונתנו איש כפרננשו בימי משה ולא יהיה בהם נגף בימידוד זה יתנו אמ ר מאיר כמן מטבע של אש הוציא הקבה מתחת כסא הכבוד שלו והראהו לו למשה ואמ לו זה יתנו כזה יתנו כל העובר ר יודן ור נחמיה ר יודן חמ כל דעבר בימא יתן כך ור נחמיה חמ כל דעבר על ס כומייא יתן מחצית השקל ועו ר יודן ור נחמיה ר יודן אמ לפי שחטאו בחצי היום לפיכך"@he ;
    oa:hasSelector opp:unit_fol_91r_1_u1_selector ;
    oa:hasSource opp:passage_fol_91r_1 .

opp:unit_fol_91v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_91v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Jerusalem_Talmud ;
    rdf:value "גרמסין אמ ר יהושע בר נחמיה בשם רבן יוחנן בן זכאי לפי שעברו על עשרת הדברות לפיכך יהא כל אחד ואחד מהם מביא עשרים גרה ר ברכיה ור לוי אמ בשם ר שמעון בן לקיש לפי שמכרו בכורה שלרחל בעשרים כסף לפילך יהא כל אחד ואחד פודה בנו בכור בעשרים כסף ר פנחס בשם ר ליי אמ לפי שמכרו בכורה של רחל בעשרים כסף ונפל לכל אחד מהם טבע לפיכך יהא כל אחד מהם מביא שקלו טבע אמ ר יה ודה בר סימון בשם ר יוחנן גדברים שמע משה מפי הגבורה ונרתע ונבהל לחחוריו א בשעה שאמ לו ועשו לי מקדש אמי משה לפני הבה דבונו של עולם כת הנה השמים ושמי השמים לא יכלכלוך אף כי הבית הזה אשר בניתי ואתה אומ ועשו לי מקדש אמ לו הקבה משה לא"@he ;
    oa:hasSelector opp:unit_fol_91v_1_u1_selector ;
    oa:hasSource opp:passage_fol_91v_1 .

opp:unit_fol_94r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_94r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma_Buber ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "התירה שנ לא יהיה לך בכיסך אבן ואבן גדולה וקטנה ואם עשית כן מלכות באה ומתגרה באותו הדור מאי טעמיה כי תועבת אלהיך כל עושה אלה מה כת בתריה זכוראת אשרעשה לך עמלק ר לייפתא גערת גים אבדת ירשע שמם מחית לעולם ועד גערת גוים זה עמלק שנאמ ראשית גוים עמלק אבדת רשע זה עשו הרשע דכת ביה וקראו להם גבול רשעה אם יאמר לך אדם אף יעקב בכלל היה אמור לו אבדת רשעים אין כת כאן אלא אבדת רשע זה עשו הרשע שמם מחית לעולם ועד ההד תמחה את זכר עמלק והשב לשכינינו שבעתים ר יודן בר גדיאי ור יהושע בן לוי ורבנן ר יודן בר גדיא אמ יזכר להם מה שעשולנו במילה שהיח נתונה בחיקו של חדם ואתיא כי האי דאמ ר חננא שלקא ור יהושע דסכנין בשם ר לוי ומה הי של ביה עמלק נושין היו מחתכין מיליתיהם של ישמ ומזרקין אותן כלפי למעלן ואומ בזה בחרת הא לך מה שבחר ור יהושע בן לוי אמ זכור להם"@he ;
    oa:hasSelector opp:unit_fol_94r_1_u1_selector ;
    oa:hasSource opp:passage_fol_94r_1 .

opp:unit_fol_95r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_95r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ור נחמיה קראך ודאי וודאימה שעשה עמלח ירד לו לבית ארגיון של מצרים ונטל טמסיהם שלישבטי שהיה שמם חקוק עליהם ובא ועמד לוחוץ לענן והיה קורא ראובן שמעון לוי ויהודה ואומר להון אחוכון אנא פוקו דאנא בעי למעבד פרקמט א עמכון כיון שהיה אחד מהם יוצא אל הם היו מזנבין אותו ורבין םאמ היקרן לפני אומות העולם אמ ר הונא משל לאמבטי רותחת שלא היתה בריה יכולה לדור בתוכה ובא בן בליעל אחד וקפץ וירד לתוכה אעפ שנכוה הוא אלא הקירה לפני אחרים כך כיון שיצאו ישראל ממשצרים ניטלה אימתן של ישראל על כל אומות העולם שנ אזנבהלו אלופי אדום תפל עליהם אימתה ופחד וכיון שבא עמלק נזדווג להם אעפ שנטל את שלו מתחת ידיהם אלא הקירן לפני אומות העולם ויזנב בך הכה אותם מכת זנב ואתיא כי האי דאמ ר חיננא בר שלקא אמ ר יהושע דסכנין ור לו בשםר יוחנן ומה היו עושין של בית עמלק היו מחתכים מילותיהם יישראל ויממרקין כלפי מעלה ואומ להם בזו בחרת הח לך מה שבחרת לפי שלח היו ישראל יודעםמה טיבה של זמורה אלא והנם שולחים את הזמורה אל אפם"@he ;
    oa:hasSelector opp:unit_fol_95r_1_u1_selector ;
    oa:hasSource opp:passage_fol_95r_1 .

opp:unit_fol_95r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_95r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "להם וממילמדה מעשוזקנו שנאמת אמר הכ קרא שמו יעקב י חיך חיך בגרונו והוצוא את כל הזמורה כל הנחשלים אחריך ר יהודה ור נחמיה ר יהודה אומ כל מי שהיה נימח היה נחשל ור נחמיה אמ כל מי שהיה הענן פולעו היה נישול ורבנן אמ זה שבטו שלדן שפלטו הענן שהיו בלם עובדי עז דא כל הנחשלים אחריך אמ ר יצחק מהו כל הנחשלים אחריך ר יהודה ור נחמיה אמ שאמרו ישראל אם רבנן הוא על כל המעשים כדרך שהוא דב העולם נעבדנו ואם לאו נמרודבו ור נחמיה אמ ישאמרו אם מספיק לנו אתמזונותינו כמלך שהוא שרוי במוינהא ואין המדינה חסרה כלום נעבדנו ואם לאו לא נעבדנו ונמרוד בו ורבנן אמ אם מסיחים אנו בלבבנו והוא יודע מה שאנו משיחים נעבדנו ואם לאו נמרודבו אמ ר ברכיה בשם ר לוי בלבם היו משיחים אם יתן להם את שאלתם דמאי טעמיה וינסו א בלבבם ולשאל אכל לנפשם מה כת תמן ויאכלו וישבעו מאר ואתה עיף ויגע עיף בצמא ויגע בדרך ולא ירא אלהים אמ ד פנחט בשםר שמואל בר נחמני מסורת אגדה היא שא יזנשו טפל אלא ביד בני בניה שלרחל שנ אם לא יסחבום צעירי רצאן שהיו קטניהם של"@he ;
    oa:hasSelector opp:unit_fol_95r_2_u1_selector ;
    oa:hasSource opp:passage_fol_95r_2 .

opp:unit_fol_98r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_98r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "וכיון דאתון לגבי מעגל אמ לו הלא תעלה אבנר בכנף המעיל אמרת בסירא הועדת וכאן חנית וצפחת בסירא הועדו וישאומ על ידי שהיתה ספיקה בידו למחות בנוב עיר הכהנים ולא מיחה ר חנן בן פזי פתר קריא בפרשת פדה אדמה שיש בה משבעה שבעה שבע פרות שבע שריפות שבע הזיות שבע כבוסים שבעה טמאים שבעה טהורים י שבעה כהנים אם יאמר לך אדם חסרהם אמוד לו אף משה ואהרן היו בכלל שנ וידבר יי אל משה ואל אהרן לאמר זאת חקת התורה ר יצחק פתח כל זו נסיתי בחכמה כת ויתן אלהים חכמה לשרמה ר לויורבנן אמ נתן לו חכמהל כנגד כל ישראל אמ ר לוי מה החוד הזה גדר לים כך היתה חכמה גדרה לשלמה מתלא אמרה דיעה קנית מה חסרת דיעה חסרת מה קנית עיד פרצה ואין חומה אנש אשר אין מעצר לרוחו יכעיר פרוצה ואין חומה כן איש אשר אין מעצר לרוחו כת ותרב חכמת שלמה מחכמת כל בני קום ומה היתה חכמתן של"@he ;
    oa:hasSelector opp:unit_fol_98r_1_u1_selector ;
    oa:hasSource opp:passage_fol_98r_1 .

opp:unit_fol_99v_2_u2 a opp:TextUnit ;
    rdfs:label "fol_99v_2#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ועל הדגים וכי אפשר לאדם כשלמה לדבר על הדגים אנא אמ שלמה מפני מה בהמה וחיה ועום טעונים שחיטה והורה יעקב איש כפר נבוריא בצור על הדגים שטעוניא שחיטה שמע ר חגי ואייתוניה אמ ליה מנן הורית כדין אמ ליה מן הדאדכת ישרצו המים שרץ נפש חיה מה עופות טעונין שחיטה אף דגים טעונין שחיטה אמ ארבעונייה וילקה אמ בר נשדאמ מולי דאוריתא ילקה אמ ליה דלא הורית טבות אמ ליה מנחן אמ ליה מן הדין דכת הצאן ובקר ישחט לקם ומצא להם אם את כל דגי הים ישחט להם אינו אומ אלא יאסף להם אמ ליה חבוט חביטך דהיא טבא בקולטא עוד הורה יעקב איש כפר נבוריא בצור על בנה שלגכרית שהוא נמול בשבת שמע ר חגי שלח ואיתיניה אמ ליה מנן הורית דין אמ ליה מזהדא דכת ויתילדו על משפחות ואומ ובן שמנת ימים ימול לכם כל זכר"@he ;
    oa:hasSelector opp:unit_fol_99v_2_u2_selector ;
    oa:hasSource opp:passage_fol_99v_2 .

