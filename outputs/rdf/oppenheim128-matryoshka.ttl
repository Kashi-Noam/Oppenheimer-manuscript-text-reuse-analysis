    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר תנחום בר יודן ותני לח כל ן ימי המלואים היה משהה משמש בכהונה גדולה ושרתה שכינה על ידיו ההד כי היום יי נראה אליכם קוראים אל יי והוא יענם זה קורא ונעננה ואה סורא וננעננה שנ בנמור ענן הבר אליהם שמענו במשה שנדבר עמו בעמוד ענן שנ וירד יי בעמיד ענן וכן וירד יי בענן ויתיצב עמישם ובאהרן נדבר עמו בענן שנא וירד יי באהל בעמוד ענן ויעמד פתח האהל אבל בשמואל לא שמענו ומהילן שמענו מן הדין קרא ותענינה אותם ותאמרנה יש ר יהודה בשם ר מרי בר יעקב אמ אמרו להם הנשים אין אתם רואים ענן שהוא קשור למעלן מחצירו ואין יש אלא ענן כדא וישאשר יהיה הענן ימים מספר נשמרו עדותיו וחת נתן למו שמענו במשה שנכתבה תורה לשמו דכת זכרו תורת משה עבדי ובשמואל נכתב לו ספרו שנ ויכתב בספר וינח לפני יי אבל באהרן לא שמיגנו אנא מלמד שניתנה לו פרשה זו שלא תזוו מבניו ודר ממנו ולא מבניו ולא מבני בניו עד סוף כל הדורות ההד זאת חקת התורה ר יהושע דסכני בשם ר לוי אמ ד דברים יצרהרע משיב עליהם ובכלם כת בהם חקה"@he ;
    oa:hasSelector opp:unit_fol_102r_2_u1_selector ;
    oa:hasSource opp:passage_fol_102r_2 .

opp:unit_fol_104r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_104r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דא פרה אלו ישראל שנ כי כפרה סורר סרר ישראל אדמה אלו ישראל שנ אדמועצם מפנינים תמימה אלו ישראל שנ יונתי תמתי אשר אין בה מום אלו ישראל שנכלך יפה רעיתי ומום אין בך אשר לא עלה עליה עול זה דורו של ירמיה שלא קבלו עליהם עולו של הקבה ונתתם אותה אל אליסר הכהן זה ירמיה שנ בו מן הכהנים אשר בענתות והוציא אותה אל מחוץ למחנה ההד ועמה קגלי לבבל ושחט אותה לפניו יואת בני צדקיהו שחט לעיניו ושרף את הפרה לעיניו שנ וישרף את בית יי ואת בית המלך את עורה ואת בשרה ואת דמה על פרשה ישקף ואת כל בתי ירושלם ואת כל בית גדול שרף באש ולמה הוא קורא אותו בית גדול זה בית מדרשו של רבן יוחנן בן זכאי ששם היו מתנים גדולתו של הקבה ולקא זה נבוכד נשצר הרשע ועץ ארז ואזוב ושני תולעת אלו חנניה מישאל ועזריה והשליך אל תוך שרפת הפרה קטיל המון שביבא דינורא ואסף זה הקבה שנ ונסא נס לגוים ואסף נדחי ישראל איש זה הקבה דכת ביה יי איש מלחמה יי שמו טהור זה הקבה שנאמר בו טהור עינים מראות ברע"@he ;
    oa:hasSelector opp:unit_fol_104r_1_u1_selector ;
    oa:hasSource opp:passage_fol_104r_1 .

opp:unit_fol_104v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_104v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "את אפר הכרה אלו גליותיהם של ישראל והניח מחוץ למחנה במקום טהור זה ירושלם שהיא טהורה והיתה לעדת בני ישראל למשמרת לפי שבעולם הזה יש מטמאין ומטהרין על פיכהן אבל לעתיד לבא הקבה עתיד לטהרן מאי טעמ שנ וזרקתי עליכם מים טהורים וטהרתם הקץ הזה לכם עשה ירח למועדים שמש ידע מבאו אמר יוחנן לא נברא להאיר אלא גלגל חמה שנ יהי מאויות מארת כת אם כן למה נבראת לבנה אלא לחדש בו חדשי וראשי שנים ר שילא אמ דככר תמרתא בשם ר יוחנן אעפנ שמי רנמכאויי מיכא שאן מונין ללסה ילו זם נ ש שקעה החמה יום טיחברא בשם ר ברכיה אמ כת ויסעו מר עמסס בחדש הראשון בחמשה עשריום אם ללבנה אתה מונה עד כאן לית לן בה אלא ארבעה עשר"@he ;
    oa:hasSelector opp:unit_fol_104v_1_u1_selector ;
    oa:hasSource opp:passage_fol_104v_1 .

opp:unit_fol_104v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_104v_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "הזה לכם עשה ירח למועדים שמש ידע מבאו אמר יוחנן לא נברא להאיר אלא גלגל חמה שנ יהי מאויות מארת כת אם כן למה נבראת לבנה אלא לחדש בו חדשי וראשי שנים ר שילא אמ דככר תמרתא בשם ר יוחנן אעפנ שמי רנמכאויי מיכא שאן מונין ללסה ילו זם נ ש שקעה החמה יום טיחברא בשם ר ברכיה אמ כת ויסעו מר עמסס בחדש הראשון בחמשה עשריום אם ללבנה אתה מונה עד כאן לית לן בה אלא ארבעה עשר משתשקע החמה מכאן שזין מונין ללבנה אלא אם כן שקעה החמה ר עזריה בשם ר חנינא אמ לאנברא להאיר אנא גלגר חמה בלבד שנ יהי מאורות מארת כת אם כן למה נבראת לבנה אלא צפה הקבה שאומות העולם עתיד לעמו ולעשותן אליהות"@he ;
    oa:hasSelector opp:unit_fol_104v_1_u2_selector ;
    oa:hasSource opp:passage_fol_104v_1 .

opp:unit_fol_106r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_106r_2#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ועץ חיים תאוה באה זה שחזל שמיד שנמשח מלך ובזרות מי מלך בזכות מעשים טובים שהיו בידו שהיה שפל רוח ושהיה אוכל חוליו בטהרה ושהיה מבזבן את מטונו בשב ל לחים על ממינן של ישרזנ יששקל ככוו עב דו כבנודיו אמ ר יהודה בר נחמני בשם ר שמעין בן לקיש שהיה בן תורה שנ בי שרים ישורו ורוזנים יחקקו צדק תני ר ישמעאל עד שלא יחטא אדם נותנים לו אימה וירא ה וכיון שהוא חוטא נותנין עליו אימה ויראה אדם הראשון עד שלא חטא היה שומע את הקול אומירון וכיון שחטא היה שומע את הקול פיגריאון עד שר חטא אדם הראשון היה שומע את הקול ועומד לו על רגליו ההד וישמעו את קול יי אלהים מתהלך בנן אמ ר אבא בר כהנא מהלך אין כת כאן אלא מתהלך ומקפץ וסליק וכיון שחטא היה שומע את הקול ומת חבא שנ ויתחבא האדם ואשתו אמ ר איבו באותה שעה גבהה קומתו של אדם הראשון ונעשית שלמאה אמה עד שלא חטאו זישראל מה כת בהם ומראה כבוד יי כאש אוכלת לעיני בני ישראל חמ ר יבא בר כהנא ז מחיצות של אש היו כוססות זו בזו והיו ישראל רואין ולא מתייראין ולא מתפחדין"@he ;
    oa:hasSelector opp:unit_fol_106r_2_u1_selector ;
    oa:hasSource opp:passage_fol_106r_2 .

opp:unit_fol_106v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_106v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "וכיון שחטאו אפי פני הסרסור לא היו יכולין להסתכל ההד וייראו מגשת אליו אמ ר פנחס ור חנן בשם ר אבין אף הסרטור הרגיש בעבירה שנ מלכ צבאות ידודון ידודון אמ ר יודן בשם ר איבו מלאכי צבאות אין כת כאין אלא מלכי צבאות מלכיהון דמלאכיא אפי מיכאל אפי גבריאל לאהיו יכולין להסתכל בפניו של משה וכיון שחטאו ישראל אפי פני הגליארין לאהיה יכול משה להסתכל שנ כי יגרתי מפני האף וה והחמה עד שלא אירע אותו מעשה לדוד מה כת בו י אוריה וישעי ממי אדא וכיון שאירע לו אותו מעשה מה כת כו ואבא עליו והוא ינע ורפה ידים עד שלא חטא שלמה היה רודה בשדים ובשדות ההד עשיתי לי שרים ושרות ותענוגות בני אדם שדה ושדות ומהו שדה ושדות שהיה רודה בשדים ובשרות וכיון שחטא הביא לו ס גבורים שומרים את מטתו ההד הנה מטתו שלשלמה ששים גבורים סביב לה מגבורי ישראל עד שלא חטא שאול מה כתוב בו ושאול לכד המלוכה על כל ישראנ וילחם סביב בכל אויביו וגו ואומ ובכל אשר יפנה יורשי מהו ידשיע מנצח וכיון שחטא מה כתוב בו וירא שאול את מחנה פל שתים ויירא ויחרד לבו מאד"@he ;
    oa:hasSelector opp:unit_fol_106v_1_u1_selector ;
    oa:hasSource opp:passage_fol_106v_1 .

opp:unit_fol_107r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_107r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דא תוחלת ממושכה מחלה לב אמר חייא בר אבא אלו ישראל עד שלאנגאלו אתה מיצא כיון שבאמשה אצל ישראל ואמ להם שאמ לו הקבה שיאמר לישראל בשמו פקד פקדתי אתכם אמרו לו רבינו משה אדין פקידה מה כחי כי אייחל ומה קצי כי אאריך נפשי אם כח אבנים כחי אם בשרי נחוש אם כחם של אבנים הוא ח כחנו אם בשרנו של נחשת היא וכיון שאמ להם בחדש הזה אתם נגאלים אמרו לו בסימן טב הוא ועץ חיים תאוה באה ההד החדש הזה לכם ראש חדש ר יהודה בר נחמני בשם ר שמעון בן לקיש פתח שכח אורך ואמתך המה ינחוני שלח אריך משה דכהוב ביה ומשה לא ידע כי קרן עיר פניו ואמתך זה אהרן ישנ תורת אמת היתה בכיהו ואית דאמ תמיך ואוריך לאיש חסיריך דא ואמתך זה משה שנ לא כן עבדי משה בכל ביתי נאמן הוא אמ ר יצחק מן הים צפה משה שאינו נכנס עם ישראל לארץ ישראל שנאמ צופיה הליכות ביתה תביאנו ותניענו אין כת כאן אלא תביאמו יתטעמו והאכתו יביאוני אל הל קדשך ואל משכנותיך אלא אלו מיוסרי ארץ ישראל שהם קדושים בארץ"@he ;
    oa:hasSelector opp:unit_fol_107r_1_u1_selector ;
    oa:hasSource opp:passage_fol_107r_1 .

opp:unit_fol_108r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_108r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר יהודה ורבנן ר יהודה אמ קול דודי וכו זה ב משה בשעה שבא ואמ לישראל בחרש הזה אתם נגמלים אמרו לו רבינו משה היאך אנו נגאלים לא כך אמ הבה לאבינו אברהם ועבדום וענו אותם ארבע מאות שנה והלא אין בידינו אלא רי אמ להם הואיל והואחפץ בנאלתכם אינו מביט בעז שלכם אלא מדלו על ההרים מקכץ על הגבעות מדלג על הקצים ועל החשבונות ועל העבורי ובחדש הזה אתם נגאלים ההד החדש הזה לכם ראש חדשים ר נחמיה אמ קול דודי הנהזה בא זה משה בשער שבא ואמ לישראל בחדש א הזה אתם נגאלים אמרו לו רבינו משה היאך אנו נגאלים וארץ משצרים מלאה בלולים ומטונפת בעז שלנו אמ להם הואיל והואחפץ בגילתכם אינו מביט בעז שלכם אלא מדלג על ההרים מקפץ על הגבעות ואין הרים ונבעית אלא עז שנ על ראשי ההרים יזבחו ועל הגבענת יקטרו ורבנן אמ קול דודי הכהנה הנה זה בא זה משה בשעה שבא ואמ לישראל בחדש הזה אתם נגאלין והם אומרים לו רבינו משה היאך אנו נגאלים ואין בידינו מעשים טובים אמ להם הואיל והוא חפץ בגאולתכם אינו מביט במעשיכם הרעים"@he ;
    oa:hasSelector opp:unit_fol_108r_2_u1_selector ;
    oa:hasSource opp:passage_fol_108r_2 .

opp:unit_fol_109r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_109r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ומן הים לסיני במצרים ראו אותי שנ ועברתי בארץ מצרים בלילה הזה בים ראו אותי שנ וירא ישראל את היד הגדולה בסיני ראו אותי שנ ויאמר יי מסיני בא או לעפר האיכים אמ ר יוסי בר חנינא לעוז אלהין דאיילתא הנה זה עמד אחרכתלנו שנ כי ביום השלישי ירד יי משגיח מן החלינות שנ וירד יי על הר סיני אל ראש ההר מציץ מן החרכים בשה שאמ יי אנבי יי אלהיך ענה ודודי ואמר לי מה אמר לי אנכי יי אלהיך דא דומה דודילצבי אמ ר ינדק מההנבי הזה מקנן ותלוי מחלן לא נן ומסוכה לחוכה ומגדר לגדר כך הרבה מדלר מבית כנסתאו ומבית מדרש זה לבית מדרש זה בשביל מה בשביל לברך את ישראל ובזכות מי בזכות מי שהיה יושב באלוני ממרא ההד וירא אליו י באלוכי ממרא אמ ר ברכיה בשם ד לוי והוא יושב ישבכתוב אמ הקבה שב וכל זמן שבניך נבנסין בבתי כנסיות ובבתי מדרשות יהיו יושבים וכבודי עומד עמהם ומה טעמיה אלהים כצב בעדת אל אמר חגי בשם ר יצחק אלהים עימד אן כתוב כאן אלא אלהים נצכ אטמוס אמ ר שמואל בר חייא ור יהודה בשם ר חנינא כל קילום וקילום שישראל מקלסן להקבה כבגרו יושב ביניהם"@he ;
    oa:hasSelector opp:unit_fol_109r_1_u1_selector ;
    oa:hasSource opp:passage_fol_109r_1 .

