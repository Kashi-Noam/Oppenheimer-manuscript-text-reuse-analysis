opp:unit_fol_80r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_80r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "עשה להם כמן טגן שלנחשת ועשה אותם נקבים נקבים ות ונתנם לתוכו והתחילו לחמם תחתיהם כיון שראו בצרתן צעקו שינתן עמהם יהושע בן יהוברק שלישו אמרו בדד זכותיה נשתזיב הם נשרפו והוא ניצול ועליו הכת אומ הלא זה אוד מוצל מאש ההד ולקח מהם קללה לכל גלות יהודה אשר בבבל לאמר ישימך יי כאפ לצדקיהו וכאחב אשר קלם מלך בבל באש מהו קלם כקליות"@he ;
    oa:hasSelector opp:unit_fol_80r_1_u1_selector ;
    oa:hasSource opp:passage_fol_80r_1 .

