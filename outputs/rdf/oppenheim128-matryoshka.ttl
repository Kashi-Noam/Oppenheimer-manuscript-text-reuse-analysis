opp:unit_fol_30v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_30v_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "אלה בני עשו ואלה אלופיהם את מוצא שלשה עשר אלופים כתובים כאן כנגד שלשה עשר שבטים בני יעקב שכן כתוב אפרים ומנשה כראובן ושמעון יהיו לי וכשם שאתה מוצא בבני יעקב שהם ארבעה עשר עם יוסף ואינן עולין אלא למנין שלשה עשר שבטים כן אתה מוצא באלופי בני עשו שהם ארבעה עשר ואינן עולין אלא למנין שלישה עשר שאותו קרח אלוף אליפז הוא אלוף קרח שלבני עשו ללמדך כמה שכד גדול פרע הקבה לעשו על שכבד אביו ואלמלא לא יצא לתרבות רעה היה שוה ליעקב בכל הוא אדום הוא ברשעו מתחלה ועד סוף וימת בלע וימלוך תאתיו יובב בן זרח מבצרה ההד מי זה בא מאדום חמוץ בגדים מבצרה מהו מי זה לעתיד לבא הולך הקבה לעשות נקמה באדום הוא בעצמו"@he ;
    oa:hasSelector opp:unit_fol_30v_1_u1_selector ;
    oa:hasSource opp:passage_fol_30v_1 .

opp:unit_fol_30v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "121"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_30v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_30v_1#u2" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "שכן כתוב אפרים ומנשה כראובן ושמעון יהיו לי וכשם שאתה מוצא בבני יעקב שהם ארבעה עשר עם יוסף ואינן עולין אלא למנין שלשה עשר שבטים כן אתה מוצא באלופי בני עשו שהם ארבעה עשר ואינן עולין אלא למנין שלישה עשר שאותו קרח אלוף אליפז הוא אלוף קרח שלבני עשו ללמדך כמה שכד גדול פרע הקבה לעשו על שכבד אביו ואלמלא לא יצא לתרבות רעה היה שוה ליעקב בכל הוא אדום הוא ברשעו מתחלה ועד סוף וימת בלע וימלוך תאתיו יובב בן זרח מבצרה ההד מי זה בא מאדום חמוץ בגדים מבצרה מהו מי זה לעתיד לבא הולך הקבה לעשות נקמה באדום הוא בעצמו ולא יודיע מהלכו למלאכי השרת באותה שעה עומדין מלאכי השרת ומבקשין להקבה לומד שירה לפניו יוא ינן מוצאין אותו הולכין אצל הים אומרין לו נראה לך הקבה שנ הנותן בים דרך ואומר להם מיום שיבש"@he ;
    oa:hasSelector opp:unit_fol_30v_1_u2_selector ;
    oa:hasSource opp:passage_fol_30v_1 .

opp:unit_fol_30v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "156"^^xsd:nonNegativeInteger ;
    oa:start "18"^^xsd:nonNegativeInteger .

opp:unit_fol_31r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_31r_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "והעביר בניו בתוכו שוב לא ראיתיו הולכין אצל סיני אומרין לו נראה לך הקבה שנאמ יי מסיני בא אמ להם מיום שנגלה עלי ונתן תורה כיבניו והיה הוא חתן ומשה שושבין ותורה כלה שוב לא ראיתיו הולכין אצל ציון נראה לך הקבה שנאמ כי בחר יי בציון אומר להם מיום שחילק שבי ממני והחריב ביתו ושרף היכלו שוב לא ראיתיו פוגע בהם ישעיה אומר להם ישעיה את מי אתם מבקשים אומרין לו הקבה אנו מבקשין אומר להם עכשו יבא ויצא מאדום ההד מי זהבא מאדום חמוץ הקבה יפרע מהם על שגזלו ממונם של ישראל ואין חמוץ אלא לשון גזל כד מכף מעול וחומץ מהו שאמ דכת חמוץ כביכול כל הגוזל ישראל כאלו גוזל את השכינה שכן כת עמו"@he ;
    oa:hasSelector opp:unit_fol_31r_1_u1_selector ;
    oa:hasSource opp:passage_fol_31r_1 .

opp:unit_fol_31r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "119"^^xsd:nonNegativeInteger ;
    oa:start "1"^^xsd:nonNegativeInteger .

opp:unit_fol_31r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_31r_2#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "בצרה מכל עיירות אדום אלא בשעה שידון הקבה את אדום יבא סמאל שר של רומי בראש פומליא של רומי ואומר לפני הקבה יש לי שכר עם הצדיקים שטובות גדולות עשיתי עם ישראל אומר לו הקבה ומה הם הטובות שעשית עם בני אומר לפניו רבונו של עולם הרבה דרכים ושווקים ומרחצאות וגשרים תקנתי להם באותה שעה אומר לו הקבה שוטה שבעולם כל מה שעשה נא עשית אלא להכשילם תקנת מרחצאות העמדת בהם עז דרכים העמדת בהם לסטים שוקים הושבת בהם זונות גשרים הושבת בהם מוכסים ולא עוד אלא שגזלת להם כל מה שהיה בידם בכל יום ויום עד שנשארו ריקים מכל טוב אומר סמאל לפני הקבה רבון העולמים אם ממון גזלנו מהם עלינו ילשלם כד והשיב את הגזילה אשר גזל או את העושק אשר עשק אומר להם הקבה דמי ישראל ששפכתם מה אתם יכולים לשלם עליו ההד מצרים לשמה תהיה ואדום למדבר שממה תהיה מחמכ בני יהודה אשר שפכו דם נקי בארצם מיד מתבייש סמאל ובורח בצרה גדולה נבצרה ולמה יברח לבצרה שיהאסבור שהיא עיר מקלט כד את"@he ;
    oa:hasSelector opp:unit_fol_31r_2_u1_selector ;
    oa:hasSource opp:passage_fol_31r_2 .

opp:unit_fol_31r_2_u1_selector a opp:TokenPositionSelector ;
    oa:end "173"^^xsd:nonNegativeInteger ;
    oa:start "6"^^xsd:nonNegativeInteger .

opp:unit_fol_31v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_31v_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "מיד הולך הקבה אחריו לבצרה ואומר לו רשע טעית בין בצר לבצרה ועוד דכת וכי יזיד איש על רעהו להרגו בערמה מעם מזבחי תקחנו למות ואתה מזיד היית מיד ימסרנו הקבה ביד מיכאל שר של ישראל ומביאו בשלשלאות של ברזל וימסרנו ביד ישראל ועושים בו כרצונם שנ ונתתי נקמתי באדום ביד עמי ישראל לפי שאין הקבה פורע מכל אומה ולשון עד שיפרע משר שקה תחלה שנ יפקוד יי על צבא המרום במרום ועל מלכי האדמה יבאדמה הוי מבצרה זה הדור בלבושו זוה לבוש נקם כד וילבש בגדי נקם אמ הקבה הלבוש הזה נאה מכל מלבושים שלבשתי שלבשתי מעולם צועה ברב כחו כד כי זבח לי בבצרה"@he ;
    oa:hasSelector opp:unit_fol_31v_1_u1_selector ;
    oa:hasSource opp:passage_fol_31v_1 .

