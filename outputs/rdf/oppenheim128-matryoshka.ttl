opp:unit_fol_165r_2_u2 a opp:TextUnit ;
    rdfs:label "fol_165r_2#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לי המקום גשה לי ואשבה ר יוםי בר ירמיה דוסתא בשם ר לוי ואין אתה מה היח שכחה של ירושנם מן הדין קרא דכת ואני אהיה לה נאם יי חומת אש סביב ולכבוד אהיה בתוכה מכאן אתה יודע מה היא שבחה של ירושכם קומי אורי כי בא אורך על כן באורים כבדו יי במה מכבדים אותו אמ ר אבא ברכהם באלין פנסייא ר איבו אמ מאורות שנ ויעש אלהים את שני המאורות הגדו הא כאי זה צדחמה זורחת ומברכיו עליה לבנה זורחת ומברכין עליה ורבנן אמ אמ הבה לישראל בני הואיל ואוריהוא אורכם ואורכם הוא אורי אני ואתם נלך ונאור לציון קומי אורי ר אחא אתח אני יי הוא שמי הוא שמי שקרא לי אדם הראשין הוא שמי שהתניתי ביני לבין מלאכי השרת וכבודי לאחר לא אתן ר מנחם בשם ר אבין השארים ותהלתי לפסילים אמ הקבה כבידי איני נותן לאחר ואתם נותנים תהלתי לפסילים ולמי אני נותנו לביון קומי אורי כי עמך מקורחיים באורך נראה אור"@he ;
    oa:hasSelector opp:unit_fol_165r_2_u2_selector ;
    oa:hasSource opp:passage_fol_165r_2 .

