opp:unit_fol_128v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_128v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אל תרבי תדברו גבוהה יצא עתק מפיכם כיל דעות יי ולו נתכנו עלילו ר אליעזר ור יהושע בן לוי ורבנן אמ באמטתא דמטתון אתמיט לכון באכרעתא דאכרעון אתכרע להון וחרנא אמ בתבשילא דבשלון אתבשל להון כדא ויזד יעקב נזיד ורבנן אמ כמחשבתא דחשבח אתחשב להון כרא וכי יזיד איש עלרעהו עושה משפט לעשוקים נותן לחם לרטבים יי מתיר אסורים עושה משפט לעשוקים אלו ישראל שנ כה אמר יי צבאות עשורד בני ישראל ובני יהודה יחדו כל שוביהם החזיקו בה מאנו שלחם גואלם חוק יי כבאות שמו ריב יריב את ריבם הפה שאמ"@he ;
    oa:hasSelector opp:unit_fol_128v_2_u1_selector ;
    oa:hasSource opp:passage_fol_128v_2 .

