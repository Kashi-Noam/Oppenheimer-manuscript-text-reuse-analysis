opp:unit_fol_47r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_47r_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "אויביהם והם גבורי מלחמה אחד לאלף ושבט שמעון וחצי שבט מנשה בארץ כשדים רחוק מבית המקדש ששה חדשים והם עד אין חקר ואין מספר ולקחים מס מחמשה ועשרים מלכיות ומהצת ישמעאלים יפרעו להם מס אבלי שבט"@he ;
    oa:hasSelector opp:unit_fol_47r_1_u1_selector ;
    oa:hasSource opp:passage_fol_47r_1 .

