opp:unit_fol_58r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_58r_2#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "זו היא שנאמרה על ידי דוד מלך ישראל שנ ישת חשך סתרו כנגדמי אמ דוד מקרא הזה לא אמרו אלא כנגד שבחו של הקבה שהוא שליט בעולמו הוא יחיד אחוד ושמו אחד והוא שוכן בשלש מאות ותשעים רהיעים ורקיע שמו וכנויו נקוד עליהם ובכל אחד ואחד משרתים ושרפים ואופנים וכרובים וגלילים וכסא הכבוד ואל תתמה בדבר זק שהרי מלך בשר ודם יש לו כמה מקומות אחת של חמה ואחת של צנה ועליך להביט בד בר זה על אחת כמה וכמה למלך חי העולמים שהכל שלו וכזמן עישין רצינו של מקום שוכן על ערבות בשבעה רקיעים ואין מתרחק מהם ללום שנ מבין שני הכרובים וידבר אליו ובשעת הכעס עולה ויושב בשמי מרום והכל צועקים ובוכים ואין קולם נשמע וגוזרין צום ומתפל שין באפר ומתבסים בשקים ומורידין דמעות"@he ;
    oa:hasSelector opp:unit_fol_58r_2_u1_selector ;
    oa:hasSource opp:passage_fol_58r_2 .

opp:unit_fol_58r_2_u1_selector a opp:TokenPositionSelector ;
    oa:end "130"^^xsd:nonNegativeInteger ;
    oa:start "4"^^xsd:nonNegativeInteger .

opp:unit_fol_58r_2_u2 a opp:TextUnit ;
    rdfs:label "fol_58r_2#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לא אמרו אלא כנגד שבחו של הקבה שהוא שליט בעולמו הוא יחיד אחוד ושמו אחד והוא שוכן בשלש מאות ותשעים רהיעים ורקיע שמו וכנויו נקוד עליהם ובכל אחד ואחד משרתים ושרפים ואופנים וכרובים וגלילים וכסא הכבוד ואל תתמה בדבר זק שהרי מלך בשר ודם יש לו כמה מקומות אחת של חמה ואחת של צנה ועליך להביט בד בר זה על אחת כמה וכמה למלך חי העולמים שהכל שלו וכזמן עישין רצינו של מקום שוכן על ערבות בשבעה רקיעים ואין מתרחק מהם ללום שנ מבין שני הכרובים וידבר אליו ובשעת הכעס עולה ויושב בשמי מרום והכל צועקים ובוכים ואין קולם נשמע וגוזרין צום ומתפל שין באפר ומתבסים בשקים ומורידין דמעות בן עזאי אומ כל הנותן ארבעה דברים כנגד עיניו ועל לבו שוב אינו חוטא לעולם מאין הוא בא ולאן הוא הולך ומי הוא דיינו ומה עתיה להיות מאין הוא בא ממקום החזשך ולאן הוא הולך לחשך ואפלה מאין הואבא ממקום הטומאה ולאן הוא הולך לטמא את אחרים מאין הוא בה מליחה סרוחת וממקום שאין העין יכולה לראות ולאן הוא הולד לשאול ואבדון לבגיהנם לישרף באור"@he ;
    oa:hasSelector opp:unit_fol_58r_2_u2_selector ;
    oa:hasSource opp:passage_fol_58r_2 .

opp:unit_fol_58r_2_u2_selector a opp:TokenPositionSelector ;
