opp:unit_fol_197r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_197r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "וכן עשו ירמיה בוכה ביום ואומר ארור היום אשר יופדני בו ארור האיש אשר בשר את אבי לאמר יולד לך בן זכר שמח שמחהו אמ הקבה ישראל בוכים בלילה וירמיהו ביום ואני ביום ובלילה לכך נאמר ואבכה יומם ולילה דא מי יתן ראשי מים מהכת למעלה מן הענין כל שבר בת עמי אלולי הכת מדבר כן הלשון שתהיה אומ כן היתה ראויה להקטע אלא קדמו הראשונים שנ וקדמונים אחזו שער משל לבן מלך שבקש להיביה אבן כיון שבא להגביהה נפלה עלו ושברתו שמע המלך שנשבר בנו התחיל אנמ נשברתי אמרו לו בני פלטין שלו בנך נשבר ואתה או נשבי מהו קדרתי שמה החזיקתני משל לחנם שלא ראה אבל מימיו והיה לו בן אחד ומת קרא לתלמידיו אמ להם הראו לי היאך האחרים מתאבלים כך החכם זה הקבה שנ יי בחכה יסד ארץ י כיון שחרבה ציון וירושלם ובית המקדש ועברו ישראל כל אותן"@he ;
    oa:hasSelector opp:unit_fol_197r_1_u1_selector ;
    oa:hasSource opp:passage_fol_197r_1 .

opp:unit_fol_197r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "143"^^xsd:nonNegativeInteger ;
