    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "עמד אבינו אברהם והורידה מן השבעי לששי עמד יכחק וזכה והורידה מן הששילחמשי עמד יעקב וזכה והורידה מן החמשי לרביעי עמד לוי וזכה והורידה מן הרביעי לשלישי עמד קהת וזכה והודה מא השלישי לשני עמד עמרם גזכה והור דת מן השכי ליאשין עמד משה וזכה והורידה לאדרץ לכך נאמ ויהי שום כדות משה"@he ;
    oa:hasSelector opp:unit_fol_84r_1_u1_selector ;
    oa:hasSource opp:passage_fol_84r_1 .

