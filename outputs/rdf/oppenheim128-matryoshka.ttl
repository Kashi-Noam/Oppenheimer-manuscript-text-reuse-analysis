    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_48r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_48r_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "אחת שהיתה יושבת על פתח ביתה ובנה מלוכלך בדם ומוטל לפניה אמ לה בתי בן ל יכדת אמרה ט הן אמ לה מה טבו שמלוכלך ומוטל בדם אמרה לו רעה גדולה שבו ביום שנולד בו ביום נחרב בית המקד אמ לה בתי עמדי והחזיקיבו שכבר תהא להם תשועה גדולה על ידו מיד עמדה והחזיקה בו ונתן לה בגדים להלבישו ותכשיטין לקשטו ולא בקשה לקבל אמ לה טלי ממני ולימים אני בא ואטול את דמיהם הניחו והלך לו חמששנים לאחר חמש שנים"@he ;
    oa:hasSelector opp:unit_fol_48r_1_u1_selector ;
    oa:hasSource opp:passage_fol_48r_1 .

opp:unit_fol_48r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "83"^^xsd:nonNegativeInteger ;
    oa:start "2"^^xsd:nonNegativeInteger .

opp:unit_fol_48r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_48r_1#u2" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "אמרה לו רעה גדולה שבו ביום שנולד בו ביום נחרב בית המקד אמ לה בתי עמדי והחזיקיבו שכבר תהא להם תשועה גדולה על ידו מיד עמדה והחזיקה בו ונתן לה בגדים להלבישו ותכשיטין לקשטו ולא בקשה לקבל אמ לה טלי ממני ולימים אני בא ואטול את דמיהם הניחו והלך לו חמששנים לאחר חמש שנים אמ אלך ואראה מושיען של ישראל אם בדמות מלכים הוא מתגדל או בדמות מלאכי השרת הלך ומבא האש עומדת על פתח ביתה"@he ;
    oa:hasSelector opp:unit_fol_48r_1_u2_selector ;
    oa:hasSource opp:passage_fol_48r_1 .

opp:unit_fol_48r_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "105"^^xsd:nonNegativeInteger ;
    oa:start "29"^^xsd:nonNegativeInteger .

opp:unit_fol_48r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_48r_2#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "לה בתי מה טבו של אותי נער אמרה לו ר לא אמרתי לך גורלו שבו ביום שנולד בו ציום נחרב בית המקדש ולא עוד אלא אפי רגלים יש לו ואינו מהלך עינים יש לו ואינו רואה אזנים יש לו ואינו שומע פה ישלו ואינו מדבר והרי הורד מוטל כאבן עד שקוא מדבר נשבה עליו רוח מארב פנות העולם והטילהו לים הגדול קרע בגדיו ותלש בשערו וצעק ואמר ווי אבדה ישועת ישראל יצתה בת קול ואמרה אליהו לא כשאתה סבור אלא ארבע מאות שנה יגור בים הגדול ושמנים שנה במעלה עשן אצל בני קרח ושמנים שנה בפתחה של רומי ושארהשנים מחזר על כל מדינות גדולות עד עתקץ"@he ;
    oa:hasSelector opp:unit_fol_48r_2_u1_selector ;
    oa:hasSource opp:passage_fol_48r_2 .

opp:unit_fol_48r_2_u1_selector a opp:TokenPositionSelector ;
