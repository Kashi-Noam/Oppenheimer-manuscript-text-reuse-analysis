opp:unit_fol_12r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_12r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "להטיל שלום בין אברהם לשרה שנ ותצחק שרה בקרבה לאמר גו ואדני זקן ולבסוף כת ואני זקנתי אמ בר קפרא גדול השלום שכן מצינו שדברו הנביאים לשון בראי כדי להטיל שלום בין מנוח לאשתו דמעיקרא כת הנה נא ות עקרה גו ולבלוף לא אידכר בה שם עיקחה אמ ברקפרא גדילחא השלים שרעלאכים אי נ ביניהם לא איבה ולאקנאה ולא שנאה ולא מינות ולא תחרות ולא מחלוקת שה קבה עושה עמהם שלים מה טעם המשל ופחד עמו עושה שלום במרומיו המשל זת מיכאל ופחד זה גבריאל ולא זה מחזיק אתאה מהן של אש ומהן שלמים בני אדם שיש ביניהם כל המדות הללו על אחת כמה וכמה אמ ר ישמעל גדוד הואהשלום שמצינו שויתר הקבה על שמו שנכתב בקדשה שימחה על המים כדי להטיל שלום בין איש לאשתו אמ ר יהושע גדולהוא השלום שברית כהנים נכרתה בשלום שנאמ הנני נותן לו את בריתי שלום אמ ר יהושע גדול הוא השלום ששמו של הרבה נקרא שלום ש נ וירדא לו יי שלום"@he ;
    oa:hasSelector opp:unit_fol_12r_1_u1_selector ;
    oa:hasSource opp:passage_fol_12r_1 .

opp:unit_fol_12r_1_u1_selector a opp:TokenPositionSelector ;
