    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ותאתנ יציון עזבני יי וכו ויישכחני שכחת איתו עוז שאמרתי לפניך בים עזינזמרת יה דא עזבני יי לפני כל אומות העולם ר חנינא פתר קריה בבנות ציון ממש שנ ויאמר יי יען כי גבהו בנות ציון בנות שהיו מהלכות בגסות רוח ותלכנה נטויות גרון כשהי כשהיתה אחת מהן מתקשטת והיתה נוטה גרונה לכאן ולכאן כדי להראות תכשיטיה ומשקרות עינים ביסה דקסרין אמ שהיו מסקרות את עיניהן בם קרא ר שמעון בן לקיש אמ בק יטרית אדומה הלוף וטפוף תלכצה כשהיתה אחת מהן אורוכה היתהה מביאה שתי קבררות ומהלכות ביניהן כדי שתהא נראת נופה על גביהן וכשהיתה אחת מהן קצרה היתה ליבשת קרדקון עבה ומביאה שתי קצרות ומהלכת ביניהן כדישתהא נראית בחורה וברגריהן תעכסנה ר אבא ברכהנא אמ שהיתה אחת מהן צרה צורת הדרקון על מנעלה"@he ;
    oa:hasSelector opp:unit_fol_156r_1_u1_selector ;
    oa:hasSource opp:passage_fol_156r_1 .

opp:unit_fol_157v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_157v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ועוד שאלו שימני כחיתם על לךך אמרו להם הנביאים לא שאלתם כראוי מה הלב הזה פנומים מגולה פעמים מכוסה אלא אם בקשתם לשאול והיית עטרת תפארת ביד יי וצניף מלוכה בכף אלהיך ר סימון בן קוזי אמ בשם ר יוחנן אמ להם הקבה לא אתם ולא נביאיכם שאלתם כראוי אלא אם בקשתם לשאול הן על כפ חקותיך כשם שאי איפשר לאדם לשכח כפות ידיו כך כל אלה תשכחנה ואנכי לא אשכחך נוציה סערה לא נחמה בני איש עד מה כבורי לכלמה תאהבוןריק בני איש זהדואג ואחיתופל ולמה הוא קוראלהם בני איש שהם בני אברהם יצחק ויעקב ואין איש אלא אברהם אבינו דכתו ועתה השב אשת האיש וכן יצחק אבינו שנ מי האיש הלזה לההולך ואיש זה יעקב אבינו שנאמד בו ויעקב אישתם עד מה כבודי לכלמה אמ רוד ער מתי אתם מכליהו מכלימים בכבודי וקוראים איתי בן ישי מדוע לא בא בן ישי ראיתי את בן ישי יגם לכלכם יתן בן ישי וכי ליתלי שם תבקשו כזב סלה מה אתם סבורים על שנטלה מלכות ממני עתה לשעה שהוא לעולם ודעו כי הפלה יי חסידלו כבר בשרכי על ידי נתן הנביא מ לו גם יי"@he ;
    oa:hasSelector opp:unit_fol_157v_1_u1_selector ;
    oa:hasSource opp:passage_fol_157v_1 .

opp:unit_fol_158v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_158v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ולחנה אין ילדים והוו לה שנ כיפקד יי אתחנה ציון הוא דורש אין לה סופה דורש ישלה שנ ובא לציון גואל ודכה אנכי מרביץ בפוך אבניך כהדין כוחלא דכתוב ותשם בפוך עיניה וג דברים נאמרו בתחל מגדל את השער שבעפעפים ופוסק את הרמעה ומעביר בת מלך ויסדתיך בספירים כסנפירינון ר יובן ור פנחס ד יודן אמ כל גזירה וגזירה שהיא עתידה להנתן בירושלם מאבנים טובות תהינאה כסנפירינון הזה אמ ר פנחס תאמר שהסנפורוינון הואנאה ביותר וחזק כך הוא מעשה באחד שירר לרומי למכור סנפירינון אמ לו הלוקח עלמנת שאברוק אותי אמ לו על מנת כן מה עשה נטלו והניחו על הסדן והיה מכה עליו בפטיש נבקע הסדן ונחלק הפטיש יוהפלויש לא חסר ולא נשבר ושמתי בדכד ר אבא אמ כדין וכדין לו ר לוי אמ כדכדינון ור יהנשנו בן לוי אמ אבני כדכודיא אמ ליה הן הראו אותן לי על ידינס מרושה בספינה אחת שהיתה מפרשת בים הגדול והיתה כולה גוים ולא היה בה"@he ;
    oa:hasSelector opp:unit_fol_158v_1_u1_selector ;
    oa:hasSource opp:passage_fol_158v_1 .

opp:unit_fol_158v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_158v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הוא ולית הוא מהימן לי אמ ליה אין כי ענותן הוא ומהימן הוא לך וכד תחמי יתהון ליה לא תחמי יתהון ליה קרם שום ברנש אלא בדברה רלעערתא למערתא רחיקא מוליך את אותו גמילין וחמי יתהוא ליה מתמן מיד נעשה רנער נם ויצא בשרום אזל ההוא ינוקא לגבי ר יהושע בן כוי ואשכחיה יתיב במתיבתא דבא דלוד אמ ליה מארי מילא דצניעותא אית לי גבך ומכע אנא למימרב קמך קדם ברנש אוחרן קם ליה ר יהושע תייתון וחמון ענותנותיה דר יהושע בן לוי דהוה מהלך בתר ההוא מינוקא גמילין ולא אמ ליה מה בעימיניה כיוא דמטו למערתא אמ ליה מארי אלין אנון אבני כדכודיא וכדי דתחמי יתהון אתיתי פמך כד חמא יתהון הבהיקה כל קרתא דלוד מאורן והשליכן לארץ ונגנמו שמשוכיך ושעריך לאבני אקדח אמ ר ירמיה בשם ר שמיאל בר יצחק עתיד הקבה לעשות שער המזרחי של בית המקדש הוא ושלי פשיפישן שלו אבן אחת שלמתלית ר יוחנן הוה דריש בכנשתא רבתא דצפורי ואמ עתיד הקבה לעשות שער המזרחי של בית המקדש הוא ושני פשפישין שלו אבן אחת שלמרגלית"@he ;
    oa:hasSelector opp:unit_fol_158v_2_u1_selector ;
    oa:hasSource opp:passage_fol_158v_2 .

opp:unit_fol_159r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_159r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והוה תמן חד מינאי פריץ ואמ אפלו בחדא בעתא דשפנינא לית אנן משכחין והדין יתיב ואמ כדין עם כשהוא מפרש בים הגרול שכעה ספינתו בים וירד לעומקי הים וראה מלאכי השרת מסתתים בו ומגלפים ומסרגים אמ להם מהו זה אמרו לו זהו שער מזרחי של בית המקדש הוא ושני פשפישין שלו אבן אחת שלמדגלית מיד נעשה לונס ויצאמשם בשלום בשתא חורניתא אתא ואשכח לר יוחנן יתיב דריש בההיא עיינ אמ ליה סביסבא כל יכיל למל למעלגא למשביא שבח ואזני וחמא כבינא לא הוה מסימנא אתי כיה ואלומ דחמון עיניך לא הוית מהימן למילי דידי דאמרית לך בשתא אוחרנתא עלה עינוי ואסתכל ביה ומיד נעשה גל של עצמות מכשה בחסיד אחד דהוה מטייל בשושניתיה דימא דיפו והרהר בל בו ואמ תאמר שהקבה פתיד לעשות שער מזרחי של בית המקד הוא ושני פשפישין שלו אבן אחת של מרגלית מיד יצתה בת קול ואמרה אלולי שאתה חם ידגמור כבר היתה מדת הדין פונעת בד העילם ככ בראתי בו ימים כדכת כי ששת ימים עשה יי את השמים ואת הארץ וכו ושער המזרחישל בית המקדש איפשר הוא לעשותו הוא ושני םשפישין שכו אבן אחת של מרגכית מיד בקש רחמים על עצמו מרפני הקבה ואמ ר בונושל עולם בלבי הרהרתי ובשפיתי"@he ;
    oa:hasSelector opp:unit_fol_159r_1_u1_selector ;
    oa:hasSource opp:passage_fol_159r_1 .

opp:unit_fol_160r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_160r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אלער בשם ר חנינא תלמידי חכמים מרבים שלום בעולם וכו לכי ואנושה אגכי אגכי הואמנחמכם חדכה שברה על חרפה שחרפו אותנו עמונים ומואבים הכת מדבר אתה מוצא כיון שגרמו עונות ונכנסו גוים לירושלם נבנסו עמם עמונים ומואבים ונכנסו לבית קדשי הקדשים ונטלו את הכרובים ונתנום בכליבה והיו מחזירין בכל חוצות ירושלם והיך אומ והלא ישראל היו אומ שאנו עובדין עז ראו מה היו הם עובדים ההד יען אמר מואב ושעיר הנה ככל הגוים בית יהודה ומה היו אומ יוי יוי בלא חדוה באותה שעה אמ הקבה שמעתי חרפתמואב וגדופי בני עמח לכן חי אני נאם יי צבאות כי מואב כסדום תהיה ובני עממ כעמורה ואנושה באה מכה על מכה גברתנית ומתישה ואקוה לנוד ואין ולחנחמים ולא מצאתי אמ הקבה אנכי אנכי הוא מנחמרם"@he ;
    oa:hasSelector opp:unit_fol_160r_1_u1_selector ;
    oa:hasSource opp:passage_fol_160r_1 .

opp:unit_fol_160v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_160v_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ועל ארבעה לא אשיבנו בקשו לברוח למערב ולא הניחו להם שנ משא בערב אמ להם הקבה הא הרגשתון אפיכון אמרו לפכיו רבונו של עולם ולא אתה הואשעשית משכו משל למה הדבר דומה למלך שנשא למטרונה והיה מצוה אותה ואומ לה אל תשיחי עם שכנותיך ולא תשאלי מנהון ולא תשאיל להוץ פעם אחת הקניטיה אותו והוציאה וטרדה מביתו והוציאה מתוך פלטן והיתה מחזרת על כל שכנותיה ולא היתה אחת מהן מקבלת אותה אמ לה המלך הא ארגישת אפיך אמ כו אדני והלא אתה הוא שעשיתישהיית מצוה אותי ואומ אלתשיחי עם שכנותיך ואל תשאילי להן ואל תשאלי מהן אלו שאלית מנהון או אשאלית להון הידה מנהון הות מנחמי עבדתי גו ביתי ולא הוו מקבלה יתיה גבה הוי כי אתה עשית כך"@he ;
    oa:hasSelector opp:unit_fol_160v_1_u2_selector ;
    oa:hasSource opp:passage_fol_160v_1 .

opp:unit_fol_161v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_161v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אבא בר כהנא בשם ר יוחכן משל למלך שקדש למטרונה וכתב לה כתובה מרובה ואמ לה יכך וכך אופות א חופות אני עושק ליך וכך וכך תסבריות אני נותז ליך הניחה והלך לו למדינת הים ושהה שם שנים רבות והיו חבירותיה מונות אותה ואומ לה עד מתי את יתבה עגונה סיב ליך בעל אחרי כאת טליא עד דחיי ליך עליך והיתה נבנשתתדיר בתוד ביתה ונוטלת כתובתה והיתה קוראה בה ומתנחמת עמה לימים בא המלך ממדינת הים וחזר עמה ואמ לה בתי תמה אני איך המתנת לי כל השנים הכלו אמרה לו אדני המלך אלולי כתובה גדולה שכתבת לי כבר הא חבירותי מאבדות אותי ממך כך לפי שבעולם הזה אומות העולם מונין לישראל ואומרים להם עד מתי אתם ממתינים ומינים על אלהיכם ונות ונותנים גפשותיכם עליו וכהרגים ונשרפים ונצלבים עליו כמה צער הוא מביא עליכם כמה ביזות הוא מביא עליכם באו לכם אצלנו ואנו נעשה אתכם דוכוסין ואפרכן ואסטרטליטין וישראל נרנסין בבתיכנסיות ובבתי מדרשות ונוטדלין ספרתורה וקורין בה והתהלכתי בתוככם ופניתי אליכם"@he ;
    oa:hasSelector opp:unit_fol_161v_1_u1_selector ;
    oa:hasSource opp:passage_fol_161v_1 .

opp:unit_fol_162v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_162v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אנכי יי אלהיך רגעהים ויהמו גליו וכי מהו שראה הינם ר יהודה ור נחמיה ר נחמיה אמ שם המפור היה חקוק עליו יי צבאות שמו וראה אותו וברח ואשיםי דבריבפיך ובצל ידי כסיתיך תמן תנינן שמעון הצדיק היה משירי כנסת הגדולה ר הונא בשם ר אחא אמ עוברי הים פירשו אותי נחית בחסדך עם זו גאלת זו גמילות חסדים נהלת בעזך זו תורה שנ יי עז לעמו יתן ועדין העולם מתמוטלו ואימתי נתבסםי אל נוה קדשך משבאו לנוה קדשך תמן תנינן רבן שמעון בן גמליאל אומ על שרשה דברים העולם קיים על הדין ועל האמת ועל השלום ושלשתן בפסוק אחד שנאמ אלח הדברים אשר תעשו דברו אמת איש את רעהו אמת ומשפט שלים שפטו בשעריכם ושלשפן דבר אחד נעשה הדין נעשה אמת נעשה שלום ר יהושע דסכנין בשם ר לוי אמ ואשים דברי בפיך ובצל ידיכסיתיך אלו דברי תורה ובצל ידי כסיתיך אלו גמילוה חלהים ללמדך שכל מי שעיסך במילות חסרים זוכה לחסות בצלו של הקבה דכתוב מה יקר חשדך אלהים ובני אדם בצל כנפיך יחסיון"@he ;
    oa:hasSelector opp:unit_fol_162v_2_u1_selector ;
    oa:hasSource opp:passage_fol_162v_2 .

opp:unit_fol_163v_1_u3 a opp:TextUnit ;
    rdfs:label "fol_163v_1#u3" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "רני עקרה הא רנה אם היא עקרה אמ ר מאיר רני עקרה אומה עקורה שעקרויה אומית העולם דכתזכור יי לבני אדום את יום ירושרם האומ ערו ערו עד היסוד בה על דעתיה דר אבא בר כהגא דאמ פנו פנו עד יסודיה מטיין עד היסוד בה אמ ר אבא בר כהנא עקר מסובים משל לאה היו אלא שהועישן רול עקרדכב ואל עקרה אמר ר צחק רחל היתה עקרה שלבית רכת ורחל עקרה תני ר שמעון בן יוחאי לפי שכל הדברים תלוים ברחל לפיכך נקראו בני ישראל לשמה שנ רחל מבכה על בניה וכא סוף דבר לשמה אלא לשם בנה שנ הבן יקיר לי אפרים לא ילדה אמ ר לוי כל מקום שנ און לה"@he ;
    oa:hasSelector opp:unit_fol_163v_1_u3_selector ;
    oa:hasSource opp:passage_fol_163v_1 .

opp:unit_fol_164r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_164r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "עליסה פצקה רנה צהלה חדוה הריעה ואית דמפקין הריעה ומעלין דיצה שנ ולפניו תדוץ דאבה כ רבים בני שוממה אמר אבא בר כהנא כתוב ומדברך נאוה אפי מדבר נאוה וחייבין על מחיצתו והוא חרב כשם שחייבין על מחיצתו והוא בנדי אמ ר ליי אמ הקבה בבניה העמידה לי רשעים כגון אחז מנשה אמין בחורבנה העמיד לי צדיקים כגון דניל וחבורתו מרדכי וחבורתי ר אתא בשם ר יוחנן אמ אמ הקבה הרבה צדיקים העמידה לי בחורבנה מצדיקים שהעמידה"@he ;
    oa:hasSelector opp:unit_fol_164r_1_u1_selector ;
    oa:hasSource opp:passage_fol_164r_1 .

opp:unit_fol_164v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_164v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ויתפרו עלה תאנה ר יהושע דסככי בשם ר לוי משל למלך שהיה לו בן והיו לו שפחות הרבה ומצוה אתי ואומר לו הןהר שלא תגעג באחת מכל השפחות מה עשה הלך וקלקל עם אחת מהן כיון שהרגיש אביו טרדו והוציאו מתוך פלטרין שלו והיה מחזר על השפחות ולא היתה אחת מהן מקבלת אותו וכיון שאכל ארם הראשון מאותו אירן שמע קול האילנות אמרים האגנבא דגנב דעתיה דברייה וגנב דעתיה דמריה אל תבאני רגל גאוה ויתפרו עלה תאנה ומה היה שמה דההיא תאנה כרת עליה דהיא אתיא אליתא ובכיתא לעלמא ר אבין אמ כרת שבע דהיא אתית זיומי אבילות לעולם ר יהודה בר סימון אמ בשם ר יהושע בן לוי אותו אילן שאכל ממנו אדם הראשון לא גלה חותו הקבה ולא עתיד לגלותו חמ הקבה והרגת את האשה ואת הבהמה אם אדם חטא מ בהמה מה חטאה אלא על שבאה לאדם תקלה על ידה לפיכך תכקל דא שלאתתא בהמה עיבה עיברת בשיק ויחמרו לה זו שנהרג אישפלני על ידה אמ הבה על כביד בנו חס דין הוא שאחוס על כבודי"@he ;
    oa:hasSelector opp:unit_fol_164v_1_u1_selector ;
    oa:hasSource opp:passage_fol_164v_1 .

opp:unit_fol_166r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_166r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בא אחר ותבעה ולא היה הגון לה וכיון שבא אחר והיה הגון לה אמ לה קומי אנהרי דאתא נהוריך כך אמ הקבה לישראל בני הואיל ואורי הוא אורכם אני ואתם נלך ונאור לציון שנ קומי אורי כי בא אורך ר פנחם בשם ר יעקב אמ עתיד הקבה להביא סיני וכרמל ותבור ולבנות בית המקרש על ראשם ומה טעם דכת נכון יהיה הר בית יי בראש ההרים ונשא מגבעות אמ רב הונא ודייך עד כאן אלאבית המקדש יאמר שירה וההרים עונים אחריו ומה לעם ונשא מובעיות אין לשון זה ונשא אלח לשון שירה שנ וכגניהו שרהטים יסר במשא כי מבין הוא ר אושנרא בשר ר אפס אמ עתיד לרו טל לענשות כחחול פנים לכל חומות העולם והם מהלכים לארה ומה טעם והלכו גוים כאורך אמר אחא נמשלו שכאל לזית רפנן שנ ינה כרי תאר יךא יי שמך יומל הקבה לכר שנ נר יי נשמת אדם מה דרכו של שמן להכתן בנר עם הפתילה והן מאירין כאחד כך אמ הקבה לישראל בני הואיל ואורי אורכם ואורכם אורי נלך אלי ואתם ונאיר לציון שנ קומי אורי כי בא אורך"@he ;
    oa:hasSelector opp:unit_fol_166r_1_u1_selector ;
    oa:hasSource opp:passage_fol_166r_1 .

opp:unit_fol_168v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_168v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "שוש אשיש ביי וההיום עשה יי נגילה ונשמחה בו אמ ר אבין אין אנו יודעים במי נשמה אליביום אם בהקבה עד שבא דוד ופירש אשמחה ואעלבה בך אמ בך ברב אותיות שכתבת לנו את התורה ב תרי כ עשרים תמן תנינן נשא אשה ושהת עמו עשר שנים ולא ילדה אינו רשאי לבטל פריה ורביה גרשה מותרת לה גשא לאחר ורשאישכי לשהות עמה עשל שנים אם הפילה מונה לה משעה שהפיכה דא שוש אשיש ביי משל למטרונה שתלך בעלה למדינת הים ובניה וחתניה לאחר זמן רב בא בעלה של מטרונה עם בניו וחתניו אמרו לה הרי בניך אמ להם ישמחו כלותי אמרו לה הרי חתניך אמ להם ישמחו בנותי אמרו לה הרי בעליך אמרה להם הא חדו הא חדו כפלה כך לעתיד לבא הנביאים אומרים לירושלם בניך מרחוק יבאו היא אומ תגלנה בנות יהודה באו בנותיך מוצה היא אומ ישמח הרציון וכיון שאומ לה הנה מלכך יבא לך בדק ונושע היא אומ הא חדו האחדו האחדו כפלה הוישוש אשיש ביי רי הלבישני בגדי ישע משל ליתומה שגדלה בפלטין שלמלך כיון שהגיע זמנה להנשא אמרי עמא אית להכלים אמרו ל אין לה מן דא דאבוהא ואיתלה מאן דנסבה כך הם ישראל יש לחם זכות משל אברהם אבינו ושל יצחק"@he ;
    oa:hasSelector opp:unit_fol_168v_1_u1_selector ;
    oa:hasSource opp:passage_fol_168v_1 .

opp:unit_fol_168v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_168v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בגדי ישע בזכותו של יעקב י דנת ביה ואת עורות עורות גדי העזים הלבישה על ידיו מעעיל בדקה יעטני בזכותו שלאברהם דכת ביה כי ידעתיו למען אשריצוה את בניו ואת ביתו אחריו כחתן יכהן פאר וככלה תעדה כליה בעשרה מקומות נקראו ישראל כלה ששה על ידי שנמ וא על ידי ירמיה וג על ידי ישעיהו ששה על ידי שלמה דכת אתי מלבנון כלה באתי לגני אחתיכלה גן נעול אחתי כלה לבבתיני אחתי כלה מה יפו דודיך אחתי כלה נפת תטפנה שפתיתיך כלה ואחת על ידי ירמיה קול ששון וקול שמחה קול חתן וקולכלה וגעל ידי ישעיה כי כדם כעדי תלכשי ותקשרים בכלה ומשוש חתן על כלה והדין וכבלה תעדה כליה כנגד מי נאמרו כנגד עשרת הדברות ששמעו ישראל בסיני והיו מצמצבמין את עצמם ככלה וכנגדן לבש הקבה עשרה לבושין כדי להפרע מאומות העולם שהם מעכבין את ישראל מלקיים עשרת הדברות לבוש הראשון נשלבש בשעה שברא את עולמו בה דר שמו שנ הוד והדר לבשת לבוש השני שלבש גאות שמו כדי להפרע מז דור המבול שנ יי מלך גאות לכש לבוש השליש שלבש בשעת מתא תורה לישראל עוז שמו שנ לבש יי עון התאזר"@he ;
    oa:hasSelector opp:unit_fol_168v_2_u1_selector ;
    oa:hasSource opp:passage_fol_168v_2 .

opp:unit_fol_169v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_169v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כך לעתיד לבא כל מי שהוי מפרש שמה של ירושלם חייב מיתה מאיטעמ וקורא לך שם חדש אשר הי יי יקבנו אמ ר לדי ששה דברים עתיד הקבה לחדש בימי מלך המשיח אלו הן שמים וארץ ולב חדש ורוח חדשה ושמו של משיח יושמה של ירושלם שמים ואכץ מנין שנ כי כאשר השמים החדשים והארץ החדשה אשר אני עושה לב ורוח דכת ונתתי לכם לב חדש ורוח רדשה אכן בקרבלם ושמו של משיח דכת בימי בימיו תושע יהודה וישראל ישכון לבטח וזה שמו אשר ירראו ייז צדקנו ושמה של ירושלם שנ וקרא לך שם חדש אשר פי יי יקבנו אמ ר לוי טבא לקרתא דשמה כשם מלכה ושמה כשם אלהיה שמה כשם מלכה שנ ושם העיר מיום יי שמה אל תקם שמה אלא יי שמה שם מלכה כשם אלהיה ושוזה שמו אשר יקרא לה יי צדקיו וזאת הברכה ולכן יחכה יי לחננלם ולכן ירום להח מךם אמ רברכיה לכן יצפה אין כתו כאן אלא יחכה כהדין צדא דמחנ לצידיה אמ ר אחא מצינן שכל מי שהוא מלמד סניגוריא הקבה מרוממו בעולם הזה"@he ;
    oa:hasSelector opp:unit_fol_169v_1_u1_selector ;
    oa:hasSource opp:passage_fol_169v_1 .

opp:unit_fol_170v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_170v_1#u1" ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    rdf:value "יקבוהו לאם נעשה ארירה לאומות וברכה לראש משביר זה משה שבירך את ישראל בעין טובה אמ ר יצחק כתו וירא בלעם כי טוב בעיני יי לכרך את ישראל ד ברכות בירכן והיה ראוי לכרכן ז ברכות ומהו שבלעם מברכן שבעי ומשהד הא את אחת עשרה ועשה בלעם בעין צרה ולא בירכם אלא שלש אי זה מקן שליש מי מנה לא הביט און ביעקב מה טבו אהליך יעקב וברכות שבירך משה את ישראל אלוהן יי אלהיכם הרבה אתכם יח אלהי אבותיכם יוסף עליכם וכו ויצאו ויברכו את העם וירא משה ויברך אותם משה ובה ומה היא הברכה שבירכם אמ להם תשרה שכינה במעשה ידיכם והדין וזאת הברנה דא וזאת הברבה הן וכבשתן לפי שהוא קנתרן בדברים בראשו של ענין שנ מזי רעב רפיכך חזר ובירבן בסופו שנ אשריך ישראל מי כמוך דא וזאת הברכה מה ברכה מטהרת את הטמאים אף משה כן מטהר את ישראל ומקרב את הרחוקים להנן ביתה שנ יחיראו ראובן ואל ימות ר איבו ורבנן ר איבו אמ תפלה קודמת לברכה מאיטעמ על זאת יתפלל כל חסיד אליך לעת מצא ואחרכך ברכה ורבנן אמ ברכה קודמת לתפלה מאי טעמ בריך יי לעולם ומה כתו בתריה תפלה למשה איש האלהים"@he ;
    oa:hasSelector opp:unit_fol_170v_1_u1_selector ;
    oa:hasSource opp:passage_fol_170v_1 .

opp:unit_fol_171r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_171r_2#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "אמ ר יהושע בן לוי עד כאן שמעתי מכאן ואילך צא ופרוש לעצמך איש האלהים בשעה שעלה למרום איש האלתים ובשעה שירד למטה איש שנ וירא אהרן וכל בנ ישראל כי קרן עור פני משה בשעה שברח מפליפרעה איש האלהים בשעה ששקע מצריים לים רא איש האלהים בשעה שנסתלק הארון ובשעני ששכן לקיים מה שנ קומה יי למנוחתך ובשעה ששכן ובנחה יאמר שובה יי רבבות אלפי ישראל מלמד שבירך כל ישראל כאחד כענין שנאתם נצבים היום כלבם אמ ר אבין כל ימיו של משה היה מבקש לברך את ישראל ומה ברכה בירכם הושיעה את עמך וברך את נחלתך תנו רבנן מהו שנ אני אמית ואחיה יכול תהא מיתה באחד וחיים באחד כדרך שהעולם נוהג תל מחצתי ואני ארפא מה מחצה ורפואה בארחה אף מיתה וחיים באחד מכאן תשנבה לאומרים אין תחיית המתים מן התורה וכן אח ישיר משה שר לא נאמר אלא ישיר מכאן לתחיית המתים מן התורה"@he ;
    oa:hasSelector opp:unit_fol_171r_2_u1_selector ;
    oa:hasSource opp:passage_fol_171r_2 .

opp:unit_fol_177v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_177v_2#u1" ;
    opp:earliestWitness opp:work_Midrash_Lekach_Tov ;
    rdf:value "כמדת בשר ודם אדם טובע כמה מטבעות בחותם אחד וכולן דומין זה לזה והקבה טבע את כל בני האדם בחותמו שלאום היאשוא יאן ארד מהם דומהלחביס לנך לכך חייבין אנו ליפן שבח והודאה למכך מלכי המלכים הקבה שברא את עולמו בעשרה מאמרות ואמרב יהודה אמ רב בעשרה מאמרות נברא העולם בחכמה בתבונה ובדעת ובכח ובגבורה ובגערה ובצדק ובמשפט ובחסד וברחמים בחכמה מנין דכת יי בחכמה יסד ארץ בדעת מנין שנ בדעתו תהומות נבקעו בכח ובגבורה מנין שנ מכין חכמים בכחו נאזר בגבורה בגערה מנין דכת עמודי שמים ירופפו ויהמהו מגערתו בצדק ובמשפט מנין דנת צדק ומשפט מכון כסאך בחסד וברחמים דכת זכור כחמיך יי וחסדיך הוב מה לידידי בביתי עשותה המזמתה לרבים הרבים אמ ר"@he ;
    oa:hasSelector opp:unit_fol_177v_2_u1_selector ;
    oa:hasSource opp:passage_fol_177v_2 .

opp:unit_fol_177v_2_u2 a opp:TextUnit ;
    rdfs:label "fol_177v_2#u2" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "זה לזה והקבה טבע את כל בני האדם בחותמו שלאום היאשוא יאן ארד מהם דומהלחביס לנך לכך חייבין אנו ליפן שבח והודאה למכך מלכי המלכים הקבה שברא את עולמו בעשרה מאמרות ואמרב יהודה אמ רב בעשרה מאמרות נברא העולם בחכמה בתבונה ובדעת ובכח ובגבורה ובגערה ובצדק ובמשפט ובחסד וברחמים בחכמה מנין דכת יי בחכמה יסד ארץ בדעת מנין שנ בדעתו תהומות נבקעו בכח ובגבורה מנין שנ מכין חכמים בכחו נאזר בגבורה בגערה מנין דכת עמודי שמים ירופפו ויהמהו מגערתו בצדק ובמשפט מנין דנת צדק ומשפט מכון כסאך בחסד וברחמים דכת זכור כחמיך יי וחסדיך הוב מה לידידי בביתי עשותה המזמתה לרבים הרבים אמ ר יצחק בשעה שחרב בית המקדש מצאו הקבה לאברהם עומד בבית המקדש אמ לו מה לידידי בביתי אמ לי על עסקיבני באתי אמ לו בניך חטאו וגלו אמ לו שמא בשוגג אמ לו עשותה המזמתה אמ לו שמא מיעוטן חטאו אמ לו הרבים היה לך לזכור ברית מילה אמ לו ובשר קדש יעברו מעליך שמא אם המתנת להם היו חוזרין בתשובה אמ לו כי רעתכי אז תעלזי"@he ;
    oa:hasSelector opp:unit_fol_177v_2_u2_selector ;
    oa:hasSource opp:passage_fol_177v_2 .

