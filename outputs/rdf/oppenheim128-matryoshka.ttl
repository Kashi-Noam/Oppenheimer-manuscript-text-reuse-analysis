opp:unit_fol_122r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_122r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה חנאת אלא לפי שהיו ב המצד משתחוים למזל טלה שלא יהו אומרים יראתנו הביאה עליהם את הפורענות קשה הא יראתנו שעמדה על עצמה קשה היא יראתנו שלא שלטה בה פורענות ר חוניא ור יהושעי בר אבין ור זכריה חתניה דר לוי בשם ר לוי אמ אין בעל הרחמים מם נוגע בנפשות תחלה ממי אתה למד מאיוב שנ ומלאך בא אל איוב ויאמר הבקר היו חורשות והאתונות רועות על ידיהן אמ ר חמא בר חנינא נעשו לו מעין דוגמת העולם הבא כרא ונגש חרש בקוצר אמ ר אבא בר כהנא יצאומן כפר קרינוס והלכו את כל האיבלון כלו וכיון שהגיעו למגדל ציבעניא מתושם אמ ר הוניא דק מיעוט הוא אף הוא משובר מולקה היה אמ ר יודן עד לבדי להגיד לך אף הוא כיון שהגידו לו בשורתו מד מתהוא ההד עוד זה מדבר"@he ;
    oa:hasSelector opp:unit_fol_122r_1_u2_selector ;
    oa:hasSource opp:passage_fol_122r_1 .

