opp:unit_fol_120r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_120r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ועצת מלאכיו ישלים נגרה הקבה על אבינו יעקב לקיים גסירתו של אותו מלאך שנא ואמר לי אלהים שמך יעקב לא יקרא שמך עוד יעקב כי אם ישראל יהיה שמך ירושלם שכל הנביאים מהנבאר עליהם שהיא נבנית על אחת כמה וכמה דא מקים דבר עבדו זה משה שנ לא כן עבדי משה וישלך מלאך ויוביאנו ממצרים אמ הקבה למשה לך אמוד לישראלל ועברתי בארץ מצרים בלילה הזה הלך משה ואמ להם כה אמר יי לחצית הלילה אני יוצא בתוך מצרים אמ הקבה והלא כבר הבטחתי את משה ואמ לא כן עבדי משה הוא משה עבדי נראה כמכזב אלא מה אמ משה כחבות הלילה אף אני ויהי בחצי הלילה לפיכך אמ ויהי בחצי הלילה חצות לילה אקום להודות לך ר פנחס בשם אלעזר בן פנחס אמ מה היה דגד עושה היה נוטל גבל וכנור ונותלן תחת מראשותיו ועומד בחבי הלילה ומנגן בהם והיו חבירי ישראל שומעין את קולו ואומ מה אם דוד המלך הוא עסוק בתורה אט על אחת כמה וכמה נמצאו כל ישראל עסוקים בתורה אמ ר לוי"@he ;
    oa:hasSelector opp:unit_fol_120r_1_u1_selector ;
    oa:hasSource opp:passage_fol_120r_1 .

