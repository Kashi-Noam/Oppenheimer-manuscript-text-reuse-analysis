opp:unit_fol_124v_2_u2 a opp:TextUnit ;
    rdfs:label "fol_124v_2#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לי סנטריותי אמ ר ברכיה אי מגירסך אנא לית את יהיב לי מן תבשילך דנדע מה אינון צריכין הוא שדוד אומ גשם נדבות תניף אלהים אמ ר בניה אם גשם היא צריכה נדבות נדבות מהו צריכה ואם טל היא צריכה תניף אלהים נחלתך ונלאה אתה כוננתה אמ ר בניה אמ הקבה לישראל בני כשהייתינותן לכם את המן הייתינותן לכם לכל אחד ואחד מרם עמל לגלגלת ועכשו שאתם נותנים לי את העמר איני רוצה מכלכם אלא עמר אחד ולא עוד אלא שאינו של חטים אלא של שעורים לפיכך משה מזהיר את ישראל ואומ להם והבאתם את עמד ראשית קצירכם אלהכהן"@he ;
    oa:hasSelector opp:unit_fol_124v_2_u2_selector ;
    oa:hasSource opp:passage_fol_124v_2 .

