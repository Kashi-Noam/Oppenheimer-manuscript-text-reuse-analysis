opp:unit_fol_84v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_84v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "שכינה אמ ר אבא בר כהנא כת ונועדתי לך שם ללמדך שאפי מה שאחרי הפרכת אינופנוי מן השכינ גוד אקך שאל את רג אמ ליה מפני מה וכ נגלה ר הקבה למשה מתוך הסנה לו נגלה לו על חרוב או על תאנה מה היית אומ אלא ללמדך שאין לך מקום שהוא פנוי מן השכינה ר יהושע דסםץ בשל רלוי אמ למה היה אהל מיעד דומה ליצערה שהיא שהיא נתונה על שפת הים ועלה הים והביף את המערה והמעהה מתמנאת מהים והים אינו חסר כלום כך אהל מועד נתמלא מזיו שכינה ועולם לא חסר כלום מזיו השכינה שירד למטה לכך נאמ ויהי ביום כלות משה צאנה וראינה בנות ציון במלך שלמה בנות ציון בנים המצויינין לי במילה ובתגלחות ובציצית במלך שלמה במלך שהשלום שלו דא במלך שהשלום שלו במעשיו לכריותיו השלים האש לאבינו אברהם השלים החרב לאבינו יצחק השלים המלאך לאבינו יעקב"@he ;
    oa:hasSelector opp:unit_fol_84v_1_u2_selector ;
    oa:hasSource opp:passage_fol_84v_1 .

opp:unit_fol_84v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "178"^^xsd:nonNegativeInteger ;
    oa:start "37"^^xsd:nonNegativeInteger .

