opp:unit_fol_13r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_13r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "רשבג אומ גדול הוא השלום שהרי אהרן הכהן לא נשתבח אלא בשביל השלום שהרו אוהב שלום ורודה שלום ומקדים שלום ומשיב שלום שנ בשלום ובמישור הלך אתי מה כת בתריה ורבים השיב מעון מלמד שכשהיה רואה שני בני אדם שונאין זה את זה הולך אנל אחד מהם ואומר לו למה אתה שונא לפלני כבר בא אלי לביתי ונשתטח לפני ואמ לי חטאתי לפלכי לך ופייס עלי ומניח לזה והולך אצל השני ואומר לו כמג שאמר לראשון והיה משים שלום ואה בה ורעות בין אדם לחברו ועל זה נאמר ורבים השיב מעון אמ ר יהושע הנביא נקרא מלאך והחכם נקורא מלאך הנביאנקוא מנלאך שנאמ ויאמר חגי מלאך י והחכם נקיאמלאך שנ כי מלאך צבאות הוא יכול יהא כהן עם אהארץ תלמוד לומר ותורה יבקשו מפיהו אמ ר יהושעי דסכנין בשם ר לוי גדול השלום שכל הברכות והתפלות חותמין בשלום קרית שמע חותמה בשלום ופרוס סוכת שלומך בקכת כהנים חותמה בשלום שנאמ וישם לך שלום"@he ;
    oa:hasSelector opp:unit_fol_13r_1_u1_selector ;
    oa:hasSource opp:passage_fol_13r_1 .

opp:unit_fol_13r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "189"^^xsd:nonNegativeInteger ;
    oa:start "36"^^xsd:nonNegativeInteger .

opp:unit_fol_13v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_13v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "אמ ר יהושע בן לוי אמ הקבה לישראל אתם גרמתם להחריב את ביתי ולהגנות את בני היו שואלין בשלימה ואני מוחל לכם ההד שאלו שלום ירושלם ואומ ודרשו את שלום העיר ואומ יהישלום בחילך שלוה בארמנופיך ואומ למן לע למען אחיורעי אדברה נא שלום בך ומי שהוא אוהב שלום ורודף שלום ומקדים שלום ומשיב שלום הקבה מורישו העולם הזה והעולם הבא שנאמר וענוים ירשו ארץ והתענוו על רוב שלום"@he ;
    oa:hasSelector opp:unit_fol_13v_1_u1_selector ;
    oa:hasSource opp:passage_fol_13v_1 .

