opp:unit_fol_106r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_106r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לא היה אדם רואה ל היה מתאוה ועכשו בין הויה ביזשאינו רואה מתאוה אמ ר אבא בר יידן בשם ר אחח דמן לכד גמטויויגר ילמפרשי ימים שיהו נזכרים ובאים במהרה לבתיהם אמ ר סימין כל נפלאים ומחשבות שחשבת כדי שלא יקבלו אומות העולם את הורתך וכברגלוי וידוע לפניך שאי ז אימית הינולם מהו לין את תורתך וליצה נראית כמחו עליהם בשביל לככונ לנו מתן שכרנו דאמ ר סימון כל חשבוניך אלינו כל אותן שני אלפים וארבע מחות ומח שנה עד שלא יצחו ישראל ממצרים שהיהה הקבה יושב ומחשב חשבונות מעבר עבורים ומקדש ית השנים ומחדש את החדשים וכיון שיצאו ישראל מנמ ממציים יצסרן להם ההר החדיש הזה ככם ראש חדשים באר מצרים לזמת מהו לאינר המ להם מכאן ואילך הרי הן מסורין לם ההד החדש הזה לנם ראש אדשים ר חייא בר אכאכ צא תוקלת ממושכה מחלה לד זה שהוא מארש אשה ונונולה לאחר זמן וניץ חיים תאוה באה זה שמארש אשה ונוטלה מיד דא תוחלת ממושכה מחכה לכ זה דור שנמשח לילך ול מלך אלא לאחר שתי שנים"@he ;
    oa:hasSelector opp:unit_fol_106r_1_u2_selector ;
    oa:hasSource opp:passage_fol_106r_1 .

