    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "צדיק אוכל דשובע נפשו זה הקבה אמ הקבה לישראל בני מכל קרבנות שאתם מקריבין לפני כרום אני נהנה מכם אלא הריח שנ ריח ריחוחי תשמרו להקרב לי במועדו אקה צוית פקודיך לשמיר מאד תשמרו והינן ציה בחוהש הנקודים שנ לשמרמאד ונאל תשמרו להק להקריב לי במועדו היא הפרשה האמורה להלן והיא הפרשה האמורה כאן ולמה היא אמורה ונשנית ר יהודה ור נחמיה ורבנן ר יהודה אמ לפישהיו ישראל אומ לשעבר היו המסעות נוהגין פסקו המסעות פסקו התמידים אמ הקבה למשה לך אמור להם לישראל שלאתיו רגילין בתמידין ורבנן אמרין להלן לתלמוד וכאן למעשה אמ ר אחא בשם ר חיננא בר פפא לפי שהיו ישראל אומ לעי לשעבר הינו מקריבין קרבנות ומתעסקין בהן ועכשו שאין אנו מקריבין ארבנות מהו שנתעסק בהם אמ להם הקבה הואיל ואתם מתעסקין בהם כאלו אתם מקריבין אותן רב הונא אמ תרתי רב הונא אמ אין כל תגליות מתקבצות אלא בזכות משניות מה טעמיה גם כי יתנו בגוים עתה אקבצם ויחלו מעט ממשא מלך ושרים רב הונא אמ חורי כי ממזרי שמש עד מבואו גדול שמי בגוים ובבל מקום מוקטר מוגש לשמי ומנחה טהורה"@he ;
    oa:hasSelector opp:unit_fol_118r_2_u1_selector ;
    oa:hasSource opp:passage_fol_118r_2 .

opp:unit_fol_124v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_124v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אבין באוראה כמה היו ישראל מצטערים על מצות העמד דתלנן תמן קצרוהו ונתנוהו הביאוהו לעזרה והיו מהבהבים בו האור כדי לקיים בו מצות קלי דבריר מאי וחכמים אומ בקנים ובקלחת חובטיים אותו כדי שלא יתמעיך נתנוהו לאבן והאבן היה מנוקב כדי שיהא האור שולט בכלו שטחוהו בעארה והרוח מנשבת בו נתנוהו לרחים של גרוסות והוציאו ממנו עשרון שהוא מנופה ביג נפה כל כך למה כדי להוציא ממנו עשרון שהוא מנופה ביג נכי כל אמ ר לוי הרי שעמלת וחרשת וזרעת ונכשת וכסחת ועדרת וקצרת ועמלת ודשת ועשית אותה ערמה אם אין הקבה מוציא לך מעט רוח שתזרה מהיכן האדם יחיה הוי אין אתה נותן לו אלא שכד הרוח שנ מה יררון לו שיעמל לרוח אמ ר אלעזר כתו ולא אמרו בלבבם נירא נא את יי אלהינו הנותן גשם ויורה ומלקהש בעתו בראשון מהו הנותן יהב ללון כולא לית אתון צריכין ליה להביא כדין שבועות אקות קציר ישמר לו ישמור לנו מן השרב ומן הרוחות הקשים ומא הטללים הקשים ואלו ז שבתות שבין פסא לעצרת תני ר חייא שבע שבתות תמימות תהיינהי אימתי הן תמימות בזמן שאין ישוע ושכניה ביניהם"@he ;
    oa:hasSelector opp:unit_fol_124v_1_u1_selector ;
    oa:hasSource opp:passage_fol_124v_1 .

opp:unit_fol_124v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_124v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "אמ ר יהושע בן לוי סאנטראך אנא לית אב את יהיב לי סנטריותי אמ ר ברכיה אי מגירסך אנא לית את יהיב לי מן תבשילך דנדע מה אינון צריכין הוא שדוד אומ גשם נדבות תניף אלהים אמ ר בניה אם גשם היא צריכה נדבות נדבות מהו צריכה ואם טל היא צריכה תניף אלהים נחלתך ונלאה אתה כוננתה אמ ר בניה אמ הקבה לישראל בני כשהייתינותן לכם את המן הייתינותן לכם לכל אחד ואחד מרם עמל לגלגלת ועכשו שאתם נותנים לי את העמר איני רוצה מכלכם אלא עמר אחד ולא עוד אלא שאינו של חטים אלא של שעורים לפיכך משה מזהיר את ישראל ואומ להם והבאתם את עמד ראשית קצירכם אלהכהן אשר קצירורעב יאכל ואל מצנים יקחהו ושאף צמים חילם אשר קצירו זה נמרוד רעב יאכל זה אבינו אברהם ואל מצנים יקחהו לא בזין ולא במגן אלא בתפלה ובתחנונים שנ וישמע אברם כי נשבה אחיו וירק את חניכיו ילידיבתו שמנה עשר ושלש מאות ר שמעין בן לקיש אמ בשם בר קפרא אליעזר לכדו היה ושמו של אליעזר שמנה עשר ושליש מאות ושאף צמים מידחק לו ממונו של נמרוד אברהם וכל המצומתים לו"@he ;
    oa:hasSelector opp:unit_fol_124v_2_u1_selector ;
    oa:hasSource opp:passage_fol_124v_2 .

opp:unit_fol_125r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_125r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "דא אשר קצירו זה פרעה רעב יאכל זה משה ואהרן ואל מצנים יקחהו לא בזין ולא במגן אלא בכפלה ובתחנונים שנאמ ויאמר יי אל משה מה תצעק אלי ושאף צמים חילם מי דחק לממונו של םיחון ועוג וע ושל פרעה משה ואהרן וכל המצומתים להם דא אשר קצירו זה סיסרא רעב יאכל זה דבורה וברק ואל מצנים יקחהו לאבזין ולא במגן אלא בתפלה ובתחנונים שנאמ מלן שמים נל חמו הכוכבים ממסלותם נלחמו עם שסרא ושאף צמים חילם מידחק לממוינם שלחל סמ ם שרא דבורה ובדק וכל המצומתים להם דא אש קצירו זה סנחריב רעב יאכל זהישעיה וחזהיה ואל מצנים יקחהו לא בזין ולא במגן ולא במלחמה אלא בתכלה ובתחנ ונים שנאמ ויתפלל חזקיהו המלך וישעיהו בן אמוץ הנביא ויצעקו השמים ושאף צמים חילם מי דחק לממונו של טנחריב ישעיה וחזקיה וכל המצימתים להם דא אשר קצירו זה המן רעבבי יאכל זה מרדכי ואסתר ואל מצנים יקחהו לא בזין ולא במגן וליא במלחמה אלא בתפלה ובתחנונים שקואפד יצע דרבים מי דחק לממונו שלהמן זה מרדכי ואסתה וכל המצומתים להם דא אשר קצירו אלא לו לא מלכים רעב יאכל זה יהושע וכלב"@he ;
    oa:hasSelector opp:unit_fol_125r_1_u1_selector ;
    oa:hasSource opp:passage_fol_125r_1 .

opp:unit_fol_127v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_127v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ליה כל הדין בזיולא אנא שלים ליה אמ ליה מריטיבו רבא אנא שלים ליה חד זמן עלון שבאי לקרתא ואתא חד מנהון למשבי אתתא דההוא גברא וקם ואכל בציו ור יוחנן אמ ברצות יי דרכי איש גם אויביו ישלים אתו זו אשתו שנ אויבי איש אנשיביתו זו אשתו אמ ר יוחנן אשתו של לסטים כלסטיס מעשה באשה אחת שקבלה על בעלה לדיין עליה עלה ורב שמאל ברניחמן ורב שמיאל כר נחאמן וחייבו להתיז את ראשו לאחר זמן מצא נחמן אמ ברצות יי דרכי איש זה יצר טוב גם אויביו ישלים אתו זה יצר הרע בנוהג שבעולם אדם גדל עם חבירו ב או גשנים בכרך והוא קושר לו חבה וזה גדל עם אדם מנעריו ועד זקנתו מצא להפילו בתוך כ שנה מפילו בתוך מ שנה מפילו בתוך ששים מפילו אמרו עליו על יוחנן כהן גדול ששמש בכהונה גדולה פ שנה ובסיף נעשה צדוקי הוא שדוד אומ כל עצמותי תאמרנה יי מי כמוך מציל עני מחזק ממנו עני ואביון מגוזלו מציל עני מחזק ממנו זה יצר טוב מיצר"@he ;
    oa:hasSelector opp:unit_fol_127v_1_u2_selector ;
    oa:hasSource opp:passage_fol_127v_1 .

opp:unit_fol_129v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_129v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "אמ ר ידאי הא ברישא דתיביתא ויוד בסופה דהא ויוד מעויד עליהנן דאינון בנין של אבהתהון ומאי טעמיה ששם עלו שבטים שבטי יה עדות לישראל שהם בניהם של אבותיהם דא גן נעול אלו הבתולות גל כעול אלו הבעולות מעין חתום אלו הזכרים תני בשם ר נתן מהו גן נעול גל נעול שני פעמים כדרכה ושלא כדרכה ר הוליא בשם ר חייא בר אבא אמ שרה אמנו ירדה למצרים וגדרה את עצמה מן הערוה ונגדרו כל הנשים בזכותה יוסף הצדיק ירד למצרים וגדר עצמו מן הערוה ונגדרו כל האנשים בזכותו אמ ר חיא בר אבא כדאי הוא גדור ערוה לעצמו שיגאלו ישראל ב בזכותו אמ ר הונא בשם בר קפרא בזכות ארבעה דברים נגאלו ישראל ממצרים י שלא שנו את שמם ושלא שנו את לשונם ושלא היה בהם לשון הרע ושלאהיה בהם פירוץ ערוה שלא שנו את שמם ראובן שמעון מנחתק ראובן שמ מסלקין שלא שנו את לשונם שנ כי פי המדבר אליכם שברשון הקדש היה מדבר שלא היה בהם לשון הרע שנ דבר נא באזני העם וישאלו איש מאת רעהו ואשה מאתרעותה אתה מוצא שהיה הדבר מופקד אצלם כל יב חדש ולאהיה ארד מהם שהלשיז על חבירו"@he ;
    oa:hasSelector opp:unit_fol_129v_1_u1_selector ;
    oa:hasSource opp:passage_fol_129v_1 .

opp:unit_fol_139r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_139r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach,
        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והרי ירמיהו בא מבני בניה של רחב הזונה ויעשה לכם דברים של סיכים בעיניכם ולצנינים בצייכם לפיכך ברך הכת לומ דברי ירמיהו בן חלקיהו ר יהודה ור סימוז פתח נביא אקים להם מקדב אחיהם כמוך והכת ולאקם נביא עויד בישראל כמשה ואתה אומר כמוך אלא כמוך בתוכחות אתה מיצא כל מה שכת בזה כתוב בזה זה נתנבא מ שנה וזה נתנבא משנה זה נתנבא על יהודה וישראל וזה נתנבא על יהודה וישראל זה עמדו בני שבטו כנגדו וזה עמדו בני שבטו בנגדו זה הושלך ליאור וזה הושלך לבור זה ניצל על ידי אמה וזה נצל על ידי עבד זה בא בדברי תוכחות וזה בא בדברי תוכחות לפיכך צרך הכת לומ דברי ירמיהו בן חלקיהו ר תנחומא פתח ואמרי לה ר אלעזר בשם ר מאיר ור מנחמי ור ביבי ר אלעזר בשם ר מאיר אומר כל מקום שנ דבם דבר דברי דברים הם אלות ותוכחות כתוב אלה הדברים אשר דבר משה מה כתו תמן מחירעב ולחמי רשף דברי ירמיהו בן חלקיהו מה כת תמן אשר למות למות אמ ר תנחום בר"@he ;
    oa:hasSelector opp:unit_fol_139r_1_u1_selector ;
    oa:hasSource opp:passage_fol_139r_1 .

opp:unit_fol_142r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_142r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כהן בן כהן קנאי בר קנאי מכפר ברמכפר אוריה לא נבעוני הוא שנ וגם איש היה מתנבא בשם יי אוריה בן שמעיה מקרית יערים וכת ועריהם גבעון והכפיל וצריך הבת ליחסו שנ ואעידה לי עדים נאמנים יחזקאל לא מבני בניה של רחב הזונה הוא והוצרך הכתוב ליחסו היה היה דבר יי אל יחזקאל בן בוזי הכהן וירמיה לא מבני בניה שלרחב היה וצרך הכת ליחסו שנאמ דברי ירמיהו בן חלקיהו מן הכהנים אשר בענתות אמ ר ברכיה עשוק שמי בכהנים בימי משה שנ יברכך יי וישמרך ובימי ירמיהו וליקח מהם קכלה ובימי משה וישמרך ובימי ירמיהו אשר למות למות בימי משה יאר יי פניו ובימי ירמיה במחשכים הושיבני בימי משה ויחנך ובימי ירמיה אשר לא אתן חניכה בימי משה ישא יי פניו אליך ובימי ידמיה אשרלא ישא פנים לזקן בימי משה וישם לך שלים ובימי ירמוה אספתי את שלמי מאת העם הזה"@he ;
    oa:hasSelector opp:unit_fol_142r_1_u1_selector ;
    oa:hasSource opp:passage_fol_142r_1 .

opp:unit_fol_145r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_145r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לו אלתהי קורא לבני מורא מהו הדין לישנא מורא אמ ר ראובן כהדין לישנא צוח צחין לשטיא מוריא פעם אחת הקניטו וקרא אותוכן אמ לו המלך כד עצמי הייתי מצוה אותך ואומי לך אל תהי קורא לבני מוריא ואת קריליה כן לית עםהיה רמעריס מקלך עם שטיא כדכת וידבר יי אלמשה ואל אהרן ויצום מה צום אמ להם אל תהיו קורים לבנ מורים וליון שהקניטי על מי מריבה אמ להם משה שמעונא המורים אמ לו הקבה כל עצמ הייתי מצוה אותך ואומר לך אלתהי לבנ מורים ואתה קודים לכני מלים לית עלקיה דערים מהלד וים מורים לכן לא תבייו את הקהלהוה לאתביא ח ירתו כאן אלא לא תב או לא את ולא אחוך לא אחתך י וזרהא דישואל אמ הקבה לישראל אבותיכם לא מצאו בינונ אני אמרתי לכם זובח לאלהים יחרם ולא עשיתם כד אלאאת המשתחוים לגטת אמר הודה בר ר ימון אמ הקבה לישראל אב תיכם בימרבר מה מצאו בי עול חני אמרתי להם כשהוו דתו להם המש ששת ימים תלקניותו והם לא עלוכ אלה ויה ביום השביע יצאו מן הנם ללקוט ולא מצאו"@he ;
    oa:hasSelector opp:unit_fol_145r_1_u1_selector ;
    oa:hasSource opp:passage_fol_145r_1 .

