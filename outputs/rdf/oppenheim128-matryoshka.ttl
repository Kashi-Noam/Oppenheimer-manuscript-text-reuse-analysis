opp:unit_fol_185v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_185v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "אמרה לו אמו תנהו לי ואנשקהו קודם הריגת לחשר לה באודניה ואתרה ליה זיל אימא כליה לאברהם אבוך אלת ווחדעיתך עלי אתה עקדת בן אחד וכיא התתי ואם עקדתי שבעה ונהרגו לחדושת השם אפקוה וקטכה זיהיא ענתה לגג יהפילה עצמה עליהם ומנחה יבתה בזת קול ואמריה לה אם תבצים שמסה תנו רב עשה בר יהושע בז חנניה שרו ילכדך גדול של נוינו איי ט תינק אחד ישיבית האסורים יניה עינים וטור קווצתיו םדוחותלותל תלים הלך ופמד על פתח ביתהאכו יימ מי נתן למשסה יעקב וישראל לבוזזים וענה אורבו תינוק ואמ הלא יי זוחטאנו לו אמ מובטח אני בזה שיוקה הוראות בישראל העבודה שאיני זזמכאן עד שאפדנו בכל"@he ;
    oa:hasSelector opp:unit_fol_185v_1_u1_selector ;
    oa:hasSource opp:passage_fol_185v_1 .

opp:unit_fol_185v_1_u1_selector a opp:TokenPositionSelector ;
