opp:unit_fol_167v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_167v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לא ילדה שרה את יצחק אלא שפחתה ילדתו מה עשה להם הקבה הוביש חוטידדיהם של מטרוניות שלהן והיו באות ומתאבקות בעפר רגליה של שרה אמנו ואומ לשרה עשי עמנו מצוה והניקי את בנינו והיתה שרה נוהגת בעצמה דבר צניעות אמ אה אברהם אין זו שעת צניעות אלא שבי לך בשוק וקדשי שמו של הקבה וגלי דדיך להן כדי שיראו חסד וגבודה שעשה עמנו הקבה והיו דדיה לובעות חלב כשת מניינות ההד וברכתי אותה וגם נתתי ממנה לך בן שהו שכשתי בריכות שני דדיה והרי דברים קל וחומר ומה אם בשר ודם שבאת לו שמחה שמחוה כל עמו ישראל שהם יושבים ומצפים ליש לישועתו של הקבה זה כמה שנים וכמה ימים על אחת כמה וכמה שוש אשיש ביי זה היום עשה יי נגילה ונשמחה בו אמ ר אבין אין אנו יודעים במי נשמח אם ביום אם בהקבה עד שבא דוד ופירש אשמחה ואעלצה בך אמ בך בכב אותיות שכתבת לווי את התורה ב תרי כ עשרים תמן תנינן נשא אשה ושהת עמו עשרשנים ולא ילדה אינו רשאי לבטל"@he ;
    oa:hasSelector opp:unit_fol_167v_1_u2_selector ;
    oa:hasSource opp:passage_fol_167v_1 .

