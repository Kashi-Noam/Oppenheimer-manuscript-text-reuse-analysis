opp:unit_fol_77r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_77r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "האדם והבהמיה ייקראו אל אלהם בחהה מהו בחזקיר ראמ ר שמעון בן חלכיתא חציפא נצח לבישא בל שכן לטובית םילעולם וישובו איש מדדכו הרעה ומן האמנל אשר יחכפי אי ם יוחנה נו שהיה בכם ידיהם החזים יי ימת איה נשכו תילי ו צגדל לאהאזירו וקרעו בי יייה אמ ר יהושע בןלוי יחי םו צם בתשובה אין אתם קורעים בגדינם בויביניכם ונא על בנותיכם למה כי חלון ורחום היזאנך אמרשינרב אכד ויחם עבל הרעה אמ ר אחא בר הנהם בנ יייא בשםי ר והנן ירן אזכת כאן אלא ארך אפם שמאריך כויוו עם ידשע ם ועם דצד קים וגובה מהם מיעיוט מעשים רעים שעשו בעולם הזד בשנייל ליתן שנרם משלם לעתיד לבא אמ ר שמואל בר נקמני בשל יונתן ארך אין כת עאן אלא ארך אפים מאריך רוחו עד שש ייבה באלנכות מחלך וניבה ומאן דאמ יימשות ן תרוז בנ מעוהי אלא מאריך רוחו וגובה שלו"@he ;
    oa:hasSelector opp:unit_fol_77r_1_u1_selector ;
    oa:hasSource opp:passage_fol_77r_1 .

opp:unit_fol_77r_1_u1_selector a opp:TokenPositionSelector ;
