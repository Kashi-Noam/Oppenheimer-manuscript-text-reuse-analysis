opp:unit_fol_11r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_11r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "אמ ר יהושע בן לוי גדול הוא השלום שהשלום לארץ כשאור לעיסה אלמלא שנתן הקבה שלום בארץ היתה החרב והחיה משכלת את הארץ מה טעם דכת ונתתי שלום בארץ והשבתי חיה רעת מן הארץ ואין ארץ אלאאץ ישראל שנימ ואשרו אתכם כל הניים כי תמיו אתם ארץ חפץ ואומ הנה כל הארץ יושבת ושוקטת ואומ דור הולך ודור בא ורארץ לעולם עומדת מלבות באה ומלרו הולכת וישראל לעולם קיים אמ שלמה אעכ שדור הולך ודורבא מלכות הורכת ומלכות באה גזירה הולנת וגזירה באה ומתחדשת על שונאי ישראל הארץ לעולם עומדת ישראל לעולם עומדין לא נעז בין ולא כלין שנ אני יי לא שניתי ואתם בני יעקב לא כליתם כשם שאני לא שניתי ולא אני עתיד להשנות כך אתם בית יעקב לא כליתם ולא עתידין ליכלות אלא ואתם הדבקים ביי אלהיכם חיים כלכם היום תמן הנינא רשבג או על שלשה דברים העולם עומד על הדין ועל האמת ועל השלום אמ ר מונא ושלשתן דבר אחדהם נעשה הדין נעשה אמת נעשה שלום ושלשתן בפסוק אחד נאמרו שנ אמת ומשפט שלום שפטו בשעריכם"@he ;
    oa:hasSelector opp:unit_fol_11r_1_u1_selector ;
    oa:hasSource opp:passage_fol_11r_1 .

opp:unit_fol_11r_1_u1_selector a opp:TokenPositionSelector ;
