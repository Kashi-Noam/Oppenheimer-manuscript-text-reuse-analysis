    rdf:value "ביום השמיני עצרת תהיה לכם ר יודה בר סימו פתר בשם ר מאיר קריה בנרה תן חלק ל שבעה וום לשמנה אלו שמנת ימי מילה אמ הקבה אם שמרת שבעת ימי נדה כראוי הריני נותן לך בן ואתה מוט לח ימים שנ וביום השמיני ימול בשר ערלתי ר טי אמ תן חלק לשבעה אלו שמנת ימי החג וגם לשמונה שנ וביום השמיני עצרת כי רוצה יי בעמו יפאר ענוים בישועה ר יהושע דסכנין בשם ר לוי אמ ריצה הוא הקבה בקרבנו של"@he ;
    oa:hasSelector opp:unit_fol_81v_1_u2_selector ;
    oa:hasSource opp:passage_fol_81v_1 .

