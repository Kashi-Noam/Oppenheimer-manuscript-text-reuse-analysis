opp:unit_fol_7r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_7r_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "הלכו העצים למשוה עליהם מלך ויאמרו לזית גו ואומ ויאמרו העצים לתאנה גו ואומ ויאמרו העצים לגפן וכי העצים מבקשין מלך אלא כנגד ישראל הוא אומר שאמרו לניתניאל בן קנז ולדבורה ולגדעון שינהגו שררה על ישראל ולא קבלו כיוצא בו החוח אשר בכבנון ששלח אל הארץ אשר בלבנון תנה את בתך לבני יוכי ימה ענין נשואין יש בחוח ובארזים אלא בנגד שכם בן יומור ויעקב אבינו נאמר המשל הז וכן אתה מוצא בנביאים ובכתובים שודברו משלים במה דברים אמורים בדברי קבנה אגל בדברדי תורה ומצות אי"@he ;
    oa:hasSelector opp:unit_fol_7r_1_u1_selector ;
    oa:hasSource opp:passage_fol_7r_1 .

