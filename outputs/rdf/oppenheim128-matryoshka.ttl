opp:unit_fol_35r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_35r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Sekhel_Tov ;
    opp:earliestWitness opp:work_Midrash_Sekhel_Tov ;
    rdf:value "ותאמר חותמך ופתילך ומטך אשרבידיך אמ ר הונא נצנצה בהרוח הקדש חותמך זה המלכות כד כי אם יהיה בניהו בן יהויקים מלך יהודה חותם על יד ימיני ופתיל זו סנהדרין כד ונתנו על ציצית הכנף פתי ל תכרת וסנהדרין הם מקיימין כלם מצות ציצית ומטיך זה מלך המשיח כד מטה עזך ישלח י מציוו"@he ;
    oa:hasSelector opp:unit_fol_35r_1_u1_selector ;
    oa:hasSource opp:passage_fol_35r_1 .

