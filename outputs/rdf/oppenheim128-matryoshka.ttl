opp:unit_fol_80v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_80v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "ואם לא אטור לעולם אמרו כירמיה כך אמרנו לו שמתביישים אנו ממנו אמ לו הקבה לך אמורלהם אצל אביכם אתם חוזרים דכתוב בבכי יבאו ובתחנוכים אובילם אוליכם בדרך ישר לא יכשלו בה כי הייתי לישראל לאב ואפרים בכוריהוא לכך נאמ שובה ישראל עד ייי אלהיך כיכשלת בעוניך אמ ר סימון משל להר גבוה שעימד על פרשת דרכים והיו נכשלים בו בני אדם אמ המלך סתמו אותו קימ עא קימעא עד שיבא עתו ואני מעבירו מן הכגולם ההד והסירותי את לב האבן מבשרכם בך יצת הרע הוא מכשול בעולם הזה אמ הקבה בנוהג שבעולם אדם נבשל בעבירה והוא מתחייב עליה מיתה לשמים מת שורו או חמורו אבדה תרנ גולתו נשברה צליחיתו ניקף באצבעו מקצת הנפש חושב לו הקבה ככל הנפש לכך אמ שלמה אחת לאחת למצא חשבון מרובעראחת וה חשבון מתמלא קקו עמכם דברים ר יודה ור נחמיה ר יודה אמ לא בדברים פתיתם אותי אותי בסיני דכת ויפתוהו בפיהם ובל שונס יכזבו לו ואומ מיד והוא רחום וכפר עון ר נחמיה אמ קחו עמכם דברים דוברים בעלי דברים טובים קראין טבין"@he ;
    oa:hasSelector opp:unit_fol_80v_1_u1_selector ;
    oa:hasSource opp:passage_fol_80v_1 .

