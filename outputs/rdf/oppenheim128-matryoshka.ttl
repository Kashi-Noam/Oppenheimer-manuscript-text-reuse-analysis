opp:unit_fol_134r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_134r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר ארעזר ור שמעון אזלון חמריא לקרתיה בעי למזבן עבר וחמתיה יתיב קמי תנורא אימיה נשאה והוא אכיל אימיה נשאה והוא אכיל עמד עד דאכל כל אצותא דפתתא אמרין חוי דחיוא בישא שריא במעון דדין שמע קלהון מה עבד להון נסב חמר הון ואפקון לריש אגרא אזלון ואמרין לאבוי אמ להון דלמא מילא בישא אשמעתוניה אמרין ליה חמנאתיה יתיב קמיה תנורא אימיה נשאה והוא אכל אמיה נשאה והוא אכיל עד דאכיל כל אצותא דפתתא ואמרן ווי דחיוי בישא שרי במעוי דדין אמ להון דלמא מן דידכון הוה אכיל לא ההוא דבראתיה ברא ליה מזוניה אעמכ אזלין ואמרין ליה מן שמי והוא מחית יתהון הוה מסיק חדחד וממחית להון הוה מחית תריתרי ר אלעזר בר שמעון אתמאני ארכילי פארין קאטיל בר נשידהוה חייך קטולין והוה ר יהושע בן קרחא קרי ליה חלא בר חמרא לא קוצים יכסוחים כסחתי ולא בגמש דחייבין קטולין קטלית בגין דערקת ואזלית לך ללודקיא אמ ליה היה לר לברוח בסוף העולם ולהניח בעל הכרם שיקוץ את קוציו"@he ;
    oa:hasSelector opp:unit_fol_134r_1_u1_selector ;
    oa:hasSource opp:passage_fol_134r_1 .

opp:unit_fol_134r_1_u1_selector a opp:TokenPositionSelector ;
