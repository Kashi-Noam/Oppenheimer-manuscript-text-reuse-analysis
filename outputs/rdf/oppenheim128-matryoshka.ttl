opp:unit_fol_126v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_126v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לבישא אמ ליה מה את מבאה מלכותא אית בר נש דלבים לבישא דסלכא דלא סחי אזל בעי ספרא וכא אשכחיה מה עצד אסר זוניתיה ואסחיתיה כיון דנפק אמ ליה מה את מבזה מלכותא איש בר נש דלבש כלילא דמלכא דלא מספר אזל בעי ספרא ולא אשכחיה מה עבד אזל לביתיה ואחתיה מני ספרא ויתיב ליה מספר ליה שרי מתנח אמ ליה מה לך מתנח אמליה וויליה לאבוי דההוא גברא מעבר קומיס פנאטון קומיס קכטון נעביד בלנאיי וספרא אמ לו ומה היא שאולה לך אנא חכים דאבנד הוה בלנאי וספר בכפר קריינוס ואת מנשכח דאלין מאני ספרא מיניה ודידיה אמ ליה קום רכיב על הדין סוסיא אמ ליה לית בי חילא דאנא גבר סב אמ ליה"@he ;
    oa:hasSelector opp:unit_fol_126v_2_u1_selector ;
    oa:hasSource opp:passage_fol_126v_2 .

opp:unit_fol_126v_2_u1_selector a opp:TokenPositionSelector ;
