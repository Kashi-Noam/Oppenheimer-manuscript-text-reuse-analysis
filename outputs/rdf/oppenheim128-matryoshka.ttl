opp:unit_fol_136r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_136r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ודיניז מאחחרייהי שנ ואלה המלפטים אשר תשים לביניהם פב יודעי מרת נפשו ובשמחתו לא יתערב זו אינר יולף למיייצמרח רח ונר כיננ סול הנוי מפני שהנפש יודעת שהיא נדונת בה ומאי טעמיה על דשעים פחים אש וגפרית ורוחזלועפות מנת כוסם מהו מנת כוסהי אמ ר שמואל בד וחמז בשם ר יונתז שיפלשאנייטיכרין של אחר המידץ דא לב יודע מדת נפשו אלו ישראל ומשמחהו לא יתערב זר זה יתרו שנ וישלן משה את חותנו ולך לו אל ארצו מה כת בתריה בוש השלישי"@he ;
    oa:hasSelector opp:unit_fol_136r_2_u1_selector ;
    oa:hasSource opp:passage_fol_136r_2 .

