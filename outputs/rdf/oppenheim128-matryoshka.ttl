opp:unit_fol_130v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_130v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כי קרוב הא קחב הא לנני לפורעםנותו של פרעה הרשע שנפרע הקבה ממנו דא כי קרוב הוא קרובה היא פורענותה שלמצרים שנפרע מהם הקבה רא כי קרוב הא קרוב הוא הרסד שעשו הכנעניים עם אבינו יעקב שנ וירא יושב הארץ הכנעני את האבל בנרקן האטד ר אלעזראמ על ידי שהתירו אזוריהם ור שמעוין בן לקיש אמ על ידי שהתירו קשרי כתנותיהם ורבנן אמרי על ידי שזקפו קומתן נ ר יודן אמ על ידי שהראו באצבעותיה והרי הדברים קל וחומר ימה אם הכנעניים שלא עשו חסר לא בידיהם ולא ברגריהם נצולו מן הפורענות אחינו ישראל שהם עושים חסד עם גדוליהם ועם קטניהם ועם חכמיהם ועם תלמידיהם לא כל שכן שיהיו נצלים מן הפורענות דא כי קרוב הואר קרובה היא השביעה שהשביע אבימלך את אבינו אברהם שנ ועתה השבעה לי באלהים הנה עד כמה דורות השביעו עד גדוחת השביעו שנא אם תשקר לי ולניני ולנכדי"@he ;
    oa:hasSelector opp:unit_fol_130v_2_u1_selector ;
    oa:hasSource opp:passage_fol_130v_2 .

opp:unit_fol_130v_2_u1_selector a opp:TokenPositionSelector ;
