    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_58v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_58v_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "בשעת פטירתי של ר אלעזר בן עזריה נכנסו תלמידין לבקרו וישבו לפנו אמרו לו רבינו למדנו דבר אחד בלבד אמ להם בני מה אלמד אתכם צאו והזהרו כל אחד בכבוד חברו ובשעה שאתה עומדים להתפלל היו יודעין לפני מי אתם עימדון ומתפללין ובשביל דבר זה תכנסו לחיי העולם הבא חמשה דברים למדנו מר אלעזר בשעת מיתתו ושמחנו בהן שמחה גדולה יותר ממה ששמחנו בחייו ואלו הן הנדור והאימום והקמיע ותפלין וכסת ענלה שמקבל ין טומאה ומטבילין אותן במה שהן צאו והזהיו בהן שהלכות גדוליתהן שנאמרו לו למשה בסיני"@he ;
    oa:hasSelector opp:unit_fol_58v_1_u2_selector ;
    oa:hasSource opp:passage_fol_58v_1 .

opp:unit_fol_58v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "193"^^xsd:nonNegativeInteger ;
    oa:start "105"^^xsd:nonNegativeInteger .

opp:unit_fol_59r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_59r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לעולם תהא נאה בכניסתך ונאה ביציאתך ותהא ממעט בעסה ועסוק בתורה מעשה בר שמעון בן אלעזר שבא ממגדל עדר מבית רבו והיה רכוב על החמור ומטייל על שפתהים ומצאו אדם אחד שהיה מכוער ביותר אמ לו ריקה כמה מכוערין בניו של אברהם אבינו אמ לו ומה אעשה לך לך ואמור לאומן שעשאני מיד ירד רשמעין בן אל עזר מן החמיר ונשתלוח לפניו ואמ לו נעניתיל מחול לי אמ לו אין אני מוחל לך עד שתלך לאומן שעשאני ותאמר לו כמה מכועגר כלי זה שעשית הלך אחריו חצי מיל שמעו בני עירו ויצאו לקראתו אמיו לו שלום עליך ר אמ להם למי אתם קורין ר אמרו לו לזה שמטייל אחריך אמ להם אם זה ד ל ירבו נ וותה בישראל אמרו לו חס ושלום ומה עשה לך אמ להם כןך וכך אמ לי אמרו לו אעככ מחול לו אמ להם מהול לו הריני מוחל לו ובלבד שלא יהא רגיל לומר כן"@he ;
    oa:hasSelector opp:unit_fol_59r_1_u1_selector ;
    oa:hasSource opp:passage_fol_59r_1 .

