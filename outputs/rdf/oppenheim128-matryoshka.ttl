    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_65r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_65r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "הסכנה והשותה מהנחלים ומהנהרות ומהמדברות בפיו ובידו אחת דמו בראשו מפני הנימא הקיז דם וישב בתענית הרי זה דמו בראשו כותבי ספרים תפלין ומזוזות הן ותגריהן ותגרי תגריהן אינן רואין סימן ברכה לעולם תגרי דגים טמאים וחלב טמא אינן רואין סימן ברכה לעולם המשתכר בקנים ובקנקנים אינו רואה סימן ברכה לעולם ר עקיבא אומ העושה מלאכה בערבי שבתות ובערבי ימים טובים מתשע שעות ולמעלה אינו רואה סימן ברכה לעולם העושה מלאכה בתשעה באב אינו רואה סימן ברכה לעולם ר עקיבא ותלמידי חכמים היו יושבין תחת הזית על שלחנו מפניהחמה והיו אומרין קוצצי אילנות ומגדלי בהמה דקה ותגרי סימטא אינן רואין סימן ברכה לעולם המוכר את ספרו אעפ שא ינ צריך לו והמוכר את בתו אעפ שאין לו מה יאכל אינו רואה סימן ברכה לעולם ר יצחק אומ מוליך קורצין הרי זה משופכי דמים שנ לא תלך רביל בעמך ר אליעזר אומ השונא את חברו הרי זה משופכי דמים שנא וכי יהיה איש שונא לרעהו וארב לו וקם עליו"@he ;
    oa:hasSelector opp:unit_fol_65r_1_u1_selector ;
    oa:hasSource opp:passage_fol_65r_1 .

