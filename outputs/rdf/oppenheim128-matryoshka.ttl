opp:unit_fol_79v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_79v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הא כרסי קמך בזעה אמ כיה ובהדה את סבר למיפק אותו חנוני שהיה פקח מה עשה נטלו וכרכו במחצלת והשליכו על פתח החנות לכל מאן דהוה עבר תמן אומר זכו בהדין מיתא דהוו בעיין מזכ ליה לקבורה אתא חד ברח פחיז אמ ליה עד אימתי להדין כדין עד דמדכי מחשר פרוטוי וכיון דאתפשר פריטוי אמ ליה קום אזיל לחבריה דההוא גברא דהגה סופיה ביש ההד ודע לי על כל אלה יביאך האלהים במשפט ר אליעזר בנו שלר יוסי הגלילי אמ אמרו ישראל לפני הקבה רבונו של עולם אם עושים אנו תשובה לפניך מי מעיד עלינו אמ להם לרעה אני נעשה עד וכת וקרבתי אלינם אליכם למשפט והייתי עד ממהר במכשפים ובמנאפים ובטובר לא אהיה לכם עד לאחב בן קוליה ולצדקיה בן מעשיה נעשיתי עד ולכם בטובה איני נעש עד אלו"@he ;
    oa:hasSelector opp:unit_fol_79v_1_u1_selector ;
    oa:hasSource opp:passage_fol_79v_1 .

opp:unit_fol_79v_1_u1_selector a opp:TokenPositionSelector ;
