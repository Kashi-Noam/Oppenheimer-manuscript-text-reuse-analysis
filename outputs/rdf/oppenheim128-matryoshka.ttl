    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר סימאי בנוהג שבעולם חתן דר אצל חמיו ועובר לצאת מבית חמיו אפשר שלא ימצא בידו אפי דבר קל חה אפי מחט אפי סכין לא נמצא בידו ההד כי מששת את כל כלי מה מצאת מכל כלי ביתיך אמ הקבה חייך בל שון שהונחת את חמיך בו בלשון אני מיכיח את בניך שנא כה אמר יי מה מצאו אבותיכם בי עול ושומנ לי ישכן בטח ארבעה שומעים הם שמעג והפסיד י שמע ונשכר שלא שמיג ונשנר שלא שמע והפסד שמעג והפסיד זה אדם הראשון שנ ולאדם אמד כי שמעת לקול אשתך ומה הפסיד כי עפר אתה ואל עפר תשוב שמע ונשכר זה אבינו אברהם שנ כל אשר תאמר אליך שרה שמינ בקולה ומה נשכר כי ביצחק יקרא לך זרע לא שמע ונשכד זה יוסם שנ ולא שלמרג אליה לשכב אצלה ומה נשכר השליט שכלו על יצרו שנ ויוסף הוא השליט דא לא שמע והפםי אלו ישראל ולא שמעו ורא הטו את אזנם ומה הפסידו אשר למות למות אמ ר לוי האזן לגיף כקנקן לכלים מה הקנקן הזה כשהוא מעשן את שתחתיו וכלם מרגישים כך הטו אזנכם ולכו אלי שמעו ותחינפשכם"@he ;
    oa:hasSelector opp:unit_fol_143r_1_u1_selector ;
    oa:hasSource opp:passage_fol_143r_1 .

opp:unit_fol_144v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_144v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כך נכנסו כל הדורות אבל אדם הראשון אמרו לו שמא הקבה עבר עליך מדת הדין אמ להם חס ושלום אני הוא שורמתי מיתה לעצמי כך וכך היה מצוה אותי ואומר לי מכל עץ הגן אכלתאכל ומעץ הדעת טוב ורע צוני שלא לאכול ממנו וכיון שעבר על דבריו גרמתי מיתה לעצמי שנכיביום אכלך ממנווכו אני הוא שגרמתי מיתה לעצמי פרעה לא מצא בי עול ואתם מצאתם בי עול למה היה פרעה דומה למלך להלך למדינת הים וכנס והפקיד כל מה שהיה לו אצל בח ביתו לאחר ימים בא המלך ממדינת הים ואמ לבן ביתותן לי מה שהפקרתי אצלך אמ ליה לא עבדך אנא ולא אפקדת גבי כלום מה עשה לו המלך נטלו ותלאו בורדין ואמ ליה עבדך אנא וכל מאן דאפקדת גבי אנא משלם לך כך כתחלה אמ הקבה למשה ועתה לכה ואשלחך אל פרעה אמ לו אותו רשע מי יי אשר אשמע בקולו לא ידעתי את יי וכיון שהביא עלינ עשר מכות אמר יי הצדים ואני ועמי הרשעים מצא לא מצא ביעול ואתם מצאתם בי עול למה היה משה דומה למלך שמסר את בנו"@he ;
    oa:hasSelector opp:unit_fol_144v_1_u1_selector ;
    oa:hasSource opp:passage_fol_144v_1 .

opp:unit_fol_146v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_146v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כך גלו עשחת השבטים וההחינ הקבה אומר עליהם את הפסוה הזה איו להם אוז להם כיכידו ממנו וכ ון נגנו שבט יהודה ובני כביכול אמ הקבה אוי לי על שברי נחלה מכתי ור שמעון בן לקיש משל למלך שהיו לו שני בנים כעס על הראשון ונטל את המקל וחבטו ופרפר ומת אמ המלך אין בי כח לקונן עליו אלא הראו למקוננות ויקוננו עליו רה גלו עשרת השבטים התחיל הקבה מקונן עליהם שמעו את הדביירזה וכיון שגלו שכט יהודה ובנימן כביכול אמ הקבה אני חין בי כח נקונן עליהם אלחרראו למהיונות ויקוננו עליהם ההד כה אמר יי נבאות התכוננו וקראו למקוננות ותמהרנה ותשנה עלינו נהי עליהם אין כת כאן אלאותשנה עלינו דידי ודידהון ותרדנה עיניהם דמעה איןכת כאן אלא ותרדנה יניניכו דידי ורידהון ועפעפיהם יזלו מים אין כת כאן אלא ועפעפינו דידי ודידהון ורבנן אמ משל למלך שהיו לו יב בנים מתו שנים התחינ מתנחם בעשרה מתו עוד שנים התחיל מתנחם בשמנה וכיון שמתו כלם התחיל מקונן עליהם איכה ר אבא ברנתנא כתח מיראיש החנם ויבן את את ואשר דנר פייי ויגידה תני ר שמעון בן יוחאי אם ראית עיירוה נהלשות ממקומם בארץ י שלא החזיקו בשכר משנים ומאי טעמיה על מה אבדה הארץ ויאמר יי על עזבם את"@he ;
    oa:hasSelector opp:unit_fol_146v_1_u1_selector ;
    oa:hasSource opp:passage_fol_146v_1 .

opp:unit_fol_146v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_146v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר הוה משלח לר יסא וכר חמא כמבדק קריתיה רארנו רישראל והיו נינין לקרניה וזאמרין להון איכון להין נשוה וקרתא נהויל והוין מייתין כהון ריש מטרתא וסנטרא והוו אמרין להון אלין נטורי קרתא אלין אינון חרובי קרתא והלין אנון בטורי קרתא אלין סופרים ומשנים שהם משמרים בינם ובליכה על שם והגית בו יומם ולילה וכן הוא אומ אם י לא יבנה בית שוא עמלו בוניו בו ר הונא ור ירמיה בשם ר שמואל אמ מצינו שויתר הקבה על עש ועל גלוי עריות ועל שפיכות דמים ולא ריתר על מאסה שלקורה שכא ויאמר יי על מה אבדה הארץ על עז ועל גליי עריות ועל שפיכות דמים אין כת כאן אלא על עזבר את תורתי ר הונא ור ירמיה בשם ר חייא בר אבא אמ כת ואותי עזבו מקור מים חיים מתוך ותורתי לא שמרו אלואי אותי עזבו ותורתי שמרו שאלו עזבו אותי ותורתי שמרו מתוך שהיו מתעסקים בה השאור שבה היו מחזרין אצלי רבהונא אמ יכמוה וזם תורה אעפ שלא לשמה שמתוך שלא לשמה בא לשמה אמ ר יהושע בן"@he ;
    oa:hasSelector opp:unit_fol_146v_2_u1_selector ;
    oa:hasSource opp:passage_fol_146v_2 .

opp:unit_fol_147r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_147r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Eichah_Rabbah ;
    rdf:value "אמ ר אבא בר כהנא לא עמדו פילופוסים באומות העולם כבלעם בן בעור וכאבני מוס הגרדי אמ להם יכולים אתם להזדגו להזדווו לאומה זו אמרו להם לכו חזרו על כל בתי כעסיות ועל כל בתי מדרשות שלהם אם מצאתם שם תינוקות מצפצפים בקוכם אין אתם יכולים להזדווג להם ואם ראו אתם יכולים להזדווג להם שכך הבטיחם אביהם הקול קול יעקב והידים ידי עשו כשיעקב מצפצף בבתיכנסיות ובבתי מדרשות אין הידים ידי עשו וכל אמן שאן קולו של יעקב מצכבף בבתי כנסחת ובבתי מדרשות הידים ידי עשו שמואל אמ וצבא תנתן על התמיד בפשע בפשעה שלתורה אימתי כשישרל משלכין דברי תורה לארץ מלכות הרשעה הזאת גוזרת ומצלחת ומאי טעמיה ותשלך אמת ארצה ואין אמת אלא דברי תורה כדא אמת קנה ואל תמכור אמ ר יודה בר סימון זנח ישראל טוב אויב ירדפו ואין טוב אלא דברי תורה כדא כי לקחטוב נתתי לכם וכן הוא או לכן כאכול קש לשון אש וכ יש קש אוכלת אש אלא דרכה של אב להיות אוכלת קש ואתה אומ כאכול קשל שון אש אלא קש זו ביתו של עשו שהוא נמשל בקש דכת ובית עשו לקש"@he ;
    oa:hasSelector opp:unit_fol_147r_1_u1_selector ;
    oa:hasSource opp:passage_fol_147r_1 .

opp:unit_fol_148r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_148r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר יהודה בר סימון מימיו לא לן אדם בירושכם ובידו עון האכאי זה צד תמיד של שחר היה מכפר על עבירות שנעשו ביום מכל מקום לא לן אדם בירושלם ובידו עח מאי טעמיה צדק ילין בה ועתה מרצחים הא עבידין קטולין הרגו את אוריה ואת זכריה ר יודן שאל לר אחא בהיכן הרגו את זכריה בעזרת נשים או בעזרת ישראל אמ ליה לא בעזרת ישראל ולא בעזרת נשים אלא בעזרת כהנים ולא נהגו בדמו לא כדם הצבי ולא כדם האיל תמן כתו איש איש מבית ישראל אשר יציד ציד חיה ברם הכא כי דמה בתוכה היה כלכך למה להעלות חמיה וננקום נקם נתתי את דמה א עבירות עשו ישראל באו היום הרגו כהן ונביא ודין ושפיכו דם נקי וחללו את השם וטמאו את העזרה ויום השבת ויום הכפורים היה וכיון שעלה נדור נכוזר"@he ;
    oa:hasSelector opp:unit_fol_148r_1_u2_selector ;
    oa:hasSource opp:passage_fol_148r_1 .

opp:unit_fol_149v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_149v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ותעזבי אביך ואמך וארץ מולדתך וו שכינתך דא ותעזבי אביך ואמך חו עא שלך נשנ אומרים לעץ אבי אתת וארץ מוכדתך זו אפרכאו שלך ותלכי אר עם אשר כא ידעת תמול שלשם כא הייט מקבלים אותך שעדיין לא כתחדשה הלכה עמוני ולא עמינית מואביולא מאבית ישלם ייפעלך אמ לה מי שהוא עתיד ליתן שכרן של צדיקים הוא יתן שכרך ותהי משכרתך שלמה אמ ר יוסי אמ לה שלמה יעמד ממך מעםייי אמר אבח כנכים לרץ יכפים לשחר יכנכם בנפים לשמשכנפם לכרובים כנפים לחיתי בנפינם לשרפים כנפים לארדץ שנ מכנף הארץ כנפים לשחר שנ אשא כנפי שחר כנפים רשמש שנ וזרחה לכם יראי שמי שמש צדקה ומרפא בכנפיה כנפים לכרובים שנ וקול כנפי הכרובים כבפים לחיות שנ וקול כנפי החיות כלפים לשרפים שנ שרפים עומדים ממעל לו שש כנפים ששכיפים לאחד גדול כחן של גומלי חסדים שאינן חסים לא בצל כפי שחר ולא בצל כנפי שמש ולא בצל כנפיכרובים ולא בצל כנפיהיות ולא בצלכנפי שרפים אלא בצל כנפיו שלהקבה ההד מה יקר חסדך אלהים ובניאום בצל כנפיך יחסיון ותאמר אני אמצא חן בעיני אדני כי נחמתני ויאמר לה"@he ;
    oa:hasSelector opp:unit_fol_149v_1_u1_selector ;
    oa:hasSource opp:passage_fol_149v_1 .

opp:unit_fol_153r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_153r_1#u2" ;
    opp:closestWitness opp:work_Midrash_Aggadah,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לנחמה אומ לו מה בידך מי אלכמוך נושא עון ועובר על פשע אמ שאמרת בכשע יעקב איזו מהן לאמין ילך נחום לנחמה אומ לו מה בידך כי לאיוסיף לעבר בד עיד בליעל כלה נכרת אומ לו אמש אמרת ממך צאמושב על יי רעה יועץ בליעל איזה מהן נאמין ילך חבקוק לנחמה אומ לו מה בידך יצאת לישע עמך אומ ל אמש אמרת עד אנה יי שועתי ולא תשמע איזה נאמין הלך בפניה אומ לו מה בידך אמ לו בעת ההיא אחפש את ירושלם בנרות אומ לו אמש אמרת יום חשר ואפלה איזו מהן נאמין ילך חגי הומ לו מה בידך העוד הזרע במגורה אמש אמרת פנה אל הרבה והנה מעט איזה מהן נאמין זכריה אמ וקבף אני קוצף על הגוים השאננים אומ לו אמש אמרת הבף יי על חבותיכם קצף איזה מהן נאמין ילך מלאכי אומ לו מה בידך ואשרו אתכם כל הגוים כי תהיו אתם ארץ חפץ אומ לו אמש אמרת אין לי חפץ בכם חוזרים אצל הקבה כלם ואומ אינה מקבלת ממנו אומר להם"@he ;
    oa:hasSelector opp:unit_fol_153r_1_u2_selector ;
    oa:hasSource opp:passage_fol_153r_1 .

opp:unit_fol_154v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_154v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר סימון הא חסלא הא מסכתא דאמרת על ירמיה שאמ כי אספתי את שלומי מאת העם הזה נאם יי את החסד ואת הרחמים השכח חנות ל אם קניץ באף רחמיו סלה השכחת חניותי על פי יי יחנו וער פי יי יסעו השכחת חניותיך אל אהל מועד והגלגל ונוב ושילה ובית עולמים שנים השכחת שאתה חנון ורחום אעפכ קפץ באף רחמיו סלה אמנ דהוא כעם רחמוי קריבין ואת אמרת עז בני ושכחני ההד ותאמר ציוץ נסבני יי ויי שכחני ואמר חלותי היא שנות ימין עליון אמ ר אלכסנדראי עד שלא חלינו פניך בתשובה נשנית ימין עליון אמ ר שמזאל בר נחמני נתחללה אותה שבועה שנשבעת ליכו בחורב ונשנית הימין אמ ר סימון השמעת מימיך גלגל חמה חולה ואינויכול לשמש נלגל לבנה חולה ואינו יסל לעלות לשמשיו אן רלים חליים ולפניו ישחליים איד ר יצחק משל לגזבר שהוא שרוי במדינה והיו בני המדינה בוטחים עליו ואומ אם יבאו גייסות לרו כשהוא יוצא ומראה לנו פנים מיד הם חוזרים פעם אחת הקניטוהו ובאו הגייסות לעיר"@he ;
    oa:hasSelector opp:unit_fol_154v_1_u1_selector ;
    oa:hasSource opp:passage_fol_154v_1 .

