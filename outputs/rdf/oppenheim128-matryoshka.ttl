opp:unit_fol_100v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_100v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma_Buber,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר יודן גדול כחן של נביאים שהם מדמים דמית גבורה של מעלה לדמות אדם שנ ואשמע קול אדם בין אולי אמ ר יהודה בר סימון ואית קרא חורי מחוור יתיר מן הדין שנ ועל דמות הכסא דמית כמראה אדם עליו מלמעלה ועוז פניו ישנא שהוא משנה מדת הדין למדת רחמים על ישראל דא מי כהחכם זהיאדם הראשון דכת ביה אתה חותם תכנית מלא חכמה ומי יודעפשר דבר שפירש שמות לכל שנ ויקרא האדם שמות חכמת אדם תאיר פניו אמ ר לוי בשם ר שמעון בן לקיש תפכוח עקבו של אדם הראשון היה מכהה גלגל אמה ואל תתמה על זה אדם עושה דסקרין של מים אחד לו ואחד לבן ביתו נאההוא לו שיעשה את שלו נאה כך אדם הראשון נברא לשל הקבה ולא כל שכן שיהא תפיח לקיבו שלו מכהה גלגל חמה ומה אם תפוח עקיבו כך קלסתרפניו על אחת כמה וכמה ר לוי אמ בשם ר חמא בר חנינא ינ חופית קשרלו הקבה בגן עדן ההד בעדן גן אלהים היית כל אבן יקרה מסנכתך אדם מטדה וגו ר שמעון בן לקיש אמ יא ורבנן אמ עשר ולא פליגי מאן דעביד להון יג עבד כל אבן יקרה מסוכתך"@he ;
    oa:hasSelector opp:unit_fol_100v_1_u1_selector ;
    oa:hasSource opp:passage_fol_100v_1 .

opp:unit_fol_108r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_108r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma_Buber,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אני ישנה מן הגאולה ולבי ולבו של הקבה ער לגאלני אמ ר חייא בר אבא קיכן מצינו שנקרא הקבה לבן של ישראל שנ צור לבבי וחלקי אלהים לעולם דא קול דודי דופק זת משה שנ ויאמר משה כה אמר יי כחצות הלילה פתחי לי אמ ר יוסי אמ הקבה לכנסת ישראל פתחילי פתא כחרינ שלמחט ואני אפתא לכם פתח שיהיו אהליות ובצוצריות יכולין להכנס בהן אחתי במצרים שנתאחו לי בשתי מצות בדם פסח ובדם מילה רעיתי יבים שנתרעו לי בים ואמרו לי יי ימלך לעילם ועד יונתי תמתי במרה שנצטוו לי מצות כיונה בציצית ובתפלין תמתי בסיני שנתממו לי בסיני ואמרו כל אשר דבר יי נעשה ונשמעג ר ינאי אמ תומייתי לא אני גדול ממנה ולא היא גדולה ממני אמ ר יהושע דסכני בשם ר לוי מה התאומים הלל אם חושש אחד מהם בראשו וחבירו מרגיש כך אמ הקבה עמו אנכי בצרה שראשי נמלא טל שנ גם שמים נטפו קווציתי רסיסי כילה גם עבים נטפו מים אימתיך בחדש הזה שנ החדש הזה לכם ראש חדשים קול דודי הנה זה בא מדלג על ההרים מקפץ על הגבעית"@he ;
    oa:hasSelector opp:unit_fol_108r_1_u1_selector ;
    oa:hasSource opp:passage_fol_108r_1 .

opp:unit_fol_116r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_116r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אלו שהן ברשותך שור שה כשבים ושה עזים אלו שאינן בתשותך איל וצבי ויחמור ואקו ודישון יתאו וזמר שמא הטרחתי עליך שתהא מחזיר בהרים בגבעות שתביא לפני מאלו שאינן ברשותך והלא לא אמרתי לך אלא מהן שברשיתך מן הגדל על אבוסיך הוי אם ארעב לא אמר לך אמ ר יצחק כתו את קרבני לחמי לאשי וכי ישלפני אכילה ושתיה אם תאמר שיש רפני אכילה ושתיה למד ממלאכי וממשרתי משרתי אש לוהני ומהיכן הן ניזונין אמ ר יודן בשם ר יצחק מזיו שכינה הם נזונים ההד באור פני מלך חיים אמ ר יצחק בשם ר חגי ההד ואתה מחיה את כלם ואת מנחיה לכולא אמ ר שמעון בן לקיש כה עולת תמיד העשויה בהר סיני וכי יש לפני זכילה ושתה למד ממשה דכתוב ביה ויהישם עם יי ארבעים יום וארבעים ליכה לחם לא אכל ומים נא שתה חמתי אכל חמתי שתי ומה אםם משה שהלך בשליחותי עמד ארבעים יום וארבעים לילה לחם לא אכל ומים לא שתה וישלפני אכילה ושתיה הוי אם ארעב לא אמר לך אמ ר חייא בר אבא בר יותי אינן צריכין לבריותי יאני צריך"@he ;
    oa:hasSelector opp:unit_fol_116r_1_u1_selector ;
    oa:hasSource opp:passage_fol_116r_1 .

opp:unit_fol_127r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_127r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Sifrei_Aggadah_on_Esther ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "יי אלהי שועתי אליך ותרפאני יי העלית מן שאול נפשי חיתני מירדיבור תלמידו מה היו אומ זמרו ליי חסידיו והודו לזכר קדשו כי רגע באפו חיים בר צונו בערב ילין בכיולבחר רנה אותותני מה היה אומ ואני אמרתי בשלוי בל אמוט לעולם יי ברצונך העמדת להרריעא הסתרת פניך הייתי נבהל אסתר מה היתה אומ אליך י אקרא ואל יזיאתחנו מה בצע בדמי בר דתי אל שחת היודך עפר היגיד אמתך ישראל מה היו אומ שמעג יי וחנני יי היה עוזרלי הפכת מספדי למחול לי פתחת שקי ותארני שמחה אמ ר פנחט בקרית עמע היה עסוק ולא הפסיק שנ למעז יזמיך כבוד ולא ידום יי אלהי כעולם אודך ויהי דשלק פרעה את העם ברצות יי דרכי איש גם אויביו ישלים אתו ר מאיר אומ זה הכלך ור יהנשע בןלוי אמ זה הנחש ור מאיר אומ זה הכלב רעוא חלבון אתא חויא דאכל מיניה חמתיה כלבא יתבין למיכל שר נבח בהון ולא אותבינון אתא קם ואכל מיניה ומית וקברוניה ועברון ליה"@he ;
    oa:hasSelector opp:unit_fol_127r_1_u1_selector ;
    oa:hasSource opp:passage_fol_127r_1 .

opp:unit_fol_23v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_23v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "היום קדוש הוא ליי גו ואומ ואדעה כי מניות הלוים לא נתנה ויברחו איש לשדהו הלוים והמשוררים עושי המלאכה ואריבה את הסגנים גו וכל יהודה הביאו מעשר הדגין והתירוש והצהר לאוצרות הא למדת שכל התירה מתקיימת על ידי אוצרו של הקבה ביום השמיני עצרות תהיה לרם כת יספת לגוי יי יספת ליוי נכבדת רחקת כל קצוי ארץ נתת שולטנות לפרעה הרשע שמא קראך י לא בחירופין ובגדופין אמר מי יי אשרא שמע בקולו נתת שלוה לסנחריב שמא קראך יי לא בחירופין ובגדופין אמ מי בכל אלהי הארצות אשרהצילו את ארצם מידי כי יציל יי את ירושלם מיד נתת שלוה לנבוכד שר שמא קראך יי לא בחירופין אמר ומאן הוא די ישזבינון מן ידי דבר אחר יספת לגוי יי נתת שלוה לדוד ברכך שנ ויברך דוד את יי לעיני כל הקהל נתת שלוה לשלמה בנג ברכך שנ ברוך יי אשר נתן מנוחה לעמו ישראל נתת שלוה לדניאל ברכך שנ ענה דניאל ואמר ליהוי שמיה די אלהא מבקך מן עלמא ועד עלמא גו רחקת כל קצוי ארץ אמ ר לוי קרבת קרוביך ורחקת רחיקיד קרבת קרוביך דכתוב קרוב יי לכל קוראיו ורחקת רחיקיך דכת רחו מרשעים יי"@he ;
    oa:hasSelector opp:unit_fol_23v_1_u1_selector ;
    oa:hasSource opp:passage_fol_23v_1 .

opp:unit_fol_85v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_85v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר חנין טעמיה דר נחמיה כהדא עששיתא דקנדילא ומיא ומשחא מעורבין כחדא והיא דלקא מן גבהון ההד ויהי ברד ואש מת מתלקחת מהו מתלקחת אמ ר יהודה בר סימן מיתה מתקהה לעשות שניחותה אמ ר אחא משל למלך שהיו לו שני לגיונות קשים והיו רבובים זה לזה וכיון שהגיע מלחמתו שלמלך עשי שלים ביניהם כך אש וברד רביבים זה לוה וכיון שהגיעה מלחמתו של הקבה במצרים עשה שלום ביניהם והלכו ועשו מלחמתו שלהקבה במצרים שנ ויהיבהי ואש מתלקחת נם בתוך נם בנרטרה שעטרה לו אמו אמ ר יצחקחזרנו על כל המקרא ולא מצינו שעשתה בת שבע עטרה לבנו שלמה אלא זה אהל מיועד שהוא מעוטר בתכלת וארגמן ובתולעת שני אמ ר הוניא שאל ר שמעון בן יוחאי את ר אלעזר בר יוסי אמ ליה איפשר ששמעת מאביך מהו בעטרה שעטרה לו אמי אמ כיהן אמ לו משל כילר שהיתה לו בת יחידוה והיה אוהבת אותה יותר מדאי לא זז מח מחבבה עד שקורא אותה אחתי לא זז מחבבה עד שקורא אות אמה כתחכה חבב הקבה את ישראל במצרים והיה קורא אותה בת שנ שמעי בת וראי"@he ;
    oa:hasSelector opp:unit_fol_85v_1_u1_selector ;
    oa:hasSource opp:passage_fol_85v_1 .

