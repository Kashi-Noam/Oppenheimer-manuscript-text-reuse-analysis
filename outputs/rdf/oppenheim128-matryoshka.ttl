opp:unit_fol_168v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_168v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "וההיום עשה יי נגילה ונשמחה בו אמ ר אבין אין אנו יודעים במי נשמה אליביום אם בהקבה עד שבא דוד ופירש אשמחה ואעלבה בך אמ בך ברב אותיות שכתבת לנו את התורה ב תרי כ עשרים תמן תנינן נשא אשה ושהת עמו עשר שנים ולא ילדה אינו רשאי לבטל פריה ורביה גרשה מותרת לה גשא לאחר ורשאישכי לשהות עמה עשל שנים אם הפילה מונה לה משעה שהפיכה"@he ;
    oa:hasSelector opp:unit_fol_168v_1_u2_selector ;
    oa:hasSource opp:passage_fol_168v_1 .

