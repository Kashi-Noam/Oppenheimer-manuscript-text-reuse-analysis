opp:unit_fol_26v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_26v_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "יוצאין אשורים ודודנים בארץ ישראל זורקין לתוכה שלום ואליהו מבשר לפניהם שלום שנ והיה זה שלום אשור כי יבא בארצנו גו ובני איטליא מבקשין לעשות מלחמה עמהם ובני ישמעאלים אומרין חזרה לנו מלכות וחינם מספקין לישא את ראשם מעט עד אשור שובים את שארה ומיד בת קול יוצאת ואומרת לישראל יבאו וינקמו נקמת יי באדום שנ ונתתי נקמתי בארום ביד עמי ישראל ומיד בחורי ישראל נקבצים והם ממליכים עליהם מלך מארץ ישראל ובני ארץ בבל מתקבצים וממליכים עליהם מלך מזרע בית דוד ומחלוקת נתנה בין אלו לאלו ובני ישראל פושעי בדוד לקיים מה שנאמ ויפש עו ישראל בבית דוד עד היום הזה"@he ;
    oa:hasSelector opp:unit_fol_26v_1_u1_selector ;
    oa:hasSource opp:passage_fol_26v_1 .

opp:unit_fol_26v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "192"^^xsd:nonNegativeInteger ;
    oa:start "90"^^xsd:nonNegativeInteger .

opp:unit_fol_27r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_27r_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "ובת קול רוצאה ומצפצפת מסוף העולם ועד סופו ואומרת מה שהיה הוא שיהיה זה הקבה שהיה ועתיד להיות ומה שנעשה הוא שיעשה והיא משיבה ואומרת להם לישראל בני כאשר עשה יהושע ליריחו ולמלכה כן תעשו לאנשי העיר המרשעת הזאת ולמלכה והם אומרין חין עמנו ארון הברית כאשר היה עם יהושע והיא משיבה להם לא היה בארון אלא שני לוחות אבנים וסתמן שמע ישראל מיד הם מריעים בתרועה שמע ישראל ומיד נופלת החומה תחתיה והם נכנסין לתוכה ומוצאין את בחוריה מתים ברחובותיה לקיים מה שנ יפלו בחדדה ברחוב ברחובותיה ואנשי מלחמתה רוכבים על סוסיהם ודוממין כאבנים כענין שנאמ וכל אנשי מלחמתה ידמו וישראל מתגברין והורגין בתוכה שלשה ימים ושלשה לילות וקובצים את כל שללה ונותנין אותה לתוך רחובה ושמועה באה עליהם מארץ"@he ;
    oa:hasSelector opp:unit_fol_27r_1_u1_selector ;
    oa:hasSource opp:passage_fol_27r_1 .

opp:unit_fol_27r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "128"^^xsd:nonNegativeInteger ;
    oa:start "7"^^xsd:nonNegativeInteger .

opp:unit_fol_27v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_27v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Lekach_Tov ;
    opp:earliestWitness opp:work_Midrash_Lekach_Tov ;
    rdf:value "המשיח ואומר להם ניהוא מלך המשיח אני הוא שהייתם מחכים לי בני כל צרה שבאה עליכם אף עלי שותף הייתי לכם עד היום הזה ועתה אל תיראו תחזקנה ידיכם והוא אומר להם שאו את הכסף ואת הזהב הזה והעלו אותו לירנשלם שנ שפעת גמלים תכסך גי ובת קול יוצאה שלישית מסוף העולם ועד סופו ואומרת עברו עברו בשערים פנו דרך יי ובת קול יוצאה עוד רביעית ואומרת להרים ולמדברות העלו מים להשקות עמי בחורי ישראל שנ כי נפתחו במדבר מים ובת קול יוצאת חמישית מסוף העולם ועד סופו ישרו המסלה וישרו ההרים והגבעות ויעשו מישור ויעלו העמקים ויושפלו הגבוהים ויעשו מישור שנ כל גיא ינשא וכל הר וגבע יושפלו ובת קול ששית אומרת כל חיות השדה והנחשים והעקרבים ברחו מפני עמי ישראל שנאמ לא יהיה שם אריה ופריץ חיות גו ובת קול שביעית יוצאת ואומרת קול ששון וקול שמחה צאו לקראת עמי ישראל בגילה ורנה ושמחה וששון ובת קול שמינית יוצאת ואומרת"@he ;
    oa:hasSelector opp:unit_fol_27v_1_u1_selector ;
    oa:hasSource opp:passage_fol_27v_1 .

opp:unit_fol_27v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "152"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_28v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_28v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma_Buber ;
    opp:earliestWitness opp:work_Midrash_Tanchuma_Buber ;
    rdf:value "שונאי היה כל ימיו ולא יכולתי לו הוי זכור לנקום נקמתי ממנו ענה אליפז איני יכול לו אין לי עסק בדבר זה לפיכך לא קיפח הקבה שכרו אש זכה שתשרה עליו רוח הקדש שנאמ ויען אליפז התימנ ועוד שדברה שכינה עמו שנ ויאמר יי אל אליפז התימני וזהו שאמ אליפז לאיוב ליש אובד מבלי טרף ואלי דבר יגונב מה נת למטלה מן הענין ויע אליפז התימני ויאמר הנסה דבר אליך תראה אמ לו אליפז לאיוב הלא אתה אומר למה איני כאברהם ומנין שהיה איוב מדמה עצמו לאברהם שנאמ הורני לחומלר ואתמשל כעפר ואפר אמ רברכיה סרס את המקרא ואתמשל כעפר ואפר הייתי דומה לאברום שאמ ואנכי עפר ואפר והוא דן אותי כדור הפלגה שכתוב בהם והחמר היה להם לחומר הוי הורני לחומר אמ לו אליפז וכי מעשיך כאברהם הן הנסה דבר אברהם נתנסה בעשר נסיונות ועמד בכלן ואתה בנסיון אחד"@he ;
    oa:hasSelector opp:unit_fol_28v_1_u1_selector ;
    oa:hasSource opp:passage_fol_28v_1 .

