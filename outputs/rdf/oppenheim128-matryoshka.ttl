opp:unit_fol_140r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_140r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והיה ירמיהו רואה כת של בחורים שלולים בקולרות של ברזל והולך ומכניס אתיה ביניהם וחוזר אחרים ועושהכן אמ ליה נבוזר אדן חדא מן תלת מלין אית בך אונביא של שקר אתה או מבעיט בייסורון את או שופך ודמים את או נביא של שקראתה את הוא דהא כמה שנין את קאים ומתנבא על הרא קרתא ועל הדא זויתא רתחרב ולדון דדיני חרבא באש לך אומבעיט בייסורין את אנא לית אנא בעי מעיק לך ולית ייסורין חשובין עלך כלום או שופך דמים את דאי מלכא שמע מה הא מתעביד בך ואנא לית אנא עביד לך כלום הוא משלח ומרים ראשי אלא אם טוב בעיניך לבא אתי בבל בא ועודנו לא ישוב עד שגלה לו הקבה ההד הדבר אשר היה אל ירמיהו מאת יי אחר שלוח אותו נבוזר אדן רב טבחים הרמה בקחתו אותו והוא אסור"@he ;
    oa:hasSelector opp:unit_fol_140r_1_u2_selector ;
    oa:hasSource opp:passage_fol_140r_1 .

opp:unit_fol_140r_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "178"^^xsd:nonNegativeInteger ;
