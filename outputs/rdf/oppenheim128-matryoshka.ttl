    rdf:value "מאן דעבד להון יא עביד להון חדא ומאן דעביד להון עשר לא עביד חדא מנהון ואחרכל השבח הזה כי עפר אתה ואל עפר תשוב ועוז פניו ישנא בשעה שאמ האשה אשר נתת עמדי אף הקבה שנה פניו וטרדו מגן עדן שנאמ וישלחהו יי אלהים מבן עדן דא מי כהחכם אלו ישראל דכת בהון רק עם חכם וצבוז הגוי הגדול הזה ומי יודע פשר דבר שהם יודעים להוש את התורה במט פנים טהור ובמט פנים טמא דא חכמת אדם תאיר פניו ר זכאי דשאב בשם ר שמואל בר נחמני אמ אתה מוצא כיון שעמדו ישראל לפני הרסיני ואמרו כל אשר דבר יי נעשה ונשמע ניתן עליהם מזיו שכינה שלמעלה ההר וצאיד שנכוים ביכך וכון שומרו לאתי החנשה ולה אלהיך ישראל נמשו שונאים להקבה ההד ועו פניו ישנא ישנא אף הקבה שינה עליהם את הדברים שנ אכן כאום תמותון דא מי כהחכם זה תלמידחכם ומי יודע כישר דבר בשעה שהוא יודעלפרש את מי שנתן חכמת אדם תאירפניו בשעה שהוא נשאל ואינו משיב ר הוה יתיב מתני שאין ממירין בבכור זחלין אפוי דבר פריא אמ הדין ודעמיה אש יתיב מתני"@he ;
    oa:hasSelector opp:unit_fol_101r_1_u1_selector ;
    oa:hasSource opp:passage_fol_101r_1 .

opp:unit_fol_102r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_102r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "יודע כשר דבר שפשר דבריתירה לישראל חכמת אדם תאיר פניו ר מני דשאב ור יהושע דסכני בשם ר לו יאמ על כל דבר ודבר שהיה הקבה אומר למשת היה אומ לו טהרתו וטומאתו וכיון שהגיע לפרשת אמוראל הכהנים אמ לפני הקבה רבונו של עולם אם נטמא במה טהרתו ולא השיבו באותה שעה נתכדכמי פניו של משה ההד ועח פניו ישנא וכיון שהגיע לפרשה הזאת של פרה אמ לו הקבה משה אותה האמירה שאמרתי לך ולא השיביתיך והיא פרשת אמיר אל הכהנים ואמ לפני רבונו שלעולם אם נטמא במה היא טהרתו אלא זו היא טהרתו שנ ולקחו לטמא מעפר שרפת החטאת משה ואהרן בכהניו ר יודן אמ בשם ר יוסי בר יהודה ור ברכיה בשם יהושע בן קיחא כל אותן משנה שעשו שראל במדבר לא נמנע משה מלשמש בכהונה גדולה ההד משה ואהרן בכהניו ר ברכיה אמ בשם ר סימון שמע לה מן הדה ובני עמרם אהרן ומשה ויבדל אהרן להקדישו קדש קדשים הוא ובניו ומשה אשהאלהים אבל בני יקראו ש על שבטהלוי אמ ר אלעזר בר יוסי אמ פשיט לן מיהא שבחליק לבן שמש משה במדבר"@he ;
    oa:hasSelector opp:unit_fol_102r_1_u2_selector ;
    oa:hasSource opp:passage_fol_102r_1 .

opp:unit_fol_103v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_103v_2#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "זובבל שנ אנת הוא רישא דידהבא תמימה זומדי עדי אמ ר חייא בר אבא מלכי מדי המימים הי אין כו להקבה עליהם אלא נ שקבלו מחבותיהם בלבר אשרחין בה מום זו יון אלכסנררוס מקדון וכד חמי לשמעון הצדיק הוה קאים ליה על רגלוי ואומ ברוך אלוהו של שממון הצדיה אמ ליה בני פלטין דידיה מן קומיה יהודאי את קאים לך אמ להון כד חנא נחית לקרבא בדמיתיה אנא חמי ונצח אשר לא עלה עליה עול זואדום שלא קבלה עליה עוני שלהקבה ולא דייה שלא קבלה עליה עלו של הקבה אלא שמחרפת ומגדפת אואומרת מי לי בשמים ועמך לא חפצתי בארץ ונתתם אותה אל אלעזר הכהן והוציא אותה אל מחץ למחנה שהואעתיד לדחוף את שרה ממחיצתו ושחט אותה לפניו שנ כי זבח ליי בבצרה וטבח גדול בארץ אדום ושקף את פ הפרה לעיניו ההד והובד גשמה ויהיבת ליקידת אשא את עורה ואת בשרה על דמה ישרף היא ודוכוסיה היא ואפרכיה הקיא ואסטרטליטיה ההר הוניך ועזבוניך ומערבך מלחיך וחובליך ומחזי בדקך ועורבי מערבך אמ ר שמואל בררב יצחק אפי שהן מקהלי יבאו ונד בקו בקהלך אף הם יפלו בלב ימים ביום מפלתך"@he ;
    oa:hasSelector opp:unit_fol_103v_2_u1_selector ;
    oa:hasSource opp:passage_fol_103v_2 .

opp:unit_fol_105r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_105r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ואמ הקבה אם בשעה שים שנים רם יה עישין כך והן מכחישין זה את זה אומות העולם עושין אותן אלוהות אלו היה אלא אחד על אחת כמה וכמה אמ ר ברכיה בשם ר סימון שניהם נבראו להאיר שנ יהי מאורוה והיו למאורות ויתן אותם אלהים לע ברקיע השמים להאיר על הארץ והיו לאותות אלו השבתו דכת כי אות היא ביני וביניכם לדורותיכם ולמועדים לו ימים טובים ולימים אלו ראשי חדשים ושנים אלו ראשי שנים שיהו אומות העולם מונין לחמ וישראל מונין ללבנה דא החדש הזה לכם ראש חדשים ורבות עשית אתה יי אלהי נפלאותיך ומח ומחשבוכי אלינו אין ערוך אליך אגידה וחדבר עצימו מספר ר חיננא בר פפא ור סימוו ר חיננח בר פפא אמ כל מכלחיים ומחשבות שחשכת כדי שיקבל אבי אברהם את המלכיות אשינו בשבילנו כדי שנעמוד בעול שמעון ברבי בשם ר יוחנן אמ ד דברים הראה הורנה לוב אברהם כמראת בין הבתרים תורה וקתל קרבנות גהנם ומלכיות תורה מנין שנ ולפיד אש"@he ;
    oa:hasSelector opp:unit_fol_105r_1_u1_selector ;
    oa:hasSource opp:passage_fol_105r_1 .

opp:unit_fol_111r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_111r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כי הנה הסתו עבר אלו ע שנה של מלכות בבל הגשם חלף הלך לי אלו נב שנה של מלכות מדי דאכי הנה הסתו ה עבר אלו ע שנה שעשו ישראל בגולה והלא אינן רלא וב אמ ל ר לוי צא מהן יח שנה שהיתה בת קוד ייצאנ ומפוצצת בפרטרין של נבוכד נצר ואומרת לו עבדא בישא סוק חריב ביתא דמרך דבנוי מרון ליה ולא שמעין קליה הגשם חלף הלך לו זה השעבור הנצנים נראו בארץ כגון דניאל וחבורתו מרדכי וחכורתו עזרא וחבורתו עת הזמיר הניע הגיע זמנה של ערלה שתזמר יהגיעזמין שלרשעים שישברו שנ שבר יי מטה רשעים הגיע זמנן שלבבליים שיזמרו הגיע זמן שלבית שני שיבנה שנא גדול יהיה כבוד הבית הזה האחרון מן הראשון אמר יי צבאות וקול התור נשמע בארצנו אמ ר יוחנן קול תייר טב נשמע בארצנו זה כורש שנ כה אמר כרשימלך פרס כל ממלכות הארץ נתן לי יי אלהי השמים התאנה חנטה כגיה אלו סלי בכורים והגפנים סמדר נתנוריח אלו הנסכים ענה דודי ואמר לי קומי לך רעיתי יפתי ונכי לך אמ ר עזריה לא היא עניה ולא היא אמירה"@he ;
    oa:hasSelector opp:unit_fol_111r_1_u1_selector ;
    oa:hasSource opp:passage_fol_111r_1 .

opp:unit_fol_115r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_115r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אתה ליקחו בשני תמידין איש שה לבית אבות שה לכית אמ ר יהודה בר סימון מעולם לא לן אדם ברושלם ובידו עון הא כאי זה צד תמיד של שחר היה מכפר על עבירות שנעשו בלילה ותמיד של בין הערבים היה מכפר על עבירות שנעשו ביום מכל מקום לא לן אדם בירושלם ובידו עון מה טעמיה טרק ילין בה אמ ר ברכיה בשם ר יצחק החדש הזה לכם בחדש הזה חדשו מעשיכם שעדין ראש וראשון לבא זה נבוכד נצר הרשע דכת ביה אנת רישא די דהבא ראשון זה עשו הרשע דכת ביה ויצא הראשון אדמני מי פורע לכם מן הראשון אני יי ראשגז מי פורע לכם ממדי בעשור אמ ר יודן בא בעשור שנכרת המן ועשרת בניו מי פורע לכם מהם שני כלקטירין מררבי ואסתר מרדכי מבחוץ ואסתר מבפנים מיפורע לכם מיון בני חשמנאי שהיו מקריבין שני תמידין בכליום נטרונם והיה לכם למשמרת עד ארבעה עשר יום אמ הקבה אביו קורא אותו גדול שנויקרא את עשוביו הגדול ואני קורא אותו קטן שנ הנה קטן נתתיך בגוים הואיל והן קוראין אותו גחל לכום תורא טבחא ההד כי זבח ליי בבצרה וטבח גדול בארץ"@he ;
    oa:hasSelector opp:unit_fol_115r_1_u1_selector ;
    oa:hasSource opp:passage_fol_115r_1 .

opp:unit_fol_117r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_117r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "עשרה בקר בריאים מפוטמים ועשרים בקר רעי ומאה צאן מן המרעה לבד מאיל וצבי ויחמור וברבורים אבוסים מהו ברבוה אבוסים אמ ר ברכיה בשם ר יהודה מיני ויודיא ורבנן אמ עוף גדול מעולה ומשובח היה והיה עולה וניתן על שלחנו של שלמה בכל יום אמ ר יהודה בר זבידא אלף נשים היו לשלמה וכל אחת ואחת היתה עושה לו סעודה כסעודה זו סבורה שמא אצלה הואסועד הוי אם ארעב לא אומר לך שבוי אחד מסרתי לך ולא היית יכול לעמד בו ואיזה זה זה נחמיה הפחה ואשר נעשה היה נעשה ליום אחד שור אחד צאן שש ברורות וצפרים נעשו לי ובין עשרת ימים בכל יין להרבה ועם זה לחם הפחה לא בקשתי מהו לרם הפחה ר הונא אמ בריקג מאמצו לחם סלת קודם שמכניסין אותו לפורני משריכים עליו חטים והוא יפה זהו לחם הפחה אמ לו אקבאטין תני אין מביאין את המעגמר אלא לאחר הסעודה וכי כרום החויחים נהנים ממנו אלאהריח כך אמ הקבה לישדאל בני מכל קרבנות שאתם מקריבים רפני כלום אני נהנה מכם אלא הריח שנ ריח ניחוח תשמרו להקריב לי במועדו צדיק אוכל לשובע נפשו"@he ;
    oa:hasSelector opp:unit_fol_117r_1_u1_selector ;
    oa:hasSource opp:passage_fol_117r_1 .

opp:unit_fol_117v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_117v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "זה אליעזר עבדו של אברהם שאמ לאמנו רבקה הגמיאיני מעטמים מכדך גמיאה אחת ובטן רשעים תחסר זה עשו הרשע שאמ לאבינו יעקב הלעיטני נא מן האדם האדם הזה אמ ר יצחק בר זעירי פער פיו אותו רשע כגמל ואמ אנא ר יצחק בר זעירי פער פיו אותו רשע והוה משלח ואזיל כי האי דתני תמן אין אובסין את הגמלל ולאדורסין אבל מלעיטין דא יצדיק אוכל לשובע נפשו זו רות שנ ותאכל ותשבע ותותר אמ ר יצחק את שמע מינה תרתי או ברכה שרתה בידו של אותו צדיק או ברכה שרתה במעיה של אותה צדקת אלא ממה דכת ותאכל ותשבע ותותר נראים דברים שרתה במעיה של אותה צדקת ובטן רשעים תחסר אלי אומות העולם אמ ר דוסתאי שאלני דוסתי מכוכבא אמ לי מהו בטן רשעים תחסר אמרתי לו גיי אחד היה בעירנו ועשה סעהה לכל זקני העיר וזימנני עמהם והביאו לפנינו מכל מה שברא הקבה בששת ימי בראשית ולא היה שלחנו חס כלום אלא אגחי פרך בלבד מה עשה נטל את הטבלה מלפנינו שהיתה יכיה ביו ככרי זהב ושברה אמרתי לו מפני מה עשית כן אמ לו רבי אתם אומ העולם הזה שליו ורעתם הבא שלכם ואם אין אנו אוכנן עכשו"@he ;
    oa:hasSelector opp:unit_fol_117v_1_u1_selector ;
    oa:hasSource opp:passage_fol_117v_1 .

opp:unit_fol_118r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_118r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אנו אוכלין וקריתי עליו ובנן רשעים החסר באברק אוכל לשובע ופשו זה חזקיהו מלך הודה שהיה קונה שתי אגודות של ירק וליטרא של בשר והיו מעלין לפניו בכל יום והיו ישראל מלין מליזין עליו ואומ זה מלך ומשוש את רצין ובן רמליתו אית מלכותא לרצין ולבן רמליהו ההד יען כי מאס העם הזה את מי השילוח התולכים לאט מהו לאט בר קפרא חזרנו על כל המקרא ולא מצינו מקום ששמו לאט אלא זה חזקיהו מלך יהודה שהיה מטהר את ישראל כמקוה שלמ סאה מנין לאט אמ להם הבה אכלים אתון בעיי שנ ולכן הנה יי מעלה עליכם את מי הנע הנהר העצומים והרבים ובטן דשעים תחסר זה מישע שנ ומישע מלך מואב היה נוקד מהו נוקד רועה ונאמ והשיב למלך ישראל מאה אלף כרים ומאה אלף אלים צמר מהו אלים צמר אמ ר אבא בר כהנא פרובטא דא צדיק אוכל לשובע נפשו אלו מלכי בית דוד ובטן רשעים תחסר אלו מלכי מזרח ר יודן ור הונא ר יודן אמ מאה צאן היה עולה לכל אחד"@he ;
    oa:hasSelector opp:unit_fol_118r_1_u1_selector ;
    oa:hasSource opp:passage_fol_118r_1 .

