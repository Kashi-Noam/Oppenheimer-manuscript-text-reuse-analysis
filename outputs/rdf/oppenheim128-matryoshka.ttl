opp:unit_fol_11v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_11v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "אמ ר יהושע גדול הוא השלום שגסע שבשעה שעמדו ישראל ואמרו כל אשר דבר יי נעשה ונשמע שמח בהם הקבה ונתן להם תורתו ובירכם בשלום שנאמ יי עוז לעמו יתן יי יברך את עמו בש בשלום ונאמ תורת יי תמימה משיבת נפש אמ חזקיה גדול הוא השלום שכל מצות שבתורה כתוב בהם כי כי תראה כי תפגע כי יקרא כי קבנה כשתבא המצוה לידך אתה זקוק לעשותה אבל השלום מה ת כת כו בקש שלום וררפהו בקשהו במקומך ורדפהו במכום אחר חזקיה אמ גדול הוא השלום שבכל המסעית כת ויסעו ויחנו לוסעין במחלוקת וחונין במחליקת ובזמן שבאו לסיני חנו חנייה אחת ויחן שם ישראל אמ הקבה הואיל ושנאו ישראל את המחלקת ואהבו את השלום ונעשו חנייה אחת עכשו אתן להם את תורתי אדניה לא נהרג אלא בשביל שהיה בעל מחלקת ומותר טומר לשון הרע על בעל מחלוקת שכן נתן אומר לבת שבע ואני אבא אחריך ומלאתי את דבריך ך נאמ ר כל השקרים אסורין ומותר לשקר בשביל להטיל שלום בין אדם לחברו"@he ;
    oa:hasSelector opp:unit_fol_11v_1_u1_selector ;
    oa:hasSource opp:passage_fol_11v_1 .

