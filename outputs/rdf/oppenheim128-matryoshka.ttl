opp:unit_fol_66v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_66v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "כנאד בקוע שאינו נפתח להכניס הרוח וכערוגה עמוקה שמח שמחזקת את מימיה וכקנקנה זפותה שמשמרת את יינה וכספוג שהוא סופג את הכל אל תהית כפתח גדול שמכניס את הרוח ולא כפתא קטן שמנבל את היקרים היה כאסקופה התחתונה שהכל דשין בה וליתד הנמוכה שהכל תלין בה ים לקית במחונך בממונך זכור איוב שלקה בממונו אם לקית בגופך זכור דתן ואבירם שיר דו חיים שאולה אל תכשל בעיניך שאין מכשול אלא בעינים אל תבוש משיניך שמא תאכל יותר מדאי אל תדרוש מן המינות שמא תמשך לגיהנם אם אומרים אחרים עליך דבר דע אל תענם גדול יהיה בעיניך כקטן ואם אמרת על אחרים דבר רע קטן יהיה בעיניך כגדול עד שתנך ותפיים עליו אל יהי פרקך רע שאין שבחה שלתורה הוי אוהב את התורה ומבבדה שלא הוי טוב שכן שבחה שלתורה הוי אוהב את הבריות ומכבדן"@he ;
    oa:hasSelector opp:unit_fol_66v_1_u1_selector ;
    oa:hasSource opp:passage_fol_66v_1 .

opp:unit_fol_66v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "135"^^xsd:nonNegativeInteger ;
    oa:start "1"^^xsd:nonNegativeInteger .

opp:unit_fol_67r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_67r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "הרחק מן המביא לידי עבירה ומן הכיעור ומן הדומה לכיעור שמא יחשדוך אחרים בעברה אל תלשן את חברך שכל המלשין אין לו רפיאה אל תהי פרוץ בנדרים שהנדרים מביאין לידי שביעות אל תאכל לחם עם כהן עם הארץ שמא תחלל קדשיקדשים הרחק מן התרעומת שמא תתרעם על אחרים ותוסיף לחטוא שבעה אבות כרותי ברית לוהן אברהם יצחק ויעקב משה ואהרן פנחם ורוד באברהם כתו ביום ההוא כרת יי את אברם ברית לאמר ביצחק כת ואת בריתי אקים את יצחק ביעקב בת וזכרתי את בריתי יעקב במשה כת על פי הדברים תאלה כרתי אתך ברית באהרן כת ברית מלח עולם הוא לפני יי בפנחס כת והיתה לו ולזרעו אחריו בחת כהנת עולם בדוד כת כרתי ברית לבחירי נשבעתי לבוד עבדי תנא אף ישראל כרותי ברית הם שנאמ על פי הדברים האלה לרתי אתך ברית ואת ישראל שבעה אבות שכבו בכבוד עזלם ולא שלטה בהם רמה ותולעה וסו הם אברהם יצחק ויעקב ומשה ואהרן ועמרם אביהם ובנימן בן יעקב וישאומ אף דוד שנ לכן שמחלבי ויגל כבודי אף בשרי ישכן לבטח"@he ;
    oa:hasSelector opp:unit_fol_67r_1_u1_selector ;
    oa:hasSource opp:passage_fol_67r_1 .

opp:unit_fol_67r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "169"^^xsd:nonNegativeInteger ;
