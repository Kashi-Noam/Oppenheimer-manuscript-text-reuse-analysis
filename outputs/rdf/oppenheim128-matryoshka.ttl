opp:unit_fol_57r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_57r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "על שותכו ומי שאין מחזיר אבדה לבעליו והמלוה את חברו על מנת ליטול ממנו ביתו או שדהו והדר בנבלה עם אשתי והמוציא עליה עלילות דברים כדי לגרשה עליהם הכת אומ אני יי חוקר לב ובוחן כליות הנעלבין ואינן עולבין שומעין חרפתן ואינן משיבין עושין מאהבה ושמחין בייסורין עליהם הכת אומ ואוהבא כצאת השמש בגבורתו המאוסין בעיניהן והנבזין בעיניהם והכ ובשים את יצרם והמשפיכים את רוחם עליהם הכת אומ כה אמר יי גואל ישראל למתעב גוי לעבד מושלים מלכים יראו וקמו שרים וישתחוו בעלי אמנה ומכסי רזים ומשיבי פקדון ומחזירי אבדה עליהם הכת אומ עיני בנאמני ארץ לשבת עמדי האוהב את אשתו כנפשו והמבבדה יותר מגופו והמדריך בניו בדרך ישרה והמשיא אשה לבנו סמוך לפרקו קודם שיבא לידי חטא עליהם הכת אומ וידעת כי שלום אהלך ופקדת נוך ולא תחטא וידעת כי רב זרעך גו האוהב את שכניו והמקרב את קרוביו והנושא את בת אחותו והמלוה פרוטה לעני בשעת דחקו עליהם הכת אוה אז תהרא ויי יענה המתודים בצדק והשבין בצדק והמקבלין את השבים ומלמדין אותם שלא ישובו לסורחנם עליהם הכת אומ אז יבהע כשחר"@he ;
    oa:hasSelector opp:unit_fol_57r_1_u1_selector ;
    oa:hasSource opp:passage_fol_57r_1 .

opp:unit_fol_57r_1_u1_selector a opp:TokenPositionSelector ;
