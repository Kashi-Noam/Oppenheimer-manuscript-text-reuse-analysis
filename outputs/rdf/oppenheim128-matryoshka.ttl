opp:unit_fol_9r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_9r_2#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "הוי אוהב את בית המדרש כדי שיבאו בניך לתלמוד תורה הוי אוהב את העטים כדי שלא יבאו בניך לאותה מדה הוי אוהב אר הענוה כדי שתמלא ידיך טובה הוי אוהב את החסידים כדי שתנצל ממלאך התשחורת הוי זהיר בקרית שמע ובתכלה כד שתנצל מדינה של גיהנם ייהי ביתך פתוח לרוחה כדי שלא יחסרו מזונותיך הוי זהיר בדלתי ביתך שלא יהו נעולות בשעה שאתה מיסב באכילה ובשתיה מפני שדלתי ביתך הם מביאות אותך לידי עניות הוי זהיר בכבוד אשתך שלא תהיה עקרה הוי שמח בייסורין הבאא עליך מפני שמצילין זותך מחוליה של מטה הוי שמח על שולאנך בשעה שהרעבי נהנין ממנה כדי שתאריך ימים יבעולם הזה ובעולם הבא הוי שמח במתנה שנתת מתוך ביתך כדי שיכפה ממך מלאך המות שנ מתן בסהר יכפה אף אם מנעת עשצמך מדבר מצוה מלא המות מק דמך אם פזרת רגליך על העני ועל המציה נתקיים עליך ברוך אתה בבואך וברוך אתה בצאתך אם שמרת פיך מלשון הרע תהאיכל ימיך לשנ אם העיזפניו בפני מי שגדול ממנו טסוף בא לידי בהרת אם מנע עצמו מדבר מצוה ועיסק בדבר עבירה סוף מתה אשתו כמגפה"@he ;
    oa:hasSelector opp:unit_fol_9r_2_u1_selector ;
    oa:hasSource opp:passage_fol_9r_2 .

