opp:unit_fol_162r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_162r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כשיגיע הקץ הקבה אומ להם בני תמיה אני מכם איך המתנתם כי כל השנים הללו וישראל אומרין לפניו רבונו של עולם אלולי ספר תורה שכתבת לנו כברהיו אומות העולם מאבד ין אותנו ממך ההד זאת אשיב אל לבי על כן אוחילי וכן אמ לולי תורתך שעשועי אז אבדתי בעניי דא אנכי אנכי הוא מכחמכם אמ ר אבין בשם ר שמעון בן לקיש למה הדבר דומה למלך שכעס על מטרונה וטדדה והוציאה מפכטרן שלו לאחר זמן בקש להחזירה לו אמרה לו תככול לי כתובתי ואחרכך תחזירני כך אמ הקבה לישרל בני בסיני אמרתי לכם אנכי יי אלהיך פעם אחת ולעתיד לבא אני עתיד לומד לכם ב פעמים שנ אנכי אנכי הוא מנחמכם אמ ר מנחמא בשם ר אבין מאותה הנחמה שנחמתם לפני בסיני שאמרתם לפני כל אשר דבר יי כעשה ונשמע מר את ותראי מאנוש ימות אלא את היא שאמרת בי לפכי בים מי כמכה באלים יי מי כמוך ותראי מאנוש ימות אלא ומכן אום הציר ינתן אמר ברכיה"@he ;
    oa:hasSelector opp:unit_fol_162r_1_u1_selector ;
    oa:hasSource opp:passage_fol_162r_1 .

opp:unit_fol_162r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "159"^^xsd:nonNegativeInteger ;
