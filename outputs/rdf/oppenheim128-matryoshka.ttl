opp:unit_fol_155v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_155v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר עזריה ור אבהו בשם ר שמעין בן לקיש אמ אתהמונא כיון שגרמו העונות ונכנסו שונאיהם ליחשנם נטלו גכורי ישראל וכתתו ודיהם לאחוריהם אמ הקבה כתוב כתו עמו אנכי בצרה בני בצרה ואני ברוחה כביכול השיב אחור ימינו מפני אווב ולסוף גלה אותה לרניאל שנ ואתה לך לקץ ותנוק ותעמד לגורלך לקץ הימין אמ ליה ליתזדין ואשבון אמ ליה ותנוח אמ ליה והניחא לעולם אמ ליה ותעמד אמ לו עם מי עם הצדיקים או עם הרשעים אמ לו לגורלך עם הצדיקים שכיוצא בך אמ לו אימתי אמ לו לקץ הימין או לקץ הימים לקץ אותה הימין שהיא משועבדת אמ הקבה קא נתתי לימיני שכל זמן שבני משועבדים תהי ימיני משעבדת וכשאגאל בני אגאל ימיני הוא שאמ דוד למען נחלצון ידידיך הושיעה ימינך"@he ;
    oa:hasSelector opp:unit_fol_155v_2_u1_selector ;
    oa:hasSource opp:passage_fol_155v_2 .

