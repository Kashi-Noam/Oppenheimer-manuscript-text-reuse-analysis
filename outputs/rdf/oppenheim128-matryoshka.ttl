opp:unit_fol_61r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_61r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "מה שיגזור עליו בעל הבית יעשה ומעשה בשמעון בן אנטיפטרם שהיו אורחין נכנסין אצלו וגזר עליהם שיאכלו וישתו והיו נודר ין בתורה ומבדין ובשעת פטירתן היה מלקה אותן נשמעו הדברים לפני רבן יוחנן בן זכאי וחכמים והיו מקנטרין בדבר אמרו מי ילך ויודיענו אמ להם ר יהושע אני אלך ואראה מה מעשיו אמרו לו לך לשלים הלך ומצאו על פתח ביתו אמ לו שלום עליך ר אמ לו שלום עליך ר ומרי אמ לו ביתא אני צריך אמ לו שב לשלום ישבו ועסקו בתורה עד הערב לשחרית אמ לו ר נלך למראן אמ לו רצונך היה ר יהושע מתיירא שמא יקתחנו על שוקיו לאחר שיצא אכלו ושתו אמ מי מלויני איב לו אני היה ר יהושע מחשב ברעתו ואמ מה אשיב לחכמים ששגרוני נפנה ר יהושע לאחוריו אמ לו ר למה נפנית לאחריך אמ לו ר רבר אני צריך לשאול ממך מפני מה בני אדם הנכנסין אצלך אתה מלקה אותא ו לא הלקית אמ לו ר אתה חכם גדול ודרך ארץ ישבידיך בני אדם הנכנסין אצלי גזרתי עליהם"@he ;
    oa:hasSelector opp:unit_fol_61r_1_u1_selector ;
    oa:hasSource opp:passage_fol_61r_1 .

opp:unit_fol_61r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "168"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_61v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_61v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לעולם לא יהא אדם קפדן בתוך סעודתו מעשה בהלל הזקן שעשה סעודה לאדם אחד ובא עני ועמד על פתחו ואמ אשה אני צדיך להכניס היום ואין לי פרנסה כלום נטלה אשתו כל הסעובה ונתנה לו ואחרכך לשה עיסה אחרת ובשלה אלפס אחר ובאתה והניחה לפניהם אמ לה בתי מפני מה לא הבאת לנו מיד ספרה לו כל המעשה אמ לה בתי אף אני לא דנתי אותך לכף חובה אלא לכף זכות שכל המעשים שעשית לא עשית אלא לשום שמים"@he ;
    oa:hasSelector opp:unit_fol_61v_1_u1_selector ;
    oa:hasSource opp:passage_fol_61v_1 .

opp:unit_fol_61v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "79"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_61v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_61v_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "מניחין פאה ממעשה אלפס ואין מניחין פאת ממעשה קדרה ומעשה בר יהושע שנת שנתארח אצל אלמנה אחת הניחה לפניו מעשה אלפסןידדה אכל ולא הניח פאה פעם שניה אכל ולא הניחפאה פעם שלישית הקדיחתו מלח וכיון שטעמו ר יהושע משך ידו ממנו ואכל פתו ריקן אמרה לו ר מפני מה מיעסת בגריסין הללו אמ לה כבר סעדתי מבעוד יום אמרה לו מעתה היה לך למעט בפת ובגריסין שאכלת מכאן אמ ר יהושע מימי לא נצחני אדם אלא אשה זו ותינוק ותינ נקה תינוקת מאיהיא פעם אחת היה מהלך מהלך ר יהושע בשדה ומצא ריבה אחת אמרה לו ר מפני מה אתה מהלך בשדה אמ לה בדרך אני מהלך אמרה לו אם זו היא דרך לסטים שכמותך כבשוה"@he ;
    oa:hasSelector opp:unit_fol_61v_1_u2_selector ;
    oa:hasSource opp:passage_fol_61v_1 .

opp:unit_fol_61v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "195"^^xsd:nonNegativeInteger ;
    oa:start "79"^^xsd:nonNegativeInteger .

opp:unit_fol_62r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_62r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "תינוק מאי היא פעם אחת היה ר יהושע מהלך בדרך ומצא תיכוק אחד שהיה יושב בין שני דרכים אמ לל בני באי זו דרך אכנס לעיר בזו או בזו אמ לו הרי שניהם לפניך זו ארוכה וקצרה וזו קצרה וארוכה הלך ר יהושע בקצרה וארוכה כיון שהגיע לחומה של עיר מצא גנות ופרדסים שהם מקיפים אותת חזר לאחוריו ומצא אותו תינוק שיושב במקומו אמ לו בני מפני מה צחקת בי לא כך אמרת לי שבזו הדרך אכנס לעיר שהיא קצרה וארוכה אמ לו ר הרי חכם גדול אתה זו היא חכמתךך הלך ר יהושע ונשקו על ראשו ואמ אשריכם ישראל שכלכם חכמים מגד גליכם ועד קטניכם כיצד מרקדין לפני הכלה בית שמאי אומ כלה כמות שהיא ובית הלל אומ כלה נאה וחסודה אמרו להם בית שמאי לבית הלל לדבריכם אפי חגרת או סומה יאמרו לה כלה נאה וחסודה והלא אמרה תורה מדבר שקר תרחק אמרו להם בית הלל לבית שמאי הרי שלקח מקח רע מן השוק ישבחנו בפניו או יגננו בפניו הוי אומ ישבחנו מכאן אמרו חכמים תהא דעתו של אדם מעור בת עם הבריות ולא יפרוס אדם"@he ;
    oa:hasSelector opp:unit_fol_62r_1_u1_selector ;
    oa:hasSource opp:passage_fol_62r_1 .

opp:unit_fol_62r_1_u1_selector a opp:TokenPositionSelector ;
