    rdf:value "כיכשלת בעוניך אמ ר סימון משל להר גבוה שעימד על פרשת דרכים והיו נכשלים בו בני אדם אמ המלך סתמו אותו קימ עא קימעא עד שיבא עתו ואני מעבירו מן הכגולם ההד והסירותי את לב האבן מבשרכם בך יצת הרע הוא מכשול בעולם הזה אמ הקבה בנוהג שבעולם אדם נבשל בעבירה והוא מתחייב עליה מיתה לשמים מת שורו או חמורו אבדה תרנ גולתו נשברה צליחיתו ניקף באצבעו מקצת הנפש חושב לו הקבה ככל הנפש לכך אמ שלמה אחת לאחת למצא חשבון מרובעראחת וה חשבון מתמלא"@he ;
    oa:hasSelector opp:unit_fol_80v_1_u2_selector ;
    oa:hasSource opp:passage_fol_80v_1 .

