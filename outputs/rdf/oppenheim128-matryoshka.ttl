opp:unit_fol_6v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_6v_1#u2" ;
    opp:closestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "עדיין הוא חולה אלא מלמד שקרא הכת משענתו הנשעז על גופו כמו שנשען על מקלו כיוצא בו אם זרחה השמש טליו דמים לו וכי השמש עליו לבדו זורחת והלא בכל העולם כלו זורחת אלא מהה השמש שלום בעולם אף ההורג הזה אם ידוע שלא בא על עסק נפשות אלא שלום היה ל עם בעל הבית יתחייב בעל הבית בדמו באלו הלכה"@he ;
    oa:hasSelector opp:unit_fol_6v_1_u2_selector ;
    oa:hasSource opp:passage_fol_6v_1 .

