opp:unit_fol_43r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_43r_1#u1" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "הנהו תריכושיים דהוו קמי שלמה אליחורף ואחיה בני שישא וספרי דשכמה הוו יומאחד חמא למלאך מותא דהוה אליץ אמ ליה אמאי איתאלצת אמ ליה הנהו תרי ספרי דילך בניי מינאי קודשא בריך הוא דמטא זמנהון מה עבד מסרינהו ל שעיר ושדרינהו למחוזא דלוז לבכינהו שעירא ואובלינהו ללוז כי מטא אפיתחא דלוז אתא סטנא ולבכינהו מציה וקטל יתהוץ לסופא חזייה שלמה לסטנא דהוה הא בדח אמ ליה אמאיבדיחת אמ ליה היכא דקא בעי לי יתהון מינאי תמן שכרתינ פתח שלמה ואמ רגלוהי דבר איניש אינון ערבין ביה באתר דמתבעי תמן מובלין יתיה בגלות שעברו כמה שנים ולא עלו לרגל הקבה מנחמן ולפי שישראל מצטענן ואומרלהם בני כמה פעמים הייתם עולים בכל שנה לא שלשפעמים חייכם כשיגיע הקץ אני בונה אותו ואין אתם מונים לו שלש פעמים אלא בכל חדש וחדש ובכל שבת ושבת ההד והיה מדי חדש בחדשו ומדי שבת בשבתו יבא כל בשר להשתחות לפני אמר יי והיאך איפשר שיהיו כל ישראל באים לירושלם בכל ראש חדש ובכל שבת אמ ר"@he ;
    oa:hasSelector opp:unit_fol_43r_1_u1_selector ;
    oa:hasSource opp:passage_fol_43r_1 .

