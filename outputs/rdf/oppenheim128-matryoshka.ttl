opp:unit_fol_69v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_69v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "מדה גדולה מזו וכבלם הויכץ למשנה יותר מן התלמוב עשה תורתך בחנם ואלתטול עליה שכר להמקום לתנה בחנם ואיז נוטלין שכר על דברי תורה ואם חתה וטל שכר על דברי הורה נמצאת מחריב את כל העולם אלתאמר אין לי ממון שכל הממון שלו הוא שנאמ ל הכסף ולי הזהב אמר יי אם עשית צדקה תזכה לממון ואם זכית לממון עשה ממנו צדקה בעוד שהוא בידך קנה ממנו בעולם הזה ותנחול העולם הבא שאם אין אתה עושה ממנו צדקה יעיף פתאום שנ התעוף עיניך בו ואיננו אל תאמר איש פלני חכם ואני איני חכם שלא שמשת כיוצאבו ואל תאמר אישפלני עשיר זאני איני עשיר שאין כל אדם זוכה לשתי שלחנות ואל תאמר איש פלני נאה ואני מרוער שבשעת המיתה אדם עשוי כנבלה ולא עוד אלא שהגבלה מוכיה לגוים או נותנ ברנם ונבלת האדם אין כל בריה יכולה להשגיח עליה ואל תאמר אישפלני גבור ואני חלש שאין גבורה אלא בתורה שנ ברכו יי מלאכיו גבורי כח עושי"@he ;
    oa:hasSelector opp:unit_fol_69v_1_u1_selector ;
    oa:hasSource opp:passage_fol_69v_1 .

