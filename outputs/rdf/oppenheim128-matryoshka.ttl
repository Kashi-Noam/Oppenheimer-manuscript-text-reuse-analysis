opp:unit_fol_195v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_195v_1#u2" ;
    opp:closestWitness opp:work_Eichah_Rabbah ;
    opp:earliestWitness opp:work_Eichah_Rabbah ;
    rdf:value "היתה כאלמנה יאמי רב יהורה כאלמנה ולא אלמנה ממש כאשה שהלך בנכה למדינת הים ודעתו לחזור עליה ועוד אמ משל למלך שכע על מטרונה וכתב לה גינה ועמד וחטפ ממנה וכל זמן שהיתה מבקשת להנשא אומ לה היסן ביטיך שגרשתיך וכל זמן שהיקה מבקשת ותובעת בתכתה אומר לה גרשתיך יכך ישראל כלזמן שהן מבקשין לעבוד עז אומר נהם איזה ספד כריתית אמכם וכל זמן שמבקשין שיעשה להם נס אומ לתם שלחתיה שטאתן את ספר כריתותיה אליה"@he ;
    oa:hasSelector opp:unit_fol_195v_1_u2_selector ;
    oa:hasSource opp:passage_fol_195v_1 .

opp:unit_fol_195v_1_u2_selector a opp:TokenPositionSelector ;
