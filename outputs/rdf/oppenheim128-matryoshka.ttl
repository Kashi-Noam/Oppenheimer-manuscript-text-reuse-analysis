opp:unit_fol_134r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_134r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר אלעזר בר שמעון אזל לגביה ר שמעון בן יוסי בן לקוניא חמוי ונכם ליה חדתור ואפה ליה חדא אצותא דפיתא ופתח ליה חד כוב דחמר והוה מזיג ליה והוא שתי מזיג ליה והוא שתי אמ ליה איפשר ששמעת מאביך כמה הוא שיעורו שלכם אמ ליה כמות שהוח אחת בנינן ושתים בימין שלש אכל לא שיערי חכמים לא בכוסך שהוא קטן ולא ביינך שהוא יפה ולאבכריסך שהא רחבה ר אלעזר בר שמעון שאל את ר שמעון בן יוהי בן לקוניא חמוי אמ ליה מה דין דכת שמלתך לא בלתה מעליך שמא כלי קוליות היו מהלכין עם ישראל במדבר אמ ליה ענני כבוד היו מעטפין אותם ולח היו בלים אמ ליה והא כתוב שמלתך לא ברתה מעליך ורגלך לא בצקה ולא היו גדלים אמ ליה החלזאון הזה כר זמן שהוא גדל לרתיקו גדל עמו וכי לא היו צריכין תכבוסת אמ ליה ענני כבוד היו מגחצין אותם ואל תתמה על זה אימיינטון הז אין מגחצין אותו אלא באור אמ ליה ולא היה ריחן קשהה מדיח הזיעה אמ כיה מתלכלכים היו ובדשאי הבאר מג מחגחין אותן שנ וריח שלמותיך כריח לבנון"@he ;
    oa:hasSelector opp:unit_fol_134r_2_u1_selector ;
    oa:hasSource opp:passage_fol_134r_2 .

opp:unit_fol_134r_2_u1_selector a opp:TokenPositionSelector ;
