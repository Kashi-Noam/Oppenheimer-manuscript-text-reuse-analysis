opp:unit_fol_152v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_152v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אך לא בעי ישלחיד אם בפידו להן שוע אמ ר אבהו אין הקבה מכה אמה ומושיבה צרי אלא מבא פיד לאו ומשעשעה בזו ומביא פד לזו ומשעשעה בזו הביא פיד לאשור ושעשעה במצרים שנ התטבימנא אמון הביא פיד למצרים ושעשעה באשור שנ הנה אשור ארז בלבנון אמ רב יוסף מפני מה גלו עשל השבטים ואחרכך גלה שבט יהודה ובנימין כדי שיהו מתנחמי אלו באלו לפיכך אמ נחמו נחמו"@he ;
    oa:hasSelector opp:unit_fol_152v_1_u1_selector ;
    oa:hasSource opp:passage_fol_152v_1 .

opp:unit_fol_152v_1_u1_selector a opp:TokenPositionSelector ;
