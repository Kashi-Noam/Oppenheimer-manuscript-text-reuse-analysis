opp:unit_fol_26r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_26r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_Rabbati ;
    rdf:value "ביניהם ר יוחנן אמ כותל ר חנינא אמ טפח ורבנין אמרין שתיהן שוות אמ ר לוי אמ הקבה לישראל בני אותן הקרבנות שכתבתי לכם בתורה הוו זהירין בהן שאין לכם פרקליט טוב לירידת גשמים יותר מן הק הקרבנות לפיכך הוצרך הכת לומר ביום השמיני עצרת תהיה לכם תם ונשלם תל עד אשר אבא אל אדני שעירה ההד ועלו מושיעים בהר ציון גו תני ר שמעון בן יוחאי מאי דכת וצים מיד כתי אלו אדומיים שעתידין לעמד באחרית הימים וכשהם יוצאין כגנבים הם באין והם עושים מלחמה עם בני ישמ עאל והורגין מהם הרבה וכד את חמי שלמאה מתכניש למישרא דעכו דע דאדק פרזלא לחספא ושקייה תברין לאצבעתא ומתחלטין במלכותא מנהון פטסקא מלכותא ורשיעתא תברת מן שעבידא וכד תחמי רומייה נפק בתקוף לאלכסנדריא דע די מטא קץ שלמאה מיתמסרא בידוהי דתורכייא ערט ערטילאין מן עכו ערקין בלא"@he ;
    oa:hasSelector opp:unit_fol_26r_1_u1_selector ;
    oa:hasSource opp:passage_fol_26r_1 .

opp:unit_fol_26r_1_u1_selector a opp:TokenPositionSelector ;
