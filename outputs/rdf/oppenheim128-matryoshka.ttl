opp:unit_fol_122v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_122v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר לוי בר ברכיה בשם ר זכריה אמ כטקסיס של מלכים בא עליהם בתחלה שבד להם אמת המים הביא עליהם קלנים ואחר כך ירה בהם חצים ואחרכך הביא עליהם לגיונות ואחר כך נתן עליהם דורמסיות ואחר כר רמה בהם נפט ואחרכד השליך עליהם אבני בליסטרא וזחר כך מימיד עלי הם כבשים ואזרכך חובשם בכשיוה בפלקיות ואחרכך הוציא את הגדולים שבהם והרגן כתחלה שבר אמת המים שלהם שנ ויהפך לדם יאוריהם ונוזליהם בל ישתיון ואחר כך הביא עליהם אמ ר יוםי בר חנינא קרקודין היה קשה להן יותר מהם ואחרכך ירה בהם חצים אלו הכנים שנ ותהי הכנם באדם ובבהמה ואחר כך הביא עליהם לגיונות זה הערוב שנ ויבא ערוב כבד ביתה פרעה ואחר כך נתא להם דורמוסיות זה הדבר שנ דבר כבד מאד ואחר כך רמה בהם נפט זה השחין שנ שחין פרח אבעביעות ואחרכך השליך עליהם אבני בליסטרא זה ברד ואחרכך הוציא את הגדולים שבהם והרגם זה מכת בכנורות ר לוי חתניה דר זכריה בשם ר ברכיה אמ כאשר שמע למצרים יחילו כשמע צור אמ ר אל עזר כל צור שבמקרא מלא זה בצור המדינה הכת מדבר"@he ;
    oa:hasSelector opp:unit_fol_122v_1_u1_selector ;
    oa:hasSource opp:passage_fol_122v_1 .

