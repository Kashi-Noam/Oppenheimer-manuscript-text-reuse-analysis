opp:unit_fol_110r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_110r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אלו מה יום שמלך המשיח נגלה להם וחוזר ונכסה מהם והיכן הוא מוליכן אית דאמרי למדבר יהודה ואית דאמרי למדבר סיחון ועוגההד לכן הצה חנכי מפתיה והולכתיה המדבר מי שהוא מאמין אוכל מלוחים ושתש רתמים וחיה ההד הקטפים מלוח עלי נאיח ושרש רתמים לחמם ומי שאינו מאמין בו והולך לו אצל אומות העולם הם הורגין אותו אמ ר יצחק בר מריון לסוף מה יום הקבה נגלה להם ויוריד להם המן למא והכת אין כל חדש תחת השמש מאי טעמיה אנכי יי ילהיך המעלך מיורץ מצרים ואומ עוד אושיבך באהלים כימי מועד ענה דודי ואמר לי קומי לך רעיתי יפתי ולכי לך אמ ר עזריה לא היא עניה ולא היא אמירה ארא ענה לי עלידי משה ואמ לי על ידי אהרן ומה אמ לי קומילך רעיתי יפתי ולכי לך זריזי גרמיך רעיתי בתו של אברהם יפתי בתי של נחקביו שנינקר ללנכ רמזבח ומנ לר בתינשל יעקב ששמע לחביא ולאמישנ וישמיניעתב לאביו ולחמיוילך סדנה ארם בי הנה הסתו עבר אלו ד מאות שנה שנגזרו על אבותינו במצרים"@he ;
    oa:hasSelector opp:unit_fol_110r_1_u2_selector ;
    oa:hasSource opp:passage_fol_110r_1 .

