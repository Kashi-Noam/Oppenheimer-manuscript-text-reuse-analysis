opp:unit_fol_120r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_120r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ושחרא לא מעוררני והיה יצרו הרע מקטרגו ואומ לו דוד דרכם של מלכים השחר מעורד אותם ואתה או אעירה שחר דרכן שלמלכים להיות ישנים עדג שעות ואתה אומ קצי לילה אקום להודות לך ומהו על משפטי צדקך על משפטים שהבאת על פרעה הרשע ועל צדקה שעשית עם שרה זקנתי ההד וינגע יי אתפרעה נגעים גדולים דא על משפטי צדקך על משפטים שהבאת פל אומות העולם ועל צדלה שעשית עם זקני וזקנתי שאלו השחיל לה קללה אחת מלמטה מהיכן הייתי עומד אלא שנתת בלבו ובירכה שנ ברוכה את לי בתי דא על משפטי צדקך על משפטים שהבאת על המצריים במצרים ועל צדקה שעשית עם אביתינו במצרים שלא היו בידן מצות שיגאלו בהם ונתת להם שתי מצות שיגאלו בהן ואלו הן דם פסח ודם מילה ההד ואעבר עליך ואראך מתבוססת בדמיך"@he ;
    oa:hasSelector opp:unit_fol_120r_2_u1_selector ;
    oa:hasSource opp:passage_fol_120r_2 .

