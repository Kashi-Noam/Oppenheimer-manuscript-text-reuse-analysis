opp:unit_fol_64v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_64v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אומר אדם הלכה של ברת הכסא בבצית הכסא ושלבית המרחץ בבית המררץ אין שואל ומשיב במקום שרובן ערומים ולא במקום שרובן לבושים רבן רובן לבושים ומיעוטן ערומים רובן ערומים ומיעוטן לבושין כלן ערומים ולא ישאל אדם שלום לחבירו בבית המרחץ מפני הסכנה ואם שואלהו אומר לו מרחץ הוא ויש אומרים משיבו ואין בכך כלום ואל יליח אדם רגליו בתוך האבטי ויהא רבוץ לתוכה מפני שגנאי הוא לו ואל יאמר אדם לחברו רוס ידך עלי בבית המרחץ והאומר אין יוצא משם כשהוא שלם אמ ר יהודה במה דברים אמורים במים המועטין אבל במים מרובין הרי זה משתבח והקורא שתי פעמים והטובל שתי פעמים הרי זה מגונה המתכסה בטליתו ועומד במקום הזיעה הרי זה גוזל את הרבים הרוחץ בצונן והמשטטף בפושרין הרי זה גוזל את הרבים והגוזל את הרבים כיצד יעשה ילך ויחפור בורות שיחין ומעכות ויתקן דרכים וטרטסיאות ואחר כך ימחל ש סשליק פרקא היוצא בדרך לבדו הודם קריאת הגבר דמו בראשו ר יאשיה אומ לא יפחות משנים ובאי זה תרנגול אמרו בתרגנו בתרנגול הבינוני שנאמ מי שת בטוחות חכמה או מינתן לשכוי בינה אדם הבא מן הדרך נכנס למרחץ הקיז דם ונשתכר ושמש מטתו על גבי קרקע דמו בראשו"@he ;
    oa:hasSelector opp:unit_fol_64v_1_u1_selector ;
    oa:hasSource opp:passage_fol_64v_1 .

opp:unit_fol_64v_1_u1_selector a opp:TokenPositionSelector ;
