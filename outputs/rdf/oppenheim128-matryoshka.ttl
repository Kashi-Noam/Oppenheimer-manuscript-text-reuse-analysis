opp:unit_fol_128r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_128r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אויב ארדוף אשיג אחלק שלל אתה מיצא כיון שבא משה אצל פרעה ואמ לו כה אמר יי שלח עמי ויעבדני אמ אותו רשע מי יי אשר אשמע בקולו לא ידעתי את יי וגם את ישראל לא אשלח הפה שאמ כל הבן הילוד היאורה תשליכוהו והפה שאמ מי יי חזר ואמ יי הצדיק ואני ועמי הרשעים הכה שאמ כל הבן הילוד היאורה תשלירו הושלך לים שנ מרכבות פרעה וחילו ירה בים הפה שאמ לא ידעתי את יי וגם את ישראל לא ישלא הוא עמו ום היה מחזר עלכתחי היכליהם שלישראל ואומלהם עא בשר צאו לשלום לכך נאמ ויהי בשלח פרעה את העם אמרו לאלהים מה נורא מעשיך ברובעזך יכחשו לך אויביך"@he ;
    oa:hasSelector opp:unit_fol_128r_1_u1_selector ;
    oa:hasSource opp:passage_fol_128r_1 .

opp:unit_fol_128r_1_u1_selector a opp:TokenPositionSelector ;
