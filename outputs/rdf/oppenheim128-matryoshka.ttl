opp:unit_fol_9v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_9v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "אם רצת לכבו חנם הווין לו בנים ובנות מתוקנים למעלה אנ רבת לכבשאר עני הווין לו בנים בעלי תורה ומקיימי מצות בישראל אם ראית חם כ חכם שמת אל תחזור מעליו עד שתוליכהו לקבר שבחזרתך יספרו בשלומך בשלום פנחם בן אלעזר אל ראית עני חבירך שנתדלדל ומטה ידו אל תחזירהו ריקם שנאמ שומר מצוה לא ידע דבר רע אם הלוית לו מאומה בשעת דחקו יתקיים עליך אז תקרא וימ יענה ואם גדלת עלמך בפני חביריך הקבה משפילך ואם כבדוך אחרים בין בישיבה ב במסבה עשה עמהם שלום ותנוח על משכבך וכן היה ר אלעזר הקפר ברבי אומ גדול השלם ושנואר המחלקת גדול השלום שאפי עובדין עז כביכול אין שנינה יכולה לנגוע בהם שנ חבור עצבים אפרים הנח לו ואם ישביניהם מחלקת מה נאמר בהם חלק לבם עתה יאשמו הא כיצד בית שיש בו מחלקת סופו ליחרב וחכמים אומרים מיזלקת בעיר שפיכות דמים בעיר בית הכנסת שיש בה מחלקת סוכיה ליחרב וחכמים אומ מוזלוקת בבית הכנסת סופיה להתגזר שנר תלמידי חכמים הדרים בעיר אחת והם בתי דינין וביניהם מחלוקת סופם למות"@he ;
    oa:hasSelector opp:unit_fol_9v_1_u1_selector ;
    oa:hasSource opp:passage_fol_9v_1 .

