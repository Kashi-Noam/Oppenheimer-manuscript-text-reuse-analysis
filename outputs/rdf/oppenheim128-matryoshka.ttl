    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_59v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_59v_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אמרו חכמים הוירך כקנה ואל תהי קשה כארז כיצד מכבד אדם את רבו בזמן ששניהם מהלכין בדרך יותנו לימין ואיזנותנו נסמם היו שלשה תלמיד וחכם והרב ביניהם הרב הולך באמצע והגדול בימינו והקטן לשמאלו וכן מצינו בשלשה מלאכים שבאו אצל אברהם אבינו ואלו הן גבריאל ומיכאל ורפאל גבריאל בא להפוך אתסצום ואת עמורה רפאל בא לרפאת את אברהם מיכאל בא לבשר את שרה והיה מיכאל באמצע וגבריאל בימינו ורפאל בשמאלו וכיון שראה אברהם אבינו את מלאכי השרת באתה שכינה ועמדה למעלה"@he ;
    oa:hasSelector opp:unit_fol_59v_1_u2_selector ;
    oa:hasSource opp:passage_fol_59v_1 .

opp:unit_fol_59v_1_u2_selector a opp:TokenPositionSelector ;
