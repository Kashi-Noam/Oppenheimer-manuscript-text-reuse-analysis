opp:unit_fol_131r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_131r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ויתן לשבי עזו זה ארון הבהת ותפארתו ביד צר אלו בגדי כהונה גדולה שנ ועשית בגדי קדש לאהרן אחיך לכבוד ולתפארת ר יהושע דסכני בשם ר לוי אחרי אתה נתת להם שבע כבשות חייך שהן עתידין להחריב מבניך זצדיקים לו הן שאול וג בניו ועלי וחפני וכנחם ואית ואמרי שמשון ולאעל אמ ר יהי בשם דסכני בשם ר חייא אמ לו הקבה לאברהם אתה נתת להם א כבשות חייך שהן עתידין להחריב מבניך ו עולמו ואלו הן אהל מועד וגלגר ושילה ונוב וגבעון ובית הע העולמים שנים אמר אלהים פן ינחם העם בראותם מלחמה ושבו מצרימה מה היית אמ על בני אפרים שעל שטיעו את הקץ כ שנה נפלו מה מאה ושמנים אלף ההד בני אפרים נושקי רומי קשת הפכו ביום קרב"@he ;
    oa:hasSelector opp:unit_fol_131r_1_u1_selector ;
    oa:hasSource opp:passage_fol_131r_1 .

opp:unit_fol_131r_1_u1_selector a opp:TokenPositionSelector ;
