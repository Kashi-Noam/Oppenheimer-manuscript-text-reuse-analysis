    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ירמיהו בן חלקיהו ר אבא בר כהנא פתח צהלי קולך בת גלים צהלי קולך ליצלי בקכיך בתגכים מה קגלים הללו מסוימים בים כך היו אבתיכם מסוימים בעולם דא בת גלים בת גולים ברתהון דגלולאי בתו של אברהם מה כת בו ויאמר יי אל אברם לך לך מארצך בתו של יצחק מה כתוב בו וילך יצחק אל אבימלך מלך פלשתים גררה בתו של יערב מה כתוב בו וישמע יעקב אל אביו ואל אמו וילך פדנה ארם הקשיבי לישה הקשיבי למצותי הקשיבי לדבדיתורה הקשיבי לררי נבואה ואם לאו לישה הא אריה סליק עלך זה נבוכד נצר שנ עלה אריה מסבכו עניה מן הצריקים יעניה מדבריתורה עניה ממצות ומעשים טובים ואם לאו ענתות י הא ענתותי אתי ויתנבי עלך דברי תוכחו לפיכך צרך הכת לומ דברי דמיהו בן חלקיהו"@he ;
    oa:hasSelector opp:unit_fol_138r_1_u1_selector ;
    oa:hasSource opp:passage_fol_138r_1 .

opp:unit_fol_138v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_138v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר אחא פתח עד מתי פתיים אמ ר שמעון בן נזירא בנוהג שבעולם אדם אוכל צחנה ג ימים ונפשו קוטטה עליו אתם כמה שנים אתם עובדים עא אותה שכתוב בה צא תאמר לו ואין נפשכם קניטה ממנה אמ ר יודן שני בני אדם נקנבאו על הליצנות ואלוה ן שלמה וישעיה שלמה אמ ולצים לצון חמדו להם וישעיה אמ ועתה אל תתלוצצו ר פנחס בשם ר שמואל בררב יצחק אמ קשה היא הליצנות שתחלתה ייסורין וסוכה כלייה תחלתה ייסורין דכת ועתה אל תתלוצצו כן יחזקו מוסריכם וסופה כליה שנ כי כלה ונחרצה שממתי מאת יי אלהים צבאות ואם לאו אודיעה דברי אתבם לפיכך צרך הכת לומ דברי ירמיהו בן חלקיהו ר אחא פתח אבותיכם איה הם והנ ביאים הלעולם יהיו אמ הקבה לישראל אביתיכם שחטאו לפני היכן הם אמרו רפניו רבונו של עולם והגביאים הלעולם יחיו אמ להם הקבה אעפ שמתו נבואתם קיימת משה שמת נבואתו קיימת וידמיהו דבריו קיימין לפיכך צרך הכתוב לומד דברי ירמיהו בן חלקיהו ר יהזשע דסכנין בשם ר לויפתח עבד משכיל ימשול בבן מביש אלו ישראל שביישו את עצמן לעם אמ ר אבא בר"@he ;
    oa:hasSelector opp:unit_fol_138v_1_u1_selector ;
    oa:hasSource opp:passage_fol_138v_1 .

opp:unit_fol_138v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_138v_2#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "יאתי ברה דמקלקלתה דתקנת עיבריה ויוכח לברה דמ דמת קלא דמתקנא דקלקלת עובדהא את מוצא כל מה שכת לישראל לגנאי כתוב ברחב בשבק ברחב כתוב ועתה השבעו נא לי ביי אלהי ישראל ובישראל כת אכן לשקר ישבעו ברחב כתוב והחייתם את אבי ואת אמי ובישראל כתוב אב ואם הקלו בך ברחב כת והיא העלתם הגגה ובישראל כת ואת המשתחוי על הגטת וכתו ותטמנם בפשתי העץ הערוכות לה על הגג ובישראל כתו אומרים ללבץ אבי אתה ברחב כתו ויאמר להם ההרה לכו ובישראל כתו על ראשי ההרים יזבחו ברחב כתו ונתתם לי אות אמת ובישראל כתר ואמת לא ידברו הוי כל מה שכתוב בישראל לגנאי כתו ברחב לשבח ובתוך אחים יחלק נחלהי זה ירמיה כתוב ויצאירמיה מיחשלם ללכת רבא אמ ליניול מחלקו צח ר בנימן בר לוי אמ למשרייה חמאן נבואן סגיאן דבר ירמיה אין כתוב כאן אלא דברי ירמיהו לפיכך צרך הכתוב לומר דברי ירמיהו בן חלקיהו ר שמואל בל נחמן פתח אם לא תורשו את יושבי הארץ אמ הקבה לישראל אני אמרתי לכם כי החרם תחרימם החתי והאמרי ואתם לא עשיתם כן אלא ואת רחב הזונה ואת כל בית אביה ואת כל אשר לה החיה יהושע"@he ;
    oa:hasSelector opp:unit_fol_138v_2_u1_selector ;
    oa:hasSource opp:passage_fol_138v_2 .

opp:unit_fol_139v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_139v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כאנש דאמ חמון מה עבד לי גנוסא דבבל פן שחיק טמיא כך אמ הקבה חמון מה עבד לי ננוסא דבבר דא דבר ירמיהו קינוי דירמיהו איכה ישבה בדד איכה יעיב איכה יועם דא דברי ירמיהו אמ הקבה לירמיהו לך אמיר להם לישראל עשוהתשובה ואי לא אנא מחריב בית מקדש אמרין ואי מחריב לאו דידיה הה מזרי מחריב אלא כך אמ הקבה אנא מחריב בית מקדשי ודבר יקום ביד ירמיהו דא דגדי ירמיהו אמ הקבה ליר לירמיהו דברי אנא בעי גבהון ירמיהו אני אמרתי להם אנכי יי אלקיך והם לא עשוכן אלא ואת המשתחוים על הגגות אכן לשקר ישבעו אני אמרתי זכור את יום השבת והם לא עשו כן אלא קדשי בזית ואת שבתותי חללת אני אמרתי כבד את אביך והם לא עשו כן אלא אב ואם הקלו בך אני אמרתי לא תרצח לאתנאף ולא תגנוב והם לא עשו כן אלא הגנוב רצוח ונאוף אני אמרתי להם לא תענה ברעך עד שקר והם לא עשוכן אלא וידרכו את לשונם קשתם שקר אני אמרתי להם לא תחמוד והם לא עשו כן אלא וחמדו שרות וגזלו"@he ;
    oa:hasSelector opp:unit_fol_139v_1_u1_selector ;
    oa:hasSource opp:passage_fol_139v_1 .

opp:unit_fol_140r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_140r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "או את הוי הכא ואנא נחית עמהון אמ ירמיהו לפני הקבה רב ונו של עולם אם אנא בחית עמהון מה אנא מהני להון יחות ברייהון עמהון דהוה מהני להון ג דברים צוה נבוכד נצר את נבוזר אדץ על ירמיהו אמ לו קחנו ועיכך שים עליו והיה ירמיהו רואה כת של בחורים שלולים בקולרות של ברזל והולך ומכניס אתיה ביניהם וחוזר אחרים ועושהכן אמ ליה נבוזר אדן חדא מן תלת מלין אית בך אונביא של שקר אתה או מבעיט בייסורון את או שופך ודמים את או נביא של שקראתה את הוא דהא כמה שנין את קאים ומתנבא על הרא קרתא ועל הדא זויתא רתחרב ולדון דדיני חרבא באש לך אומבעיט בייסורין את אנא לית אנא בעי מעיק לך ולית ייסורין חשובין עלך כלום או שופך דמים את דאי מלכא שמע מה הא מתעביד בך ואנא לית אנא עביד לך כלום הוא משלח ומרים ראשי אלא אם טוב בעיניך לבא אתי בבל בא ועודנו לא ישוב עד שגלה לו הקבה ההד הדבר אשר היה אל ירמיהו מאת יי אחר שלוח אותו נבוזר"@he ;
    oa:hasSelector opp:unit_fol_140r_1_u1_selector ;
    oa:hasSource opp:passage_fol_140r_1 .

opp:unit_fol_142r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_142r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה בנימין כל זמן שהיה במעי אמי לא מתה וכיון שיצא ממנה מתה ההד ויהי כצאת נפשה כי מתה ותקרא שמו בן אוני כך כל ימים שהיה ירמיה בתיך ירושלם לא חרבה וכיון שיצא ממנה חרבה הוא שירמיהו אומ פתיתני יי ואפת שדלתני ואשתדליה אפקקני מן גנה וחרבת אותה אתמל אמרת לי הנה חנמאל בן שלום דודך ועכשו חזקתני ותוכל אי מה בנימין אחרון לכל השבטים אף ירמיהו אחרון לכל הנביחים וכי לא כבר נתנבאו אחריו חגי זכריה ומלאכי ר אלעזר ור שמואל בר נחמן ר אלעזר אמ קצרי נבואה היתה ר שמואל בר נחמאץ אמ כבר היתה נבואה פקודה בידם ר אלעזר ור יוחנן ר אלעזר אמ כל הנביאים נתנבאו דברי תוכחות וחתמו בדברי נחמות חוץ מירמיהו שחתם בדברי תוכחות שאמ ככה תשקע בבל ולא תקום מפני הרעה אמ ר יוחנן ועד הוא בדברי נחמות חתם לפי שהיה חוזר ומתנבא על חורבן בית המקדש יכול בחורבן בית המקדש חתם תלמוד לומ עד הנה דברי ירמיהו"@he ;
    oa:hasSelector opp:unit_fol_142r_2_u1_selector ;
    oa:hasSource opp:passage_fol_142r_2 .

opp:unit_fol_142v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_142v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דברי ירמיהו ואם כאו דבר יי מה ירמיהו עובר אף דבריו עובה מה הקבה חי וקיים אף דבריו כן חיים וקיימים לעו ולעולמי עד ויהי בימי יהויקים בן יאשיהו אמ ר אבין עלה אריה מסבכו במזל אריה עד ולות ירושלם בחדש החמשי והחדיב אריאל שנ הוי אריאל אריאל קריה חנה דוד על מנת שיבא אריה במזל אריה ויבנה אריאל יבא אריה זה הקבה דכת ביה אריה שאג מי לא יירא במיל אריה שנ והפכתי אבלם לששון אב שלהם לששון ויבנה אריאל שנ בונה ירושלם י טדחי ישראל יכנס שמעו דבר ייי ביתיעקב לכן אנשילבב שימי שמעיו לי חכינה כשל מרשנ ושדי מעול רעזריה וריונתן בן חגי בשם שמואל בר רבינחק קפדנותן של אבות ולא ענוהנותן שלבנים קפדנותן שלאבות זה"@he ;
    oa:hasSelector opp:unit_fol_142v_1_u1_selector ;
    oa:hasSource opp:passage_fol_142v_1 .

opp:unit_fol_143r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_143r_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר סימאי בנוהג שבעולם חתן דר אצל חמיו ועובר לצאת מבית חמיו אפשר שלא ימצא בידו אפי דבר קל חה אפי מחט אפי סכין לא נמצא בידו ההד כי מששת את כל כלי מה מצאת מכל כלי ביתיך אמ הקבה חייך בל שון שהונחת את חמיך בו בלשון אני מיכיח את בניך שנא כה אמר יי מה מצאו אבותיכם בי עול ושומנ לי ישכן בטח ארבעה שומעים הם שמעג והפסיד י שמע ונשכר שלא שמיג ונשנר שלא שמע והפסד שמעג והפסיד זה אדם הראשון שנ ולאדם אמד כי שמעת לקול אשתך ומה הפסיד כי עפר אתה ואל עפר תשוב שמע ונשכר זה אבינו אברהם שנ כל אשר תאמר אליך שרה שמינ בקולה ומה"@he ;
    oa:hasSelector opp:unit_fol_143r_1_u2_selector ;
    oa:hasSource opp:passage_fol_143r_1 .

opp:unit_fol_143r_2_u2 a opp:TextUnit ;
    rdfs:label "fol_143r_2#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמר אחא צריכה לישראל חריבה כי עבדין תשובה אמ ר עקיבא יאיה מסכנותא לברציה דיעקב כערקא סומקא בגרוניה דסוסיא חור אמ ר שמואל בר נח מץ כד תמוט בידה בירה שמה וכד תרום קיקלא קיקלא ישמה כד תמוט בירה ביכה שמה שמעו דבר י בית אפי בירידתן הואקורא אותן בית ישראל וכד תרום קיקלה קיקלא שמה זה ארץ כשדים זה העם לא היה ולואי לא היה אמ ר לוי משר למטרונה שהיו לה שני שושבינים חד עירני וחד בר מדינה זה שהיה עירני היה אומ לה דברים של ניחומים לא בת גיניסים את זה שהיה בר מדינה היה אומר לה דברים של קנתרין ונא בת יהודים ולא בת סנותים את כך ירמיה על ידי שהיה עירני מענתות היה גכנס לירושלם ואומ להם דברים של נחומים שמעו דבר יי בית יעקב אלין מיליא עזבתא הוון אבהתכון עבדן ברם ישעיה על ידי שהיה בר מדינה מירושלם היה אומ לישראל דברים שכקנתרין שמעו דבר יי קציני סדום האזינו תורת אלהינו עם עמור מן פלטתא דעמרידסדום"@he ;
    oa:hasSelector opp:unit_fol_143r_2_u2_selector ;
    oa:hasSource opp:passage_fol_143r_2 .

opp:unit_fol_143v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_143v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר לוי אמוץ ואמצי אחים היו ועל ידי שהיה ישעיה בן אחיו של מלך יהיה אומ לישראל דברים של קנטרין כדא ועשיר יענה עזות אמ ר לוי משל כמטרונה שהכניסה כמלםך שני הדסי ואבדה את שניהם כך כיון שעמדו ישראל על הרסיני ואמרו כל אשרדבר יי נעשה ונשמע אבדו את שניהם ועשו ועשו להם עגל מסכה אמ להם הקבה אם תשמרו את נשמע וכאלו שמרתם את שניהם וכיון שלא שמעו אמ להם הקבה שמעו דבר יי עד שלא תשמעו קל קרנא משרוקיתא שמעו בארץ ישראל עד שלא תשמעו בחוצה לה שמעו חיים עד שלא תשמעו מתים ותשמעו אזניכם עד שלא תשמעו עצמותיכם שנ העצמות היבשות שמעו דבר יי ר הונא ור אחא בשם ר יהושע בן לוי אמ קרוב לשמנה פעמים נעשו ישראל כתף אחת במצהם ומאי טעמיה הבה נתחכמה לו פן ירבה והיה כי תקראנה מלחמה מתוךכך קפץ עליהם ובאלם שנ וארד להצילו מיד מצרים ר"@he ;
    oa:hasSelector opp:unit_fol_143v_1_u1_selector ;
    oa:hasSource opp:passage_fol_143v_1 .

opp:unit_fol_144r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_144r_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ואיני מקבלת שכד אלא על אחת מי גרם לי שאהא משמרת שני ימים טובים בסוריא על שלא שמרתי יום טוב אחד כתקונו בארץ ישראל סבוהה הייתי שאני מקבלת שכר על שנים ואיני מקבלת שכר אלא על אחד ר יוחנן הוה קר עליהון וגם אני נתתי להם חקים לא טובים ומשפטים לא יחיו בהם הה אמר יי מה מצאו אבותיכם בי עול אמ הבה לישראל אבותיכם לא מצאובי עול ואתם מציתם ביעל אום החשן לא ימצח בי על ואתם יצאת ביעיל למה היה אדם הראשון דומה לחחולה שנכנס אצכו רופא אמ לו דבר פלכי אכול ודבר פלני לא תאכל וכיון שעובר על דבריו גורם מיתה לעצמי נכנסו קרוביו אצלו אמרו לו תאמר שהרופא עבר עליך מדת הדין אמ להם חס ושלום אני הוא שגרמתי מיתה לעצמי כך וכך צוני הרופא ואמ לי דברפלני אכול ודבר פלני לא תאכל וכיון שעברת על דבריו גרמתי מיתה לעצמי"@he ;
    oa:hasSelector opp:unit_fol_144r_1_u2_selector ;
    oa:hasSource opp:passage_fol_144r_1 .

opp:unit_fol_145v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_145v_1#u1" ;
    opp:earliestWitness opp:work_Midrash_Aggadah ;
    rdf:value "איכה כת אף בניו הכנסתי אוינם לארץ ישראל דצייתים ועברו על צוויי ודנתי אותם בגירושין וינשלוחים וקיננתי עליהם איכה הכנסתי אותם לחדץ ישראל שנ ואביא אתכם אל ארץ הכמל וצויתים שנ צו את בני ישראל ויעבדו על צידיי שכא יכל ישראל עברואת תורתי ודנתי אותם בגירושיז שנ מכת אירשם ודנת אותם בשליחים שנ שלח מולי פני יצנו וקוגנתי עליהם איכה ישבה בדד אגח בר נזהנא פתח לא ישגתי בסור משחקים ואעלוז אמדה כנסת ישראל לפני הקבה רבדנו של עולם לזנכנ גיבוה תררטיאות ובבתי קרים יאות של אומותהעולם ושזקיני עמיהם ואנלוז מפני ידך בדד ישבתי נגעה בי יד שר פרעה ולא ישבתי ברר ננעה בי יד של סנזריב וכו ייינ נ כוד וכיון שנגעה ביידך בדד ישבתי שנ מפני ירך בדר ישבתי וכן איכה ישבה בדד ר קפרא פתח ויקרא יי אלהים צבאות ביום ההוא לבכי ולמספד ולקרחה ולחגיר שק אמ הקבה למלאכים מלך בשר גדם כשהוא אבל מה הוא עושה אמרו לוי תולה לו שק על כיתחו אמ להם אף אני עושה כן שנ אלביש שמים קדרו ושק אשים כסותם ועוד שאל להם מלך בשר גדם אבל מה הוא עושה אמ לו"@he ;
    oa:hasSelector opp:unit_fol_145v_1_u1_selector ;
    oa:hasSource opp:passage_fol_145v_1 .

opp:unit_fol_145v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_145v_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "וכן איכה ישבה בדד ר קפרא פתח ויקרא יי אלהים צבאות ביום ההוא לבכי ולמספד ולקרחה ולחגיר שק אמ הקבה למלאכים מלך בשר גדם כשהוא אבל מה הוא עושה אמרו לוי תולה לו שק על כיתחו אמ להם אף אני עושה כן שנ אלביש שמים קדרו ושק אשים כסותם ועוד שאל להם מלך בשר גדם אבל מה הוא עושה אמ לו מכבה את הפנסין אמ להם אף אני אעשה כן שנ שמש וירח קדרו וכוכבים אספו נגהם"@he ;
    oa:hasSelector opp:unit_fol_145v_1_u2_selector ;
    oa:hasSource opp:passage_fol_145v_1 .

opp:unit_fol_146r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_146r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ועוד שאל להם מלך בשר ודם אבל מהי עושה אמרו לומהלך יחף אמ להם אף אני עושה כן שנ בסופה ובסערה דרכו וענן אבק רגליו ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו יושב דומם אמ להם אף אני עושה כן שנ ישב בדד וידם ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו מהפך את המטה אמ להם אני עושה כן שנ חזה הוית עד די כרסוון רמיו ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו מבזע פורפירא אמ להם אף אני עושה כן שנ עשה יי אשר זמם בצע אמרתו אמ ר יעקב דכפרחנן מבאפ פרפירא ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו יושב ומקונן אמ להם אף אני עושה כן שנ איכה ישבה בדד כה אמר"@he ;
    oa:hasSelector opp:unit_fol_146r_1_u1_selector ;
    oa:hasSource opp:passage_fol_146r_1 .

opp:unit_fol_148v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_148v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בר קפרא אמ ארכי בן יונס דהוו זינים אטאקיא אטאקטיא וחברי גנבים שהיו מתחברים לגנבים אמ ר ברכיה מעשה באשה אחת שנגנב מיחם שלה ובאה לקבול לפני הדיין ומצאתו שפות על גבי כירתי ועיד מעשה באיש אחד שנגנבה לו טליתו ובא רבאלקבול לפני הדיין ומצאה מוצעת על בי מטתו אמ ר לוי מעשה באשה אחת שכבדה לדיין מנורה אחת שלכסף והלך אנדיק אנדיטקיס שלה וכבד שיח של זהב למחם אתת ואשכחת דינה הפוך אמרה ליה מאריינהר דיני בההוא מנרתא דכספא אמ ומה אעשה וכפה השיח את המנורה ההד כלו אוהב שחד ורודף שלמונים היו אומ שכים לי ואנא אשכם לך יתום לא ישפוטו ר אלעזר ור יוחנן ר אלעזר אמ בראשונה היה אדם מת בירושלם והיה ממנה אפטרופוס על היתומים והיתה אלמנה תובעת כתובתה אצל היתומים והם הולכים אצל הדיין ומיצאים אותו חשוד"@he ;
    oa:hasSelector opp:unit_fol_148v_2_u1_selector ;
    oa:hasSource opp:passage_fol_148v_2 .

opp:unit_fol_149r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_149r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והיתה אומ מה אם זה שהוא איש לא הועיל כלום אני שאני אלמנה על אחת כמה וכמה לקיים מה שנ יתום לא שפטו וריב אלמנה לא יבא אליהם כבץ נאם האדון יי צבאות אביר ישראל אמ ר שמואל בר נחמן כל מקום שנ נאם האדון עוקר דיורים ומבניסדיורים בנין אב שבכרם היה ארון הברית אדון כל הארץ עוקר כנעניים ומכניס ישראל אביר ישראל רתנחום בר חנילאי תקיפיהון רישאל ורבנן אמ אביר ישראל לפנ אומות העילם הוי אנחם מצרי ואנרמה מאויבי ר יהודה ור נחמיה ר יהודק אומ היה לאהם פשרה זקובים ואתה עוקף עליו ונוטלם ממנו אמהקבה עלי לשלום גמולו ולהפרע מאותו האיש ורב נחמן אמ הוי אנחם מצרי שתים ואנקמה מאויבי שתים אלו דמלתיות ואשיבה שופטיך כבראשונה זה משה ואהרן ויועציך כבתחלה זהד דוד ושלמה אחריכן יקרא לך עיר הצדק קריה נאמנה ציון במשפט תפדה ושביה בצדקה גחמו כחמו עמי האנוש מאלוה יצדק אם מע מעשהו יטהר גבר וכי ישאדם ברק מבוראו אלא אם מפשהו יטהרגבר אמ הקבה בועז מנחם ואני איני מנחם בועז מנזם שנ ויען בעז ויאמר לה"@he ;
    oa:hasSelector opp:unit_fol_149r_1_u1_selector ;
    oa:hasSource opp:passage_fol_149r_1 .

opp:unit_fol_150r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_150r_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דברתי אני עם כבי י לאמר י הלב יודע יהלב חאה הלב שומע הלב עומד י רת הלב נופל י הלב מה לד הלב צועק יהלב מכנה הלב שמח הלב רואה שנ ולביראה הרבה חכמה ודעת הלב מדבר שנ דברתי אני עם לבי י הלב יודע שנ לב יודע מרת נפשו הלב שומרו שנ ונתת לעבדך לב שומע הלב עומד שנ היעמד לבך הלב נוכל שנאמ אליפל לבידם עלו יהלב מהיך שלא ריאמר אליי לא לכי כלך הלב ביכם שנ בנם לבם אל י הלב שמאח שנא לכן שמח לבי ויגל כבודי הלב מסתער שנ ויסער לב מלך ארם הלב מתנחם שנ נחמי נחמו עמים דברו על לב ירושלם מה"@he ;
    oa:hasSelector opp:unit_fol_150r_1_u2_selector ;
    oa:hasSource opp:passage_fol_150r_1 .

opp:unit_fol_150v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_150v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ור נתן אמ שני נביאים בשחרית ושני נביאים בערבית השכם ושלוא בבקר השכם ושלוח בין הערבים דא מה אעידך כמה קשוטים קשנותי אתכם דאמר יוחנן ביום שירד הקבה לסיני ליתא תורה לישראל ירדו עמו םרבוא שכ מלאכי השרת וכל אחד ואחד מהם עטרה בידו לנטר לכל אחד ואח מישראל אמ ר אבא ברכהנא בשם ר יוחנן קכ רבוא כדי להלבישאן ענוה ענדה ואחד לאסרו זינו ר חננא רבא דמצנתרין אמ חינם כדא מוסר מלכים פתח ויאסר אזור במתניהם דא מה אעידך כמה בזות נתתי לכם בזת מצרים ובזת הים ובזת סיחון ועוג ובזת לא מלכים דא מה אעידך ויעודים ויעדתי לכם אהל מועד וגלגל ושילה ונב וגבעון ובית העולמים שנים ומה אדמה לך לאי זו אומה דמיתיאתכם איזו אומה גאלתי ככם ביד חזקה והבאתי על אויב עשר מכות ולאי זו אומה קרעציאת הים ולחיזו אומה הורדתי את המן ולאיזו אומה הגזתי את השלו ולאיזו אומה הקפתי ענני כבוד ולאיזו אומה קרבתי לכני הרסיני ונתכי להם את"@he ;
    oa:hasSelector opp:unit_fol_150v_1_u1_selector ;
    oa:hasSource opp:passage_fol_150v_1 .

opp:unit_fol_152r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_152r_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מאהביך שכחוך אותך לא ידרושו כי מכת אויב הכיתיך באיוב בת כשדים שמו שלשה ראשים ובירושלם כת והעיר נתנה ביד הכשדים באיוב כת אש אלהים נפלה מזהשמים ובירומלם כתוב ממרום שלחאש בעצמותי וירדנה באיוב כתו ויקחלוחרש להתגרדבו ובירושלם כתוב איכה נחשבו לנבלי חרש באיוב כתיב וישבו אתילארץ ובירושלם כתוב ישבו לאירץ ידמי באיוב כתוב שק תפרתי עליגלדי ובירושלם כתוב העלו עפר על ראשם באוב כתוב חנוני חנוני אתם רעי ובירושלם כתוב אשר לא אתזככם חנינה באיוב כתוב כייד אלה טעה בי ובירושלם כתוב כי לקחה מיד יי כפלים בכל חטאתיה אמ ר יהושע בר נחמיה מה אם איוב שחטא בכפלים ניתא לו שכד בכפלים וכן ירושלם מקנחמת בכפלים שנ נחמו נחמו עמי"@he ;
    oa:hasSelector opp:unit_fol_152r_1_u2_selector ;
    oa:hasSource opp:passage_fol_152r_1 .

opp:unit_fol_153v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_153v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לב ירושלם כנגד מיאמ ולמי אמ כנד אותם ח נביאים שנת ובאו בחורבנה של ירושלם קודם חורבנה ואחר חורבנה יואל נחום צפניה י מלאבי יחזקאל ירמיה חגי זכריה חטאו ישראלל בהוא שנאמ כחשו ביי ויאמרו לא הוא ולקובהוא שנא והוא כלחם בם ומתנחמים בהוא של אנכי אנכי הוא מנחמכם חטאו בזה שנ כיזה משה האש ולקו בוהר בזה שנ על זה היה דוה לבנו ומתנחמים בזה שנ הנה אלהינו זה חטאו באש שנ הבנים מלקטים עצים והאבות מבערים את האש ולקו באש שנ ממרום שלח אש בעצ בעצמותי ומתנחמים באש שנ ואני אהיה לה חומת אש סביב ולכבוד אהיה בתוכה חטאו ביש שנ היש י בקרבנו ולקו ביש שנ אם ישמכאוב כמכאובי ומתנחמים ביש שנ להנחיל אוהבי יש חטאו ברפלים שנ חטאחטאה ירושלם ולקו בכפלים שנ כי לקחה מיד יי כפכים בכל חטאתיה ומתנחמים בכפילים שנ נחמו נחמו עמי"@he ;
    oa:hasSelector opp:unit_fol_153v_1_u1_selector ;
    oa:hasSource opp:passage_fol_153v_1 .

opp:unit_fol_154r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_154r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר יהודה בר סימון נ זוכרת אני שירים שאמרתי לפניך בלילות כדא ונגינותי גנגןכל ימי חיינו על בית יי בלילה זו לילה וליכוי של פרעה לילה אותו שכתו בו ייהי בחצי הלילה ויי הכה כל בכור בארץ מצרים זו לילה ולילו של גדעון לילה אותו שנתוב כו ויהיבלילה ההוא ויאמר יי אליו קום רד במחנה זה לילה ואותו של סנחריכ כילה שכתוב בו ויהי בלילה ההוא ויצא מלאך יי ויך במחנה אשור אזכרה נגינתי בלילה עם לבבי אשיחה משתעיא אנא עם לבבי ומכשפשה בעובדי ואמ הלעולמים יזנח יי חם ושלום לאשבק ולאשביק ההד כילא יזנחלפולם יי ולאיוסיף לרביתעוד י לשעבר לרצות ולאלרבות לשעבר היזת מרצה אחרים בשבילי ועכשו לא לרצות ולא לרצות משה כעס ואתה אמרת לו לך שוב אל המחנה אליהו כעס ואתה אמרת לו לך שוב לדרכך מדברה דמשק ועכשו לא לרצת ולאלרצות א האפס לנצח חסדו גמר אמר לדור ודור האפס לנצח קסרו מהו האפס אמ ר ראובן לשון יוני הוא כדא האפכ הניח גמר אמר לדור ודור ר חננא בר פפא ור סימון ר חיננכא אמ נגמר אותו דבר שאמרת למשה בסיכי וחנותי את אשר אחון ורחמתי את אשר ארחם"@he ;
    oa:hasSelector opp:unit_fol_154r_1_u1_selector ;
    oa:hasSource opp:passage_fol_154r_1 .

