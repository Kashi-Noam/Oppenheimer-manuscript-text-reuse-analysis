opp:unit_fol_204v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_204v_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "לו משביעך אני שתאמר לי איזו בריה אתה אמ לו הואיל והשבעתני אומר לך נ ילוד אשה אני וכבר נפטרתי מן העולם ובכל יום ויום אני מביא משאוי ליוצא בזה לבית עולמי ומכניסין אותי לתוכו ושוהפין אותי אמ לו בני למה אמ לי מפני שבאתי על נערה מאורסה ביום הכפורים אמ לו בני שמעת שישלך תקנה אמ לו כך שמת מאחורי הפרגוד שבזמן שיעלה בני לתיבה ועונין ישראל אחריו אמז יהא שמיה רבא וברוך יי המבורך לעוכם ועד מכניסין איתי לגזעדן אמ לו בני מה שמך אמ לו אדשיא ושם אשתך שששיא ושם עירך בלדקיא כתב את הכתב עליציו ונטלו בידו עד שהגיע לאותה העיר וכיון שהגיע בה ויצאו בל בניהגיר להלסו אמ להם כלום אתם יודעים פלני אשרו ענ כלם ואמרו לו לא נין לו ולא נכד בעמו אמ להם בני למה מהלו מכני שבא אתו האיש על נערה מאורשה"@he ;
    oa:hasSelector opp:unit_fol_204v_1_u1_selector ;
    oa:hasSource opp:passage_fol_204v_1 .

