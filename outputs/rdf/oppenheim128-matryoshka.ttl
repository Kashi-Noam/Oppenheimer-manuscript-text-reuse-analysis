opp:unit_fol_186r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_186r_2#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "ועתיד הקבה להפכו לש לשמחה שנ כה אמר יי צבאות צום הרביעי וצום החמשי וצום השביעי וצום העשירי יהיה לבית יהודה לששון ולשמחה ולמועדים טובים ועתיד להכנים גליות שלישראל לתוך ירושלם שנ בונה ירושלם יי נדחי ישראל יכנס אמ ר אלעזר עתיד הקבה לעשות מחול לצדיקים בגן עדן וכל אחד ואחד מראה באצבעו שנ ואמרתם ביום ההוא הודו ליי קראו בשמו הודיעו בעמים עלילותיו כתו יפתיתני יי ואפת בשעה שאמ לירמיהו לך הנבא על ירוש ירושלם אמ לפניו רבונו של עולם הנה לא ידעתי דבר כל כך למה שלא היה רוציד להנבא על ישראל נבוא קשה אמ לו הקבה בטרם אצרך בבטן ידעתיך וליון שאמ לו נביא לגוים נתתיך נתיישבה דעתו ואמ מוטב לגוים ולא"@he ;
    oa:hasSelector opp:unit_fol_186r_2_u1_selector ;
    oa:hasSource opp:passage_fol_186r_2 .

opp:unit_fol_186r_2_u1_selector a opp:TokenPositionSelector ;
    oa:end "165"^^xsd:nonNegativeInteger ;
    oa:start "50"^^xsd:nonNegativeInteger .

opp:unit_fol_186v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_186v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "לו הבה קח את כוס היין החמה מיד נטלו שנ ואקח את הכוס מיד יי אמ ירמיה לפני הקבה רבונו של עולם למי זשקה אותו אמ לו למי משקין כוס תחלה אמ לו למי שמסב בראש ומי מסב בראש ירושלם מיד התחיל צ צועק ובוכה משל למה הדבר דומה לשוטה שנכנסה לעזרה לשתות מי המרים ובאהכהן להשקותה נסתכל בה והיא אמו נתביש וחזר לאחוריו התחיל צועק ובוכה על אמו כך ירמיהו כיון שאמ לו לך השרף את ירושלם צעק צעקה גדולה ומרה ובכה בפיה גדולה ואמ לפני הקבה רבולו של עולם לאכך אמרת לי נביא לגים נתתיך ועוד אמרת לי והשקית אותו את כל הגוים דכת פ כה אמר יי אלהי ישראל אלי קח את כוסהיין החמה הזאת מידי והשקית אותו את כל הגוים אשר אני שולח אותך ושתו והתגועשו והתהוללו מפני החרב אשר אנכי שולח ביניהם ואקח אתהכום מיד יי ואשקה את כל הגוים את ירושלם ואת ערי יהודה ואת מלכיה ואת שריה לתת אותה לחרבה לשמה ולשרקה ולקללה כהיום הזה ועכשו תחלת נביאתו פתיתני יי ואפת חזקתני ותיכל כי מדי אדבר אזעק חמט ושד אקרא כיהיה דצר יי לי לחרפה ולקלס כל היום אמ לו הקבה"@he ;
    oa:hasSelector opp:unit_fol_186v_1_u1_selector ;
    oa:hasSource opp:passage_fol_186v_1 .

