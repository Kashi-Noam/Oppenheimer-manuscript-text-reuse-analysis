opp:unit_fol_67v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_67v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "תשעה נכנסו בחייהם לגן עדן ואלו הם חנוך בן ירד ואליהו ואליעזר עבד אברהם וחירם מלך צור ועבד מלך הכושי ויעבן ובן בנו של ר יהודה הגשיא ובתיה בת פרעה ושרח בת אשר ויש אומ אף ר יהושע בן לוי כצררץ ףרקא כםל דרכיך יהין לשם שמים הוי אוהב את השמים וירא מן השמים הויחרד ושש על המצות שב לפני הזקנים והטה אזנך לשמוע את דבריהם והקשב אזכך לדברי חביריך אלתרדי גבהל להשיב ותהא מחשב דברים בענין ואמור על ראשון ראשון ועל אחרון אחרון והוי מודה על האמת ואל תדבר בפני מי שגדול ממך בחכמה ואם חפצת לרמר ללמד אל תאמר על מה שלא שמנת שמנת ואם שאת שאלוך דבר קטן ואי אתה יודעביו אל תבוש לומ איני יו ואם שנו לך ולא שמעת אל תבוש לומר שנולי ואל תשא פנים לעצמך לומר לא שמעתי עשה דבריך לשם פועלם לדבר בהם לשם שמים אל תעשםל כעטרה להתעטר בהם ולא כקרדום לאכול בהם ולא כמר לחפיר בהם קבל עליך דברי תורה בצער ואל תהי מבקש עלבונך חשבון יפה ופרק טוב איש הבטחה"@he ;
    oa:hasSelector opp:unit_fol_67v_1_u1_selector ;
    oa:hasSource opp:passage_fol_67v_1 .

opp:unit_fol_67v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "171"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_68r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_68r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "דע שמן היום למחר בין שהוא שלך בין שאינו שלך את שלך אינו שלך ואת שאינו שלך והיהי שלך עליו הכת אומ הוי המרבה לא לו למוד להיות גומר בטוב הוי עלוב ואהוב לכל ושפלרוח ולשון רכה הוי קל לראש ונוח לתשחורת תואר טוב הרחק מן המביא לידי עבירה הוי נרתע מחטא הקל שמא יביאך לחטא חמור הוירץ למצוה קלה ובורח מעברה קלה שמא תביאך לחמורה יהיכבוד חבירך חביב עליך כשלך הוי מיקר את כל האדם אל תאמר אחניף לזה שיאכילני ולזה שישקני ולזה שילבישני ולזה שיכסני מוטב שתתבייש מעצמך ואל תתבייש מאחרים אל יכלימוך שפתיך ואל יבזך פיך ואל הנאך לאונך"@he ;
    oa:hasSelector opp:unit_fol_68r_1_u1_selector ;
    oa:hasSource opp:passage_fol_68r_1 .

opp:unit_fol_68r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "102"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_68v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_68v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "אם הטיבות הרבה יהי בעיניך מעט ואל תאמר משלי הטיבותי אלא ממה שהטיבדך יוצרך וצריך אתה ליתן הודאה לשמים ואם הטיבוך מעט יהי בעיניך הרבה ואל תאמר בשביל מעשי ההגונים הטיבו לי אלא בשביל מעשי שאינן הגונין הטיבו לי שנאמ ומשלם לשנאיו על פניו להזבידו אם הרעות מעט יהי בעיניך הרבה ואמור אוי לי כי חטאתי אוי לי כי בא מכשול על ידי ואם הרעוך הרבה יהי בעיניך ימעט ואמור במעט נגביתי והלא יתר מיכן הייתי ראוי סבירק פרוקא תן דעתך עד שיצא דבר מפיךך חשוב מעשיך בדרך ארץ ותן שכר לפסיעיתיך צדק הדין עליך והוצא עצמך מן התר עומת הוי דן את חבירך לכף זכות ואל תכריעהו לכף חובה הוי שש בחלקך והת נאה במיעוטך ואל תשנא את המוניחך יהא חלקך מבורך לעולם עין טובה ונפש שבעה למד השונך לומר איני יודע שמא תבבדה ותאחז אם רפית במצוה אחת סופך לרפות באחרת וכן כיוצא בה אם הקלות עשצמך להקל מצוה אחת סופך להקל באחרת וכן כיוצא בה ואם עברת עד דצי תירה ברבינך מעבירין אותך ביצונך ושלא"@he ;
    oa:hasSelector opp:unit_fol_68v_1_u1_selector ;
    oa:hasSource opp:passage_fol_68v_1 .

opp:unit_fol_68v_1_u1_selector a opp:TokenPositionSelector ;
