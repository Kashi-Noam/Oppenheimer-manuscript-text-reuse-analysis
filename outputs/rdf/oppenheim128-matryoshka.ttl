opp:unit_fol_192v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_192v_1#u2" ;
    opp:closestWitness opp:work_Eichah_Rabbah ;
    opp:earliestWitness opp:work_Eichah_Rabbah ;
    rdf:value "שבית המקדש חרב וישראל גלו מעל ואתה מתבקש לבכות ולספוד מיד קרע משה את בגדיו והניח ידו על ראשו והיה הולך ובוכה עד שהגיע אצל אבות העולם וכיון שראוהו אברהם ועגקב אמרו לו בן עמרם מה היה לך אמ להם וכי אין אתם יודעים שבית המקדש חרב וישראל גלו ואנו מתבקשים לספוד ולבכות באותה שעה אף הם קרעו בגדיהם והניחו ידיהם על ראשיהם והלכו הלוך ובכו עדשהגיעו לשערי ירושלם מיד קרא הקבה לבכי ולמספד ואלמלי מקרא כתו אי איפשר לאמרו שנאמ ויררא יי אלהים צבאות ביום ההוא לבכי ולמספד והיו הודפים משער זה לשער זה ומספידים וביכים כאדם שמתו מוטל לפניו"@he ;
    oa:hasSelector opp:unit_fol_192v_1_u2_selector ;
    oa:hasSource opp:passage_fol_192v_1 .

opp:unit_fol_192v_1_u2_selector a opp:TokenPositionSelector ;
