opp:unit_fol_62v_2_u2 a opp:TextUnit ;
    rdfs:label "fol_62v_2#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "או מפני ששותה בה רג אומ מפני שמראה בה טעמי תורה לא ישמח אדם בין הבוכים ולאיבכה בין השמחים ולא יהא ער בין הישנים ולא ישן בין הערים ולא עומד בין היושבים ולא יושב בין העזמדים כללו של דבר אליישנה אדם דעתו מדעת חבריו ובני אדם סליק פרקא הנכנם לביה אנ יאמר להם תנו לי ואוכל עד שיאמרו ליהם מזגו לו את הכום שוהא ושותהו וכמה ישהא בחמין שלש פעמים ובצונן ארבע אמ ר יהודה במה דברים אמורים ברוס שבגליל אבל בכום שביהודה שותה שוהא כל צרכו ושותהו לא יאמר אדם לחברו בוא ואכול ממה שהאכלתני שזת דרך רבית"@he ;
    oa:hasSelector opp:unit_fol_62v_2_u2_selector ;
    oa:hasSource opp:passage_fol_62v_2 .

opp:unit_fol_62v_2_u2_selector a opp:TokenPositionSelector ;
