opp:unit_fol_70v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_70v_1#u2" ;
    opp:closestWitness opp:work_Vayikra_Rabbah ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "ואימתי בחדש השביעי באחד לחדש ר חייא בר מריא פתח אך הבל בני אדם כזב בני איש במאונים לעלות המה מהבל יחד בנוהג שבעולם הבריות אומרות פלני ישאפרנית ופלנית ישא פלני במאזנים לעלות המה מהבל יחד אמ ר חייא בר מריא עד שהם וישויים הבל ממעי אמם הם יחד אמ ר נחמן כל הבלים וכזבים שישראל עושים בעולם הזה כדאי הוא אבינו"@he ;
    oa:hasSelector opp:unit_fol_70v_1_u2_selector ;
    oa:hasSource opp:passage_fol_70v_1 .

