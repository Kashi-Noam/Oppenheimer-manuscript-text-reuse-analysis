opp:unit_fol_174r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_174r_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "אותם בהלכה אמ להם מנין לרם השרן שהוא טמא כבשר השרץ אמ לו ר שמעון זה טמא וזה טמא אמ לו ר חלעזר הדם טמא מן הבשר עמד ר מתיא ונשקו לר אלעזר עלפיי אמ לו רשמעיון ואני למה לא הורית לי אמלו לא נשקתי אותו כהוגן אלא על עריכת שפתיו באותה שעה נתן עיניו בו והיה מוטרף למות ונזכר שבועה שנשבע לאבוו ונתישבה דעתו עליו ובקש עליו רחמים והיו המלחים עוברים בספינה ודקך אחד מהם על צוארו שלר אלער ויצתה אסכרה מפיו וחיה באותה שעה תלה ר שמעון עיניו לתורן של ספינה וראה שידה שמרון שמה יושבת עליו אמ לור שמעון מהד טביך בכאן אמ לו באתי לעשות"@he ;
    oa:hasSelector opp:unit_fol_174r_1_u1_selector ;
    oa:hasSource opp:passage_fol_174r_1 .

opp:unit_fol_174r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "110"^^xsd:nonNegativeInteger ;
    oa:start "1"^^xsd:nonNegativeInteger .

opp:unit_fol_174r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_174r_2#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "באותה שעה אמ ר שמעון לפני הקבה רבונו שלעולם להגר המצרית זימנת על ידה ה מלאכים ולו זימנת שד אמ לו מאי איכפת לך כיוןשיעשה לך נס מה אתה מבקש אמ לו איזה נם את עושה לנו אמ לה אני הולך ער שו ואכרנס בבתו של מלך והיא צווחת ואומ הביאו לי את ר שמעון בן יוחאי ותבא אתה שם ותלחש על אזנה ואני אצא מיד ממלה אמ לו מה סימן ישלי כשאתה ייצא ממנה אמ לו באותה שעה תשברו כל כל יז ככית שיש בביתו של מלך אמ לה לך ועשה כמו שאמרת הלבה ונכנסה בו והיתה צווחת ואומ הביאו לי את ר שמעון בן יוחאי שלחו אחריו לארץ ישראל אמרו להם הריהוא לפניכם באו ומצאוהו בספינה והוליכוהו אצל המלך אמ לו המלר אתה הוא ר שמעון בן יוחאי אמ לו אני ואתה תרפא אתבתי אמ לוהן אמ לו ומה אתה עושה לה אני לוחם על אונה והיא מתרפאת"@he ;
    oa:hasSelector opp:unit_fol_174r_2_u1_selector ;
    oa:hasSource opp:passage_fol_174r_2 .

