opp:unit_fol_98r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_98r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר יצחק פתח כל זו נסיתי בחכמה כת ויתן אלהים חכמה לשרמה ר לויורבנן אמ נתן לו חכמהל כנגד כל ישראל אמ ר לוי מה החוד הזה גדר לים כך היתה חכמה גדרה לשלמה מתלא אמרה דיעה קנית מה חסרת דיעה חסרת מה קנית עיד פרצה ואין חומה אנש אשר אין מעצר לרוחו יכעיר פרוצה ואין חומה כן איש אשר אין מעצר לרוחו כת ותרב חכמת שלמה מחכמת כל בני קום ומה היתה חכמתן של בני קדם שהיו יודעים במזל וערומים בטייר אמ רבין שמעון לן גמליאל בג דברים אני משבח את בני המזרח"@he ;
    oa:hasSelector opp:unit_fol_98r_1_u2_selector ;
    oa:hasSource opp:passage_fol_98r_1 .

