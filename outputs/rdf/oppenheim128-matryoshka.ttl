opp:unit_fol_108v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_108v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הואמביט בצרקי שבכם כיון עמרם ובית דינו ואין הרים וגבעות אלא בכני דינין בלבר כדא ואלכה ויכדתי אל ההרים אמ ר יודן עבדות וגרות בארץ לא להם ועבדום וענו אותם ארבע מאות שנה אפי על אספאטיליאת שלהם ר יודן ור הונא ר יודן אמ בשם ר אליעז רבנו של ר יוסי הגלילי ור הונא בשם ר אלינזר בן עקב אומ קל ררי הנה וה בא זה קלו קולו שלמלך המשיח בשעה שיבא לישראל ויחמר להם בחדש הזה אתם נגאלים והם אומרים לו היאך אנו נגאלין לאכך אמ הקבה שהוא משעבדנו בע אומות והוא משיבן ב תשובות ואומ להם אחד מכם גולה לברבריא ואחד לסדמטייא והוא כמו שגליתם כלכם ולא עוד אלא שהמלכות הרשעה הזאת מכתבת טירונין מכל אומה ואומה מביאה כותי אחד ומביא ומשעבד והוא כגון ששיעבדה וכן כושי אחד ואחר כלאה יאמר להם בחדל הזה אתם נגאלים ההד החדש הזה לכם ראש חדשים דומה דודי לצבי או לעפר האילים הנה זה"@he ;
    oa:hasSelector opp:unit_fol_108v_1_u1_selector ;
    oa:hasSource opp:passage_fol_108v_1 .

