    rdf:value "המוצא עצמות בקבר הרי זה מלקט וכו תנן במכמורות דברי ד עקיביא וחכמים ומ לא יזזם ממקומן מצאן בכוך או באיצטוון לא יזיזם ממקומן אין מפנין לאאר המת ולא את העצמות ממקום בזו למקום בזוי ולא ממקום מכנבד למקום מכובד ואן צריך לומ ממקום מכובד למקום ב ובתוך שלו אפי ממקום מכובד למקום בזוי ימותר שכין הוא כבודו ירושרמי ערב הוא לאדם בשעה שווה נינוח אצל אבותיו אין קוברין שני מתים זה בצד זה ולא את המת בצד העצמות ולא עצמות בנד המת ר יהודה אומ תל הישן עמו בחייו נקבר עמו במותד קבר שפנהו מנתרב ונאה לא יעשכו בית יצבז בית הבקר בית בעציםי שית יריייצריי אנל כוך שינהו אסור בהצאה איימכד לשם מת לא"@he ;
    oa:hasSelector opp:unit_fol_8v_1_u1_selector ;
    oa:hasSource opp:passage_fol_8v_1 .

