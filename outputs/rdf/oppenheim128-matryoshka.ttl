opp:unit_fol_132v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_132v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אליך ייינפשי אשא כתוב אחד או אמ דוד לפני הקבה רבונו של עולם תשוק נפשיעל אלו שהן עתידא ליתן ולמסור את נפשם בלב טיוב ובאהבתך את נפשם על קדוש שמיך ואי זה זה זהדורו של שמד אמ לו הקבה דוד כלום הפסידו ואין חלקם בחיים חלקם בחיים שנ ורצפונך תמלא בטנם ירו ישבעו בנים והניחו יתרם לעולליהם אמ דוד לפני הקבה יהה לי חלק עמהם אמ לו הקבה וצפונב תמלא בטנם וצפים אין כתיב כאן אלא וצפינך תמלא בטנם דידך ודידהון אמ דוד לפני הקבה אלו באים מכחתודה ומעשים טובים אבל אני בצדק אחזה פניך אמ ר חייא בראבא אם יאמר לך אדם תן נפשך על קדוש השם אני נותנה ובלבד שיתיהו את ראשו כ מיד כדודו של שמד שהיו נותנים כדוריות של אש תחת שיחיהם וקרומיות שלקנה תחת צפרניהם"@he ;
    oa:hasSelector opp:unit_fol_132v_1_u1_selector ;
    oa:hasSource opp:passage_fol_132v_1 .

