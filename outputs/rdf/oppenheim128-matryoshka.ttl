opp:unit_fol_63r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_63r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לא ישלח אדם לחברו חבית שליין ויתן על פיה שמן שוו דרך המיתה ומעשה באדם אחוד שעשה משתה לבנו כיון שבאו בני חבורה והסבו נכנס להביא יין ראה את החבית שהיא מלאה שמן וחנק את עצמו מכאן אמרו חכמים אל ישלח אדם לחברו חביה שליין ויתן עלפיה שמן שזו דדך המיתה לא אמר אדל לחברו טול שמן מפך ריקן מפני שמהנהו טובת חנם ולא יסרב אדם לחב לסעוד ויודע בו שאינו סועד ולא ירבה לו בתקרובת ויודע בו שאינו מקבל לא ישקה אדם יין ישן לשום חדש שזו דרקך גזל היה משקה יין לחמיים אל יאמר להם סלקו את זה ותנו לזה שחה דרך הגזל היה"@he ;
    oa:hasSelector opp:unit_fol_63r_1_u1_selector ;
    oa:hasSource opp:passage_fol_63r_1 .

opp:unit_fol_63r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "106"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_63v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_63v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לא יפרו אדם פרוסה על גבי הקערה אבל מקנח אדם קערה בפרוסה ולא יניח אדם פירורין על גבי שולחן מפני שהוא ממחה דעתו שלחברו ולא ישוך אדם מפרוסה ויחזירנה לתיך הקערה וכן לא ישוך אדם מפרוסה ויתננה לחברו לפי שאין דעת הבריות שוות ולא ישתה מן הכוס ויתננו לחברו מפני סכנת נפשות ומעשה ברל עקיבא שהיה לו אכסניא אצל אדם אחד נתן לו כוס וטעמו אמ לו ר עקיבא טול ושתהו שוב נתן דו כוכד אחר וטעמו אמ לו ר עקיבא טול ושתהו אמ לו בן עזאי עקיבא עד מתי אתה משקה כוסות הטעומים שוב מעשה בר עקיבא שנתארח אצל אדם אחד נטל את הפרוסה וסמך בה את הקערה חטפה ר עקיבא ואכלה אמ לו ר אין לך פרוסות שתאכל ארא פרוסה שאני סומך בה את הקערה אמ כמדומה אנם שאתה נכוה בפושרין עכשו אי אתה נכוה אכי ברותחין ברותחין ולא ישתה אהם כוסו ויניחנו על גבי השלחן אלא"@he ;
    oa:hasSelector opp:unit_fol_63v_1_u1_selector ;
    oa:hasSource opp:passage_fol_63v_1 .

opp:unit_fol_63v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "149"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_64r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_64r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "חמשה דברים אמ ר אין מניחין בשר חי על גבי הפת ולא על הכוס ועל הקערה ואין זורקין את הפת ואין סומכין את הקערה בפת ואין יושבין על האוכלין מפני שמשביחין את האוכלין והנכנס לסעודה לא יטול חלקו ויתננו לשמש שמא יארע דבר קלקלה בסעודה אלא יטלנו ויניחנו לפניו ואחרכך יתנרו לו אורחין הנכנסין אצל בעל הבית אין יוצאין אלא אם כן נטלו רשות מבעל קבית ואין נותנין דבר לתינוק אלא אם כן נטלו רשות מבעל הבית ומעשה באדם אחד שהבניס אצלו שלשה אורחים בשני בצרות והיו לו שלשה ביצים והניחן לפניהם בא בנו של בעל הבית ועמד לפניהם נטל אחד"@he ;
    oa:hasSelector opp:unit_fol_64r_1_u1_selector ;
    oa:hasSource opp:passage_fol_64r_1 .

opp:unit_fol_64r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "101"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_64r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_64r_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אורחין הנכנסין אצל בעל הבית אין יוצאין אלא אם כן נטלו רשות מבעל קבית ואין נותנין דבר לתינוק אלא אם כן נטלו רשות מבעל הבית ומעשה באדם אחד שהבניס אצלו שלשה אורחים בשני בצרות והיו לו שלשה ביצים והניחן לפניהם בא בנו של בעל הבית ועמד לפניהם נטל אחד מהם חלקו ונתן לו וכן השני וכן השלישי וכיון שבא אביו ומצא שהיה אוכל אחת בפיו ושתים בידיו עמד וה גביהו מלא קומתו וחבטו לארץ ומת אף אמו כשראתה אתבנה שמת עמדה על הגג ונפלה ומתה אף אביו כיון שראה כן עמד על הגגנ ונפל ומת ואמ ר אלעזר בן יעקב של נפשות נהרגו על דבר זה"@he ;
    oa:hasSelector opp:unit_fol_64r_1_u2_selector ;
    oa:hasSource opp:passage_fol_64r_1 .

opp:unit_fol_64r_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "158"^^xsd:nonNegativeInteger ;
    oa:start "52"^^xsd:nonNegativeInteger .

opp:unit_fol_64r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_64r_2#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "וקוד שיכנס כיצד יעשה חולץ את מנעליו ומכלק את כובעו ומסלק את טליתו ומתיר את חגרו ופושט את חליקו ואחר כך מתיר אפרק סותו התחתונה רחץ ויצא וקביאו דו את המפה מקנח את ראשו ואחר כך מקנח את כל האיברים הביאו לו את השמן סך את הראש ואחר כך סך את כל האיברים ואחר כך מניח פרקסותו הת חתונה ולובש את חלוקו וחוגר את חגורו ומתכסה בטליתו ואחר כך מניח מלעליו מניח של ימין ואחר כך מניח של שמאל וכשהוא חולץ חולץ של שמאל תחלה ואחרכך של ימין וכן לענין תפליך מניח של יד תחלה ואחר כך שלראש וכשהוא חולץ חולץ שלראש תחלה ואחרכך שליד אם יש לו בן או עבד מניחן לו הנכנט למרחץ אינו מתעמל ואינו מתברר ואינו משתכר על השיש ומעשה ברבן גמליאל שהיה חלוש חלפו לו שמן על השיש ולא קבל רשבג או המשתכר על השיש חברו של חמור והאוכל בשוה חברו שלכלד ויש אומרים פסול לעדות בית הכסא נותן שלום זה שנכנם וזה שיוצא בית המרחץ נותן שלום זה שנכנס וזה שיוצא ולא יכניס אדם שמן לבית המרחץ בזכוכית מפני הסכנה ולא ירוק אדם לבית המרחץ מפני הסכנה ובכל מקום לא ירוק אדם בפני חברו"@he ;
    oa:hasSelector opp:unit_fol_64r_2_u1_selector ;
    oa:hasSource opp:passage_fol_64r_2 .

opp:unit_fol_64r_2_u1_selector a opp:TokenPositionSelector ;
