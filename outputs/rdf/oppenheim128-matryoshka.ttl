    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כי זה משה האיש ובלשון וה הוג בהו שנ זה יתנו כל העובר על הפקודים צדקה צדקה תרומם גוי וחסד לאמים חטאת ר אליעזר ור יהושע ורבנן ר אליעזר אומ צדקה תרומם גוי אלו ישראל וחסד לאומים חטאת חסדים הם החטא לאומות העולם שהם מתייהדים בהם ור יהושע או צדקה תרומם גוי אלו ישראל וחסד לאמים קטאת הנייה היא לאומות העולם בשעה שישראל חוטאין שהן חוזרין ומשעבדין בהן ורבן שמעון בן גמליאל אומ צדקה תרומם גוי אלו ישראל וחסד לאמים חטאת חסד של אומות העולם חטאת הוא להם שכן דניאל אומ לנבוכד נצר וחטאך בצדקה פרוק ועוייתך במחן עניין ר אלעזר בן ערך אומ צדקה תרומם גוי וחסד אלו ישראל אבל לאומות העולם חטאים"@he ;
    oa:hasSelector opp:unit_fol_87v_1_u2_selector ;
    oa:hasSource opp:passage_fol_87v_1 .

opp:unit_fol_96v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_96v_1#u1" ;
    opp:closestWitness opp:work_Bamidbar_Rabbah,
        opp:work_Midrash_Tanchuma,
        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר לוי בשם ר חמא בר חנינא אמ כל זמן שזרעו שר עמלק קיים בעולם לא יהיה השם שלם ולא הככא שלם אבד זרעו של עמלק מן העולם אז יהיה הכסא שלם והשם שלם מאי טעמיה האויב תמו הרבות נצח וערים נתשת אבד זכרם המה מה כת בתריה ויי לעולם ישב כונן למשפט כסאו מי יתן טהור מטמא לא אחד כגון אברהם מתרח חזקיהו מאחז יאשיהו מאמון ישראל מאומות העולם העולם הבא מהעולם הזה מי עשה כן מיצוה כן מי גזרכן לא יחידו של עולם תנינן בהרת כגרים טמא פרח בכלו טהור מי עשה עשה כן לא אחד לא יחידו של עולם תנינן האשה שמת ולדה בתוך מעיה והושיטה החיה את ידה ונגעה בו החיה טמאה טומאת שבעה והאשה טהורה עד שיצא הולד וכן המת בבית הבית טהור יצא מתוכו הרי הוא טמא מי עשה כן מי צוה כן מיגזרכן לא אחד לא יחידו שלעולם ותנינן תמן כל רעוסקין בפרה מתחלה ועד סוף טמאים בגדים והיא עצמה מטהרת טמאים אלא אמ הקבה חקה חקקתי וגזירה גזרת ואין אתה רשאי לעבור על גזרתי שנ זאת חקת התורה"@he ;
    oa:hasSelector opp:unit_fol_96v_1_u1_selector ;
    oa:hasSource opp:passage_fol_96v_1 .

opp:unit_fol_99v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_99v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בני מחול אלו ישראל בנים שמחלה להם שכינה על מעשה העגל ויד בר שלשת אלפים משל אמ ר שמואל בר נחמני חזרנו על כל המקרא ולא מצינו שנתנבא שלמה אלא קרוב לח מאות פסוקים ואת אמרת שלשת אלפים משל אלא מלמד שלמד על כל פסוק ופסנק שנתנבא שנים ושלשה טעמים ועל כל משד ומשל ויהי שירה של שלמה שין כת כאן אלא ויהי שירו חמשה ואלף שירו של משל אמשה ואלף וידבר על העצים וכי איפשר לאדם כשלמה לדבר על העצים אלא אמ שלמה מפני מה מצירע זה מטהר בגבוה שבגבוהים ובנמוך שבנמוכים בעץ ארז ואזוב ושני תולעת אלא על ידי שאדם מגביי עצמו כארז וכשהוא משפיל עצמו כאזוב הוא מתרפא באזוב וידבר על הבהמה ועל העוף וכי אפשר לאדם כשלמה לדבר על הבהמה ועל העוף אלא אמ שלמה הבהמה ניתרת בשני סימנין והעוף ניתר בסימא אחד אלא שהבהמה נבראת מן היבשה והעיף כת חחד אומ מן היבשה וכת אחר אומ מן הים מן היבשה שנ ויצר יי אלהים מן הצדמה כל הבהמה מן הים שנ ויאמר אלהים ישרצו המים שרץ נפש חיה ברקפא אמ מרקה שבים נבראו"@he ;
    oa:hasSelector opp:unit_fol_99v_1_u1_selector ;
    oa:hasSource opp:passage_fol_99v_1 .

opp:unit_fol_99r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_99r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ולזה נאה לקרותו סום ולזה חמור ולזה ארי ולזה נמד ולזה דוב ולזה נשר ההד ויקרא האדם שמות לכל הבהמה ולעוף השמים אמ לו ואתה מה שמך אמלו אדם אמ לו ולמה אמ לו שנבראתי מן האדמה אמ לו ואני מה שמי אמ לו אדני אמ לו ולמה אמ לו לפי שאתה לבדך אדון על כל בריותיך אמ ר אחא אמ הקבה אני יי הוא שמי הוא שמי שקרא לי אדם הראשון הוא שמי שהתניתי ביני לבין עצמי הוא שמי שהתניתי ביני לבין מלאכי השרת הוא שמי שהתניתי ביני לבין בריותי מאיתן זה אברהם אבינו שנ משכיל לאיתן האזרחי והימן זה משה שנ לא כן עבדי משה בכל ביתי נאמן הוא וכלכל זה יוסף שנ ויבלכל יוסף את אביו וכו אמרו המצריים כלום מלך זה העבד עלינו אלא בחכמתו מה עשו נטלו ע פתקים וכתבו עליהם שבעים לשון והשליכום לפני יוסף והיה קורא כל אחד ואחד בלשונו ולא עוד אלא שחיה מדבר בלשח שלא היו יכולים לשמיע אותו ההד עדות ביהוסף שמו בצאתי על ארץ מצרים שפת לא ידעתי אשמע אשמיע כת ודרדע זה דור המתר ולמה הנא קורא אותם דרדע שהיו כלם מלאים דיעה"@he ;
    oa:hasSelector opp:unit_fol_99r_1_u1_selector ;
    oa:hasSource opp:passage_fol_99r_1 .

