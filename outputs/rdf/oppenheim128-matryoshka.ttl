opp:unit_fol_152v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_152v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ואיך תנחמוני הבל ותשובותיכם נשאר מעל אמ ר אבאבר כהנא נםייידבריכם צריכים מרוק ורבנן אמרי ואיך תנחמוני הבל דדריכם סותרין זהאת זה לעתיד אמ הקבה לנביאים לנחם את דושלם ילך הושע לנחמה אומר רת הקבה שלחני לנחמך אומרת לו מה בידך אהיה כטל לישראל אומרת לו אתה אמרת הכה אפרים שרשם יבשפרי בל יעשון והיום אתה אומ לי אהיה כטל אי איזה מהם נקגבל ילך אל לנחמה אמלו מה בידך היה ביום ההוא יטפו ההרים עסיס אומ לו אמש אמרת הקיצו שכורים ובכו איזה מהם נאמין ילך עמוס לוחמה אומרנ לו מה בידך בים ההוא אקים את סכת דוד הנוכלת אומ לו אמשאמרת נפלה ולא תוסיף קום אי זה"@he ;
    oa:hasSelector opp:unit_fol_152v_1_u2_selector ;
    oa:hasSource opp:passage_fol_152v_1 .

opp:unit_fol_152v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "178"^^xsd:nonNegativeInteger ;
    oa:start "69"^^xsd:nonNegativeInteger .

opp:unit_fol_153r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_153r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מיכה לנחמה אומ לו מה בידך מי אלכמוך נושא עון ועובר על פשע אמ שאמרת בכשע יעקב איזו מהן לאמין ילך נחום לנחמה אומ לו מה בידך כי לאיוסיף לעבר בד עיד בליעל כלה נכרת אומ לו אמש אמרת ממך צאמושב על יי רעה יועץ בליעל איזה מהן נאמין ילך חבקוק לנחמה אומ לו מה בידך יצאת לישע עמך אומ ל אמש אמרת עד אנה יי שועתי ולא תשמע איזה נאמין הלך בפניה אומ לו מה בידך אמ לו"@he ;
    oa:hasSelector opp:unit_fol_153r_1_u1_selector ;
    oa:hasSource opp:passage_fol_153r_1 .

