opp:unit_fol_161r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_161r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הקבה רבונו של עולם לא אתה הוא שנישית כי הלא אתה הוא שכתבת לנו בתורה לא תתאתן בם לו נסבנו מנהון או אנסיבנון להון הדין מנהון הוה מחמי בריה או ברתיה קיים על תרעיה ולא הוה מקבלה יתיה הוי כי אתה עשית הבאת יום קראת ויהיו כמוני כמוני בצרה ולא כמוני ברוחה אין מנחם לי אמ הקבה אנכי אנכי הוא מנחמכם י רקםם אב על בנים רחם יי על יראיו כאיזה אב תני רחייא כרחמן שבאבות ואיזהו רחמן שבאבות ר עזריה אמ בשם ר אחא זה אברהם אבינו אתה מוצא קודם שלא הביא הקבה מבול על הכדומיים אמ אברהם אבינו לפני קבה רבונו של עולם נשבעת שאין אתה מביא מבול לעולם ומה תעשה מן השבועה שנאמ אשר נשבעתי מעבר מינח וכו אם מבול של אש אתה מביא מה אתה מערים על השבועה חלילה לך מעשות כדבר הזה להמית צדיק עם רשע אמ ר לוי השופט כל הארץ לא"@he ;
    oa:hasSelector opp:unit_fol_161r_1_u1_selector ;
    oa:hasSource opp:passage_fol_161r_1 .

opp:unit_fol_161r_1_u1_selector a opp:TokenPositionSelector ;
