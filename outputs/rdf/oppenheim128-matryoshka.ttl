opp:unit_fol_151r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_151r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "יי אל אברם במחזה לאמר ר נסריה בשם ר יהודה בר סימון כיתר קריה בישעיה אמ ישעיה מטינ מטיל הייתי בבית תלמידי ואשמע את קול יי אומר את מי אשלח ומי ילך לנו שלחתי את עמוס והיו קורין אותו פסילוכה אמ ר פנחס למה כמר נקרא שמו עמוס שהיה פסולוכ בל שונו אמרו ישראל הניח הקבה את כל עולמו ולא השרה שכינתו אלא על הדין פכולוסה על הדין קטיוע לישנא שלחתי את מיכה והיו מכים אותו על הלאי שנ בשבט יכו על הלחי את שופטישראל אלא מעתה את מיאשלח ומי ילך לנו מיד ואמר הנני שלחני אמ לו הקבה שעיה בנים סרבנים הם טרחנים הם מקבל את עלך ללקות ולהתבזות מהם אמ ליה על מנת כן שנ גוי נתתי למכים ולחיילמורטים אבל איניכדאי שאלך בשליחותך אנל בניך אמ לו הקבה ישעיה אהבת צדק ואהבת לצדק את בני ותשנארשע שנאת מלחייבן"@he ;
    oa:hasSelector opp:unit_fol_151r_2_u1_selector ;
    oa:hasSource opp:passage_fol_151r_2 .

opp:unit_fol_151r_2_u1_selector a opp:TokenPositionSelector ;
    oa:end "165"^^xsd:nonNegativeInteger ;
