opp:unit_fol_58r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_58r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "בשביל ארבעה דברים נכסי בעלי בתים יורדוא לטמיון על עושקי שכר שכיר ועל כובשי שכר שכל ועל פזרקי עול מעל צואריהם ונותנין על גבי חבינםי חביריהם ועל גסית הרוח כנגד כלן ר דוסתאי בר יהודה אומ לעולם היה מתגרה ברשעים ואל תהנא בעושי עולה שנ עוזבי תורה יהללו רשע ושומרי תורה יתגרו בם ואם לחשך אדם לומר אל תתחר במרעיה ואלתקנא בעושי עולה אלתתחר במרעים להיות במרעים ואל תקנא בעושי עולה להיות כעושי עולה אין ישיבה למעלה לא אכילה ולא שתיה ולא שינה ולא פריה ורביה ולא אידה ולא שנאה ולא תחרות ולא קנאה ולא עורף ולא רבוי ולא עפוי ולא עכבה"@he ;
    oa:hasSelector opp:unit_fol_58r_1_u1_selector ;
    oa:hasSource opp:passage_fol_58r_1 .

opp:unit_fol_58r_1_u1_selector a opp:TokenPositionSelector ;
