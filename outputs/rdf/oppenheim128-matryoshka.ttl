opp:unit_fol_47v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_47v_2#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "והיה אליהו זכור לטוב מהלך בדרך באותו היום שחרב בית המקדש ושמע בת קול צועקת ואומרת בית מק דשא קדישא לחורבא בני מלכא יהיבין בשביא אתתא דמרכא תינטר ארמלותא שנ איכה ישבה בדד העיר רבתי עם כיון ששמע אליהו זכור כטוב כיון דעתו להחריב את כל העולם הלך ומצא בני אזם שחורשין וזורעין אמ להם הקבה ק נק על"@he ;
    oa:hasSelector opp:unit_fol_47v_2_u1_selector ;
    oa:hasSource opp:passage_fol_47v_2 .

opp:unit_fol_47v_2_u1_selector a opp:TokenPositionSelector ;
