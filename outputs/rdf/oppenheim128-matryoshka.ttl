        opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "כיוצא בו כי אם במקום אשר יבחל יי אלהיך באחד שבטיך וכת אחד אומר כי אם אל המקום אשר יבחר יי אלהיכם מכל שבטיכם בא המכריעי ויתןדוד לארנן במקום שקלי זהב משקל שש מאות וכי דמיו שש מאות היו והא לא נקנה אלא בחמשים שקלים שנ ויקן דוד את הוגורן ואת הבקר בכסף שקלים חמשים ומה תלמוד לומר שש מאוה אלא שנתן חמשים מכל שגט ושבט נמצא דודנותן משלו חמשים בלבד בשביל שבט יהודה ונמצאו שני שני כתובים קיימין כאחד באחד שבטיך ומכל שבטינם יר נחמיה אומ דברי תורה עניים במקומין ועש ועשירים במקום אחר וצריכין להביא ראיה יבמקום אחר וכן הוא אמ היתה כאניות סוחר ממרסקתביא לחמה מדבות שהוא מיוהוד במקומו כיצד נתדור נדר ותאמר יי צבאות אם ראה תראה בעני אמתד גו למה נתיחד כאן השם הזה אמרה חנה לפני הקבה רבונו של עולם שני צבאות בראת ביילמלך העליונים והתחתוני העליונים לא פרים ולא כרבים ולא מתים התחתונים פרים ורבים ומתים אם מן התחתונים אב אהיה פרה ורבה ומתה או אהיה מן חעליוגים ואהיה בחיים ולא אמות"@he ;
    oa:hasSelector opp:unit_fol_5v_1_u1_selector ;
    oa:hasSource opp:passage_fol_5v_1 .

opp:unit_fol_6r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_6r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "כיוצאבו כי שנא שלח אמריי אלדי ישראל למה נתיחד השם הזה בכאן והלא בשלש נבואום הללו של חגי זכריה ומלאכי אין בהם כלשון הזה אלא כך היו מנחמין את ישראל ואומנרין להם אענ שנש שנשנאתם ונשלחתם אלהיכם הוא ושמו מתיחד עליל מדבר נה שאינו מתפרש במקומו ומתפרש במקום אחר כיצד ויטע יי אלהי ם גן בעדן מקדם וישם שם את האדם ונאמ ויצמח י אלהים מן האדמה כל עץ נחמד למראה גו שמענו שנתן הקבה אדם בגן עדן לאחר שברא בו כל עצי מאכל וכל מיני מגדים אבל לא שמענו שברא לו חופות שלזהב ושל אבנים טובות ומרגליות והיכן שמענו בשהואאומ לחירם מלך צור בגודק ג אלהים היית כל אבן יקרה מסוכתך אדם פטדה ויהלם גו כך אמ לו שמא אדם הראשון אתה שעשי לו את כל הכבנד הזה כיוצא בו משפחת בני קהת יחנו על ירך המשכן תימנה משפחות הגרשוני ונשיא בית אב לגרשוני גו והחונים לפני המשמ קדמה לפני אהל מועד גו שמענו כל זה אבל לא שמענו שצוה הקבה לא הרן שיעשה את בניו עשרה וארבע משמרות אבל להלן שמענו ממה שנאמר אלה פקודתם לעבודתם לכא לבית יי כמשפטם ביד אהרן אביהם כאשר צוהו יי אלהי ישראל מלמד שהיתה משצנה זו מסורה להם מימות משה ואהרן"@he ;
    oa:hasSelector opp:unit_fol_6r_1_u1_selector ;
    oa:hasSource opp:passage_fol_6r_1 .

opp:unit_fol_6v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_6v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "מדבד שנאמר במקצת ונוהג בלל אם כן ה מפני מה נאמר במקצת לפי שדבר הכת בהוה כיצד ובשר בשדה טרפה לא תאכלו ארן לי אלא בשדה בעיר מנן תלמוד לומר נבלה וטרפה לא תאבלו לטמאה בהיאם כן למה נאמר ובשר בשדה טרפה מפני שדבר הכת בהווה שדרכו להטרף בשדה ינתר מן העיר כיוצא בו כי יהיה בד איש אשר לא יהיה טהור מקרה לילה אין לי אלא מקרה לילה מקכה יום מנין תלמוד לומ ואיש כיתצוא ממנו שכבת זרע אם כן למה נאמר מקרה לילה אלא שדבר הכת בהוה שדרבו של קרי בלי לה יותר מהיום כיוצא בו אלתגל דל עדיין הוא חולה אלא"@he ;
    oa:hasSelector opp:unit_fol_6v_1_u1_selector ;
    oa:hasSource opp:passage_fol_6v_1 .

opp:unit_fol_70v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_70v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מרדע שהוא מורה דעה לפרה דרבן שהוא מדיר בינה בפרה אמ ק הבה לפרתו אדם ענשה דרבן וליצר הרע אינו עושה דרבן מדריכך בדרך תלך אמר לוי בשם רחמא בר חנינא אמ משל לבן מלכים שהיה לו דין אצל אביו אמ לו אביו בני אם אתה מבקש לזכות לפני בדין מנה לך גקיא לוגוס פנני ואת זוכה ליני בדין כך אמ הקבה לישמל בני אם מבקטים אתם לזכותלפני בדין תהיו מזכירים לפני זכו אבית ואתם זוכין לפני בדין אחד זה אבינו אברהם דנה ביה אחד היה אברהם וירשית הארץ זכרון נחתי תרועה זה אבינו יצחק וירא והנה איל אחר נאחז בסבד בקרניו מקרא קדש זהיעקב אבינו שמע אלי יעקב עבדי וישראל מקוראי אמ הקבה תהיו מזכירין לפני זכות אבות ואתם זכין לפני בדין ואימתי בחדש השביעי באחד לחדש ר חייא בר מריא פתח אך הבל בני אדם כזב בני איש במאונים לעלות המה מהבל יחד בנוהג שבעולם הבריות אומרות פלני ישאפרנית ופלנית ישא פלני במאזנים לעלות המה מהבל יחד אמ ר"@he ;
    oa:hasSelector opp:unit_fol_70v_1_u1_selector ;
    oa:hasSource opp:passage_fol_70v_1 .

opp:unit_fol_7r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_7r_1#u2" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "ויאמרו העצים לגפן וכי העצים מבקשין מלך אלא כנגד ישראל הוא אומר שאמרו לניתניאל בן קנז ולדבורה ולגדעון שינהגו שררה על ישראל ולא קבלו כיוצא בו החוח אשר בכבנון ששלח אל הארץ אשר בלבנון תנה את בתך לבני יוכי ימה ענין נשואין יש בחוח ובארזים אלא בנגד שכם בן יומור ויעקב אבינו נאמר המשל הז וכן אתה מוצא בנביאים ובכתובים שודברו משלים במה דברים אמורים בדברי קבנה אגל בדברדי תורה ומצות אי ארנה דודש בלישון משל מכנגד ליצד במכפר הימים אשר ערתם את הזרץ יום לשנה יום לשנה וכן הוא אומ ויאמר יי אליהוא יען אשר הטיבות לעשות הישר בעיני ככל אשר בלבבי עשית לבית אחאב בנים רבעים ישבו לך על כסא ישראל ולמה בנים רבעים כנגד ארבעה דורות שהיתה משפחת בית אחאב קיימת ונעקרה על יכו ואלו הן עמדי נאחאב ניורם ובניו ומנין שדורשין בלשון נופל על הלשון בהגדה שנ כה אמר יי אלהי ישראל הנני על הרועים הרועים את עמי גו ואם משא יי תאמרו גו לכן הנני ונשיתי אתכם"@he ;
    oa:hasSelector opp:unit_fol_7r_1_u2_selector ;
    oa:hasSource opp:passage_fol_7r_1 .

opp:unit_fol_81v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_81v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "עינים מראות ברע ומהו יוסיף אמץ שמעצים בחן של צדיקים לעשות רצונו דא ויאחז צדיק דדכו זה משה דכת ביה צדקת יי עשה וטהר ידים יוסיף אמץ דכת לא חמור אחד מהם נשאתי יוסיף אמש שהעצים כח המקום שנ ועתה יגדל נא כח י ר יניקב בר אחא בשם ר יוסי בר חנינא אמ ורבנן בשם ר יוחנן יתקף חייליהון דרחמך הגביר מדת רחמים על מדת הדא כדא ועתה צדל נא כח יי אמ ר משל לגבור שהוא מתנו מתנוסם באבן של מסית ועבר אחד וראה אותה ואמ לו ייפה כחך יפה כחך בנכורה כתוב ביום השמיני עצרת תהיה לכם ר יודה בר סימו פתר בשם ר מאיר קריה בנרה תן חלק ל שבעה וום לשמנה אלו שמנת ימי מילה אמ הקבה אם שמרת שבעת ימי נדה כראוי הריני נותן לך בן ואתה מוט לח ימים שנ וביום השמיני ימול בשר ערלתי ר טי אמ תן חלק לשבעה אלו שמנת ימי החג וגם לשמונה שנ וביום השמיני עצרת כי רוצה יי"@he ;
    oa:hasSelector opp:unit_fol_81v_1_u1_selector ;
    oa:hasSource opp:passage_fol_81v_1 .

opp:unit_fol_82v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_82v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר חנינא בריה דר אידי מוד יפופעמיך בנעלים בת נדיב בנעלים אי כת כאן אלא בנעלים בשתי נעירות נעילה בפסח ונעינה בחג אמ הקבה אתם נועלים בפני בפסח ואני נועל בפניכם בחג ואני משיב רוחות ומעלה עננים ימוריד גשמים ומפריח טללים ומגדל צמחים ומדשן פירות ואתם נועלין בפני בפסח ואתם יוצאים וקוצרים ומוצאים אותה מלאה ברכות לפיכך צרך הכת לומ ביום השמיני עצרת אמ ר יודן בשם ר יצחק כל זמן שישראל נעצרים בבתי בנסיות וב בתי מדרשות הקבה עוצר שכינתו עמהם מה טעמיה נעצרה נא אותך ונעשה לפניך גדי עזים אמ ר חגי בשם ר יצחק כל זמן שישראל מקוים להקבה ומתפללין בבתי כנסיות בבתי מדרשות הקבה מקוה את שכינתו עמהם מה טעמיה שנ קוה קויתייא ויט אני וישמע שועתי אמ ר אלכסגדרי משל למלך שבאת לושמחה כל זימי המשתה מטרונה מרמזת לבני כנטין ואומרת להם עד שהמלך בחוריא שלו שאלו צרככם וכיון שלא נתבוננו כבשה להם מטרונה עוד יום אחד"@he ;
    oa:hasSelector opp:unit_fol_82v_1_u1_selector ;
    oa:hasSource opp:passage_fol_82v_1 .

opp:unit_fol_83r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_83r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לפיכך צרף הכת לומ ביום השמיני עצרת וכו אמ ר אלכסנדראי משל למלך שבאת לו שמחה כל א ימי המשתה בנו של מלך טרוד עם האורחים וכיון שיצאו ז ימי המשתה אמ המלך לבנו בני יודע אני שכל זימי המשתה היית טרוד עם האורחים ועכשו אני ואתה נשמח יום אחד ואיני מטריח עליך הרבה אלא תרנגול אחד וליטרא אחת של בשר כך כל ז ימי החג ישראל עסוקים בקרביותיהם של אומות העולם אמ ר פנחם כל אותן ע פרים שהיא ישרל ינקריבין בחג כנגד ע אומות שלא יצוה העולם מהו דין ומה טעמיה תחת אהבתי ישטנוני ואני תפלה בטוחים אנו בתכלה וכיון שיצאו ז ימי החג אמ הקבה לישראל בני יודע אני שכל א ימי החג הייתם עסוקים בקרבנותיהם של אומית העולם ועכשו אני ואתם נשמח יום אחד ואיני מטריח עליכם הרבה אלא פר אחד איל אחד כבש אחד כיון ששמעו ישראל כן התחילו מקלסין להקבה ואומרים זה היום עשה יי נגילה ונשמחה בו"@he ;
    oa:hasSelector opp:unit_fol_83r_1_u1_selector ;
    oa:hasSource opp:passage_fol_83r_1 .

opp:unit_fol_86v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_86v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "נתן להן הריובשיהיו קיימת לעולם ר יודן בשם שמואל ברכאמן ור הוניא בשם בר קפיא אמ עד היכן סיו קימות עד בגלגל שורים זבחו והיכן הקריבום אמר אבא בר כהנא בנוב הקריבום ר אבהו איד בגבעון הקריבום ר חמא בר חנינא אמ בב ת עולמי הקיבום אמ ר לוי טעמיה דר חמא בר חנינא שנ ויזבח שלמה את זבח השלמים אשר זבח ליי דקר עשרים ושנים אלף יתני בשם ר מאיר עד עכשו הזקיימות ולא החמו ולא הזקייא ולא התרפו והלא דברים קו מה אם העגלות שניידקו במלא ים ביהל מיעד ניתנ להם הוייה שיהיו קיימות לעולם ין בה בה על אחת כמה וכמה שנ בהם ואתם צכם ויים כלכם היום רי שא את ראשכני א ז שועתי לו"@he ;
    oa:hasSelector opp:unit_fol_86v_1_u1_selector ;
    oa:hasSource opp:passage_fol_86v_1 .

opp:unit_fol_88v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_88v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בעת ההוא שלח מ עררך בלקןכן בלארן מלר כבל חברים ומנחה אלחזקיהו מה כת בספרים שרם ליחזקיהו שלם לאלוהו שרם לירושלם מיד חזר בו ואמ מה עשיתי שהקדמתי שלומו של יחזקיהו מיד עמד מככאו ופסעג פסיעות והחזיר את הכתבים וכתב כתבים אחרים תחתיהם מה כהב בהם שלום לאלוהו של יחזקיהו שלום ליחזקיהו שלום לירושלם אמ לו הקבה אתה עמדת מכסאך ופסעת שלש פסיעות לכבודי חיך שאני עתיד להעמיד ממך ג מלכים קיומו קלטורין שולטין מסוף העולם ועד סופו ואלו הן נבוכד נצר ואויל מרדך ובלשצר וכיון שמרדו וחרפו קעקע הקבה את ביצתן מן העולם והעמיד אחרים תחתה ודבנן אמרי צדקה תרומם גוי אלו ישראל נדבה שהביאו ישראל למלאלת המשכן ולאהל מועד נתנה להם תלוי ראש על ידי משה ההד כי תשא את ראש בני ישראל ר יודן פתח כסף נבחר לשון צדיק לב רשעים כמענו כסף נבחר לשון צדיק זה יעידו הנביא לברשעים כמעט זה ירבעם ההד והנה איש אלהים בא מיהודה וקרא על המזבח בדבר יי ולמה מזבח מזבח שני פעמים אמ ר אבא בר כהנא מזבח שבביתל ומזבח שבדן"@he ;
    oa:hasSelector opp:unit_fol_88v_2_u1_selector ;
    oa:hasSource opp:passage_fol_88v_2 .

