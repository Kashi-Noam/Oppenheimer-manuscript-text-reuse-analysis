opp:unit_fol_127v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_127v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר אבהו אזל לקסרין ואזדמן גביה חד גבר ואתא כלבא לגביה אמ ליה כל הדין בזיולא אנא שלים ליה אמ ליה מריטיבו רבא אנא שלים ליה חד זמן עלון שבאי לקרתא ואתא חד מנהון למשבי אתתא דההוא גברא וקם ואכל בציו ור יוחנן אמ ברצות יי דרכי איש גם אויביו ישלים אתו זו אשתו שנ אויבי איש אנשיביתו זו אשתו אמ ר יוחנן אשתו של לסטים כלסטיס מעשה באשה אחת שקבלה על בעלה לדיין עליה עלה ורב שמאל ברניחמן ורב שמיאל כר נחאמן וחייבו להתיז את ראשו לאחר זמן מצא נחמן אמ ברצות יי דרכי איש זה יצר טוב גם אויביו ישלים אתו"@he ;
    oa:hasSelector opp:unit_fol_127v_1_u1_selector ;
    oa:hasSource opp:passage_fol_127v_1 .

opp:unit_fol_127v_1_u1_selector a opp:TokenPositionSelector ;
