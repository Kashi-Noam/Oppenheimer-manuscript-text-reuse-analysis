opp:unit_fol_73r_2_u2 a opp:TextUnit ;
    rdfs:label "fol_73r_2#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה המקוה הזה פעמים פתור ופעמים נעול כך שערי תפלה פעמים פתוחים ופעמים נעולים מה המקוה הזה אדם מבקש לטבול בו ומצא אביו או רבו שם מתבייש והולך לו אבל הים מפליג קימעיא ויורד וטובל ר ברכיה ור חלבו בשם רב ענן בר יוסי אמ שערי תפלה לעולם פתוחין ואתיא כי האי דמרי ר יוסי בר חלפתא שאמ עתים הם לתפלה ובא דויד ופירש דכת ואני תפלתי לך יי עת רצון אלהים ברב חסדך ענני באמת ינ ישעך תאנה בשם ר אליעזר מקוה ישראל יי מושיעו בעת צרה מה המקוה הזה מטהר את הטמאים כך הקבה מטהר את ישראל לפיכך הושע מזהיר את ישראל ואומ להם שובה ישראל עד יי אלהיך ויי נתן קולו לפני חילו בראש השנה כי רבמאד מחנהו"@he ;
    oa:hasSelector opp:unit_fol_73r_2_u2_selector ;
    oa:hasSource opp:passage_fol_73r_2 .

opp:unit_fol_73r_2_u2_selector a opp:TokenPositionSelector ;
    oa:end "177"^^xsd:nonNegativeInteger ;
    oa:start "56"^^xsd:nonNegativeInteger .

opp:unit_fol_73v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_73v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כי עצום עושי דברו שהקבה מעצים כחן של צדיקים כדי שיעשו דברו כיגדול יום יי ונורא מאד זה יום הבפורים ומי יכילנו אמ ר כרום כריספדאי בשם ר יוחנן שלש פנקסות הן אחת של צדיקים גמרים ואחק של רשעים גמורים ואחת של בינטניים אלה לחיי עולם לו הצדיקים מורין ואנה לחרפות לדראון עולם זלו רשעים גמורין ימחו מספר לו הרשעים ועם חיים ל הצדיקים ועם צדיקים אל יכתבו לו הבינוניים שנתא להם הקבה עשרת ימי תשובה שבין ראם ראש השנה ויום הכפורים אם עשו תשובה נכתבין עם הצריקים ואם לאו נכתבין עם הרשעים לפיכך הושע מזהיר את ישראל ואומ להם שובה ישראל עד יי אלהיך רגזו ואל תחטאו אמרו בלבבכם על משכבכם ודמו אבינא אמ ארגיז יצרך ואל יחטיאך ורבנן אמרי אכעים סלה ר יויקב בר אבינא ורבנן ר יעקב בר יצרך ואל תביאך לידי חטא תאני בשםר אלעזר מקוה ישראל יי"@he ;
    oa:hasSelector opp:unit_fol_73v_1_u1_selector ;
    oa:hasSource opp:passage_fol_73v_1 .

opp:unit_fol_73v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "145"^^xsd:nonNegativeInteger ;
    oa:start "3"^^xsd:nonNegativeInteger .

opp:unit_fol_73v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_73v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לפיכך הושע מזהיר את ישראל ואומ להם שובה ישראל עד יי אלהיך רגזו ואל תחטאו אמרו בלבבכם על משכבכם ודמו אבינא אמ ארגיז יצרך ואל יחטיאך ורבנן אמרי אכעים סלה ר יויקב בר אבינא ורבנן ר יעקב בר יצרך ואל תביאך לידי חטא תאני בשםר אלעזר מקוה ישראל יי מושיעי בבית צרה אמ הקבה אם אמרתי לך שתהא מתפלל בבית הכנסת שבעירך ואם אין אתה יכול להתפלל התפלל בביתד ואם אין אתה כול התפלר רבה על מטתך"@he ;
    oa:hasSelector opp:unit_fol_73v_1_u2_selector ;
    oa:hasSource opp:passage_fol_73v_1 .

opp:unit_fol_73v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "173"^^xsd:nonNegativeInteger ;
    oa:start "96"^^xsd:nonNegativeInteger .

opp:unit_fol_74r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_74r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לפיכך הושע מזהר להם לישראל ואומ להם שובה ישראל עד יי להיך זבחי אלהים רוח נשברה לב נשבר ונדכה אלהים לא תבזה זבדי בן לוי ור יוסי בן פטראם ורבנן חד אמ אמ דוד לפני הקבה רבונו של עולם אם תקבלני בתשובה יודע אני ששלמה בני עתיד לבנות בית המקדש ובונה את המשבח ומקריב עליו הקרבנות מן הדין קרייה לב נשבר ונדכה אני יודע שתיטיב את ציון וה בנה חומות ירושלם וכת אז תחפץ זבחיצדק עולה וכליל אז יעלו על מזבחך פרים ורבכן אמרי מנין לזה שהוא עובר לפני התיבה שהוא צריך להזכיר בנין בית המקדש וקרבנות ומזבח מא הדא ברכתא רנה אנהם ושנון כניון ויענרוך בניך בירושלם אמ ר אבא בר יודן מה שפסל בבהמה הכשיר באדם פסל בצהמה עורצת או שבור או חרוץ או יבלת או גרב או ילפת הכשיר באדם לב נשבר ונדכה אלהים לא תבזה אמ ר אלכסנדראי הדיוט אם משתמש בכלי שבור גנאי הוא לו אבל הקבה אינו כן אלא כל שמושו כלים שבורים שנ קרוב יי לנשברי לב"@he ;
    oa:hasSelector opp:unit_fol_74r_1_u1_selector ;
    oa:hasSource opp:passage_fol_74r_1 .

opp:unit_fol_74r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "188"^^xsd:nonNegativeInteger ;
    oa:start "24"^^xsd:nonNegativeInteger .

opp:unit_fol_74v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_74v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הן אל ישגיב בכחו ומי כמהו מורה אמ ר ברכיה לשון יוני הוא ומהו ישגיב בכחו שהוא מעצים כחן של צדיקים שיעשו רצונו ומי כמהו מורה שהוא מורה לחטאים דרך שיעשו תשובה לפיכך הושע מזהיר את ישראל ואומ להם שובה ישראל עד יי אלהיך נווב וישר יי על כן יוכה חטאים בדרך שאלו לנבואה החוטא מה הוא עונשו אמרה להם הנפש החו החוטאת היא תמות שאלו לתורה החוטא מה הוא עונש אמרה להם יביא אשם ייתכפר לו שאלו להקבה החוטא מהו עונשו אמ להם עושה תשנבה ומתכפרר לו ההד טוב וישר יי על כן יורה חטאים בדרך אמ ר פנחס למה הוא טוב שהוא ישר ולמה הוא ישר שהוא טוב על כן יורה חטאים בדרך שהוא מורה לחטאים דרך שיעשו תשובה לפיכך הושע מזהיר לישראל ואומלהם שובה ישראל"@he ;
    oa:hasSelector opp:unit_fol_74v_1_u1_selector ;
    oa:hasSource opp:passage_fol_74v_1 .

