    rdfs:label "fol_65v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "כל מי שיש לו בית המדתש בעירו ואינו הולך לשם חייב מיתה ר מאיר אומ כל מי שיש לו תלמי חכם בצדו ואינו משמשו חייב מיתה שנ כי דבר יי בזה ואומ מה מצאו אבותיכם בי עול כי רחקו מעלי התירמנעליו ויצא לשוק הרי זה מגסי הרוח סוטרו לצדדין וקובעו לאחוריו ידכתו על חברתה ורצועות תפלין בידו ומחזיירן כשהוא מהלך בשוק הרי זה מגסי הרוח ומנין לגסות הרוח שהוא כעז שנ ולא תביא תיעבה אל ביתך ולהלן הוא אומ תועבת יי כל גבה לב כתוב הכא תועבה ונאמר להלן תועבה מה להלן עז אף כאן עז הנבינם לישן אומ ברוך המפיל חבלי אינה על אדם והניעור משנת נ אומ אלהי נשמה שנתת בי טהורה המתהפיך משנתו על הצדדים אומ ברוך פוקח עורים"@he ;
    oa:hasSelector opp:unit_fol_65v_1_u1_selector ;
    oa:hasSource opp:passage_fol_65v_1 .

opp:unit_fol_65v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "174"^^xsd:nonNegativeInteger ;
    oa:start "52"^^xsd:nonNegativeInteger .

opp:unit_fol_66r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_66r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "הנכנס לבית הכסא אומ התכבדו מכובדים קדושים משרתי עליון תנו כבוד לאםל הינו ועמדו במקומבם והזהרו עזרוני ושמרוני המתינו לי עד שאבנס ואצא שזה דדכן של בני אדם והיוצא מבית הכסא אומ ברוך אשר יצר את האדם בחכמה רחץ פניו אומ ברוך המעביר שינה מעיני ותנומה מעפעפי לבש כליו ויצא לשוק אומ יהי רצון מלפניך יי אלהי שתוליכני לשלום ותסמכני לשלום ותנני לחן לחסד ולרא ולרחמים בעיניך ובעיני כל רואי ותגמלני חסדים טוגבים ותחזירני לביתי בשלום ותצילני מכף אויב ואורב בדרך והצילני מלשחהרנב ואלתרגלני לרבר עבירה וחטא ועול ואל אכשל בדבר הלכה ולא בשום דבר בעולם ותצילנר מכל מיני מזיקים מכל מיני פורעניות המתרגשות לבא בעולם שלא יזיקו בי בין ביום בין במלילה אמן יהי רצון מלפניך יי להי שתראלי בשמחתה של ירושלם ונחמותיה אמן חסלת מדת דרך ארץ תל דרך ארץ זוטא בעה דרכן של הלמידי חכמים ענו ושכל רוח אריה וממולא עלוב ואהוב לכל אדם שפל לא נשיביתו ירא חטא ודורש את האדם לפי מעשיו ואומ כל מה שיש בעולם הזה אין לו חפץ בהם יושה ומשנה ומטנף כסותו לפני רגלי תלמידי חכמים ואין"@he ;
    oa:hasSelector opp:unit_fol_66r_1_u1_selector ;
    oa:hasSource opp:passage_fol_66r_1 .

opp:unit_fol_66r_1_u1_selector a opp:TokenPositionSelector ;
