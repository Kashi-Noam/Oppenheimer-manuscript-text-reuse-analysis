opp:unit_fol_160v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_160v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "העת שנלך עליהם ונכלה אותם ורבנן פתרין קרא באומות העולם אתה מוצאכיון שגרמו העונות ונכנסו גוים כירושלם גזרו שבכל מקום שישראל בורחים שיהיו מסגירים אותם בקשו לברוח לדרום ולא הניחו להם שנ כה אמר יי על שלשה פשעי דמשק ועל ארבעה לא אשיבנו בקשו לברוח למערב ולא הניחו להם"@he ;
    oa:hasSelector opp:unit_fol_160v_1_u1_selector ;
    oa:hasSource opp:passage_fol_160v_1 .

opp:unit_fol_160v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "53"^^xsd:nonNegativeInteger ;
    oa:start "4"^^xsd:nonNegativeInteger .

