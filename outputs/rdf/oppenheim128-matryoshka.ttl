opp:unit_fol_162v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_162v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "על אחת כמה וכמה הוא שהנביא מקטרן ואומר להם ותשכח יי עושך נוטה שמים ויוסד ארץ נתפחד תמיד כל היום מפני חמת המציק בא כאשר כונן כהשחית הנשיתון מה דאמרית לכון אם ימדו שמל מלמעלה ויחקרו מוסדי ארץ למטה בם אני אמאס בכל זרע ישראל על כל אשר עשו ראיתם שמים שנתמוניטו והארץ שנתמוטטה לאהיה לכם ללמו מהם אלא ותפחד תמיד כל היום מפני חמת המציק אמ ר יצחק שהיו הצרות מציקות זו אחר זו ואיה חמת המציק אלו המן ואחשורוש כאשר כונן להשחית שנאמ בחדש העשירי הוא חדש טבת יו מה צועה להפתח ולא ימות לשחת ולא יחסר לחמו אמ ר אבהו זו אחד מעשרהה דבדים שאמרו חכמים שהם סימן טוב לחולה עטווש זיעה שינה קרי חכום הלוך מעים בדרך ארץ וכו עטיוש מלין דכת עטישותיו תהל אור זיעה שנ בזעת אפך תאכל לחם"@he ;
    oa:hasSelector opp:unit_fol_162v_1_u1_selector ;
    oa:hasSource opp:passage_fol_162v_1 .

