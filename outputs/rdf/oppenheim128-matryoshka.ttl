opp:unit_fol_184v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_184v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "אחר שחיי לו דבנים אמי לאשתי ישלך כלום לאכול כביה אמיה לו ישמלא כףקמח אמ לה בשלי אותו ונאכלנו קודם שנמות בשלתו בקדירה נית זה טפה מן הקדרה בא בנו הגדול לגרפה דחפו אביו אמ לא תגזולאת אחיך לאכול עד שבאו כשדים והוליכום ושבו אותם והרגום הלך אביהם ומצא כל אחד ואחד מהם במקומו מה עשה נטל אצבעו של בנו הגדול והניחה בעינו אמ אצבע שלא הנחתי לגרוף אותה ר טפה תנקראת עינו ועוד מעשה באשה אחת שהיולהג בנים הלכו שני בניה למלחמה ונטלה את בכה שהיא מניקה ובשלתו בקדרה כשהן אוכלין הכירו את ידי אחיהן כיון שראו כך עלו לגג והפילו עצמן לארץ ומתו עליהם מקונן ירמיה טובים היו חללי חרב מחללי רעב ואף ירושלם צועקת וארמרת אללי לי כי הייתי כאספיקיץ הקוצר מכיח ספיחים והבוצר מניח עוכלות אבל אני רא נשתיר כי כלום ונמסרתי ביד נבוכד לצר"@he ;
    oa:hasSelector opp:unit_fol_184v_1_u1_selector ;
    oa:hasSource opp:passage_fol_184v_1 .

