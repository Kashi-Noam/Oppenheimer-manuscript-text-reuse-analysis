opp:unit_fol_4v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_4v_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "ללמד על מתזתורה ונמצא למבממנו כיוצא בו אתה אומ קולה כנמש ילך כשם שמהלך הולו שלנחש מהלך קולה שלמצרים מלמד שכשאמ הקבה לנחש על גחולך תלך ידדג מלאכים בקצצו ידיו ורגליו והיה קולו הולך מסלף העולם ועד סופו בא נחש ללמד על מפלתה שלמצרים ונמצא למד ממנה מכלל שאחריו מעשה והוא פרטו של ראשון כיצב ויברא אלהים אתהאדם בצלמו הרי זהכלל ואחר כך פירט את המעשה ויצר יי אלהים ויפל יי אלהים תרדמה גו ויבן יי אלהים גו והשומע סבור שהוא מעשה אחר ואינו אלא פרטו שלראשון"@he ;
    oa:hasSelector opp:unit_fol_4v_1_u2_selector ;
    oa:hasSource opp:passage_fol_4v_1 .

opp:unit_fol_4v_1_u2_selector a opp:TokenPositionSelector ;
