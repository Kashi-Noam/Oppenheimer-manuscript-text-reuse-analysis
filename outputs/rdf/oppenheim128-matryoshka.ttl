opp:unit_fol_173r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_173r_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "תנו רבנן יפעם אחת בזרה מלכות קרשעה שמד על ישראל בימי רבן שמעון בן יוחאי שלא לקיים את המילה ושלא לקיים את השבת ושלא לקיים את הנדה והיה שם זקן אחד ושמו ראובן בר אצטרובילי וקיה גבנס וייצא לפני המכך בלא רשות יום אחד נכנם לפניהמלך ומצאו יושב אמ לו אדני המלך מישישכו אויבים מהו רוצה שיהיו גבורים או חלשים אמ לו חלשים אמ לו יהודים הללו אינם חלישים מכם אלא לפישהם מקיימין את המיבה הם חלשים שכיון שנוכד בן לאחדמהם הם מתקבצים וחותכים את בשרו לח ימים ועל זה תששכחו ושוב איןבוכח ואם מבטל אתה מילה מהם הם מתגברים ואתם משליח אכלוסין עליהם והם מורדין בך אמ לו יפה אמרת תבטל גזירה זו ועוד מהו רוצה מי שישלו שונאים שיהיו ענייה או עשירים אמ לו עניים"@he ;
    oa:hasSelector opp:unit_fol_173r_1_u1_selector ;
    oa:hasSource opp:passage_fol_173r_1 .

