opp:unit_fol_62v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_62v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אדם כוסו בבת אחת ואם שתה הרי זה גרגרן ורעבתן וכמה ישהא וישתה שנים מדרך ארץ שלשלה מגסי הרוח ולא יאכל אדם שום ובצל מראשו אלא מעליו ואם אכל הרי זה רעבתן וגרגרן ולא ישתה שתיכוסות ויברך ברנת המזון מפני שנראה כגרגרן סליק פרקא שנים שהיו יושבין על שלחן אחד הגדול שבהן שולח יד תחלה ואחרכך הקטן ואם שרח הרי זה גרגרן ומעשה בר עקיבא שעשה סעודה לתלמידיו הביא לפניהם שני תבשילין אחד נא ואחד מבושל בתחלה הביא לפניהם נא הפקח שבהם אחז את הקלח בידו אחת ולש ותלשו בידו אחת לא בא אחריו משך ידו ממנו ואכל פתי ריקן הטפש שבהם אחח את הקלח בידו אחת ונשכו בשניו אמ לו ר עקיבא לאכך כנל אלא הנח עקבך עליו בתוך הקערה ואחר כך תביי לפניהם מרושל אכלו ושתו ונסתפקו אחרכך אמ להם בני לא עשיתי לכם כל כך אלא לבדוהק אתכם אם יש בידכם דרך ארץ אם לאו לא יאכל אדם"@he ;
    oa:hasSelector opp:unit_fol_62v_1_u1_selector ;
    oa:hasSource opp:passage_fol_62v_1 .

opp:unit_fol_62v_1_u1_selector a opp:TokenPositionSelector ;
