opp:unit_fol_93r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_93r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר שמואל בר נחמני אמ בשם ר יונתן לשון יוני הוא אלון אידי אלון ברות עד שיעקב משמר אבלה של מניקתו של אמו באת לו בשורת אמי שמתה ההד וירא אלהים אל יעקב עד בבאו מפדן ארם ויברך אותו ומה היא הברכה שבירכו ר אחא בשם ר יונתן אמ ברכת אבלים בירכו אמ הקבה אבוי שלים ליה ביש סאביה שלים ליה ביש אתו אמיה שלים ליה ביש אביה שלים לה ביש אחוי שלים ליה ביש סאביה שלים ליה ביש אתון שלמו ליה ביש ואנא אשלים ליה בישותיה תהיו אתם מזכירין שמו מלמטה ואני מוחק את שמו מלמעלה שנ יהיו נגד ייי תמיד ויכרת מארץ זכרם ההד זרור את אשר עשה לך עמלק"@he ;
    oa:hasSelector opp:unit_fol_93r_1_u1_selector ;
    oa:hasSource opp:passage_fol_93r_1 .

