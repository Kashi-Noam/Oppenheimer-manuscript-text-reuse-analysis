        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דא במלך שלמה במלך שהיא שעושה שלום לבריותיו אמ ר יוחנן כת המשר ופחד עמו עושה שלום במרומיו אמ ר יעקב דכפר חנן המשל זה מיכאל ופחד זה גבריאל עמי י מושלמים לו פא זה מזיק את זה ולא זה מזיק אתזה אמ ר יוחנן מימיה לא ראתה חמה פגימתה של לבנה ולית מזל קדים לחבריה ולית מזלחזי מאי דקמוי אמ ר לוי כלהון סלקיכהדין דסליק בסולמא הפיך כת המקרה במים עליותיי תאני ר שמעין בן יוחאי הרקיע של מים והכוכבים שלאש והם דרים זה לום זה ואינן מזיקין זה את זה אמ ר אבין לאסוף דבר אין בין מלאך למלאך אלא אפי במלאך עצמו הוא עשה שלים בו ואית בו חמש אפין ההד וגויתו כתרשיש כתוב ויהי ברד ואש מתלקחת ר יהודה ור נחמיה ד יהודה של צרלוחיתשלביד מלאותאש"@he ;
    oa:hasSelector opp:unit_fol_85r_1_u1_selector ;
    oa:hasSource opp:passage_fol_85r_1 .

opp:unit_fol_88r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_88r_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Midrash_Tanchuma ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "צדקה תרומם גוי לו ישראל וחסד לאמים חטאת מקבלין הן ישראל חסידים מאומות העולם שכן רב שקה הוא אומ ליחזקיהו ועתה המלבעדי יי עליתי וכן נבוזר אדן אומ לירמיהו ויבא ויעש יי כאשר דבר והיה לכם הדבר הזה דבר כתו ר נחוניא בן הקנה או צדקה תכומם גוי אלוישראל וחסד לאומים חטאת חסד שאומות העולם עושים חטאת הוא לישראל ממי אתה למד ממישעמלך מואב שהיה נוקד שנ ומישע מלך מואב היה נוקד מהו נוקדרועה והשיב למלך ישראל מאה אלף כרים ומאה אלם אילים במר מהו אלים צמר ר אבא בר כהנא אמ פרי בטיא מה עשה כינח כל אצטרוגולין ואמ להון לית אתון אמרין דאנא עביד קרבא עם כל אומייא ונצח להון ועם אלין יהודאי לית אנא יכיל למנצח אלא אינון נצחיז לי אמרין ליה בזכות חד סב דהוה להון אמ להון ומהודין סבא אמרין ליה אברהם אמ לתין ומה הוה עסקיה אמרין נה מד גר יח דאי אפב ניה ומאה שנן והרביה אמ להו וחרביה אמחניה נא אמ ואי רנא קרגיה מתוגברין ליה נסן לו קרביה על אחת נמה וכמה"@he ;
    oa:hasSelector opp:unit_fol_88r_1_u2_selector ;
    oa:hasSource opp:passage_fol_88r_1 .

opp:unit_fol_89v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_89v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כי תשא כת אמ משה לפני הקבה רבון העול בשעה שיש לישראל זכות הנחלהם ובשעה שאין להם זכות שא להם פעם אחת בשנה כדי שיבא יום הכפורים ויכפר להם שנ כי ביום הזה יכ פר עליכם לטהר אתכם ב תשא את ראש בני ישראל אמ ר יוסיבר חנינא רמזו שהוא עתיד להקריב ראשון של שבטיים ואי זה זה ראובן שנ יחיראובן ואל ימית אמ ר יודן בשם ר שמואל בר נחמני משל למלך שהיה לו אפקריםין והיה מציה את עבדו נערה ויקפנה ותן דעתך עליה אמ לו אדני המלך מכל אפקריסין שיש לך אין אתה מצוני אלא על זו אמ לו מפני שהן דבקין בבש כך אמ משה לפני הקבה רבונו של עולם מע אומות אומית איתיטיות שישלך בעולמך אין אתה מצוני אלא על ישראל שנ ואל בני ישראל תאמר אמור אל בני ישת צו את בני ישראל ואתה תצוה את בני ישראל אמ לו מפני שהן דבקים בי שנ כי כאשר ידבק האזור אל מתני איש כו הדברתי אלי את כל בית ישראל ואת כל בית יהודה נאם יי להיות לי לעם לתהלה לשם ולתפארת"@he ;
    oa:hasSelector opp:unit_fol_89v_1_u1_selector ;
    oa:hasSource opp:passage_fol_89v_1 .

opp:unit_fol_91v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_91v_1#u2" ;
    opp:closestWitness opp:work_Midrash_Tanchuma,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר יהושע בר נחמיה בשם רבן יוחנן בן זכאי לפי שעברו על עשרת הדברות לפיכך יהא כל אחד ואחד מהם מביא עשרים גרה ר ברכיה ור לוי אמ בשם ר שמעון בן לקיש לפי שמכרו בכורה שלרחל בעשרים כסף לפילך יהא כל אחד ואחד פודה בנו בכור בעשרים כסף ר פנחס בשם ר ליי אמ לפי שמכרו בכורה של רחל בעשרים כסף ונפל לכל אחד מהם טבע לפיכך יהא כל אחד מהם מביא שקלו טבע אמ ר יה ודה בר סימון בשם ר יוחנן גדברים שמע משה מפי הגבורה ונרתע ונבהל לחחוריו א בשעה שאמ לו ועשו לי מקדש אמי משה לפני הבה דבונו של עולם כת הנה השמים ושמי השמים לא יכלכלוך אף כי הבית הזה אשר בניתי ואתה אומ ועשו לי מקדש אמ לו הקבה משה לא כשם שאתה סבור אלא כ קרש בצפוין וכ בדרום ושמנה במערב ואני יורד ומצמצם שכינתי ביניהם דכת ונועדתי לך שם ובשעה שאמ את קרבני לחמי לאשי אמ משה לפני הקבה רבונו של עונם עילם אם מכנים אני כל החיות שבעולם אין בהן כדי העלאה אחת אוכל העצים שבעולם אין בהן כדי הבעה אחת שנ ולבנון איהי בער וחיתו אין די עולה"@he ;
    oa:hasSelector opp:unit_fol_91v_1_u2_selector ;
    oa:hasSource opp:passage_fol_91v_1 .

opp:unit_fol_92r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_92r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לו הקבה משה לא כשם שאתה סבוד אלא ואמרת להם זה האשה אשר תקריבו ליי כבשים בני שנה שנים ליום ולא שניהם בבת אחת אלא אחד בשחרית ואחד בין הערבים שנ את הכבש אחד תעשה בבקר ואת הכבש השני תעשה בין הערבים ובשעה שאמ לו ונתנו איש כופר נפשו אמ משה לפני ההבה רבון העולמים מי יוכל ליתן פדיון נפשו שנ אח לא פדה יפדה איש ולא יתן לאלקים כפרו וייקר פדיון נפשם וחדל לעולם אמ לו הקבה למשה משה לא כשם שאתה סבור אלא זה יתנו כזה יתנו רב הונא בשם רב אמ שדי לא מצאנוהו שגיא כח לא מצינו כח גבורתו של הקבה ואינו בא בטרחות עם ישראל כיון ששמע משה כך התחיל משה משבח בישראל ואומ להם אשרי העם שככה לו אשרי שאל יעקב בעסרו זובר עין אבתיו אל ייי וחטאת אמו אל תמח וכי אבופיו של עשו הרשע רשעים היו והלא צדיקים גמורים היו אברהם זקנו יצחק אביו ואתה אומ יזכר עון אבותיו אל יי אלא חטא שחטא על אבותיו ומה חטא חטא על אבותיו אתה מוצא חי בשנותיו של אברהם יצחק חיה קפי שנה ואברהם קעב אמ ר יודן בשם ר"@he ;
    oa:hasSelector opp:unit_fol_92r_1_u1_selector ;
    oa:hasSource opp:passage_fol_92r_1 .

opp:unit_fol_92v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_92v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "אמ ר ברכי שלא תאמר אחר שיצא ממעי אמו אלא עד שהוא במעי אמו זרתא פי מתיחא לקבליה ומאי טעמא זורו רשעים מרחם ור נחמיה אמ גרם לה שלא תעמיד יב שבטים מז הדין קרא שנ ויאמר יי לה שני גוים בבטנך האתרי ושני לאומים ממניך הא ארבעה ולאם מלאם אמץ הא שתא שיתא ורב יעבד צעיר הא תמניא וימלאו ימיה ללדת והנה תומים הרי עשרה ויצא הראשון אדמוני ואחדריכן יצא אחיו הא תרי עשר ואית דמיתי לה מן הדין קא ותאמר אם כן למה זה אנכי הדין זה ז שבעה ה חמשה הא תרין עשר ורבנן אמ גרם לה שלא תצא מטתה ברבים אתה מיצח בשעה שמתה רבקה אמרו מחן יפיק קומה אברהם כבר מת יצחק עיניו כהות יעקב ברח מפני עשו אם יפוק עשו רשיעא קומה יהוון אמרין ברייתא לייטין ביזייא דהא כדין אינקון מה עשו הוציאו אותה בלילה אמ ר יוסי בר חנינא לפי שלא יצחה מטתה ברבים אף הכת לא פרסם את מטתה אלא מן הצד ההד ותמת דבורה מינקת רבקה מהו אלון בכות"@he ;
    oa:hasSelector opp:unit_fol_92v_2_u1_selector ;
    oa:hasSource opp:passage_fol_92v_2 .

opp:unit_fol_95v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_95v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "זה כת בו נער וזה כת יצו יקטן זריכת בו נער שנ והוא נער את בני בנהה וזה כת בוקנן שנ הנה קנון קטן נתתיך בגוים בזוי אתה מחד זה גדל בין שניב ולא עשה כמעשיהם וזה גדל בין שני רשעים ול עשה כמעשיהם יבא זה ויפול ביד זה זה חס עלל כבוד קונו וזה בזה כבוד קונו יבא זה ויפל על זה כ זה כת בו ולא ירא אלהים וזה כת בו את האלהים אני ירא יבא זה ויפול ביד זה והיה בהניח יי אלהיך לך מכל אויביך מסביב אמ ר עז ור יודן בר סימון בשם ר יהודה בר אלעאי עלג דברים נשצטוו ישראל בכניסתן לארץ למנות עליהם מלך ולבנות להם בית הבחירה שנ ועשו לי מקדש ונמחו את זכר עמלק שנ תמחה את זכר עמלק מתחת השמים ר יהושע בן לוי בשם ר"@he ;
    oa:hasSelector opp:unit_fol_95v_1_u1_selector ;
    oa:hasSource opp:passage_fol_95v_1 .

