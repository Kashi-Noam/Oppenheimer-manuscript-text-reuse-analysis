    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ויגל את מסך יהודה מלאתי משפט כגון משנתו של ר חייא ומשנתו של ר הושפיא ומשנתו של ברמפראו צדק ילין בה אמ ר יהודה בר סימון מימיו לא לן אדם בירושכם ובידו עון האכאי זה צד תמיד של שחר היה מכפר על עבירות שנעשו ביום מכל מקום לא לן אדם בירושלם ובידו עח מאי טעמיה צדק ילין בה ועתה מרצחים הא עבידין קטולין הרגו את אוריה ואת זכריה ר יודן"@he ;
    oa:hasSelector opp:unit_fol_148r_1_u1_selector ;
    oa:hasSource opp:passage_fol_148r_1 .

