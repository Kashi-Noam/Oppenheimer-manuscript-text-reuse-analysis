opp:unit_fol_12v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_12v_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "שהוא אותב שלום ורודף שלום ומקדים שלום ומשיב שלום ומטיל שלום בין ישראל לאביהם שבשמים עד אחת כמה וכמה ר יוסי הגלילי אומ אף שמו של משיח נקרא שלום שנ אבי עד שרשלום אי ר יהושע גדול הוא השלים שישראל נקרא שלום שנאמ כי זרע השלום למי השלום לזרע השרום ר יוסי הגלילי אומ גדול הוא השטם שבשעה שמלך המשיח המשיח נלה לישראל אק כיתא ילא גשלם שנאמר מה נאוו על ההרים רגלי מבשר משמיע שלום ר יוסי הגלילי אומ גדול הוא השלום שבשעת מלחמה אין פותח אלא בשלום שנ כי תקרב אל עיר להלחם עליה וקראת אליה לשלום אמ ר יהושע גדול הוא השלום שעתיד הקבה לסמוך צדיקים בשלום שנ יצר סמוך תטר שלום אמ ר יהושע גבול הוא השלום שהיא תלויה לחיים ותלויה למתים לחיים מנין ויאמר יתרו למשה לך לשלום"@he ;
    oa:hasSelector opp:unit_fol_12v_1_u2_selector ;
    oa:hasSource opp:passage_fol_12v_1 .

