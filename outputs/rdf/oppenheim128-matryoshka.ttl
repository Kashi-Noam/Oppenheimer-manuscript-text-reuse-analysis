opp:unit_fol_133v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_133v_1#u2" ;
    opp:closestWitness opp:work_Kohelet_Rabbah ;
    opp:earliestWitness opp:work_Kohelet_Rabbah ;
    rdf:value "אמרו צריכים אנו למדכיא והוה נסיב תרמיסן ומקבץ ומסלק בשוקא כל הן דהוה תמן חד מית הויא טיף וסליק ליה חמתיה אדכותי אמ ליה אלא אזל מדחיך בהדין סבא דיהודאי מה עבד נסבהד מיתא דאזיל וטמריה בחד מן אלין שוקיא דדכי ואמ ליה נקתא שוק כלן אמ ליה אין אפקית הלין מיתא אמ ליה גוד חמי לי צפה ר שמעון בן יוחאי ברוח הקדש וישב שם ואמר גוזר אני על העליונים שירדו על התחתונים שיעלו וכן הות ליה מיד נפיק עבר קומי כנשתא דמגדלא שמת קלהון דמינוקאי ספרא דמגדלא אמ הא בר יוחאי דדכי בטבריא אמ ליה ולא"@he ;
    oa:hasSelector opp:unit_fol_133v_1_u2_selector ;
    oa:hasSource opp:passage_fol_133v_1 .

opp:unit_fol_133v_1_u2_selector a opp:TokenPositionSelector ;
