opp:unit_fol_8r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_8r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Semachot ;
    opp:earliestWitness opp:work_Tractate_Semachot ;
    rdf:value "המלקט עצמות והמשמר עצמות והמולך עצמות ממקום למקום פטור מקרית שמע ומן התפלה ומן התפלח ומכל מצות האמורות בתורה ואם כצה להחמיר על יעצמו לא יחמיר מפני כבוד עצמות ר יוחנן בןנורי אומ ירחיק ארבע אמות ויקרא שמעוזן בן עזאי אומ אם היו כגמו בספיכה משלקן לצד אחד וקורא ר יצחק אומ של קרובים פטור ושלאחרים חייב ר שמעון אומ בשבת חייב ובחול פטור ר נתן אומ אם יש עמהן אכילה חבילה פטור מפני שזיקת שמירנז עליו ולש זיקת חבילה רהמוליך עצמות יונ תבי הקדש ממקום ל למקור לא יהנם בקרון ולא בספינה ולא יתנם על גבי בהמר בהה ואם בשביל הנאת עצמו או בש הזרם הדי זה מותר לא וחת החרם הרי זר שופך מי ינוכך דמים בלבד ונא כאלו עובד עז ומולה עדיות ומחלל שבתות היה עובר בבית הקברות לא יתן תפלין עליו ולא כתבי הקדש בידיו ולא יקרא ולא יתפלל מפל שהוא דרך בזיון העושה כו בקבר והגיע זמן המקרא פזרש למקום טהרה וקודא ומתפלל ואחר כך נכפס המוצא מת בקבר לא יזיזנו ממקומו אלא אם כן יודע שהיה"@he ;
    oa:hasSelector opp:unit_fol_8r_1_u1_selector ;
    oa:hasSource opp:passage_fol_8r_1 .

opp:unit_fol_8r_1_u1_selector a opp:TokenPositionSelector ;
