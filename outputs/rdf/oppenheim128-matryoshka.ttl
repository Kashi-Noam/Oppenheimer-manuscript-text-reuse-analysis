    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "אותו היום ישב ר שמעון ודרש בבית המדרש הגדול שלו לעולם הוירך כקנה ואל תהי קשה בארז מה קנה יצאו ארבע רוחות העלם קנה הולך ובא עמהם עמדו הרוחות קנה במקומו עומד מה סופו שלקנה זה זנה ליטול ממנו קולמוס לכתוב בו ספר תורה אבל ארא חה אינו כן ינתה רוח צפינית עוקרתי והופכתו עלל פניו נמצא ארח זה שהיה עימד על שישיו מה הוא סופד באין ומכתתין אותו ומסככין בו בתים והשאר מניחין על גבי האור לכך אמרו חכמים הוירך כקנה ואל תהי קשה כארז כיצד מכבד אדם את רבו בזמן ששניהם מהלכין בדרך יותנו לימין ואיזנותנו נסמם היו שלשה תלמיד וחכם והרב ביניהם הרב הולך באמצע והגדול בימינו והקטן לשמאלו"@he ;
    oa:hasSelector opp:unit_fol_59v_1_u1_selector ;
    oa:hasSource opp:passage_fol_59v_1 .

opp:unit_fol_59v_1_u1_selector a opp:TokenPositionSelector ;
