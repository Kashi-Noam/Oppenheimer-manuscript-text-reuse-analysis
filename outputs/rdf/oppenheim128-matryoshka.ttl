opp:unit_fol_147r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_147r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "קולו של יעקב מצכבף בבתי כנסחת ובבתי מדרשות הידים ידי עשו שמואל אמ וצבא תנתן על התמיד בפשע בפשעה שלתורה אימתי כשישרל משלכין דברי תורה לארץ מלכות הרשעה הזאת גוזרת ומצלחת ומאי טעמיה ותשלך אמת ארצה ואין אמת אלא דברי תורה כדא אמת קנה ואל תמכור אמ ר יודה בר סימון זנח ישראל טוב אויב ירדפו ואין טוב אלא דברי תורה כדא כי לקחטוב נתתי לכם וכן הוא או לכן כאכול קש לשון אש וכ יש קש אוכלת אש אלא דרכה של אב להיות אוכלת קש ואתה אומ כאכול קשל שון אש אלא קש זו ביתו של עשו שהוא נמשל בקש דכת ובית עשו לקש"@he ;
    oa:hasSelector opp:unit_fol_147r_1_u2_selector ;
    oa:hasSource opp:passage_fol_147r_1 .

