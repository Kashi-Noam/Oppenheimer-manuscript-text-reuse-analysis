opp:unit_fol_53r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_53r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Kutim ;
    opp:earliestWitness opp:work_Tractate_Kutim ;
    rdf:value "הגבנים שלהם מותרות ר שמעון בן שעזר אומ אם של בעלי בתים מותרות אם של כפרים אסורות השלקים והכ בשים שלהם שדרכן לתת בהן ן וחומץ חסודין חולקין כהני ישראל עם כהני כותיים במקומן מפני שהוא כמציל מידם אבל לא במקום ישראל שלא יחזיקנו בכהנה כהן כותי שהוא אוכל את ישראל ומאכיל את ישר אל בטומאה מותר בטהרה אסור אין לוקחין פת מנחתום רותי במוצאיהפסח אלא לאחר שלשה תנורן ולא מבעלי בתים אלא לאחר שלשה שבתות ומן הכפרים אלא לאחר שלש עשיות אימתי בזמן שלא עשו מצה עם ישראל או שקדמו יום אחד אבל אם עשו מצה עם ישראל או שאחרו יום אחד חמצו מותר ר שמעון אוסר מפני שאינן יודעין לשמר מצה כישראל"@he ;
    oa:hasSelector opp:unit_fol_53r_1_u1_selector ;
    oa:hasSource opp:passage_fol_53r_1 .

opp:unit_fol_53r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "114"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_53r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_53r_1#u2" ;
    opp:closestWitness opp:work_Tractate_Kutim ;
    opp:earliestWitness opp:work_Tractate_Kutim ;
    rdf:value "כותי שהוא אוכל את ישראל ומאכיל את ישר אל בטומאה מותר בטהרה אסור אין לוקחין פת מנחתום רותי במוצאיהפסח אלא לאחר שלשה תנורן ולא מבעלי בתים אלא לאחר שלשה שבתות ומן הכפרים אלא לאחר שלש עשיות אימתי בזמן שלא עשו מצה עם ישראל או שקדמו יום אחד אבל אם עשו מצה עם ישראל או שאחרו יום אחד חמצו מותר ר שמעון אוסר מפני שאינן יודעין לשמר מצה כישראל בר אשונה אמרו יינה של גדוד אסור מפני יינה של כפר פושה חזרו לומר כל מקום שנחשדו המעורבין בגוים פתוחה אסורה סתומה מותרת ט ר מאיר אומ כל יינו מותר חוץ מן הפתוחה שבשוקים וחכמים אנמרים פתוחה בכל מקום אסורה וסתומ מותרת נקובה וסתומה כסתומה הקנהנים שלהם חדשים מותרים ישנים אסורים מפני מה הכותיים אסור ין לבא בישראל מפכי שנתערבו עם כהני הבמות"@he ;
    oa:hasSelector opp:unit_fol_53r_1_u2_selector ;
    oa:hasSource opp:passage_fol_53r_1 .

opp:unit_fol_53r_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "177"^^xsd:nonNegativeInteger ;
    oa:start "46"^^xsd:nonNegativeInteger .

opp:unit_fol_53v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_53v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Kutim ;
    opp:earliestWitness opp:work_Tractate_Kutim ;
    rdf:value "ישמעאל אומ גירי הצדה היו מתחלתן ומפני מה אסורין מפני ספק ממזרות ושאינן מיבמין את הנשואה מאימתי מקבלין אותם משיכפרו בהה גרזים ויודו בירושלם ובתחיית המתים מכאן ואילך הגוזל את הכותי כאלו גוזל את ישראל"@he ;
    oa:hasSelector opp:unit_fol_53v_1_u1_selector ;
    oa:hasSource opp:passage_fol_53v_1 .

opp:unit_fol_53v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "36"^^xsd:nonNegativeInteger ;
    oa:start "1"^^xsd:nonNegativeInteger .

opp:unit_fol_54r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_54r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אשת אביו וממנו את למד ערות אבות עד סוף כל הדורות ופרט בבהמה לפי שאינה קרובה אלא רחוקה ומן אחותו את למד קירוב בשר כמו אשת אח ומן חורבה חותנתו את למד קורבת אישות החלק החמשי ארור מכה רעהו ולוקח שחד ומשם את למד דיני קנסות החובל בחברו והריגה ומלשינות ושחד אפלו שוחד דברים זרת דרך ארץ בעה המקדש את האשה הרי זה אוסר עליו שבע עריות לו הן אמה ואם אמה ואם אביה בתה ובת בנה ובת בתה ואחותה בזמן שהיא קיימת וכלן שנאסרו על יו אין להן היתר לאיסורן חוץ מאחות אשתו שאינה אסורה אלא בחייה ול עוכם אינו כאסל את אשתו על אמה ועל בתה על אחותה"@he ;
    oa:hasSelector opp:unit_fol_54r_1_u1_selector ;
    oa:hasSource opp:passage_fol_54r_1 .

opp:unit_fol_54r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "145"^^xsd:nonNegativeInteger ;
    oa:start "35"^^xsd:nonNegativeInteger .

opp:unit_fol_54v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_54v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "נבעלה באונם מותרת לו בר צון אסורה לו נהכהנת בין באונם בין ברצון אסורה לו נתארסה נת גרשה נבעלה בין באונס בין ברצון אסורה לחזור לו דברי ר ישמעאל שהיה ר ישמעאל אומר לא יוכל בעלה הראשון אשר שלחה גו אחרי אשר הוטמאה וכי מאין נטמאת זו אלא זו שאמרו חכמים נבעלת באונס מותרת לו ברצון אסורה לו והכהנת בין באונס בין ברצון אסנרה לו זה מדרש דרש ר יוסי בן כיפר ימשום ר אלעזר בן שמוע כל האסורות לו איסור ערוה ובא עליהן אין צריבות ממנו גט חוץ מאחות אשתו ואשת אחיו ואשת איש שיש להן היתר אחר איסורן זה מדרש דרש ר חנינא בן אורי לפני חכמים משום ר נתן כל שהוא בלא יבא הולד פסול ופוסלבביאה ואלו הן עמוני ומואבי מצרי ואדומי עבד ממזר נתין כותי חלל בת חלל כשרה אעפ שהוא בלא יבא כל האם האסורות לו איסור ערוה ובא על הן מותר בקרובותיהן בקרובותיהן הבא על אשת"@he ;
    oa:hasSelector opp:unit_fol_54v_1_u1_selector ;
    oa:hasSource opp:passage_fol_54v_1 .

opp:unit_fol_54v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "152"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_55r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_55r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "זו שאלה שאל ר יוסי בן תדאי איש טבריא את רבן גמליאל מה אשתי שאני מותר בה אני אסור בבתה אשת איש שאני אסור בה אינו דין שאהא אסור בבתה אמ לו צא ופרנס לי כהן גדול שכהוב בו כי אם בתולה מעמיו יקח אשה ואני אפרנס לך כל ישראל דבר אחר אין דנין לעקור דבר מן התורה ונדהו רג כל האסורות לו איסור ערוה ובא עליהן לא פסלן מן הכהנה נדה אעפ שחייב על ביאתה הולד כשר להיות עומד ומקריב על גבי המזבח הנבעלת ממי שאינו איש אעפ שחייבת כרת לא פסלה מן הכהנה אמ ר יוסי מעשה בריבה אחת שהיתה מכבדת הבית ובא הקוף ובעלה מאחריה ובא מעשה לפני חכמים ולא פסלוה מן הכהנה"@he ;
    oa:hasSelector opp:unit_fol_55r_1_u1_selector ;
    oa:hasSource opp:passage_fol_55r_1 .

opp:unit_fol_55r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "116"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_55r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_55r_2#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אלו הן שניות אם אביו ואם אמו ואשת אבי אביו ואשת אבי אמו ואשת בן בנו ואשת בן בתו ואשת אחי אביו מאמו ואשת אחי אמו מן האב בר קפרא מוסיף אם אבי אביו ואם אבי אמו אשת אחי אביו אסורה לו ובתו מותרת לו ואחי אביו מותר באשתו ובבתו אשת אחי אמו אסורה לו ובתו מותרת לו ואחי אביו מותר באשתו ובבתו אשת אחי אמו אסורה לו ובתו מותרת לא וחחי אמו מותר באשתו ובבתו אשת חמיו ואשת חתנו הרי אלו מותרות לו אבל אמרו חכמים אשת חמיו אסורה מפני מראית העין ובתה מותרת לו בת חורגו אסורה לו ואשתו מותרת לו וחורגו מותר באשתו ובבתו נושא אדם אשת בן אחיו ואשת ב ן אחותו המחזיר גרושתו משנשאת אסורה לבעל וחולצת וצרתה מותרת ליבם והוא שבא על אחות חלוצתו אסורה לבעל וחולצת ואסורה ליבם אשת כשר ויש לו אח פצוע דכא מותרת לבעל ואסורה ליבם צרת סוטה מותרת לבעלה ואסורה ליבם ואחיו שבא על אחו גרושתו חלוצתו מותרת לבעל ואסורה ליבם בעל אשתו של כצוע דכא וישלו אח כשר מותרת ליבם ואסוי לבעל סוטה אסורה לזה ולזה חלוצה אסורה לזה גלזה אשתו של פצוע דכא ויש לו אח פצוע דכא אסורה לזה ולזה"@he ;
    oa:hasSelector opp:unit_fol_55r_2_u1_selector ;
    oa:hasSource opp:passage_fol_55r_2 .

opp:unit_fol_55r_2_u1_selector a opp:TokenPositionSelector ;
    oa:end "194"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_55v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_55v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "הבא על השפחה חייב עליה משום ארבע עשרה לאוין וכרת בידי שמים משום לא תזרע כרמך כלאים ומשום לא תחרוש בשור ובחמום ומשום לא תלבש שעטנז ומשום לא תרצח ומשום לא תנאף ומשום לא תגנב ולא תענה ולא תחמד ומשום אשת אב ומשום אשת אח משום שפחה משום זונה משום נדה משום גויה אם היה ישראל וחלל עצמו וזרעו בגויה לא יהיה לו ער בחכמים ועונה בתלמידים ואם היה כהן לא יהיה לו בן מגיש מנחה ליי צבאות הנושא אשה ההוגנת לו אליהו נושקו והקבה אוהבו והנושא אשה שאינה הוננת לו הקבה שונאו ואליהו רוצעו אוי לו לפוסל את את זרעו ולפיגם את משפחתו ולנושא אשת שאינה הוגננ לו וכל הפסול פוסל ואינו מדבר בשבחו של עולם"@he ;
    oa:hasSelector opp:unit_fol_55v_1_u1_selector ;
    oa:hasSource opp:passage_fol_55v_1 .

opp:unit_fol_55v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "134"^^xsd:nonNegativeInteger ;
    oa:start "17"^^xsd:nonNegativeInteger .

opp:unit_fol_56r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_56r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אבא חלפו אומ משום אבא חגרא אביו אל תהיפרוץ בנדרים שלא תמעול בשבועות ואל תתארח אצל כהן עם הארץ שמא יאכילך בקדשי שמים אל תרבה שיחה עם האשה שכל שיחתה של אשה אינה אלא דברי ניאופים ר אחי בר יאשיה אומ כל הצופה בנשים סוף שהוא בא לידי עבירה וחכמים אומרים כל המסתכל בעקב של אשה גוזרין עליו שיהיו לו בנים בעלי מומין וכל מי שאין בו בשת פנים במהרה הוא חוטא שנ הכרת פניהם ענתה בם וכל מי שיש בו בשת כנים לא במהרה הוא חוטא שנ ובעבור תהיה יראתו על פניכם לברתי תחטאו ר מיאשא בר בריה דר יהושע בן לוי אומ כל הרואה דבר ערוה ואינו זן את עיניו ממנו זוכה ומקביל פני שכינה שנ עוצם עיניו מראות ברע מה כת בתריה והוא מרומים ישכון וכת מלך ביפיו תחזינה עיניך כיל סרקא המינין והמסורות והמשומד והרשעים והחנפין והאפיקורוסין עליהם הכתו אומ כי לא לפניו חנף יבא האמתנין והגפתנין והזחחנין והזדונים ועזיפנים ובער י זרועות עליהם הכת אומ כי זרועות רשעים תשברנה וסומך צדיקים חורשי רע ומחשיכי דברים ומפטירי שכה ומחליף לשון עליהם הכת אומ יהי דרנכם חשך"@he ;
    oa:hasSelector opp:unit_fol_56r_1_u1_selector ;
    oa:hasSource opp:passage_fol_56r_1 .

