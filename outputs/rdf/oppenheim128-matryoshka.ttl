opp:unit_fol_88r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_88r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמרבן יוחנן בן זכאי רואה אני את דברי ר אלעזר בן ערך מדבריכם שהוא מדבר בנותן צדקה וחסר לישראל וחטאים לחומות העולם ר יהודה בר יהודה אמ צדקה תרומם גוי לו ישראל וחסד לאמים חטאת מקבלין הן ישראל חסידים מאומות העולם שכן רב שקה הוא אומ ליחזקיהו ועתה המלבעדי יי עליתי וכן נבוזר אדן אומ לירמיהו ויבא ויעש יי כאשר דבר והיה לכם הדבר הזה דבר כתו ר נחוניא בן הקנה או צדקה תכומם גוי אלוישראל וחסד לאומים חטאת חסד שאומות העולם עושים חטאת הוא לישראל ממי אתה למד ממישעמלך מואב שהיה נוקד שנ ומישע מלך מואב היה נוקד מהו נוקדרועה והשיב למלך ישראל מאה אלף כרים ומאה אלם אילים במר מהו אלים צמר ר אבא בר כהנא אמ"@he ;
    oa:hasSelector opp:unit_fol_88r_1_u1_selector ;
    oa:hasSource opp:passage_fol_88r_1 .

