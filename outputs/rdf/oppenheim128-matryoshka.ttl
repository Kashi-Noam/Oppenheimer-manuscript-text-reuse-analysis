opp:unit_fol_131v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_131v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר יוסי אומ ונ וחמשים עלו בני ישראל לה דורות עלו שנ ובני ישראל פרו וישרצו וירבו ויעצמו במאד מאד תרין אמיראין חד אמ אם לגדול שבשרצים אתה מדמה אותם הא עכברא ילדה שתא ואם לקנן שבשרצים אתה מדמה אותם הא עקרבא ילדה שתין רקק משה חת עצמית יוסף עמו להודיע בבזה ומשה היה עסוק בעצמות יוסף ההד ויקחמשה שבחו של משה שכל ישראל היו עסוקים את עצמרת יוסף עמו מהו עמו עמו למחנה לויה ומי הודיע למשה היכן יוסף קבור אמרו רבותינו סרח בת בת אשר היתה שם באותו הדור אמרה למשה בנילום הנהר יוסף קבור הלך משה מיד ועמד על שפת נילום ואמ יוסף יוסף הגיעה השעה שהקבה טאל את בניו השכינה מעכבת לך וכל ישראל"@he ;
    oa:hasSelector opp:unit_fol_131v_1_u1_selector ;
    oa:hasSource opp:passage_fol_131v_1 .

