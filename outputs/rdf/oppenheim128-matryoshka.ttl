opp:unit_fol_151v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_151v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מי יתנך כאח לי כאי זה אח כקין להבל קין הרג להבל כישמעאל ליצחק שמעאל שנא ליצחק כעשו לינקב עשו שונא ליעקב כאחי ייסף ליוסף אחי יוכף שנ שונאים הי ליוסח אלאכסר לאחיו י אתה מונא יחרכל הרעות שעשו לו מה כת בו ועתה אר תיראו אנכי אכלכל יאתכם אמ ר שמלאי אמ להוח אתן ראשין ואנא גפא אם אזל רישא מה גופא טב דא אמ להון אתח משנין בעפרא דארעא ובחלא דימא ולכוכבי שמיא והריני הולך ועושה מלחמה עמהם אם יכולתי להם הריני יכול לכם דא אמלהם מה אני נעשה אנטויריקוס של אבא הולא ואנא קביד דא אמלהם מה אני נעשה מברר שלהקבה שהוא מברר ובוחר ואני אוסיף דא אמ לקם אתם מלהנסדור של עולם יב שעות ביום ויב שעות בלילה יב מזרות בשמים ויב חדשים בשנה יכול אני לבטל מנהג סדורו שלעולם דא עד שלא ירדתם לכאן היו המצריים נוהגין בימנהו עבד משיכדתם לכאן אתם גניוסייא"@he ;
    oa:hasSelector opp:unit_fol_151v_1_u1_selector ;
    oa:hasSource opp:passage_fol_151v_1 .

opp:unit_fol_151v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "176"^^xsd:nonNegativeInteger ;
