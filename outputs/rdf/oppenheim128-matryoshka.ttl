opp:unit_fol_146r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_146r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לו מהפך את המטה אמ להם אני עושה כן שנ חזה הוית עד די כרסוון רמיו ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו מבזע פורפירא אמ להם אף אני עושה כן שנ עשה יי אשר זמם בצע אמרתו אמ ר יעקב דכפרחנן מבאפ פרפירא ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו יושב ומקונן אמ להם אף אני עושה כן שנ איכה ישבה בדד כה אמר יי קראו התבוננו וקראו למקוננות ר יוחנן ר שמעון בן לקישורבנא ר יוחנן אמ משל למלך שריו להם ט שנבנים כיים על הראשון ונטל את המקנ וחבטו והגלהו אמ טו אנול לאה לנגלה לעס על השני יונטל המקל וחבטו והנלהו אמ אנא הוא רגרמית לעצמי רתרבותי בישא"@he ;
    oa:hasSelector opp:unit_fol_146r_1_u2_selector ;
    oa:hasSource opp:passage_fol_146r_1 .

