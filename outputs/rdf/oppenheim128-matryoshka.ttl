opp:unit_fol_132r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_132r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "שני ארונות עם ישראל במדבר ארונו של יוסף וארונו של חי העולמים והיו אומית העולם אומרים להם זה ארונו שלמת וזה ארונו של אי העולמים ואומות העולם מונים לישראל ואומרין להם וכי דרכו של ארון האלהים להיות מהלך עם ארון של מת וישראל אומדים להם המת שהוא מונח בארון הזה קיים כל מה שהוא מונח בארון הזה וכל הכתובבו ר יוחנן הוה יתיב ודריש כאי זה צד היו המים לישראל כחומה דרש ד יוחנן כאלין קנקליא אדיקת אמרה סרח בת אשר אנא הויתי תמן ולא הוו אלא כאלין אמפימאנ ר יוחנן הוהיתיב ודריש כל הנפש הבאה ליעקב ינצרימה עולא ירכו מלבד נשי בני ינקב כל נפש ששים ושנ וייסף וב בניו והא חסרין חד ר לוי בשם ר חמא בר חנינא אמ זויוכבד שנולדה בין החומות ויש אומ סרח בת אשר השלימה מניינן של ישראל שנ אנבי שלמי אמור ר ישראל אני היא שהשלמתי מניינן של ישראל אני השלמתי נאמן לנאמן אמ ר תנחום בל חנילאי הקבה נכנם עמהם בר בודו"@he ;
    oa:hasSelector opp:unit_fol_132r_1_u1_selector ;
    oa:hasSource opp:passage_fol_132r_1 .

opp:unit_fol_132r_1_u1_selector a opp:TokenPositionSelector ;
