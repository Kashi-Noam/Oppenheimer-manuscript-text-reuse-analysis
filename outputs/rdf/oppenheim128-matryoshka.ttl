opp:unit_fol_185r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_185r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "מעשה בבנו ובתו שלר ישמעאל בן זלישע כהן גדול שנשבו לפנ אדנים הבן לאדון אחד והלת לאדון אחד אמרו זה לזה ישלי עבד שהוא יפה ביותר ואיז כמותי בעולם אמ לו חבירו יש לי שפחה אחת שאין כמות בעולם נת יעצו להשיאם זה לזה מה עשו זיווגום היה יושב וה דהרוז אחד וזה בקכץ איזד זה בוכה ואומר אני כהן בן הפם בדולים אנשא לשפחה וזו בוכה ואומרת אני בת להז גדול ואנשא לעבד והיו בוכים כל הלילה כיון שעל ה נמוד השחר הכירו והצתזה וגעו בבכיה גדולה וחבהו זה את יה עד שיצאה נשמית וטל הן מקונן ירמיה על אלה לבוכיה אמ רב יהודה אמרב"@he ;
    oa:hasSelector opp:unit_fol_185r_1_u1_selector ;
    oa:hasSource opp:passage_fol_185r_1 .

opp:unit_fol_185r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "107"^^xsd:nonNegativeInteger ;
