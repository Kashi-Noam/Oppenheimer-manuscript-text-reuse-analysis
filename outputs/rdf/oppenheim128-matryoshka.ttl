opp:unit_fol_4r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_4r_1#u1" ;
    opp:closestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "מדבר שהא שנוי כיצד אמ ר יוסי בר חנינא ארבעי ושתים שנה היה הרעב כאוי לבא במצרים שכין פרעה רואה שבע פרות ושבע שבלים הרי יד והוא אומר וליוסף שבעפכות ישבע שבלים הרי לח וייסף חוזר ואות שבעפרות ושבע שבלים ודי שם קרער אלא שתי שנים שכ מב ולח על עיהב נמצרים בלה היוב שירד הרלכאוי ואמתי הורו אינן מב שנה ביהי יאזקאל יונד כי זה שנתם נתתי ארן מוצרים שחמה יארבעים שנההיתה כך ולא עשתה אלא לצורך כינוצא בר בר איבה אומי א תבטחו לכם גו לי רנאמ שלשפעמים אמ להם אל בניחו שלש פעמים שזם אנכ עישים רצונו שלמע אין שלש חגיכם כלום וכן הואאומ חדשיכם ומועדיכל שלאה נפשי ואומ שנאתי מאסתי חגיכם דבר חחר אמ להם דאו שלש פעמים מקדשנם שחרב נב וגבעון שילה הזהרו שלא יארב גם זה"@he ;
    oa:hasSelector opp:unit_fol_4r_1_u1_selector ;
    oa:hasSource opp:passage_fol_4r_1 .

opp:unit_fol_4r_1_u1_selector a opp:TokenPositionSelector ;
