opp:unit_fol_178r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_178r_1#u2" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "מיד הניח ידיו על ראשו והיה צועק ובוכה אמ שמא חס ושלים אין להם לישראל תקנה יצתה בת קול ואמרה זית רענין יפה פרי תאר קרא יי שמך מה זית זה תחלתו כסופו אף שראל אחריתן כתחלנן לקול המלה נדולה לקל מיליהק ומתלים נתירעפי תכו ישאל ראמ רחינש ברפהא דברגדול הבח מרלים באורה שעה שנ כי חזק הוא ממנו אל תקריפ ממנו אלא ממנו כביכול אפי בעל הבית אינויכול לה וציא כליו משם אמ ר יהושע בן לוי למה נמשלו ישראל בזית לומר לך מה זית זה אין עליו נושרין לא בימות החמה ולא בימות הגשמים אף ישראל אין להם בטלה לא בעולם הזה ולא בעולם הבא אמ ר יחכן למה"@he ;
    oa:hasSelector opp:unit_fol_178r_1_u2_selector ;
    oa:hasSource opp:passage_fol_178r_1 .

opp:unit_fol_178r_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "111"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_178r_1_u3 a opp:TextUnit ;
    rdfs:label "fol_178r_1#u3" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "כי חזק הוא ממנו אל תקריפ ממנו אלא ממנו כביכול אפי בעל הבית אינויכול לה וציא כליו משם אמ ר יהושע בן לוי למה נמשלו ישראל בזית לומר לך מה זית זה אין עליו נושרין לא בימות החמה ולא בימות הגשמים אף ישראל אין להם בטלה לא בעולם הזה ולא בעולם הבא אמ ר יחכן למה נמשלו ישראל בזית לוא לך מה זיתזה אינו מוציא שמנו אלא על ידי כתישה אר ישראל כן איכן חוזרין למוטב אלא על ידי ייסורין וחייבינהו קודשא בריך הוא לישראל לענויי נפשיהו ולמנהג אבלותא בט באב ואסור באכילה ובשתיה וברחיצה ובסינה ובנעירת הסנדל נברתשמיש המטה ואסור לקרות בתורה ובנביאים ובכתנבים ולשנות במשנה ובמדדש בהלכות ואגדות אבל קורא באיוב ובקינות ובדברים הרעים שבירמיה ותינוקית של בית כבן בטלים משום שנ פקודי יי ישרים משמחי לב"@he ;
    oa:hasSelector opp:unit_fol_178r_1_u3_selector ;
    oa:hasSource opp:passage_fol_178r_1 .

opp:unit_fol_178r_1_u3_selector a opp:TokenPositionSelector ;
