opp:unit_fol_78r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_78r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר אחא לא מהשיכו כ משב נ ייע לו רמר אלם ירבד שנע בנירבייא לחי היסשלו לאירעי משר כיי האה אם שער תמוקמה צ י קשינ ת ביגג סבילסקשה תסונת של ירייה שעזלה עליו גזבה קשה שנקמ אזתום בשך וין האישהיה בייהו כה אמר יי כתכו אה איץ וזה עריריג בר לא יצלי בימיו ר אבא ברכהנא אמ כטרוה היה של מיי שנשמה שזתה מוכצו עיד אינו יפה לאימ ר חלרו אמ כחותל הזה של תמרה שמשעה אתיה מדערי עוד יזינו יפה למאמה אם כלי אין חת כו ר חמא בר חנינא אמ ככלי של מיינירולים שעטא בר נחמן אנ ככלי שלמהיי הם אינד מאית למנע הק ה טמינו מנימניוי מכניהו בויהויק כירולך יהוו מליה ההב מיהנ נאם יכי אם יהיה נציהו בן יהויקים וצלד יהורה חותם על יד ימיני בירהשם אתקנך ר חינש בר יצחק אנתקך אין כת כא אלם אנקנב בתשיבה ממקוא נתיקתו משל תהא תקנתו אמ ר זינידא שמיגית קליה דרר שמול בר יצהק יתיב"@he ;
    oa:hasSelector opp:unit_fol_78r_1_u1_selector ;
    oa:hasSource opp:passage_fol_78r_1 .

opp:unit_fol_78r_1_u1_selector a opp:TokenPositionSelector ;
