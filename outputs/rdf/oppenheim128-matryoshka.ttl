opp:unit_fol_66r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_66r_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לבש כליו ויצא לשוק אומ יהי רצון מלפניך יי אלהי שתוליכני לשלום ותסמכני לשלום ותנני לחן לחסד ולרא ולרחמים בעיניך ובעיני כל רואי ותגמלני חסדים טוגבים ותחזירני לביתי בשלום ותצילני מכף אויב ואורב בדרך והצילני מלשחהרנב ואלתרגלני לרבר עבירה וחטא ועול ואל אכשל בדבר הלכה ולא בשום דבר בעולם ותצילנר מכל מיני מזיקים מכל מיני פורעניות המתרגשות לבא בעולם שלא יזיקו בי בין ביום בין במלילה אמן יהי רצון מלפניך יי להי שתראלי בשמחתה של ירושלם ונחמותיה אמן חסלת מדת דרך ארץ"@he ;
    oa:hasSelector opp:unit_fol_66r_1_u2_selector ;
    oa:hasSource opp:passage_fol_66r_1 .

