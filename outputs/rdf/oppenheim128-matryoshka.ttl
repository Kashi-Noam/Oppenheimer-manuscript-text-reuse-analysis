        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "איכה היתה לזונה ר אבהו בשם ר יוסי בר חנינא כתח והמה כאדם עברו בריק שם בגדו בי והמה כאדם וה אדם הראשון הרנסתי אותו לגן עדן וצויתיו ועבר על צוויי ודנתי אותו בגירושין ודנתיאותו בשליחין וקוננתי עליו אינה הרנסתיו לגן עדן שנ ויקח יישלרים את הארם ויניחהו בנן עדן ובויתיו שנ ויצו יי אלהים על האימ ועבר על צוויי שנ המן העץ אשרצויתיך ודנתי אותו בגירושין שנ ויגרש את האדם ודנתי אותו בשלוחים שנ וישלחהו יי אלהים וקוננתי עליו איכה שנ ויקרא יי אלהים אל האום ויאמר לו איכה"@he ;
    oa:hasSelector opp:unit_fol_145r_2_u2_selector ;
    oa:hasSource opp:passage_fol_145r_2 .

opp:unit_fol_151r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_151r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "לך נביאיך חוו לך שואותפל ורבנן אמ מי ירפא לך נביאיך אהבת צדק ותשנא תע על כן משחך אלהים אלהיך שמן ששון מחביריך ר עזריה בשם ר אחא פתר קריה באבינו אברהם אתה מוצא קודם שהביא הקבה מבול על הסדומיים אמ אבינו אברהם לחני הקבה לבון העולמים נשבעת שאין אתמביא מבול לעולם מאי טנמ כי מי כח זאת לי אשר נשבעצי מעבור מי כח עוד על הארץ ואמ מבול של מים אין אתה מביא מה אתה מעדים על השבועה חלילה לך מעשות כדבר הזה אמ ר לוי אמ אבינו אברהם השפט כל הארץ לאיעשה משפט אם דין אתה מכקש אין עולם אלם עולם אתה מבקש אין דין את תפיש חבלא בתרין רישוי בעי עלמא ובעי דינא דקושניא אין לית מוצר צתמו גד יצכשרף דניי י דנ נק לנ לית עלמא יכיל קאים אמ הקבה אברהם אהבת צדק ותשנא רשע אהבת לצדק בריותי ושלאת רשע מלחייבן על לן משחד אלהים אלהיך שעש ששון מחביריך"@he ;
    oa:hasSelector opp:unit_fol_151r_1_u1_selector ;
    oa:hasSource opp:passage_fol_151r_1 .

opp:unit_fol_163r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_163r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כנטוע שמים וליסה ארץ אלו הקרבנות ולאמר לביון עמי את אמ ר חיננא ברפפא חזררנו על כל המקרא ולא מצאם מקום שנקראו ישראל ציון אלא בהכא שנ ולאמר לביון על אכה רני עקיה לא יליה מושיבי עקרת הבית אם הבנים שמחה הלטיה ועקרות היו ונפרדו ואליהן שרה רבקה רחל ולאה ואשתו שכ מנח וחנה וציון דא מושיבי ה עקרת הבית זואמנו שרה שנ ותהישרי ק עקרה אם הבבים שמחה שנ הניקה בנים שרה מושיבי עקרת הבית זו רבקה שנ ויעתר יצחק ליי לנכח אשתו כי עקרה היא אם הבנים שמחה ותהר רבקה אשתו מושיבי כוקרת הבית זו לאה שנ וירא יי כי שנואה לאה ויפתח את רחמה מכאן שהיתה פקרה אם הבנים שמחה שנ הפעם יזבללי אישי מושיבי עקרת הבית זו רחל שנ ורחר עקרה אם הבנים שמחה שנ בני רחל יוסף ובניהן מושיבי עקרת הבית זו אשתו של מנוח שנוירא מלאך יי אל האשה ויאמר יליה הנהנא את עקרה ולא ילדת והרית וילדת בן מושיבי עקרת הבית זו חנה שנ ולחנה אין ילדים אם הבכים שמחה כי פקד ייי את חנה ותהר ותלד שלשהבנים"@he ;
    oa:hasSelector opp:unit_fol_163r_1_u1_selector ;
    oa:hasSource opp:passage_fol_163r_1 .

opp:unit_fol_165r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_165r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דלמא ר אלעזר בן עזריה ור אל עזר המודעי הוו יתבין ועסקין יהדין קר אבעתהה יא יקראו לירושלם כסא יי אמ ליה וב אללאי בן אלעזר לר אלעזר המידעי ומחזקת היא ירושל א נליה עתד הקבה לימה לה האריני הרחיבי קכלי אכלוםך הרחיבי מקום אהלב האמר יוחנן עתידה ירושלם להיות נוגעת לשערי דמשק ומחי טעמא משא דבר יי בארץ חדרך ר יהודה ור נחמיה ר יהודה אומ אין זה לשח חדרך אמ ליה ומה אתה מקים ודמשק מנוחתו ואיןמנוחה אלא ירושלם שנא זאת מנוחתי עדי עד פה אשב כי אויתיה אמ ליה ומה אתה מקיים ונבנתה עיר על תלה אמ ליה שאינה עתידה לזוז ממקומה אלח מתרחבת ועולה מכל צדדיה והגליות באות וחונים תחתיה לקיים מה שנ וארמון על משפטו ישב ואומ כי ימין ושמאל תפרצי הר ילארך ולרחב מנין שנ וממגדל חננאל עד יקבי המלך ר נחמיה ור יהודה אומ אין לשון זה חדקך ומה אתה מקים רובה או עד שיהא ריבע ולא פליגין מאן דאמ עד אוק יאנום יקבים שיקבם המלך שלמה הכי ואידך לרוחב ולגובה מנין שנ ורחבה נסבה למעלה למעלה עד"@he ;
    oa:hasSelector opp:unit_fol_165r_1_u1_selector ;
    oa:hasSource opp:passage_fol_165r_1 .

opp:unit_fol_168r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_168r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "גרשה מותרת להנשאלאחר ורשאי שני כשהותעמה עשרשנים אם הפילה מונה לה משעה שהפילה אמ ר די מעשה באשה ששהתה עם בעלה עשרשנים ולא ילדה אתי לקמיה דר שמעח בן יוחאי כדי למשתבקא אמ להם חייכם כשם נחדווגתם זה לזה אלא על ידי מאכל ומשתה כך אל תתפמשו זה אלא מתוך מאכל ומשתה הלכו ועשו סעודה לאחר שאכלו ושתו אמ לאשתו כל חפץ טוב שיש לי בתיך ביתי טלי אותו ולכי לך לבית אביך מה עשתה נשכרתו יותר מדאי ואמרה לעבדיה ולשפחותיה טלו אותו והוליכוהו לבית אבי ם ויהי בחצי הלילה נעור האיש משנתו ומצא עצמו בבות אבי אשתו אמ לה מפני מה אני נתין בבית אביך אמרה לו ולא כך אמרת לי כלחפץ טוב שיש לי בתיך ביתי טלי אותו אין לי חפץ טוב בעולם אלא אתה מיד בכושניהם כיון ששמע ר שמעון בן יוחאי כך נתפלל עליהם ונכקדו הקבה פיקד עקרות והצדיקים פוקדים עקרות והלא דברים קל וחומר מה אם בשר ודם אמר לבשר ודם אין ליחנן ליוב בעילם אלא אתה ישרזל שהם יישבים והצלים לישועתו שלהקבה זה כאה שנים"@he ;
    oa:hasSelector opp:unit_fol_168r_1_u1_selector ;
    oa:hasSource opp:passage_fol_168r_1 .

opp:unit_fol_171v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_171v_1#u1" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "לא נאמר אלא יבנה אמ ר יהושע בן לוי כל האומר שירה בעולם הזה זוכה ואומ שירה לעולם הבא שנ עוד יהללוד סלה ונאמ ירננו על משכבותם אמ ר חייא בר אבא אמ ר יוחנן פתידים כל כל הנביאים ככם לומר שיכה בבת אחת שנ קול צופיך נשאו קול יחדו ירגנו אמרב יהודה אמ רב כל המונע הלכה מפי תלמיד כאלו גוזלו מנחלת אבותיו שנ תורה צוה לנו משה מורשה קהלת יעקב מורשה היא לכל ישראלל מששת ימי בראשית אמ ר שמעון חסידא כל המונע הלכה מפי תלמיד אפי עוברין שבמעי אמן מקללין אותו שנ מוננ בר יקבוהו לאם ואין לאם אלא עוברים שנאמ ולאם מלאם יאמץ ואין קב אלא קכלה שנ מה אקת לא קבהם ואין בר אלא תרה שנ נשקו בר אמ עילא בר ישמעאל מנקבין אותו ככברה אמ אביי כאובלא דקצרי אם כמדו מאישכרו אמ רבה אמ רב ששת זוכה לברכות כיוסף שנ וברכה לראש משביר ואין משביר אלא יוסר שנ ויוסף הוא המשביר לכל עם הארץ אמ רב ששת כל המלמד תורה בעלם הזה זוכה ומלמדה לעולם הבא שנ ומרוה גם הוא"@he ;
    oa:hasSelector opp:unit_fol_171v_1_u1_selector ;
    oa:hasSource opp:passage_fol_171v_1 .

opp:unit_fol_172r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_172r_1#u1" ;
    opp:closestWitness opp:work_Ein_Yaakov_Glick_Edition ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "אמר אלעזר כל אדם שיש בו דעה לסוף תנ מתעשר שנ ובדעת חדרים ימלאו כל הון יקר וכנעים וכל שאין בודעה אסור לרחם עליו שנ כי לא עם בינות הוא על כן לאירחמנו עושהו אמ ר אלעזר כל המשייר פתיתים על שילחנו כאלו עובד ע שנ העורבים לגד שלחן אמ ר אלעזר כל המשנה ומחליף בדבורו כאלו עובד עש שנ אולי ימשני אבי והייתי בעיניו כמתעתכג וכת התם אך הבל המה מעשה תעתועים אמר אלעזר כל המסתכל בעריות קשתו ננערת שנעריה תעד קשתך ואמר אלנזר לעילם הויקבל וקיים אמ ר זירא אף אנן נמי תנינא בית אפר אין פותחין בו חלונות לראות את נועו אמ ר טבי אמ ר יחשיה מאי דכת שאול ועוצר רחם וכי מה ענין שאול אצלרחם לומ לך מה רחם מכניס ומוביא אף שאל מכנים ומוציא והלא דברים קל וחנמר ומה רקם שמכניסין לי בחשאי מויציאין ממנו בקולי קולרת שאול שמבפיסין בו בקוליקולות אינו דין שמוציאין ממנו בקולי קולות מכאן תשובה לחומ אין תחיית המתים מן התורה"@he ;
    oa:hasSelector opp:unit_fol_172r_1_u1_selector ;
    oa:hasSource opp:passage_fol_172r_1 .

opp:unit_fol_180r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_180r_1#u1" ;
    opp:closestWitness opp:work_Babylonian_Talmud,
        opp:work_Midrash_Tehillim ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "אמרו בשר נאכל בשר שממנו מקריבין על גבי המזבח וערשו בטל יין נשתה שממנו מנסכין על גבי המזבח ועכשו בטל אמ להם אם כן לא נאכל לחם שממנו היומקריבין מנחות ועכשו בטל אפשר בפירות פירות לאנאכל שמהן היו מקריבין בכורים ועכשו בטל מים לא נשתה שמהן היו עושין נסוך המים ועשו בטל אלא שתקו אמ להם בני שלא להיות אבל כל ה עיקר אי אינשר שכבר נגרה גזרה ולקיות אבל יותר מדאי אי איפשר שאין גוזרון גזירה על הצבור אלא אם כן רוב הצבור יכולין לעמוד בה אבל אמרו חכמים סד אדם את ביתו בסיד ומשייר בו דברמועט וכמה אמ רב חסדא אמה אמ רביוסף וכנגד הפתח עושה אדם כל צרכי סעוד ומשייר בו דבר מועט מאי היא כסא דהרסנא עושה אשה כל תכשיטיה ומשיירת דבר מועט מאיהיא אמ רב פפא בת צידעא נלכדה ביתר מנא לן שנ גדע בחרי אף כל קרן ישראל אמ ר חייא בר אבין אל"@he ;
    oa:hasSelector opp:unit_fol_180r_1_u1_selector ;
    oa:hasSource opp:passage_fol_180r_1 .

opp:unit_fol_186r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_186r_1#u1" ;
    opp:closestWitness opp:work_Ein_Yaakov_Glick_Edition ;
    opp:earliestWitness opp:work_Eichah_Rabbah ;
    rdf:value "היה רבן גמליאל ור יהושע ור אלעזר בן נסריה ור עקיבא מהלכין בררך שמעו קול המונה של רומני ברחוק קכ מיל התחילו הם בוכים ד עקיבא משחק אמ להם ומפני מה אתם בוכים אמרו לו ומפני מה אתה משחק אמ להם ומפני מה אתם בוכים אמרו לו גוים שעמד עלינו בחטאתינו משתחוים לאלילים ומקטרים לעצבים והם יושבים בשלוה ובהשקט ואנו בית הרום רגלי אדננו נשרף ולא נבכה אמ להם לכך אני משיק ומה אם לעוברי רצונו כך לעושירצונו על אחת כמה ונמה שובפעם אחת היו עולין לירושלם כיון שהגיעו לצופים קרעו את בגדיהם כיח שעלו להר הבית ראו שועל שהיה יוצא מבית קדשי הקדשים התחילו הם בוכים והיא משאק אמרו לו מפני מה אתה משחק אמ להם ומפני מ אתם בוכים אמרו לו מקום שכתוב בו והזר הקרב יומת ועכשו שועלים הלכו בו ולא נבכה אמ להם ורכך אני משחק נית ואעידה לי עדים נאמנים את אוריה הכהן ואת זכריהו בן יבדכיהו וכי מה ענין אוריה אצל זכריה"@he ;
    oa:hasSelector opp:unit_fol_186r_1_u1_selector ;
    oa:hasSource opp:passage_fol_186r_1 .

opp:unit_fol_195r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_195r_1#u1" ;
    opp:closestWitness opp:work_Eichah_Rabbah,
        opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Eichah_Rabbah ;
    rdf:value "שהם היו בתח לה מלוכלכים בעולם שהם הם היו בגבעה והם עמדו כנגד ירמיה והם היו כופין את ישראל לעז שבגבולן היה בית המקדש תאנא שנה קודם חורבן הבית רמז הקבה לשר ההריון ונתעברו נשותיהן כפלים וכשנכנסו גוים בהיכל גזרו שלא יהרגום אלא שיוליכום לבבל וכשהגיעו לנהרות בבל מתו כלם בבת אחת בקשו לקברן ולא הניחם נבוזר אדן אמ להם אל תקברו אותם אלא הוליכום על צואריכם והיו נושאים אותם פל צוארם עד שנשכו בשרם וגופם על כתפיהם באותה שעה געו כלם בבכיה עד שעלתה בכייתם למרום ועתיד הקבה לשלם להם גמולם שנ בת בבל השדודה אשרי שישלם לך את גמונד שגמלת לנו ועתיד לרחם על ציון ולהיות לה קומת אש דכת ואני אהיה לה נאם יי חומת אש סביב ולכבוד אהיה בתוכה איכה ישבה בדד שלשה אמרו לשון איכה י משה וישעיה וירמיה משה אמ איכה אשא לבדי ישעיה אמ איכה היתה לזונה ירמיה אמ איכה ישבה בדד אמ ר לוי משל למטרונה שהיו לה שלשה שושבינין אחד ראה אותה בשלותה ואחד ראה אותה בפחזותה ואחד ראה אית בניוולה משה ראה אותה בשלותה אמ איכא אשא לבדי"@he ;
    oa:hasSelector opp:unit_fol_195r_1_u1_selector ;
    oa:hasSource opp:passage_fol_195r_1 .

