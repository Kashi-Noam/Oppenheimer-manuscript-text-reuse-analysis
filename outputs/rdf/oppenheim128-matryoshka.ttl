opp:unit_fol_197r_1_u3 a opp:TextUnit ;
    rdfs:label "fol_197r_1#u3" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "אמרו לו בני פלטין שלו בנך נשבר ואתה או נשבי מהו קדרתי שמה החזיקתני משל לחנם שלא ראה אבל מימיו והיה לו בן אחד ומת קרא לתלמידיו אמ להם הראו לי היאך האחרים מתאבלים כך החכם זה הקבה שנ יי בחכה יסד ארץ י כיון שחרבה ציון וירושלם ובית המקדש ועברו ישראל כל אותן הצרות אשר למות למות ואשר לחרב לחרב קרא הקבה למלאכי השרת אמ להם הראו לפני היאך בני אום מתאבלים אמרו לו המתאבל קורע את בגדיו אף אנו נעשה כן שנ עשה יי אשר זמם בצע אמרתו"@he ;
    oa:hasSelector opp:unit_fol_197r_1_u3_selector ;
    oa:hasSource opp:passage_fol_197r_1 .

opp:unit_fol_197r_1_u3_selector a opp:TokenPositionSelector ;
    oa:end "179"^^xsd:nonNegativeInteger ;
