opp:unit_fol_72v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_72v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ובזמן שהא בא בשבת זכרון תרועה מזכירין אבל לא תוקעין ר ועירא הוה מפקיד לחבריה עלין ושמעין קליה דר לוי דדריש רלית איפשר דיפוק פרשיתיה דלאולפן עאל ודרש קדמיהון ואמ כת אחד אומ זכרון תרועה יהיה לכם מזכירין אבל לא תוקעין וכת יום תרועה יהיה לכם האכאי זה צד יתק יימו שני כתובין הללו בזמן שהוא בא בחול יום תרועה יהיה לכם ובמן שהוא באבשבת זכרון תחעה מזבכירין אכל לא תוקעין תאני ר שמעון בן יוחאי ידחה במקדש שבית דין יודעין זמנו טלחדש תאני ר שמעון בן יוחאי יום תרועה יהיה לכם ועשיתם במקום שהקרבנו קריבין אמ ר תחליפא קסריא בכל קרבנות כת והקרבתם וכאן כת ועשיתם אמ הקבה משום שנכנס שנכנסתם לפני ברין ביום הזה ויצאתם בדימיס מעלה אני עליכם כאלו היום נעשיתם והיום בראתי אתכם בריאה חדשה שנ כי כאשר השמים החדשים והארץ החדשה אשר אני עושה עומדים לפני נאם יי כן יעמד זרעכם ושמכם שובה שראל עד יילהיך כי כשלה בעונך אם יתקע שופר בעיר ועם לא יחרדו אם תהיה רעה בפיר ויי לא עשה משל למדינה שהיתה משובשת בגייסות והיה בה זקן אחד"@he ;
    oa:hasSelector opp:unit_fol_72v_1_u2_selector ;
    oa:hasSource opp:passage_fol_72v_1 .

