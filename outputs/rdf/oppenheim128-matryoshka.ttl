opp:unit_fol_83v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_83v_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "אמ ר הוניא למדתך התורה דרך ארץ שלא יהא החתן נכנס לחופה תחלה עד שהכלה נותנתלו רשות שנ יבא דודי דודי לגנו ואחר כך באתי לגני אחותי כלה ר מנחם חתניה דר אליעזר בר אבינא אמ בשם ר שמעון בן יאסינא באתי לכאן אין כת כאן אלא באתי לגני לגנוני למקום שהיה נקרא מתחלה שעיקר שכינה בתחתונים היתה ההד וישמעו את קול יי מתהלך מקפץ וסליה ויתחבא האדם אמ ר איבו באותה שעה גבהה קומתו של אדם הראשון ונעשית של ק אמה אמ ר יצחק וצדיקים יירשו ארץ הרשעים הוכן הם פורחין באויר אלא מהו וישכנו לעד עליה וישכינו שכינה עליה עיקר שכינה בתחתונים היתה וכיון שחטא אדם הראשון נסתלקה לרקיע הראשון עמד דור אנוש וחטא נסתלקה מז הראשון לשני עמד דור הפלגה וחטא נסתרקה מן השני לשלישי עמר דור המבול וחטא נסתלקה מן השלישי לרביעי עמדו דור מצריים בימי אבינ אברהם ונסתלקה מהר ביעי לחמישי עמרו הסדומיים ונסתלקה מן החמשי לששי עמדו מצריים בימימשה ונמלר ונסתלקה מן הששי לשביעי וכנגדן עמדו שבעה בדיקי והורידוה לארץ"@he ;
    oa:hasSelector opp:unit_fol_83v_1_u2_selector ;
    oa:hasSource opp:passage_fol_83v_1 .

