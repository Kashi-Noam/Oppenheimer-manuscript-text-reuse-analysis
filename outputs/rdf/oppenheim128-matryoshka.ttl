    rdf:value "שמנים אלף פרחי כהונה והרגם עליו עד שהגיע דמן לקברו שלזכריה ההד פרצו ודמים בדמים נגעו ועדין הדם תוסס בההיא שעתא נזף ביה נבוזר ארן אמ ליה מה את בעי דתיבד כל אומתך עלך באותה שעה נתמלא הקבה רחמים ואמ ומה אם זה שהוא בשר ודם אכזרי נתמלא ראמים על בני אני שכתוב בי כיםל רחום יי אלהיך על אחת כמה וכמה באותה שעה כמז הקבה לדם ונבלע במקול ככסך היה לסצים בראשונה היו משתמשי י במטבעות שלכסף משרבו הרמאים התחילו שהיו משתמשן במנובנת של נחשת מחופים כסף והוה חד מנהון אזיל לגבי צרפא ושמע קללה אמר לברי בייתיה הנחש ליה אף הוא אזל למזבן קסנ דחמר מן גו קפילא ושמרג קלא אמר לברבייתיה המהד ליה ההד כספך היה לסיגים סבאך מהלבמים"@he ;
    oa:hasSelector opp:unit_fol_148v_1_u1_selector ;
    oa:hasSource opp:passage_fol_148v_1 .

