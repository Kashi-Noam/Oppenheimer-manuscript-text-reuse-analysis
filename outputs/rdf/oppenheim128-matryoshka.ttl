opp:unit_fol_51r_2_u2 a opp:TextUnit ;
    rdfs:label "fol_51r_2#u2" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "נאמרה אהבה בישראל שנ אהבתי אתכם אמר יי ונאמרה אהבה בגרים שנ ואה בתם את הגר נקראו ישראל עבדים שנ כי לי בני ישראל עצים ונהראו הגרים עבדים שנ מהיות לו עברים נאמר דצון בישראל שנ והיה על מצחו תמיד לר צרן להם לפני יי ונאמ רצון בגרים שנ עולותיהם וזבחיהם לרצון על מזבחי נאמנה שמירה בישראל יי שומרך יי צלך על יד ימינך ונאמרה שמירה בגרים יי שומר את גרים נאמר שירות בישראל שנ כהני יי תקראו משרתי להינו ונאמר שירות בגרים שנא ובני הנכר הנלוים אל יי לשרתו חביבין הגרים שלא מל אבדהם אלא בן עשרים ולא בן שלשים אלא ב תשעים ותשע שנה שאלו מל בן עשרים ובן שלשים לא היה גר מתגייר מבן עשרים שנה ומבן שלשים שנה ומעלה אלא שהקבה היה ממשמש עמו ובא עד שהגיע לתשעים ותשע שנה שלא לנעול דלת בפני הגרים ולתת אריכות ימים לשבים ולהרבות שכר לעושי רצונו שנ יי חפץ למענצדקו יגדיל תורה ויאדיר אברהם אבינו קרא עצמו גר שנ גר ותושב אנכי עמכם דוד מלך ישראל קרא עצמו גר שנאמ כי גר אנכי עמך תושב ככל אבותי"@he ;
    oa:hasSelector opp:unit_fol_51r_2_u2_selector ;
    oa:hasSource opp:passage_fol_51r_2 .

opp:unit_fol_51r_2_u2_selector a opp:TokenPositionSelector ;
