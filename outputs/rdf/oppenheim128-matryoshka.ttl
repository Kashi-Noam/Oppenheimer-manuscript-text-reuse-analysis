opp:unit_fol_3v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_3v_2#u1" ;
    opp:closestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "בו והיה כי יבצע יי את כב מעשה בהר ציוןץ ודיד ישרם אר קור על ררי גודל לבד מלך שוב סיר גו ולמה ביאמי בכחידי וישיא ובחכמתיר נבנו הקבה אימי והמני הגרזן על החוצב בו גו והלח א חתהה אמה אלא לקרדום הזה שהאומן מבקע בו אבל הם חיט יכול לבקע רלום מעצמ וכמלוה הזה שאדם מכד כו והוא אינו יכול להכות כך אני מחריב את העולם בך ואתה מתגאה ואמר בכח ידי עשיתי לפיכך ישלח י צבאות במשמניו רזון גו ואף כל מלכי אומות העולם על דבר זה נידונין ומפני מה פירשו באשור בלבד מפני שהוא תחלה"@he ;
    oa:hasSelector opp:unit_fol_3v_2_u1_selector ;
    oa:hasSource opp:passage_fol_3v_2 .

opp:unit_fol_3v_2_u1_selector a opp:TokenPositionSelector ;
    oa:end "100"^^xsd:nonNegativeInteger ;
    oa:start "2"^^xsd:nonNegativeInteger .

opp:unit_fol_3v_2_u2 a opp:TextUnit ;
    rdfs:label "fol_3v_2#u2" ;
    opp:closestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "מדרך קצרה כיצד ואהה מתהלך מאהל אלקהל וממשכן היה צריך לומ וממשכן אל משכן אלא שרבר הכת לשון קצרה ומאימתי הדבר נידו ן בדך קגרה משיהא העתין צריך לו ודא כיוצאבו ותכל דוד לצאת היה צריך לומר ותכל נכש דוד המלך אלא שובר הכת בלשח קצרה ואעפ שאן ראיה לדבר זכרלרבת שנ נכספה וגם כלתה גפשי"@he ;
    oa:hasSelector opp:unit_fol_3v_2_u2_selector ;
    oa:hasSource opp:passage_fol_3v_2 .

opp:unit_fol_3v_2_u2_selector a opp:TokenPositionSelector ;
