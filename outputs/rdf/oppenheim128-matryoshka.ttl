opp:unit_fol_102r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_102r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ומי יודע כשר דבר שפשר דבריתירה לישראל חכמת אדם תאיר פניו ר מני דשאב ור יהושע דסכני בשם ר לו יאמ על כל דבר ודבר שהיה הקבה אומר למשת היה אומ לו טהרתו וטומאתו וכיון שהגיע לפרשת אמוראל הכהנים אמ לפני הקבה רבונו של עולם אם נטמא במה טהרתו ולא השיבו באותה שעה נתכדכמי פניו של משה ההד ועח פניו ישנא וכיון שהגיע לפרשה הזאת של פרה אמ לו הקבה משה אותה האמירה שאמרתי לך ולא השיביתיך והיא פרשת אמיר אל הכהנים ואמ לפני רבונו שלעולם אם נטמא במה היא טהרתו אלא זו היא טהרתו שנ ולקחו לטמא מעפר"@he ;
    oa:hasSelector opp:unit_fol_102r_1_u1_selector ;
    oa:hasSource opp:passage_fol_102r_1 .

