    rdf:value "אמ ר אחא דברים שא נגלו למשה נגלו לר עקיבא וחביריו שנ וכל יקר ראתה עינו זה ר עקיבא אמ ר יוסי בר חנינא רמזו שכל הפרות בטלות ושלך קיימת אמ ר אחא בשם ר יוסי בר חנינא בשעה שעלה משה למרום שמיג קולו של הקבה יושב ועוסק בפרשת פרה אדמה ואומר הלכה בשם אומרה ר אליעזר אומ עגלה בת שנתה ופרה בת שנתים אמ לפניו רבונו של עולם העליונים והתחתונים ברשותך ואתה אומ הלכה משמו של בשר ודם אמ לו הקבה צדיק אחד עתיד לעמוד בעולמי ועתיד לפתוח בפרשת פרה תחלה ר אליעזר אומ עגלה בת שנתה ופרה בת שתים אמ לפניו רבון העולם יהיר צון מלפניך שיהא מחלצי אמ לו חייך שהוא מחלציך ההד יושם האחד אליעזר ושם אותו המיוחד לאלינסר תמן תנינן אבא שאל אומ ככא ופכה כהנים דולים עושין אנתו משל עצמן ולא היה אחד מהם מוביא פרתו בכבשו שלחבירו אלא סותרו וחוזר ובונה אותו משלו ר אחא אמ בשם ר חנינא יותר מס ככר זהב היה מוציא עליו שיחוצים היו דהא הני שמעון הצדיק עשה שתיפרות ולא בכבש שהוציא את הראשונה הוציא את השניה"@he ;
    oa:hasSelector opp:unit_fol_103r_1_u1_selector ;
    oa:hasSource opp:passage_fol_103r_1 .

opp:unit_fol_103v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_103v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma_Buber ;
    opp:earliestWitness opp:work_Midrash_Tanchuma_Buber ;
    rdf:value "אית לך למימר על אותו הצדיק שהיה שחוץ ר אבין אמ בשם ר אליעזר ששאלו גוי ואמ לו מה שאתם עושים נראין כמן כשפים מביאין אתם פרה ושורפין אותה וכותשין אותה ונוטלין את אפרה ואחד מכם מטמא למת ומזים עליו ב אוג טפים ואומרים לו טהרת אמ לו נכנסה בך רוח תזזית מימיך אמ לו הן אמ ומה הייתם עושין אמ לו מביאין עקרים ומינשנין תחתיו ומרביצין עליו מים והיא בורחת אמ לו ישמעו אזניך מה פיך מדברת כך החחהזה רוח טומאה ההד וגם אתרוח הטומאה אעביר מן הארץ כיון שיצא אמרו לו תלמידיו לזה דחית בקנה לנו מה אתה אומ אמ להם חייכם לא המת מטמא ולא המים מטהרין אלא גזירתו של מלך מלכי המלכים הקבה הוא אמ הקבה גזירה גזרתי חקה חקקתי ואין אתה רשאי לעבות על גזירתי שנ זאת חקת התורה מפני מת כל הקרביות באים זכדים וזו באה נקבה אמ ר איבו משל לבן שפחה שטינף פלטין של מלך אמ המלך תבא אמו ותקום צואת בנה שבחיקו כך אמ הקבה תבא פרה ותבפר על מעש העגל"@he ;
    oa:hasSelector opp:unit_fol_103v_1_u1_selector ;
    oa:hasSource opp:passage_fol_103v_1 .

opp:unit_fol_105v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_105v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "עשן מלכיות מנין שנ והנה אימה חשכה אמ לי הקבה לאברהם כל זמן שבניך מתעסקין בתורה ובקרבנות לא ישתעברו במלכיות אבל הם עפידים לבטל את התויה ואת הקרבנות במה אתה רוצה שירדו בניך בגיהנם או ישתינב במלכיוה ר חיננא ברפפא אמ אברהם בירר לו את המלכיות שנ אם לא כי צורם ויי הסגירם ואין צותם אלא אברהם שנ הביטו אל צור חצבתם ויי הסגירם שהסר ים הקבה עמו אמ ר ברכיה בשם ר ליי כל איהו היום היה אבינואברהם ותמיה בלבו אי זה מהם ישרוב או נהנם או מלכיות שזו ישר יזו קשה מט הט אדיזהם ער מצי אתה יושב ותמיה בלבך פסוק הדא מליי ה ימן לכך ההד ביום ההוא כית יי את אברם ברית לאמר מהו לאמר אמ ר חננא בר פכא אברי בירר לו את המלכיות שנ בזנו בחש ובמים ורוציאנו לרו באו למחלהת ר יודן ור ימא בי חנינא אמ יקן אזד בשה ד יהקוזה שררלו אתי המלריות ומרייטעימיה ארצ בית אר וש לרישנו ארב נת אימיא על דראשנא שנ לינו באש"@he ;
    oa:hasSelector opp:unit_fol_105v_1_u1_selector ;
    oa:hasSource opp:passage_fol_105v_1 .

opp:unit_fol_106r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_106r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "תאוה יבל תאיתו לא היה אדם רואה ל היה מתאוה ועכשו בין הויה ביזשאינו רואה מתאוה אמ ר אבא בר יידן בשם ר אחח דמן לכד גמטויויגר ילמפרשי ימים שיהו נזכרים ובאים במהרה לבתיהם אמ ר סימין כל נפלאים ומחשבות שחשבת כדי שלא יקבלו אומות העולם את הורתך וכברגלוי וידוע לפניך שאי ז אימית הינולם מהו לין את תורתך וליצה נראית כמחו עליהם בשביל לככונ לנו מתן שכרנו דאמ ר סימון כל חשבוניך אלינו כל אותן שני אלפים וארבע מחות ומח שנה עד שלא יצחו ישראל ממצרים שהיהה הקבה יושב ומחשב חשבונות מעבר עבורים ומקדש ית השנים ומחדש את החדשים וכיון שיצאו ישראל מנמ ממציים יצסרן להם ההר החדיש הזה ככם ראש חדשים באר מצרים לזמת מהו לאינר המ להם מכאן ואילך הרי הן מסורין לם ההד החדש הזה לנם ראש אדשים ר חייא בר אכאכ צא תוקלת ממושכה מחלה לד זה שהוא"@he ;
    oa:hasSelector opp:unit_fol_106r_1_u1_selector ;
    oa:hasSource opp:passage_fol_106r_1 .

opp:unit_fol_107v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_107v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דא שלח אורך ואמתך המה ילחוני אורך ואמתך זה משה ואהרן שעל ידיהם שלח הקבה חורה ל שראל ונגאלו ממצרים אימתי בחדש הזה ההד החדש הזה לכם ראש חדשים ר לוי פתח והייתם לי קדושים כי קדוש אני יי כמי שהוא בורד את היפה מתיך הפסולת וחוזר ובורר אבל כשהוא בורר את הרע מתוך היפה בורד לו ושוב אינו בורר אמ ר לוי בכל מעשיהם ישראל משונים מאומות העולם בחרישתם ובזריעתם ובקצירתם ובעמורם ובדישתם ובגרניהם וביקביהם ובמנינם ובחשבונם בחרישתם שנ לא תחרש בשור ובחמור יחדו ובזריעתם לא תזרע כרמך כלאים ובקצירתם שנ ולקט קבירך לא תלקט ובעמורן שנ ושכחת עמר בשדה ובדישתן שנאמ לא תחסם שר בדישו ובגרניהן וביקביהן שנ הענק תעניק לו מצאנך מגרנך ומיקבך ובמליינן ובחשבונן שיחו אמות העולם מונין לחמה וישראל מונין ללבנה ההד האדש הזה לכם ראש חדשים אני ישנה ולביער חול קול דודי דוכק אמרה רנסתישראל לפני ההבה רבונו של עולם אני ישנה מבית המקדש ולבי ער בבתי כנסיות ובבתי מדדשות אני ישנה מן הקרבנות ולבי ער במצות וצדקות אני ישנה מן המצות ולבי עד לישותן דא חני ישנת מן הקץ ולבי ער לגאולה"@he ;
    oa:hasSelector opp:unit_fol_107v_1_u1_selector ;
    oa:hasSource opp:passage_fol_107v_1 .

opp:unit_fol_110r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_110r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אשרי המחכה ויגיעי כימים אלף שנש מאות שלשים וחמשה אלין מיתליא דהכא מן אנון אלו מה יום שמלך המשיח נגלה להם וחוזר ונכסה מהם והיכן הוא מוליכן אית דאמרי למדבר יהודה ואית דאמרי למדבר סיחון ועוגההד לכן הצה חנכי מפתיה והולכתיה המדבר מי שהוא מאמין אוכל מלוחים ושתש רתמים וחיה ההד הקטפים מלוח עלי נאיח ושרש רתמים לחמם ומי שאינו מאמין בו והולך לו אצל אומות העולם הם הורגין אותו אמ ר יצחק בר מריון לסוף מה יום הקבה נגלה להם ויוריד להם המן למא והכת אין כל חדש תחת השמש מאי טעמיה אנכי יי ילהיך המעלך מיורץ מצרים ואומ עוד אושיבך באהלים כימי מועד ענה דודי ואמר לי קומי לך רעיתי יפתי ולכי לך אמ ר עזריה לא היא עניה ולא היא אמירה ארא ענה לי עלידי משה ואמ לי על ידי אהרן ומה"@he ;
    oa:hasSelector opp:unit_fol_110r_1_u1_selector ;
    oa:hasSource opp:passage_fol_110r_1 .

opp:unit_fol_110v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_110v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והגחנים סמדר נתנוריח אלו הנשארים שעשו תשובה ונתקבש אמ נהם מאם כל הדן רירא נינא איה בכון ואכן תביגו הכא קומי לך רעיתי יפתי ולכילך דרא ענה דודי ו אמר עזריה לא היא עניה ולא היא אמירה אלא ענה לי על ידי יהוש ואמר לי על ידי אלעזר ומה אמ לי קומילך יפתי כעיתי יפתי כי הנה הסתו עבר אלו מ שנה שעשו ישראל במדבר הגשם חלם הלך לו אלו לא שנה שהיה כעם על ישראל הנצנים נראו בארץ אלו המדגלים שנ נשיא אחד נשיא אחד לנחול את הארץ עת הזמירהגיע הגיע זמנה של ערלה שתזמר הגיע זמום של כנענים שיזמרו הגיע זמנה שלארץ ישראל שתחלק שנ לאלה תחלתך הארץ בנחלה וקול התור נשמע בארצנו אמ ר יוחנן קול תייר טב נשמע בארצנו זה יהושע שנ ויצו יהושע את שוטרי העם לאמר התאנה חנטה פגיה אלו סלי בכורים ותגפנים סמדר נתנוריח אלו הנסכים דא ענה דודי ואמר לי אמ ר עזריה לא היא עניה ולא היא אמירה אלא ענה לי על ידי דניאל ואמר לי על ידי עזרא מה אמר לי קומי לך רעיתי יפתי ולכי לך"@he ;
    oa:hasSelector opp:unit_fol_110v_2_u1_selector ;
    oa:hasSource opp:passage_fol_110v_2 .

opp:unit_fol_111v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_111v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אלא ענה לי דודי על ידי אליהו ואמר לי על ידי מלך המשיח ומה אמר לי קומי לך רעיתי יפתי ולכילם כי הנה הסתו עבר אמ ר עזריה זו מלכות הרשעה שהיא מסהה הבריות כדא כי יסיתך אחיך בן אמך הגשם חלף הלך לו זה מן השעבוד הנצנים נראו בארץ אמר יצחק כת ויראני יי ארבעה חרשים אלי הן אניהו ומלף המשיח ומלכי צדק ומשוח מלחמה הג עת הר הגיע הגיע זמנה של ערלה שתזמר הגיע זמנן של רשעים שישברו שנ שבד יי מטה רשעים הגיע זמנה של מלכות הרשעה הזאת שתעקר מן העולם הגיע זמנה של מלכות שמים שנת גלה שנ והיה יי למלך על כל הארץ ביום ההוא יהיה יי אחד ושמו אחד וקול התור נשמע בארצנו אמ ר יוחנן קלתייר טב נשמע בארצנו זה קולו שלמלך המשיח שנמה נאו על ההרים רגלי מכשר התאה התאנה קנטה פגיה אמר חייא בר אבא סמוך לימות המשיח דבר גדול בא והרשעים כלים בו והגפנים סמדר נתנו ריח אלו הנשארים שנ והיה הנשאר בציון והנותר בידושלם קדוש יאמר לו רבנן אמ שבוע שבן דוד בא בו שנה ראשונה והמ והמטרתי על עיד אחת ועל עיר אחת לא אמטיר"@he ;
    oa:hasSelector opp:unit_fol_111v_1_u1_selector ;
    oa:hasSource opp:passage_fol_111v_1 .

opp:unit_fol_114v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_114v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אלם אף הכא כתו ויענו כל העם יחדו מה כתוב לעתיד לבא אז ידלג כאיל פסח אף הכא ויוצא משה את העם לקראת האלהים מן המחנה דברו אל כל עדת בני ישראל אמ ר יוחנן והלא אינו יפה אלא מדידן ואת אמר מבעשור אלא מלמד שהיו קשורין לכרעי מטותיהם של ישראל מבעשור והיו המצריים נכנסין ורואין אותם ונפשם פורחת מעליהם ר חייא בר יהודה דיפו אמ משכו וקחו לכם צאן למשפחותינם ושחטו הפסח שיהא כל אחר ואחד מכם מושך אלוהו של מצה מצריושוחטולפניו והוא גרשה לש פיה למלם אמר חלבו בשם ר יוחנן הכא את אמר בעשור לקדש הזה ולהלן אמ והעם עלו מן הירדן בעשור לחדש הזה אמ ר אחה בשם ר יוחנן לקיחתו עמדה להם בירדן ואכילתו עמדה להם בימי המן שנ ואכלו את הבשר בלילה הזה ואומ בלילה ההוא נד דה שנת המלך אמ ר ברכיה בשםר אבהו דרשר נחום בר סימאי בטרסיס ויקחו להם איש שה לבית אבות איש זה הקבה שנ יי איש מלחמה"@he ;
    oa:hasSelector opp:unit_fol_114v_1_u1_selector ;
    oa:hasSource opp:passage_fol_114v_1 .

opp:unit_fol_119r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_119r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הכניסו לו התבשיל השני ואכלו והיה ערב לו התחיל ממחה בקערה ר אמ חורי אמ ר אבין משל למלך שהיה מהלך בדרך והגיע לבורגנין הראשון ואבל שם ושתה שם הגיע לבורגנין השני ואכל שם ושתה שם ולן שם כך למה הוא מתני על העולה ואת העולה היא העולה אלא מלמד שהעולה כלה כליל בית שמאי אומ כבשים שהם כובשים עונותיהן של ישראל כדא ישוב ירחמנו יכבוש עונותינו ובית הלל אומ כל דבר שהוא נכבש צ סופו לצוף אלא מהו כבשים שהם מכבסים עונותיהם של ישראל כדא אם יהיו חטאיכם כשנים כשלג ילבינו בן עזאי אומ כבשים בני שנה שהן מכבסין את עונותיהם של ישראל ועשין אותן כתינוק בן שנתו שנים ליום בגכל היום שנים ליום בגלל הלחם שנים ליום י פרקליטי לאותו היום שנ בו והיו לי אמר יי צבאי ליום אשר אני נסשה סגלה שנים ליום ישהם נשחטים לאנ היום שנים ליום שהוא יודע איזה נשחט בשחרית ואי זה נשחט בין הערבים עליב תמיד אמ ר יהודה בר סימון מעורם לא לן אדם בירושלם ובידו עון כאי זה צד תמיד של שחר היה מכפר על עבירות שנעשו ביום מכל מקום לא לן אדם בירושלם ובידו עון מאי טעמיה צדק ילין בה"@he ;
    oa:hasSelector opp:unit_fol_119r_1_u1_selector ;
    oa:hasSource opp:passage_fol_119r_1 .

opp:unit_fol_121r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_121r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר יהושע בר נחמיה שמע לה מן הדא גם חשך לא יחשיך ממך ולילה כיום יאיר כחשכה כאורה חשכה שהיא אורה לפני ולילה לתשמישן שלבריות היו בה ביום מתו בכוריה של מצרים האכיצד לקו מכת מיתה מבערב והיו מפרפרים כל הלילה ומתו ביום מאי טעמא כלר כלנו מתנו אין כת כאן אלא כלנו מתים מיתין ואזלין הכא את אמ בים הכותי כל בכור בארץ מצרים ולהלן הוא אומ הקדשתי אותם לי אמור מיגתה בו ביום שמתו בכוריהם של מצרים הקדשתי לי כל בכור בארץ מצרים ויי הכה כל בכור כל בכור בכר לאיש בכור לאשה בכור לזכר י בכור לנקבה הא כיצד איש אחדבא על עשר נשיםוהן יולדות עשרה בנים נמצאו כלם ברורינשים עשרה אנשים באים על אשה והיא יולדת עשרה בנים נמצאו כלם בכורי אנשים הגע עצמך שאין שםבכוד לא לאיש לא לאשה ולא לזכר ולאלנקבה והא מה אני מקיים כיחין בית אשי אין שם מת אמ ר אבא בראחא אפטרופום שלבית היה מת כדא שמה הראש כי לא היה בכור וישימהו אביהו לראש תניא בשם ר נתן ביום שהיה בכורו של אחד מהם מת היו צרין איקונין שלו בכותל בביתו ואותו היום היה נדוקת ונדחקת וטרית והיה זה קשה עליהם כאלו אותו מת"@he ;
    oa:hasSelector opp:unit_fol_121r_1_u1_selector ;
    oa:hasSource opp:passage_fol_121r_1 .

opp:unit_fol_121v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_121v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר יודן לפי שהיו המצרים קוברין בתוך בתיהן והיו הכלבים נכנסין דרך הביבין ומשמלוין את הבכודות מבין המתים ומתעתעים בהם והיה קשה עליחם כאלו אותו היום קברום מבכור פרעה מלמד שפרעה היה בכור נתכנסו כל הבכורות אצל אבותיהם ואמרו להם בשביל דאמ משה ומת כל בכור וכל מאן דאמ על אלין עכא אתא עליהון אלא יצא יולין ויפקון אלין עבראי מן בינלא ואי לא אזלין עמא מייתין אמרו עשרה בנים לאחד ממנו ומודון בחד מנהון ולא תקום עד דאלין עבראי אמ כל סמא זמלתא ניזיל לן גביפרעה דהוא בוכרא ודלמא הוא חיים על נפשיה ומפיק אלין עבראי מביננא הלכו ליים אצל פרעה ואמרו לו בגין דאמ משה ומת כל בכור בארץ מצרים וכל דאן מה דאמר על אלין עמא אתא עליהון וכדאי קום ואפיק אלין עבראי מבינן ואי לא יזלון מייתן כלהון בוכריא אמפרעה לעבדיוי צאו וקפחו שוקיהם אנא אמר אינפשא חיננשרן דאנן ענחי וימן ימרן יוליו עביאי מבי עבראימבינן מיד יצאו הבכורות והרגו באבותיהם ששים רבוא ר אבין בשם ר יהודה בן פזי אמ בתיה בת כרעה בכורה היתה ובזכות מה ניצלה מצלתושלמ בתפלתו שנ משה שנ לאיכבה בכין בליכנרה בליל כתו כדא לים שמורים הוא ליי"@he ;
    oa:hasSelector opp:unit_fol_121v_1_u1_selector ;
    oa:hasSource opp:passage_fol_121v_1 .

opp:unit_fol_124r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_124r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה יתרון לאדם בכל עמלו שיעמל תחת השמש אמ ר יודן תחת השמש הוא דאין לו למעלה מן השמש יש לו ר הונא ור אחא בשם ר חלפאי אומ עמל הוא תחת השמש ואוצר ישלו למעלה מן השמש ר לי ורבנן ר לוי אמ כל מה שהבריות מגדלין מצית ומעשים טובים בעולם הזה דיין שהקבה יזריח להם את השמש שנ וזכח השמש ובא השמש ורבנן אמ כל מה שהצדיקים מגדלין מצות ומעשים טובים בעולם הזה דיין שהקבה יחדש ויאיר את פניהם כגלגל חמה שנ ואוהביו כצאת השמש בגבורתו אמר ינאי בנוהג שבעולם אדם לוקח לו ליטרא של בשר כמה הוא יגע בה כמה צער הוא מצטער עליה עד שיבשלנה וקבריות ישנים על מטותיהם והקבה משיב רוחות מעלה עננים ומוריד גשמים ומפריח טללים ומגדל צמחים ומדשן פירות ואין אתה נותן לו את העמר אמ ר פנחס בנוהג שבעולם אום מכבס את כסותו בימות תגשמים כמה הוא יגע בה כמה צער הוא מצטעד עליה עד שלא ינגבה והבריות ישנים והקבה משיב רוחות וכו ומנדל צמחים ומדשן פירות ואין זתה נותן לו את"@he ;
    oa:hasSelector opp:unit_fol_124r_1_u1_selector ;
    oa:hasSource opp:passage_fol_124r_1 .

opp:unit_fol_126r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_126r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ור שמעה בן לקיש אמ לעולם לא תהא מצות העמר קלה בעיניך שעל ידימצות העמר זכה אבינו אברינ לירש את ארץ כנען ההד ונתתילו ולזיניו איריך את ארץ מגוריך את כד ארץ כיעז לאחזת יילם על מנת וזתה את ברייתי תשמל ואיחו זו מצותה עומר ר אבהו ימ לה יהושוג בזרוי ור שמואה בר נחמני ורבנז ר יהישע בן ליי אמ לעולס לא יגהיה מצות העמר קלהי בעיניך שהיא ריי שעמדה ליום בימי גדעון שנ ויכא גדפו והנה איש מספר לרעהו חילום ויזמר הנריחלום חכמתיי הנה צליל לחם שעורים מתהויך במזנה עדיז ויבא עד ואהל ויכהו מהו צליל ליזם שעורים ורבין זמייי על שצלל עריהם ארמו הדיר מן הצריקים ובזרות מהניטילו בזני ית נימר רישנווריה אמ י שמואל די ניימא היא שע דה סהם בימי יוזיייה שנ והיה כנ ייווזוז מידהידהבה ושר יניה יי עליו יייהיים יבהו יידת נר יידות יצנושה נליר יי ייייייי שלתדאשיה זדתו ידיור הויאו זומצות העומר שנ והנים הכהן ורבנן אמרי היא נשנאמר להם בימי"@he ;
    oa:hasSelector opp:unit_fol_126r_1_u1_selector ;
    oa:hasSource opp:passage_fol_126r_1 .

opp:unit_fol_126v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_126v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מהו ללחם ר חמא בר חנינא חמ רבה בה שעורים שמואל בר נחיב ימ דברים שהם מריצין אה בני מיתן ר ישמואל אמ קמן אמרין עבדין מנה חהיה לריהא ולא טרימא מטרונהה אחת שאלה אתר יוחי בן חלפתא אמ לו כמה צער נצטער או יוה דיק כמה ירבדם רמה שפחות יש לי והן מבזבזין במאכל ובונזקה אמלה להודיער שבכל מקום שישראל בצער הנדיקירי עימגיהם בצער ור לוי אמ היא שעמדה להני בימי המז אותהי מוצא ניוז שראה מידני המז בהלר זתו וזכונם בויי חרנ מר רכי דומיה שרישע הזה בא להריני זאמ לתני מידיו ברחו ככם כד שי יתבוו ביחלתי נרול בין נחי בין במות אנח מוה רייה נתבט בטליתו ועמ וט להיתפלו מ ההוה ישיעא ויוי ליה גביה אמ להו במחי ע חקיתו אמרו ליה צמנות העומרי שהיו ישראל יוחריב וכביינה ש"@he ;
    oa:hasSelector opp:unit_fol_126v_1_u1_selector ;
    oa:hasSource opp:passage_fol_126v_1 .

opp:unit_fol_130v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_130v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "היו דומים לטכסים של מלכים ואו ראו מה שלחנו מארצנו וכא נחם אלהים ולא נהום בדרך הארץ אמר ליי בשם ר חמא בר חנינא אמ בה תמני שטין דרך המים שבאים מלמעלה והלאם מלמטה ברםהבא המים מלמטה והלחם מלמעלה שנ הנני ממטיר לכם לחם מן השמים והמים מלמטה שנ אחישיר ישראל עלי באר ענו לה דרך הארץ תלמיד טוען את הפנאם ומהלך לפני הרב ברם הכא לא ימיש עמוד הענן דדך הארץ תלמיד מהלוך תחלה והרב מהלך אחריו ברם הכא שנ וי הולך לפניהם יומם דרך הארץ תלמיד מרחץ אתהרב בום הנא וארחצך במים ואשטף דמיך דרך הארץ תלמיד מלביש את הרב ברם הכא ואר חצך במים וארלבישך רקמה ר סימאי אמ כורפירון י תרגם עקילם פילאקטון דרך הארץ תלמיד מיעיל את הרב ברם הכא ואנעלך תאש דרך הארץ תלמד טועזן את הרב ברם הכא ואשא אתכם על בנפי ושרים דרך הארץ הרב ישן והתלמיד על גבו ברם הכא הנה לא ינום ולא יישן שומר ישראל"@he ;
    oa:hasSelector opp:unit_fol_130v_1_u1_selector ;
    oa:hasSource opp:passage_fol_130v_1 .

opp:unit_fol_141r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_141r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Jerusalem_Talmud ;
    rdf:value "אמ ר זעירא בא וראה מה חצויפה היא ארץ ישראל שהיא עושה פירות גדולה תדין אמוראין חד אמ שהם מזבלים אותה וחרנה אמ שהן הופכין את עפרה בהדין רמה עיר סאתה מה דלעיל בחתליה לידע מה דלרע סליק ליה נרובדא הוה בחד בר נש והוה קים רדה בהדא בקעאתא דארבל ועשק סכתא ונפק חדא עפרא יקידא ואוקיד זרעיה אמ ר חיגנא בר פפא א מאות מיני דגים טהורים ושמנה מאות מיני חגבים ולעופות אין מספר וכלם גלו עם ישראל בבבל וכשחזרו כלם חזרו עמהם חוץ מן הדג הנקרא שיבוטא ודגים היאך גלו ר הונא בשם ר יוסף אמ דרך התהום חזרו"@he ;
    oa:hasSelector opp:unit_fol_141r_1_u1_selector ;
    oa:hasSource opp:passage_fol_141r_1 .

opp:unit_fol_141v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_141v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מכרובים לשער הקדמוני שנ וישאו הכרובים את כנפיהם וירמו מן הארץ משער הקדמוני לחצר שנא והחצר מלאה את נוגה כבוד יי מן החצר למזברו שנ ראיתי את יי כצב על המזבח ומן המזבח לגג שנ טוב שבת עד פנת גג ומן הגנ לחומה שנראיתי את יי נצב על חומת אנך ומן החומה לעיר שנקול יי לעיר יקרא ותושיה יראה שמך ומן העיר כהר שנ ויעל כבוד יי מעל העיר ויעמד על ההר אמ ר יונתן שלש שנים ומחצה עשקה שכינה שרויה בהר הזתים ומכר זתג פעמים בכל יום ואומרת שובו בנים שובבים וכיון שלאחזרו התחילה השכינה פורחת באויר ואומ הפסוק הזה אלך ואשובה אל מקומי דא למה נקרא שמו ירמיה שבימיו נעשה בית ארימקן דא שבימיו נתרוממה מדת הדין בן חלקיהו אמ ר יהודה בר סימון ארבעה הם שהם באים ממשפחת נטיה ולו הן פנחס ואוריה ויחזקאל וירמיה פנחס אתה מוצא"@he ;
    oa:hasSelector opp:unit_fol_141v_1_u1_selector ;
    oa:hasSource opp:passage_fol_141v_1 .

