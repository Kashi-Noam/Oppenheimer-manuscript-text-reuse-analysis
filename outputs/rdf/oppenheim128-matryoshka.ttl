    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מאחוריו אמ ר אחא כהדין קתדרין דברושא וידותמ ה ומזה עד מקום השבר הא כיצד שרביט של ותב בו מאחריו ויונה בראשו ועטרה של זהב בפי ונד יהוא ושב תחתיה בשבת שש כנגד ורק עיר והלא הן אמ ר אנין הן די נלכא שרי"@he ;
