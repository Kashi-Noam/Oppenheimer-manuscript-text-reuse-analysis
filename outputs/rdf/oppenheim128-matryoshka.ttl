opp:unit_fol_10v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_10v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "הוא היה אומ הגדע והבורסקי והבנאי אין מעמידין מהם פרנס על הצבור ואין מעמידין מהם אפטרופא הוא היה אומ יושבי כפרים והולכי מדברות ז חייהם אינן חיים וממונם אינו שלהם ובניהם אינו שלהם ארבע פרוטות אין בהם סימן ברכה לעולם ואל הן שכר כותבין שכר מתורגמנין ושכר הבא ממדינת הים נוהנ ושא אשה לשום כתבה שאין מורישין לבניהם ולבני בניהם יש נושא אשה לשום זלנת וישנו שא אשה לישום ממון ויש נושא אשה לשום גדולה ויש נושא אסה לשום שמים הנ ושא אשה לשום זנות עליו הכת אומ ביי בגדו כי בנים זכים ילדו הנושא אשה לשום ממון עליו הכת אומ עתה יאכלם חדש את חלקיהם חהש נכנם וחדש יוצא וממונם כלהי הנושח אשה לשום גדולה לסוג שמורידח אותו מגדולתו הנושאאשה לשום שמים סוף שיוצאין ממנו בנים שמושיעין את ישראל ע הדר אלהים בני אדם הדר בני אדם כסותן הדר תורה חכמה הדר זקנה שיבה הדר בחורים יראת חטא הדר עם הארץ מארה קרא ולא שנה הרי זה בור שנה ולא קרא עם הארץ הרא ושנה ולא פירש חכם קרא ושנה ופירשנבון לא קרא ולא שנה נוח לו שלא"@he ;
    oa:hasSelector opp:unit_fol_10v_1_u1_selector ;
    oa:hasSource opp:passage_fol_10v_1 .

