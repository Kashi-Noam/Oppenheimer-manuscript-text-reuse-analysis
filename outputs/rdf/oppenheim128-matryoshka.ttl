opp:unit_fol_49v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_49v_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "כד שמע יואב לדוד דאמ כן תמה ואמ כלים אבא מרחם על בנוי טפי מאמהון והלא ם אמא רחמא עליהון סגי דהיא מצטייפא על הון בעבורה ועל מתברא והיא מרבייה להון בביתא והוא מר לן לא מר יאות איזיל ואחמי מה ברייתא דבריין ואידע אם מר קושטא עטר בכל תחום ישראל לחכה כלא כן מטא לחד אתר ואתאכסן גבחד גבר סד מכוכן דהוו ליה תרין עשר בנין וההוא גברא טריד כל יומא בעבידתיה בדברא ולעידן רמשא הוה הני מאגריה לחמא והוה זיין גרמיה ואנתתיה ובנוי בדוחקא ואענ דהוה סב ומסכן לא שביק לבנוי למיניל בעבידתיה אלא הוא טרח עליהון וזיין להון וכך הוה ינביד כל ליליא הוה פריס ללחמא אר בסר ביצועין והור יהיב לכל חד וחד פרוסתיה ולאנתיה פרוסתא יזדא והוא היה חתי לחדא כד חמא יואב שרי תמה אמ לית"@he ;
    oa:hasSelector opp:unit_fol_49v_1_u1_selector ;
    oa:hasSource opp:passage_fol_49v_1 .

opp:unit_fol_49v_1_u1_selector a opp:TokenPositionSelector ;
