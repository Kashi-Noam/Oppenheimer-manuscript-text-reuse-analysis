opp:unit_fol_112r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_112r_1#u1" ;
    opp:closestWitness opp:work_Shir_HaShirim_Rabbah ;
    opp:earliestWitness opp:work_Shir_HaShirim_Rabbah ;
    rdf:value "שניה חבי רעב משתלחין בשלישית רעב גדול ומתים בו אנשים ונשים וטם והתורה משתכחת מישראל ברביעית רעב לא רעב ולא שובע בחמשית שבע גדול אוכלים ושותים ושמחים והתורה חוזרת לישנה ולחדושה בששית קולות בשביעי מלחמות במיצאי שביעית בןדוד בא בו אמ אביי כמאן שבועין אתון כהדא ולא אתתן אתיא אלא כי האי דאמ ר יוחנן דור שבן דודבא בו תלמידי חכמים מתים והנשארים עיניהם כלות ביגון ובאנחה וצרות רבות ורעות על הצבור וגזרות קשות מתחדשות עד שהראשונה קיימת באה האחי ואסמכה ליה אמ ר אבין דור שבן דוד בא בו בית ועד יהיה לזנות והגליל יחרב ואנשי הגליל יסובבו מעיר לעד ולא יתחוננו אנשיאמת וחסד נאספים והאמת נעדרת והולכת לה והיכן היא הולכת לה דביר ינאי אמרי הונלכת ויושבי עדרים עדרים במדבר כדא ותהי האמת נעדרת וסר מרע משתולל אמ ר נהוראי דוד שבן דוד בא"@he ;
    oa:hasSelector opp:unit_fol_112r_1_u1_selector ;
    oa:hasSource opp:passage_fol_112r_1 .

