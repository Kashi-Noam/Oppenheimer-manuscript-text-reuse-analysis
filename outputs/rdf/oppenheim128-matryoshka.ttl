opp:unit_fol_125v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_125v_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "ובאיזה זכות זכו ישראל לירש את ארץ בנען הוי אימ בזכות מצית העמר לפיכך משה מזהיר אתישמ ואומ להם והבאתם את עמר ראשית קצירכם אל הכהן וכן הניף את העמר לפני יי לרבונכם וכאי זה בד היה מליפו ר חמא בר עוקבא אמ בשם ר יוסי בר חנינא מיליך ומביא מעלה ומוריד מוליך ומביא לבטל טללים רעים מעלה ומוריד כדי לעצור טללים רעים רסימא בשם ר יהושע בן לוי אמ מוליך ומביא למי שהרוחות שלו מעלה ומוריד למי שהעליונים והתחתו שלו ר אבין אמ ור יהודה ור כחמיה היא ר יעקב בר אביי בשם ר יהודה בר כמין ור יוחנן ור שמעון בן לקיש ר יוחנן אמ לעולם אל תהי מצות הניומר קלה בעיניך שעל ידי מצוה העומר ענישה הקבה שלום בן איש לאשתו ההד והביא האיש את אשתו אלהבהן והכיא את קרבנה עליה עשירית האיפה קמח שעורים ואיזו זו מצות העומר"@he ;
    oa:hasSelector opp:unit_fol_125v_1_u2_selector ;
    oa:hasSource opp:passage_fol_125v_1 .

opp:unit_fol_125v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "180"^^xsd:nonNegativeInteger ;
    oa:start "38"^^xsd:nonNegativeInteger .

opp:unit_fol_125v_1_u3 a opp:TextUnit ;
    rdfs:label "fol_125v_1#u3" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_Rabbati ;
    rdf:value "זכו ישראל לירש את ארץ בנען הוי אימ בזכות מצית העמר לפיכך משה מזהיר אתישמ ואומ להם והבאתם את עמר ראשית קצירכם אל הכהן וכן הניף את העמר לפני יי לרבונכם וכאי זה בד היה מליפו ר חמא בר עוקבא אמ בשם ר יוסי בר חנינא מיליך ומביא מעלה ומוריד מוליך ומביא לבטל טללים רעים מעלה ומוריד כדי לעצור טללים רעים רסימא בשם ר יהושע בן לוי אמ מוליך ומביא למי שהרוחות שלו מעלה ומוריד למי שהעליונים והתחתו שלו ר אבין אמ ור יהודה ור כחמיה היא ר יעקב בר אביי בשם ר יהודה בר כמין ור יוחנן ור שמעון בן לקיש ר יוחנן אמ לעולם אל תהי מצות הניומר קלה בעיניך שעל ידי מצוה העומר"@he ;
    oa:hasSelector opp:unit_fol_125v_1_u3_selector ;
    oa:hasSource opp:passage_fol_125v_1 .

