opp:unit_fol_51v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_51v_1#u2" ;
    opp:closestWitness opp:work_Tractate_Kutim ;
    opp:earliestWitness opp:work_Tractate_Kutim ;
    rdf:value "ישראל שהיא מכשרת את הגרים האומר בארץ שראל גר אני מקבלין אותו מיד ובחוצה לארץ אין מקגלין אותו אלא אם כן היו עידיו עמו חביבה ארץ ישראל שהיא מכפרת את העונות ואת הפשעים שנאמ ובל יאמר שכן חליתי העם היושבים בה נשוא עון ונן אתה מוצא כארבעה כתים העומדים לפני המקום שנ זה יאמר ליי אנני וזה יקרא בשם יעקב וזה יכתוב ידו ליי ובשם ישראל יכנה זה יאמר ליי אני הוא כלו כלו למקום ולא נתערב בו שום חטא וזה יקרא בשם יעקב אלו גיריהצדק וזה יכתיב ליי אלו בעלי תשובה ובשם ישראל יכנה אלו יראישמים סליקא לה מסכת גרים תל מסכת כותיים בעה דרכי כותיים פעמים כגוים פעמים כישראל ורובי כישראל אין מביאין מהן לא קני זבות ולא קני יולדות לא חטאות ולא אשמות אין מקנין אותן במחובר לקרקע ואין מוכרין להם צמר לגזוז ולא תבואה לקצור ולא עצים מחוברין לקרקע אבל מוכרין להם עצים על מנת לקוץ אף מה שיקבצו מוכרין לטבח כותי בהמה לשאוט ר מאיר אמ אף מה שישחוט אין מוכרין להם בהמה גסה אעפ ששבורה ולא סייחין ולא עגלים אבל מוכרין להם שבורה שאינה יכולה להתרפאות"@he ;
    oa:hasSelector opp:unit_fol_51v_1_u2_selector ;
    oa:hasSource opp:passage_fol_51v_1 .

opp:unit_fol_51v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "184"^^xsd:nonNegativeInteger ;
    oa:start "2"^^xsd:nonNegativeInteger .

opp:unit_fol_52r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_52r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Kutim ;
    opp:earliestWitness opp:work_Tractate_Kutim ;
    rdf:value "מוכרין להם כלי זיין ולא כל דבר שיש בו נזק לרבים אין משיאין אותן ולא נושאין מהם נשים אבל מלוין אותם ולוין מהם ברבית נותנין להם לקט שכחה ופאה ויש עליהם לקט שכחה ופאה והם נאמנין על רלחט השנאה והכאה בשעתן ונל מנשאר עני בשעתו ופירותיהם טבל כפירות הגוים ואוסרים אה העירוב כגוים בת ישראל אינה מילדת את הכ ותי ולא מניקה את בנה אבל כותית מילדת בת ישראל ומניקה את בנה כרשותה ישראל מל את הכותי והכותי מל את ישראל ר יהודה אומ כותי לא ימול את ישראל שאין מוהלו אלא לשום הר גרזים מעמידין בהמה בפונדקי כותיים ושוכדין כותי שילך אחד בהמתו של ישראל ומוסר ישראל בהמתו לדועה בותי מוסר ישראל את בנו שילמדנו כותי אומנות ומתיחדים ומסתפרים עמהם בכל מקום מה שאין כן בגוים חולץ ליבמתו ונותן וט לאשתו ונאמן הכותי להביא גט ממדינת הים לישראל מה שאין"@he ;
    oa:hasSelector opp:unit_fol_52r_1_u1_selector ;
    oa:hasSource opp:passage_fol_52r_1 .

