opp:dataset a void:Dataset,
        dcat:Dataset ;
    dcterms:created "2026-11-02"^^xsd:date ;
    dcterms:description "צמתים: חיבורים (bf:Work) עם טענות תיארוך (טווח OWL-Time, אזור, מקור, ודאות). קשתות: יחידות טקסט משותפות. לכל זוג עדים ליחידה יש צומת השוואה עם התמיכה בשני המסלולים: ישן←אופנהיימר, וישן←חדש←אופנהיימר. ההכרעה מבטאת קרבה טקסטואלית ולא הוכחת העתקה. חיבורים מאוחרים לאופנהיימר מסומנים ואינם נפסלים; האזור הוא מידע בלבד."@he ;
    dcterms:license "לא נקבע – להשלים לפני פרסום" ;
    dcterms:title "מטריושקה של ציטוטים באופנהיימר 128: חיבורים, תיארוכים ויחידות טקסט משותפות"@he ;
    void:triples 46103 ;
    skos:note "הסתייגות: הנתונים מבוססים רק על מועמדים שדוח ACT החזיר (עד 30 לכל קטע), שקיבלו יישור מלא, ושעברו את הסף המשוכלל S ≥ 21.14 (דיוק 98% וכיסוי 86% על 487 זוגות מתויגים). היעדר עד אינו ראיה להיעדר הטקסט. נוסח כל חיבור הוא המהדורה שבספריא; קיצורי \"וכו'\" עשויים להיות של המדפיס. התיארוכים נאספו ממקורות זמינים (בעיקר Encyclopaedia Judaica וויקיפדיה האנגלית), לא מ\"מבוא למדרשים\" של רייזל."@he ;
    prov:wasGeneratedBy opp:activity_matryoshka_2026_11 .

