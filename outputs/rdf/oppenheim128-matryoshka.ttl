opp:unit_fol_46v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_46v_1#u2" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Otzar_Midrashim ;
    rdf:value "ושבט ראובן נגדם מאחורי הררי פארן וישביניהם שלום ושלוה ואקבה וביחד מלחמוקם וכריקות הדרכים שכורת בדרך מכות ודרך בבל וכל שללם יחלקו יחדו משא גמל מן מאכל יש אצלם בשני כספים ומדברם בלשון קדר ועמהם מקרא ומשנה ותלמוד והגדה וכל שבת ושבת דורשין בלשון קדש ומתרגמין בלשון קדר וש בכו אפרים וחצי שבט מנשה שם נגב מדינת מאקא יהם זעומי נפש וקהויי לב בעריסיסים יכרתו דרכים ולא יחוסו עלל אדם ואין להם ממון"@he ;
    oa:hasSelector opp:unit_fol_46v_1_u2_selector ;
    oa:hasSource opp:passage_fol_46v_1 .

opp:unit_fol_46v_1_u2_selector a opp:TokenPositionSelector ;
