    rdf:value "מנשמת אלוה יאבדו איבד הקבה את כלן במצריים אומ נשפת ברוחך כסמו ים שאגת אריה וק שחל אף כל הרשעים העתידים לעמוד כן יאבדם הקבה אמ לו איוב אם כן הסתכל בעשו אביך אמ לו אין לי עמו עסק שנ בן לא ישא בעון האב ההד ליש אובד מבלי טרף ובני לביא יתפרדו לו אלופיו אמ לו איוב ואת מה אמ לו ואלי דבר יגמב ותקח אזני גו אני נציא אני אין לי עסק עמו אכא להוכיחך בסעפים מחזיונות ההד בסעפים מחזיונות לילה"@he ;
    oa:hasSelector opp:unit_fol_29v_1_u1_selector ;
    oa:hasSource opp:passage_fol_29v_1 .

