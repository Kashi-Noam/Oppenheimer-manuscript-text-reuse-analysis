opp:WitnessSummary a owl:Class ;
    rdfs:label "Witness summary"@en,
        "סיכום עדות לאופנהיימר"@he ;
    rdfs:comment "קשת מסוכמת בין חיבור לאופנהיימר: מספר יחידות ובכמה מהן החיבור הוא העד הקרוב ביותר."@he .

opp:unit_fol_102v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_102v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati,
        opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אשת אח וכלאים ושעיר המשתלח ופרשת פיה אדמה אשת אחיו מנין שנ עדות אשת אחיך לא תגלה מת בלא בנים מותרת לו וכת בה חקה שנ ושמרתם אתם את חקתי וכו כלאים מנין שנ לא תלבש שעטנז צמר ופשתים יחדו סדין בציצית מותר וכת ביה חקה שנ את חקתי תשמרו ושעיר המשתלח מנין שנ והמשלח את השעיל הוא עצמו מכפר על אחרים וכת ביה חקה שנאמ והיתה זאת לכם לחקת עולם פרה אדומה מנין דתנינן דמן כל העיסקן בנרה מתילה ינד כום מנימו זבגייל בגדים והיא עצמה מטהרת טמאים וכת בה זאת חקית התורה ויקקו אליך ר לוליאני בר טביריס אמ בשם ר יצחק קאטריקי ור עזריה אמ ליה ר ינחק ור יוסי בר חנינא אמ אמ לו הקבה למשה לך אני מגלה טעמי פרה אבל לאחר חקה דאמ רב הונה כי אקח מועד אני מישרים אשפט והיה ביום ההוא לא יהיה אור יקרות וקפאון כתו דברים שהם מכוסים מכם בעולם הזה הם עתיד לה תפרסם לכם כהדין בוליס ההד והולכתי עורים בדרך לא ידעו אלה הדברם עשיתים ולא עזבתים אעשם אין כתי כאן אלא עשיתים כבד עשיתים לר ח עקיבא וחביריו"@he ;
    oa:hasSelector opp:unit_fol_102v_1_u1_selector ;
    oa:hasSource opp:passage_fol_102v_1 .

opp:unit_fol_116r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_116r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "זה שעל נף הנהר זיפשר לו שלא ישתה שנים או שלשה לינין מים ואנא על ליגא דחמרא כתבית דאנא שתי דאנא רוי דאנא שביע תני ר חייא בר מנשיא בשם ר שמעון בן לקיש אימרה לעכוב בהמה אחת מסרתי לך ולא הית יכול לעמיד בו ואיזוזו בהמות בהררי אלף אמ ר יוחנן ור יהושע בן לוי ורבנא ור יוחנן אמ בהמה אחת היא ורבוצה על אלף הרים ואלף הרים מגדלים לה מזונות והיא אוכלת ומאי טעמיה כי בול הרים ישאו לו ור יהושע בן לוי אמ בהמה אחת היא והיא רבוצה על אלף הרים ואלף הרים מגדלין לה כל מיני מאכל לאנילתם של צדיקים לעתיד לבא ומאי טעמי ה והיה השרון לנוה צאן ועמק עכור לרבן בקר לעמי דאשר דרשוני ורבנן אמרין בהמה אחת היא רבוצה על חלף הרים ואלף הרים מגדלים לה בהמות והיא אוכלת ומאי טעמיה וכל חית השרה שחחקו שם"@he ;
    oa:hasSelector opp:unit_fol_116r_2_u1_selector ;
    oa:hasSource opp:passage_fol_116r_2 .

opp:unit_fol_94r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_94r_2#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Midrash_Tanchuma ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ יזכר להם מה שעשוליו בבית המקדש שהוא נתון בחיקו של עולם כדאמ ר הונא ומחיק הארץ עד העזרה התחתונה שתים אמית ובא שמיאל הנביא וכרעה להם שנ וישסף שמואל את חוג לפני יי בולול מה עשה לו ר אבא בר כהנא אמ היה מחתך מבשרו זתים זתים ומאכיל לנעמיות ההד יאכל בדי עורו בירר לו מיתה מרה ורבנן אמרי העמיד קונטיסן ומתחו עליהם והיה אומר אכן סר מר המית כך ממיתים את השרים מיתות חמורות ומרות ר שמואל בר אבדימי אמ בדיני אומות העילם דנו לא בעדים ולא בהתראה אמ ר יצחק סרסו שנ ויאמר שמואל כאשר שכלה נשים חרבך אמו שלאותו האיש אמ ר לוי אף משה רמזה להם מן התורה שנאמ כי ינצו אנשים יחדו וקצתה את כפה מה כת תמן זכור את אשר עשה לך עמלק אמ ר ברכיה אתה אומר לנו זכור רבו העו אנו שכחה מצויה בנו אבל אתה שאין שכחה לפניך אתה זרור לו את אשר עשה לך אמ ר צחק ליו עשה לך לא עשה שנ זכור יי לבני אדום את יום ירושלם האומרים ערו ערו עד היסוד בה"@he ;
    oa:hasSelector opp:unit_fol_94r_2_u1_selector ;
    oa:hasSource opp:passage_fol_94r_2 .

