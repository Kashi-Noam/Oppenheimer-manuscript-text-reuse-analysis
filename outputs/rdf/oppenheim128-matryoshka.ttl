opp:unit_fol_150r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_150r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לה חס ושלום מן האמהות את נקמנית אין אתנתמנית מן האמהות והרי דברים קל וחומר מה אם בועז שדבר על לבה שלרות דברים טובים דברים נחימים נחמה כשיבא הקבה לנחמה את ירושלם על אחת כמה וכמה הוי נחמי נחמו דברתי אני עם כבי י לאמר י הלב יודע יהלב חאה הלב שומע הלב עומד י רת הלב נופל י הלב מה לד הלב צועק יהלב מכנה הלב שמח הלב רואה שנ ולביראה הרבה חכמה ודעת הלב מדבר שנ דברתי אני עם לבי י הלב יודע שנ לב יודע מרת נפשו הלב שומרו שנ ונתת לעבדך לב שומע הלב עומד שנ היעמד לבך הלב נוכל שנאמ אליפל לבידם עלו יהלב מהיך שלא ריאמר אליי לא לכי כלך הלב ביכם שנ בנם לבם אל י הלב שמאח שנא לכן שמח לבי ויגל כבודי הלב מסתער שנ ויסער לב מלך ארם הלב מתנחם שנ נחמי נחמו עמים דברו על לב ירושלם מה אעידך מה"@he ;
    oa:hasSelector opp:unit_fol_150r_1_u1_selector ;
    oa:hasSource opp:passage_fol_150r_1 .

