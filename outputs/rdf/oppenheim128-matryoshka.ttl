opp:unit_fol_149r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_149r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הוי אנחם מצרי ואנרמה מאויבי ר יהודה ור נחמיה ר יהודק אומ היה לאהם פשרה זקובים ואתה עוקף עליו ונוטלם ממנו אמהקבה עלי לשלום גמולו ולהפרע מאותו האיש ורב נחמן אמ הוי אנחם מצרי שתים ואנקמה מאויבי שתים אלו דמלתיות ואשיבה שופטיך כבראשונה זה משה ואהרן ויועציך כבתחלה זהד דוד ושלמה אחריכן יקרא לך עיר הצדק קריה נאמנה ציון במשפט תפדה ושביה בצדקה"@he ;
    oa:hasSelector opp:unit_fol_149r_1_u2_selector ;
    oa:hasSource opp:passage_fol_149r_1 .

