opp:unit_fol_193r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_193r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "אני אלר אחריה ואראה מי מניח ידו עליהם אמ לו לירמיהו לך לחני ורדאה לי אי זה הדרך הוליכום אמ לו רבנו אי אתה יכול לעבור מרוב חכלים שמלאות הדרכים אמ לו אעפכ לך לפני הלך לפניו עד שהגיעו לכהר פרת ומצאום יושבים על הדרכים על נהרות בבל ונשאו את עיניהם וראו את משה ואמרו זה לזה הרי משה בן עמורם בא לגאול אותנו כדרך שגאל את אבותינו ממצרים אמ להם משה בני לואול אתכם עכאו אי חיפשר שכבר יגזרה גזרה המקום יקניב לנם ח נ גאולתכם וכיון שהנכירם משה והלך מהם געו בבכיה גדולה עד שעלתה צעקתם למרום שנ על כהרות בבל שם ישבנו גם בכינו בזכדנו חת ציון ובחזרתם היומוצאים אצבעונ ידיהם ורגליהם מקוטעות מושלכות על הדרבים וחה דמיהו מלקכום ונותום בתוך טליתו ומחבקן ומנשקן ובוכה ומקונן עליהם ואומ בני לא כך הייתי לכם תנו ליי אל היכם כבוד בטרם יחשיך ובטרם יתנגפו רגליכם"@he ;
    oa:hasSelector opp:unit_fol_193r_1_u1_selector ;
    oa:hasSource opp:passage_fol_193r_1 .

