opp:unit_fol_60v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_60v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לעולם יהו בני אדם חשובין לפניך כלסטים וכבדם כק ומעשהה בר יהושע שהשכים אצלו אדם אחד ונתן לו אכילה ושתיה והעלהו לגג לשכב ונטל סולם מתחתיו מה עשה אותו האיש עומד בחצי הלילה ונטל את הכלים וכרכן בטיל תו וניון שבקש לירד נפל מן הונונשברה ונשברה מפרקתו לשחרית השכים ר יהושע ובא ומצאו כשהואנופל אמ לו ריקה כך עושח בני אדם שכמותך אמ לו ר לא הייתי יודע שנטלת את הסולם מתחתי אמ לו ריקה אי אתה יודע שמאמש היינו זהירין בך מכאן אמ ר יהושע בן לוי לעולם יהיו נל אדם בעיניך כלסטים והוי"@he ;
    oa:hasSelector opp:unit_fol_60v_1_u1_selector ;
    oa:hasSource opp:passage_fol_60v_1 .

opp:unit_fol_60v_1_u1_selector a opp:TokenPositionSelector ;
