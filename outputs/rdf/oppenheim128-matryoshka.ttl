opp:unit_fol_195v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_195v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "איכה היתה לזונה ירמי אמ בכה תבכה בלילה ורוח הקדש אומ הנה שם יושבות מבכות את התמוז ירמיה אמ גלתה יהרה מענ ורוח הקדש אימ ותגל אינתזנותיה ירמיה אמ דרכי ציק אבלות ורוח הקדש אומרת על דרכים ישבת להם כערבי במדבי ירמיה אמ היו צריה ליאש ורוח הקדש אומ להם ואת למדת אותם עליך אלופים לראש לדתי עם אמ רבא אמר יוחנן שהיו משאזקטנה לגדל לגדול וגדולה לקנן כדילרבות העם היתה כאלמנה יאמי רב יהורה כאלמנה ולא אלמנה ממש כאשה שהלך בנכה למדינת הים ודעתו לחזור עליה ועוד אמ משל למלך שכע על מטרונה וכתב לה גינה ועמד וחטפ ממנה וכל זמן שהיתה מבקשת להנשא אומ לה היסן ביטיך שגרשתיך וכל זמן שהיקה מבקשת ותובעת בתכתה אומר לה"@he ;
    oa:hasSelector opp:unit_fol_195v_1_u1_selector ;
    oa:hasSource opp:passage_fol_195v_1 .

opp:unit_fol_195v_1_u1_selector a opp:TokenPositionSelector ;
