    rdf:value "שובה ישראל עד יי אלהיך כי לא מחשבותי מחשביתיכם ולא דרב דרכיכם דרכי נאם יח משל ללסכום שהוא נדון לרני קוסטינר בתחלה הוא קורא אנל גון שלו ואמר כך הוא מכה אותו ואחר כך נותזלו פרגולא ואחר כך יוצא ליהרי אבל הקבה אינו כן אלא לתחלה הואקורא אנטון של שבטים שנ ועתה יוסיפו לחטוא ויעשו להם מסכה מ כתבונם עצבים מעשה חרשים כלם להם הם אומרים זובחי אדם עגלים ישקון ואחרכך הוא מכה אותן הכה אפרים שרשם יבש פרי בל יעשום ואחר כך הואי נותן להם כמס כמה שנאמ צר צרור עון אפרים צפונה חטאתו ואחרכך הואנותן להם פרקולא שנ תאשם שומרון כי מרהה"@he ;
    oa:hasSelector opp:unit_fol_75r_2_u2_selector ;
    oa:hasSource opp:passage_fol_75r_2 .

