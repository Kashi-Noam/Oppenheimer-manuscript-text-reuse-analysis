opp:unit_fol_56v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_56v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "מכין בסתר ומחרפין בולוי ומזילי הר הרבים ומטילי המחלוקות עתידין להיות כקרחוכעדל ועליהם פכת אומ ותכס עליהם הארץ ויאבדו מתוך הקהל עוצרי פירות ומפקיעי שערים ומקטיני איפה ומגדילי השקר ומלוי ברבית עליהם הכת אומ נשבע יי בגאון יעקב אם אשכח לנצח את כל מעשיהם ואלו שאין מורישין לבניהם ואם מורישין לבניה אין מורישין לבני בניהם המשחק בקוביא ומלוה ברבי והמגדל בהמה דקה והנושא ונותן ממעות שביעית וממעות הבאות ממרינת הים וכהן ולוי שלוו על חלקם המינין והמשומדים והמסורות והחנפים ומחללי שם שמים עליהם הכת אומ ישובו רשעים לשאולה כל גוים שכחי אלהים ואומ מעוות לא יוכל לתקון ההוגין ביונים והמגפפין בידים והבועטין ברגליהם והמהלכין בראשי אצבעותיהם עליהם הלת אומ אל תבואני רגל גאוה ויד רשעים אל תנידני גסי הרוח ומספרי לשון הרע ומדברי נבלה וחכמים בעיניהם עליהם הכת אומ כי הנה יום בא בוער כתנור המשיא אשה לבנו קטן והמשיא בתי לזקן והמחזיר אבדה לעי והעושה טובה למי שאינו יודעה עליהם הכת אומ לא יאבה יי סלוח לו הגבאין והחרמין והפורטין והמוכסין עליהם הכת אומ הונך ועזבוניך מערבך מלחיך וחובליך מחזיקי בדקך ועורבי מנרבך יפלו בלב"@he ;
    oa:hasSelector opp:unit_fol_56v_1_u1_selector ;
    oa:hasSource opp:passage_fol_56v_1 .

opp:unit_fol_56v_1_u1_selector a opp:TokenPositionSelector ;
