opp:unit_fol_143r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_143r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אם תאבו ושמעתם טוב הארץ תאכלו ואם תמאנו ומריתם קרב תאכלו כי פי יי דבר אמר אחא צריכה לישראל חריבה כי עבדין תשובה אמ ר עקיבא יאיה מסכנותא לברציה דיעקב כערקא סומקא בגרוניה דסוסיא חור אמ ר שמואל בר נח מץ כד תמוט בידה בירה שמה וכד תרום קיקלא קיקלא ישמה כד תמוט בירה ביכה שמה שמעו דבר י בית אפי בירידתן הואקורא אותן בית ישראל וכד תרום קיקלה קיקלא שמה זה ארץ כשדים זה העם לא היה ולואי לא היה אמ ר לוי משר למטרונה"@he ;
    oa:hasSelector opp:unit_fol_143r_2_u1_selector ;
    oa:hasSource opp:passage_fol_143r_2 .

