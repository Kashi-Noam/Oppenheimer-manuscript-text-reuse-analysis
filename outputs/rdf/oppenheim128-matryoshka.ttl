opp:unit_fol_134v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_134v_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "ליה בעי את למאנש חכמה ודבר אגדרה רא כי חולת אהבה אני אמ ר לוי משל לבן מלכים שעמד מחליו אמ פדגונו ילך לאיסכולי שלו אלא יתעדן בני ב או נ חרשים במאכל ובמשקה ואחר כך הוא ל הוא הוכך לאסכופי שלו נבן שתאוישרא ממצרםי הא ראוים לקבל את התורה אלן שהיא בה בעלי מימין מש משעבוודי טיל ולבנים אלא יתעדיו ב אוגחדשים בנאר ובמן ובשלו ואחר כך יקלי את התורה אימתי יהדםשם השילישי"@he ;
    oa:hasSelector opp:unit_fol_134v_1_u2_selector ;
    oa:hasSource opp:passage_fol_134v_1 .

opp:unit_fol_134v_1_u2_selector a opp:TokenPositionSelector ;
