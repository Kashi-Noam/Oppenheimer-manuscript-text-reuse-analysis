    rdfs:label "fol_179v_1#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "בו ורבנן אמרי התחלת פורענות עדיף נשניה מנאלן דתניא ר יוסי אמ מגלגלין זכות ליום זכות ויום חובה ליום חובה אמרו כשחרב הבינ בראשונה ערב ט באב היה ומוצאי שביעית היתה ומשמ ומשמרתו של יהויריב היתה והיו הלוים עומדים ואומרי שירה ומה שירה היו אומ וישב עליהם את אונם וברעתם יצמיתם יצמיתם יי אלהינו לא הספיקו לומ יצמיתם עד שבאו גוים וכבשום וכן בשניה"@he ;
    oa:hasSelector opp:unit_fol_179v_1_u1_selector ;
    oa:hasSource opp:passage_fol_179v_1 .

opp:unit_fol_180v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_180v_1#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "רב יהודה אמ שמואל משום רבן שמעון בן גמליאל מאי דכת עיני עוללה כנפשי מכל מנבנות ערי ר מאות בתי כנסיות היו בכרך גדול שלביתר וכל אחת ואחת היו בה ד מאות מלמדי תינוקות וכל אחד מהם היו יושבים לפניו ד מאות תינוקות ובשעה שנכנס האויב היו דוקרין אותן בחוטיהן וכשגברו האויבים כרכום בספריהם והציתום באש אמ רבה בר בר חנה אמ ר יוחנן מ סאה רצרצי תפלין נמצאו בראשי הרוגי בתר רב אסי משמיה דר ינאי בר ישמעאל אמ גקופות שלמ מ סאה במתניתא כנא מ קופות של מסאה לא פליגי הא בראשי האבדרעי אמ ר שמואל בר נחמני אמ ר יחחנן מאי דכת ידו פרש צר על כל מחמדיה זה עמון ומואב שבשעה שנכנסו גוים להיכל הכל נפנו אחרכסף וזהב והם נפנו אחרי ספר תורה"@he ;
    oa:hasSelector opp:unit_fol_180v_1_u1_selector ;
    oa:hasSource opp:passage_fol_180v_1 .

opp:unit_fol_180v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_180v_1#u2" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "רב יהודה אמ שמואל משום רבן שמעון בן גמליאל מאי דכת עיני עוללה כנפשי מכל מנבנות ערי ר מאות בתי כנסיות היו בכרך גדול שלביתר וכל אחת ואחת היו בה ד מאות מלמדי תינוקות וכל אחד מהם היו יושבים לפניו ד מאות תינוקות ובשעה שנכנס האויב היו דוקרין אותן בחוטיהן וכשגברו האויבים כרכום בספריהם והציתום באש אמ רבה בר בר חנה אמ ר יוחנן מ סאה רצרצי תפלין נמצאו בראשי הרוגי בתר רב אסי משמיה דר ינאי בר ישמעאל אמ גקופות שלמ מ סאה במתניתא כנא מ קופות של מסאה לא פליגי הא בראשי האבדרעי אמ ר שמואל בר נחמני אמ ר יחחנן מאי דכת ידו פרש צר על כל מחמדיה זה עמון ומואב שבשעה שנכנסו גוים להיכל הכל נפנו אחרכסף וזהב והם נפנו אחרי ספר תורה ואומ זאת היא שכתו בה לא יבא עמוני ומואבי בקהל יי ישרף"@he ;
    oa:hasSelector opp:unit_fol_180v_1_u2_selector ;
    oa:hasSource opp:passage_fol_180v_1 .

opp:unit_fol_182r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_182r_1#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "אמרו לו כלי זהראוי הוא למלכו הכנס שניה ותזכי במה שתוציא ונמנע והרהר בתשובה הביאו חמור שלנסרים ונסרוהו והוא אומ זה והיה מצדיק עליו את הדין ויקים איש צרדוס אחיו של יוכף בן יונחר נתפשו שניהם לשמד יוסף נתלה שלא קבל יקים קבל ונרכב על סוס עברעל דורו ראה מה נתן לך כטורונך ומה נתן לי פטרוני השיב יוסף ליקים ואמ ל אם למלעיסיו כך למרוביו על אחת כמה וכמה הרהר תשובה בעצמו ודץ עצמו בר מיתות נם יוסף וראה מטתו בין מלאכי השרת נער ואמ לתלמידיו קדמני יקים בתשובתו לגן עדן דרש רב עולא בריה דרב עידאי מאידכת ויאמר יי ינק כי גבהו בנות ציון מלמד שהיו הולכות בקומה זקופה ותלכנה נטויות גרון שהיו מחלכות ארוכה לצד קצרה ומשקרות עינים דהונן מליין כחלא הלוך וטפיף תלרנה שהיוהולכות עקב בצד גדל וברגליהן תעכסנה אמ ר יצחק דבי ר אמי מלמד שהיו מעלות מיר רפרסמון בנעליהם ומחלכות בשוקי ירושלם וכין וכיון שמגיעות אבל בחורי ישראל בועטות בקרקע ומתיזות עליהן ומכניסות בהן יצרהרמע כזרס"@he ;
    oa:hasSelector opp:unit_fol_182r_1_u1_selector ;
    oa:hasSource opp:passage_fol_182r_1 .

opp:unit_fol_182v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_182v_1#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "מאי פירענותיהו דרשרבא בדרעולא והיה תחת בשם מק יהיה מקום שהיו מתבשמות בו נעשה נמקים נמקים ותחת חגורה נקפה מקום שהיוחוגרות בורבצלבילל נעשה נקפים נקפים ותחת מעשה מקשה קרחה מקום שהיו מתקשטות בו לעשה קרחים קרחים ותאנ פתיגיל מחגורת שק פתחים הבאים לידי גילה כעשים למחגורת שק כי תחת יופי אמ רבא היינו דאמרי אינשי חלופי שופרא כיבא ושפח יי קדקד בנות ציון אמר יוםי בר חנינא מלמד שפרחה צרעת כתוב הכא ושפח וכת התם ולשאת ולספחת ולבהרת ויי פתהן יערה רב ושמואל חדאמ שנשפכו כקיתון וחד אמ שנעשו פתחיהן כיער אמ רב יהודה אמ רב"@he ;
    oa:hasSelector opp:unit_fol_182v_1_u1_selector ;
    oa:hasSource opp:passage_fol_182v_1 .

opp:unit_fol_182v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_182v_1#u2" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "ושפח יי קדקד בנות ציון אמר יוםי בר חנינא מלמד שפרחה צרעת כתוב הכא ושפח וכת התם ולשאת ולספחת ולבהרת ויי פתהן יערה רב ושמואל חדאמ שנשפכו כקיתון וחד אמ שנעשו פתחיהן כיער אמ רב יהודה אמ רב אנשי ירושלם אנשי שיץ היו היה אדם אומר לחבירו במה סעדת היום בפת עמילה או בפת שאינה עמילה בח גודלין בין חרדלין במסב רחב או במסב קבר בחבר טוב או בחבר רע אמ רב וכולם לשום זנות"@he ;
    oa:hasSelector opp:unit_fol_182v_1_u2_selector ;
    oa:hasSource opp:passage_fol_182v_1 .

opp:unit_fol_182v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_182v_2#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "באדם אחד שנתן עיניו באשת רבו ושוליא דנגרי הוה פעם אחת עטדך רבו לטת אמ לו שגר אשתך עמי ואני אלוך שגרה עמו שהתהו בביתו ג ימים קדם הוא ובא יתלו אמ לו אשתי ששגרתי אצלך היכן היא אמ ליה פטרתיה לאלתר אלא שמערבי שמתעללין בה בדחד אמ לו מה אעשה לה אמ לו גרש אותה אמ לו כתובתה מרובה אמ לו אני אליך הלוהו לו כ כתובתה וגרשה עמד הוא ונשאה וכשהגיע זמנו לא היה לומה לפרוע אמ לו בא ועשה עמי בחובך והיו הם יושבים ואוכלים והוא עומד ומשקה עליהם והיו דמענת יורדות מיגיניו ונופלות בתויך כוסיהן ועל אותו מעשה נחתם גזרדין וישאמ על שתי פתילות בנר אחד כת איכה ישבה בדד אמ רבא אמ ר"@he ;
    oa:hasSelector opp:unit_fol_182v_2_u1_selector ;
    oa:hasSource opp:passage_fol_182v_2 .

opp:unit_fol_183v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_183v_1#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "תנו רבנן מעשה בני אדם שנשבו מהר הכרמל והיה שבאי מהלך אחריהם אמ אחד מהם לחבירו גמל שמהלכת יסומאהיא באחת מעיניה וטעונה שתי נודות אחת של יין ואחת שלשמן ושני בני אדם מנהיגין אותה אחד גוי ואחד ישראל אמ להם עם קשי עקף מנין אתם יודעים אמרו לו גמל מעשבים שלפניה צד שרואה אוכלת וצד שאיו רואה אינה אוכלת וטעונה שתי נאדות אחת של יין ואחת ל שמן שליין מטפטף ושוקע ושל שמן מצפצף וצף ושנ בלי אדם המנהגין אותה אחד גוי ואחד ישראל גוינפנה בדרך וישראל נפנה ליצדדין רץ אחריהם ומצא כדבריהם כיון שהגיעו לפתחה שלרומי אמ אחד מהם לחבירו מרימ אני ריח קפלוטות מבנשלין בקדכה של כפר חנניה כעס עליהם אותו שבאי אמ להם אלהיכם לא יכול לסבול אתכם ואני אוכל לסבול אתכם עד שהוא מקלל בא שלמנסר של שנמלך אעלו מהינן באת אמ כו מארן יהודה באתיהיום אמ לו איפשר באת היום ד מאותפרסה אמלו הן רח ששבה בספינה ובאתי היום ואם אין"@he ;
    oa:hasSelector opp:unit_fol_183v_1_u1_selector ;
    oa:hasSource opp:passage_fol_183v_1 .

opp:unit_fol_184r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_184r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "אמרה לו טלה זה מתה אמו והניקתהו הכלבא ויין זה מכרם שאביך קבור בו היה אכל ושתה עמד ורקד אמ אמד לחבירו ראה רגליו שהם דומים לרגלי נימוס אמ לאמו כל מה שאמרו לי התינוקות אמת אמרו לי ואם אין את אומרת לי מי היה אבא אני הורנך אמ לו פעם אחת הביא אביך זתד והיה נאה עד מאד נבעלתי לו ונתעברתי ממנו עמד ונשקן על ראשן ואמ ברוך יי אלהי ישראל שבחר בזרעו של אברהם ונתן להם ממין ופטרם לבתיהם לשלום הינו דכת החכמה תחיה אמרו מעשה באחד ודואג בן יוסף שמו והיתה אמו וזקנתו ואחותו ואחות אביו מודדות אותו בטפחים ונותנות משקלו לשמים וכשעלה נבוכד נצר לירושלם היתה אמי וקרוביו אוכלין אותו איברים איברם והיה ירמיה קונן עליהם אם תאכלנה נשים פרים עולל טפוחים אם יהרג במקדש יי כהן וגביא זה זכריה בן יהוידע אמרו אותו היום שהרגוהו עברו א עיד עבירו הרגו כהן ונביא וחלל השבת ויום הכפורים היה ועבדו עז ונימא את המקדש ובטלו"@he ;
    oa:hasSelector opp:unit_fol_184r_1_u1_selector ;
    oa:hasSource opp:passage_fol_184r_1 .

opp:unit_fol_190v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_190v_1#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "רוח סערה באה מן הצפון להיכן אזל אמ רביהודה אמ רב שהלך לכבוש את כל העולם כרו ביד נבוכד נשצר הרשע וכל כך למה כדי שלא יאמרו ביד אומה שפלה מסר את בניו אמ הקבה מי גרם לי שאהיה שמש לעובדי פסילים עונותיהן של ישראל גרמו לי דכת ורבו יתירא הוספת לי אמ רבא בר ירמיה מלמד שרכב ארי וקשר תנין בראשו לקיים מה שטוגם את חית השדה נתתי לו לעבדו אמרו בשעה שבקש הקבה להחריב את ירושלם אמ כל זמן שעיני בביתי אין אומות העולם יכולין ל אלא אעלים עיני ולתי ממנו ואשבע שלא אזקק לו עד עת קץ ויבאו בו זרים ויחריבוהו באותה שעה נשבע הקבה בימינו והחזירה לאחור שנ השיב אחוד ימינו מחלי אויב באותה שעה נכנסוגוים ליהיכל ועשו בו כר טונם נכנס נבוזר אדץ ותפש את צדקיהו והיאך תפש אותו והוא ברח במחלה תחת הארץ מלמד שירד מלאך בדמות צדקיהו והיה מהליך מלמעלה וצדקיהו מהלך מלמטה וכיון שהגיע לערבות יריחו יצא מן המחלה ותכשוהו עבדי נבוכד נצר שנ בחדש הרביעי בתשעה לחדש ויחזרך הרעב בעיר ולא היה לחם לעם הארץ ותבקע העיר וכל אנש המלחמה יברחו ויצאו מז העיר לילה דרך שער בין החומותים וכת וירדפו"@he ;
    oa:hasSelector opp:unit_fol_190v_1_u1_selector ;
    oa:hasSource opp:passage_fol_190v_1 .

opp:unit_fol_190v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_190v_2#u1" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "ויאמר אל האש לביש הבדים ויאמר בא אל בינות לגלגל אל תחת לבדרוב מלא חפניך גחלי אש מבינות לכרובים וזרוק על העיר ויביא לעיני וישלח הכרוב את ידו מבינות לכרובים אל האש אשר בינות לכרובים וישא ויתן אל האש לבוש הברים ויקח ויצא אמ רב הונא בר ביזנא אמ ר שמעון חסידא אלמלא לא נתעממו ביהו לא נשתייר משונאיהם שלי ישראל שריד ופליט וכיון שחרבה ירושלם ונשתייר בית המקדש אמ הקבה למלאכי השרת באו ונראה ביתי בחורבנו ומה עשו לו אויבים מיד בא הקבה ומלאכי השרת עמו וירמיהו לפניהם וכיון שראו בית המקדש חרב ומוטל בתלו אמ הקבה איפשר זהו בירבי ובית מנוחתי נכנסו גוים לתוכ ועשו בו כרצונם ואני"@he ;
    oa:hasSelector opp:unit_fol_190v_2_u1_selector ;
    oa:hasSource opp:passage_fol_190v_2 .

opp:unit_fol_192r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_192r_1#u1" ;
    opp:earliestWitness opp:work_Eichah_Rabbah ;
    rdf:value "הקבה לירמיהו מחני מה אתה רואה אותי שאני דומה למי שהיה לו בן ועשה לו חופה ומת בתוך חפתו ואין לך כאב על בני זהו משל שבני אדם מושלים מכאוב למכאובי כאב אמ לפניו רבונו של עולם ומה שבידי לעשות אמ לו לך קרא לי אברהם יצא ויע ממערת המכפלה ומשק בן עמרם מקבורתו ויבאו ויבכו לפני שהם יודעין לבכות ולהם נאה רבכות אמ לפניו רבונו של עולם ומנין אני יודע היכן משה קבור אמ לו לך ועמוד על שפתהירדק וצעק לך בקולך ואמור משה בן עמרם עמוד שאתה מתבקש לפלי המקום והוא ישמע ויעמד מיד הלך ירמיה למערת המכפלה אמ אבות העולם עמדו שאתם מתבקשי לפני המקום אמרו מה היום מימים ומה דבר אירע בעולם שאנו מתלקשים לפני המקום והיה מתבייש לומר להם שא יאמרו בימיך היתה זאת לבנינו ענה ואמ להם איני יודע והלך ועמד עוד על שפת הירדן וצעק ואמר משה בן עמרם משה בן עמרם עמוד שאתה מתבקש לפני המקום אמ לו למה אמ לו"@he ;
    oa:hasSelector opp:unit_fol_192r_1_u1_selector ;
    oa:hasSource opp:passage_fol_192r_1 .

opp:unit_fol_199r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_199r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Eichah_Rabbah ;
    rdf:value "כל הדרה זה הקבה דכת ביה זה הדור בלבושו וילכו בלא כח היה אדם אומ לחבירו בירושלם למדני סדר אחד השנה לי פרק אחד והוא אומ לו אין ביכח אומ לו הקבה חייכם כך יוישה בלם שנ וילכו בלא כח ברו לי זדים שיחות אשר לא כתורתך אמרו ישר לפניה בה רבונו של עולם כתבת בתורה שלח תשלח את האם ואת הבנים תקח לך ובירושלם כתו אם על בנים רטשה יהוי אשר לא כתורתך כת איש איש מביתישראל אשר יצוד ציד חיה או עיף ושכך את רמי וכסהו בעפר ובירושלם כת שכנו דמם כמים סביבות ירושלם ואח קובר י הוי אשרלא כתורתך בתורה כתבת אותו ואת בנו לא תשחטו ביום אחד ובישראל כת להשמיד להחג ולאבד את כל היהודים ולולי שנתגלגלו רחמיו של הקבה עלי אותה הלילה הייתי אבודה מן העולם אמרה כנסת ישראל לחמורים נתת קבור ולי לא נתת קבורה ומי הם החמורים אלו המצריים דכת אשר בשר חמורים בשרם שפלכום הים ליבשה ונתנו לקבורה ולי לא נתת קבורה הוי אשר לא כתורתך"@he ;
    oa:hasSelector opp:unit_fol_199r_1_u1_selector ;
    oa:hasSource opp:passage_fol_199r_1 .

opp:unit_fol_1r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_1r_1#u2" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "לו אנל הוא מני ן לחברו חרבד שכוקש לאתי מרות אתה נויהן מו כנח היפה שבשתיהן מדצבר שחבירו מוכיח עליו רך מדבר שהוא מובירד על חבירו מדבר שהיה בכלל ויצא מן הכלל ללמד על עצמו מדבר שהיה בכלל ויצא מן הכלל כלמד על חבירו ממשל מכנגד ממ ממוקדם וממאוחר שהוא בענין ממוקדם ומאוחד שהוא בפרשיות מלשון נוטריקון מלשון גיא מטריא בשני פנים אחד הולך בחדוף אותיות והשני שהוא בחשבון האותיות מכאן אמרו נל מקום שאת מוצא דבריו של ר אליעזר בנו של ר יוסי הגלילי בהגדה עשה אזנך כא פרכסת שנ להקשיב לחכמה אזנך גו מרבויתיצר הרבה שלש לשונו את אף גם אה לרבות כיצד וייפקד את שרה גו אלו נאמ ויזפקד את שרה הייתי אומ שרה לבדה נפקדה תלמוד לומר את ריבה מלמד שכל העקרנת נפקדו עמה וכן הוא אומ שחוק עשה לי אלהים כל השומע יצחק לי כיוצא בדבר אתה אומר את פני מבין חכמה אלו נאמר פני מבין הייתי אומ לשעתי בלבד וכשהוא אומ את לרבות ילדורות ולדורי דורות וכן הוא אומ עוז והדר לבושה ותשחרך ליום"@he ;
    oa:hasSelector opp:unit_fol_1r_1_u2_selector ;
    oa:hasSource opp:passage_fol_1r_1 .

opp:unit_fol_203v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_203v_1#u1" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "שהמדו ישראל על הים אמרו כשם שאלו עולים מצד אחד כך מצריים עולים מצד אחר ואינם מתים מיד אמ הקבה לשר של ים שיכנא אותם ליבשה בעוד שהן חיים ויראו ישראל ויאמינו בנ שהם מתים אמ הים לפני הקבה רבר של עו כלום יש אדון נוכן מתנה לעבדו ואחרכך נוטלה ממנו ולאעוד אלא שאני נל חמתי עם משריים ועכשו יבא עופות ויאכלום אמ לו הקבה אני אתזלך בשבילם אחד ומחצה בהם אמלפניו רבו של עו יש עבד שתובע אתרבו אמ לו נחל קישון יהא ערב מיד פלט אותם הים ליבשה ובאין ישראל ורואין אותם כשהם חיים והיו מכירין כל אחד ואחד את שונאו ואחר כך היו מתים שנוירא ישראל את מצרים מת על שפת הים מיד הושיען הקבה מידם שנ ויושע יי ביום ההוא וכ והאמינו ביי ובמשה שנ ויאמינו ביי ובמשה עביו יתברך שמי שלמלך מלכי רמלכים הקבה שהוא ראשק ראשון ושהוא אחרון ומבלעדיו אין אלהים כדכת אני"@he ;
    oa:hasSelector opp:unit_fol_203v_1_u1_selector ;
    oa:hasSource opp:passage_fol_203v_1 .

opp:unit_fol_24v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_24v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והלווה ואינו משלם שנ לווה רשע ולא ישלם ומי שהוא בעל מחלקת שנ סורו נא מעל אהלי האנשים הרשעים האלה גו דבר אחר לווה רשע ולא ישלם אלו אומות העולם שהם אוכלים ואין מברכין וצדיק חונן ונותן אלו יש שהן אוכלין ומברכין אמ דיש לקיש את מוצא כשהקבה נותן לביק מה שמבקש לו בידו הוא חוזר וחונן משלו שנאמ וצריק חונן ונותן דבר אחר וצריק חונן ונותן חי העולם חונן ונותן אמר לויכך עלה בדעתו של הקבה לעשות רגל אחד בכל חדש וחדש שבקיץ בניסן פסח באייר פסח שני בסיון עצרת ועל ידי עבירות ומעשים רעים שהיו בידם נטל מהם שלשה תמוז אב ואלול בא תשרי ופרע שלשתן ריש שתא לקביל תמוז צומא רבא לקביל אב שבעת ימי החג לק ביל אלול אמ הקבה של אחרים פורע ושלו אינו פרע תנו לו משלו ויבא ויטול את שלו לפיכך הוצרך הכת לומר ביום השמיני"@he ;
    oa:hasSelector opp:unit_fol_24v_1_u1_selector ;
    oa:hasSource opp:passage_fol_24v_1 .

opp:unit_fol_24v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_24v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אלו אומות העולם שהם אוכלים ואין מברכין וצדיק חונן ונותן אלו יש שהן אוכלין ומברכין אמ דיש לקיש את מוצא כשהקבה נותן לביק מה שמבקש לו בידו הוא חוזר וחונן משלו שנאמ וצריק חונן ונותן דבר אחר וצריק חונן ונותן חי העולם חונן ונותן אמר לויכך עלה בדעתו של הקבה לעשות רגל אחד בכל חדש וחדש שבקיץ בניסן פסח באייר פסח שני בסיון עצרת ועל ידי עבירות ומעשים רעים שהיו בידם נטל מהם שלשה תמוז אב ואלול בא תשרי ופרע שלשתן ריש שתא לקביל תמוז צומא רבא לקביל אב שבעת ימי החג לק ביל אלול אמ הקבה של אחרים פורע ושלו אינו פרע תנו לו משלו ויבא ויטול את שלו לפיכך הוצרך הכת לומר ביום השמיני עצרת"@he ;
    oa:hasSelector opp:unit_fol_24v_1_u2_selector ;
    oa:hasSource opp:passage_fol_24v_1 .

opp:unit_fol_29r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_29r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma_Buber ;
    opp:earliestWitness opp:work_Midrash_Tanchuma_Buber ;
    rdf:value "הנה יסרת רבים אתה היית מנחם כל בעלי ייסורין כשהיה סומא בא אצלך ואמ לך כבר היה הקבה יו דע מה עתיד לעשות שסימא נאותי האיש היית מנחמו ואומר ל בני אם אתה בונה בית ולא בקשת לעשוה לך חלונות מי ימחה בידך כך עתיד הקבה להשתבח אז תפקחנה עיני עורים אם בא אצלך פסח היית מנחמו ואומר לו בני אם עשי לך קיתון ושלא בקשת לעשות לו אזנים מי ימחה בידך בך עתיד הקבה להשתבח אז ידלג כאיל פסח הוי כושל יק ימון מליך כי עתה תבא אליך ותלא ועכשו כשבאו ייסוין עליך נלאית נשוא תגע עדיך ותבהל לפי שנגעה בך מדת הדין נבהלת הלא יראתך כסלתך על שאמרת אדם צדיק אני ולמה הוא מייסרני וכי איזה צדיק אבד מימיו זכר נא מי הוא נקי אבד נח שלא שהיה צדיק לא נמלט מכל דורו וכן אברהם לא נמלט מן הכבשן יצחק לא נמל מן המאכלת יעקב לא נמלט מן המלאך משה לא נמלט מחרב פרעה"@he ;
    oa:hasSelector opp:unit_fol_29r_1_u1_selector ;
    oa:hasSource opp:passage_fol_29r_1 .

opp:unit_fol_2r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_2r_1#u1" ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    rdf:value "כיוצא בדבר אתה אומ אך בעשום לחדש השביעי הזה יום הכפורים הוא גו אלו נאמר בעשור לחדש הייתי אומר שיום הכפורם מכפר אף לשאינם שבים תלמוד לומר אך שאינו מכפר אלא על השבים בלבר רק למעט כיצד רק אין יראה אלהים במקום הזת יכול מה ששמעו באזניהם לא היו יראים כל עיקר תלמוד לומ מק רשעים היו ויראים מה ששמעי אמור מעתה עד שלא שמעו באזניהם לא היו יראים מששמעו היו יראים וכן הוא אומ וישכם אבימלך בבקר ויקרא לכל עבדיו גו כיוצא בדבר אתה אומ ויאמר לו המלך עד כמה פעמים אני מש משביעך אשר לא תדבד אלי רח אמתימלמד שלא מ לו כל לבו אלא מכני שהיה יהושפט מלך יהגדה יושב שם מן למעט כיצד ויעמד העם על משה מן הבקר עד הערב יכול כל היום כלו היה משה דן אם כן אימתי היו תלמידיו למדין תלמוד לימ מן למעט שנא היה יושב כל הום כלו ושמערו חכמום שש שעות כיוצא בדבר אתה אומ ירעם מן שמים י ובול שהרע נשמע מכל קצות השמים תלמוד לומ מן למעט מלמד שאינא נשמע אלא כלפי אפרכיא שהוא נשמע לה וכןהוא אומ ירעם אל בקול כפלאות במקום שהוא חדי עתיד לחדש דבר"@he ;
    oa:hasSelector opp:unit_fol_2r_1_u1_selector ;
    oa:hasSource opp:passage_fol_2r_1 .

opp:unit_fol_2v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_2v_1#u1" ;
    opp:closestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "אחר רבוי כיצד גם את הארי ואת הדוב הכה עבדך לו נאמ הארי והדגב הייתי אומ שתי חיות בלבד כשהוא אומ גם את הארי גם הג הדוב הרי שנשה רבויין מלמד שהיו שם חמשה חיות רעות ארי ושתי גורותיו הדוב וגורו כיוצא בו גם את בניהם ואת בנותיהם ישרפון לאלהיהם לו נשמר בניהם ובנותי הייתי אומ שאין מקריבין לעז אלא בנים ובנות בלבד תלמוד לומר גם את בניהם ואת בנותיהם רבוי אחר רבוי מלמד שאף אבותיהם ואמותיהם היה מקריבן אמ ר עקיבא אני ראיתי גוי אחד שכפתי לאביו ל בוי דדבר המקום ולא בי ינ אמרת והלא גם בנן דבר יגנ לא שבר עמו ומנין ש עם מרים קודם למשה שט והקח מרים הנביאא אחת אהה בלבד שעדיין לא נולד השיק ומנין שנדד עם אהרן קודם למשה שנ ויבא איש האלהים אל מ ויאמר אליו הנגלה נגליתי אלבית א בהיותם בתצרים גו ובחיר איתו מכל שבטי ישראל לי לר לעלות על מזבחי גו והיתה נבואתו כבושת שמנה מאות ושמנים ושש שנים"@he ;
    oa:hasSelector opp:unit_fol_2v_1_u1_selector ;
    oa:hasSource opp:passage_fol_2v_1 .

opp:unit_fol_33v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_33v_1#u1" ;
    opp:earliestWitness opp:work_Bamidbar_Rabbah ;
    rdf:value "מעשה באיש אחד שהיה עומה בבית הכנסת ובנו עומד כנגדו וכל העם עונין אחר העיבר לפני התיבה הנלויה ובנו עונה דברים של תפלות אמרו לו ראה בנך שהוא עונה דברים של תפלות אמ להם ומה אעשה לו תינוק הוא וישחק שוב עושה באותו ענין ועונה דברים שלתפלות ואומרין לאביו אמ להם ומה אעשה תינוק הוא וישחק כל אותן ימי החג ענה בו דברים שלתפלות ולא אמ לו דבר לא בא עד שלישית השנה עד שמת אותו האיש ומתה אשתו ומת בנו ובן בנו ויצאו עשרה נפשות מתוך ביתו ולא נשתייר לו אלא זוג אחד של בני אדם אחד חגר וסומא ואחד שוטה ורשע שוב מעשה באדם אחד שהיה מתחרט שלא קרא ולא שנה פעם אחת היה עומד בבית הכנסת וכיון שהגיע העובר לפנם התיבה לקדושת השם הגביה קולו ואמר קדוש קדוש קדוש יי צבאות אמרו לו מה ראית שהגבהת את קולך אמ להם לא זכיתי לא למקרא ולא למשנה ועכשו שניתנה לי רשות לא אגביה קולי ותשוב נפשי עלי לא יצאה השנה עד שעלה אותו האיש מבבל לארץ ישראל ועשאוהו שר החיל של קיסר ומנוהו ראש על כל בוריונות של ארץ שראל ונתנו לו מקום ובנה עיר וישב בה קראו לו קילוניא"@he ;
    oa:hasSelector opp:unit_fol_33v_1_u1_selector ;
    oa:hasSource opp:passage_fol_33v_1 .

opp:unit_fol_3r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_3r_1#u1" ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "וחומד מפיוש כצד כיאת רגלים רצת וילאיך קל וחומה ואיב תתחרה את הסיסים כוצא בו ויאמר המלך לאכת המלכה בשישן הבירה הרגו גו קל וחומר בשאר מדינוה המלך מה עשו מק וחומר סתום ביצם נשבע להרע ולא ימי להרע הוא דלא יחליף אבל נשבעלה טיב יחליף וכר מה קשה על בני אדלי לעשות להרע ליגצמו או להיטב ום להרע לעגצמי אינו מנליף קל וחימר ליטיב לעצמו איזהו להרע לעצמו שמינר לו ענשות אמ ר"@he ;
    oa:hasSelector opp:unit_fol_3r_1_u1_selector ;
    oa:hasSource opp:passage_fol_3r_1 .

opp:unit_fol_41r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_41r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma ;
    opp:earliestWitness opp:work_Midrash_Tanchuma ;
    rdf:value "וכן דניאל אומ חזה הוית עד די התגזרת אב ןדי לא בידין ומחת לצלמא על רגלוהי די פרזלא וחספא והדקק המון חןחן לה שהואנותן חן ותחנונים לישראל כמה דתימא ושפכתי על בית דוד ועל יושבי ירושלם רוח חן ותקנונים ואחד שמשיח פורע מן עשו הוא נעשה מלך גדול ההד ואבנא די מחת לצלמא הות לטוררב ומלאת כל ארעא ומהו לטוררב כדא מי אתה הר הגדול דא למה קורא למשיח הר שהוא בא דרך הרים כד מה נאוו על ההרים רגלי מבשר באותה שעה ישראל מסתכלין על ההרים ההד אשא עיני על ההרים מאין יבא עזרי זה משיח שנקרא עזר כד ישלח עזרך מקדש ומאיכן הואבא מן הקבה ההד עזרי מעם יי עושה שמים וארץ"@he ;
    oa:hasSelector opp:unit_fol_41r_1_u1_selector ;
    oa:hasSource opp:passage_fol_41r_1 .

opp:unit_fol_43r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_43r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_Rabbati ;
    rdf:value "הקבה מנחמן ולפי שישראל מצטענן ואומרלהם בני כמה פעמים הייתם עולים בכל שנה לא שלשפעמים חייכם כשיגיע הקץ אני בונה אותו ואין אתם מונים לו שלש פעמים אלא בכל חדש וחדש ובכל שבת ושבת ההד והיה מדי חדש בחדשו ומדי שבת בשבתו יבא כל בשר להשתחות לפני אמר יי והיאך איפשר שיהיו כל ישראל באים לירושלם בכל ראש חדש ובכל שבת אמ ר לוי ירושלם עתידה להיות כארץ ישראל וארץ ישראל ככל העולם והיאך הם באים מסוף העולם ועד סופו אלא העבים טוענים אותם ומביאים אותם לירושלם בכל ראש חדש ובכל שבת הוא שהנביאמקלס מי אלה כעב תעופינה"@he ;
    oa:hasSelector opp:unit_fol_43r_1_u2_selector ;
    oa:hasSource opp:passage_fol_43r_1 .

opp:unit_fol_43v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_43v_1#u1" ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "מדינים זה עם זה החטים החטים והקש והמוץ על אומרים בשבילנו נזרע השדה הקש והמוץ אומרין בשבילנו נזרע השדה אמרו להם החטים תבא השעה ואתם רואים כיון שהגיע עונת הגרן התחיל בעל השדה נוטל את הקש ושורפו ואת המוץ ומשליכו לרוח והחטים מעמידן כרי התחילו הכל מנשקים אותם כך ישראל נמשרו בחטים שנ בטנך ערמת חטים אומות העולם נמשלו במוץ ועשו בקש ואת מוצא שתילדות יעקב ועשו ובני שעיר כתובות כתובות בתורה זה בצד זה ונן תולדות בני נח כתובו אצל פרשת אברהם וכן תולדוה ישמעאל אצל תולדות יצחק וכלם מדיינים עם ישראל ישראל אומרים בשבילנו נברא העולם אומות העולם ועשו אומרים בשבילנו נברא העולם אומר ין לתם ישראל תבא השעה ואתם רואים מי הוא עקרו של עולם לעתיד לבא נוטל הקבה עשו הנמשל לקש ושורפו שנ והיה בית יעקב אש ובית יוסף להבה ובית עשו לקש ודלקו בהם ואכלום ול וטל אומות העולם הנמשלים למוץ וזורם לרוח שנ יהיו כמיץ לפני רוח ומלאך יי דוחת ואומר תזרם ורוח תשאם וסערה תפיץ אותם"@he ;
    oa:hasSelector opp:unit_fol_43v_1_u1_selector ;
    oa:hasSource opp:passage_fol_43v_1 .

opp:unit_fol_44r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_44r_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "יוסף יי לי בן אחר למה הרא לבנימן אחר לומר שהוא אחר לגלות אמ ר יודה בר סימון לא למקום שגלו עשרת השבטים גלו שבט יהודה ובנימן עשרת השבטים גלו לפנים מנהר סבטיון ושבט יהודה ובנימן גלו מפוזרין בכל הארצות ויש אומרים הליים בני משה הם חונים לפנים מנהר סבטיון אמרו רבותינו בשעה שגלו ישראל לבבל ובאו להם לפרת כמה דתימא על נהרות בבל שם ישבנו גם בכינו אמרו האומות ללוים עמדו לפני עז ואמרו שירה כדרך שהייתם משוררים נבית המקרש אמרו להם הלויים שוטים שבעולם אלמלא אמר ושירה על כל נם ונם שעשה ליוהרבה לא גלי נה מארצנו לא הוסיף לנו כבוד על כברדנו וגדו לה על גדולתנו ונאמר שירה לפני עז מיד עמדו והרגו מהם תלי הלים ואעפ שהרגו מהם הרבה גדולה היתה השמסה שלא עבדו עז לכך נאמר ותוללנו שמח מה עשו הלוים שנשאלו קצצו אצבעות ידיהם כדי שלא יקישו הכנורות וכשהיו אומרים להם שוררו והקישו בככור היו מראים אצבעותיהם מקוצצים ואומרים להם איך נשיר את שיר יי ואצבעותינו מקו מקיצצים כיון שבא בר ילה ירדה הענן וכסה עליהם ועל נשיהם ובניהם ובנותיהם והאיר להם הקבה בעמוד אש וקוליכם כל הלילה עד אור הבקר והניחם על שפת"@he ;
    oa:hasSelector opp:unit_fol_44r_1_u1_selector ;
    oa:hasSource opp:passage_fol_44r_1 .

opp:unit_fol_44v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_44v_1#u1" ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "הים כיון שזרח השמש נסתלק הענן ועמו האש והמשיך הקבה לפניהם נחל אחד שמו סבטיון וסגר בפניהם כדי שלא יוכל אדם לעבור עליהם הים סובב עליהם מהלך שלשה ימים חדשים מרובע ומצד האחד לא הים סובב כל הרוח והמשיך הקבה אול נהנ וסגר בפניהם ותחחום אותו נהר מאתים אמה והנהר מלא חול ואבנים ומושך חול ואבנים וקולך רעש קולו בלילה מהלך חצי יום והנהר מושך חול ואבנים כל ששת ימי המעשה ובשבת ני נוח ומיד תעלה אש מערב שבת עד מוצאי שבת מצד הנחל והאש לוקטת ולא יוכל אדם לנגוע אל הנחל המהכך מיל ומלחכת האש כל מה שישריש סביבות הנחל עד"@he ;
    oa:hasSelector opp:unit_fol_44v_1_u1_selector ;
    oa:hasSource opp:passage_fol_44v_1 .

opp:unit_fol_45r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_45r_1#u1" ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "הם ועימ ועומדין לפנים מן הנהר ואין ביניהם לא בהמה טמאה ולא חיה טמאה ולא עוף טמא ולא שום רמש האזמה ועמהם צאן ובקר ויש אצלם שש מעיינות ויתקבצו בלם לאגמה אחת וישקנ מהם ארצם ובאותה אגמה ישר צו כל מיני דגים ועל המעיינות ועל האגמה יפרחו נל מיני עופות טהורים ועמהם כל מיני פירות וזורעים וקוצרים זורעים אחד וקוצרים מאה והם בעלי אמונה בעלי תורה בעלי מקרא בעלי משנה ואגדה והם חכמים וטהורים חסידים קדושים ואינם נשבעים לשקר וחיים מאה ועשרים שנה ולא ימות להם בן ובת בחיי אביו ורואים שלשה וארבעה דורות והם בעצמם בונים בתים וחורשים וזורעים לרי שאין להם עבדים ושפחות ואינם סוגרם בתיהם בלילה ונער קטן הולך עם בהמתו מהלך כמה ימים ואין מתיירא לא מן הלסטים ולא מחיתו רעה ולא מן רמש האדמה ולא מן השדים ולא מכל דבר רע מפלי שהם קדושים ועדין הם עומדים בקדושתו של משה רבינו לפיכך נתן להם הקבה כל יאת ובחר בהם ואינם רואים בני אדם ולא בני אדם רואין אותם אלא א רבעה שבטים בלבד דן ונפתלי וי ואשר שהם ריושבים מעבר לנהרי כוש"@he ;
    oa:hasSelector opp:unit_fol_45r_1_u1_selector ;
    oa:hasSource opp:passage_fol_45r_1 .

opp:unit_fol_45r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_45r_2#u1" ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "ושבט דן ונפתלי גד ואשר חונים מעבר לנהרי כוש כיצד הלכו לשם אמרו רבותינו בשעה שעמד ירבעם בן נבט ועשה שני עגלי זהב והחטיא את ישראל ונחלקו במלכות בית דוד וכינס עשרת שבטי מישראל ואמר להם צאו והלחמו עם רחבעם"@he ;
    oa:hasSelector opp:unit_fol_45r_2_u1_selector ;
    oa:hasSource opp:passage_fol_45r_2 .

opp:unit_fol_45v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_45v_1#u1" ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "ירושלם אמרו לו למה אנחנו נל חמים עם אחינו ועם בני אדננו דוד מלך ישראל ויהודה יעצו עליו זקני ישראל ואמרו לו אין לך בכל ישראל גבורי חיל ואנשי מלחמה כשבטדן צוה אותם שילחמו עם יהודה מיד חמ להם ירבעם קומו בני דן והלחמו עם יהודה אמרו לו בחיי דן אבינו אין אנו עושין מלחמה עם אחינו ולא נשפוך דמם חנם מיד נטלו בני דן חרבות ורמחים וקשתות ומסרו עצמם למות ולעשות מלחמה עם ירבעם עד שהצילם הקבה מלשפוך דמי אחיהם והיו מכד יחין בכל שרבט ד ואומרין נוסו בני דן וצאו מארץ ישראל ואלך אל אהץ מצרים ויעצו על ארץ מצרים להחריבה ינלהרוג כל יושביה אמרו להם נשיאיקם למה תלבו למצרים כבר כתוב בתורה לא תוסיפו לראותם עוד עד עולם ועוד היו יועצים על אדום ועמון וכשמצאו כתוב בתורה שהקבה מנע ישראל לירש גבולם נתן בהם הקבה רוח טובה והיו בני דן"@he ;
    oa:hasSelector opp:unit_fol_45v_1_u1_selector ;
    oa:hasSource opp:passage_fol_45v_1 .

opp:unit_fol_45v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_45v_1#u2" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "ועם בני אדננו דוד מלך ישראל ויהודה יעצו עליו זקני ישראל ואמרו לו אין לך בכל ישראל גבורי חיל ואנשי מלחמה כשבטדן צוה אותם שילחמו עם יהודה מיד חמ להם ירבעם קומו בני דן והלחמו עם יהודה אמרו לו בחיי דן אבינו אין אנו עושין מלחמה עם אחינו ולא נשפוך דמם חנם מיד נטלו בני דן חרבות ורמחים וקשתות ומסרו עצמם למות ולעשות מלחמה עם ירבעם עד שהצילם הקבה מלשפוך דמי אחיהם והיו מכד יחין בכל שרבט ד ואומרין נוסו בני דן וצאו מארץ ישראל ואלך אל אהץ מצרים ויעצו על ארץ מצרים להחריבה ינלהרוג כל יושביה אמרו להם נשיאיקם למה תלבו למצרים כבר כתוב בתורה לא תוסיפו לראותם עוד עד עולם ועוד היו יועצים על אדום ועמון וכשמצאו כתוב בתורה שהקבה מנע ישראל לירש גבולם נתן בהם הקבה רוח טובה והיו בני דן עולי עד נהר פישון ונוסעים על ה ומלים וחונין עד שהגיעו לנהריכוש ומצאו הארץ שמנה וטובה ויחנה ורחבה שדות וכרמים גנות ופרדסים ולא מצאו יוש יושביה את בני דן ל שבת עמהם וכרתו להם ברית והיו בני כוש פורעים להם מס וישבו עמהם שנים רבות עד שפרו ורבו עד למאד"@he ;
    oa:hasSelector opp:unit_fol_45v_1_u2_selector ;
    oa:hasSource opp:passage_fol_45v_1 .

opp:unit_fol_46r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_46r_1#u1" ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "ואחרי מות סנחריב נסעו שלשה שבטים מישראל והם נפתלי גד ואשר והיו נוסעים וחונים עד שבאו אצר גבולם של שבט דן והרגו באנשיכוש הרבה מהלך מאתים יום על מאתים יום ועושים מלחמה עם שגע מלכויות ממלכי כוש עד היום כל שבט ושבט שלשה חדשים בשנה ושלל השבט לשבטו ובני שמשון עם בנידן והללו ארבעה שבטים חונים בחוילה אשר שם והזהב וישלהם זהב כאבנים וצאן ובקר וגמלים וחמורים וסוסים הרבה מאד וזורעים וקוצרים ויושבים באהכים של שיער ונוסעים וחונים מגבול לגבול מקלך מאתים יום על מאתים יום ומקום שהם חונים שם באהליהם אין לך מקום שתבנס שם רגל ואינם חונים כי אם במקום שדות וכרמים ודנין בארבע מיתות בית דין ועליהם אמר הכתוב מעבר לנהרי כוש עתרי בת פוצי יובילון מנחתי"@he ;
    oa:hasSelector opp:unit_fol_46r_1_u1_selector ;
    oa:hasSource opp:passage_fol_46r_1 .

opp:unit_fol_46v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_46v_1#u1" ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "אין שנין ואין פגע רע והם חונים עשרה ימים על עש ימים מרובע ויש להם מקנה רב גמלים ועתודים ואין מגדלין סוסים ואין להם כלי זיין כי אם מאכלת לפי שהם צריכין אותו לשחוט והם בעלי אמונה ואין בידם עושה ולא גזלה אפי עבדים שלהם אם מוצאין ממון בדרך אין פושט יד לקחתו ושכיניהם רשעים עובדי אש נושאים אמותם ואחיותיהם לנשים ואין להם עבודת אדמה ולא חרישה ולא קצירה ולא עמילת כרמים בלתי הכל בכסף יקנו ויש להם שופט ונשיא וארבע מיתות בית דין בידם ומדברים בלשון קדש ובלשון פרס ובלשון קדר ובני זבולון חונים בהרםי לארן נוטעים אוכלים של שער הבאים מן ארמניא ומגימים עד נחל פרת ושבט ראובן נגדם מאחורי הררי פארן וישביניהם שלום ושלוה ואקבה וביחד מלחמוקם וכריקות הדרכים שכורת בדרך מכות ודרך בבל וכל שללם יחלקו יחדו משא גמל"@he ;
    oa:hasSelector opp:unit_fol_46v_1_u1_selector ;
    oa:hasSource opp:passage_fol_46v_1 .

opp:unit_fol_48v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_48v_1#u1" ;
    opp:earliestWitness opp:work_Midrash_Tanchuma_Buber ;
    rdf:value "וכן אתה מוצא בשעה שהלך יעקב לארם נהרים לייך אצל לבן עשה אצלו עשרים שנה שנ זה לי עשרים שנה בביתיך וכל אותן הימים לא דבר הבה עם יעקב והיה מהרהר ואומר שמא הניחני הקבה לא כך אמ לי הנה אנכי עמך ידע הקבה מה הרהר יעקב אמ לו הקבה אם אתה מבקש שאהיה עמך כשם שאמר לך הכיש עצמך מביתו של לבן הרשע ואהיה עמך ההד ויאמר יי אל יעקב שוב אל ארץ אבותיך ולמולותו ואהיה עמך"@he ;
    oa:hasSelector opp:unit_fol_48v_1_u1_selector ;
    oa:hasSource opp:passage_fol_48v_1 .

opp:unit_fol_4r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_4r_1#u2" ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "מדבר שהא שנוי כיצד אמ ר יוסי בר חנינא ארבעי ושתים שנה היה הרעב כאוי לבא במצרים שכין פרעה רואה שבע פרות ושבע שבלים הרי יד והוא אומר וליוסף שבעפכות ישבע שבלים הרי לח וייסף חוזר ואות שבעפרות ושבע שבלים ודי שם קרער אלא שתי שנים שכ מב ולח על עיהב נמצרים בלה היוב שירד הרלכאוי ואמתי הורו אינן מב שנה ביהי יאזקאל יונד כי זה שנתם נתתי ארן מוצרים שחמה יארבעים שנההיתה כך ולא עשתה אלא לצורך כינוצא בר בר איבה אומי א תבטחו לכם גו לי רנאמ שלשפעמים אמ להם אל בניחו שלש פעמים שזם אנכ עישים רצונו שלמע אין שלש חגיכם כלום וכן הואאומ חדשיכם ומועדיכל שלאה נפשי ואומ שנאתי מאסתי חגיכם דבר חחר אמ להם דאו שלש פעמים מקדשנם שחרב נב וגבעון שילה הזהרו שלא יארב גם זה מסדור שנחלק כישד כי מרבית העם רבת מאפרים גו בעד מי בעד כל לבכו הכין לדרוש את יי האלהים אלהי אבותיו סדור היה ראוי להיות אלא שנחלק מאימתי דנין אותו כסדור משינהג איתו הענן לכך שהוא חולק על דברירעיו ועיני בנים תכלינה סדור היה ראוי להיות אלא שנחלק"@he ;
    oa:hasSelector opp:unit_fol_4r_1_u2_selector ;
    oa:hasSource opp:passage_fol_4r_1 .

opp:unit_fol_51v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_51v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Gerim ;
    opp:earliestWitness opp:work_Tractate_Gerim ;
    rdf:value "חביבה ארץ ישראל שהיא מכשרת את הגרים האומר בארץ שראל גר אני מקבלין אותו מיד ובחוצה לארץ אין מקגלין אותו אלא אם כן היו עידיו עמו חביבה ארץ ישראל שהיא מכפרת את העונות ואת הפשעים שנאמ ובל יאמר שכן חליתי העם היושבים בה נשוא עון ונן אתה מוצא כארבעה כתים העומדים לפני המקום שנ זה יאמר ליי אנני וזה יקרא בשם יעקב וזה יכתוב ידו ליי ובשם ישראל יכנה זה יאמר ליי אני הוא כלו כלו למקום ולא נתערב בו שום חטא וזה יקרא בשם יעקב אלו גיריהצדק וזה יכתיב ליי אלו בעלי תשובה ובשם ישראל יכנה אלו יראישמים סליקא לה מסכת גרים תל מסכת כותיים בעה דרכי כותיים פעמים כגוים פעמים כישראל ורובי כישראל אין מביאין מהן לא קני זבות ולא קני יולדות לא חטאות ולא אשמות אין מקנין אותן במחובר לקרקע ואין מוכרין להם צמר לגזוז ולא תבואה לקצור ולא"@he ;
    oa:hasSelector opp:unit_fol_51v_1_u1_selector ;
    oa:hasSource opp:passage_fol_51v_1 .

opp:unit_fol_5r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_5r_1#u1" ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "חזון ישעיהו בן אמוץ הרי זה ככל ואחר כך פרט בשנת מות המלך עזיהו בשנת מות המלך אאז ויהי בארבע עשרה שנה והשומע סבור שהוא מעשה אחר ואינו אלא פרטו שלראשון מדבר שהוא נתלה בקטן ממנו כיש יערוף כמטר לקחי גו ולי גשמים גדוכים מן התורה שהיא נתלית בהם אלא לפי שהם מרוים את הכל ולהשמיע את האזזכדרך שהא שומעת כיוצא בו אריה שאג מי לא יירא יי אלהים דבר וכי מי נתן כח וגבור לארי הלא מי שאמרוהיה העלם אלא הרי אנו תולין אותו בבריותיו להשמיע את האזן כדרך שהיא שומעת מנני כתובין המכחישין זה את זה כיצך כתוב אחד אומר ויהי כל ישרםל אלפים ומאה אלם איש גו וכתו אחד אומ ותהי ישראל שמנה מאות אלףאיש גו אלו שלש מאות אלת איש מה טיבן בא המכדיע ואמ ובני ישרל למנמירם ראשי האבות ושרי האלפים והמאות ושוטריהם המשרתים את המלך לכל דבר המחלחות הבאה והיוצאת חדש בחדש לכל חדשי השנה המחלנקת האחת עשרים וארבעה אלף הללי שלש מאוק אלםף איש היו כותבח בנימוסו שלמלך ולא היו צריכין להמנות ביצד עשסכ וארבעה אלף לחדש אחד הרי הם מאתים ושמנים ושמנת אלפים לשנים חעשר חדש נשתיירו שם שנים עשר אלף הם נשיאי ישראל השליכן"@he ;
    oa:hasSelector opp:unit_fol_5r_1_u1_selector ;
    oa:hasSource opp:passage_fol_5r_1 .

opp:unit_fol_62r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_62r_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "שהיה יושב בין שני דרכים אמ לל בני באי זו דרך אכנס לעיר בזו או בזו אמ לו הרי שניהם לפניך זו ארוכה וקצרה וזו קצרה וארוכה הלך ר יהושע בקצרה וארוכה כיון שהגיע לחומה של עיר מצא גנות ופרדסים שהם מקיפים אותת חזר לאחוריו ומצא אותו תינוק שיושב במקומו אמ לו בני מפני מה צחקת בי לא כך אמרת לי שבזו הדרך אכנס לעיר שהיא קצרה וארוכה אמ לו ר הרי חכם גדול אתה זו היא חכמתךך הלך ר יהושע ונשקו על ראשו ואמ אשריכם ישראל שכלכם חכמים מגד גליכם ועד קטניכם כיצד מרקדין לפני הכלה בית שמאי אומ כלה כמות שהיא ובית הלל אומ כלה נאה וחסודה אמרו להם בית שמאי לבית הלל לדבריכם אפי חגרת או סומה יאמרו לה כלה נאה וחסודה והלא אמרה תורה מדבר שקר תרחק אמרו להם בית הלל לבית שמאי הרי שלקח מקח רע מן השוק ישבחנו בפניו או יגננו בפניו הוי אומ ישבחנו מכאן אמרו חכמים תהא דעתו של אדם מעור בת עם הבריות ולא יפרוס אדם את המטה במקו הרך אלא במקום הקשה ולא יאחז אדם בביצה פרוסה בידיה ואם עושה כן הרי זה רענתן וגרנרן ולאישתה"@he ;
    oa:hasSelector opp:unit_fol_62r_1_u2_selector ;
    oa:hasSource opp:passage_fol_62r_1 .

opp:unit_fol_70r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_70r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "דא ארוא חיים אין ארח חיים אנלא ייסורין שנ ודר חיים תוכחות מוסר למעלה למשכיל למי שהוא מסתכל במצותיה שלתורה מה כת למעלה מן הענן לא תכלה פאת שדך בקצרך אומות העולם שהן מכלין שדותיהם אעשה כלה אך אותך לא אעשה כלה אלא דסרתיך למשפט מ מיסכך אני בייסורין ובעולם הזה בש ביל לנקותך מעונותיך לעתיד לבא ואימתי כן נכא השבלי בוור נחבש כברכיה פתח תרעי קדש שופר בכסא ליום חגנו וכל החהשים אינן חדט אלא שאר החדשים אינן נכסין אלא ליום חגנו ורלא ניסן ישלו חג בפני עצמו אלא חדש ונכסה ואיזה זה תשרי בחדש הזה חדשו מעשינם בחדש שופר בחדש הזה תספר תשפרו מעשיכם אמ הקבה אם שפרתם מעשיכם לפני הכי אני נעשה לכם כשופר הזה מה שופר זה מכניס בזו ומוציא בזו אף אני יוצא מכסא דין ונכנס ויושב בכסא רחמים ומתמלא עליכם רחמים ומרחם עליכם והופך לכם מדת הדין למרת רחמים אימתי כן בחדש השביעי באחד לחדש ר לוי בשם ר חמא בר חנינא חתא בה אמר גואלך קדוש ישראל אני יי אלהיך מלמדך להועיל מדריכך בדרך תלך מהו מלמדך מסקיד לך בגין הדין מסיקא דהוה מסקיד להדא תורתא וג שמות נקראו לו מלמד מרדע דרבן מלמד שהוא מלמד לפרה לחרוש"@he ;
    oa:hasSelector opp:unit_fol_70r_1_u1_selector ;
    oa:hasSource opp:passage_fol_70r_1 .

opp:unit_fol_71r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_71r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ומה טעמיה האדם הגדול בענקים הוא והארץ שקטה ממלחמ במאזנים לעלות במזל מאזנים מתכפר להם בחדש שמזלו מאזנים ואיזה זה תשרי תשרה כת על שם תשרי ותשבוק לחובנא אימתי בחדש השביעי באחד לחדש בחדש שהוא משובע במצות שופר בתוכו כפור בתוכו נלולב וערבה בתוכו דא ברהש השביעי בחדש שהוא מושבע בכל גתות בתוכו כל מיני מגדים בתוכו דא בחדש השביעי ר ברכיה הוה קרי ליה ידחא דשבועתא שבו נשבע הקבה לאבינו אברהם שנ ויאמר בי נשבעתי נאם יי כי יען אשר עשית את הדבר הזה ולא חשכת את בנך את יחידך מה צורך היה לשבועה זו רבי ברבי רבא בשם ר יוחנן אמ אבינו אברהם לכני הקה רבונו של עולם גלוי וידועהיה לפניך שבשעה שאמרת לי קחנא את בנך את יחידך אשר אהבת את יצחק אמ אברהם לפני הקבה רבון העולמים כשם שהיה בלבי מה להשיבך וכבשתי רצוני ולא השיבותיך כך בשעה שיהיו בניו של יצחק באים לידי עונות ומעשים רעים תהי זוכר להם עקדת יצחק אביהם ומתמלא עליהם רחמים ותהפוך להם מדת הדין למדת רחמים ואימתי בחדש השביעי באחד לחדש וישא אברהם את עיניו וירא והנה איל אחר"@he ;
    oa:hasSelector opp:unit_fol_71r_1_u1_selector ;
    oa:hasSource opp:passage_fol_71r_1 .

opp:unit_fol_73r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_73r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "היה ניצול וכל מי שלאהיה שומע לו היו הגייסות באים והורגים אותו ההד בן אדם צופה נתתיך לבית ישראל ושמעגת מפי דבר ולא הזהרתו ולא דברת להזהיר רשע מדרכו הושעה לחיותו הוא רשע בעונו ימות ודמומידך אבקש ואתה כי הזהרת רשע ולא שב מרשעו ומדרכו הרשעה הוא רשע בעונו ימות ואתה את נפשך הצלת כך אם יתקע שופר בעיר בראש השנה ועם לא יחרדו אם תהיה רעה בעיר ויי לא עשה אין הקבה חכץ במיתתן של רשעים ההד אמור אליהם חי אני נאם יי אם אחפץ במות רשע כי אם בשוב רשע מדרכו וחיה אמ הקבה מה אנא בעי מנכון אלא הודאה ותשובה שנ שובו שובו מדרכיכם הרעים ולמה תמותו בית ישראל וישמעיניה מן הדא דכת דרשוני וחיו עמי מה אנא בעי מנכון אלא דרשוני וחיו לפיכך הושע מזהיר את ישראל ואומר להם שובה ישראל עד יי להיך"@he ;
    oa:hasSelector opp:unit_fol_73r_1_u1_selector ;
    oa:hasSource opp:passage_fol_73r_1 .

opp:unit_fol_73r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_73r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מבטח כל קצוי ארץ אתה הוא בטחונם שלכל העולם וזרועותם בשמך הם בוטחים יוצחי דרכים בשמך הם בוטחים יורדי הים בשמךהם בוטחים שנ יים רחוקים ר חננא ברפפא אמ שאל את רשמאל בר נחמן אמליה מרו רין דכת וים רחוקים אמ ליה נמשלה תשובה בים מה הים לינלם פתיא כך תשובה לעולם פתוא נמשלה תפלה במקוה מה המקוה הזה פעמים פתור ופעמים נעול כך שערי תפלה פעמים פתוחים ופעמים נעולים מה המקוה הזה אדם מבקש לטבול בו ומצא אביו או רבו שם מתבייש והולך לו אבל הים מפליג קימעיא ויורד וטובל ר ברכיה ור חלבו בשם רב ענן בר יוסי אמ שערי תפלה לעולם פתוחין ואתיא כי האי דמרי ר יוסי בר חלפתא שאמ עתים הם לתפלה ובא דויד ופירש דכת ואני תפלתי לך יי עת רצון אלהים ברב חסדך ענני באמת ינ ישעך תאנה בשם ר"@he ;
    oa:hasSelector opp:unit_fol_73r_2_u1_selector ;
    oa:hasSource opp:passage_fol_73r_2 .

opp:unit_fol_75r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_75r_2#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "היה נשיא לראובני הוא בארי הוא בארה ולמה נקרא שמוי בארה שהוא בארה שלתורה ולמה בא בגילה כדי שיחזרו עשרת השבטים לזכותו ולמה ולמה מת משה במדבר בשביל שיחזור דור המדבר לזכותו אי ר ברכיה אמ לו הקבה לראובן פתח פתחת בתשובה תחלה חייך שבן בנך בא ופותח תאלה לישראל בתשובה תחלה זה הושע שאמ להם לישראל שובה ישראל עד יי אלהיך כי לא מחשבותי מחשביתיכם ולא דרב דרכיכם דרכי נאם יח משל ללסכום שהוא נדון לרני קוסטינר בתחלה הוא קורא אנל גון שלו ואמר כך הוא מכה אותו"@he ;
    oa:hasSelector opp:unit_fol_75r_2_u1_selector ;
    oa:hasSource opp:passage_fol_75r_2 .

opp:unit_fol_75v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_75v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "שובה ישראר עד יי אלהיך ר אלעזר בשם ר שמואל בר נחמני אומ משל למדינה שמרדה במלך ושלח לה המלך פדמוכוס אחד להחריבה והיה אותו פדמוכוס בקי ומיושב אמ להם לכם עצה שלא יעשה המלך לכם כדקך שעשה למדינה פלנית וחבירותיה כך אמ הושע לישראל בני עשו השנבה שלא יעשה לכם הקבה כמו שעשה לישומרון וחביחתיה אמרו ישראל לפני הרבה רבונו שנ עלם אם ע עושין אנו תשובה מקבל נו אתה אמ להם תשובתו שלקין קבלתו קבלתי ותשובתכם איני מקבל שנגזרה עליו גזרה קשה ההד כי תעבד את האדמה לא תוסף תתכחה לך וכיון שעשה תשובה נמנעה ממנו סצי גזרה ומנין שעשה תשובה שנ ויאמר קין אל יי גדול עוני מנשוא ומנין שנמנעה ממניו חצי גדיה שנ ויצאקין מלפני יי וישב בארץ לד קדמת עדן מהו ויצאקין ר יודן בשם ר איבו אמ יצא כמפשיל דברים לאחוריו וכ גונב דעת ט מעלה ר ברכיה בשם ר אלעזר בר שמעון אמ יצא כמפרים וכמרמה"@he ;
    oa:hasSelector opp:unit_fol_75v_1_u1_selector ;
    oa:hasSource opp:passage_fol_75v_1 .

opp:unit_fol_76v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_76v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "תשובתן של אנשי ענתות קבלתי ותשובותינם אני מקבל שנגזרה עליהם גזרה קשה ההר לכן כה אמר ייאל אנשיענתיה לאמר המבחשים את נפשך ראמי תנבא בשם יי ז טאתמית בידי ם פוקד עליהם הבחורים ימ בחדב בצם ובנו הם ינ ברעב ושארית לא תהיהלהםכה פקרתם כיון שנ שותשוב כו ענתות שנ אנשי ענתוה מאה ועשר ם ושמנ ותשובותיכם איני מקבל תשובה ל אנשינינהה קלתי ותשובותיכם איני מקבל שגזרה עליהם גזרה קשה ההד ויחל יונה לבא בעיר מהלך יום אד ויקרא ויאמר עוד ארבעים יום ונינוה נהפכית ויגע הדבר אל מלך נינוה ויאמר בנינוה מטעם המלך וגדוליו לאמר האדם והבהמ הנקר והצאן אל יטעמו מאומה ואל ירעו ואל ישתו ויתכסו שקים האדם והבהמה וה בקר ויקראו אל אלהים בחזקה וישובו מדרכם הרעה ומן החמם אשר בכפיהם אמ ר שמעח בן לקיש תשובה של רמאות עשו אנשינינוה מה עשו אמ ר הונא בשם ר שמנכון בן חלפתא העמידו הענלים מבפנים ואמיתיהן מבחוץ סייחים מבפנים ואמותיהן מכון והון אלין מפנין מכא ואלן מכנא אמרין אין לית את את מיחם עלן לית"@he ;
    oa:hasSelector opp:unit_fol_76v_1_u1_selector ;
    oa:hasSource opp:passage_fol_76v_1 .

opp:unit_fol_78v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_78v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר יודי מהו כהו מנינשיכל הרעים ודעוכ ם לזם א רליי לור עישין תשובה יום אחד מזי יהיו מזלם שתה זנע רייםים בקוט תשמעו י אמ ר יודה בר כ זשובה י יזל עד ונ כה ינננ ד אמ ר אלעזר בנוהג שבעולם אדם עומד ומבזד שיה הה ברבים לאחר זמן הוא מבקש להתרצות לו והוא אומ לו והכא בזית אותי ברבים ומתרצה לי ביני ובינך אלא הבא חותם אנשים שבזית אותי לפניהם ואני מתרצהלך אכל הבה אינו כן אלא אדם עומד ומחרף ומגדף לשמו והקבה אומ לו עבה תשובה ביני לבינך ואני מקברך דתץ יששכר איש כפר מנדי כי הוא ידוי מתי שוא וירא און ולא יתבונן בנוהג שבעולם אדם עושה גדישים גדישים של עבירות אם יעשה תשובה כביכול וירא אין ולא יתבונן תני בשם ר מאיר שובה ישראל עד יי להיך עד שהוא עומד במרת רחמים ואם לאו אלהיך עד דלא יתעביד סניגוריא קטינריא שמואל כטא גריסא בשם ר מאיר שמח בחור בילרותיך ויטיבך לבר בימי בחורותיך והלך בדרכי לבך ובמראה עיניך ודע כי על כל אלה יביאך אלהים במשפט שמואל בר"@he ;
    oa:hasSelector opp:unit_fol_78v_1_u1_selector ;
    oa:hasSource opp:passage_fol_78v_1 .

opp:unit_fol_7v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_7v_1#u1" ;
    opp:earliestWitness opp:work_Tractate_Semachot ;
    rdf:value "לא כי על סום ננוס על כן תנוסוז וכלם בו בלשון שחטאו בו בל שון נדונו יומנין שדורשין בגיא מטריא בהגדה אם בחשבון הרי כבר נאמר שמנה עשר ושלש מאות זה אליטזר שהוא חשבונו ואם לחלוף האותיות הרי כבר נאמר ועל ישבי לב קמי ואתה מחליף לב קמי בני מטריא ותמצא כשדים וששו בגי ומטריא בבל טוב בגי מטריא נפם מנון בגי ימטריא סרדה ומנין שדורשח נוטריקון בהגדה תלמוד לומר אבדהם אב המון עים כרמל דך ומל הבר שהוא כןי ינמלל ביד ירט יראה דאתה נטתה נמרצת נואף מאבי רוצח צורר תועבה בצקלונו בא ויצק ליר אנני אנם טמקיז נכתבית יהבית ירבעל ירב בו הבעל ממוקדם ומאוחר שהוא בענין ניצד ש ביו קרא עליו את הפסוק הזה ונהמת באחריתך נכלנת בשרך ושארך ואמרת איך שנאתי מוסר ותוכה נאץ לבי ולא שמעתי לקול מורי ולמלמדי לא הטיתי אזנם כמעט הייתי בכל רע בתוך קכל ועדה גמר וחזר לראש המקרא ואמו קראה עליו את הפסוק הזה כעס לאביו בן ככיל ותוגה ליולדתו אחותו קראה עליו המקרא הזה ערב לאיש לחם שקר ואחר ימלא"@he ;
    oa:hasSelector opp:unit_fol_7v_1_u1_selector ;
    oa:hasSource opp:passage_fol_7v_1 .

opp:unit_fol_81r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_81r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כגון לוי בר סיסי וחברותי שנכנסו גייסות לעירו שקל ם פר תורה ועלה לראש הגג אמ רבון העולמים איבטלית הני מלי מן האי סיפרא ייעטן ליסטי אילא ייזלון להון ואזלו להון תלמידיה עבד הכי יבשה ימיניה ואזול לסטי תלמידיה אחרן עבד כן לא יבשת ימיניה ולא אזול לסטי סבור למימר אין שוטה נפגע ואין בשר המת מרגיש באזמל ושובו אל יי אלהיכם ואמרו אליו כל תשא עון וקח טוב ר יהודה ור נחמיה ב יהודה אומ הכל אתה נושא ועונותינו לא תשא ור נחמיה אמ כלא סב ושבק ולא תסב פלגא ותשבוק פלגא וקח טוב ר נתן בר אחא בשם ר סימון קמרטון דידיה נפש וקח טוב וקח נפש ונשלמה פרים שפתינו אמ ר אבהו דוימשלים אותם הפרים שהיו מקריבין לפניך שפתינו בתפלה שאנו מתפללים לפניך אמ ר יצחק כפרה זו שאתה מכפר על נפ נפשותינו טובה גדולה אתה עושה על נפשותינו ומה עלינו לומר טוב להודות ליי ולזמר לשמך עליון הודו ליי"@he ;
    oa:hasSelector opp:unit_fol_81r_1_u1_selector ;
    oa:hasSource opp:passage_fol_81r_1 .

opp:unit_fol_81v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_81v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Jerusalem_Talmud ;
    rdf:value "אמ ר יוחנן שמיני עצרת לול בפני עצמו פיים בפני עצמי קרבן בפני עצמי רגל בפני עצמו אמ ר יבון בכלם כת וביום וכאו כת ביום מכאן שהוא שהוא רגל בפני עצמו פייס בפני עצמו אמ ר יוסיכהאי דתנינן תמן בשמיני עצרת חזרו לפיים ברגלים קרבן פר איל אחד ברכה אחת אמ ר אילא מכאן שהוא נעון זמן תנינן סוכה כל שבעה כאי זה צד גמר מלאכול כא יקתיר את סוכתו אבל מוריד הוא את הכלים מן המנחה ולמעלה בשביל כבוד יום טוב האחרון ר אבא בר כהנא ור חייא בר אשי בשם רב אמ צריך לפסול סוכתוי מבעיד יום ר יהושע בן לוי אמ צריך לקדש בלילי יום טוב האחרון בתוך ביתו ר יטקב בר אחא בשם שמואל אמ קדש בבית זה ונמלך לו לאכול בבית אחר צריך לקדש פעם שניה ר אחא ור חנינא בשם ר הושעיא הרי שהיתה סוכתו עריבה עלנו הרי זה מקדש בלילי יום טוב האחרון בתוך ביתו ועולה ואוכל בתוך סוכתו ואינו צריך לקדש פעם שניה"@he ;
    oa:hasSelector opp:unit_fol_81v_2_u1_selector ;
    oa:hasSource opp:passage_fol_81v_2 .

opp:unit_fol_82r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_82r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אבין אתיא כשמואל בדר חייא ודר הושעיא בשם ר יהושע בן לוי אמ ר מני ולא פליגי למה דאמ שמואל בשהיתה דעתו לאכול בבית אחר ומה דאמ ר יהושע בן לוי בשאין דעתו לאכול בבית אחר דאמ ר יהושע בן לוי ראויה היתה עצרת שלחג להיות רחוקה ממנו חמשים יום רשם שהעצרת רחוקה מן הפכח ניום משלו משל למה הדבר דומה למלך שבאתה לו שמחה והיו לו בנות נשואות במקום רחוק אלו שהן נשואות במקום רחוק לית ביומיא דייזלון וייתון אמ להן המלך אני ואתם נשמח יום אחד כך בפסח ענ ידי שישראל יוצאין מן החרף לקיץ לפליכך הוא רחוקה ממיו ני חמשים יום דא תביומא ריוליא ייתון ברם הכא על ידי שישראל נכנסים מן הקיץ לחרף ואבק דרכים קשה יתידות דרכים קשה לפיכך אינה רחוקה מן סכות נ יום דלית ביומיא דייזלון ויתון אמ אני ואתם נשמח יום אחד לפיכך צרך הכת לומר ביום השמיני עצרת תהיה לכם הכא את אמ עצרת תהיה לכם ולהלן את אמ עצרת ליי אלהיך אמ ר"@he ;
    oa:hasSelector opp:unit_fol_82r_1_u1_selector ;
    oa:hasSource opp:passage_fol_82r_1 .

opp:unit_fol_82v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_82v_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לפיכך צרך הכת לומ ביום השמיני עצרת אמ ר יודן בשם ר יצחק כל זמן שישראל נעצרים בבתי בנסיות וב בתי מדרשות הקבה עוצר שכינתו עמהם מה טעמיה נעצרה נא אותך ונעשה לפניך גדי עזים אמ ר חגי בשם ר יצחק כל זמן שישראל מקוים להקבה ומתפללין בבתי כנסיות בבתי מדרשות הקבה מקוה את שכינתו עמהם מה טעמיה שנ קוה קויתייא ויט אני וישמע שועתי אמ ר אלכסגדרי משל למלך שבאת לושמחה כל זימי המשתה מטרונה מרמזת לבני כנטין ואומרת להם עד שהמלך בחוריא שלו שאלו צרככם וכיון שלא נתבוננו כבשה להם מטרונה עוד יום אחד כך ז ימי החג התורה מלמדת ומרמזת לישראל ואומ להם שאלו מיי מטר תדע לך שהוא כן בשני כת ונסכיהם בששי ונסכיה"@he ;
    oa:hasSelector opp:unit_fol_82v_1_u2_selector ;
    oa:hasSource opp:passage_fol_82v_1 .

opp:unit_fol_83r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_83r_2#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אבין אין אנו יודעין במה לשמח אם ביום ואם בהקבה ובא שלמה ולימ נגילה ונשמחה בך בך בתירתך בך בישועתך אמ ר יצחק בכב אותיות שהכתבת עלינו בתורה נגילה ונשמחה בך בך בית תרי כף עשרים אלה תעשו ליי במועדיכם ר חוניא בשם ר תנחך בר יודן אמ אלה עשיתם אין כת כאן אלא אלה תעשו ליי במועדיכם התורה מרמזת לחם לישראל ואומרת להם תניין יומא ר ברכיה בשם ר יבא בר כהנא אמ כת ושמרת את החקה הזאת למועדה מימים ימימה התורה מרמזת לישראל ואומרת להם תניין יומא אמ ר יהודה בר סימון כת השקיפה ממעון קדשך מן השמים וברך את עמך את ישראל כל זמן שישראל מוציאין מעשרותיהם כר אוי ואומ לפני המקום רבון העול מים בערתי הקדשמן הבית התירה מרמזת ל שראל ואמרת להם תנין יומא ואתם הדבקים ביי אלהיכם חיים כלכם היום"@he ;
    oa:hasSelector opp:unit_fol_83r_2_u1_selector ;
    oa:hasSource opp:passage_fol_83r_2 .

opp:unit_fol_83v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_83v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כך לשעבר היה הקבה מקבל מתנות קרבנות מלמטן שנ באתי לגני אחתי כלה אמ ר הוניא למדתך התורה דרך ארץ שלא יהא החתן נכנס לחופה תחלה עד שהכלה נותנתלו רשות שנ יבא דודי דודי לגנו ואחר כך באתי לגני אחותי כלה ר מנחם חתניה דר אליעזר בר אבינא אמ בשם ר שמעון בן יאסינא באתי לכאן אין כת כאן אלא באתי לגני לגנוני למקום שהיה נקרא מתחלה שעיקר שכינה בתחתונים היתה ההד וישמעו את קול יי מתהלך מקפץ וסליה ויתחבא האדם אמ ר איבו באותה שעה גבהה קומתו של אדם הראשון ונעשית של ק אמה אמ ר יצחק וצדיקים יירשו ארץ הרשעים הוכן הם פורחין באויר אלא מהו וישכנו לעד עליה וישכינו שכינה עליה עיקר שכינה בתחתונים"@he ;
    oa:hasSelector opp:unit_fol_83v_1_u1_selector ;
    oa:hasSource opp:passage_fol_83v_1 .

opp:unit_fol_84r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_84r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אפריון עשה לו המכך שלמה עדי הלבנון אחרין זה אהל מיעד עשה לו האכך סנמה המלך שהשלום שלו אמ ר יהודה בד ארעאי משל ר מלך שהיה לו בת קטנה ניד שלא הנדילה ובאתה לידי סימנין אמ אין כבידם של בתי שאהא מדבר עמה בפרהסיא אלח עשו לה פסליון ואהא מדבר עמה מתוך פפליון כך כתחלה כת בי נעד ישראל ואוה בהו במצרים דאי אותו שנ וע ברתי בארץ מצרים בלילה הזה בים ראו אותו שו וירא ישראל את היד הגדולה בסיכי ראו אותי פנים בפנים וכיון שקצלו את התורה ונעשו לו לאומה שלימה אמ אין כבודן שלבני שאהא מדבר עמהם בפרהסיא אלא יעשו לי משכן ואהא מדבר עמם מתוך הענן ההד ובבוא משה מעצי הלבנון שנ עצי שטים עומדים עמודיו עשה כסף שני ווי העמודים וחשוקיהם זהב"@he ;
    oa:hasSelector opp:unit_fol_84r_1_u2_selector ;
    oa:hasSource opp:passage_fol_84r_1 .

