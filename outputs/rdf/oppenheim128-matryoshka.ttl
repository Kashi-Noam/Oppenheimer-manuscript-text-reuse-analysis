    opp:closestWitness opp:work_Tractate_Kutim ;
    opp:earliestWitness opp:work_Tractate_Kutim ;
    rdf:value "אלו בברים שאין מוכדין להם אין מוכרין להם לא נבלות ולא טרפות ולא שרצים ורמששים לא סנדל שלי גבלה ולא שמן שלי שנמפי נשנפל לתוכו עכבר ולא רוםכום ולא שליל אעפ שישראל אוכלין אותן כוסכוס ושכיל אין מוכדין אותם להם מפני ממכר לועות וכשם שאין מוכרין להם כך אין לוקחין מהם שנ כי עם קדוש אתה ליי אדהיך כשאתה קדום לא תעשה עם קדוש אחר למעלה ממך נאמן הכותי על נטע רבעי ועל הערלה ועל הציונות אבל לא על הסכנות ולא על הפורענות לא על ארץ העמים ולא על בית הפרס מפני שנחשדו בהם זה הכלל בדבר שנחשדו אין נאמנין עכו לרוק בנ אין לוקחין בשר מעבחכותי אלא ממה שהוא אוכל ולא דקריות של צפרים אלא אם כן ולא שיתן הוא לו שכבר נחשדו שמאכילין את ישראל נבלות"@he ;
    oa:hasSelector opp:unit_fol_52v_1_u1_selector ;
    oa:hasSource opp:passage_fol_52v_1 .

opp:unit_fol_52v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "128"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_52v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_52v_1#u2" ;
    opp:closestWitness opp:work_Tractate_Kutim ;
    opp:earliestWitness opp:work_Tractate_Kutim ;
    rdf:value "ולא טרפות ולא שרצים ורמששים לא סנדל שלי גבלה ולא שמן שלי שנמפי נשנפל לתוכו עכבר ולא רוםכום ולא שליל אעפ שישראל אוכלין אותן כוסכוס ושכיל אין מוכדין אותם להם מפני ממכר לועות וכשם שאין מוכרין להם כך אין לוקחין מהם שנ כי עם קדוש אתה ליי אדהיך כשאתה קדום לא תעשה עם קדוש אחר למעלה ממך נאמן הכותי על נטע רבעי ועל הערלה ועל הציונות אבל לא על הסכנות ולא על הפורענות לא על ארץ העמים ולא על בית הפרס מפני שנחשדו בהם זה הכלל בדבר שנחשדו אין נאמנין עכו לרוק בנ אין לוקחין בשר מעבחכותי אלא ממה שהוא אוכל ולא דקריות של צפרים אלא אם כן ולא שיתן הוא לו שכבר נחשדו שמאכילין את ישראל נבלות שוה הכותי לישראל בכל מקום שבתורה ישכל שהרג את הכותי וכותי שהרג את ישראל בשוגג גולה ומחיד גנהרב שור של ישראל שנגח שור של כובי סטוד שור של כותי שנגח שור של ישראל אם הם משלם זצי נזקי ואם מועד משלם נזק שלם ר מאיר אומ שור של כותי שנגח שורנשל ישראל בין תם בין מועד משלם נזק שלם מן העליה"@he ;
    oa:hasSelector opp:unit_fol_52v_1_u2_selector ;
    oa:hasSource opp:passage_fol_52v_1 .

opp:unit_fol_52v_1_u2_selector a opp:TokenPositionSelector ;
