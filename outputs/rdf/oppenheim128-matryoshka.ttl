opp:unit_fol_58v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_58v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "ומי הוא דיינה ידע שאין דיינו בשר ודם אלא אדון כל המעשים ברוך הוא שאין לפניו לא עולהד ולא ישכחה לא משואכנים ולא מקח שוחד ומה עתיד להיות עפר רמה ותולעה שנ אף כי אנו רמה ובין אדם תולעה ר שמעון אומ רמה בחייו ותולעה במותו רמה בחייו אלו הכנים ותולעהה במיתו זהו שמרחיש במותו ר אליעזר בן יעה אומ אדם צאה ומשובח ומוציא דבר מגונה מעיו משל למה הדבר דומה לטרקלין גדולה וביב של בורסקי קבוע בתונה כך אדם נאה ומשיבח ומוציא דבר מצונה מפיו אם מוציא ממעיו פוליטון או אנה אפרסמון או אחד מכל מינ בשמים עלאחת כמה וכמד שהיה מתגאה על"@he ;
    oa:hasSelector opp:unit_fol_58v_1_u1_selector ;
    oa:hasSource opp:passage_fol_58v_1 .

opp:unit_fol_58v_1_u1_selector a opp:TokenPositionSelector ;
