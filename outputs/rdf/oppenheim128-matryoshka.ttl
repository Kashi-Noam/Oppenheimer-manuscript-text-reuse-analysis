opp:unit_fol_78v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_78v_1#u2" ;
    opp:closestWitness opp:work_Kohelet_Rabbah ;
    opp:earliestWitness opp:work_Kohelet_Rabbah ;
    rdf:value "אמ ר יודי מהו כהו מנינשיכל הרעים ודעוכ ם לזם א רליי לור עישין תשובה יום אחד מזי יהיו מזלם שתה זנע רייםים בקוט תשמעו י אמ ר יודה בר כ זשובה י יזל עד ונ כה ינננ ד אמ ר אלעזר בנוהג שבעולם אדם עומד ומבזד שיה הה ברבים לאחר זמן הוא מבקש להתרצות לו והוא אומ לו והכא בזית אותי ברבים ומתרצה לי ביני ובינך אלא הבא חותם אנשים שבזית אותי לפניהם ואני מתרצהלך אכל הבה אינו כן אלא אדם עומד ומחרף ומגדף לשמו והקבה אומ לו עבה תשובה ביני לבינך ואני מקברך דתץ יששכר איש כפר מנדי כי הוא ידוי מתי שוא וירא און ולא יתבונן בנוהג שבעולם אדם עושה גדישים גדישים של עבירות אם יעשה תשובה כביכול וירא אין ולא יתבונן תני בשם ר מאיר שובה ישראל עד יי להיך עד שהוא עומד במרת רחמים ואם לאו אלהיך עד דלא יתעביד סניגוריא קטינריא שמואל כטא גריסא בשם ר מאיר שמח בחור בילרותיך ויטיבך לבר בימי בחורותיך והלך בדרכי לבך ובמראה עיניך ודע כי על כל אלה יביאך אלהים במשפט שמואל בר רב יצחק בקשו חכמים לגנוז ספר קהלת שמצאו דברים שהם מטין לדרך המינות"@he ;
    oa:hasSelector opp:unit_fol_78v_1_u2_selector ;
    oa:hasSource opp:passage_fol_78v_1 .

