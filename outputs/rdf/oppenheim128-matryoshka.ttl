opp:unit_fol_171r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_171r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    rdf:value "יג ספרי תורה כתב משה יב ליב שבטים וא לשבטו שללוי מוציא ספר תורה שלו ומגיהו מתוכו יא שבטים בירך משה ולמה לא בירך לשבטו של שמעון לפי שהיה בלבו עליו על אותו מעשה שעשה בשטים שנ וישב ישראל בשטים ואומ ושם איש ישראל המכה אשר הכה את המדינית זמרי בן סלוא נשיא בית אב לשמעוני ובשביל כן כא ו ואער טפלו עם יהודה שנ וזאת ליהודה ויאמר שמע םיקול יהודה ואין שמעג זה אלא שמעון כדא כי שמע יי כי שנואה אנכי ותקרא את שמו שמעון אמ ר יהושע דסכני משל לשור שעשקיו רעים כעם עללו אדניו אמרו לו לך וצייר צורת ארי באבוסו כדי שיהא מביט ומתיירא כשיראו כך שמעון נמשל בשור ויהודה לארי לפיכך טפלו ליהודה ובשביל שלא בירכו לא העמיד מלך משבטו והא כתו מלך זמרי בתרצה שבעת ימים אמ ר יודן לית שבעת ימים לבר במלכות כלום יא מזמורות אמ משה כנגד יא שבטים שביקך ואלו הן תשב אנוש עד דכא זה שבטו שלראובן שהיו כלם בעלי תשובה למקום יושב בסתר עליון זה שבטו של לוי"@he ;
    oa:hasSelector opp:unit_fol_171r_1_u1_selector ;
    oa:hasSource opp:passage_fol_171r_1 .

