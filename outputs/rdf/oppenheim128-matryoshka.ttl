opp:unit_fol_191r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_191r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tehillim ;
    opp:earliestWitness opp:work_Midrash_Tehillim ;
    rdf:value "אמר יי התבוננו וקראו למקוננות ותבואילה ואל החכמות שלחו ותבאנה אמרו בשעה שהגלה נבוכד נצר הישע את ישראל לבבל לא הניחום הרודפים לשוב עד שהויעיי שרגיעו לנהרוה בכל שנ על נהרות בבר שם ישבנו גם בכינו ללמדך שהיו רודפים אותם בעל כרחם לקיים מה שנאמ קלים היו רודפינו כיון שהגיעו לפרת היה נבוכד נר הרשע יושב בספינה וכל גדול כשדים מימינו ומשמיכו וכל מיני זמר לפניהם שנ וכשדים באניות רנתם כיון שנשא עיניו אותו רשע וראה את שרי יהודה הולכים ערומים ושלשלאות בצוארם על שפת הנהר אמ מפני מה הכל הולכים בלי משוי אין לכם משא שתתנו עליכם מיד הביאו שקים ועשו אותם בחמת ומלאו אותם חול והניחו על צוא צואריהם וכפפו את קומתם לקיים מה שנ על צארנו נרדפ באותה שעה געו כלם בבניה עד שעלתה בכייתם במרום"@he ;
    oa:hasSelector opp:unit_fol_191r_1_u1_selector ;
    oa:hasSource opp:passage_fol_191r_1 .

opp:unit_fol_191r_1_u1_selector a opp:TokenPositionSelector ;
