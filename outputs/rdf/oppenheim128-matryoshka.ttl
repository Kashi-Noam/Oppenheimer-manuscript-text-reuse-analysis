opp:unit_fol_66r_1_u3 a opp:TextUnit ;
    rdfs:label "fol_66r_1#u3" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "ואל אכשל בדבר הלכה ולא בשום דבר בעולם ותצילנר מכל מיני מזיקים מכל מיני פורעניות המתרגשות לבא בעולם שלא יזיקו בי בין ביום בין במלילה אמן יהי רצון מלפניך יי להי שתראלי בשמחתה של ירושלם ונחמותיה אמן חסלת מדת דרך ארץ תל דרך ארץ זוטא בעה דרכן של הלמידי חכמים ענו ושכל רוח אריה וממולא עלוב ואהוב לכל אדם שפל לא נשיביתו ירא חטא ודורש את האדם לפי מעשיו ואומ כל מה שיש בעולם הזה אין לו חפץ בהם יושה ומשנה ומטנף כסותו לפני רגלי תלמידי חכמים ואין איש רואה בו דבר רע שואל כענין ומשיב כהלכה"@he ;
    oa:hasSelector opp:unit_fol_66r_1_u3_selector ;
    oa:hasSource opp:passage_fol_66r_1 .

opp:unit_fol_66r_1_u3_selector a opp:TokenPositionSelector ;
