opp:unit_fol_50r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_50r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Gerim ;
    opp:earliestWitness opp:work_Tractate_Gerim ;
    rdf:value "העבד שטבל לפני רבו לבן חורין מעשה בבלוריה המלוה שטבכה מקבם עבדיה בפניה ומהצתן לאחריה ובאמ שה לפני חובנה אמחו אלו שטבלו בפניה בני חורין ושלבל לאחריה מ יעבדין בשם שוכנם לבדותמצות בשנום כך נכנס למילה ולטבילה ולהרבן שניא מעכבין ואחד נומערב ר אליעזר בן יעקב אמ אוף הקרבן מעלב בך היהה אליעזרבן יעקב אומ גר שנעגיר צריך להפריש ממנו ביעית לקטרתר שהעון אומ איטציב נכרעים מן הגיים בדברי ר יוםי ר יודה אימר אין בכרעין אלא הרי הוא כבן אמו אמ ר חנינאבן גמליאל מפני מה הנרים מאמינים מפני שהם מהשבן קודם לשנה וקודם לשתים שאובה את חובי ושאעשת הת רצוני אמ לר יוסי אלו ממון נחסרין הריהוא בדבריך אלא שהם קוברים בנים ובני בנים וחלאים רעים דים רין באין עליהם מכני מה מאמינין מפני שבע צות שנצטוו עליהם בני נח שנפק פרהא אי זהו גר תישב כל"@he ;
    oa:hasSelector opp:unit_fol_50r_1_u1_selector ;
    oa:hasSource opp:passage_fol_50r_1 .

opp:unit_fol_50r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "166"^^xsd:nonNegativeInteger ;
    oa:start "27"^^xsd:nonNegativeInteger .

opp:unit_fol_50v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_50v_1#u1" ;
    opp:closestWitness opp:work_Tractate_Gerim ;
    opp:earliestWitness opp:work_Tractate_Gerim ;
    rdf:value "ולא ביוה דעד אלא דנוה יפה באמצע ארץ ישראל במקום שאו מנותם אנומק שנ עמר ישב בקרבך במקום אשרין חרבת שערי לא תונו כל ערוה שישראל מצונ עליה מיתת ביתדין אין הגוים מצווין טליה מנתתצה דין הא פצי היה נשאי אחות אביא ויני אחית אביו ואם ר משר אומ יוציא וחכמים אול יקיים שתי אחיו האם מאיר אומ חציא וחכמים אום דיום ישראל שבא על נכרית וילדה ידנזנביני וכםייתכיי שבא על בת ישראל וילדה ידון כדיני ישאל גר שמת זהניח בן גוי או שנתגייר ובניו ליצו נכשו אנ קרץ הצבי ועבדיו בני חורין אם הא העברים פקחין לקני שינה מפני שאמרו צלסים שאין להם אחם ותתת לקנין במשינה ושיש לה אזדיות נקנח במסיכה אניעזד אומ נ ברזקת בל אלא טאלש הה בת בההו ואמ שד השל וחכמים אומ לא ה ששיחזק זה בא מן הדרום וזה בא מן הצר זנהלי קים הלוכו וזה זכה למקום הלונו"@he ;
    oa:hasSelector opp:unit_fol_50v_1_u1_selector ;
    oa:hasSource opp:passage_fol_50v_1 .

opp:unit_fol_50v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "185"^^xsd:nonNegativeInteger ;
    oa:start "39"^^xsd:nonNegativeInteger .

opp:unit_fol_51r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_51r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Gerim ;
    opp:earliestWitness opp:work_Tractate_Gerim ;
    rdf:value "לא תינה ולח תלחצנו לאתוננו בדברים ולא תלהצנו בממון אל תאמרלו אמשהיית עובד לבל ונבו ועד עכשו חזירך בין שניך ואתה עומד ומדבר עמי ומנין לאונאתו שהיא אסורה שנ וגר לא תונה כי גרים הייתם בארץ מצרים מכאן היה ר נתן או מום שבך אל תאמנר לחבירך ר ארי עזר בן יעקב אומ הגר לפי שסורורע הזכיר עליו הכת במקומו הרבה שנ וגר לא תונה ולא תלחצנו וגר לא תלחץ ואתם ידעתם את נפש הגר הא למדת לפי שסורו רע הזהיה תורה עליו במקומות הרבה"@he ;
    oa:hasSelector opp:unit_fol_51r_1_u1_selector ;
    oa:hasSource opp:passage_fol_51r_1 .

opp:unit_fol_51r_1_u1_selector a opp:TokenPositionSelector ;
