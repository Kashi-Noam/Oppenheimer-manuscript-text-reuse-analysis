opp:unit_fol_145r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_145r_2#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "וילכו אחרי הדבל ויהביי ומ ר צחק מל לטז והכים שיצא עליו שייר וזוד יהוא מתירא ואומר תאמד יידטר חוב זה שלק זהובים של ד זהובים הוא אמ לר בעל יוניי א יתתייגע כור שלכובים שלעורים הוא מה רהויא כרויג והא כך המ יוקבה לישחל בני עא שאתם להוטם אחריה אינה דבר של ממש אלא הבר המה מעשה תעתועים לא כאלה חלק יעקב"@he ;
    oa:hasSelector opp:unit_fol_145r_2_u1_selector ;
    oa:hasSource opp:passage_fol_145r_2 .

