opp:unit_fol_178v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_178v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Lekach_Tov_on_Lamentations ;
    opp:earliestWitness opp:work_Midrash_Lekach_Tov_on_Lamentations ;
    rdf:value "משנכנס אב ממעטק בשמחה ט באב שרל להיות בשבת אסורין לספרד ולכבס ובחמשי מותרין מפני בבוד השבת קודם תענית אסור לאחר תענית מותר ערב טבאב לא יאכל אדם ב תבשילין ולא יאכל בשר ולא ישתה יין אמ רב יהודה אמ רב כך היה מנהגוי שלר יהודה בר אלעאי ערב ט באב היה צשב בין הנור וכירים ומביאין לו פת חריבה ואוכלה במלח ושותה עליה קיתון שלמים ודומה כמי שמתו מוטל לחננו והלכה ט באב שחל להיות בשבת אוכל ושי ושותה כל צרכו ומעלה על שלחנו אפי כס עודת שלמה בשעתה תנו רבנן מקום שנהגו לעשות מלאכה בט באב עושן ומקום שנהגו שלא לעשות אין עושין בכל מקום תלמידי חכמים בטלים רבן שמעון בן גמליאל אומ יעשו כל אדם ערצמם כתלמידי חכמים וכל העושה מלאכה בט באב אינו רואה ממנה סימן ברכה לעולם וכל האוכל ושותה בט באב"@he ;
    oa:hasSelector opp:unit_fol_178v_1_u1_selector ;
    oa:hasSource opp:passage_fol_178v_1 .

opp:unit_fol_178v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "137"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_178v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_178v_1#u2" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "ולא יאכל בשר ולא ישתה יין אמ רב יהודה אמ רב כך היה מנהגוי שלר יהודה בר אלעאי ערב ט באב היה צשב בין הנור וכירים ומביאין לו פת חריבה ואוכלה במלח ושותה עליה קיתון שלמים ודומה כמי שמתו מוטל לחננו והלכה ט באב שחל להיות בשבת אוכל ושי ושותה כל צרכו ומעלה על שלחנו אפי כס עודת שלמה בשעתה תנו רבנן מקום שנהגו לעשות מלאכה בט באב עושן ומקום שנהגו שלא לעשות אין עושין בכל מקום תלמידי חכמים בטלים רבן שמעון בן גמליאל אומ יעשו כל אדם ערצמם כתלמידי חכמים וכל העושה מלאכה בט באב אינו רואה ממנה סימן ברכה לעולם וכל האוכל ושותה בט באב כאלו אוכל ושותה ביום הכפורים וחכמים אומ כל האוכל ושותה בט באב עונותיו חקוקים על טצמותיו שנ ותהי עונותם על עצמיתם וכל המתאבל על ירושלם יזכה ויראה בשמחתה שנ שמחו את ירושלם וגילו בה כל איהכיה שישו אתה משוש כל המתאבלים עליה"@he ;
    oa:hasSelector opp:unit_fol_178v_1_u2_selector ;
    oa:hasSource opp:passage_fol_178v_1 .

