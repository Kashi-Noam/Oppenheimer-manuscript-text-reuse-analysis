opp:unit_fol_36v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_36v_1#u2" ;
    opp:closestWitness opp:work_Bereishit_Rabbah ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "יותר ממשאוי אמ ליה לא תיהוי אמרכן אלא הוי אמר ברוך האל הנאמן כד הוה צערא קשה עלוי יתר מזצרכה הוה סליק ר חנינא ואמ עלוי מילה והוה נייח בתר יומין איבאש ר חנינא סלקר אנ יוחנין מבקדא יתיה אמ ליה מה אית לך אמ לו מה קשים הייסורין אמ לו ומה הוית אמר עלאי אמ ליה כד הוינא לברא הוינא הוינא עריב אוחרנין וכדון דאנא לגאו אנא בעי מאן דיערבני אמ לו אין שרביטו של הקבה ממשמש ובא אלא בבני אדם שליבן כך כשושן הוי הרועה בשושנים אמ ר אלעזר לבעל הבית שהי לו שתי פרות אחת כחה יפה ואחת כחה רע על אי זהמהם הואמטריח על זו שכחה יפה כך אין הקבה מנסה את הרשעים שאיזן ירונין לטמוד שנ והרשעים כים נגרש ואת מי הוא מנסה את הצדיקים שנ יי צדיק יבחן וכן הוא אומ והאלהים נסה את אברהם ויהי אחר הדברים האלה ותשא אשת אדני את עיניה על מי"@he ;
    oa:hasSelector opp:unit_fol_36v_1_u2_selector ;
    oa:hasSource opp:passage_fol_36v_1 .

opp:unit_fol_36v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "173"^^xsd:nonNegativeInteger ;
    oa:start "21"^^xsd:nonNegativeInteger .

opp:unit_fol_37v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_37v_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "קראתי שמך יי מבור תחתיות זה דניאל שנתפלל לפני הקבה מן הבור ושמע הקבה קול תפלתו והבילו מן הארים ההד קולי שמעת גו קרבת ביום אקראך גו וכן הוא או שלהי שלח מלאכיה וסגר פום אריוותא ולא חבלוני כלקבל דיקדמוהי זכו השתכחת לי ולא די שהצילו אלא שנקמו מאויביו ההד רבת יי ריבי נפשי גאלתחיי וכן הוא אומ ואמר מלכא והיתיו גובריא אליך די אכלו קורבוהי די דניאל ולגוב אריוותא רמו אינון בניהון ונשיהון ולא מטו לארעית גובא עד די שליטו בהון אריוותא וכל גרמיהון הדיקו הרי מצינו שניצל דניאל מן הבור מן המקרא ורבותינו אמרו מסורת היא בידינו שפעם אחרת ניצל דניאל מבור אריות בימי כרש הפרסי על שכפר בעז וביערה אמרו מלכא אסטיגום אתאסף על אבהתיה וקביל כורש פרסאה מלכותיה ודניאל איתווא איקרייה עם דמלכא ועמד ווא עם מלכא ומשבח ווא מן כולהון וחמוי דמלכא ואיתווא פתכרא חד לבבליי דשמיה ביל ומפקין ווא עלו נפקתא כל יום סמידא תרי עשר ארדבין ודיכרי ארבעין וחמרא שית מתרין והוה מלכא דחיל ווא ליה ואזיל ווא ליה כל יום וסגיד ווא ליה ודניאל סגיד ווא לאלהא ואמר מלכא לדני אל מטול מאן לא סגדת לבל אלהי אמר ליה דניאל"@he ;
    oa:hasSelector opp:unit_fol_37v_1_u1_selector ;
    oa:hasSource opp:passage_fol_37v_1 .

opp:unit_fol_37v_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "188"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_39r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_39r_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereshit_Rabbati ;
    rdf:value "לדניאל דרמי בגוב אריואתא גצצל אמר חבקוק מר לא חזא לי בבל ולגובא לא ידענא ליה וישדי מלאכא אידיה וגל רישיה דחבקוק ושר לית בם ערא דר ישי וסאמיה לבבל יעיל מן גובא בעהא די וחא רהודשא וקרא חבקוק ואחר רניאל דניאל קום שהול שירותא הרא דשד לך חלהא אמר רניאל אתרכרן אלהא ולא שבק רחמוי מיני וידענא דלא שבקת לאיינין דיחמן לך ורם דניאל ואכל ושקליה מלחנא לחבקוק ביה בשעתא ואקימיה באתרא דשניה הייך דהוומן קדם דין ואתא מלכא ליומא דשבעה למיבכי ענידניאל מטונ דגריאות ליה עליוא א לות גובא ואדיק בגובא וחזייה לדניאל כד יתיב ויהב קלח רמא וקמר רב הוא אלהיה דדניאל ואסקיה לדניאל מן גובא ולבעינ דבבוי דדניאל הינין דאכלו קורצוי ובעון למיקטניה אשרי אינון בגובא ובה בשעתא אכלו אינון אריוואתא קדמוי דמלכאו ודם דניאל לכך נאמר צמתו בבור חיי וידו אבן בי צפו מים על ראשי"@he ;
    oa:hasSelector opp:unit_fol_39r_1_u1_selector ;
    oa:hasSource opp:passage_fol_39r_1 .

opp:unit_fol_39r_1_u1_selector a opp:TokenPositionSelector ;
