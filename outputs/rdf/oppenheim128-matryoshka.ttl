    oa:start "27"^^xsd:nonNegativeInteger .

opp:unit_fol_69r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_69r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "הוי עכוב ואהוב להשיב ליודעך עלובואהוב לכלאודם ולאנשי ביתך יותר מכל אדם תחלת נדדים פתח לחום תחשת טמאות פתח לעז קלות ראש פתח ליי אוף אם ערבת על מנת לשלם ואם לוית עלמנת לפרוע ואם הלותת על מנת לתבוע הוימחשב להשיב ולפכוק את החשבון קנה שם טוב קנה ליצמו קנה דברי תורה קונה לו חיי העולם הבא אין הביישן למד ואין הקפדן מלמד ולא כל המרבה סזור חכם חמש עשרה מדות נאמרו בתלמיד חכם נאה בביאתו חסיד בישיבתו ערום ביראה פקח בדע חכם בדרכיו כונס וזכרן מרבה בישיבנה מלבה להשם שואל כענין ומשיב כהלכה ומוסיף על כל פכרקו וכרק דבהק הולך אצל חרם למד על מנת לרמד ועל מנת לעשות אל תהיה כאסקופה העליוכמ שמנועת את הרגלים אלא כאמצעית שכל היושב עלית זועף וסופה להסתר היה כאסקופה התחתונה שרוב בני אדם דורסין אותה לסוךל כל הבניין כלו נסתר והיא במקומה עומדת סניק פרקא תלמידי חנמים נאים בחבורה ואין עמי הארץ נאים בחבורה"@he ;
    oa:hasSelector opp:unit_fol_69r_1_u1_selector ;
    oa:hasSource opp:passage_fol_69r_1 .

