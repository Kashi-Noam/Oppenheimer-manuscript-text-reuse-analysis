    rdf:value "ברצות יי דרכי איש גם אויביו ישלים אתו ר מאיר אומ זה הכלך ור יהנשע בןלוי אמ זה הנחש ור מאיר אומ זה הכלב רעוא חלבון אתא חויא דאכל מיניה חמתיה כלבא יתבין למיכל שר נבח בהון ולא אותבינון אתא קם ואכל מיניה ומית וקברוניה ועברון ליה נפש ועדכרון היא מתקריאנפש דכל בא ור יהושע בןלויאמ זה הנחש חד בר נש שחיק טמיא אתיא חויא דטורא אכל מיניה חמתיה חויא רביתא שרי מתרתר עליהוזן עפרא ולא אותביכון לסופא רק גרמיה לגויה"@he ;
    oa:hasSelector opp:unit_fol_127r_1_u2_selector ;
    oa:hasSource opp:passage_fol_127r_1 .

opp:unit_fol_127r_1_u2_selector a opp:TokenPositionSelector ;
