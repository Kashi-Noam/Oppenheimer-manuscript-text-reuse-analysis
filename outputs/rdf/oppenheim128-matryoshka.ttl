opp:unit_fol_152r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_152r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "דא אמ להם אם הורג אני אתכם עכשויהיו המצריים אומ כת של בחוריםראה ואמ אלו אחי ואחד כך מצא עליהם עלה והדגן דא אמ להם אם הורג אני אתכם עכשו יהיו המצריים אומ עם אחיו לא שמר אמונה ועמנו ישמור אמונה לפיכך וינחם אותם וידבר על לבם והרי הדברים קל וחומר ומה אם יוס שדבר על לבם שלאחיו דברים טובים דברים נחומים נתיישב לבם כשיבא הקבה לנחם את ירושלם על אחת כמה וכמה שאמ נחמי נחמי עמי"@he ;
    oa:hasSelector opp:unit_fol_152r_1_u1_selector ;
    oa:hasSource opp:passage_fol_152r_1 .

opp:unit_fol_152r_1_u1_selector a opp:TokenPositionSelector ;
