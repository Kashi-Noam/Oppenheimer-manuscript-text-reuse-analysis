opp:unit_fol_134v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_134v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר אלעזר בר שמעון אתמני אנגדא בטים מפיק עבורא חד זמן אתא לגביה בדמית חדסב אמ ליה אתקין לי בעירא אמ ליה מה אית גבך למטען אמ ליה חדא שחיק חפסאטי והדא גולטי ומרכות אמ ליה אתון חמיין להדין סבא דאנא טעין לי ומאזיל ליה לסופא דעלמא ואת אמ התקףן לי התקין לי בעירא ארכביה והוו מלקין טורין ומחיק ליה גלמן מעביר ליה חקלין דכובין וחכלין דדכדרין לקופא שרי מנאטל גרמיה ערוי אמ יליה סבא ג קליל וגירמך ואלא אתא מקלח לך אמ ליה בעי את"@he ;
    oa:hasSelector opp:unit_fol_134v_1_u1_selector ;
    oa:hasSource opp:passage_fol_134v_1 .

opp:unit_fol_134v_1_u1_selector a opp:TokenPositionSelector ;
