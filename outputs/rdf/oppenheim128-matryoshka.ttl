    rdfs:label "fol_92r_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "לו הקבה משה לא כשם שאתה סבוד אלא ואמרת להם זה האשה אשר תקריבו ליי כבשים בני שנה שנים ליום ולא שניהם בבת אחת אלא אחד בשחרית ואחד בין הערבים שנ את הכבש אחד תעשה בבקר ואת הכבש השני תעשה בין הערבים ובשעה שאמ לו ונתנו איש כופר נפשו אמ משה לפני ההבה רבון העולמים מי יוכל ליתן פדיון נפשו שנ אח לא פדה יפדה איש ולא יתן לאלקים כפרו וייקר פדיון נפשם וחדל לעולם אמ לו הקבה למשה משה לא כשם שאתה סבור אלא זה יתנו כזה יתנו רב הונא בשם רב אמ שדי לא מצאנוהו שגיא כח לא מצינו כח גבורתו של הקבה ואינו בא בטרחות עם ישראל כיון ששמע משה כך התחיל משה משבח בישראל ואומ להם אשרי העם שככה לו אשרי שאל יעקב בעסרו זובר עין אבתיו אל ייי וחטאת אמו אל תמח וכי אבופיו של עשו הרשע רשעים היו והלא צדיקים גמורים היו אברהם זקנו יצחק אביו ואתה אומ יזכר עון אבותיו אל יי אלא חטא שחטא על אבותיו ומה חטא חטא על אבותיו אתה מוצא חי בשנותיו של אברהם יצחק חיה קפי שנה ואברהם קעב אמ ר"@he ;
    oa:hasSelector opp:unit_fol_92r_1_u2_selector ;
    oa:hasSource opp:passage_fol_92r_1 .

