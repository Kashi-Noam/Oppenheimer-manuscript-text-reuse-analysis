    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "מיד הניח ידיו על ראשו והיה צועק ובוכה אמ שמא חס ושלים אין להם לישראל תקנה יצתה בת קול ואמרה זית רענין יפה פרי תאר קרא יי שמך מה זית זה תחלתו כסופו אף שראל אחריתן כתחלנן לקול המלה נדולה לקל מיליהק ומתלים נתירעפי תכו ישאל ראמ רחינש ברפהא דברגדול הבח מרלים באורה שעה שנ כי חזק הוא ממנו אל תקריפ ממנו אלא ממנו כביכול אפי בעל הבית אינויכול לה וציא כליו משם אמ ר יהושע בן לוי למה נמשלו ישראל בזית לומר לך מה זית זה אין עליו נושרין לא בימות החמה ולא בימות הגשמים אף ישראל אין להם בטלה לא בעולם הזה ולא בעולם הבא אמ ר יחכן למה נמשלו ישראל בזית לוא לך מה זיתזה אינו מוציא שמנו אלא על ידי כתישה אר ישראל כן איכן חוזרין למוטב אלא על ידי ייסורין"@he ;
    oa:hasSelector opp:unit_fol_178r_1_u1_selector ;
    oa:hasSource opp:passage_fol_178r_1 .

opp:unit_fol_179r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_179r_1#u1" ;
    opp:earliestWitness opp:work_Jerusalem_Talmud ;
    rdf:value "ה דברים ארעו את אבותינו בי בתמוז וה בט באב ביז בתמוז נשתברו הלוחות ובטל התמיד והובקעה העים ושרף אפוסטומוס את התורה והועמד צלם בהיכל בט באב נגזר על אבותינו שלא יכנסו לארץ וחרב הבית בראשונה ובשניה ונלכדה ביתר ונחרשה העיר חרב הבית בראשונה מנלא דכת ותשא כל העדה ויתיו את קולרי ואמי ואמ רבא ואיתימא ר יוחנן אותו הלילה ט באב היה אמ להם הקבה לישראל אתם בכיתם בכיה של חנם אני אקבע לכם בכיה לדורות חרב הבית בראשוכה מנא לן שנ בחדש החמשי בתשעה לחדש היא שנת תשע עשרה שנה וכת וישרף את בית יי ואת בית המלך וכת בחמשי בשבעה לחדש אי איפשר לומ שבעה שכבר נאמר תשעה הא כיצר בא בחדש נכנסו גוים להיכל ואכרו ושתו ויקלקלו שביעי ושמיני ותשיעי סמוך לחשיכה הציתו בו את האור והיה"@he ;
    oa:hasSelector opp:unit_fol_179r_1_u1_selector ;
    oa:hasSource opp:passage_fol_179r_1 .

opp:unit_fol_179v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_179v_1#u2" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "תנו רבנן כשחכב הבית בראשונה פרחי כהונה שבאתו הדור נטלו מפתחות של בית המקדש בידם ועלו לינ ההיכל ואמרו לפני הקבה רבונו של עולם הואיל ולא זכינו להיות לפניך גזברים נאמנים הרי המפתחות מסורים לך וזרקום כלם מעלה ועאה נאנא נסתידי ונאולתא מנהל ומי הם קפינו וננא נתב לתוך האור ונשרפו ועליהם קונן ישעיה משא גיאחזיון מה לך איפה כי עלית כלך לונת תשואות מלאה עיד הומה ואף הקבה מקרקר עליהם כתרנוגלים של מקרקר קיר ושוע אל ההר תנו רבנן כשחרב הבית"@he ;
    oa:hasSelector opp:unit_fol_179v_1_u2_selector ;
    oa:hasSource opp:passage_fol_179v_1 .

opp:unit_fol_180v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_180v_2#u1" ;
    opp:closestWitness opp:work_Ein_Yaakov_Glick_Edition,
        opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "כד שמעו לנביאי דקא מקנבי אחורבנה שלירושלם שלחו לנבוכד כצר פוק תא שלא להו מסתפינא דלא לעביד בההוא גברא כמה דעבד בקמי שלחו ליה כי אין האיש בביתו ואין איש אלא הקבה שנאמ יי איאמלחמר שלא להו קרבא הוא ואכי שלחו ליה הלך כדק בדרך מיחוק שלא להון איכא צדיקי דבען רחמי ומייתו לה שלחו ליה צרורהכסף לקח בידו ואין כסף אלא צדיקים שנ ואכרה לי בחמשה עשר כסף שלח להו ליעבדו תשובה ומייתו ליה שלחו ליה קבע לון זמן שנ ליום הנסא יבא ביתו ואין כסא אלא זמן שנ תקעו בחדש שופר שלח להו סיתוא הוא ולא מצינא שלחו ליה תא אשנה דטורי שנ שלחו כר מושל ארץ מסכע מדברה שלח להו ליתלי רוכתא למנח בה ביה שלחו ליה בתי קברים שלהם בפלטרין שלכם שנ בעת ההיא נאם יי ינשציאו את עצמית מלכי"@he ;
    oa:hasSelector opp:unit_fol_180v_2_u1_selector ;
    oa:hasSource opp:passage_fol_180v_2 .

opp:unit_fol_181r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_181r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "נאמר אלא קמח כת ואמר אי אלהימו זה טיטוס הרשע שארף וגדף כלפי מעלה מה עשה תפש בידו זונה ונכנם לבית קדשי הקדשים והציע ספר תירה תחתיה ועבר עליה עבירה נטל הסייף וגירר את הפרכות נעשה נס והיה דם מבצבץ ויוצא כשהוא סבור שהרג את עצמו ננונ את הפרכות ועשא כנן נדויתני בנשל ם לי ביה מנוה והניחם בתיכו והביאם לספינה שלו ליכלך ונלהשתבח בעירו ה ועמד עלי נחשול שלים לטבעו אמ אותו רשע כמדומה לי שאלהיהם של לו אין גבורתו אלאבים בא פרעה וטבעו בים בא סיסרא וטבעו בנחל קישון וההוא גברא דרבעי למטבעי בימא אם גבור הוא יעלה ליבשה עמי לעשות מלחמה יצת בת קול ואמרה לו רשע בן רשע בן בנו של עשו הרשע ברה קלה ישלי בעולמי יתוש שמו שמא זה יעלה ליבשה עמךך וילחם עמך אמאי קרי ליה דמעלנא אית ליה"@he ;
    oa:hasSelector opp:unit_fol_181r_1_u1_selector ;
    oa:hasSource opp:passage_fol_181r_1 .

opp:unit_fol_181r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_181r_1#u2" ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "מה עשה תפש בידו זונה ונכנם לבית קדשי הקדשים והציע ספר תירה תחתיה ועבר עליה עבירה נטל הסייף וגירר את הפרכות נעשה נס והיה דם מבצבץ ויוצא כשהוא סבור שהרג את עצמו ננונ את הפרכות ועשא כנן נדויתני בנשל ם לי ביה מנוה והניחם בתיכו והביאם לספינה שלו ליכלך ונלהשתבח בעירו ה ועמד עלי נחשול שלים לטבעו אמ אותו רשע כמדומה לי שאלהיהם של לו אין גבורתו אלאבים בא פרעה וטבעו בים בא סיסרא וטבעו בנחל קישון וההוא גברא דרבעי למטבעי בימא אם גבור הוא יעלה ליבשה עמי לעשות מלחמה יצת בת קול ואמרה לו רשע בן רשע בן בנו של עשו הרשע ברה קלה ישלי בעולמי יתוש שמו שמא זה יעלה ליבשה עמךך וילחם עמך אמאי קרי ליה דמעלנא אית ליה ומפקנא לית לית כיון שעלה ליבשה יתוש אחד נכנס לו בחוטמו ונקר לו במוחו זשנים"@he ;
    oa:hasSelector opp:unit_fol_181r_1_u2_selector ;
    oa:hasSource opp:passage_fol_181r_1 .

opp:unit_fol_181v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_181v_1#u1" ;
    opp:closestWitness opp:work_Ein_Yaakov_Glick_Edition ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "לא אהני ליה אמ ר חייא בר אבין אמ ל יהושע בן קרחא שחלי זקן אחד בבקעה זו הרג נבוזר אדץ מאתים ויא רבוא ובירושלם הרג צד רבוא עד שהלך דמם ונגעבדמו שלזכריה שנ פרצו ודמים בדמים נגעו חזייה לדמיה דזכריה דקא רתח וסליק אמ להו מאי האי אמרו ליה דם זבחים דאשתפיך אמ להו אייתו לי דמא דדבחיכון אייתו ליה ולא אדמי אמ להו אי אמריתו לי מיטב ואי לא סריקנא לבשרייכו במסריקי דפרזלא אמרו ליה נביא הוק וקא מזכח לן ולא קבילנא מיניה והשתא קא מפיסינן ליה ולא קאמפיים אייתירבנן קטל עילויה ולא נח אייתי בחורים ובתולות קטל עלויה ולא נ קטל עד טדנבוא ולאנח קרב לובה אמ ליה זניה כל נ טובים שבהם הרגתי ניחאלך רנבדינהו לכלהו מיד נח הרהר בתשובה בדעתו ואמ מה ישראל שלא הרגו חלא כפש אחת כך הוא שהרג נפשות"@he ;
    oa:hasSelector opp:unit_fol_181v_1_u1_selector ;
    oa:hasSource opp:passage_fol_181v_1 .

opp:unit_fol_183r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_183r_1#u1" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "אמ ר יוחנן בכל מקום שהיו הולכים נטשו שרים לארוניהם בכה תבכה בלילה אמ ר אבא אמ ר יוחנן שתי בכיות הכלו למה אחת על מקדש ראשון ואחת על מקדש שני בלילה על עסקי הלילה וכד הביכה בלילה קולו נשמעי וכוכבים ומזלות בוכים עמו דא כל השומע קולו ביכה עמו מכושה בשכנתו של רבן גמליאל שמת בנה והיתה בוכה בלילה והיה רבן שמעון שומעג את קולה ובוכה כנגדיה עד שנשרו גבות עיניו הכירו בה עבדיו והוציאוה משכונתו ורמינתה על לחיה אמ ר אבא אמ ר יוחנן כאשה שכוכה על בים יעיריה שנ אלי כנתונה חנירתשק על גבעל נעוריה אין מנחם לה מכל אהביה אלו נביאיהשקר שאים מני חים את ישראל שיעשו תשובה כל רעיה בגדו בה לו מיכאל וגבדיאל שהיו מלמדין זכות על ישראל אמ להם הקבה מיחביב עליכם אמרו לפניו רבונו של עולם שמך חביב עלינו ואחריו מי אמרו ישראל ואחריהם מי אמרו בית המקדש אמ להם כבר נשבעתי בשמי הגדול שאתם בעצמכם תציתו בה את האור באותה שעה"@he ;
    oa:hasSelector opp:unit_fol_183r_1_u1_selector ;
    oa:hasSource opp:passage_fol_183r_1 .

opp:unit_fol_194r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_194r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אבין עלה אריה במזל אריה והחריב אריאל על מנת שיבא אריה ויבנה אריאל עלה אריה זה גבוכד נצר דכפויב ביה עלה אריה מסבכוי במזל אריה שנאמ עד גלות ירושלם בחדש החמישי והחריב אריאל זה בית המקדש דכת הוי אריאל אריאל על מנת שיבאארה זה הקבה דכת ארנה שאג מי לא יירא ויבנה אריאל דכת בונה ירושלם יי נדחי ישראל יכנס"@he ;
    oa:hasSelector opp:unit_fol_194r_1_u1_selector ;
    oa:hasSource opp:passage_fol_194r_1 .

opp:unit_fol_199v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_199v_1#u1" ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    rdf:value "זה יי קוינו לו נגילה ונשמחה בישועתו ות ברך שמי של מלך מלכי המלכים קבה שבחר בישראל מע אומות ועשאם סגולה לעצמו וקראם בנים לעצמי וקראם עבדים לעצמו וכל זמן שעושין רצונו נקראו לו בנים שנ בנים אתם ליי אלהיכם ובזמן שאק עושין רצונו של מקום נקראו אחרים שנ כיהם לא עמי ולא עוד אלא כל זמן שעושין רצונו מלאכתן נעשית על ידי אחרים שנ ועמדו זרים ורעו צאנכם ובזמן שאין עושין רצונושל מקום מלאכתא נעשית על ידי עצמן של ואספת דגנך ולא עוד אלא שמלאכת אחרים כעשית על ידם שנ ועבדת את איביך"@he ;
    oa:hasSelector opp:unit_fol_199v_1_u1_selector ;
    oa:hasSource opp:passage_fol_199v_1 .

opp:unit_fol_1r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_1r_1#u1" ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "מדבר שהואמיוחד במקומו מדבר שאינו מתפרש במקומו ימתפרש מדגד אאר מדבר שנאמר במרצת והוא נוהג בכל מדבר שנאמר בזה נהוא הדין לחברו מדבר שנאמר ב ואינו ענין לו אנל הוא מני ן לחברו חרבד שכוקש לאתי מרות אתה נויהן מו כנח היפה שבשתיהן מדצבר שחבירו מוכיח עליו רך מדבר שהוא מובירד על חבירו מדבר שהיה בכלל ויצא מן הכלל ללמד על עצמו מדבר שהיה בכלל ויצא מן הכלל כלמד על חבירו ממשל מכנגד ממ ממוקדם וממאוחר שהוא בענין ממוקדם ומאוחד שהוא בפרשיות מלשון נוטריקון"@he ;
    oa:hasSelector opp:unit_fol_1r_1_u1_selector ;
    oa:hasSource opp:passage_fol_1r_1 .

opp:unit_fol_1v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_1v_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "א לרבות כיצד ויקח את אדרת אליהו גו אף הוא ויכה את המים מה תלמוד לומר אף הוא מלמד שנעשו נסים לאליש בקריעת הירדן יותר מאליהו שבפעם ראשונה היתה זרות שנהם ועכשו זכותו של אלי שע לברו וכן הוא הוא אומ ויהי נא פישנים ברוחך אלי מכאן אתה דורש שמנה מופתים באליהו וששה עשר באל ישע כיוצא בדבר אתה אומ אף ברי יטריח עב מה תלמוד לומר אף סלמד שענני מטר קשים והכבה מטריח עליהם להפסיקם אחר שהמטר וורד כל צרכו והיינו דכתוב אף ריבה גם לרבות כיצד גם צאנכם גם בקרכם קחו אלו נאמר צאנכם בקרכם היית אומ לא נתן להם אלא אתשלהם לבד תלמוד לומר גם מלמד שנתן להם דורון משלו ומשל שריו להיים מה שנ גם אתה תתן בידינו כיוצא בדבר אמה אומר ומתו גם שנהם מת תלמוד לומר גם שניהם שאם היתה מעוברת אין ממתינין לה עד שתלד ממיעוט כיצד שלשלשונות הם"@he ;
    oa:hasSelector opp:unit_fol_1v_1_u1_selector ;
    oa:hasSource opp:passage_fol_1v_1 .

opp:unit_fol_205r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_205r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_Rabbati ;
    rdf:value "למרום להוריד כוכה לישראל באתה הענן ורבצה כנגדו ולא היה יודע משה רבינו אם לרכוב עליה ולם יחז בב מיד פתחה הענן את פיה ונכנס לתיכה ינשאהו הענן שנאה ויבא משה בתויך הענן והיה משה רבינו מהלך ברקיע כאדם שמהלך בארץ פועבו קמוחל המלחך שהוא ממונ על יב אלפים מלאכי חבלה שהם עימנדים על שערי הרקיינ גער בו בי שה יאמ לו מה לך בן עמרם במקום קדושי על וני והלא ממקום המטונף באתה מה לך במקום טהרה ולא בילוד אשה אתהי מה לך במקום אש ולא בשר ודם אתה אמ לו אני משה בן עמרם שבאתי להוריד תורה לישראל כיון שלא הניחו מיד הכהו סצע ארד ונפל על פניו ואבדו מן העולם והיה משהרביו מהלך ברקיע כאדם שמהל בחרץ עד שהגיע למקום הדרניאל המלאך אמרו עליי שהוא גבוה ששים פר סאות וכל דבורודבור שיוצא מפי יוצחים ממנו יב אלפים בררים של אש כיון שראה ה ה געה בו ואמ לו מה לך בן עמרם במקום קדישי עונין וכיום ששמע משה את קולו נבהל ונרתע לא חוריו ונח לררל מוולנו עינ דמעפית ובקש ליכיל מן הננן"@he ;
    oa:hasSelector opp:unit_fol_205r_1_u1_selector ;
    oa:hasSource opp:passage_fol_205r_1 .

opp:unit_fol_24r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_24r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "יספת לגגי יי אומוו העולם אתה נותן לאחד מהם בן זכר הוא מושך לו ערלה ומגדל לו בלורית הגדיל מוליכו לעז שלו ומכעיסך אבל ישראל אתהנותן לאחד מהם בן זכר מלו לשמנה ימים ואם הוא בכור פודהו לשלשים יום הנגדיל מוליכוה לבתי כנסיות ולבתי מדרשות והואמברך בכל יום ויוומ ברוך יי המבורך דבראחר יספת לגי יי אומות העולם אתה נותן להם יום אידם הם אוכלים ושותים ופוחחין ונכנסין בבתי תרטסיאות ובבתי קרקסיאות ומכעיסין אותך אבל ישראל אתה נותן להם מים טובים והם אוכלין ושותין ושמחים ונכנסין לבתי כנסיאות ובתי מדרשות ומרבין בתפל ומוסיפין בקרבנות לפיכך הוצרך הכת לומר ביום השמיני עצרת תהיה לכם לווה רשע ולא ישלם אמ ר יצחק שלשה הם שנקראו רשעים לו ה ן הפושט ידו על חבירו והלווה ואינו משלם ומי שהאא בעל מחלקת הפושט ידו על חברו שנ ויאמר לרשע למה תכה רעך אמ ר יהודה לא שהכהובלבד אלא אפי הגביה ידו עליו להכותי ולא הכהו נקרא רשע שנ ויאמר לרשע למה תכה למה הכית לא נאמר אפא למה תכה אמ ר שמואל בר תנחום אמריתה קמי דר תנחומא ואמ לי אף מי שהוא מעיז פניו נקרא רשע שנ העז איש רשע בפניו"@he ;
    oa:hasSelector opp:unit_fol_24r_1_u1_selector ;
    oa:hasSource opp:passage_fol_24r_1 .

opp:unit_fol_25r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_25r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ביום טובה היה בטוב וביום רעה ראה אם נזדוג לך יום רעה ראה לעשות תשובה ולהנצל ממנו ר אלעזר אומ שלשה דברים מבטלין גזירה קשה אלו הן תפלה ותשובה ודדקה ושלשתן בפסוק אחד ויכנעו עמי אשר נקרא שמי עליהם גו ויתפללו זו תפלה ויבקשו פני זוצדקה דכת אני בצדק אחזה פניך וישובו מדרכם הרעה זו תשובה וכת תמן ואני אשמע מן השמים ואסלח לעונם גו רב הונא בשם ר יוסי אומ אף שנוי השם ושנוי מעשה שנוי השם מאברהם אבינו שנ ולא יקרא עוד שמך אברם והיה שמך אברהם אברם אינו מוליד אברהם מוליד ודכותה שרי אשתך לה תקרא שמה שרי כי שרה שמה שרי אינה יולדת שרה ינרדת שנוי מעשה מאנשי נינוה שנאמ וירא אלהים את מעשיהם כי שבו מדרכם הרעה ויש אומ אף שנוי מקום מנ לא מאברהם אבינו שנ ויאמד יז אל אבתם לך לך מארצך גו רבה בר מחסייא ורב חייא בשם רב אמרי יפה תענית לחלום כאש בנעורת רב יוסף אמ לחלום בן יומו ואפי בשבת"@he ;
    oa:hasSelector opp:unit_fol_25r_1_u1_selector ;
    oa:hasSource opp:passage_fol_25r_1 .

opp:unit_fol_32r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_32r_2#u1" ;
    opp:closestWitness opp:work_Midrash_Tehillim ;
    opp:earliestWitness opp:work_Midrash_Tehillim ;
    rdf:value "דבר אחר אני אגיד צדקתך ההד בעת ההיא יעמד מיכאל השר הגדול העומד על בני עמך והיתה עת צרה אשר לא נהיתה מהיות גוי עד העת ההיא ובעת ההיא ימלט עמך כל הנמצא כתוב בספר באותו עת שהכל מעידים בו שהוא צרה לעליונים ולתחתונים בעת שאמ מלאכי השרת יראים ממנו ההד כי כה אמר יי הול חרדה שמענו פחד ואין שלום שאלו נא וראו אם יולד זכר מרוע ראה ראיתי כל גבר ידיו על חלציו כיולדה כביכול זה הקבה שכל הגבורות שלו מצטער על עולמו ונהפכו כל פנים לירקון אלו מלאכי השרת שכת בהן וארבעה פנים לאחד הוי כי גדולהיום מאין כמהו אומות העולם אומרן כן בשעה שיתחייבו בדין עתיד הקבה לומר לאומות העולם בואו בני עשו קוזמטמוריסון שלכם ודונו עמי ההד קרבו ריבכם יאמר יי הגישו עצומותיכם יאמר מלך יעקב והם אומרים רבון העולם ומי עושה קוזמטמוריסון של ישראל והוא אומר להם אני כביכול שנ אל ישראל הוא נותן עוז ותעצומות לעם דן את אומות"@he ;
    oa:hasSelector opp:unit_fol_32r_2_u1_selector ;
    oa:hasSource opp:passage_fol_32r_2 .

opp:unit_fol_32v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_32v_1#u1" ;
    opp:closestWitness opp:work_Ruth_Rabbah ;
    opp:earliestWitness opp:work_Ruth_Rabbah ;
    rdf:value "ושרי אומות העולם אומרין רבון העולם וני יש לפניך משוא פנים אם אלו מגלי עריות אלו מגלי עריות ואם אלו עובדי עז אלו עובדי עז ואם אלו שופכי דמים אלו שופכי דמים מפני מה הללו יורדין לגיהנם והללו אין יורדין באותה שעה מיכאל שר ישראל סניגורן של ישרחל משתתק ההד בעת ההיא יעמוד מיכאל השר הגדול מהו יעמוד וכי יש ישיבה למעלה לא כן אמ ר חנה בן אנדרי שאין ישיבה למעלה דכת הרבת על חד מן קאמיא דדין לישנא דאק אמר ליה קאמיא קיימיא שרפים עומדים ממעל לו וכל צבא השמים עומדים ואת אמר יעמוד ומהו יעמוד יעמוד משתתק כד הוחלתי כי לא ידברו עמדו ולא ענו עוד העומד על בני עמך שעומד ללמד סניגוריא על ישראל והיתה עת צרה שאותה שעה יתחייבו ישראל לירד לגיהנם אשר לא נהייתה מהיות גוי עד העת ההיא אימתי היו ישראל לגוי במצרים שנ ויהי שם לגוי לימדך הכת שקשה דין גיהנם מכל שעבוד מלכיות שנשתעבדו בו ישראל ובעת ההיא ימלכו עמך בזכות מי ר לוי אומ בזכות המילה כת הכא ובעת ההיא ימלט עמך וכת להלן בעת ההיא אמר יי אל יהושע"@he ;
    oa:hasSelector opp:unit_fol_32v_1_u1_selector ;
    oa:hasSource opp:passage_fol_32v_1 .

opp:unit_fol_33r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_33r_1#u1" ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "אמ ר אבהו משל לבן מלכים שהיה לו דין עם אחד וכלו מזונותיו ובא אחד וסיפק לו מזונות אמ המלך אין לי עסק אלא עם זה שסיפק לו מזונות כך אמ הקבה כבר היתה מלכות עקורה מאדום ובצרה סיפקה לה מלכים שנ וימת בלע וימלוך תחתיו יובב בן זרח מבצרה אמ הקבה אין לי עסק אלא עם בצרה ההד חמוץ בגדים מבצרה וכן הוא אומ כי זבח ליי בבצרה"@he ;
    oa:hasSelector opp:unit_fol_33r_1_u1_selector ;
    oa:hasSource opp:passage_fol_33r_1 .

opp:unit_fol_34r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_34r_1#u1" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "אמ ר חמא בר חנינא כת מות וחיים בידלשון למה נסמכה ידללשון לומר לך מה יד ממיתה אף לישוןממיתה אימה יד בסמוך לה אף לשון בסמוך לה תל יחץ שחוט לשונם מרחוק דיבר אי מה הן ממית בארבעים או בחמשים אמה אף לשון בארבעים או בחמשים אמה ותו לא תל שתו בשמים פיהם ולשונם תהלך בארץ ויאמר שתי בשמים פיהם חץ שחוט לשונם למה נאמר אלו כן הייתי אומר מיזל אזלא מיתטל לא קטלא תל חץ שחוט לשונם"@he ;
    oa:hasSelector opp:unit_fol_34r_1_u1_selector ;
    oa:hasSource opp:passage_fol_34r_1 .

opp:unit_fol_3v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_3v_1#u1" ;
    opp:closestWitness opp:work_Otzar_Midrashim ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "בים יאמ אמיה בתענית עד שאגא כף כייצאבדב אתה אומר ישי ייל נהי לא לקא יקמ חינו נוטל שוחד עלק לה גו אדל נוטל הוא יעל ורשעלפטרו אמרת על מדכך ליטיל שוחד על הצדיקים או על הרשעים הוי אימר יול הצריקים ח על הצדיקים איט נוטל שיחד קל וחומור על הרשעים מגזירה שוה כד נזיר היה שמואל כדב רי נהוראי שנ ומורה לא יעלה על ראשו נאמר מירה בשמשון ונאמר מירה בשמאל מה מורה האמור בשמשון נזר אף מורה האמור בשמואל כזר הרי מירה מודה לגזירל שוה כיוצא בדבר אתה אומ ויאמר יי אל יהושע היום הזה אחל גדלך גו במה גדלו שהעמיד לו חמה ולבה וכבר העמידן למשה מתאלה שנ ריום הזה אהחלתה פחדך מה אחר שנאמר ביהושע שה עמיד לו חמה ולבנהו או אחל שראמיר במשה שהעמיד לו חמה ולבנה הרי אמל אחל לוז רה שוה מבנין אב כצד זה היסיד שמלמד עלמה שהוא אחריו ימא ימהי נקרא יסד משיהיה הוא תחלה אמ ר חייא על כל כבור ודבור היה הקבה קורא משה משה והוא משב הננ ובנין אב לכשם ויקלא אליו להים מתיך הסנה ויאמר משה משה ויאמר הנני"@he ;
    oa:hasSelector opp:unit_fol_3v_1_u1_selector ;
    oa:hasSource opp:passage_fol_3v_1 .

opp:unit_fol_40v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_40v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Midrash_Tanchuma ;
    rdf:value "זה משיח ולמה קנרא אותו הר הגדול שהוא גדול מי אתה הר הגדול הר מן האבות שנ הנה ישכים עבדי ירום ונשא וגבה מאד עבדי זה משיח ירום מאברהם שכתוב בו הרימו ידי אל יי ונשא ממשה שנאמ בו כי תאמר אלי שאהו בחיקך וגבה ממלאכי השרת שנאמר בהם וגביהם וגובה להם לכך נאמר מי אתה הר הגדול וממי הוא מזרובבל שהוא מזרעו של דוד שנאמ ובני יכניה אסיר שאלתיאל בנו גו ומלכי רם ופריה גו ובני אליועינה הודויהו ואלישיב ופליה ועקוב ויוחנן ודליה ועננ שבעה עד כאן פירט הכתו עד ענני שבעה ומי הוא ענני זה המשיח שנ חזה הוית בחזוי ליליא וארו עם ענני שמיא כבר אינש אתי ועד עתיק יומיא מטא וקדמוהי הקריבוהו ומהו שבעה שכת במשיח כמה דתימא כי מי בן ליום קטנות ושמחו וראו גו ביד זרובבל שבעה אלה לכך נאמר לפני זרובבל לפי שיוצא מזרובבל למישור למי שהוא עתיד להוכיח במישור כמה דתימא והוכיח במישור לענויאץ והוציא את האבן"@he ;
    oa:hasSelector opp:unit_fol_40v_1_u1_selector ;
    oa:hasSource opp:passage_fol_40v_1 .

opp:unit_fol_42v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_42v_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Midrash_Tehillim ;
    rdf:value "אמ ר אלעזר בכיה ושירה יש כאן המצרם בוכין חפני נשלהם בזום שבזזום ישראל וח קנו נ בתיהם שנאמ וינצלו את מברים וישראל היו משור משוררין שהיו טעונין ביזת שונאיהם הוי בכושרות ופרצת ימה וקדמה אמ ר יצחק כיון שישראל מגיעין עד עפר מיד הם ני נגאלים שנ התנערי מעפר קומי שבי ירושלם וכן דוד הוא אומר כי שחה לעפר נפשנו דבקה לארץ בטננו קומה עזרתה לנו ופדנו למען חסדך למהה שכן הבטחת ליעקב אבינו כשבניך יגיעו עד עפר מיד הם נגאלים שנאמ והיה זרעך ככגפר הארץ מיד ופרצת ימה וקדמה"@he ;
    oa:hasSelector opp:unit_fol_42v_1_u1_selector ;
    oa:hasSource opp:passage_fol_42v_1 .

