opp:unit_fol_170r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_170r_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "והנה הכושי בא ויאמר הכושי יתבשר אדני המלך ויאמר המלך השלום לנער לאבשכום ויאמר הכושי יהיו כנעד אייבי אדני המלך וירגז המלך ויעל על עלית השער אמ ר חננא בד יצחק ומן לטוביירים ודקרו אותו והרי דברים קל וחומר ומה אחימעץ בן בדוק שלא על בן המלך לא טובה ולא רעה ר זכה לכל הכבוד הזה מי שהוא עלמד סניגוריא על ישראל על אחת כמה וכמה תדע לך שהוא כן שכל ימיו שלמשה לא נקרא איש האלהים עד שבי רך לישראל שנוזאת הברכה אשרברך משה איש האלהים מגע בר ירבוהו לאם וברכה לראש משביר מונע בר בעת צרה יקבוהו לאם יעשה ארירה לאומות וברכה לראש משבר זהו המשביר בעת צרה דא מונעבר זהו שמונע ברה שלתורה ירבוהו לאם יעשה אריכה לאומות וברכה לראש משביר זה המלמד תורה בעין יפה דא מונעבר זה בלעם הרשע שמנע ברכות לברך את"@he ;
    oa:hasSelector opp:unit_fol_170r_1_u2_selector ;
    oa:hasSource opp:passage_fol_170r_1 .

opp:unit_fol_170r_1_u2_selector a opp:TokenPositionSelector ;
