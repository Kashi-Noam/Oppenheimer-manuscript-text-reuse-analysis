opp:unit_fol_76r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_76r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "פגע בו אדם הראסון אמ לו מה נעשה בדינך אמ לו עשיתי תשובה ופירשתי באותה שעה התחיל אהם הראשון טופח על פניי ואומ כך היא כחה שלתשובה ולא היתי יודע באותה שעה אמ טוב להודות ליי ולזמר לשמך עליון אמ ר לוי המזמור הזה אדם הראשון אמרו שנ מזמור שירליום השבת ואם השובתו שלקין קבלתי תשובותיכם איני מקבל תשובתו של אחאנ קבלתי ורתשובותיכם אני מקבל שנגזרה עליו גזרה קשה ההד לך ודברת אליו לאמר כה אמר יי במקום אשר לקקו הכלבים את דם נבות ילקו הכלבים את דמך גם אתה ויהיכשמוע אחאב את הדברים האלה ויקרע את בגדיו וישם שק על בשרו ויצום וכמה נתענה שלש שעות אם היה למד לאכול בג שעות היה אוכל בו אם היה למוד לאכול בו היה אוכל בט ויהל אט מהו אט אמ ר יהושע בן לוישוו ה מהלך וב יחף כת תמן ה ויהידבר יי"@he ;
    oa:hasSelector opp:unit_fol_76r_1_u1_selector ;
    oa:hasSource opp:passage_fol_76r_1 .

opp:unit_fol_76r_1_u1_selector a opp:TokenPositionSelector ;
