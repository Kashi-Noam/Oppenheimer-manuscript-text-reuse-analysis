opp:unit_fol_115v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_115v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אל תאכלו ממנו נא מהבהבה בשל מבשל במים כי אם צלי אש ראשו על כרעיו ועל קרבו הוא ודוכסיה הוא ואפרכיה הוא ואסטר טליטיה ההד הוניך ועזבוניך מערבך מלחיך וחובליך מחזיקי בדקך ועילבי מעתיך וכל אנשי מלחמתך אשר בך וכל קהלל אשר בתוכך יפלו בלב ימים בים מפלתן אמ רב שמואל בד רב יצחק אפי אותן שהן מנקהלי ובאו ונרבקו בה הלך אי הם יפרו בלב ימים ביום מפלתך רביכה תאכלר אותו מתניכם חגורים נעליכם ברילינם ומקלכם בידכם ואכלתם אותו בחכזון פסהי היא ליי אבל לעתיד לבא מה כתי כי לא בחפזין תצאו ובמנוסה לא תלכון כי הולך לפניכם יי ומאם ומא ספכם אלה ישראל"@he ;
    oa:hasSelector opp:unit_fol_115v_1_u1_selector ;
    oa:hasSource opp:passage_fol_115v_1 .

