opp:unit_fol_101v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_101v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma_Buber,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "גוי אחד ראה את ר יהודה בר אלעאי חמתיה אפוי נהירין אמ הגוי הדין יהודאי חדא מן תלת מלין אית ביה או שתי דחמר הוא או מוזיף ברביתא הוא או מרבי חזיריהוא שמע קליה ר יהודה בר אלעאי אמ ליה תפחרוחיה דההוא גברא דחדא מנהון לית בי לא מרבי חזירי אנא דאסיר לבר נש מישראל למרבי חזירי דתנינן תמן לא יגדל אדם חזירים בכל מקום ולא מוזיף ברביתא אנא דאסר להון לדבית ישא למוזיף ברביתא דבת לא תשיך לאחיך ולא שתוי דחמר אנא לבד מד כסי דאנא שתי בליל יא דפסחא דאנא נזיק רישי מן פסחא ועד עצרתא ואמ ליה ועל מה אפיך להירן אמ ליה אורייתי הא דמנהרא אפי דכת חכמת אדם תאיל פניו ר אבהו אזל לקסרי ואתא מתמן אפוי נהירין חמין יתיה תלמידיה סלקין ואמרין לר יוחלן הדין ר אבהו אשכא סימא אמ להון למה אמרי לית אפוי נהירין אמ להון דלמא אוריתא חדתא שמנב סליק לגביה אמ ליהה מה אוריתא חדתא שמעתא אמ ליה תוספתא עתיקא אמית קרא עליה חכמת אום תאיר פניו רא מי כהנ להחני כהאכם זה משה דכת ביה עיר גבורים עלה חכם"@he ;
    oa:hasSelector opp:unit_fol_101v_1_u1_selector ;
    oa:hasSource opp:passage_fol_101v_1 .

