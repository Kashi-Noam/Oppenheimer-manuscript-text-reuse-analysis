    opp:closestWitness opp:work_Shir_HaShirim_Rabbah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "רפידתו זהב י שנ ואת הקרשים תצפה זהב מרכבו ארגמן שנ ועשית פרכת תכלת וארגמן תוכורצוף אהבה מבנות ירושלם ר יודן אמ זו זכות תורה וצדיקים יירשו ארץ אמ ר עזריה בשם ר יהודה בר סימן זו שכינה אמ ר אבא בר כהנא כת ונועדתי לך שם ללמדך שאפי מה שאחרי הפרכת אינופנוי מן השכינ גוד אקך שאל את רג אמ ליה מפני מה וכ נגלה ר הקבה למשה מתוך הסנה לו נגלה לו על חרוב או על תאנה מה היית אומ אלא ללמדך שאין לך מקום שהוא פנוי מן השכינה ר יהושע דסםץ בשל רלוי אמ למה היה אהל מיעד דומה ליצערה שהיא שהיא נתונה על שפת הים ועלה הים והביף את המערה והמעהה מתמנאת מהים והים אינו חסר כלום כך אהל מועד נתמלא מזיו שכינה ועולם לא חסר כלום מזיו השכינה שירד למטה לכך נאמ ויהי ביום כלות משה צאנה וראינה בנות ציון במלך שלמה בנות ציון בנים המצויינין לי במילה ובתגלחות ובציצית במלך שלמה במלך שהשלום שלו"@he ;
    oa:hasSelector opp:unit_fol_84v_1_u1_selector ;
    oa:hasSource opp:passage_fol_84v_1 .

opp:unit_fol_87r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_87r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בזכות אביתינו כבודי שהשרית שכינתך בינותי ואמרק לנו ועשו לי מקדש מרים ראשי קחת שהיינו חייבים לך הרמת ראשנו ונתת לנו תלוי ראש שנ כי תשא את ראש ר יעקב בשם ר יוחנן דבית גברין פתחדרך עצל כמשוכת חדק דרך עצל זה עשו הרשע כמשוכת חדק הוא מדמה להאל ילידתא דאת אפשרלה מן הכא והיא מתעדיא מן הכא ואת מפשר לה מן הכא כך הוא עשו הרשע מתהפד ואומ אייתי גול גלתיך אייתי דימוסיך אייתי ארנונך לית ליה קניס ניה ומזמיה ליה וארח ישרים סלולה זה הקבה דכת ביה כי ישרים דרכי יי וצדיקים ילכו בם שהכשיר את לשונו למשך למשה לכך אמ כי תשא את ראש בני ישראל ר יונתן פתא וינשק אדם וישפל איש וישח אדם אלו ישראל רכת צאן מרעיתי אדם אתם וישפל איש זה משה שנ והאיש משה ענו מאד אמ משה לפני הקבה רבון העולמים יודע אני ששחו ישראל לחנ העגל והושפלתי אני ואלתשא להם כיתשא אתראש בני ישראל ר יונה בצריא כיתח כי אלהים שופט זה ישפיל וזה ירים"@he ;
    oa:hasSelector opp:unit_fol_87r_1_u1_selector ;
    oa:hasSource opp:passage_fol_87r_1 .

opp:unit_fol_89r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_89r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "על כבודו של צריק יותר מרבורו ירבעם עימד ומהד יבלעא ולאיבשהיו כיון ששלח ידו ללהה ותיבש ידו אשר שלח אליו ותגן המלך ויאמר אל אישי האלהים הל נא את פני יי אלהיך התפלל בעדי תרין אמוראין חד אמ אלהיך ולא אלהיו וחרנא אמ באלו פנים יהיה קורא אלהיו אעלכ ויחל איש האלהים את פני יי ותשב יד המלך אליו ותהי כבראשונה מהו כבראשונה ר ברכיה אמ ור יהודה בר סימוק בשם ר יהושע בן לוי אם הכתוש את האויל במכתש כחמור של חרשים אין אתה מועיל ממנו כלום מה בראשונה עומד ומקריב לען אף באחרונה כן דא כסף נבחר לשון צדיק זה הקבה שהבחיר את עולמי למשה ואמ כי תשא את ראם בני ישראל מה"@he ;
    oa:hasSelector opp:unit_fol_89r_1_u2_selector ;
    oa:hasSource opp:passage_fol_89r_1 .

opp:unit_fol_91r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_91r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "את ראשבני ישראל ר מנחמא ור ביבי ור חייא רבה בשם ר אליעזר בן יעקב אומ נמשלו ישראל בחול מה החול הזה את עושה בו גומא מבערב ובשחרית אתה מוצא אותה שנתמלאת כך כל אלפים שחסרו ישראל בימי דוד אימתי נתמלאו במי שלמה שנ יהודה וישראל כחול אשר על שפת הים לרוב אובלים ושותים ושמחים ר אלעזד בשרר יוסי בן זמרא אמ כל זמן שנמנו ישראל לצירך לא חסרו שלא לצורך חסרו ובאי זה זמן נמנו לצורך בימי משה שלא לצורך בימי דוד אמ ר שמואל בר נחמני בשם ר יונתן ונתנו איש כפרננשו בימי משה ולא יהיה בהם נגף בימידוד זה יתנו אמ ר מאיר כמן מטבע של אש הוציא הקבה מתחת כסא הכבוד שלו והראהו לו למשה ואמ לו זה יתנו כזה יתנו כל העובר ר יודן ור נחמיה ר יודן חמ כל דעבר בימא יתן כך ור נחמיה חמ כל דעבר על ס כומייא יתן מחצית השקל ועו ר יודן ור נחמיה ר יודן אמ לפי שחטאו בחצי היום לפיכך יתנו מחצית השקל ור נחמיה אמ לפי שחטאו בו שעות לפיכך יתנו מחצית השקל"@he ;
    oa:hasSelector opp:unit_fol_91r_1_u2_selector ;
    oa:hasSource opp:passage_fol_91r_1 .

opp:unit_fol_92v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_92v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אברהם אבינו עבר עשו הרשע שתי עבירות קשות בא על נערה מאורסה והרג את הנפיש ההד ויבא עשו מן השדה והוא עיף ואין שדה האמור כאן אלא נערה מאורסה כדא ואם בשדה ומצא האיש את הנערה והוא עיף זה אלא לשון הריגה כדא כי עיפה נפשי להורגים ר זכאי אמ אף גנב פי מאמרו ויבא וכתוב ו אם גנבים באו לך אמ הקבה והלא כבר הבטחתי לאברהם אוהבי ואמרתי לו ואתה תבא אל אבתיך והדא סיבו טבא שיראה את בן ביו שופך דמים ומגלה עריות וגונב לית הדא סיבו טבא טב ליה דתתכניש בשלם ההד כי טוב חסרך מחיים ומה חטא חטא על אביו גרם לו שיכהו עיניו מכאן אמרו כל מי שמעמיד בן רשע או תלמיד רשע שעיניו כהות בן רשע מאבינו יצחק שנ ויהי כי זקן יצחק ותכהין עיניו מראות למה שהעמיד לעשו בן רשע תלמיד רשע מאחיה השילוני שנ ואחיה לא יכול לראות ולמה על שהעמי לירבעם תלמיד רשע ומה חטא חטא עשו על אמו ר תנחום בר אבין אמ ור יהודה ור נחמיה ורבכן ר יהודה אמ כרעם שהוא יוצא ממעי אמו חתך מטרין שלהיכדי שלא תלד עוד ההד על רדפו בחרב אחיו ושחת רחמיו"@he ;
    oa:hasSelector opp:unit_fol_92v_1_u1_selector ;
    oa:hasSource opp:passage_fol_92v_1 .

opp:unit_fol_96r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_96r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ודם ילשש בו כח לפשוט ירו בכסאו של הקבה אלא עלידו שהיה עתיד להחריב את ירחושלם שהיא נקראת כטא יי שנ בעת ההיא יקראו לירושלם כסא יי לפיכך כי מחה אמחה את זנר עמלק ויאמר כי יד על כם יה תאני בשם ר אליעזר שבועה נשבע הקבה ואת ימיוי ימיני כסאי כסאי שאם יבאו גרים מכל העולם שיני מקבלן ימשרעו של עמלה איני מקבל אוז זיוד עשה בן שנ ויזמר דוד אל הננים המגיד לי אמ ר יצחק הואדואג האדומי שנ ויאמר לו דמך על ראשך דמיך כת אמ ליה הרבה דמים שפכת בנוב עיר הכהלים מדור דור אמ הקבה בין דר דר אנא בתראה לדרי דרין ר אליעזר ור יהושע ור יוסי ר אליעזר אומ מדורו של משה עד דורו של שמואל ור יהושע אמ מדורו של שמואל עדדורו של מרדכי ואסתר ור יוסי אומ מדורו שלי מרדכי עד דורו של מלך המשיח שהואג דורות ומנין לדורו של מלך המשיח שהוא גדורות שנ ייראוך עם שמש ולפני ירחז הור דורים דור דור אחד דורים שנים ר ברכיה בשם ר אבא בר כהנא אמ כל זמן שזרעו שלעמלקקיים בעולם באלו נכנף מהם את"@he ;
    oa:hasSelector opp:unit_fol_96r_1_u1_selector ;
    oa:hasSource opp:passage_fol_96r_1 .

opp:unit_fol_97v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_97v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר שמואל בר נחמני אמרו לו לנקש מפנימה את מצוי בין הגדירות אמ להם מפני שאני פרצתי פרצתי גדירו של עולם מפני מה אתה מהלך ולשונך שותת אמ להם היא גרמה לי מפני מה כל בהמה וחיה נושכים ואינם ממיתים ואת נושך וממית אמ להם אם ישך הנחש בלא לחש איפשר דאנא עבד כלום דלא מתאמר לי מן עליתא מפני מה את נושך באבר אחד וכל האיברים מרגישים אמ להם ולי אתם אומ אמרו לבעל הלשון שהוא אומ כאן והורג ברומי ולמה נקרא נחש שלישי שהוא הורג שלשה האומרו והמקבלו וזה שנאמר עליו ובימי שאול סרג ארבעה דוייג שאמרו ושאול שקבלו ואחימלך שנאמר עליו ואבנר ולמה נהרג אבנר ר יהושע בן לוי אמ על ידי שהקדים שמו לשמו של דוד ההד וישלח אבנר אל דוד מלאכים כתב מן אבנר לדוד ור שמעון בן לקיש אמ על ידי שעשה דמן של נערים שחוק של ויאמר אבנר אל יואב יקומונא הנערים וישחקו לפטנו ורבנן אמרי על ידי שרא המתין לשאול להתפייס בדוד שנ ואבי ראה גם ראה בכדתי את כלף מעילך אמ ליה אבנר מאן את בעי מן גולגוי דדין בסירה הוערת"@he ;
    oa:hasSelector opp:unit_fol_97v_2_u1_selector ;
    oa:hasSource opp:passage_fol_97v_2 .

opp:unit_fol_98v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_98v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לו אומנין בשכרן מה עשה פרעה כינס כל אצטרוגלין שלו ואמ להם צפו וראו בני אדם שהן עתידין למות באותה שנה מיד כשבאו הציץ שלמה בה ונתא לכלם תכריכיהם ושלחם לו וכתב ואמ לו לאהיה לך תכריכין לקבור אתמתיך הרי לך הן עם תכריכיהן ויחכם מכל האדם זה אדם הראשון ומה היתה חכמתו של אדם הראשון אתה מנו בשער שבלקש ררנה לכחות אום הרישין נמלר במלוני במלאני השרת ואמ להם נעשה אדם אמרו לתניו רבונו של עולם מה אנוש כי תזכרנו ובן אדם כי תפקדנו אמ להם אדם שאני מבקש לבראות חכמתו מרובה משלכם מה עשה הקבה כינס כל בהמה וחיה ועוף והעבירם לפניהם אמ להם מה שמותם של אלו ולא היו יודעין וכיון שברא את אדם הראשון כינס כל בהמה חיה ועוף והעבירם לפני אדם הראשון ואמ לו מה שמותם של אלו אמ לו לזה נאה לקרותו"@he ;
    oa:hasSelector opp:unit_fol_98v_1_u1_selector ;
    oa:hasSource opp:passage_fol_98v_1 .

opp:unit_fol_9r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_9r_1#u1" ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Zuta ;
    rdf:value "ואל תתירא מך דין ל מטה שהרי שידין איהםי ממון הם אלא הדי מתי רא מבית דין של מעלה שיש לך מעידין למעלה שאין אוהבין ממו ולא עוד שלא שמכר יזין עליך בכל שעה ושעה אם ענ דברי בשמחת כומלא שלי תצא לשחרך ואף אני בעד בעצמי אצא לקראתך ואומר לך בואך בשלום עיניך שלא נתת בממון שא נושלך הם יא רו באישין חשך שנ וזרח בחשך אורך אזניך שלא שמעת בהם דברים בטלים הם יקשיבו לך שלום בעולם הזה ויאזינג לחיי העולם הבא שנאמ ואזניך תשמעפנה דבר מאחריך לאמר זה הדרך לכו בו כי תאמינו וכי תשמאיל כיך שלא ספר לשח הרע עליו יהרגו כל בעליה פיך שעסק בתורה עליו יתברכו כל בעלי ברכה ידיך ששמרתמן הגזל מה יעשו לך כל בני עולה ידיך שלא קפצת מן הצדקה מה יעשו לך כל בעל כסף וזהב רגליך שלא קדמוך לדבר עבירה מה יעשה לך מלאך המוה דברי אלה התריתי לפניך ומה שתר בה עשה ולא תאמר לא התרו בי"@he ;
    oa:hasSelector opp:unit_fol_9r_1_u1_selector ;
    oa:hasSource opp:passage_fol_9r_1 .

