opp:unit_fol_4v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_4v_1#u1" ;
    opp:closestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "שבאללמד ונמצא ו כיצד כחדוח אש המסים מים תבינק עדק לא שמענו במעשה םאשי שליהטה האש אי יפני הרקיע וכשרואגא במחן תורה יקינת שמים בשם שעשית הנשה בדאשית כך עשיהי נשדצומה מלמד שב שבשעה שאמ הקבה יהי רקיע בתיך המים וכבר נבראו מיום ראשון אלא שלאהיו מצוחצחות עד שיצאה האש מלמעלה וליחנה את פני הרקיע בא מעשה ברא בראשית ללמד על מתזתורה ונמצא למבממנו כיוצא בו אתה אומ קולה כנמש ילך כשם שמהלך הולו שלנחש מהלך קולה שלמצרים מלמד שכשאמ הקבה לנחש על גחולך תלך ידדג מלאכים בקצצו ידיו ורגליו והיה קולו הולך מסלף העולם ועד סופו בא נחש ללמד על מפלתה שלמצרים ונמצא למד ממנה"@he ;
    oa:hasSelector opp:unit_fol_4v_1_u1_selector ;
    oa:hasSource opp:passage_fol_4v_1 .

opp:unit_fol_4v_1_u1_selector a opp:TokenPositionSelector ;
