opp:unit_fol_197v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_197v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "אף אני עושה כן שנ ראיתי את הארץ והנה תהו ראיתיההרים והנה רועשים וכל הגבעות התקלרלו ראיתי והנה אין האדם וכל עוף השמים נדרו ואין אדם אלא ישראל שנ ואתן צאני צאן מרעיתי אדם אתם המתאבל תולה שק על פתחו אף אני עושה כן שנ אלביש שמים קדרות המתאבל בוכה ביום ובלילה אף אני אעשה כן שנ ואבכה יומם ולילה את חללי בת עמי מי בכה הקבה בכה דומה לחכם שהיו לו שני בנים משכים ומוליכם לבית הספר מעריב מוליכם לבית הספר לאחר ימים מתו שניהם והיה משכים לבית הספר ובוכה מערב לבית המשתה ובוכה כך הקבה כיון שחרבה ביון זירושלם היה משכים לציון ומבקש אחד מישראל ולאהיה מוצא מעדיב לירושלם ומבקש אחד מישראל ולא היה מצא לכך ואננה יומם ולילה את הקבה נתתיתירה לישר ל שמני שיעסרו בה יומם ולילה שלוהגית בו יומם"@he ;
    oa:hasSelector opp:unit_fol_197v_1_u1_selector ;
    oa:hasSource opp:passage_fol_197v_1 .

opp:unit_fol_197v_1_u1_selector a opp:TokenPositionSelector ;
