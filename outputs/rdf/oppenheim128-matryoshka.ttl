    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "לא אתה הוא שנישית כי הלא אתה הוא שכתבת לנו בתורה לא תתאתן בם לו נסבנו מנהון או אנסיבנון להון הדין מנהון הוה מחמי בריה או ברתיה קיים על תרעיה ולא הוה מקבלה יתיה הוי כי אתה עשית הבאת יום קראת ויהיו כמוני כמוני בצרה ולא כמוני ברוחה אין מנחם לי אמ הקבה אנכי אנכי הוא מנחמכם י רקםם אב על בנים רחם יי על יראיו כאיזה אב תני רחייא כרחמן שבאבות ואיזהו רחמן שבאבות ר עזריה אמ בשם ר אחא זה אברהם אבינו אתה מוצא קודם שלא הביא הקבה מבול על הכדומיים אמ אברהם אבינו לפני קבה רבונו של עולם נשבעת שאין אתה מביא מבול לעולם ומה תעשה מן השבועה שנאמ אשר נשבעתי מעבר מינח וכו אם מבול של אש אתה מביא מה אתה מערים על השבועה חלילה לך מעשות כדבר הזה להמית צדיק עם רשע אמ ר לוי השופט כל הארץ לא יעשה משפט אם משפט אתה מבקש אין עולם ואם עולם אתה מבקש אין דין מה אתה עושה אתה לוקח החבל בשני ראשיה בעי עולמך ובעי דינא אין לית את מבתרי צבחר לית עלמא יכיל קאים"@he ;
    oa:hasSelector opp:unit_fol_161r_1_u2_selector ;
    oa:hasSource opp:passage_fol_161r_1 .

opp:unit_fol_36r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_36r_2#u1" ;
    opp:closestWitness opp:work_Babylonian_Talmud,
        opp:work_Ein_Yaakov_Glick_Edition,
        opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Tractate_Semachot ;
    rdf:value "ויען עכן את יהושע ויאמר אמנה אנכי חטאתי ליי אלהי ישראל גו ומנין שמחל לו הקבה שנ ויאמר יהושע מה עכרתנו יעכרך יי היום הזה היום הז אתה ערור ואי אתה עכור לעולם הבא וכן הוא אומ ובני זרח זמרי ואיתן והימן וכלכל ודרדע ח כלם חמשה אמ ר יוחנן מהו כלם חמשה כלם לעולם הבא כת זמרי וכת עכן רב ושמואל חד אמ עכן שמו ולמה נקרא שמו זמרי שעשה מעשה זמרי וחד אמ זמרי שמו ולמה נקרא שמו עכן שעיכן עיננתיהם של ישראל ומלך אלקום עמו ד זה דוד שחטא במעשה אוריה ובת שבע וכיון שהודה כד ויאמר דוד אל נתן חטאתי ליי מיד מחל לו הקבה שנ ויאמר נתן אל דוד גם יי העביר חטאתך לא תמות ולמה לקרא דוד מלך אלקום שלארם מלך בישראל שכרת הקבה עמי ברית מלכות לו ולבניו עד סוף כל הדורות כמו שכר עם דוד כד לא אחלל בריתי ומוצא שפתי לא אשנה"@he ;
    oa:hasSelector opp:unit_fol_36r_2_u1_selector ;
    oa:hasSource opp:passage_fol_36r_2 .

opp:unit_fol_47v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_47v_1#u1" ;
    opp:closestWitness opp:work_Bereshit_Rabbati ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "מה כעל אל והיה בכל יחם יצון המקושרות אמ ר שמואל בר נחמן כל מקום שנאמ ויהי צרה והיה שמחה שנאמ והיה בכל יחם גו מה שמחה היתה שם שנטל הצדיק שכר יגיעתו התיבון והא כת והיה נאשר נלכדה ירושלם אמ להם אף היא אינה צרה אלא שמחה שבו ביום נולד מנחם ובוביום נטלו ישראל אפוכי על עונותיהם דאמ ר שמואל בר נחמן אפוני שלימה נטלו ישראל על עונותיהם ביום שחרב בית המקדש שנאמ תם עונך בת ציון לא יוסיף להגלותך ומנין אתה אומ בו ביום נולד משיח בו ביום חרב בית המקדש שנ בטרם תחיל ילדה"@he ;
    oa:hasSelector opp:unit_fol_47v_1_u1_selector ;
    oa:hasSource opp:passage_fol_47v_1 .

opp:unit_fol_49r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_49r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma,
        opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Midrash_Tanchuma ;
    rdf:value "מאשר םיקרת בעיני נכ בדת ואני אהבתיך אמ הקבה לישראל יקר אתה בעיני מכל האומות שכל האומית לא נתתי להם מנין ולן י נתתימנין משל למלך שהיו לו גרנות הרבה והיו כלן טנופות ומלאות זונין לפיכך לא היה מדקדק במנין אבל היה לו גרן אחת וראה אותה נאה אמ לבן ביתו אותן הגרנות טנופות ומלאות זונין לכך לא הייתי מדקדץ במנינם אבל הורז הזו חטים יפות הם לכך אני רוצה לדקדק במנינם במה כורים ישבו כמה שקים כמה מדות יש בו המלןי זה מלד מלכי הקב המלכים הקבה והגורן אלו ישראל שנ מדושתי ובן גרני ונן הוא אומ חדש ישה לייי ראשית תנואתה בן ביתו זה משה שנא לה כן עבדי משה בכל ביתי נאמן הוא אמ לו הקבת האומות טנופות הן שנ והיו עמים משרכוה קוצים כסוחים לכך אל תדקדק במנינם צדיקים הם חטים ברורים הם שנ וי לייילם יירשו ארץ ונן הוא אימ ר אני מדקדק במנינם וכן עשי כורים שנאמ שאו את כל עדו שנאמ וצבאו ופקנדיו כמה"@he ;
    oa:hasSelector opp:unit_fol_49r_1_u1_selector ;
    oa:hasSource opp:passage_fol_49r_1 .

opp:unit_fol_87r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_87r_2#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "מטרונה אחת שאלה את ר יוסי בן חלפתא אמרה לו לכמה ימים ברא האלהים את עולמי אמ לה לששה אמרה לו ומה הוא עושה מאותה שעה אמ לה מזויג זיווגין רתו זבלנ גרלני וכלני לכה כלני אמרה לו והרא האחה יכלה למעבד הכי כמה עבדים וכמה שפחות ישלי ובשעה קלה אני יכולה לוווגן אמ לה אם קלה בעיניך קשה היא לפני המקום כקריעת ים סוף הניחה ר יוםי בן חלפתא והלך לו מה עשתה נטלה אלף עבדים ואלף שפחות והעמידן שורות שורות אמרה פלני ישא פלנית ופלנית ישא פלני וזיווגה אותן בלילה אחד בצפרא אתון לגבה דין רישיה בזיע ודין עיניה שמיטא ודין רגליה תבירא דין אמ לית אנא בעי לרא ורא אמרה לית אנא בעי לדין שלחה והביאת את ר יוסיבן חלפתא אמרה לו תורתכם נאה היא ומשובחת כל מה שאמרת יפה אמרת אמ לה לאכך אמרתי לך אם קלה היא בעיניך קשה היא לפני הקבה כקריעת ים סוף ומה הקבה עושה מזווגן בעל כרחן שלא בטובתן ההד אלהים מושיב יחידים ביתה מוציא אסירים בכושרות דבעי אמרו שירה ודלא בכי בפי אמר ברכיה כלשון הזה השיבה ר יוסיבן חלפתא"@he ;
    oa:hasSelector opp:unit_fol_87r_2_u1_selector ;
    oa:hasSource opp:passage_fol_87r_2 .

opp:unit_fol_87v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_87v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "יושב ועושה סולמותי מעלה לזה ומורידן לזה מוריש לזה ומעשיר לזה שנכי אלהים שופט זה ישפיל וזה ירים ר יונה בצריא ורבנן פתרין קריא באהרן בלישון זה הושפל ובל שון זה הוגבה בלשון זה הושפל ואשליכהו באש ויצא העגלהזה ובל שון זה הוגבה שנ זה קרבן אהרן ובניו ור יונה פתרקריא בישראל בלשון זה הושפרו ובלשון זה הוגבהו בל שון זה הושפלו שנ כי זה משה האיש ובלשון וה הוג בהו שנ זה יתנו כל העובר על הפקודים צדקה צדקה תרומם גוי וחסד לאמים חטאת ר אליעזר ור יהושע ורבנן ר אליעזר אומ צדקה תרומם גוי אלו ישראל וחסד לאומים חטאת חסדים הם החטא לאומות העולם שהם מתייהדים בהם ור יהושע או צדקה תרומם גוי אלו ישראל וחסד לאמים קטאת הנייה היא לאומות העולם בשעה שישראל חוטאין שהן חוזרין ומשעבדין בהן ורבן שמעון בן גמליאל אומ צדקה תרומם גוי אלו ישראל וחסד לאמים חטאת חסד של אומות העולם חטאת הוא להם שכן דניאל אומ לנבוכד נצר וחטאך בצדקה פרוק ועוייתך במחן עניין ר אלעזר בן"@he ;
    oa:hasSelector opp:unit_fol_87v_1_u1_selector ;
    oa:hasSource opp:passage_fol_87v_1 .

opp:unit_fol_90r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_90r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אבין משל כמלך שהיה לו פורפוריון והיה מצו לעבדו ואומר לונערו קפל תן דעתך עליה אמ לו אדני המלך מכל פורפוריון שיש לך אין אתה מצוני אלא על זה אמ לו מפני שלבשתי אותה בשעה שמלכתי תחלה כך אמ משה לפני הקבה רבונו של עולם מע אמית אוותנטיות שיש לך בעילמך אין אתה מציני אלא על ישרל צו את בני ישראל ואל בני ישראל וכו כי תשא את ראש בני ישראל אמ לי מפני שהמליכוני על הים ואמרו יי ימלך לעולם ועד אמ ר ברכיה משל למלך שהיתה לו מעפורת והיה מצוה את משרתו ואומ לו נערה קפלה תן ע דעתך עליה אמ לו אדני זקן מכל מעפריות שלך אין אתה מצוני אלא על זו אמ לו מפני שבה נתעטפתי בשעה שנתמניתי דיין תחלה כך אמ משה לפני הקבה רבונו של עולם מע אומות וכו כדלעיל אמ לוממני שהן קבלו עול מלכותי בסיני ואמרו כל אשר דבר יי נעשה ונשמע אמ ר יודן בא וראה כמה חבב הקבה לישראל שהוא מזכירן ה פעמים בפסוק אחד ההד ואתנה את הלוים נתונים לאהרן ולבנו הני ר שמנון בן וחאי"@he ;
    oa:hasSelector opp:unit_fol_90r_1_u1_selector ;
    oa:hasSource opp:passage_fol_90r_1 .

opp:unit_fol_90v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_90v_2#u1" ;
    opp:closestWitness opp:work_Bamidbar_Rabbah,
        opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בימי העגל שנ ויעשו בלי לוי כדבר משה וכו ר מנחמא בשם רברכיה אמ משל למלך שהיה לו צאן ונרנסו ואבים אבים לתוכה ובקש המלך מהרועה ואמ לו מנה לי את צאני לידע כמה חסרו כך אמ הקבה למשה מנה לי את ישראל לידע כמהחסרו בעשרה מקומות נמנו ישראל א בירידתן למצרים שנ בשבעים נפש ירדו אבותי מצרימ ואחת בעלייתן שנ ויסעו בני ישראל מרעמסס סכותה כשש מאות אלף רגלי ושנים בחומש הפקודים ואחת במרגלים ואחת בחלוק הארץ ושנים בימי שאול שנאמ ויפקדם בטלאים מאתים אלמרגלי ועשרת אלפים את איש יהוהה ויפקדם בבזק ויהיו בני ישראל שלשמאות אלף איש ואיש יהודה שלשים אלא וכד אינון עתירין באלין אימרייא וכד אינון מתמסכנין באלין בזקיא ואחד בימי דוד שנ ויתן יואב את מספר מפקד העם ואחד בימי עזרא שנ כל הקהל כאחד ארבע רבו ואחתנ לעתיד לבא שנ עוד העבורנה הצאן על ידי מונה"@he ;
    oa:hasSelector opp:unit_fol_90v_2_u1_selector ;
    oa:hasSource opp:passage_fol_90v_2 .

opp:unit_fol_93r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_93r_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "בר נחמני אמ בשם ר יונתן לשון יוני הוא אלון אידי אלון ברות עד שיעקב משמר אבלה של מניקתו של אמו באת לו בשורת אמי שמתה ההד וירא אלהים אל יעקב עד בבאו מפדן ארם ויברך אותו ומה היא הברכה שבירכו ר אחא בשם ר יונתן אמ ברכת אבלים בירכו אמ הקבה אבוי שלים ליה ביש סאביה שלים ליה ביש אתו אמיה שלים ליה ביש אביה שלים לה ביש אחוי שלים ליה ביש סאביה שלים ליה ביש אתון שלמו ליה ביש ואנא אשלים ליה בישותיה תהיו אתם מזכירין שמו מלמטה ואני מוחק את שמו מלמעלה שנ יהיו נגד ייי תמיד ויכרת מארץ זכרם ההד זרור את אשר עשה לך עמלק ר תנחום בר חנילאי פתח זנרוניכם משלי אפר לגבי חמר גביכם אמ הקבה ליש בני אותן שתי זכירוה שהכתבתי לכם בתורה היו זהידין בהן שנ תמקה את זכר עמלק כי מחה אמחה את זכר עמלקו משלי אפר משולים באפר אם זכיתם הרי אתם בניו של אברהם שהמשיל עצמו באפר שנ ואנכי עפר ואפר ואם לאו לנבי חמר גביכם התקינו עצמכם לשעבודה של מצרים"@he ;
    oa:hasSelector opp:unit_fol_93r_1_u2_selector ;
    oa:hasSource opp:passage_fol_93r_1 .

opp:unit_fol_93v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_93v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה כת במצרים וימררו את חייהם בעבודה קש בחמר ובלבנים ר יודן בשם ר איבו פתח אל תהיו כםום כפרד אין הבין ששה דברים נאמרו בסוס אוכל הרבה ומוציא קמעא אוהב זנות אוהב מלחמה מוחס שינה ורוחו גסה עליו ויש אומ אף מתכוין להרוג את בעליו במלחמה אל תהיו כסוס כפרד י הסוס הזה את ממתגו והוא בולם מכשכשו והוא בולם מקשטו והוא בולם מאכילו שעורים והוא בולם לא קריב לגביה והוא בולם אתם אל תהיו כן אלא הוו זהירין למזגו לטבא טבתיה ולמזגו לבישא בישותיה לטבא טבתיה לא תתעב אדומי כי אחיך הוא ולמזגו לבישא בישותיה זכור את אשר עשה לך עמלה ר ברכיה בשם ר הונא פתח מחזני מרמה תועבת יי ואבן שלמה רצונו אמ ר ברכיה בשם ר הונא אם ראית דור שמדותיו רעות ושל שקר דע שהמלכות באה ומתגרה באותו הדור ומאי טעמיה מאזני מרמה תועבת יי מה כת בתריה בא זדון ויבא קלין ר הונא בשם ר אבא בר כהנא אמ כת האקכה במחזני רשע וני איפשר כן דור שמדותיו שלשקר זוכה בכים זבני מרמה אמ ר לוי אף משה רמה לישראל נון התירה"@he ;
    oa:hasSelector opp:unit_fol_93v_1_u1_selector ;
    oa:hasSource opp:passage_fol_93v_1 .

opp:unit_fol_94v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_94v_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma,
        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אבא בר כהנא מהו ערו ערו פגרו פגרו היך מה דאת אמר ערו עכו ומהו עמלק עם לק כהדין ילקא דא עמלק עם לק אומה שבאת ללים בנן טל ישראל כככם ר לוי בשם ה שמינון בן חלפתא למה היק דומה עמלק לזבוב שהוא להוט אחר המכה כך היה עמלק להוט אחר ישראל ככלב תאני בשם ר נתן ארבע מאות פרסה נסע עמלק ובא לעשות מלחמה עם ישראל ברפידים בדרך בצאתכם ממצרים אמר לוי מן הדרך בא עליכם כליסטים משל למלך שהיה לו כרם והקיפו גדר והושיבו בו כלב נשכן אמ המלך כל מי שיבא ויפרוץ את הגדר ינשכנו הכלב ובא בנו שלמלך ופרץ את הגדר ונשכו הכלב כל זמן שהיה המלך מבקש לה זכיד חטא של בנו אומר לו זכור היאך נשכך הכלב כך כל אמן שמקבה מבקש להזניר חטא של שליל מה מה שעשו ברפידים שאמרו היש יי בקרבנו אם אין הואחו להם זכור את אשר עשה לך עמלק י אשרקרןך בדרך ר יודה ור נחמיה ורבנן ר יהודה אמ קרך טמאך היך מה דאת אמר כי יהיה בך איש אשר לאיהיה טהור מקרה לילה"@he ;
    oa:hasSelector opp:unit_fol_94v_1_u1_selector ;
    oa:hasSource opp:passage_fol_94v_1 .

opp:unit_fol_97r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_97r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "ר תנחום בר חנילאי פתח אמרות יי אמרות טהורות אמרוה בשר ודם אינן אמרות טהורות בנוהג שבעולם מלך בשר ודם נכנס למדינה בני מדינה מקלסין אותו וערב לו קלוסן אומ להם למחר אני בונה לכם דמוסיות ומרחצאות ולמחר אני מכניס להם אמת המים ישן לו ולא עמד היכן הוא והכן אמרותיו אבל הקבה אינו כן אלא וי אלהים אמת שהוא לבד האמת אמ ר אבין הוא אלהים חיים אמלך עולם לכך אמרותיו טהורות ר יודה בשם ר יוחנן ור ברכיה בשם ר אליעזר בן יעקב מכפרחנן אמרי לה בשם ר יהושע בן לוי מצינו שעקם הקבה שתים ושלש תיבות כדי שלא יוציא דבר של טומאה מתוךפיו ההד מכל הבהמה הטהורה תקחלך שבעה שבעה איש ואשתו ומן הבהמה אשר לא טהורה היא שנים איש ואשתו הטמאה אין כת כאן אלא אשר לא טהורה היא אמ ר יהודה בר מנשה כשבא לפתוח להם בסימני טהיה את הגמל כי לא מפרים פרסה הוא אין כת כאן אלא את הגמל כימעלה גיה הוא ואת החזיר כי לא מעלה גרה אין כת כאן אלא כי מפריס פרסה הוא ר"@he ;
    oa:hasSelector opp:unit_fol_97r_1_u1_selector ;
    oa:hasSource opp:passage_fol_97r_1 .

opp:unit_fol_99v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_99v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר אבין יר אבין בשם בשם ר שמואל קפודקאה אמ אעב דרגלוי דתרנגולתא דמיין לחרצפיתיה דנונא ועל הרמש וכי אפשר לו לאדם כשלמה לדבר על הרמש אלא אמ שלמה מפני מה שמנה שרצים האמורין בתורה הצדן והחובל בהן חייב ושאר שקצים ורמשים החובל בהם פטוד מפני שיש להם עורות ועל הדגים וכי אפשר לאדם כשלמה לדבר על הדגים אנא אמ שלמה מפני מה בהמה וחיה ועום טעונים שחיטה והורה יעקב איש כפר נבוריא בצור על הדגים שטעוניא שחיטה שמע ר חגי ואייתוניה אמ ליה מנן הורית כדין אמ ליה מן הדאדכת ישרצו המים שרץ נפש חיה מה עופות טעונין שחיטה אף דגים טעונין שחיטה אמ ארבעונייה וילקה אמ בר נשדאמ מולי דאוריתא ילקה אמ ליה דלא הורית טבות אמ ליה מנחן אמ ליה מן הדין דכת הצאן ובקר ישחט לקם ומצא להם אם את כל"@he ;
    oa:hasSelector opp:unit_fol_99v_2_u1_selector ;
    oa:hasSource opp:passage_fol_99v_2 .

