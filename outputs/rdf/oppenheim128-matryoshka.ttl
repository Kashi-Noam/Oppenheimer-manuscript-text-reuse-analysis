opp:unit_fol_167r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_167r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אשיש ביי הלא אתה תשוב תחיי ועמך ישמחו בך אמ רב אחא את ועירך ועמך ישמחובך כהו ותאמר שרה צחם עשה לי אלחני ר פנחס ור יהודה ורב חנן בשם רב שמואל בררב יצחקך ראובן בחדוה שמעון מה איכפת ליה שהרי שרה אמנו אומרת כל השומת יצחק לי אלא מלמד שבשעה שנפקד שרה אמנו כל העקרות נפקדו עמה וכל החרשים כלם נתפקחו וכל הסומים לתפתחו וכל האלמים נתרפאו והיו הכל אומ ולואי שתפקר שרה אמנו פעם אחרת בשביל שנפקד עמה ר ברכיה בשם ר חלבו אמ הקבה עשה דורון לעולם נאמר כאן צחק עשה לי להים ונאמ להלן והנחה למדינות עשה מה עשיה האמורה להלן נתן דורון לעולם אף כאן כן"@he ;
    oa:hasSelector opp:unit_fol_167r_2_u1_selector ;
    oa:hasSource opp:passage_fol_167r_2 .

