opp:unit_fol_43v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_43v_1#u2" ;
    opp:closestWitness opp:work_Bereishit_Rabbah ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "מדינים זה עם זה החטים החטים והקש והמוץ על אומרים בשבילנו נזרע השדה הקש והמוץ אומרין בשבילנו נזרע השדה אמרו להם החטים תבא השעה ואתם רואים כיון שהגיע עונת הגרן התחיל בעל השדה נוטל את הקש ושורפו ואת המוץ ומשליכו לרוח והחטים מעמידן כרי התחילו הכל מנשקים אותם כך ישראל נמשרו בחטים שנ בטנך ערמת חטים אומות העולם נמשלו במוץ ועשו בקש ואת מוצא שתילדות יעקב ועשו ובני שעיר כתובות כתובות בתורה זה בצד זה ונן תולדות בני נח כתובו אצל פרשת אברהם וכן תולדוה ישמעאל אצל תולדות יצחק וכלם מדיינים עם ישראל ישראל אומרים בשבילנו נברא העולם אומות העולם ועשו אומרים בשבילנו נברא העולם אומר ין לתם ישראל תבא השעה ואתם רואים מי הוא עקרו של עולם לעתיד לבא נוטל הקבה עשו הנמשל לקש ושורפו שנ והיה בית יעקב אש ובית יוסף להבה ובית עשו לקש ודלקו בהם ואכלום ול וטל אומות העולם הנמשלים למוץ וזורם לרוח שנ יהיו כמיץ לפני רוח ומלאך יי דוחת ואומר תזרם ורוח תשאם וסערה תפיץ אותם אבל ישראל הנמשלים בחטים מה כתוב בהם ואתה תגיל ביי ובקדוש ישראל תתהלל"@he ;
    oa:hasSelector opp:unit_fol_43v_1_u2_selector ;
    oa:hasSource opp:passage_fol_43v_1 .

