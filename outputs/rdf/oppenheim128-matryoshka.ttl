opp:unit_fol_182v_2_u2 a opp:TextUnit ;
    rdfs:label "fol_182v_2#u2" ;
    opp:closestWitness opp:work_Babylonian_Talmud ;
    opp:earliestWitness opp:work_Babylonian_Talmud ;
    rdf:value "באדם אחד שנתן עיניו באשת רבו ושוליא דנגרי הוה פעם אחת עטדך רבו לטת אמ לו שגר אשתך עמי ואני אלוך שגרה עמו שהתהו בביתו ג ימים קדם הוא ובא יתלו אמ לו אשתי ששגרתי אצלך היכן היא אמ ליה פטרתיה לאלתר אלא שמערבי שמתעללין בה בדחד אמ לו מה אעשה לה אמ לו גרש אותה אמ לו כתובתה מרובה אמ לו אני אליך הלוהו לו כ כתובתה וגרשה עמד הוא ונשאה וכשהגיע זמנו לא היה לומה לפרוע אמ לו בא ועשה עמי בחובך והיו הם יושבים ואוכלים והוא עומד ומשקה עליהם והיו דמענת יורדות מיגיניו ונופלות בתויך כוסיהן ועל אותו מעשה נחתם גזרדין וישאמ על שתי פתילות בנר אחד כת איכה ישבה בדד אמ רבא אמ ר יוחנן מפני מה לקו ישראל באיכה מפני שעברו על לו כר יתות שנאמרו למשה בסיני ישבה בדד אמ רבא אמ ר יוחנן אמ להם הקבה לישראל אני אמרתי וישכן ישראל בט בדד ועכשו בדד יהיה מושבם העיר רבתי עם שהיו משיאין קטנה לגדול וגדולה לקנן כדי שיהיו לה בנים הרבה היתה כאלמנה אמ לב יהודה אמ רב כאלמנה ולא אלמנה ממש"@he ;
    oa:hasSelector opp:unit_fol_182v_2_u2_selector ;
    oa:hasSource opp:passage_fol_182v_2 .

