    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "יי מה ושיע כי אם עונותיכם היו מבדינים שנות ימין עליון אמ ר שמעזבן לקיש אם חלאים הם אית סיברא דכל הת דתשיש סופיה מבריא אם שנות ימין עליון הוא לית סברה היא דעתיה דר שמעון בן לקיש דאמ כי אם מאס מאסתנו אם מאיסה היא לית סברה ואם קציפה היא אית סיברה דכל רע לסופיה מתרצה וציון אומ עזבני ושכחני שנ ותאמר ציון וכו מה צשונן אדם חי גבר על חטאיו דיא שהוא חי אמ ר ברכיה חייתי בידך וחי ואת מתאונן אמ ר חוניא גבור בחטאים ומתאונן אמ ר לוי מה יתאונן אדם חי על חי העולמים אם בקש להתאונן גבר על חטאיו יתאונן אמ ר יודן יעמד כגבור על חטאיו ואליתאונן ר אומ תרעומלים בני תרעומנים ארם הראשון אני הייתי עסוק עמו לעשות לו עזר שנ ידנשה לו עזר כנגדו והוא מתרעם לפני ואומ האשה אשר נתת עמדי אף יעקב כן עשה לי אני עסקתי עמו על בנו להמליכו על מצרים והוא מתרעם עליו ואומר נסתרה דרכי משי אף בניו עשו לי כן במדבר אני הייתי עסוק לבור להם לחם קל כדרך"@he ;
    oa:hasSelector opp:unit_fol_155r_1_u1_selector ;
    oa:hasSource opp:passage_fol_155r_1 .

opp:unit_fol_155v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_155v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "עזבני ושכחני שנ ותאמר ציון וכו וחרה אפי בו ביום ההוא ועזבתים אמ ר אחא יום אחד היה פורח אפו שלהקבה פיוספים אלו עשו תשובה פשרו אמ ר תנחומא פיוספין אינון עבדין ואנא עבדית אינון עברין ועזבני והפח את בריתי ואנא עברית ועזבתים יוהסתרתי פני מהם דא וחדה אפי בו ביום ההוא בבבל ועזבתים במדי והסתרתי פני מהם ביון והיה לאכול באדום על שם אכלה ומדקה ומעצחוהו רעות רבות אלו ק תוכחות חסרב שבתנהה ואמר ביום ההוא הלא כי אין אלה בקרבי מצאוני הרעות האלה לו היה בקרבי לא ינצאוני הרעות האלה אלו היה בתוכו לא גליתי איון אומ עזבני ושכחנ ההד ותאמר יציון וכו א אשכחך ירושלם תשכח ימיני כר קפרא אמ קלו בידך וקצך ורם לבבד ושכחת את יי אלהיגך וקצך בידיאם אשלחך ירושלם ר רוסא אמ אם"@he ;
    oa:hasSelector opp:unit_fol_155v_1_u1_selector ;
    oa:hasSource opp:passage_fol_155v_1 .

opp:unit_fol_156v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_156v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "שהיתה אחת מהן מביאה שלפוחית של תרנגונת וממלזה שמן אפרסמון ונותנה אותה בין עקיבה למנעלה וכשהיתה מגעת לכת שלבחורים והיתה רורסת עליה היא נבקעת והיתה הרוח יוצאה ממנה ומפיעפע בהם כארכ של עכנה והיה הבה אומ לירמיהו ראה מה לו עושות כאן תגלו מראן ומכאן והי ירמיהו חוזר עליהן ואומ בנותי שובו עד שלא קבאו השונאים עליכם ומה היו אומ ימהר יחישה מעשהו למען נראה רופוס יראה אותי ונוטלכי לו לאשה זפרכום ירזה אותי ונוטלני לו לאשה ותקרב ותביה ע נצת קדושישראל ונדעה תדע על דמן הוא קימאעל דידן ועל דידיה וכיון שגרמו העונות ונכנסו השונבאים לירושלם היו יוצאות מקושטות כחונות והיה רופו רואה אחת מהן ונוטלה לו ראשה ומעלה ומושיבה בקרונין אמ הקבה הא קמת על דידהון קמת ועל דידי לאקמת מה עשה להן הקבה אמ ר אלעזר הכה אותן בצרעת שנ ושפח יי קדקד בנות ציון ואין ושפח אלא צרכת שנא ולשאת ולספחת ר יוסי בר חנינא אמ העלה ראשן משפחות משפחות שלכנים ור חייא בר אבא אמ עשה אוכן שפחות מכודנות אמהן משעבדץ ר ברכיה חלפו בר זברי בשם ר יוסי ספח ספחכתו שמר משפחותיהם שכא יתערב זרע עמי הארצות בזרע הקדש אעפכ לא חזרו בהן"@he ;
    oa:hasSelector opp:unit_fol_156v_1_u1_selector ;
    oa:hasSource opp:passage_fol_156v_1 .

opp:unit_fol_158r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_158r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "עד מתי אתם מדקקים כנגד ישראל ומטנפים בהם ת אהבון ריק רודפים אחר דברים שלריקנות לאמר אלהים עזבו שכחו אין השבינה חיזרת לו עוד אלא תברשו כזב סלת אמ הקבה מה אתם סגברים על שסלקתי מישוראל לשעה שהא לעולם ודעי כי הפלה יי חסידלו כבר בשרתים על ידי שעיה ואמ להם עניה סוערה לא נחמה הנה אנכי וכו מהו עניה עניה מן הצדיקים עניה מדברי תורה עביה מזהמצות עליה ממעשים טובים סערה משערתה שער ערוה מאומות העולם דכתו זכר י לבני אדום את יום ירושלם האומרים ערו ערו עד היסוד בה ר אבא בר כהנא אמ מהו ערו ערו פגרו פגרו דכתו חומת בבל הרחבה ערער תתערער ר לוי אמ פנופנו דכת ותער כדה אלהשקת על דעתיה דר אבא לוידאמ פנו פנו עד יסודיה נכון עד היסוד בה כא נחמה אמר כי כל מקום שנ אין לה סופה לה י ותהי שרי עקרה אין כה ולד"@he ;
    oa:hasSelector opp:unit_fol_158r_1_u1_selector ;
    oa:hasSource opp:passage_fol_158r_1 .

opp:unit_fol_159v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_159v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "להם מתו זה אמרו לו שער מזרחי של בית המקדש הוא ושני פישפישח שלו אבן אחת שלמרגלית ובל גבולך לאבני חפץ אמ ר בנימין בן לוי עתידין תחומי ירושכם להיותמאבנים טובות ומרגליות ההד וכל גבולך לאבניחפץ אמ ר לוי עתידין להיות תחומי ירושלם מלאים י מיל על יח מיל אבנים טובות ומרגליות לפי שבעולם הזה היה ישראל אחוד מתרכם מחבידו שהוא חייב לו והוא אומר לו גלך אגבל הדין כעמים שהוא עישר שלום ביניהם לית תרתין אפיאנפקק נפקין מתרציין אבל לעתה לכא אם חיב אדם לחבירו והוא אומ לו נלך אצל המשיח בירושלם וכיון שהן מגיעין לתחומי ירושלם הם מוצאים אבנים טובות ומרנליות והוא נסב תרתין מנהון אמ ליה יתיר מן אלין אנא חייב לך והוא אמ ליה אף לא כדין הא שרי והאשביק לך י הה השם גבולר שלום וכל בניך למודי יי ורב שלום בניך ד רובי שלומות הן א יפדח בימיו צדיק ורב שלום עד בלי ירח ב שלום רב לאוהבי תורתך גוענוים יירשו ארץ והתענגו על רוב שלום"@he ;
    oa:hasSelector opp:unit_fol_159v_1_u1_selector ;
    oa:hasSource opp:passage_fol_159v_1 .

opp:unit_fol_163v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_163v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מושיבי עקרת הבית זו ציון שנ רני עקרה אם הבנים שמחה ואמרת בלבבך מי ילד לי את אלה אמ רבין רני עקרה הא רנה אם היא עקרה אמ ר מאיר רני עקרה אומה עקורה שעקרויה אומית העולם דכתזכור יי לבני אדום את יום ירושרם האומ ערו ערו עד היסוד בה על דעתיה דר אבא בר כהגא דאמ פנו פנו עד יסודיה מטיין עד היסוד בה אמ ר אבא בר כהנא עקר מסובים משל לאה היו אלא שהועישן רול עקרדכב ואל עקרה אמר ר צחק רחל היתה עקרה שלבית רכת ורחל עקרה תני ר שמעון בן יוחאי לפי שכל הדברים תלוים ברחל לפיכך נקראו בני ישראל לשמה שנ רחל מבכה על בניה וכא סוף דבר לשמה אלא לשם בנה שנ הבן יקיר לי אפרים לא ילדה אמ ר לוי כל מקום שנ און לה ולד לסוף זהוילה והא כת ותהי שרי עקרה אןלה ולד וכת הניקה בנים שרה ולחנה אין ילדים והוה לה שנ כי פקד י אתחנה צין היא דורשלה אין לה ונאמ ובא לצין גואל פצחירנה ובהלי בעשרה לשונות נקראת שמסה גילה שישה עליצה"@he ;
    oa:hasSelector opp:unit_fol_163v_1_u1_selector ;
    oa:hasSource opp:passage_fol_163v_1 .

opp:unit_fol_167r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_167r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "ר שמעח בן יחצרק שאל לר שמואל בר נחמני לפי ששמעתי עליך שאתה בעל הגדה מהיכן היתה אורה יוצאה לעולם מתחלה נתעטף הקבה באצטלית לבנה והיה כל העולם מבהיק משזיו הדרו אמרה לו בלחישה אמ לו מקרא מלא הוא שנ עוטה אור כשלמה ואתה אמ בלחישה אמ לו כשם שאמרו לי בלחישה כןך אמרתי בלחישה ואלולי דרשה ר יצחק בדבים לא הוה איפשר לאמרה קמוי מכאן מה הוון אמרין אמ ר ברכיה ממקום בית המקדש היתה אורה יוצאה לעולם מה טעם והנה כבוד אלהי ישראל בא מדרך הקדים וקולו כקול מים רבים והארץ האירה מכבודו ואין כבודו אלא בית המקדש של כסא כבוד מרום מראשון מקום מקדשנו כ והכה החשר יכסה ארץ ר אבא בר כהנא אמ חשך ואפלה שמשו במצרים גימים"@he ;
    oa:hasSelector opp:unit_fol_167r_1_u1_selector ;
    oa:hasSource opp:passage_fol_167r_1 .

opp:unit_fol_167r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_167r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "אמ ר ברכיה ממקום בית המקדש היתה אורה יוצאה לעולם מה טעם והנה כבוד אלהי ישראל בא מדרך הקדים וקולו כקול מים רבים והארץ האירה מכבודו ואין כבודו אלא בית המקדש של כסא כבוד מרום מראשון מקום מקדשנו כ והכה החשר יכסה ארץ ר אבא בר כהנא אמ חשך ואפלה שמשו במצרים גימים ומה טעם ויהי חשך אפלה בכל ארץ מצרים שלש ימים אבל תהו ובהו לא שמשו בעולם הזה והיכן עתידין לשמש הוי אומ בכקך גדול של רומי שנ וננה עליה קו תהו ואבני בהו ורבנן אמ אומות העולם שלא קבלו את התורה שנתנה מתוך החשך שנ ויהי כשמע את הקול מתוך החשך ועל ישראל שקבלו אותה והיא נמשלת לנד אומר ועליך יזרח י וכבודו עליך יראה"@he ;
    oa:hasSelector opp:unit_fol_167r_1_u2_selector ;
    oa:hasSource opp:passage_fol_167r_1 .

opp:unit_fol_167v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_167v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר יהושעבן לוי אתה מוצא שבשעה שילדה שרה אמנו את יצחק היו אומות העולם אומרים חס ושלום לא ילדה שרה את יצחק אלא שפחתה ילדתו מה עשה להם הקבה הוביש חוטידדיהם של מטרוניות שלהן והיו באות ומתאבקות בעפר רגליה של שרה אמנו ואומ לשרה עשי עמנו מצוה והניקי את בנינו והיתה שרה נוהגת בעצמה דבר צניעות אמ אה אברהם אין זו שעת צניעות אלא שבי לך בשוק וקדשי שמו של הקבה וגלי דדיך להן כדי שיראו חסד וגבודה שעשה עמנו הקבה והיו דדיה לובעות חלב כשת מניינות ההד וברכתי אותה וגם נתתי ממנה לך בן שהו שכשתי בריכות שני דדיה והרי דברים קל וחומר ומה אם בשר ודם שבאת לו שמחה שמחוה כל עמו ישראל שהם יושבים ומצפים ליש לישועתו של הקבה זה כמה שנים וכמה ימים על אחת כמה וכמה שוש אשיש ביי זה היום עשה יי נגילה ונשמחה בו אמ ר"@he ;
    oa:hasSelector opp:unit_fol_167v_1_u1_selector ;
    oa:hasSource opp:passage_fol_167v_1 .

opp:unit_fol_170r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_170r_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    rdf:value "מאחימעץ בן צדוק שאמ ארובה נא ואבשרה את המלך כי שפטו י מיד אויביו וכו ויאמר המלך השלום לנער לאבשלום אמ ר אבא בר כהנא אמ דוד אין הוא דוכוס אתעביד ואין הוה אפרכוס הוה עביד איסטרטליטיס והנה הכושי בא ויאמר הכושי יתבשר אדני המלך ויאמר המלך השלום לנער לאבשכום ויאמר הכושי יהיו כנעד אייבי אדני המלך וירגז המלך ויעל על עלית השער אמ ר חננא בד יצחק ומן לטוביירים ודקרו אותו והרי דברים קל וחומר ומה אחימעץ בן בדוק שלא על בן המלך לא טובה ולא רעה ר זכה לכל הכבוד הזה מי שהוא עלמד סניגוריא על ישראל על אחת כמה וכמה תדע לך שהוא כן שכל ימיו שלמשה לא נקרא איש האלהים עד שבי רך לישראל שנוזאת הברכה אשרברך משה איש האלהים מגע בר ירבוהו לאם וברכה לראש משביר מונע בר בעת צרה יקבוהו לאם יעשה ארירה לאומות וברכה לראש משבר זהו המשביר בעת צרה דא מונעבר זהו שמונע ברה שלתורה ירבוהו לאם יעשה אריכה לאומות וברכה לראש משביר זה המלמד תורה בעין יפה דא מונעבר זה"@he ;
    oa:hasSelector opp:unit_fol_170r_1_u1_selector ;
    oa:hasSource opp:passage_fol_170r_1 .

