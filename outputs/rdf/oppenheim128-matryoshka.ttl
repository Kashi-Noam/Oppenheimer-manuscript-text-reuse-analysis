    rdf:value "כל אחד ואחד מהם במקומו מה עשה נטל אצבעו של בנו הגדול והניחה בעינו אמ אצבע שלא הנחתי לגרוף אותה ר טפה תנקראת עינו ועוד מעשה באשה אחת שהיולהג בנים הלכו שני בניה למלחמה ונטלה את בכה שהיא מניקה ובשלתו בקדרה כשהן אוכלין הכירו את ידי אחיהן כיון שראו כך עלו לגג והפילו עצמן לארץ ומתו עליהם מקונן ירמיה טובים היו חללי חרב מחללי רעב ואף ירושלם צועקת וארמרת אללי לי כי הייתי כאספיקיץ הקוצר מכיח ספיחים והבוצר מניח עוכלות אבל אני רא נשתיר כי כלום ונמסרתי ביד נבוכד לצר הרשע כרחל ביד ארי וכגדי ביד הטבח"@he ;
    oa:hasSelector opp:unit_fol_184v_1_u2_selector ;
    oa:hasSource opp:passage_fol_184v_1 .

opp:unit_fol_184v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "146"^^xsd:nonNegativeInteger ;
