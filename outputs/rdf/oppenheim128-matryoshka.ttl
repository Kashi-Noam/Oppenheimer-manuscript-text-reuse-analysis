opp:unit_fol_202v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_202v_2#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    rdf:value "היה מתריס ואומר מי יי אשר אשמע בקולו ומהו מי יי אמ להם פרעה למשה ילאהרן ומה שמו של אלהיכם ומה כבודו ומה אומנותו ומה כחו ומה עבודתו וגבורתו ומה טיבו מיום שעמד אלהיכם למלכות ולמה לא שיגר לי אגרות ולא קביא לי אכסניא ולא ידע שכל מלכי העולם תחת ידי משל למה הדבר דומה לארי וזאב ושועל שהיו מהלכין בספתה והחמור גובה המכס אמ להם החמור תנו לי מכס אמ לו שועל כמה עזים פניך ארי וכל חיות יושבים ואתה גובה מכס אמ לו חמור מן המלך אני נוטל ולננזיהמלך אני מרנים אמ להם הארי קרבי לי ספינה על שוטה זה קרבו לו וטרפו אמ לשועל סדר לי אבריו של שוטה זה במקום אחד הלך שועל וסדרן נטלאת לבו ואכלו כשבא ארי אמ לו לבו של זה היכן הוא אמ לו אדני המלך לא היהלי לב שאם היה לו לב לא היה לוקחמכס מן המלך כך פרעה הרשע"@he ;
    oa:hasSelector opp:unit_fol_202v_2_u1_selector ;
    oa:hasSource opp:passage_fol_202v_2 .

