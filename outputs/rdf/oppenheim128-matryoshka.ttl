    rdf:value "אמ ר חזקה בשם ר ירמיה כך היה ר שמעון בן יוחאי אומ קרב אברקם מן גביה ועד גבאי ואנא מקריב מן גבאי ועד דייתי מלכא משיחא ואין לא יצרף עימיה אחיה השילוני ואנא מקרבין כל עמא עאל תליתאה ודרש ויאמר לה לכי מכרי את השמן ושלמי זהנשיך ית בניך תחיביוהי רינא ר שמעון בן יוחאי ור אלעזר עבדין טמירין תלת עשרה שנין בהדא מערתא דבקע אכלין חירובין דתרומן עד שהעלה גופן חלדות חלדות לסוף יג שנין נפקר שמע בן יוחאי ויתיב ליה פל תרע מערתא וחמא לחד בר נשפרים מצדתיה למצד עופין פרסה זמן קדמאי שמע ברת קלא דאמרת דימים ואשתזבת פרסה זמן תנין ושמע ברת קלא אמ סכק לה ואתפיסת אמ אפי צפר מבלעדי שמא לא"@he ;
    oa:hasSelector opp:unit_fol_133r_2_u2_selector ;
    oa:hasSource opp:passage_fol_133r_2 .

opp:unit_fol_133v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_133v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Jerusalem_Talmud ;
    rdf:value "אמרו צריכים אנו למדכיא והוה נסיב תרמיסן ומקבץ ומסלק בשוקא כל הן דהוה תמן חד מית הויא טיף וסליק ליה חמתיה אדכותי אמ ליה אלא אזל מדחיך בהדין סבא דיהודאי מה עבד נסבהד מיתא דאזיל וטמריה בחד מן אלין שוקיא דדכי ואמ ליה נקתא שוק כלן אמ ליה אין אפקית הלין מיתא אמ ליה גוד חמי לי צפה ר שמעון בן יוחאי ברוח הקדש וישב שם ואמר גוזר אני על העליונים שירדו על התחתונים שיעלו וכן הות ליה מיד נפיק עבר קומי כנשתא דמגדלא שמת קלהון דמינוקאי ספרא דמגדלא אמ הא בר יוחאי דדכי בטבריא אמ ליה ולא מן המנין היית מיד נעשה גל נשל עצמות ר שמלון בזייוחאי הוה שמטתא וחמא בר נש דלקיט ספיחי שביעית אמ ליה ברי ולא שביעית היא אמ ליה ולא את הוא הוא שאת מתיר אמ לי אין וחבירי חלוקין עלי קרא עלייוכקץ גדר ישכנו נחש וכןהות ליה"@he ;
    oa:hasSelector opp:unit_fol_133v_1_u1_selector ;
    oa:hasSource opp:passage_fol_133v_1 .

opp:unit_fol_135v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_135v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר אחא גבורים הם דבריתורה להפרע ממי שאינו עמל בהן כל צרכן אמ ר אבין דברי תורה נמשלו בקונדיטון מה קונדיטון הזה יש בו יין ודבש ופלפלין ויש בה ייז שנ כי טובים דודיך מיין ויש בה דבש שנ ומתוקים מדבש ונופת צופים ויש בה פלפלין שנ צרוכה אמרתך מאד ועבדך אהבה כל מעשה יום מתן תורה היו משולשין התורה משלשת תורה נבאים וכתובים ואותיותיה משלשים אלם בית גימל וישראל משלשים כהנים לויים וישראל ואבות שלשה אברהם יצרוק ויעקב ומשה שלישי ביניהם שנ אנכי עמד בין אדני וביניכלי ואותיותיו משלשין מנ שח הא ומן שבנו שלישי ראובן שמעזליי ואותיות שבטו למיד ואו וד ואח נשלשה וישוה אהרן ומורים נצתן לשנ מה שנ והצרינהו ישיישה יייזיםי ודיום יישכישי ושנ הו ביוני השויהישי ידד יי לעיני נל הדים נול הר"@he ;
    oa:hasSelector opp:unit_fol_135v_1_u1_selector ;
    oa:hasSource opp:passage_fol_135v_1 .

opp:unit_fol_136r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_136r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הים וכת ויושע יי ביום ההוא את ישראל מיד מצרים והשמעתי בסיני שנ משמים השמעת דין ואין בכם זר זה יתרו שנ ואתם עדינאם יי ואנים תני ר שמעון בן יוחאי אמ הקה אם אתם עדי אני אל ואם אין אתם עדי כביכול כרכ זמן זמן היה לאדם הראשון שיכנם לבן עדן שנ ויקח יי אלהים את האדם ויניחהו בכן עדן וזמן היה לו רצאת שנ ויגרש את האדם וזמן היה לנח ולבניו שיכנסו לתיבה שנ בא אתה וכל ביתך אלהתיבה וזמן היה לו שיצא שנ צא מן התבה זמן היה לאבינו אברהם שתנתן המילה על ידו וזמן היה שיפלו מבניו איזת במדבר ואחת במצרים ועת לכל חפץ תחת השמים אמ ר ביבי חפכיץ שוהוא למטה מן השמים נתח למנוה מז השמים ואי זו זו תורה ואימתי בחדש הנאלישי חרק צדקה אהלךך בתיך נתיבות משפט התורה אומרת באי זו שביל זני מכויה בדרנן של ניוניי צדקות שנ בתוך נתיבית משפני אמ יהונא לוחקן יכם י של מטרונה שהיותה עוצרת בשוה ומייימנטים שניךם מלריניה וזין מאחריה כד ה יי יתידה דיני זמלפניה ודינין מאחריה דינין מלפניה שם שם לו חק ומשפט"@he ;
    oa:hasSelector opp:unit_fol_136r_1_u1_selector ;
    oa:hasSource opp:passage_fol_136r_1 .

opp:unit_fol_136v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_136v_1#u1" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "את בנו ואמ היו מוניה איפאטייא לפדיון בני כ אמ הקבה לישראל היו מוניט אפאטיא לאאם מצויים מצרים אמ ר לוי בשם ר חמא בר חנינא משל למלך שהיה משיא את בתו ואמ היו מונים אפאטיא לנשואי בתי כך אמ הקבה לישראל היו מונים יום מתן תורה שנאמ ביום הזה באו מדבר סיני אמ ר יהושע בן לוי משל לבן מלך שהיה מטייל בשוק וכגע בו אוהבי של מלך ומרא חיקו אבנים טובות ומדגליות אמ המלך פתחו לי את האסבריות שלא יהא בני אומר אלולי שבא יתרו ולמד את הדינין לאהיה לו ליתן לנו את התורה אלא הריני נותן להם את התורה שכולה דינין שנ ואלה המשפטים אשר תשים לפניהם אמ ר לוי משל למלך שהיה מבקש ליקח אשה בת טובים ובת גנסים ואמ אל אהיה אני תובע בה משאני עושה עמה כמה טובות ואחר כך אני תובעה והציגה ערומה והלבישה כך כשה הקבה לישראל ואלבישך רקמה"@he ;
    oa:hasSelector opp:unit_fol_136v_1_u1_selector ;
    oa:hasSource opp:passage_fol_136v_1 .

opp:unit_fol_137r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_137r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והעבירם בים שנ ובני ישראל קלכו ביבשה בתוך הים שבאים באו עליה והצילה אלו עמלקיים אמ ר אלעזר משל למלך שהיה מבקש ליקח אשה ואמ אל אתבענה עד שאעשה עמה כמה טובות ואחרכך אני תובעבה ראה אותה אצל הנחתום ומלא חיקה גלוסקאות כך עשה הקבה לישראל שנ הנני ממטיר לכם לחם מן השמים מצאה אצל החנוני והשקה אותת קונדיטון כך עשה הקבה לישראל שנ אזישירישראל את השירה הזאת עלי באר ענו לה מצאה אצל הפטס ומלא חיקה פטומות שנ ויגז שליים מןהים מצאה אל פרקרים ומלא חיקה פרקריסים שנ ויניקהו דבש מסלע ר יודן אמ משל למלך שהוא משיא את בתו וקבע קראטיסים בים ואמ בני רומי ייתון לסוריא ובני סוריא לא יסקון לרומי וכיזן שהשיא את בתו התיר קרטיסיס כך עד שלא ניתנ תורה השמים שמים ליי והארץ נתן לבני אהם אבל משניתנה תורה ומשה עלה אל האלהים וכת וירד יי על הר סיני אמ ר יודה בר סימון משל למלך שהיה מבקש להשיא את בתו והיה לו"@he ;
    oa:hasSelector opp:unit_fol_137r_1_u1_selector ;
    oa:hasSource opp:passage_fol_137r_1 .

opp:unit_fol_137v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_137v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כשיצאו ישראל ממצרים היו ראויים לקבל את התורה מיד אלא היה בהם בעלי מומין משעבו טיט ולבנים והתורה היא תמימה ואינה ראויה ליתן לבעלי מימין אמ הקבה אם ממתין להם עד שאני בורא להם עבולם חדש הרי אני משהה שמתת שמחת תורה אבל לעתיד לבא אז תפקחנה עיכי עורים ברם הכא וכל העם רואים את הקולותו ואת הלפידים מה לעתיד לבא ואזני חרשיםיר יתפקחנה ברם הכה ניאמרו כל אשר דבר יי נעשה וצשמע מה לעתיד לבא אז ידלג כאיל פסח ברם הכא ויוצא משכה את העם לקאד לקראת האלהים מן המחנת מה לעתיד לבא ותרן לשון אלם ואף הכא ויעכו כל העם יחדו ויאמרו ר אבא בר יודן ור יהודה בר סימון בשם ר יהושע אמ שאלתי את ר חייא הגדול הגיורת והשבויה ומשוחרר ומשוחררת לא ינשאו ולא יתארסו עדשיהיו להן גחדשים ושלשתן היו בישראל הגיורת שנ כי גרים הייתם בארץ מצרים השבויה שנ כל שדביהם החחיקו בם מאנו שלחם משוחררת שנ מהיות להם עבדים מפני מה ניתנה תורה במזל תאומים אמ ר אבין אמ הקבה"@he ;
    oa:hasSelector opp:unit_fol_137v_1_u1_selector ;
    oa:hasSource opp:passage_fol_137v_1 .

opp:unit_fol_138r_1_u1 a opp:TextUnit ;
