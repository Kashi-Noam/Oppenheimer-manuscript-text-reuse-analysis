    oa:start "105"^^xsd:nonNegativeInteger .

opp:unit_fol_40r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_40r_1#u1" ;
    opp:closestWitness opp:work_Midrash_Tanchuma ;
    opp:earliestWitness opp:work_Midrash_Tanchuma ;
    rdf:value "הגדילות באור ואינן גדיכות באויר מאי ניהי זו סלמנדרא כיצד ברייתה אמרו הוגגין העושיאחת הזכוכית כשמסיקין את הכ בשן שבעה ימים ושבעה לילות רצופין מכובד האור יוצא משם ברייה הדומה לעכבר והבר ותקורין אותה סלמנדרא אדם סך ידו מדמה או אחד מאיבריו אין האור שולטת באותו מקום כמה על שתחלת ברייתה מן האור מכאן אמרו תלמידי חכמים אין אור של גיהנם שולטת בהם קל וחומר מסלמנדרא ומה סלמנדרא על שתחלת ברייתה מן האור הסך מדמה אין האור שולטת בו תלמידי חכמים העוסקים בתורה שהיא אש שנאמ אש דה למו וניתנה מיד אש ולומדיה אש שנ בית יעקד אש על אחת כמה וכמה לכך נאמר מה גדלו מעשיך יי"@he ;
    oa:hasSelector opp:unit_fol_40r_1_u1_selector ;
    oa:hasSource opp:passage_fol_40r_1 .

opp:unit_fol_40r_1_u1_selector a opp:TokenPositionSelector ;
