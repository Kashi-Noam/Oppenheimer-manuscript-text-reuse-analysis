    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "אלא מעליו ואם אכל הרי זה רעבתן וגרגרן ולא ישתה שתיכוסות ויברך ברנת המזון מפני שנראה כגרגרן סליק פרקא שנים שהיו יושבין על שלחן אחד הגדול שבהן שולח יד תחלה ואחרכך הקטן ואם שרח הרי זה גרגרן ומעשה בר עקיבא שעשה סעודה לתלמידיו הביא לפניהם שני תבשילין אחד נא ואחד מבושל בתחלה הביא לפניהם נא הפקח שבהם אחז את הקלח בידו אחת ולש ותלשו בידו אחת לא בא אחריו משך ידו ממנו ואכל פתי ריקן הטפש שבהם אחח את הקלח בידו אחת ונשכו בשניו אמ לו ר עקיבא לאכך כנל אלא הנח עקבך עליו בתוך הקערה ואחר כך תביי לפניהם מרושל אכלו ושתו ונסתפקו אחרכך אמ להם בני לא עשיתי לכם כל כך אלא לבדוהק אתכם אם יש בידכם דרך ארץ אם לאו לא יאכל אדם עד ארבע שעות ולא ירחץ בבית המרחץ עד ארבע שעות חמין רובן קשה לגוף ומיעוטן יפה יין רובו קשה לגוף ומיעוטו יפה שלשה דברים שקולין זה כזה חכמה יראה ענוה"@he ;
    oa:hasSelector opp:unit_fol_62v_1_u2_selector ;
    oa:hasSource opp:passage_fol_62v_1 .

opp:unit_fol_62v_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "181"^^xsd:nonNegativeInteger ;
    oa:start "25"^^xsd:nonNegativeInteger .

opp:unit_fol_62v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_62v_2#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "הנכנס לבית הכסא לא יחזיר פניו למערבו ולא לאחוריו אלא ליאצרדין ואל יפרע עצמו עד שישב ואל יקנח בימין ארא אלא בשמאל ומעשה בר עקיבא שהלך אחר ר יהושע לראות את המעשה ראה שלא נכנס רבית הכסא אלא לצדדין ולא פרע עצמו עד שישב ולא קנח אלא בשמאל ומפני מה אין מקנחין בימין ר אליעזר אומ מפני שאוכל בה ר יהושע או מפני ששותה בה רג אומ מפני שמראה בה טעמי תורה לא ישמח אדם בין הבוכים ולאיבכה בין השמחים ולא יהא ער בין הישנים ולא ישן בין הערים ולא עומד בין היושבים ולא יושב בין העזמדים כללו של דבר אליישנה אדם דעתו מדעת חבריו ובני אדם סליק פרקא הנכנם לביה אנ יאמר להם תנו לי ואוכל עד שיאמרו ליהם מזגו לו את הכום שוהא ושותהו וכמה ישהא בחמין שלש פעמים ובצונן ארבע אמ ר יהודה במה דברים אמורים ברוס שבגליל אבל בכום שביהודה שותה שוהא כל צרכו ושותהו לא יאמר אדם"@he ;
    oa:hasSelector opp:unit_fol_62v_2_u1_selector ;
    oa:hasSource opp:passage_fol_62v_2 .

opp:unit_fol_62v_2_u1_selector a opp:TokenPositionSelector ;
