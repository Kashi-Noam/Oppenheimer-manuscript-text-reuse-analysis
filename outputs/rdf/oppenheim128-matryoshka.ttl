opp:unit_fol_197r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_197r_1#u2" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Yalkut_Shimoni_on_Nach ;
    rdf:value "בוכים בלילה וירמיהו ביום ואני ביום ובלילה לכך נאמר ואבכה יומם ולילה דא מי יתן ראשי מים מהכת למעלה מן הענין כל שבר בת עמי אלולי הכת מדבר כן הלשון שתהיה אומ כן היתה ראויה להקטע אלא קדמו הראשונים שנ וקדמונים אחזו שער משל לבן מלך שבקש להיביה אבן כיון שבא להגביהה נפלה עלו ושברתו שמע המלך שנשבר בנו התחיל אנמ נשברתי אמרו לו בני פלטין שלו בנך נשבר ואתה או נשבי מהו קדרתי שמה החזיקתני משל לחנם שלא ראה אבל מימיו והיה לו בן אחד ומת קרא לתלמידיו אמ להם הראו לי היאך האחרים מתאבלים"@he ;
    oa:hasSelector opp:unit_fol_197r_1_u2_selector ;
    oa:hasSource opp:passage_fol_197r_1 .

opp:unit_fol_197r_1_u2_selector a opp:TokenPositionSelector ;
