opp:unit_fol_196v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_196v_2#u1" ;
    opp:closestWitness opp:work_Midrash_Lekach_Tov_on_Lamentations ;
    opp:earliestWitness opp:work_Midrash_Lekach_Tov_on_Lamentations ;
    rdf:value "בוכה ומבכה אחרים עמה דא בלילה שכל הבוכה בלילה קולו נשמע אמ ר אבא לילה היה מושך עמהם קייה דא כל הבוכה בלילה אפי מזלו לונין ענמו דח בלירה הבוכה בלכה רל השומע קולו בונה בוכה כנגדו מעשה באשה אחת שהיתה בשכונתו שלרבן גמליאל והיה לה בן תשחורת ומת והיתה בוכה עליו בליכות והיה רבן גמליאל שומע קולו ונזכר חורבן בית המקדש ועומד ובוכה כנגדה עד שנשרו ריסי עיניו והרגישו בו תלמד והוציאוה משכונתו דא מי יתן ראשימים ועיני מקור דמעה ואבכה יומם ולילה וירמיה מקונן ברוח הקדש ואומ בכה תבכה בלילה מי בכה ישראל בכו ויש אומ ירמה בכה אמ ר אחא כיון שחרבה ציון וירושלם ובית המקדש ונשרף ההיכל וגלו בקולרין ובשלשלאות היו ישראל מברשי לבכות ולא היו מניחין אותם אלא היו רודפים ומכים אותם על צואריהם שנ על צוארנו נרדפנו וכיון שיצאו יום ראשון אלו נפנו לקכילה ושתיה ולו נפנו לבכיה וכן נבוזר אדן מצוהו על ירמיהו גבוכד נצר קחנו ועינך שים עליו ואל תעש לו מאומה רע אמרו ישראל לירמיה נעשה התנאי בינינו את נתון ברוחה הוי את בוכה ביום"@he ;
    oa:hasSelector opp:unit_fol_196v_2_u1_selector ;
    oa:hasSource opp:passage_fol_196v_2 .

opp:unit_fol_196v_2_u1_selector a opp:TokenPositionSelector ;
