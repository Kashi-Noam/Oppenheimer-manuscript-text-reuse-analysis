opp:unit_fol_135r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_135r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הלא כתבת לד של שים במונו טת וונו ומעשולשים לר וזר שלו ריו זו הורה צינ ריפודזירוגמא י א איהו בעינך כייודד וומא בו שהכל יצז להרדתי שנ ייים הזה שציך יי זלידו ליישית את האקים האנה ואתה ושתניים ושמת זותם רכל לבכך וככל ופש שמיאל ברנחמיי אמ שלשים גבורים חיך מה דאת אמ ישנ שים על כ אמ ר שמואנ בר נחמן למו נמישלו עדי תיה שיז יניה יו הוה מתקיים לכיו יי כז הן דברי תרה מנה ימין למי שהוא עמל בהן ככל ציכן ומאי טעמיה י ויייית בגי נם וחרב פיפיות ר יהודה ירנא מה ורהין ר מוה א מאי ניפיית שתי הויות תורה שבנודב יהוירה שבעל ט ור נחמיה אמ פיפיות כה פיות חתי שהיא אוכלת משניצדדה ונותנת חיים בעולם הזה ובעולם ורבנן אמ כי היו שרי קדש ושרי האלהים גוזרים על העליונים והם עושין על התחתונים והם עושין"@he ;
    oa:hasSelector opp:unit_fol_135r_1_u1_selector ;
    oa:hasSource opp:passage_fol_135r_1 .

