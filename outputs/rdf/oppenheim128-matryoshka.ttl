opp:unit_fol_196v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_196v_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Midrash_HaGadol ;
    rdf:value "אמ ר עקיבא בלילט באב היה אברהם אבי בבית המקדש מטייל בין ארוכות וקצרות אחזו הקבה ואמ לו מה לידידי בביתי אמ לו היכן בני אמ לו גלו בחטאם אמ לפניו רבונו של עו ולא היה בם צדיקים אמ ליה סוגייהו בישין דכת עשותה המזמתה הרבים אמ לו ולא היו מקיימין את המילה אמ ובשר קדש יעברו מעליך ולא עוד אלא שהיו שמחים במפלתן אל ו שלאלו שנ כי רערני אז תעלחי וכת שמח לאוד לא ינקה בכה תבכה בלילה שתי בכיות הללו למה אחת בגלות יכניה ואחת בגלה צדקיהו י דא אחת על מקדש ראשון ואחת על מקדששני בלילה על עסקו לילה שנויבכו העם בלילה ההוא אמ להם הקבה אתם בכיתם בכיה שלחנם אני אקבע לכם בכיה לדורות ויבכו שבכו על לוחות הראשו שאלמלא לא נשתב אין כל בריה יכולה לשלוט בם שנ והמכתב מכתב אלהים הוא חרות על הלוחות י אל תיקריחרות אלא חירות יחירות ממלאך המית חירות מן המלכיות דא בכה תבכה שבנו עד שלא"@he ;
    oa:hasSelector opp:unit_fol_196v_1_u1_selector ;
    oa:hasSource opp:passage_fol_196v_1 .

opp:unit_fol_196v_1_u1_selector a opp:TokenPositionSelector ;
