opp:unit_fol_144r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_144r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מי גרם לי שאהא מפרשת שתי חלות בסוריא על שלא הפרשתי חלה אחת כתקנה בארץ ישראל סבורה הייתי שאני מקבלת שכר על שתים ואיני מקבלת שכד אלא על אחת מי גרם לי שאהא משמרת שני ימים טובים בסוריא על שלא שמרתי יום טוב אחד כתקונו בארץ ישראל סבוהה הייתי שאני מקבלת שכר על שנים ואיני מקבלת שכר אלא על אחד ר יוחנן הוה קר עליהון וגם אני נתתי להם חקים לא טובים"@he ;
    oa:hasSelector opp:unit_fol_144r_1_u1_selector ;
    oa:hasSource opp:passage_fol_144r_1 .

