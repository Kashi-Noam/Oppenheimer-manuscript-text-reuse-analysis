opp:unit_fol_140v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_140v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ כי דה יי את יעקב וגאלו מיד חזק ממנו ובחזירה היה רואה אצב אצבעית רגליהם וידיהם מושלכות מקוטיעות בדרך והה נוטלן ומחבקן ומנשקן ונותנן לתוך טליתו ואומר להם בני לא כך הייתי אומר לכם תנו ליי אלהיכם כבוד בטרם יחשיך עליכם דברי תורה בטרם יחשיך עליכם דברי נבואה כול ההרים אשא בכי ונהי על ההרים הרמים שנעשו מדבר אשאקינה כי נצתו מבלי איש עובר ולא דייכם שלא שמעתם בקולו אלא מקנה מקנים אותו בנס שלכם אעפכ מעוף השמים ועד בהמה נדדו הלכו אמ ר יוסי בר קלפתא נב שנה היו שלא נראה עוף טס על ארץ ישראל לקיים מה שנאמר מעוף השמים ועד בהמה נדדו הלכו אמ ר חוניא קודם למ שנה עד שלא גלו ישראל לבבל נטעו תמרים בבבל לפי שהיו להוטים אחר המתיקה לכי שהיא מרגלתאת הל שון לתרה תני בשםר הדי הודה שבע שנים נתקיים בה גפרית וימלח שרכה כל ארנה על שם והגביר ברית לרבים כותיים שבאו מה היו עושים מטליות מטליות היתה נשרפת זורעין כאן והיא נשרפת זורעין כאן והיא נשרפת"@he ;
    oa:hasSelector opp:unit_fol_140v_1_u1_selector ;
    oa:hasSource opp:passage_fol_140v_1 .

