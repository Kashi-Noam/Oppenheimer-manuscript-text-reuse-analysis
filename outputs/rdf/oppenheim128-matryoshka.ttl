opp:unit_fol_72r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_72r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אצם הששי דוד השביעי במלכים השביעי חביב שאול אישבש דוד שלמה רחבעם אביה אסא ונאמ ויקרא אסא אל ייי בשמטים השביעיה חביבה שנ וקדשתם את שנת החמשים שנה בשנים השביעית חביבה שנ והשביעית תשמטנה ונטשתה בימים השביעי חביב שנ ויברך אלהים את יום השביעי ויקדש אותו בחדשים השביעי חביב שנבחדש השביעי באחד לחדש ר אבא בריה דר פפי ור יהושע דסכנין בשם ר לוי אמ כל ימות השנה ישראל עסוקים במלאכתם ובראש השנה רם נוטלין שופרות ותוקעין והקבה עומד מכסא הדין ויושב בכסא רחמים ומתמלא עליהם רחמים והופך עליהם מדת הדין למדת רחמים אימתי בחדש השביעי באחד לחדש"@he ;
    oa:hasSelector opp:unit_fol_72r_1_u1_selector ;
    oa:hasSource opp:passage_fol_72r_1 .

