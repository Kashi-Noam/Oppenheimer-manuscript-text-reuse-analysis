    oa:start "31"^^xsd:nonNegativeInteger .

opp:unit_fol_191v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_191v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_Rabbati ;
    rdf:value "בשתי ידי אחריבנו שנ אף ידי יסדה ארץ וימיני טפחה שמים אמרו מלאכי השרת לנני הקבה רבונו של עולם דייך שהחרבת בית דירתך של מטה אל תחריב דירתך של מעלה שנ אלתנאץ למפא שמך אל קנבל כסאכבודך אמ להם וכי מלך בשר יודם אני שאני צריך תנחומיכם אני מכיר בראש ואני מכיר בסוף שנ ועד זקנה אניהוא ועד שיבה אני אסבול אלא רדו מרפני וראו אוהבי בני קביבי שמהלכין בשלש בשל שלאות על יצואריהם ושאו משאם מעליהם ולא מלאני השרת בלבריידו זלא אף הקבה ייד מעירפל שלו ש שנ ונשא עמם במשא אילמלא כתוב איאיפשר לאמרו שנ למתנכם שלחתי בבלה אמרו בשעה שהגלה נבוכד נצר את ישראל לבבל צאו אומותהעולם וראו פניהם שחורות ודומות לשוליקדרה והיו תמהים עליהם ואומרים וכי זו היא אומה שכתוב בה ויצא לך שם בגוים ביפיך אמרו להם ישראל מפנימה אתם רואים פנינו שחורת ודומות לשולי קדרה ששאפתני השמש שנאמ אל תראוני שאני"@he ;
    oa:hasSelector opp:unit_fol_191v_1_u1_selector ;
    oa:hasSource opp:passage_fol_191v_1 .

opp:unit_fol_191v_1_u1_selector a opp:TokenPositionSelector ;
