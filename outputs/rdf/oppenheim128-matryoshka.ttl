        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר ינאי אין בן דוד בא אלא בדור שפניו דומות לכלב אמ ר לוי אם ראית דור מחקף צפה לרגליו שלמשיח ומאי טעמיה אשר חרפו אויביך יי אשר חרפו עקבות משיחך מה כת בתריה ברוך יי רעולם אמן ואמן ר יוחנן פתא ואכרה לי בחמשה עשר כסף וחמר שעורים ולתך שעורים אמ ר יוחנן ואכרה לי בחמשה עשרכסף הרי הם טו בניסן וחמר שעורים הרי שלשים ולתך שעורים הרי ששים אלו ס מצות שכתב לנו משה בתורה אמ ר יוחנן בשם ר שמעון בן יוחאי ג פרשיות כתב לנו ב משה בתורה וכל אחת ואחת ישבה ס מצות ואלו הן פרשת פסח ופרשת נזיקין ופרשת קדשים ר לוי בשם ר שילא אמ דכפר תמרתא אמ משבעים שבעים ולא פליגי מאן דעבד פרשת פסחים ע כלל עמה פרשת תפלין מאן דעבד פרשת נזיקין ע עבד עמה פרשת שמטה מאן דעבד פישת קדושים ע ברל עמה פרשת עכלה דא ואכרה לי בחמשה עשר כסף אלו טו בניסן אימתי בחדש הזה שנ החדש הזה לכם ראש חדשים דא החדש הזה לכם ר ברכיה בשם ר יודן בר שמעון אומ אמ הקבה לישראל בני חדוש גאולה יש לבם כאן לעתיד לבא"@he ;
    oa:hasSelector opp:unit_fol_112v_1_u1_selector ;
    oa:hasSource opp:passage_fol_112v_1 .

opp:unit_fol_112v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_112v_2#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לשעבר לא גלתי אומה מתוך אומה ועכשו אני גואל אומה מתוד אומה ההד או הנסה אלהים לבא לקחת לו גוימקרב גוי ר יהושע בר נחמיה אמ בשם ר חנן בן פזי גוי מקרב עם עם מקרב גוי וין כת כאן אלא גוי מקרב גוי שהיו אלו ערלים ואלו ערלים אלו מדלי בלורית ואלו מנלי בלורית ואם כן לא היתה מדמ מדת הדין נותנת שינאלו שראל ממצרים לעולם צחמ ר שמואל בר נחמן אלולי שאסר הקבה את עצמו בשבועה לא היו ישראל נגאלים ממצרםם לעורם ומאיטעמיה לכן אמור לבני ישראל י ואין לכם אלא לשו שבועה שנולכן נשבעתי לבי עלי אמ ר ברליה גאלת בזרוע עמך בטרוניא אמ ר יודן מלבא לקחת לו גיי עד מוראם גבדולים עב אותיות אם יאמר לך אדם עה הם אמור לו צא מהם גוי שני שאינו מן המנין אמ ר אבין בשמו גאלן ששמו שלהקבה עב אותאה אמ ר לוי משל למלך שנשבה בנו ולבשה נקמה למלך והלך ופדה את ביו אמ המלך היו מינים איכאטיא לפדיון בני כך אמ הקבה היו מונים איפאטיא ליציאת מצרים ר לויי בשם ר חמא בר"@he ;
    oa:hasSelector opp:unit_fol_112v_2_u1_selector ;
    oa:hasSource opp:passage_fol_112v_2 .

opp:unit_fol_113r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_113r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "וכיון שנשא אשה בת טובים בת גיניסים כתב לה גימקיאן וכתב לה איפאטיא כך מכל נשים שנשא אחשורוש לא כתב להן גימקיאן ולא איפאטיא וכיון שנשא אםתר שהיא בת טובים ובת גיניסים כתב לה איפאטיא וכתב לה ר גימקיאן שנאמ בחדש העשירי הוא חדש טבת וכתב לה איפאטיא שנא בשנת שבע למלכותו אמ ר ברכיה החדש החדש הזה לכם סימן הוא לכם ההד כירח יכון עולם כהדין זיהרא עלמא מדכר אם זכיתם הרי אתם מונים למלואתו ואם לאו הרי אתם מונים לכגמו אברהם יצחק ויעקב יהודה פרץ חצרון רם עמינדב נחשון שלמון בועז עובד ישי דוד שלמה ונאמ וישב שלמה על כסא יי למלך הא זיהרא נל מלייה הרי אתם מונים לפגמי רחבעם אביה אסא יהושפש יהורם אחד יואש אמציה עזיהו יותם אחז יחזקיהו מנשה אמון יאשיהו צדקיהו שנאמ ואת עיני צדקיהו עור הא זהרא על פגמיה החדש הזה לכם מסורהוא לכם אמר יהושע בקלוי משל למלך שהיה לו אורוגילון וכיון שעמד בנו מסרו לו"@he ;
    oa:hasSelector opp:unit_fol_113r_1_u1_selector ;
    oa:hasSource opp:passage_fol_113r_1 .

opp:unit_fol_114r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_114r_1#u1" ;
    opp:closestWitness opp:work_Bereishit_Rabbah,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "ואתם נשאל לבית דין שלמטה ו מאינונמיה כיז אלהינו בכל קראנו ואין קראנו אלא מיעדות כדא אלה מועדיניי מקראיקדש אמ ר כרוספדאי בשם ר יוחנן ל שעבר אלה מועדי יי מכאן ואילך אשר תקראו אותם במועדם אמ ר אילא אם קראתם מועדי יי ואם לאו אינן מועדי ההד החדש הזה לכם אתם מונים לו ואין אומות העוכם מונין לו אמ ר לוי בשם ר יוסי בר אלעאי דרך הארץ הוא שהגדול מונה לגדול והקטן מונה לקנק עשו שהוא גשול מונה לחמה שהואגדול יעקב שהוא קנן מונה ללבנה שהיא קטנה אמ רב נחמן והא סימן טוב מה הגדול שליט ביום ואינו שלניט בלימה כך עשו הרשנ שנינ בעולם הזה ואינו שליט לעולם הבא מה החאור הקטן שליט ביום ובלילה כן יעקב שליט ביום ובלילה בעולל הזה ובעולם הבא רב נחמן אמ כל זמן שאורו של גדול מתפרסם אורו שלקטן מתעלם כך כל זמן שאורו של עשו בעולם אין אורו של יעקב מתפרסם בשישקע או של עשו יתפרסם אורו של יעקב שנ כי הנה החשך יכסה ארץ וערפל לאמים תני ר שמעון בן יוחאי בג דברים נתקשה משה והראן לו הקבה"@he ;
    oa:hasSelector opp:unit_fol_114r_1_u1_selector ;
    oa:hasSource opp:passage_fol_114r_1 .

opp:unit_fol_116v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_116v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "איפשרכן דאית בעיר אביל בעיר אמ ר תנחומא גדולים מעשי להינו מה משונים הם מעשיו של הקבה ומהיכן היא שותה ר יהושע בן לוי ורבנן ר יהושע בן לוי אמ נל מה שהיה דן מכניס לו חדשים הוא עושה איתן גמיאה אזת מאי טעמיה הן יעשק נהר ולא יחפז הרבנן אמ בהמה את היא וכל מה שהירדן מכניס ליב חודש הוא עושה אותן גמיאה אזה ומאי טעמיה בטח כי יגיח ירדן אר פיהו וישבהן לכלון פה אמ ר הונא בשם ר יוסף יזנן לליך לה ומהינן מוא שותה תני ר שמעין כבן בן יוחאי ונהד יוצא מעדן ושמו יובל ומשם הואשותה דכתו ועל יובל ישלח שרשיו תני בשם ר מאיר ואולם שאל נא בהמות ותורך זה בהמית ועוף השמים ויגד לך זה זין שדי ויספרו לך דגי הים זה לויתן מי לא ידע בכל אלה כ יד יי עשתה זאת מלך אחד מסרתי לך ולא היית יכול לעמיד בו ואיזה זה זה שלמה בן דוד שנ ויהי לחם שלמה ליום אחד שלשים כר סלת וששים בר המק אמ רשמואל בד רב יצחק ואלו מיני מילאטימא היו אכל לסעודתו לא היתה בריה יכולה לעמד"@he ;
    oa:hasSelector opp:unit_fol_116v_1_u1_selector ;
    oa:hasSource opp:passage_fol_116v_1 .

opp:unit_fol_122r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_122r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ועד בכור השפחה ר הונא בר אחא בשם ר אליעזר בנו של ר יוסיהגלילי אומ אפי שפחות המכודנות ברחים היו אומ רציננו בשעבודנו וישראל בשעבו אמ ר יוסי ברפזי מסורת אגדה היא ששרה אמנו בשעה שירדה במצרים קדמוה כדנוה לריחים וכל בכור בהמה אם אדם חטא בהמה מה חנאת אלא לפי שהיו ב המצד משתחוים למזל טלה שלא יהו אומרים יראתנו הביאה עליהם את הפורענות קשה הא יראתנו שעמדה על עצמה קשה היא יראתנו שלא שלטה בה פורענות ר חוניא ור יהושעי בר אבין ור זכריה חתניה דר לוי בשם ר לוי אמ אין בעל הרחמים מם נוגע בנפשות תחלה ממי אתה למד מאיוב שנ ומלאך בא אל איוב ויאמר הבקר היו חורשות והאתונות רועות על ידיהן אמ ר חמא בר חנינא נעשו לו מעין דוגמת העולם הבא כרא ונגש חרש בקוצר אמ ר אבא בר כהנא יצאומן כפר קרינוס והלכו את כל האיבלון כלו וכיון שהגיעו למגדל ציבעניא מתושם אמ ר הוניא דק מיעוט הוא אף הוא משובר מולקה היה אמ ר יודן עד לבדי להגיד לך אף הוא כיון שהגידו לו בשורתו מד מתהוא ההד עוד זה מדבר מה אמ כשדים שמישלשה ראשים"@he ;
    oa:hasSelector opp:unit_fol_122r_1_u1_selector ;
    oa:hasSource opp:passage_fol_122r_1 .

opp:unit_fol_123r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_123r_1#u1" ;
    opp:closestWitness opp:work_Midrash_HaGadol ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר לוי בשם ר חמא בר חני אמ מי שפרע מן הראשונים יפרע מן האחרונים מה במצרים דם אף באדום כן שנ ונתתי מופתים בשמים ובארץ דם ואש מד מה במצרים צפרדעים אף באדום כן שלקול שאון מעיר קול מהיכל קול יי משלם גמול לאויביו מה במצרים כנים אף באדום כן שנונהפכו נחליה לזפת ועפרה לגפרית כדא והך את עפר הארץ מה במצרים ערוב אף באדום כן שנ וירשוה קאת וקפד וינשוף ועורב ישכנו בה מה במצרים דבר אף באדום כן שנ ונשפטתי אתו ברבר ובדם מה במצרים שחין אף בזדום כן שנ ואאת תהיה המכה אשר יניף יי את כל הגיים אשר צבאו על ירושלם המק בשרו מה במצרים ברד אף באדום כן שנ וגשם שוטף ואבני אלגביש אש וגפרית אמטיר עליו ועל אגפיו מה במצרים ארבה אף באדום כן שנאמ ואתה בן אדם כה אמר יי צבאות אמור לצפור כל כלף וכל חית השדה הקבצו ובאו האספו מסביב על זבחי אשר אני זובח לכם בשר גבורים תאכלו ודם נשיאיה ארץ תשתו אלים פרים ועתודים מריאי בשן כלם ואכלתם חלב לשבעה ושתיתם דם לשכרון מזבחי אשר זבחתי לכם ושבעתם על שולחני סוס ורכב בור וכל איש מלחמה נאם יי"@he ;
    oa:hasSelector opp:unit_fol_123r_1_u1_selector ;
    oa:hasSource opp:passage_fol_123r_1 .

opp:unit_fol_147v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_147v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Yalkut_Shimoni_on_Nach ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לשון אש זה בית יעקב שהוא משול באש שו והיה בית יעקב אשובית יוסף להבה וחשש להבה ירפה זה ביתו של יוסף דכת ובית יוסף להבה שרשם כמק יהיה לו האבות שהם שנ שרשם של ישראל ופרחם כאבק יענה אלו השבטים שהם פרחיהם של ישראל מפני מה יכי מאסו את תורת יי אמ ר יודן וכי מאסו את תודת יי זו תורה שבכתב ואת אמרת קדוש ישראל נאצו זו תורה שבעל פה איכה ישבה בדד ר יודה ור נחמיה ר יודה אמ אין לשון חה איכה אלא לשן תוכחת כדא איכה תאמרו חכמים אנחנו ר נחמיה אמ אין כשון זה איכה אלא לשון קינה כדא איכה ישבה בדד משל למטרונה שהיו לה שושבינין אחד רואה אותה בשלותה ו ואחדרואה אותה בפחזותה ואחדרואה אותה בנוולה כך משה ראה ישראל בשלותן ואמ איכה אשא לבדי ישעיה ראה אותה בפחזותה ואמ איכה היתה לזונה ירמיהו ראה אותה בניוולה ואמ איכה ישבה בדד קריה נאמנה קריה חדתא קריה מרבבתא ר פנחס בשם ר הושעיה ד מאות ופ בתי כלסיות היו בירושלם ובכל אחת ואחת יש בה סופר למקרא ובית"@he ;
    oa:hasSelector opp:unit_fol_147v_1_u1_selector ;
    oa:hasSource opp:passage_fol_147v_1 .

opp:unit_fol_147v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_147v_1#u2" ;
    opp:closestWitness opp:work_Midrash_HaGadol,
        opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "והיה בית יעקב אשובית יוסף להבה וחשש להבה ירפה זה ביתו של יוסף דכת ובית יוסף להבה שרשם כמק יהיה לו האבות שהם שנ שרשם של ישראל ופרחם כאבק יענה אלו השבטים שהם פרחיהם של ישראל מפני מה יכי מאסו את תורת יי אמ ר יודן וכי מאסו את תודת יי זו תורה שבכתב ואת אמרת קדוש ישראל נאצו זו תורה שבעל פה איכה ישבה בדד ר יודה ור נחמיה ר יודה אמ אין לשון חה איכה אלא לשן תוכחת כדא איכה תאמרו חכמים אנחנו ר נחמיה אמ אין כשון זה איכה אלא לשון קינה כדא איכה ישבה בדד משל למטרונה שהיו לה שושבינין אחד רואה אותה בשלותה ו ואחדרואה אותה בפחזותה ואחדרואה אותה בנוולה כך משה ראה ישראל בשלותן ואמ איכה אשא לבדי ישעיה ראה אותה בפחזותה ואמ איכה היתה לזונה ירמיהו ראה אותה בניוולה ואמ איכה ישבה בדד קריה נאמנה קריה חדתא קריה מרבבתא ר פנחס בשם ר הושעיה ד מאות ופ בתי כלסיות היו בירושלם ובכל אחת ואחת יש בה"@he ;
    oa:hasSelector opp:unit_fol_147v_1_u2_selector ;
    oa:hasSource opp:passage_fol_147v_1 .

