opp:unit_fol_161r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_161r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר יהושע בר נחמיה פתר קרא ביעקב אבינו שנ והיא עבר לפניהם מהו והוא עבר הואהוה בעקא אמ מוטב שיפגע בי ולא בבני מה עשה זיינם מבפנים והלבישם בגדים לבנים מבחוץ והתקין עצמו לג דברים לתכלה ולרורין למלקמהי לתכלה שנ הצילני נא מיד אחי מיד עשו ולדורון שנ ותעבר המנחה על פניו ולמלחמה שנאהו אם יבא עשואל המחנה האחת והכהו אמ מכאן ולהלן אנא עבד עימיה קרבא אמ ר שמואל בד ח נחמכר דרכו של אב לרחם ודרבה של אם לדחם רדכו שר אב לרחם שנ כרחם אב על בכפים ודרכה שלאם לנחם שנ כאיש אשך אמו תנחמנו אמ הקבה אנא אעביד דאב ודאם אנא עביד כאב שנ כרחם אב על בנים רחם"@he ;
    oa:hasSelector opp:unit_fol_161r_2_u1_selector ;
    oa:hasSource opp:passage_fol_161r_2 .

opp:unit_fol_161r_2_u1_selector a opp:TokenPositionSelector ;
