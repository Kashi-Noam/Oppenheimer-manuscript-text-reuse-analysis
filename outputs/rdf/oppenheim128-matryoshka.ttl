    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "גם את זה לעמת זה עשה האלהים עשה הקבה צדיקים ורשעים שנ ואחרי כן יצא אחיו וידו אוחזת גו יצא זה צדיק וזה רשע ר פנחס ור חלקיה בשם ר סימון אמרי מפני מה ברא הקבה צדיחים ורשעים כדי שיהו מכפרין אלו על אלו על שם גם את זה לעומת זה עשה האלהים דבר אחר ביום טובה היה בטוב אמ ר תנחום בר חייא ביום טובתו של חבירך היה עמו בטובה וביום רעתו ראה היאך לעשות עמו חסד כך היתה אמו של ר תנחום בר חייא עושה ביום שהיתה לוקחת ליטרא של בשר לוקחת שתים אחת לו ואחת לעניים מפני מה ברא הקבה עניים ועשירים כדי שיהו מתפרנסין אלו עם אלו על שם גם את זה לעומת זה עשה האלהים דבר אחר ביום טובה היה בטוב אמ ר אחא ביום טובתה של תורה היה עמה בטוב וביום רעה ראה לכשיגיע אותו יום שנאמ עליו פחדו בציון חטאים תהא מן הרואים ולא מן הנראים תהא מאותן שנאמר פליהן ויצאו וכאו בפגרי האנשים הפושעיםובי ולא מאותה שנאמר בהם תולעתם לא תמות גו מפני מה ברא הקבה נן ערן וגיהנם כדי שיהא מצלת זומזו וכמה ריוח"@he ;
    oa:hasSelector opp:unit_fol_25v_1_u1_selector ;
    oa:hasSource opp:passage_fol_25v_1 .

opp:unit_fol_36v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_36v_1#u1" ;
    opp:closestWitness opp:work_Shir_HaShirim_Rabbah ;
    opp:earliestWitness opp:work_Bereishit_Rabbah ;
    rdf:value "יוחנן איבאש עבד חשש עמרמורוי תלת שנין ופלגא סלקר יוחנן מבקרא יתיה אמ ליה מה אית לך אמ ליה ישעלי יותר ממשאוי אמ ליה לא תיהוי אמרכן אלא הוי אמר ברוך האל הנאמן כד הוה צערא קשה עלוי יתר מזצרכה הוה סליק ר חנינא ואמ עלוי מילה והוה נייח בתר יומין איבאש ר חנינא סלקר אנ יוחנין מבקדא יתיה אמ ליה מה אית לך אמ לו מה קשים הייסורין אמ לו ומה הוית אמר עלאי אמ ליה כד הוינא לברא הוינא הוינא עריב אוחרנין וכדון דאנא לגאו אנא בעי מאן דיערבני אמ לו אין שרביטו של הקבה ממשמש ובא אלא בבני אדם שליבן כך כשושן הוי הרועה בשושנים אמ ר אלעזר לבעל הבית שהי לו שתי פרות אחת כחה יפה ואחת כחה רע על אי זהמהם הואמטריח על זו שכחה יפה כך אין הקבה מנסה את הרשעים שאיזן ירונין לטמוד שנ והרשעים כים נגרש ואת מי הוא מנסה את הצדיקים שנ יי צדיק יבחן וכן הוא אומ והאלהים נסה את אברהם ויהי אחר הדברים האלה ותשא אשת אדני את עיניה על"@he ;
    oa:hasSelector opp:unit_fol_36v_1_u1_selector ;
    oa:hasSource opp:passage_fol_36v_1 .

opp:unit_fol_47r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_47r_1#u2" ;
    opp:closestWitness opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Midrash_Tanchuma ;
    rdf:value "כי לא נחש ביעקב אמ בלעם לבלק הרי אתה מחזר ומנחש ומקכם באי זה מקום תשלוט בהם והם אינם כן כשהם צריכים לה לחם בשונא עומד כהן גדול ולובש אורים ותומים ושואנ בהקבה כל הגוים מנחשים ומקסמים וישראל מבדין אותם בתשובה ומבטלין קסמיהם שנ מפר אותות בדים וקוסמים יהוללו כעת יאמר ל עקב ולישראל מה פעלל ראתה עינו של בלעם שישראל יושבים לפני הקבה לעתיד לבא כתלמיד היושב לפני רבו ושואלין אותו כל פרשה ופרשה למה נכתבה וכן הוא אומר ליושבים לפני יי יהיה סחרה ואומ לא יכנ עוד מוריך והיו עיניך רואות את מוריך ומלאכי השרת רואין אותם ושואלין לום מה הורה לכם הקבה לפי שאינן יכולין"@he ;
    oa:hasSelector opp:unit_fol_47r_1_u2_selector ;
    oa:hasSource opp:passage_fol_47r_1 .

opp:unit_fol_51r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_51r_2#u1" ;
    opp:closestWitness opp:work_Bamidbar_Rabbah,
        opp:work_Tractate_Gerim ;
    opp:earliestWitness opp:work_Tractate_Gerim ;
    rdf:value "נאמרה אהבה בישראל שנ אהבתי אתכם אמר יי ונאמרה אהבה בגרים שנ ואה בתם את הגר נקראו ישראל עבדים שנ כי לי בני ישראל עצים ונהראו הגרים עבדים שנ מהיות לו עברים נאמר דצון בישראל שנ והיה על מצחו תמיד לר צרן להם לפני יי ונאמ רצון בגרים שנ עולותיהם וזבחיהם לרצון על מזבחי נאמנה שמירה בישראל יי שומרך יי צלך על יד ימינך ונאמרה שמירה בגרים יי שומר את גרים נאמר שירות בישראל שנ כהני יי תקראו משרתי להינו ונאמר שירות בגרים שנא ובני הנכר הנלוים אל יי לשרתו חביבין הגרים שלא מל אבדהם אלא בן עשרים ולא בן שלשים אלא ב תשעים ותשע שנה שאלו מל בן עשרים ובן שלשים לא היה גר מתגייר מבן עשרים שנה ומבן שלשים שנה ומעלה אלא שהקבה היה ממשמש עמו ובא עד שהגיע לתשעים ותשע שנה שלא לנעול דלת בפני הגרים ולתת אריכות ימים לשבים ולהרבות שכר לעושי רצונו שנ יי חפץ"@he ;
    oa:hasSelector opp:unit_fol_51r_2_u1_selector ;
    oa:hasSource opp:passage_fol_51r_2 .

opp:unit_fol_69v_2_u1 a opp:TextUnit ;
    rdfs:label "fol_69v_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "לא דבר רע ולא גזל שכל איבריך יעירו בב ואל נתדמוד רגליך לדבר עביכה שמנא יהונת השניעי באידלחיש ר אשיה פתח קריא בחמשהם זקנים שהיו מעברין את השנה והקבה מסכים עמהם ומניח סנקליטין שלו ומצמצם שכינתו ביניהם למטה יומלאכי השרת אומרים אל נערץ בסוד קדושים רבה ונורא על כל סביביו ומניח סנקליטין שלו למעלה ויודד ומצרשם שכינתו ביניהם למטה כל כך למה שאם טעו בדבר הלכה הקבה מאיר פניהם בהלכה שנ יי באור פניך יהלכון אמ ר יאשיה כת אשרי העם יודעי תרועה ולי אומות העולם אינן יודעון להריע כמהה הרנות ישלהם כמה בוקיאנוס ישלהם כמה שלפיראים יש להם ואתה אומ אשרי העם יודעי תרועה אלא אשרי העם שהם יודעים לפתות את בוראם בתרועה אימתי בחדש השביעי באחד לחדש ר ברכיה בשם ר ירמיה פתא ארח חיים למילה למשכיל למנינן סורמשאמ מטה ארחחיים אין ארחחיים אלא דברי תורה דכת עץ חיים היא למסזיקים בה"@he ;
    oa:hasSelector opp:unit_fol_69v_2_u1_selector ;
    oa:hasSource opp:passage_fol_69v_2 .

opp:unit_fol_71v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_71v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "אמ ר יודן מלמד שהראה הקבה לאבינו חברהם האיל ניתש מחורש זה ונסבך בחרש אחר אמ לו הקבה אברהם כך עתידין בניך להיות נאחזים בעונות ונסבכים בצרות וסופם להגאל בקרניו שלאיל שנ ויי עליהם יראה ויצא כברק חצו ויי אלהים בשופר יתקע והלך בסערות תימן אמ ר חייא בר יצחק מלמד שהראה לו הקבה לאבינו אברהם את האיל נתש מחרש זה ונסבך בחרש אחר ניתש מחרש זה ונסבך בחרש אחר אמ לו הקבה אברהם כך עתידין בניך להיות נאחזים וסבכים באומות העולם ובמלכיות ונמשכים ממלכות למלכות מבבל למדי וממדי ליון ומיון לאדום וסופם להגאל בקרכיו של איל שנ וי עליהם יראה וכת יי צבאות יגן עליכם יי צבאות יגן עלינו כל השביעים חביבים למעלה הרקיע השביעי חביב שמים שמי השמים ורקיע שחקים וזבול ומעון ומכון ערבות מה כת שם סלו לרוכב בערבות ביה שמו בארצות השביעית ח חביבה ארץ אדמה נשיה ארקא גא פה תבל וכת והוא ישפט תבר בצדק בדורות השביעי חביב אדם שת אנוש קינן מהללאל ירד חנוך וכת ויתהלך חנוך את האלהים באבות השביעי חביב אברהם יצחק יעקב לוי קהת עמרם משה ונאמר ומשה עלה אל האלהים"@he ;
    oa:hasSelector opp:unit_fol_71v_1_u1_selector ;
    oa:hasSource opp:passage_fol_71v_1 .

opp:unit_fol_72v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_72v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna,
        opp:work_Yalkut_Shimoni_on_Torah ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "ובזמן שהא בא בשבת זכרון תרועה מזכירין אבל לא תוקעין ר ועירא הוה מפקיד לחבריה עלין ושמעין קליה דר לוי דדריש רלית איפשר דיפוק פרשיתיה דלאולפן עאל ודרש קדמיהון ואמ כת אחד אומ זכרון תרועה יהיה לכם מזכירין אבל לא תוקעין וכת יום תרועה יהיה לכם האכאי זה צד יתק יימו שני כתובין הללו בזמן שהוא בא בחול יום תרועה יהיה לכם ובמן שהוא באבשבת זכרון תחעה מזבכירין אכל לא תוקעין תאני ר שמעון בן יוחאי ידחה במקדש שבית דין יודעין זמנו טלחדש תאני ר שמעון בן יוחאי יום תרועה יהיה לכם ועשיתם במקום שהקרבנו קריבין אמ ר תחליפא קסריא בכל קרבנות כת והקרבתם וכאן כת ועשיתם אמ הקבה משום שנכנס שנכנסתם לפני ברין ביום הזה ויצאתם בדימיס מעלה אני עליכם כאלו היום נעשיתם והיום בראתי אתכם בריאה חדשה שנ כי כאשר השמים החדשים והארץ החדשה אשר אני עושה עומדים לפני נאם יי כן יעמד זרעכם ושמכם שובה שראל עד יילהיך כי כשלה בעונך אם יתקע שופר בעיר ועם לא יחרדו אם תהיה רעה בפיר ויי לא עשה משל למדינה שהיתה משובשת בגייסות והיה בה זקן אחד"@he ;
    oa:hasSelector opp:unit_fol_72v_1_u1_selector ;
    oa:hasSource opp:passage_fol_72v_1 .

opp:unit_fol_75r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_75r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כל זמן שהוא מתרים הואלוקה מודה הוא נונל פרקולא והקבה אינו כן אלא עד שלא ל הודה הוא נוטל פרקורא הודה הוא נוטל דימוס ההד מכסה פשעיו לא יצליח ומודה ועוזב ירוחם אמ ר יגדן מודה על מנת לעזוב לפיכך הושע מזהיר לישראל ואומ להם שובה ישראל עד יי אלהיך כי כשלת בעונך מחרי פיאיש ישבע טוב וגמול ידי אדם ישיב לו כת וישב ראובן אלהבור והנה אין יוסף בבור ויקרע את בגדיו ר אליעזר ור יהושע ורבא ר אלעזר אומ בשקו ובתעניתו היה עיסק על אותו המעשה שאירעו ולא נפנה וכיון שנפנה משקו ומת ומתעניתו בא והציץ בבור והנה אין יוסף בבור ויקרע את בגדיוי ר יהושע אומ טרחותו של בית היה מושלכת עליו ולאנפנה וכיון שנפנה מטרחותו שלבית בא והציץ בבור והנה אין יוסף בבור ויקרע את בגדיו אמ לו הקבה אתה בקשת להחזיר בכורה של רחל החביב לאביך חייך שבן בנך בא ומחזיר את ישראל לאביהם שבשמים ואי זה זה זה הושע ההד דבר י אשר היה אל הושע בן בארי"@he ;
    oa:hasSelector opp:unit_fol_75r_1_u1_selector ;
    oa:hasSource opp:passage_fol_75r_1 .

opp:unit_fol_79r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_79r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "אמרו כך אמ שלמה שמק בחור בילדויתיך ויטיבך לבך בימי בחורותיך והלך בדרך לבך יומשה אמ נלא תתורו אחרי לבבכם ואחרי עיניכם ושלמה חמ והלך בדרכי לבך ובמראה עיניך וכי הותרה הרצועה לית דין וליתדיין כיון שאמ ודע כי על כ אלה יביאך האלהים למשפט אמרו יפיה אמ שלמה ר חייא בר אבא ור שמעון בר חלפתא ור חייא רבה משל לליסטים שברח מכני קוטטינר אמ לו המעט ברב וננ ניש תתייע בבריחה ודע כיעל כל אלה יביאך האלהים במשפט אמ ר יאשיה משל לאחד שונב את המכס וכיק דאתציד אמרו ליה אייתי מוכסא אמ להון סבו אמ ליה מה את סבר דאנן בעינא מינך האדינא אנן בעינא כל אלין מכסיא דהוית יליף גניב ההד כי על כל אלה יביאך האלהים במשפט אמ כ לוי משל לעוף שהוא נתון בכלוב ובא חבירו ועמד על גביו אמ לו אשריך שמצ שמזונותיך מצויים לך בכל עת אמ לו שוטה שבעונם במזוני אתה מסתכלט ואין אתה מסתכל במשצודה ההד ודעכי על כל אלה יביאך האלהים במשפט אמ ר תנחומא משל לבן בלמעל אחד שנכנס לחנות ואמ לבעל החנות הב לי חמר טב ופיתא נקיה וקופר של בשר שמן וכיון שאכל ושתה אמרו ליה"@he ;
    oa:hasSelector opp:unit_fol_79r_1_u1_selector ;
    oa:hasSource opp:passage_fol_79r_1 .

