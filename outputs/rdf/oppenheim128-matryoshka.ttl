opp:unit_fol_169r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_169r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לבוש הרביעי שלברש כדי להפרע ממלכות בבל לבן שמו שנ לבושיה כתלג חיור לבוש החמשי שלבש כדי נהפרע ממדי צדק שמו שנא וילבש צדקה כשרין לכוש הששי והשביעי שרבש כדי להפרע ממלכות ין נקם וקנאה שמם שנ ויעט כמעיל קנאה לבוש השמיני ורתש יעי שהואת עתיד ללסש כי להפרע ממלכות אדום אדום שמם שנ מדוע אדום ללבושם לבוש העשירי שעפיד ללביש כדילהפרע מגוג ומסג חמרץ בגדים מבצרה אמרו ישראל לפני הקבה רבונו שלעולם מכל לבושים שלבשת איזלך נאה אלא זה שנאמ זה הדור בלבושו כי כארץ תוציא צמחה וכגנה זרועיה תצמיק אמר פיי מהגת הגנה הזאת מההרת ועושה פיכות קודם שדה הבעל כך הם מיתי ארץ ישראל חיים קודם למיתי חוצה לארץ אית דאמרין מיומין ואית דאמרין משנין מה טעם נותן נשמה לעם פליה גלן אד גר אלהים יצמיח צדקה ותהיה טגד כל הגוים ר פנחס ור חלקיה בשם ר סימח אמרי כאיניש דאמ ליה לחבריה קודשא בריך הוא יצמח לך צדקה בדינך וכאו גוים צדקם ר לוי אמ צדק בדינך וכל מלכים כבודך אמ רלוי לפי שבדגולם הזה כל מי שהוא מפרש שמו של הקבה חייב מיתה מאי טעמיה ונקב שם יי מות יומת"@he ;
    oa:hasSelector opp:unit_fol_169r_1_u1_selector ;
    oa:hasSource opp:passage_fol_169r_1 .

