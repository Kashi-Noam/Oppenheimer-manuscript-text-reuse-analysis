opp:unit_Upper_cover_1_u1 a opp:TextUnit ;
    rdfs:label "Upper_cover_1#u1" ;
    opp:earliestWitness opp:work_Mishnat_Rabbi_Eliezer ;
    rdf:value "שלשים ושתים מדות בעה בראשית אל תיקרי בראשית אלא בראשית אלו שש אותיות שבהן נברא העולם שנ כי ביה יי צור ענכמים שתים וארבע הרי שש האלמדת שבאלו שש אותיתת נבראו שמים וארץ ושמא תאמר שמים וארשץ בלבד נבדאו באלו שש אותיות והלא צו עולמים כתוב יצור עולם לא נאמר אלא צור עולמים אלא מכאן אתה למד שבזט שש אותיות ברא הקבה שמים ואץ והעגולם הזה והעולם הבא דבר סזר בראשית אמ רנ שזר בנו שלד יוסי הגנילי בשלשים ושתים מדות האגדה נדרשת מרבוי וממיעו ומרבוי אחר רבוי וממיעוט אחר מיעוט מקל וחומר מפורש מקל וחומר סתום מגזרה שוה ומבלין אב מדרך קצרה מדבר שהוא שנוי מסדור שנחנק מור שהוא בא ללמד ונמצא למד מכלל שאחריו ימעשה והוא פרטו שלראשוז מדבר שהוא נתכה בקטן ממנו להשמיע את האוזן בדדך שהיא שומעת משני כתובין המכחישין זה את זה עד שיביא הכת רשלישי ויכריע ביניהם"@he ;
    oa:hasSelector opp:unit_Upper_cover_1_u1_selector ;
    oa:hasSource opp:passage_Upper_cover_1 .

opp:unit_fol_100r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_100r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אין אתי בר עממיא לגבך רימר דאנא בעי למגזר ולית עביך יהודאי על מנת למגאריניה בשבתא או ביום צימא דכפוריא אין מחללין עליו את השבת ולא יום הכפורים אלא על בנה שלישראל בלבד אמ ליה מנן אמ ליה מן הדא דכתוב ועתה ברית לאלהינו להוציא כל נשים והנולד מהן בעצת יי והחרדים במצות אלהינו אמ ליה ומן קבלה אתה מלקני אמ ליה כת תמן וכתורה יעשה אמ ליה מאי זותורה אמ ליה מן ההיא דאמ ר יוחנן משום ר שמעון בן יוחאי שנ לא תתחתן בם וגו כי יסיר את בנך מאחרי בנה מן הישראלית קרוי בנך ואין בנך מן הגויה קרוי בנך אמ ליה חבוט חביטיך דהיא לובא בקולטא אמ שלמה על כל אלה עמדתי ופרשה זו שלפרה אדמה כשה ייתי מגיע בה חוקר ודורש בה אמרתי אחכמה והא רחוקה ממני מה כהחכם ומי יודעפשר דבר מי כהחכם זה הבה דכת ביה יי בחכמה יסד ארץ ומי יודע פשר דבר שפירש התורה למשה חכמת אדם תאיר פניו"@he ;
    oa:hasSelector opp:unit_fol_100r_1_u1_selector ;
    oa:hasSource opp:passage_fol_100r_1 .

opp:unit_fol_109v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_109v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה טעמיה ואתה קדוש יושב תהלוית ישראל או לעפר האיכים אמ ר יוסי בר חנינא לעוו אלהין דאיילתא הנה זה עומד אחר כתלינו בבתי כנסיות ובבתי מדרשות משגיח מץ החלונות יבין כתפותיהם של כהנים מציץ מן החרכים מבין אצבעותיהם של כהנים ענה בודי ואמר לי מה אמ לי יבדכך יי וישמדך דא דומה דודי לצבי אמר יצחק מה הצבי הזה נגלה ואוזר ונכסה כן משיח ראשון נגלה להם וחוזר ונכסה מהם כמה נכסה מהם ר יהודה בריבי אמ ג חדשים ההד ויפגעו את משה ואת אהרץ נצבים לקראתם או לעופר האילים ר יוסי בר חנינא אמ לעוז אלהין דאיילתא הנה זה עומד אחר כתלנו אחר כותל מערבי שלבית המקדש שנשבע הקבה שלא יהיה חרב לעים משניח מן הילינות בזכות זכוה י מצן מש מן החרבים בזכות אמהות י ללמדך שכשם שיש הכרש בין חלון לחלון כך ישהפרש בין זכות אבות לזכות אמהות אמ ר ברכיה בשם ר לוי כגואל הראשון כך גואל האחרון מה גואל הראשון נגלה להם וחזר ונכסה מהם כך גואל נגלה להם וחזר ונכסה מהם כמה יהיה נכסה מהם אמ ר תנחומא בשם ר חייא בר הושעיא ור מנחמא בשם ר חמא בר חנינא מה יום ההד ומעת הוסר התמיד ולתת שקוץ שומם ימים אלף מאתים ותשעים"@he ;
    oa:hasSelector opp:unit_fol_109v_1_u1_selector ;
    oa:hasSource opp:passage_fol_109v_1 .

opp:unit_fol_109v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_109v_1#u2" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מה טעמיה ואתה קדוש יושב תהלוית ישראל או לעפר האיכים אמ ר יוסי בר חנינא לעוו אלהין דאיילתא הנה זה עומד אחר כתלינו בבתי כנסיות ובבתי מדרשות משגיח מץ החלונות יבין כתפותיהם של כהנים מציץ מן החרכים מבין אצבעותיהם של כהנים ענה בודי ואמר לי מה אמ לי יבדכך יי וישמדך דא דומה דודי לצבי אמר יצחק מה הצבי הזה נגלה ואוזר ונכסה כן משיח ראשון נגלה להם וחוזר ונכסה מהם כמה נכסה מהם ר יהודה בריבי אמ ג חדשים ההד ויפגעו את משה ואת אהרץ נצבים לקראתם או לעופר האילים ר יוסי בר חנינא אמ לעוז אלהין דאיילתא הנה זה עומד אחר כתלנו אחר כותל מערבי שלבית המקדש שנשבע הקבה שלא יהיה חרב לעים משניח מן הילינות בזכות זכוה י מצן מש מן החרבים בזכות אמהות י ללמדך שכשם שיש הכרש בין חלון לחלון כך ישהפרש בין זכות אבות לזכות אמהות אמ ר ברכיה בשם ר לוי כגואל הראשון כך גואל האחרון מה גואל הראשון נגלה להם וחזר ונכסה מהם כך גואל נגלה להם וחזר ונכסה מהם כמה יהיה נכסה מהם אמ ר תנחומא בשם ר חייא בר הושעיא ור מנחמא בשם ר חמא בר חנינא"@he ;
    oa:hasSelector opp:unit_fol_109v_1_u2_selector ;
    oa:hasSource opp:passage_fol_109v_1 .

opp:unit_fol_110v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_110v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "הגשם חלף הלך לו אלו מאתים ועשר דא כי הנה הםתו עבר אלו מאתים ועשר הגשם חלף הלך לו אלו ימי השעבוד לא הוא הגשם ולא הוא הסתו אמ ר תנחומא עקר טרחוק טרחותא מטרא עקר שעברדן של ישרל לא היה אלא פו שנה משעה שנולדה מרים ולמה נקראת שמה מרים אמ ר יצחקך לשון מירור הוא כדא וימררו את חייהם בעבדה קשה ה גשנים נראו בארץ זה משה ואהרן פת הזמיר הגיע זמנה של זי וז ערלה שת מר הגיע זמנן של מצרים שיזמרו הגיע זמנה של עא שלהם שתעקר מן העולם שנ ובכל אלהי מצרים אעשה שפטים אני י הגיע זמנה שלים להבקע שנ ויבקעוהמים הגיעזמנה של שירה שתאמר שנ אז ישיר משה ובני ישראל הגיע זמנה של תורה שתנתן שנ עזי וזמרתיה ויהי לי ליסועה אמ רביבי זמירות היו לי חקיך אמ ר תנחומא הגיעזמן שיעשו שראל זמירות להקבה שנ עזי וזמרת יה וקול התור נשמע בארצנו אמ ר תכחומא קול תייר טב נשמע בארצנו זה משה שנ ויאמר משה כה אמר יי"@he ;
    oa:hasSelector opp:unit_fol_110v_1_u1_selector ;
    oa:hasSource opp:passage_fol_110v_1 .

opp:unit_fol_110v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_110v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "כי הנה הםתו עבר אלו מאתים ועשר הגשם חלף הלך לו אלו ימי השעבוד לא הוא הגשם ולא הוא הסתו אמ ר תנחומא עקר טרחוק טרחותא מטרא עקר שעברדן של ישרל לא היה אלא פו שנה משעה שנולדה מרים ולמה נקראת שמה מרים אמ ר יצחקך לשון מירור הוא כדא וימררו את חייהם בעבדה קשה ה גשנים נראו בארץ זה משה ואהרן פת הזמיר הגיע זמנה של זי וז ערלה שת מר הגיע זמנן של מצרים שיזמרו הגיע זמנה של עא שלהם שתעקר מן העולם שנ ובכל אלהי מצרים אעשה שפטים אני י הגיע זמנה שלים להבקע שנ ויבקעוהמים הגיעזמנה של שירה שתאמר שנ אז ישיר משה ובני ישראל הגיע זמנה של תורה שתנתן שנ עזי וזמרתיה ויהי לי ליסועה אמ רביבי זמירות היו לי חקיך אמ ר תנחומא הגיעזמן שיעשו שראל זמירות להקבה שנ עזי וזמרת יה וקול התור נשמע בארצנו אמ ר תכחומא קול תייר טב נשמע בארצנו זה משה שנ ויאמר משה כה אמר יי כחצות הלילה התאוה חנטה פגיה אלו גימי אפלה שבם כלו רשעי ישראל"@he ;
    oa:hasSelector opp:unit_fol_110v_1_u2_selector ;
    oa:hasSource opp:passage_fol_110v_1 .

opp:unit_fol_112r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_112r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "שביעית בןדוד בא בו אמ אביי כמאן שבועין אתון כהדא ולא אתתן אתיא אלא כי האי דאמ ר יוחנן דור שבן דודבא בו תלמידי חכמים מתים והנשארים עיניהם כלות ביגון ובאנחה וצרות רבות ורעות על הצבור וגזרות קשות מתחדשות עד שהראשונה קיימת באה האחי ואסמכה ליה אמ ר אבין דור שבן דוד בא בו בית ועד יהיה לזנות והגליל יחרב ואנשי הגליל יסובבו מעיר לעד ולא יתחוננו אנשיאמת וחסד נאספים והאמת נעדרת והולכת לה והיכן היא הולכת לה דביר ינאי אמרי הונלכת ויושבי עדרים עדרים במדבר כדא ותהי האמת נעדרת וסר מרע משתולל אמ ר נהוראי דוד שבן דוד בא בו נערים ילבינו זקנים וזקנים יעמדו מפני נערים בת קמה באמה כלה בחמותה אויבי איש אנשיביתי בן לא ייבוש מאביו חכמת סופרים תסרח והגפן תתן פריה והין ביוקר אמ ר חבא בר נהנא רור שבן דוד"@he ;
    oa:hasSelector opp:unit_fol_112r_1_u2_selector ;
    oa:hasSource opp:passage_fol_112r_1 .

opp:unit_fol_113v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_113v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "יוסי בר חנינא משל למלך שהיה לו עומירה וכיון שעמד בנו מסר לו שומירה אמ ר אחא משל למלך שהיו לו אוצרות הרבה והיה מפתח לכל אחד וכיון שעמר בנו מסר לו את המפתחות אמ ר חיא בר אבא משל לנגר שהיה לו כלי אומנות וכיון שעמד בנו מסרלו כלי אומנותו ורבנן אמ משל לרוכא שהיה לו נרתק שלרפואות וכיון שעמד בנו מסרלו נה נרתיקו תני ר הושעיא גזרו בית דין למטה ואמרו היום ראש השנה הקבה אומר למלאכי השרת העמידו סניגורין ויעמדו סקיפטורין שגזרו בית דין למטן ואמרו היום ראש השנה נשתהו העדים מלבא או שנמלכו בית דין לעבר את השנה למחר הקבה אומר למלאכי השרת העבידו בימא ויעבירו סניגורים ויעברו סקיפטורין שגזרו בית דין למטה ואמרו שמחר יהיה ראש השנה ומאי טעמיה כי חק לישראל הוא אם חק לישראל הוא משפט לאלהי יעקב ואם אינו חק לישראל כביכול אינו משפט לאלהי יעקב אמ ר יעקב ור פנחס ורחלקיה בשם ר סימון כל מלאכי הש הולכים רפני הקבה ואומרים לפניו רבון העו למים אימתי יהיה ראש השנה והוא אומר להם"@he ;
    oa:hasSelector opp:unit_fol_113v_1_u1_selector ;
    oa:hasSource opp:passage_fol_113v_1 .

opp:unit_fol_114r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_114r_2#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "במנורה ובשרצים ובלבנה במנורה מנין שנ וזה מעשה המנורה בשרצים מנין שנ וזה לכם הטמא בלבנה מנין שנ החדש הזה לכם ראש חדשים אמ ר שמלאי ותני לה בשם ר שמלאי כל החדש שלא נולד קודם לשש שעות אין בה מניו לדאותי מבערב אמ ר שמאלבר יכא ור אחא בשם ד שמואל ברנחמן שנה שיצאו ישראל ממצרים היו חדשישנה וחדשי תקופה שוים אמ ר ברכיה ור ירמיה בשם ר יוחנן נתעטף הקבה בטלית מצויצת ונ והעמיד למשה מכאן ואהרן מכאן וקרא למיכאל ונבריאל ועשה אותם כשלוחי בית דין לקדוש החדש אמ להם כאיזה צד ראיתם את הלבנה לפניהחמה או לאחרהחמה לבפונה אולדרומה כמה הה גבוה ולאין היה נוטה וכמה היה רחבה אמ להם כסדר הזה שאתם רואים כך יהיו בני מעברין את השנה למטן על ידי בית דין ועל ידי עדים ועל ידי טלית מצויצת רב נהמן ור אלמזר בר יוסי ור אחא חד אמ אמ הקבה לישראל בני חדוש גאלה ישלכם כאן לעתיד לבא וחד אמ חדוש לעתיד לבא ישלכם כאן מה כתי לעתיד לבא אז תפקחנה עיני עורים ואף הכא וכל העם רואים את הקולות"@he ;
    oa:hasSelector opp:unit_fol_114r_2_u1_selector ;
    oa:hasSource opp:passage_fol_114r_2 .

opp:unit_fol_118v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_118v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "מנחה טהורה בבבל אלא אמ הקבה הואל ואתם מתעסקין בה כאלו אתם מקרבין אותה לפני ואם נרלמו מכל אשר עשו צורת הבית ותכונתו ומוצאיו ומובאיו וכל צורותיו וכי יש צורת הבית עכשו אלא אמ הקבה הואיל ואתד עוסקים בבניינו כאלו אתם בונים אותו אמ ר יוסי מפני מה מתחילין לתינוקות מתות כהנים אם כן יתחילו להם מבראשית אלא אמ הקבה מה הקרבנות טהורון אוא התינוקות ני הורין יבאו טהורום ויתעסח בטהורים א אמ ר אבא בר כהנא ור חנין תרויהון בשםר עזריה דכפר חטייא משל למלך שהיו לו שני מגורשים מגירסים בשל לו הראשון תבשיד ואכלו והיה ערבלו וכן השני בשלרו תבשיל ואכלו והיה ערב לו ואין אנו יודעין אי זה מהן עדב לו ביותר כן הקריב נחקרבן והיה ערב להקבה ואין אנו יידעין איזה מהן ערב לו ביותר אלא כשהוא מציה את ישראל ואומ להם ריח ניחוא תשמרו להקריב לי במועדו לכך אנו יודעין שקרבנן של ישראל ערב לו ביותר ר אבין אמ תירתי א ר אבין אמ משל למלך שהיה מיסב על אוקבטון שלו והכניסו לו תבשיל"@he ;
    oa:hasSelector opp:unit_fol_118v_1_u1_selector ;
    oa:hasSource opp:passage_fol_118v_1 .

opp:unit_fol_119v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_119v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ויהי בחציהלילה אמר תנחום דיפו בשם ר נוני דקסרי ואחשבה לדעת זאת עמל היא ברויני אמ משה לפני הקבה דבון העו אין בריה יכולה לעמד על חצי הלילה אלא ההבה אבל אני עמל היא בעיני לפי שאין בריה בעולם יכולה לעמוד על חצי הלילה אלא הוא לפיכך אמ ויהי בחצי הלילה ר אחא פתח אני יי הוא שמי וכבודי לאחר לא אתץ אמ ר אחא אמ הקבה אני הוא שמי הוא שמי שקדא לי אדם הראשון הוא שמי שהתניתי בעולמי הוא שמי שהתניתי ביני לבין עצמי הוא שמי שהתניתי ביני לבין מלאכי השרת וכבודי לאחר לא אתן ר מנחמא אמ בשם ר אבין אלו השרים רב נחמן אמ בשם ר מני אין בריה בעולם יכולה לעמוד על חצי הכילה אלא הוא לכךנא ויהי בחצי הלילה"@he ;
    oa:hasSelector opp:unit_fol_119v_1_u1_selector ;
    oa:hasSource opp:passage_fol_119v_1 .

opp:unit_fol_120r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_120r_1#u2" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ואמר לי אלהים שמך יעקב לא יקרא שמך עוד יעקב כי אם ישראל יהיה שמך ירושלם שכל הנביאים מהנבאר עליהם שהיא נבנית על אחת כמה וכמה דא מקים דבר עבדו זה משה שנ לא כן עבדי משה וישלך מלאך ויוביאנו ממצרים אמ הקבה למשה לך אמוד לישראלל ועברתי בארץ מצרים בלילה הזה הלך משה ואמ להם כה אמר יי לחצית הלילה אני יוצא בתוך מצרים אמ הקבה והלא כבר הבטחתי את משה ואמ לא כן עבדי משה הוא משה עבדי נראה כמכזב אלא מה אמ משה כחבות הלילה אף אני ויהי בחצי הלילה לפיכך אמ ויהי בחצי הלילה חצות לילה אקום להודות לך ר פנחס בשם אלעזר בן פנחס אמ מה היה דגד עושה היה נוטל גבל וכנור ונותלן תחת מראשותיו ועומד בחבי הלילה ומנגן בהם והיו חבירי ישראל שומעין את קולו ואומ מה אם דוד המלך הוא עסוק בתורה אט על אחת כמה וכמה נמצאו כל ישראל עסוקים בתורה אמ ר לוי חלון היתה על גבי מטתו שלדוד פתוחה לצפון והיה הכנמר תלי כנגדה והיתה רוח צפונית יוצאת בחצי הלילה ומנשבה בו והיה הכנור מנגן מאליו ההד עורה כבודי עורה הנבל וכנור אעירה שחר"@he ;
    oa:hasSelector opp:unit_fol_120r_1_u2_selector ;
    oa:hasSource opp:passage_fol_120r_1 .

opp:unit_fol_120v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_120v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר שמעון בן יוחאי משה שאינו יודע לאר עתותים ולא רגעים ולא זמנים של לילה לפיכך הוא אומ כחצות הלילה אני יוצא בתוך מצרים אבל הקבה הוא יודע עתיו ורגעיו וזמניו של לילה לפיכך הואנלנס כפי חוט השערה ומחלקו ר בנימן בריפת בשם ר יוחנא ומ הלי לה נהלק מחלא ורבנן אמרי יוצרו רלקו רנא את את אמ ויה בחדי הלילהי ולהלן את אמ ויחצר עמיהם בילה אמ ר תנחומא אמ הקבה אביכם יצא עמי בהצות הלילה ואני יוצא כמו כן לבניו בחצות הלילה ורבנן אמ אמ הקבה אביכם יצא עמי מאמש ועד הבקר ואני יוצא עם בניו מחצית ועד בקר אמר יוחנן אין שרה של מצרים נופל אלא ביום ומאי טעמיה ובתחפנחם עשה היום חשך היום ביום ההוא יהיו חמש ערים בארץ מצרים מדברות שפת כנעץ אליהן חמש ערים אמ ר חלקיה בשם ר סימון נא ונוף ות ותחפנחס ועיר ההרס ועיר שמש נא אלכסנדריאה ונוף מנאפים ותחפנחם חפניים עיר ההרס סרקיני ועיר שמש אליופולים אמ רבן יוחנן בן זכאי מצינו שהיום והלילה קרואים יום מאי טעמיה ויהי בקר ערב ויהי בקר יום אחד"@he ;
    oa:hasSelector opp:unit_fol_120v_1_u1_selector ;
    oa:hasSource opp:passage_fol_120v_1 .

opp:unit_fol_122r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_122r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר שמואנ כרנחמן ניוו ששמע איוב כן התחל מגייס עליהם חיילותי למלחמה ההד כי אערוץ המון רבה ובוז משפחות יחיתני אמ איוב אומה בזויה אומה זו שבאומות שנהן ארץ כשדים זה העם לא היה ולואי לא היה סבור הייתי ליתן אימתן עבי וכיון שאמרו לי ואדום לאי לא אצא פתח ואחד כך ויקח לו חרט להתגרד בו אף מחלון וכליון כך כתחלה מתו סוסיהם וגמליהם וחמוריהם ואחר כך מת הוא שנ וימת אלימלך איש נעמי ואחר כך וימותו גם שניהם ואחר כך מתה אשתו אף כינגעים הבאים על אדם כך כתקלה הוא מתחיל בבתיו נאם חזר בו טעונים חליצה ישנ וחלצו את האבנים ואם לאחזר בו טעונין נתיצה שנ ונתץ את הבית ואחרכךד מתחיל בבגדיו חזר בו טעונין קריעה שנ וקרעו את הבגד ואם לאחזר בו טעדנין שריפה שנאמ ושקף את הבגד נאחר כך הוא מתחיל בגופו אם חזר בו יוצא ובא לו ואם לא חזר בו בדד ישב מחוץ למחנה מושבו ואף במצרים כן כתחלה נגעה מדת הדין בממונם שנ ויך גפנם ותאנתם וישבר עץ יבולם ויסגר לברד בעירם ומקניהם לרשפים ואחרכך ויך כל בכור במשצרים"@he ;
    oa:hasSelector opp:unit_fol_122r_2_u1_selector ;
    oa:hasSource opp:passage_fol_122r_2 .

opp:unit_fol_123v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_123v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Vayikra_Rabbah ;
    rdf:value "ישראל שקבלו את התורה שנהנה מתוך ההשך שנ ויהי כשמעכם את הקול מתוך החשך עליהם הוא אומ ועליך יזרח יי וכבודו עליך יראת מה יתרון לאדם בכל עמלו שיעמל תחת השמש אמ ר בנימין בר לוי בקשו חכמים לגנוז ספר קהלת לפי שמצאו בו דברים שהם נוטים לצד מינות וכן אמרו כך היה שלמה צריך לומר מה יתרון לאדם שיעמל תחת השמשיכול אף עמילה של תורה בכלל חזרו ואמרו אלו אמ בכל עמל ושתק היינו אומרים אף עמלה של תורה בכלל וכשהוא אומ בכל עמלו בכל עמלו אינו מועיל צל בעמלה שלתורה מיעיל אמ ר שמואל בר יצרן יצחק בקשו חכמים לגנוזספר קהלת שמצאו בו דברים שנוטים לבד המינות אמרו כך היה שלמה צריך לומר שמח בחור בילדותיך ומשה אמר ולא תתורו אחרי לבבכם ואחרי עיניכם ושלמה אמ והלך בדרכי לבך ובמראי עיניך וכי הותרה הרצועה לית דין ולית דיין וכיון שאמ ודעכיעל כל אלה יביאך האלהים במשפט אמ יפה אמ שלמה"@he ;
    oa:hasSelector opp:unit_fol_123v_1_u1_selector ;
    oa:hasSource opp:passage_fol_123v_1 .

opp:unit_fol_125v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_125v_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ואל מצנים יקחהו לא בזן ולא במגן ולא במלחמה אלא בהכלה ובתחנונים שנ ויאמר יי אל יהושע קום לך למה זה אתה רופל עליפניך ושאף צמים חילם מי דחק לממונן של לא מלך יהושע וכלב וכל המצומתים אצלם ובאיזה זכות זכו ישראל לירש את ארץ בנען הוי אימ בזכות מצית העמר לפיכך משה מזהיר אתישמ ואומ להם והבאתם את עמר ראשית קצירכם אל הכהן וכן הניף את העמר לפני יי לרבונכם וכאי זה בד היה מליפו ר חמא בר עוקבא אמ בשם ר יוסי בר חנינא מיליך ומביא מעלה ומוריד מוליך ומביא לבטל טללים רעים מעלה ומוריד כדי לעצור טללים רעים רסימא בשם ר יהושע בן לוי אמ מוליך ומביא למי שהרוחות שלו מעלה ומוריד למי שהעליונים והתחתו שלו ר אבין אמ ור יהודה ור כחמיה היא ר יעקב בר אביי בשם ר יהודה בר כמין ור יוחנן ור שמעון בן לקיש ר יוחנן אמ לעולם אל"@he ;
    oa:hasSelector opp:unit_fol_125v_1_u1_selector ;
    oa:hasSource opp:passage_fol_125v_1 .

opp:unit_fol_128v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_128v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "לא ידעתי את יי הוא עצמו היה מחזר על פתח היכליהם של ישראל ואומ להם צאו לשכום לבו לשלום לכך נאמר ויהיבשל חפרעה תקת גערה במבין מהכות כסיל מאה תני ר ישמעאל משל למלך שאמ לעבדו צא והביא לי דג מן השוק הלך והביא לו דג מבאיש אמלוחייך חדאמזתלת לא פלטא לך אוסירית אתה אוכל או מאה ברדילין אתה לוקק או ממון אתה נותן אמ אני אוכל סירית לא הספיה לאכול סירית עד שקניטה נפשו עליו אמ אני לוקה לא הספיק ללקות חמשים ברדילין עד שקניטה נכשו עליו אמ אנינותן ממון נמצא אוכל סירית ולוקה ומשלם ממון כך אמ הקבה לפרעה הרשע חייך עשר האטפראה אתה לוקה וממונך אתה נותן וישראל אתה משלח עשר קאטפראה אתה לוקה אלועשר מכות ממונך אתהנותן שנ וינצלו את מצרים"@he ;
    oa:hasSelector opp:unit_fol_128v_1_u1_selector ;
    oa:hasSource opp:passage_fol_128v_1 .

opp:unit_fol_129r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_129r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "נעול אחתי כלה גל נעול מעין חתום ר יהודה בר סימון אמ בשם ר יהושע בן ליי משל למלך שהיו לו בנות בוגרות ולא נפנה להשיאן הלך למדינת הים ועמדו הבנות ונתעסקו לעצמן ונשאו ראנשם והיתה כל אחת ואחת מהן נוטלת חותמו של בעלה וסמנאטירין שלו לאחר ימים בא המלך ממדינת הים ושמע קול הבריות מליזין על בנותיו ואו שזנו בנותיו של מלך מה עשה המלם הוציא כרוז ואמ כל עמא לקמפון קרא לחתנו הראשון אמ לו מי אתה אמ לו חתנך ורוביא חותמו ונתן לו אמ לו של מי הוא זה אמ לו שלי והוציא סמאגטבין שלו אמלו של מיהואזה אמ כו שלי הוא זה וכן לשלישי אמ המלך בנותי נתעסקו לעצמן ונשאו לאנשים ואתם אומשזנו בנותיו של מלך כך לפי שהיו אומות העולם מונין לישראל ואומ להם בניהם של מצריים בניכם שהיו שולטים המצריים בנשותיכם כל שכן בנשיכם אמ ר הושעיא קרא הקבה למלאך שהוא ממונה על ההריון ואמ לו לך וצייר ליצורת הולד בדמות אביו ההד לראובן משפי הראובני לשמעון משפחת השמעוני אמ ר מרינוס בר הושעיא כאינש דאמ ברוני"@he ;
    oa:hasSelector opp:unit_fol_129r_1_u1_selector ;
    oa:hasSource opp:passage_fol_129r_1 .

opp:unit_fol_130r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_130r_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ישראל למצרים וגדרו עאמן מן הערוה נגאלו תדע לך שהוא כן שנ שלחיך פרוס רמונים לכך נאמ ויהיבשלח פרעה את העם מי ציוח ווי מצריים צווחו ווי תני ר שמעון בן יוחאי משל לאחד שנפלה לו ירושה במדינת הים והיה היורש עצל ועמד ומכרה בדבר מועט והלך הלוקח וחפרה ומצא בה מטמח ובנה אתה פלטרין והיה מה לך בשוק מקא זוזי מן קדמי ומרא זוזי מן בתראי התחיל המוכר חונק את עצמו ואומ מה אבדתי כך כשהיו ישראל חונים על שפתהים היו דומים לטכסיס שלמלכים והיו המצריים חונקים עצמם ואומ זה לזה ראו מה שלחנו מארצנו אמר יוסי משל לא חד שנפלה לו שדה בית כור והיה יורש עצל ועמד ומכרה בדבר מועט והלך הליקח וחפרה ומצאבו מניין ועשה אותי גנותוכי רדסים התחיל המונד חונק עצמו ואומ ווי מה אבדתי כך כשהיו ישראל חונים על שפת הים דגלים דגלים דומים לטכסיס שלמלכים היו המצדיים חונקים עצמם ואומ ראו מה שלחנו מארצנו"@he ;
    oa:hasSelector opp:unit_fol_130r_1_u1_selector ;
    oa:hasSource opp:passage_fol_130r_1 .

opp:unit_fol_133r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_133r_1#u1" ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "תנינא ודרש ונראתה הקשת בענן אמ ר שמעון בן יוראי הוא סימניה דעלמא אמ ר חזקיה בשם ר ירמיה כל ימיו של ר שמעון בן יוחאי לא נראתה הקשת בענן ר חזקיה בשם ר ירמיה אמ כך היה ר שמעין בן יוראי אומ בקעה בקעה המלאי דינרי זהב והיא נתמלאת ר חזקיה אמ בשם ר ירמיה אליהו זל ור יהושע בן לוי הוו יתיבין פשטין מטון חדא שמיעה משמיה דר שמעון בן יוחאי עבר ר שמעון בן יוחאי אמרין הא אתא מריה דשמעתא ניקום ונישייליה קמון ושאלון ליה אמ ליה מאן הוא דין דעמך אמ ליה ר יהושע בן לוי הוא וגדול הדור הואי אמ לו אם נר ותה הקשת בימיו לית הוא כדאי סבר למחזי אפי אמ ר חזקיה בשם ר ירמיה כך היה ר שמעין בן יוחאי אומ נשבע הקבה לאברהם אבינו"@he ;
    oa:hasSelector opp:unit_fol_133r_1_u1_selector ;
    oa:hasSource opp:passage_fol_133r_1 .

opp:unit_fol_133r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_133r_2#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "אמ ר חזקה בשם ר ירמיה כך היה ר שמעון בן יוחאי אומ קרב אברקם מן גביה ועד גבאי ואנא מקריב מן גבאי ועד דייתי מלכא משיחא ואין לא יצרף עימיה אחיה השילוני ואנא מקרבין כל עמא עאל תליתאה ודרש ויאמר לה לכי מכרי את השמן ושלמי זהנשיך ית בניך תחיביוהי רינא ר שמעון בן יוחאי ור אלעזר עבדין טמירין תלת עשרה שנין בהדא מערתא דבקע אכלין חירובין דתרומן עד שהעלה גופן חלדות חלדות לסוף יג שנין נפקר שמע בן יוחאי ויתיב ליה פל תרע מערתא וחמא לחד בר נשפרים מצדתיה למצד עופין פרסה זמן קדמאי שמע ברת קלא דאמרת דימים ואשתזבת פרסה זמן תנין ושמע ברת קלא אמ סכק לה ואתפיסת אמ אפי צפר מבלעדי שמא לא יאבד ואנן יתבין הכא כד שמע דמליא בידיכון אמ ניחות ונתסי בהדין דמוקיד דטבריא נחתין ואתסון בהדין דמיקמי דטבריא אמרו צריכין אנו להחדיק טובה כדרך שאבותי היו עושים שהיו עישים אטולים ומיכרים בזול ועשו אטולים ומכרו בזול"@he ;
    oa:hasSelector opp:unit_fol_133r_2_u1_selector ;
    oa:hasSource opp:passage_fol_133r_2 .

