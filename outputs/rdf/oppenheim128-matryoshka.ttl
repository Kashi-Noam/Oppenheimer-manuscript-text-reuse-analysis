opp:unit_fol_112v_1_u2 a opp:TextUnit ;
    rdfs:label "fol_112v_1#u2" ;
    opp:closestWitness opp:work_Pesikta_Rabbati ;
    opp:earliestWitness opp:work_Pesikta_Rabbati ;
    rdf:value "אמ ר ינאי אין בן דוד בא אלא בדור שפניו דומות לכלב אמ ר לוי אם ראית דור מחקף צפה לרגליו שלמשיח ומאי טעמיה אשר חרפו אויביך יי אשר חרפו עקבות משיחך מה כת בתריה ברוך יי רעולם אמן ואמן ר יוחנן פתא ואכרה לי בחמשה עשר כסף וחמר שעורים ולתך שעורים אמ ר יוחנן ואכרה לי בחמשה עשרכסף הרי הם טו בניסן וחמר שעורים הרי שלשים ולתך שעורים הרי ששים אלו ס מצות שכתב לנו משה בתורה אמ ר יוחנן בשם ר"@he ;
    oa:hasSelector opp:unit_fol_112v_1_u2_selector ;
    oa:hasSource opp:passage_fol_112v_1 .

