opp:unit_fol_166v_1_u1 a opp:TextUnit ;
    rdfs:label "fol_166v_1#u1" ;
    opp:closestWitness opp:work_Pesikta_DRav_Kahanna ;
    opp:earliestWitness opp:work_Pesikta_DRav_Kahanna ;
    rdf:value "ר חייא בברייתו של עולם צפה הקבה בית המקדש בנוי וחרב ובנוי שנ בראשית ברא אלהים הריבנוי והארץ היתה תהו ובהו הרי חרב ויאמר אלהים יהי אור הרי בנוי ומשוכלל לעתיד לבא אמ ר שמואל בר נחמז לפי שבעולם הזה מהלכין לאור החמה ביום ולאור הלבנה בלילה ומה טעם לא יהיה לך עוד השמש לאור יומם ולנוגה הירח לא יאיר לך ונאור מי הים הולכים לאורו של הקבה שנ והיה לך יי ראור עולם ואלהיך לתפארתך אמ ר חנינא חלונות היו בביה המקדש ובהם היתה אורה יוצאה לעולם מה טעם ויעש לבית חלוני שקופים אטומים שקופות היו ואטומות שהיו קטנות מבפנים ורחבות מבחוץ כדי להוציא אורה לעולם אמ ר לוי בנוהג שבעולם אדם בונה טרקלין חלונותיו מקטינוה מבחוץ ומרחיבו מבפנים כדי להכפס אורה לתוכה אבל חלונות שר בית המקדש לא כך היו אלא מקטינות מבפנים ומרחיבו מבחוץ כדי שיצא מהן אורה לעולם אמר ברכיה"@he ;
    oa:hasSelector opp:unit_fol_166v_1_u1_selector ;
    oa:hasSource opp:passage_fol_166v_1 .

