opp:unit_fol_60r_1_u1 a opp:TextUnit ;
    rdfs:label "fol_60r_1#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "רימנו אמ להם רבותי המתיט לי עד שאפטר משכינה שהא גדולה מכם שנאמ ויאמר יי אם נא מצאתי חז בעיניך אל נא תעבור מעל עבדך וכיון שופטר אל ית אבינו מן השכינה בא והשתחוה להם והכניסם תאת האילן שנא יוקח נא מעט מים ואחרכך ואקחה פת לחם אבל לוט מה אמ להם לינו ורחצו ל רגרירם אחרים אומ לא אמ להם לוט אלא חכמה אמ אלו הויו רואין אותם אנשיסדום רוחצין ידיהם ורגליהם נמצאו הורגין אותי ואת אשתי ואת בנותי אלא יראו אותם באבק שעל רגליהם ויאמרו לא באו מן הדרך אלא עכשו"@he ;
    oa:hasSelector opp:unit_fol_60r_1_u1_selector ;
    oa:hasSource opp:passage_fol_60r_1 .

opp:unit_fol_60r_1_u1_selector a opp:TokenPositionSelector ;
    oa:end "93"^^xsd:nonNegativeInteger ;
    oa:start "0"^^xsd:nonNegativeInteger .

opp:unit_fol_60r_1_u2 a opp:TextUnit ;
    rdfs:label "fol_60r_1#u2" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "ההולך אחרי רבו אינו רשאי ליפטר מאחריו עד שיטול ממנו רשות היו שניהם תלמידים שקולים זה כזה בעל הבית נכנס תחלה ואחרכך אורח וכשהן יוצאין אורח יוצא תחלה ובעל הבית יוצא אחריו והנמ והנפטר מרבו בין שהוא גדול מרבו ובין שרבו גדול ממנו אומר לו הריני נפטר ברשותך סליק פרץא לעולם לא יפטר אדם מאצל חבכו אלא אם כן נוטל הימנו רשות וילמד כל אדם דרך ארץ מן המקום שאמ לו לאברהם כלום אברהם אנם צריך לך אמ לפניו רבונו שלעולם הן"@he ;
    oa:hasSelector opp:unit_fol_60r_1_u2_selector ;
    oa:hasSource opp:passage_fol_60r_1 .

opp:unit_fol_60r_1_u2_selector a opp:TokenPositionSelector ;
    oa:end "175"^^xsd:nonNegativeInteger ;
    oa:start "93"^^xsd:nonNegativeInteger .

opp:unit_fol_60r_2_u1 a opp:TextUnit ;
    rdfs:label "fol_60r_2#u1" ;
    opp:closestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    opp:earliestWitness opp:work_Tractate_Derekh_Eretz_Rabbah ;
    rdf:value "לעולם אל ירנם אדם פתאום לבית חברו וילמד כל אדם דרך ארץ מן המקום שעמד על פתח הגן וקרא לו לאדם שנאמי ויקרא וי אלהים אל האדם ויאמר לו איכה מעשה בארבעה זקנים שהלכו למלכות הפנימית והיה להם פילוספוס אחד חבר שם והם רג ור יהושע ור אלעזר בן עזריה ור עקיבא אמ לו ר יהושע לרגו ד רצונך ונקביל פני פוליספיס חבירנו אמ לו לאו לשחרית אמ לו ר יצונך ונקביל פני פוליספום חבירט אמ לו הן הלך ר יהושע ושפח על הדלת והיה פליכמת ההוא מאשב ברעתי ואומר אין זודרך ארץ אלא שלחנם פעם שניה עמד ורחץ פניו ידיו ודגליו פעם שלישית עמד ופתח את הדלת וראה חתמי ישראל אלו באין מכאה ואלו באין מכאן ואלוהן רג ור יהושע ור אלעזר בן עזריה מימינו ור עקיבא משמאלו והיה פילוספוס מחשב בדעתו ומר היאך אתן שלים לחכמיישהל אם אומר אני שלום עליך רג נמצאתי מבזה חכמי ישראל אם אומר אני שרום עליכם חכמי ישראל נמצאתי מבזה את רג כיון שהגיע אצלם אמ להם שלום עליכם חכמי ישראל ולרבן גמליאל בראש"@he ;
    oa:hasSelector opp:unit_fol_60r_2_u1_selector ;
    oa:hasSource opp:passage_fol_60r_2 .

opp:unit_fol_60r_2_u1_selector a opp:TokenPositionSelector ;
