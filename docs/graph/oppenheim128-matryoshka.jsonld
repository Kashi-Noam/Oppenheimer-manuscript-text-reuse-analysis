 {
  "@id": "http://example.org/oppenheim128#unit_fol_148r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ויגל את מסך יהודה מלאתי משפט כגון משנתו של ר חייא ומשנתו של ר הושפיא ומשנתו של ברמפראו צדק ילין בה אמ ר יהודה בר סימון מימיו לא לן אדם בירושכם ובידו עון האכאי זה צד תמיד של שחר היה מכפר על עבירות שנעשו ביום מכל מקום לא לן אדם בירושלם ובידו עח מאי טעמיה צדק ילין בה ועתה מרצחים הא עבידין קטולין הרגו את אוריה ואת זכריה ר יודן"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_148r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_148r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_148r_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#evOrderOlder",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
