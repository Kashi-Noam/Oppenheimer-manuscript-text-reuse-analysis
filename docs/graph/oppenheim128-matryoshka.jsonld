  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-6–ה-7 (שכבת ילמדנו: 845 בערך)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Pesikta Rabbati', on Jewish Virtual Library: 'The precise date and place of compilation have not yet been fixed with certainty'; scholarly opinion favours a 6th–7th-century Palestinian origin; the date 845 in the first homily applies to the Yelammedenu stratum, and the date 1219 is a later gloss."
   },
   {
    "@value": "Wikipedia (English), 'Pesikta Rabbati' (text from the Jewish Encyclopedia, 1906): 'Composed around 845 CE'; it seems to be a combination of parts, with some homilies perhaps added later."
   },
   {
    "@value": "Encyclopaedia Judaica, 'Midrash' (M. D. Herr), on Jewish Virtual Library: Its table puts Pesikta Rabbati with Tanhuma, Deuteronomy Rabbah and Numbers Rabbah II in the 775–900 group of the middle period."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "It is a composite work: EJ says scholarly opinion favours a 6th–7th-century Palestinian origin, with the date 845 in the text applying only to the Tanhuma-Yelammedenu layer, while the Jewish Encyclopedia (via English Wikipedia) dates the whole work to c. 845."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "כל מקורותיו ארץ-ישראליים; מקום העריכה המדויק לא הוכרע"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Pesikta_Rabbati_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Pesikta_Rabbati_end"
   }
  ]
