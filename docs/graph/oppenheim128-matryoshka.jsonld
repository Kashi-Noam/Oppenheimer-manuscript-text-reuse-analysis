 {
  "@id": "http://example.org/oppenheim128#unit_fol_181r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מה עשה תפש בידו זונה ונכנם לבית קדשי הקדשים והציע ספר תירה תחתיה ועבר עליה עבירה נטל הסייף וגירר את הפרכות נעשה נס והיה דם מבצבץ ויוצא כשהוא סבור שהרג את עצמו ננונ את הפרכות ועשא כנן נדויתני בנשל ם לי ביה מנוה והניחם בתיכו והביאם לספינה שלו ליכלך ונלהשתבח בעירו ה ועמד עלי נחשול שלים לטבעו אמ אותו רשע כמדומה לי שאלהיהם של לו אין גבורתו אלאבים בא פרעה וטבעו בים בא סיסרא וטבעו בנחל קישון וההוא גברא דרבעי למטבעי בימא אם גבור הוא יעלה ליבשה עמי לעשות מלחמה יצת בת קול ואמרה לו רשע בן רשע בן בנו של עשו הרשע ברה קלה ישלי בעולמי יתוש שמו שמא זה יעלה ליבשה עמךך וילחם עמך אמאי קרי ליה דמעלנא אית ליה ומפקנא לית לית כיון שעלה ליבשה יתוש אחד נכנס לו בחוטמו ונקר לו במוחו זשנים"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_181r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_181r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_181r_1"
   }
  ]
 },
