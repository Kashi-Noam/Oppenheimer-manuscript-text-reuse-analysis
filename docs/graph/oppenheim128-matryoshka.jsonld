  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Vayikra_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "לא דבר רע ולא גזל שכל איבריך יעירו בב ואל נתדמוד רגליך לדבר עביכה שמנא יהונת השניעי באידלחיש ר אשיה פתח קריא בחמשהם זקנים שהיו מעברין את השנה והקבה מסכים עמהם ומניח סנקליטין שלו ומצמצם שכינתו ביניהם למטה יומלאכי השרת אומרים אל נערץ בסוד קדושים רבה ונורא על כל סביביו ומניח סנקליטין שלו למעלה ויודד ומצרשם שכינתו ביניהם למטה כל כך למה שאם טעו בדבר הלכה הקבה מאיר פניהם בהלכה שנ יי באור פניך יהלכון אמ ר יאשיה כת אשרי העם יודעי תרועה ולי אומות העולם אינן יודעון להריע כמהה הרנות ישלהם כמה בוקיאנוס ישלהם כמה שלפיראים יש להם ואתה אומ אשרי העם יודעי תרועה אלא אשרי העם שהם יודעים לפתות את בוראם בתרועה אימתי בחדש השביעי באחד לחדש ר ברכיה בשם ר ירמיה פתא ארח חיים למילה למשכיל למנינן סורמשאמ מטה ארחחיים אין ארחחיים אלא דברי תורה דכת עץ חיים היא למסזיקים בה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_69v_2#u1"
   }
  ],
