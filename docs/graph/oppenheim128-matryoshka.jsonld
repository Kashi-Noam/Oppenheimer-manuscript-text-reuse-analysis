  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "1915 (תרע\"ה), ניו יורק"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Wikipedia (English), 'Julius Eisenstein': Lists 'Otzar Midrashim (1915)', an anthology / library of 200 minor midrashim."
   },
   {
    "@value": "The Online Books Page (UPenn), J.D. Eisenstein: Catalog entries 'Ozar midrashim. A library of two hundred minor midrashim' (1915), publisher J.D. Eisenstein; also a 1928 Reznick, Menshel edition."
   },
   {
    "@value": "Sefaria, 'Otzar Midrashim': Composed: 1915 CE."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "No dispute over the year 1915 (a 1928 reissue exists); the place New York is implied by Eisenstein's New York activity but none of the pages consulted states the imprint place explicitly."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "אוסף מודפס בהוצאת י\"ד אייזנשטיין, ניו יורק; המדרשים הקטנים שבו עצמם מתקופות ומקומות שונים"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
