 {
  "@id": "http://example.org/oppenheim128#unit_fol_73r_2_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מה המקוה הזה פעמים פתור ופעמים נעול כך שערי תפלה פעמים פתוחים ופעמים נעולים מה המקוה הזה אדם מבקש לטבול בו ומצא אביו או רבו שם מתבייש והולך לו אבל הים מפליג קימעיא ויורד וטובל ר ברכיה ור חלבו בשם רב ענן בר יוסי אמ שערי תפלה לעולם פתוחין ואתיא כי האי דמרי ר יוסי בר חלפתא שאמ עתים הם לתפלה ובא דויד ופירש דכת ואני תפלתי לך יי עת רצון אלהים ברב חסדך ענני באמת ינ ישעך תאנה בשם ר אליעזר מקוה ישראל יי מושיעו בעת צרה מה המקוה הזה מטהר את הטמאים כך הקבה מטהר את ישראל לפיכך הושע מזהיר את ישראל ואומ להם שובה ישראל עד יי אלהיך ויי נתן קולו לפני חילו בראש השנה כי רבמאד מחנהו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_73r_2#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_73r_2_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_73r_2"
   }
  ]
 },
