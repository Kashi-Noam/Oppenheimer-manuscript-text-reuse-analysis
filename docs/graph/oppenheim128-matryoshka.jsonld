 {
  "@id": "http://example.org/oppenheim128#unit_fol_64r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "חמשה דברים אמ ר אין מניחין בשר חי על גבי הפת ולא על הכוס ועל הקערה ואין זורקין את הפת ואין סומכין את הקערה בפת ואין יושבין על האוכלין מפני שמשביחין את האוכלין והנכנס לסעודה לא יטול חלקו ויתננו לשמש שמא יארע דבר קלקלה בסעודה אלא יטלנו ויניחנו לפניו ואחרכך יתנרו לו אורחין הנכנסין אצל בעל הבית אין יוצאין אלא אם כן נטלו רשות מבעל קבית ואין נותנין דבר לתינוק אלא אם כן נטלו רשות מבעל הבית ומעשה באדם אחד שהבניס אצלו שלשה אורחים בשני בצרות והיו לו שלשה ביצים והניחן לפניהם בא בנו של בעל הבית ועמד לפניהם נטל אחד"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_64r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
