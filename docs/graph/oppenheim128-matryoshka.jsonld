  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_02"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאות ה-8–ה-9 (גרעין ארץ-ישראלי מהמאות ה-6–ה-7)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica, 2nd ed., 'Tanhuma Yelammedenu' (Marc Bregman), on Encyclopedia.com: The genre 'began to crystallize toward the end of the Byzantine period in Palestine (5–7th century)'; the printed Tanhuma (Constantinople 1520–22) 'seems to have undergone final redaction in geonic Babylonia'."
   },
   {
    "@value": "Wikipedia (English), 'Midrash Tanhuma' (cites Bregman 2003): The material shared by the printed and Buber recensions comes from 6th–7th-century Palestine; 'the formation of the printed edition is dated to after the Islamic conquests'."
   },
   {
    "@value": "Encyclopaedia Judaica, 'Midrash' (M. D. Herr), on Jewish Virtual Library: Its table puts Tanhuma in the 775–900 group of the middle period."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Tanhuma-Yelammedenu literature grew in strata: Bregman holds that the shared core is Palestinian from the 6th–7th century, but the printed recension took shape after the Islamic conquests and perhaps had its final redaction in geonic Babylonia; the EJ table gives 775–900."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "החומר המשותף לנוסחים ארץ-ישראלי (המאות ה-6–ה-7); לפי ברגמן (EJ) העריכה הסופית של הנוסח הנדפס כנראה בבבל הגאונית"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Tanchuma_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Tanchuma_end"
   }
  ]
 },
