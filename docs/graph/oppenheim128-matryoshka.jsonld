 {
  "@id": "http://example.org/oppenheim128#unit_fol_128r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אויב ארדוף אשיג אחלק שלל אתה מיצא כיון שבא משה אצל פרעה ואמ לו כה אמר יי שלח עמי ויעבדני אמ אותו רשע מי יי אשר אשמע בקולו לא ידעתי את יי וגם את ישראל לא אשלח הפה שאמ כל הבן הילוד היאורה תשליכוהו והפה שאמ מי יי חזר ואמ יי הצדיק ואני ועמי הרשעים הכה שאמ כל הבן הילוד היאורה תשלירו הושלך לים שנ מרכבות פרעה וחילו ירה בים הפה שאמ לא ידעתי את יי וגם את ישראל לא ישלא הוא עמו ום היה מחזר עלכתחי היכליהם שלישראל ואומלהם עא בשר צאו לשלום לכך נאמ ויהי בשלח פרעה את העם אמרו לאלהים מה נורא מעשיך ברובעזך יכחשו לך אויביך"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_128r_1#u1"
   }
  ],
