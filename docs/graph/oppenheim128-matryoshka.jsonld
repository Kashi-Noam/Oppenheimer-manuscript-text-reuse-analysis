   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_121v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Torah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר יודן לפי שהיו המצרים קוברין בתוך בתיהן והיו הכלבים נכנסין דרך הביבין ומשמלוין את הבכודות מבין המתים ומתעתעים בהם והיה קשה עליחם כאלו אותו היום קברום מבכור פרעה מלמד שפרעה היה בכור נתכנסו כל הבכורות אצל אבותיהם ואמרו להם בשביל דאמ משה ומת כל בכור וכל מאן דאמ על אלין עכא אתא עליהון אלא יצא יולין ויפקון אלין עבראי מן בינלא ואי לא אזלין עמא מייתין אמרו עשרה בנים לאחד ממנו ומודון בחד מנהון ולא תקום עד דאלין עבראי אמ כל סמא זמלתא ניזיל לן גביפרעה דהוא בוכרא ודלמא הוא חיים על נפשיה ומפיק אלין עבראי מביננא הלכו ליים אצל פרעה ואמרו לו בגין דאמ משה ומת כל בכור בארץ מצרים וכל דאן מה דאמר על אלין עמא אתא עליהון וכדאי קום ואפיק אלין עבראי מבינן ואי לא יזלון מייתן כלהון בוכריא אמפרעה לעבדיוי צאו וקפחו שוקיהם אנא אמר אינפשא חיננשרן דאנן ענחי וימן ימרן יוליו עביאי מבי עבראימבינן מיד יצאו הבכורות והרגו באבותיהם ששים רבוא ר אבין בשם ר יהודה בן פזי אמ בתיה בת כרעה בכורה היתה ובזכות מה ניצלה מצלתושלמ בתפלתו שנ משה שנ לאיכבה בכין בליכנרה בליל כתו כדא לים שמורים הוא ליי"
   }
  ],
