 {
  "@id": "http://example.org/oppenheim128#unit_fol_180v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "רב יהודה אמ שמואל משום רבן שמעון בן גמליאל מאי דכת עיני עוללה כנפשי מכל מנבנות ערי ר מאות בתי כנסיות היו בכרך גדול שלביתר וכל אחת ואחת היו בה ד מאות מלמדי תינוקות וכל אחד מהם היו יושבים לפניו ד מאות תינוקות ובשעה שנכנס האויב היו דוקרין אותן בחוטיהן וכשגברו האויבים כרכום בספריהם והציתום באש אמ רבה בר בר חנה אמ ר יוחנן מ סאה רצרצי תפלין נמצאו בראשי הרוגי בתר רב אסי משמיה דר ינאי בר ישמעאל אמ גקופות שלמ מ סאה במתניתא כנא מ קופות של מסאה לא פליגי הא בראשי האבדרעי אמ ר שמואל בר נחמני אמ ר יחחנן מאי דכת ידו פרש צר על כל מחמדיה זה עמון ומואב שבשעה שנכנסו גוים להיכל הכל נפנו אחרכסף וזהב והם נפנו אחרי ספר תורה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_180v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_180v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_180v_1"
   }
  ]
 },
