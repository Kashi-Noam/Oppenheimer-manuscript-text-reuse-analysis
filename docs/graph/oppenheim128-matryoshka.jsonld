 {
  "@id": "http://example.org/oppenheim128#unit_fol_178r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מיד הניח ידיו על ראשו והיה צועק ובוכה אמ שמא חס ושלים אין להם לישראל תקנה יצתה בת קול ואמרה זית רענין יפה פרי תאר קרא יי שמך מה זית זה תחלתו כסופו אף שראל אחריתן כתחלנן לקול המלה נדולה לקל מיליהק ומתלים נתירעפי תכו ישאל ראמ רחינש ברפהא דברגדול הבח מרלים באורה שעה שנ כי חזק הוא ממנו אל תקריפ ממנו אלא ממנו כביכול אפי בעל הבית אינויכול לה וציא כליו משם אמ ר יהושע בן לוי למה נמשלו ישראל בזית לומר לך מה זית זה אין עליו נושרין לא בימות החמה ולא בימות הגשמים אף ישראל אין להם בטלה לא בעולם הזה ולא בעולם הבא אמ ר יחכן למה נמשלו ישראל בזית לוא לך מה זיתזה אינו מוציא שמנו אלא על ידי כתישה אר ישראל כן איכן חוזרין למוטב אלא על ידי ייסורין"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_178r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_178r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_178r_1"
   }
  ]
 },
