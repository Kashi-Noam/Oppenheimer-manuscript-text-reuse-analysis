 {
  "@id": "http://example.org/oppenheim128#unit_fol_100v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma_Buber"
   },
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר יודן גדול כחן של נביאים שהם מדמים דמית גבורה של מעלה לדמות אדם שנ ואשמע קול אדם בין אולי אמ ר יהודה בר סימון ואית קרא חורי מחוור יתיר מן הדין שנ ועל דמות הכסא דמית כמראה אדם עליו מלמעלה ועוז פניו ישנא שהוא משנה מדת הדין למדת רחמים על ישראל דא מי כהחכם זהיאדם הראשון דכת ביה אתה חותם תכנית מלא חכמה ומי יודעפשר דבר שפירש שמות לכל שנ ויקרא האדם שמות חכמת אדם תאיר פניו אמ ר לוי בשם ר שמעון בן לקיש תפכוח עקבו של אדם הראשון היה מכהה גלגל אמה ואל תתמה על זה אדם עושה דסקרין של מים אחד לו ואחד לבן ביתו נאההוא לו שיעשה את שלו נאה כך אדם הראשון נברא לשל הקבה ולא כל שכן שיהא תפיח לקיבו שלו מכהה גלגל חמה ומה אם תפוח עקיבו כך קלסתרפניו על אחת כמה וכמה ר לוי אמ בשם ר חמא בר חנינא ינ חופית קשרלו הקבה בגן עדן ההד בעדן גן אלהים היית כל אבן יקרה מסנכתך אדם מטדה וגו ר שמעון בן לקיש אמ יא ורבנן אמ עשר ולא פליגי מאן דעביד להון יג עבד כל אבן יקרה מסוכתך"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_100v_1#u1"
   }
  ],
