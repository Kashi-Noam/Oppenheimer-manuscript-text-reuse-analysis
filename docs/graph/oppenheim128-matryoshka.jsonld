  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-6 (מסורתית רב אשי ורבינא, כ-500; תוספות סבוראיות עד אמצע המאה ה-7)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Wikipedia (English), 'Babylonian Talmud': Traditionally compiled by Rav Ashi and Ravina II around 500 CE; most likely completed in the 6th century, before the Muslim conquests of the mid-7th century at the latest; final Savoraic editing in the 6th century."
   },
   {
    "@value": "NJOP, 'The Babylonian Talmud Completed': Traditional date of completion: 13 Kislev 4236 (475 CE), the death of Ravina II."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Tradition sets the close at Ravina II's death (475) or about 500, but most scholars favor completion in the 6th century with Savoraic/Stammaitic editing that may extend into the 7th century."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "ישיבות בבל (סורא, פומבדיתא)"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Babylonian_Talmud_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Babylonian_Talmud_end"
   }
  ]
 },
