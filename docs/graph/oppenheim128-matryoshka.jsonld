 {
  "@id": "http://example.org/oppenheim128#unit_fol_89r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "על כבודו של צריק יותר מרבורו ירבעם עימד ומהד יבלעא ולאיבשהיו כיון ששלח ידו ללהה ותיבש ידו אשר שלח אליו ותגן המלך ויאמר אל אישי האלהים הל נא את פני יי אלהיך התפלל בעדי תרין אמוראין חד אמ אלהיך ולא אלהיו וחרנא אמ באלו פנים יהיה קורא אלהיו אעלכ ויחל איש האלהים את פני יי ותשב יד המלך אליו ותהי כבראשונה מהו כבראשונה ר ברכיה אמ ור יהודה בר סימוק בשם ר יהושע בן לוי אם הכתוש את האויל במכתש כחמור של חרשים אין אתה מועיל ממנו כלום מה בראשונה עומד ומקריב לען אף באחרונה כן דא כסף נבחר לשון צדיק זה הקבה שהבחיר את עולמי למשה ואמ כי תשא את ראם בני ישראל מה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_89r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_89r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_89r_1"
   }
  ]
 },
