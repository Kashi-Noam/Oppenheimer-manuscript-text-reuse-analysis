 {
  "@id": "http://example.org/oppenheim128#unit_fol_146r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "לו מהפך את המטה אמ להם אני עושה כן שנ חזה הוית עד די כרסוון רמיו ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו מבזע פורפירא אמ להם אף אני עושה כן שנ עשה יי אשר זמם בצע אמרתו אמ ר יעקב דכפרחנן מבאפ פרפירא ועוד שאל להם מלך בשר ודם אבל מהו עושה אמרו לו יושב ומקונן אמ להם אף אני עושה כן שנ איכה ישבה בדד כה אמר יי קראו התבוננו וקראו למקוננות ר יוחנן ר שמעון בן לקישורבנא ר יוחנן אמ משל למלך שריו להם ט שנבנים כיים על הראשון ונטל את המקנ וחבטו והגלהו אמ טו אנול לאה לנגלה לעס על השני יונטל המקל וחבטו והנלהו אמ אנא הוא רגרמית לעצמי רתרבותי בישא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_146r_1#u2"
   }
  ],
