 {
  "@id": "http://example.org/oppenheim128#unit_fol_87v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "כי זה משה האיש ובלשון וה הוג בהו שנ זה יתנו כל העובר על הפקודים צדקה צדקה תרומם גוי וחסד לאמים חטאת ר אליעזר ור יהושע ורבנן ר אליעזר אומ צדקה תרומם גוי אלו ישראל וחסד לאומים חטאת חסדים הם החטא לאומות העולם שהם מתייהדים בהם ור יהושע או צדקה תרומם גוי אלו ישראל וחסד לאמים קטאת הנייה היא לאומות העולם בשעה שישראל חוטאין שהן חוזרין ומשעבדין בהן ורבן שמעון בן גמליאל אומ צדקה תרומם גוי אלו ישראל וחסד לאמים חטאת חסד של אומות העולם חטאת הוא להם שכן דניאל אומ לנבוכד נצר וחטאך בצדקה פרוק ועוייתך במחן עניין ר אלעזר בן ערך אומ צדקה תרומם גוי וחסד אלו ישראל אבל לאומות העולם חטאים"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_87v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_87v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_87v_1"
   }
  ]
 },
