 {
  "@id": "http://example.org/oppenheim128#unit_fol_173v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ויש מהם שאינו מספיק לכל השבת כולה ולוה ומוציאו בשבת אחרת ואם אתה מבטל מהם שבת יהיו עשירים כמותכם והם מירדים בך אמ לו יפה אמרת אמ המלך תבנל גזירה זו ושוב אמ לו מי שישלו אויבים מהו רוצה שיהיו מרובים או מועטים אמ לו מעוטים אמ לו יהודים אלו אינן מועניין אלא בשביל שמקיימין את הנדה אשה אחת מהן יושבת שבעה ימים ויד ומ ושמנים שאינה מזדווגת עם בעלה ואם לא יעשו כן יפרו וירבו כמותבם וימרדו בך אמ לו יפה אמרת תבטל גזירה זו אמ לו אם כן כתוב אגרות עליהם ושלח כארץ ישראל מיד ציה המלך וכתבו אגרונ ויצא ר ראובן בן אנל רובילי ונכנסו גדולי המלך אצלו ומצאו הדברים שיעצו על ישראל הפוכים אמרו לו אצבע של יהודי נכנסה לכאן אמרו לו חזור בך אמ להם אין המלך חוזר בדברו אמרו לו אם כן כתוב באגרות אחרות שכל מי שיוליבם יהרג צוה המלך"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_173v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_173v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_173v_1"
   }
  ]
 },
