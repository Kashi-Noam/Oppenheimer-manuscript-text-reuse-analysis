 {
  "@id": "http://example.org/oppenheim128#unit_fol_27r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ובת קול רוצאה ומצפצפת מסוף העולם ועד סופו ואומרת מה שהיה הוא שיהיה זה הקבה שהיה ועתיד להיות ומה שנעשה הוא שיעשה והיא משיבה ואומרת להם לישראל בני כאשר עשה יהושע ליריחו ולמלכה כן תעשו לאנשי העיר המרשעת הזאת ולמלכה והם אומרין חין עמנו ארון הברית כאשר היה עם יהושע והיא משיבה להם לא היה בארון אלא שני לוחות אבנים וסתמן שמע ישראל מיד הם מריעים בתרועה שמע ישראל ומיד נופלת החומה תחתיה והם נכנסין לתוכה ומוצאין את בחוריה מתים ברחובותיה לקיים מה שנ יפלו בחדדה ברחוב ברחובותיה ואנשי מלחמתה רוכבים על סוסיהם ודוממין כאבנים כענין שנאמ וכל אנשי מלחמתה ידמו וישראל מתגברין והורגין בתוכה שלשה ימים ושלשה לילות וקובצים את כל שללה ונותנין אותה לתוך רחובה ושמועה באה עליהם מארץ"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_27r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_27r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_27r_1"
   }
  ]
 },
