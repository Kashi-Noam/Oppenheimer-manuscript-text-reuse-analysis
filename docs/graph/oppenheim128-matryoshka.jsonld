 {
  "@id": "http://example.org/oppenheim128#unit_fol_1r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Mishnat_Rabbi_Eliezer"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מדבר שהואמיוחד במקומו מדבר שאינו מתפרש במקומו ימתפרש מדגד אאר מדבר שנאמר במרצת והוא נוהג בכל מדבר שנאמר בזה נהוא הדין לחברו מדבר שנאמר ב ואינו ענין לו אנל הוא מני ן לחברו חרבד שכוקש לאתי מרות אתה נויהן מו כנח היפה שבשתיהן מדצבר שחבירו מוכיח עליו רך מדבר שהוא מובירד על חבירו מדבר שהיה בכלל ויצא מן הכלל ללמד על עצמו מדבר שהיה בכלל ויצא מן הכלל כלמד על חבירו ממשל מכנגד ממ ממוקדם וממאוחר שהוא בענין ממוקדם ומאוחד שהוא בפרשיות מלשון נוטריקון"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_1r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_1r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_1r_1"
   }
  ]
 },
