 {
  "@id": "http://example.org/oppenheim128#unit_fol_162v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "על אחת כמה וכמה הוא שהנביא מקטרן ואומר להם ותשכח יי עושך נוטה שמים ויוסד ארץ נתפחד תמיד כל היום מפני חמת המציק בא כאשר כונן כהשחית הנשיתון מה דאמרית לכון אם ימדו שמל מלמעלה ויחקרו מוסדי ארץ למטה בם אני אמאס בכל זרע ישראל על כל אשר עשו ראיתם שמים שנתמוניטו והארץ שנתמוטטה לאהיה לכם ללמו מהם אלא ותפחד תמיד כל היום מפני חמת המציק אמ ר יצחק שהיו הצרות מציקות זו אחר זו ואיה חמת המציק אלו המן ואחשורוש כאשר כונן להשחית שנאמ בחדש העשירי הוא חדש טבת יו מה צועה להפתח ולא ימות לשחת ולא יחסר לחמו אמ ר אבהו זו אחד מעשרהה דבדים שאמרו חכמים שהם סימן טוב לחולה עטווש זיעה שינה קרי חכום הלוך מעים בדרך ארץ וכו עטיוש מלין דכת עטישותיו תהל אור זיעה שנ בזעת אפך תאכל לחם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_162v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_162v_1_u1_selector"
   }
  ],
