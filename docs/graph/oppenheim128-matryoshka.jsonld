 {
  "@id": "http://example.org/oppenheim128#unit_fol_136r_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ודיניז מאחחרייהי שנ ואלה המלפטים אשר תשים לביניהם פב יודעי מרת נפשו ובשמחתו לא יתערב זו אינר יולף למיייצמרח רח ונר כיננ סול הנוי מפני שהנפש יודעת שהיא נדונת בה ומאי טעמיה על דשעים פחים אש וגפרית ורוחזלועפות מנת כוסם מהו מנת כוסהי אמ ר שמואל בד וחמז בשם ר יונתז שיפלשאנייטיכרין של אחר המידץ דא לב יודע מדת נפשו אלו ישראל ומשמחהו לא יתערב זר זה יתרו שנ וישלן משה את חותנו ולך לו אל ארצו מה כת בתריה בוש השלישי"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_136r_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_136r_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_136r_2"
   }
  ]
 },
