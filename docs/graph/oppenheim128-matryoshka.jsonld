 {
  "@id": "http://example.org/oppenheim128#dating_Ruth_Rabbah",
  "@type": [
   "http://example.org/oppenheim128#DatingAssertion",
   "http://www.w3.org/2006/time#ProperInterval"
  ],
  "http://example.org/oppenheim128#confidence": [
   {
    "@id": "http://example.org/oppenheim128#conf_medium"
   }
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@value": "0500/0640"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_49c1707fa5"
   },
   {
    "@id": "http://example.org/oppenheim128#source_d4a1b73550"
   },
   {
    "@id": "http://example.org/oppenheim128#source_0ce57e68aa"
   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_02"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-6 (לא לפני)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Ruth Rabbah', on Jewish Virtual Library: Its sages are no later than the end of the 4th century, but because it drew on Pesikta de-Rav Kahana 'it is difficult to assign the compilation … to a date prior to the sixth century'; it 'was redacted in Ereẓ Israel'."
   },
   {
    "@value": "Encyclopaedia Judaica, 'Midrash' (M. D. Herr), on Jewish Virtual Library: Its table groups Ruth Rabbah with Pesikta de-Rav Kahana and Song of Songs Rabbah in the 500–640 block."
   },
   {
    "@value": "Wikipedia (English), 'Ruth Rabbah': One of the earlier midrashim, contemporary with or shortly after Song of Songs Rabbah; Palestinian, with no Babylonian aggadot."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "It is placed among the early Palestinian midrashim, but because it draws on Pesikta de-Rav Kahana EJ dates it no earlier than the 6th century (its table: 500–640); Zunz's claim that it used the Babylonian Talmud was disproved by Albeck."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "נערך בארץ ישראל; מקורותיו ירושלמי, בראשית רבה, ויקרא רבה, איכה רבה ופסיקתא דרב כהנא"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Ruth_Rabbah_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Ruth_Rabbah_end"
   }
  ]
 },
