  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "נחמוה עליונים נחמוה תחתונים נחמוה חיים נחמוה מתים נחמוה בעולם הזה נחמוה בעולם הבא נחמנה על עשרת קשבטים נחמוה על שבט יהודה ובנימין משל לפלטין שנשרף מי צריך לנחם לא בעל הפללין שנ יען ביתי אשר הואחרב אמ ר ברפה בשםר לוי משל כמלך שהים לו כרם מסרו לאריס כד הוה עביד חמר טב אמ חמר כרמי עב כד הוה עביד חמר ביש אמ חמר כדמא דאריסי ביש אמ ליה האריס אדני טב תתלה בך וביש תקלה בי בין טב בין בישהוא דידך כך אמ הקבה כתחלה אמ למשה והוצא את עמי כד חטאח אמ לו לך רד כישחת עמך אמ לפניו רבונו שלל עולם כד זכו עמך וכד חטאו עמי והם עמך ונחלתד למה יי יחרה אפך בעמך אמ ר שמעון לא זו מחבבם עד שקראם עמו שנאמ וינחם יי על הרעהה אשר דבר לעשות לעמו אמ ר סימון אמרו ישראל לישעיה רבנו אראמ ר סימק אתה מנחמנו או אלהינו אמ להם חס ושלום אמר אלהיכם אמ לו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_153r_2#u1"
   }
  ],
