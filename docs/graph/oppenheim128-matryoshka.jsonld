  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המחצית הראשונה של המאה ה-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Wikipedia (English), 'Genesis Rabbah' (cites Strack & Stemberger 1996, pp. 279–280): Strack & Stemberger: 'composed between 400 and 450'; Elbaum: early 5th century; generally dated to the 5th century, with some later additions."
   },
   {
    "@value": "Encyclopaedia Judaica, 2nd ed., 'Genesis Rabbah' (M. D. Herr & S. G. Wald), on Encyclopedia.com: 'Edited in Ereẓ Israel, probably in the beginning of the fifth century'; it is 'the earliest amoraic aggadic Midrash extant'."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Scholars broadly agree on an early-5th-century Palestinian redaction (Strack & Stemberger: 400–450; EJ: beginning of the 5th century; Elbaum: early 5th century), while recognising later additions; its literary relationship to the Yerushalmi is debated."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "המדרש האמוראי הקדום ביותר; עריכה ארץ-ישראלית (לשון, חכמים, רמזים היסטוריים)"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Bereishit_Rabbah_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Bereishit_Rabbah_end"
   }
  ]
 },
