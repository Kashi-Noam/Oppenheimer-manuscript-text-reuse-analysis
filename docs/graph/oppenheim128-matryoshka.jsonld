 {
  "@id": "http://example.org/oppenheim128#unit_fol_125v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ואל מצנים יקחהו לא בזן ולא במגן ולא במלחמה אלא בהכלה ובתחנונים שנ ויאמר יי אל יהושע קום לך למה זה אתה רופל עליפניך ושאף צמים חילם מי דחק לממונן של לא מלך יהושע וכלב וכל המצומתים אצלם ובאיזה זכות זכו ישראל לירש את ארץ בנען הוי אימ בזכות מצית העמר לפיכך משה מזהיר אתישמ ואומ להם והבאתם את עמר ראשית קצירכם אל הכהן וכן הניף את העמר לפני יי לרבונכם וכאי זה בד היה מליפו ר חמא בר עוקבא אמ בשם ר יוסי בר חנינא מיליך ומביא מעלה ומוריד מוליך ומביא לבטל טללים רעים מעלה ומוריד כדי לעצור טללים רעים רסימא בשם ר יהושע בן לוי אמ מוליך ומביא למי שהרוחות שלו מעלה ומוריד למי שהעליונים והתחתו שלו ר אבין אמ ור יהודה ור כחמיה היא ר יעקב בר אביי בשם ר יהודה בר כמין ור יוחנן ור שמעון בן לקיש ר יוחנן אמ לעולם אל"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_125v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_125v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_125v_1"
   }
  ]
 },
