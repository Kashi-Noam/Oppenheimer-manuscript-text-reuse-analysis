 {
  "@id": "http://example.org/oppenheim128#unit_fol_202v_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Torah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Torah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "היה מתריס ואומר מי יי אשר אשמע בקולו ומהו מי יי אמ להם פרעה למשה ילאהרן ומה שמו של אלהיכם ומה כבודו ומה אומנותו ומה כחו ומה עבודתו וגבורתו ומה טיבו מיום שעמד אלהיכם למלכות ולמה לא שיגר לי אגרות ולא קביא לי אכסניא ולא ידע שכל מלכי העולם תחת ידי משל למה הדבר דומה לארי וזאב ושועל שהיו מהלכין בספתה והחמור גובה המכס אמ להם החמור תנו לי מכס אמ לו שועל כמה עזים פניך ארי וכל חיות יושבים ואתה גובה מכס אמ לו חמור מן המלך אני נוטל ולננזיהמלך אני מרנים אמ להם הארי קרבי לי ספינה על שוטה זה קרבו לו וטרפו אמ לשועל סדר לי אבריו של שוטה זה במקום אחד הלך שועל וסדרן נטלאת לבו ואכלו כשבא ארי אמ לו לבו של זה היכן הוא אמ לו אדני המלך לא היהלי לב שאם היה לו לב לא היה לוקחמכס מן המלך כך פרעה הרשע"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_202v_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_202v_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_202v_2"
   }
  ]
 },
