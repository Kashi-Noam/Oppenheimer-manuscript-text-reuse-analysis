 {
  "@id": "http://example.org/oppenheim128#unit_fol_158v_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "הוא ולית הוא מהימן לי אמ ליה אין כי ענותן הוא ומהימן הוא לך וכד תחמי יתהון ליה לא תחמי יתהון ליה קרם שום ברנש אלא בדברה רלעערתא למערתא רחיקא מוליך את אותו גמילין וחמי יתהוא ליה מתמן מיד נעשה רנער נם ויצא בשרום אזל ההוא ינוקא לגבי ר יהושע בן כוי ואשכחיה יתיב במתיבתא דבא דלוד אמ ליה מארי מילא דצניעותא אית לי גבך ומכע אנא למימרב קמך קדם ברנש אוחרן קם ליה ר יהושע תייתון וחמון ענותנותיה דר יהושע בן לוי דהוה מהלך בתר ההוא מינוקא גמילין ולא אמ ליה מה בעימיניה כיוא דמטו למערתא אמ ליה מארי אלין אנון אבני כדכודיא וכדי דתחמי יתהון אתיתי פמך כד חמא יתהון הבהיקה כל קרתא דלוד מאורן והשליכן לארץ ונגנמו שמשוכיך ושעריך לאבני אקדח אמ ר ירמיה בשם ר שמיאל בר יצחק עתיד הקבה לעשות שער המזרחי של בית המקדש הוא ושלי פשיפישן שלו אבן אחת שלמתלית ר יוחנן הוה דריש בכנשתא רבתא דצפורי ואמ עתיד הקבה לעשות שער המזרחי של בית המקדש הוא ושני פשפישין שלו אבן אחת שלמרגלית"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_158v_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_158v_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_158v_2"
   }
  ]
 },
