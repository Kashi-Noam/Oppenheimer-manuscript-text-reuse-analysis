  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "העת שנלך עליהם ונכלה אותם ורבנן פתרין קרא באומות העולם אתה מוצאכיון שגרמו העונות ונכנסו גוים כירושלם גזרו שבכל מקום שישראל בורחים שיהיו מסגירים אותם בקשו לברוח לדרום ולא הניחו להם שנ כה אמר יי על שלשה פשעי דמשק ועל ארבעה לא אשיבנו בקשו לברוח למערב ולא הניחו להם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_160v_1#u1"
   }
  ],
