 {
  "@id": "http://example.org/oppenheim128#unit_fol_99v_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ר אבין יר אבין בשם בשם ר שמואל קפודקאה אמ אעב דרגלוי דתרנגולתא דמיין לחרצפיתיה דנונא ועל הרמש וכי אפשר לו לאדם כשלמה לדבר על הרמש אלא אמ שלמה מפני מה שמנה שרצים האמורין בתורה הצדן והחובל בהן חייב ושאר שקצים ורמשים החובל בהם פטוד מפני שיש להם עורות ועל הדגים וכי אפשר לאדם כשלמה לדבר על הדגים אנא אמ שלמה מפני מה בהמה וחיה ועום טעונים שחיטה והורה יעקב איש כפר נבוריא בצור על הדגים שטעוניא שחיטה שמע ר חגי ואייתוניה אמ ליה מנן הורית כדין אמ ליה מן הדאדכת ישרצו המים שרץ נפש חיה מה עופות טעונין שחיטה אף דגים טעונין שחיטה אמ ארבעונייה וילקה אמ בר נשדאמ מולי דאוריתא ילקה אמ ליה דלא הורית טבות אמ ליה מנחן אמ ליה מן הדין דכת הצאן ובקר ישחט לקם ומצא להם אם את כל"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_99v_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_99v_2_u1_selector"
   }
  ],
