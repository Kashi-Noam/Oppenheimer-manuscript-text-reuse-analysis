 {
  "@id": "http://example.org/oppenheim128#unit_fol_12v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Zuta"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Zuta"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "שהוא אותב שלום ורודף שלום ומקדים שלום ומשיב שלום ומטיל שלום בין ישראל לאביהם שבשמים עד אחת כמה וכמה ר יוסי הגלילי אומ אף שמו של משיח נקרא שלום שנ אבי עד שרשלום אי ר יהושע גדול הוא השלים שישראל נקרא שלום שנאמ כי זרע השלום למי השלום לזרע השרום ר יוסי הגלילי אומ גדול הוא השטם שבשעה שמלך המשיח המשיח נלה לישראל אק כיתא ילא גשלם שנאמר מה נאוו על ההרים רגלי מבשר משמיע שלום ר יוסי הגלילי אומ גדול הוא השלום שבשעת מלחמה אין פותח אלא בשלום שנ כי תקרב אל עיר להלחם עליה וקראת אליה לשלום אמ ר יהושע גדול הוא השלום שעתיד הקבה לסמוך צדיקים בשלום שנ יצר סמוך תטר שלום אמ ר יהושע גבול הוא השלום שהיא תלויה לחיים ותלויה למתים לחיים מנין ויאמר יתרו למשה לך לשלום"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_12v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_12v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_12v_1"
   }
  ]
 },
