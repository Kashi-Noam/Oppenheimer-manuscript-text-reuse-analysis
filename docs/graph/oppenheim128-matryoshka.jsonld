 {
  "@id": "http://example.org/oppenheim128#dating_Mishnat_Rabbi_Eliezer",
  "@type": [
   "http://example.org/oppenheim128#DatingAssertion",
   "http://www.w3.org/2006/time#ProperInterval"
  ],
  "http://example.org/oppenheim128#confidence": [
   {
    "@id": "http://example.org/oppenheim128#conf_low"
   }
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@value": "0700/0900"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_41ffa44f23"
   },
   {
    "@id": "http://example.org/oppenheim128#source_d4a1b73550"
   },
   {
    "@id": "http://example.org/oppenheim128#source_b7cb8bebe3"
   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_02"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "אמצע המאה ה-8 בערך"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica, 'Midrashim, Smaller' (M. D. Herr), entry 'Midrash Agur', on Encyclopedia.com: Midrash Agur (also called Mishnat R. Eliezer or Midrash of 32 Middot) 'was probably composed in Ereẓ Israel, more or less contemporaneously with Pirkei de-R. Eliezer … about the middle of the eighth century'."
   },
   {
    "@value": "Encyclopaedia Judaica, 'Midrash' (M. D. Herr), on Jewish Virtual Library: Its table puts Mishnat R. Eliezer (Midrash Agur) in the 640–900 block of the middle period."
   },
   {
    "@value": "Wikipedia (English), 'Baraita on the Thirty-two Rules': The Baraita of 32 rules is traditionally c. 150 CE (school of R. Eliezer b. Jose), with interpolations; Zucker argued it was written only in the 10th century by Samuel b. Hofni, and Greenbaum challenged him."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "EJ dates the midrash to about the mid-8th century in Eretz Israel (its table: 640–900); the attached Baraita of 32 Middot is traditionally tannaitic, but Zucker argued it was written by Samuel b. Hofni in the 10th century, which Greenbaum disputed."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "לפי הר (EJ): כנראה חובר בארץ ישראל, בערך בזמן פרקי דרבי אליעזר"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Mishnat_Rabbi_Eliezer_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Mishnat_Rabbi_Eliezer_end"
   }
  ]
 },
