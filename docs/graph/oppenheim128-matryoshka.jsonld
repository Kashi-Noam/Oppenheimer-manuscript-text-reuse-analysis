 {
  "@id": "http://example.org/oppenheim128#unit_fol_46v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ושבט ראובן נגדם מאחורי הררי פארן וישביניהם שלום ושלוה ואקבה וביחד מלחמוקם וכריקות הדרכים שכורת בדרך מכות ודרך בבל וכל שללם יחלקו יחדו משא גמל מן מאכל יש אצלם בשני כספים ומדברם בלשון קדר ועמהם מקרא ומשנה ותלמוד והגדה וכל שבת ושבת דורשין בלשון קדש ומתרגמין בלשון קדר וש בכו אפרים וחצי שבט מנשה שם נגב מדינת מאקא יהם זעומי נפש וקהויי לב בעריסיסים יכרתו דרכים ולא יחוסו עלל אדם ואין להם ממון"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_46v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_46v_1_u2_selector"
   }
  ],
