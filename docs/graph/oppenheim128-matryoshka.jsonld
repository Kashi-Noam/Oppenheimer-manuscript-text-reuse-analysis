 {
  "@id": "http://example.org/oppenheim128#unit_fol_59v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אותו היום ישב ר שמעון ודרש בבית המדרש הגדול שלו לעולם הוירך כקנה ואל תהי קשה בארז מה קנה יצאו ארבע רוחות העלם קנה הולך ובא עמהם עמדו הרוחות קנה במקומו עומד מה סופו שלקנה זה זנה ליטול ממנו קולמוס לכתוב בו ספר תורה אבל ארא חה אינו כן ינתה רוח צפינית עוקרתי והופכתו עלל פניו נמצא ארח זה שהיה עימד על שישיו מה הוא סופד באין ומכתתין אותו ומסככין בו בתים והשאר מניחין על גבי האור לכך אמרו חכמים הוירך כקנה ואל תהי קשה כארז כיצד מכבד אדם את רבו בזמן ששניהם מהלכין בדרך יותנו לימין ואיזנותנו נסמם היו שלשה תלמיד וחכם והרב ביניהם הרב הולך באמצע והגדול בימינו והקטן לשמאלו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_59v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_59v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_59v_1"
   }
  ]
 },
