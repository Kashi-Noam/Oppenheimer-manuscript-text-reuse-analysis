 {
  "@id": "http://example.org/oppenheim128#unit_fol_182v_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "באדם אחד שנתן עיניו באשת רבו ושוליא דנגרי הוה פעם אחת עטדך רבו לטת אמ לו שגר אשתך עמי ואני אלוך שגרה עמו שהתהו בביתו ג ימים קדם הוא ובא יתלו אמ לו אשתי ששגרתי אצלך היכן היא אמ ליה פטרתיה לאלתר אלא שמערבי שמתעללין בה בדחד אמ לו מה אעשה לה אמ לו גרש אותה אמ לו כתובתה מרובה אמ לו אני אליך הלוהו לו כ כתובתה וגרשה עמד הוא ונשאה וכשהגיע זמנו לא היה לומה לפרוע אמ לו בא ועשה עמי בחובך והיו הם יושבים ואוכלים והוא עומד ומשקה עליהם והיו דמענת יורדות מיגיניו ונופלות בתויך כוסיהן ועל אותו מעשה נחתם גזרדין וישאמ על שתי פתילות בנר אחד כת איכה ישבה בדד אמ רבא אמ ר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_182v_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_182v_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_182v_2"
   }
  ]
