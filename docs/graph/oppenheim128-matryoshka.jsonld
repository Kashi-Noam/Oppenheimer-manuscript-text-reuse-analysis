 {
  "@id": "http://example.org/oppenheim128#dating_Midrash_HaGadol",
  "@type": [
   "http://example.org/oppenheim128#DatingAssertion",
   "http://www.w3.org/2006/time#ProperInterval"
  ],
  "http://example.org/oppenheim128#confidence": [
   {
    "@id": "http://example.org/oppenheim128#conf_medium"
   }
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@value": "1300/1399"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_925f276223"
   },
   {
    "@id": "http://example.org/oppenheim128#source_6bf3f442a7"
   },
   {
    "@id": "http://example.org/oppenheim128#source_ac9196bfee"
   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_10"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-14 (יש המקדימים למאה ה-13)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Wikipedia (English), 'Midrash HaGadol' (cites Higger 1934 JQR; Strack & Stemberger 1991; Fisch 1940): Written by David ben Amram Adani of Yemen (14th century), dated to the late 14th century by Higger; via Strack & Stemberger, 'modern scholars almost uniformly attribute the work in its entirety to David bar Amram al-Adani' and the attribution to Abraham Maimonides is 'only extremely weakly attested'."
   },
   {
    "@value": "Encyclopaedia Judaica (2007), 'Midrash ha-Gadol', on Jewish Virtual Library: 'A 13th-century rabbinic work on the Pentateuch, emanating from Yemen'; 'now certain that it was written by a native of Aden, David b. Amram Adani.'"
   },
   {
    "@value": "Wikipedia (English), 'David ben Amram Adani' (cites Ratzaby, EJ 1971 and 1989): Adani is a 14th-century figure; Yehoshua ha-Nagid corresponded with him in 1346, and he asked about a calendar cycle beginning 1352."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Most recent scholarship (Higger; Strack & Stemberger; Ratzaby, who has Adani corresponding in 1346/1352) puts it in the 14th century, but the EJ entry 'Midrash ha-Gadol' calls it a 13th-century work; Fisch's attribution to Abraham Maimonides (Egypt) is considered weakly attested."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "דוד בן עמרם העדני מעדן; כל כתבי היד ממוצא תימני"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_HaGadol_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_HaGadol_end"
   }
  ]
 },
