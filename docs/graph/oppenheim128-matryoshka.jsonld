 {
  "@id": "http://example.org/oppenheim128#unit_fol_32v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Ruth_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Ruth_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ושרי אומות העולם אומרין רבון העולם וני יש לפניך משוא פנים אם אלו מגלי עריות אלו מגלי עריות ואם אלו עובדי עז אלו עובדי עז ואם אלו שופכי דמים אלו שופכי דמים מפני מה הללו יורדין לגיהנם והללו אין יורדין באותה שעה מיכאל שר ישראל סניגורן של ישרחל משתתק ההד בעת ההיא יעמוד מיכאל השר הגדול מהו יעמוד וכי יש ישיבה למעלה לא כן אמ ר חנה בן אנדרי שאין ישיבה למעלה דכת הרבת על חד מן קאמיא דדין לישנא דאק אמר ליה קאמיא קיימיא שרפים עומדים ממעל לו וכל צבא השמים עומדים ואת אמר יעמוד ומהו יעמוד יעמוד משתתק כד הוחלתי כי לא ידברו עמדו ולא ענו עוד העומד על בני עמך שעומד ללמד סניגוריא על ישראל והיתה עת צרה שאותה שעה יתחייבו ישראל לירד לגיהנם אשר לא נהייתה מהיות גוי עד העת ההיא אימתי היו ישראל לגוי במצרים שנ ויהי שם לגוי לימדך הכת שקשה דין גיהנם מכל שעבוד מלכיות שנשתעבדו בו ישראל ובעת ההיא ימלכו עמך בזכות מי ר לוי אומ בזכות המילה כת הכא ובעת ההיא ימלט עמך וכת להלן בעת ההיא אמר יי אל יהושע"
   }
  ],
