 {
  "@id": "http://example.org/oppenheim128#dating_Midrash_Lekach_Tov",
  "@type": [
   "http://example.org/oppenheim128#DatingAssertion",
   "http://www.w3.org/2006/time#ProperInterval"
  ],
  "http://example.org/oppenheim128#confidence": [
   {
    "@id": "http://example.org/oppenheim128#conf_high"
   }
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@value": "1097/1115"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_2d70062303"
   },
   {
    "@id": "http://example.org/oppenheim128#source_852ae3f63c"
   },
   {
    "@id": "http://example.org/oppenheim128#source_1cab6748b0"
   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_06"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "סוף המאה ה-11 – ראשית המאה ה-12 (1097, תוקן 1107/8)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Midrash Lekaḥ Tov', on Jewish Virtual Library: A late 11th-century work by Tobias b. Eliezer, who lived in the Balkans (Buber); refers to the martyrs of the 1096 Crusade."
   },
   {
    "@value": "Wikipedia (English), 'Tobiah ben Eliezer' (incorporating the Jewish Encyclopedia): Written in 1097 and revised in 1107 or 1108; covers the Pentateuch and the Five Megillot; Buber proved the author a native of Kastoria."
   },
   {
    "@value": "Seforim Blog, 'Lekah Tov – What's in a Name?': Written after 1097 (refers to Crusade tribulations); author's residence variously given as Kastoria or Ashkenaz (Mainz suggested by Singer and Seligsohn)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "The date is anchored by the work's own allusions to 1096/1097 and a revision of 1107/8 (Sefaria gives c. 1105–1115); the author's place (Kastoria/Balkans vs. Mainz) has been disputed."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "ר' טוביה בן אליעזר, יליד קסטוריה שבבלקן (בובר); יש שהציעו אשכנז (מגנצא)"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Lekach_Tov_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Lekach_Tov_end"
   }
  ]
 },
