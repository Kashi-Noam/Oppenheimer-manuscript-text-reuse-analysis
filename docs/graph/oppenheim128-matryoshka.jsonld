 {
  "@id": "http://example.org/oppenheim128#unit_fol_81v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ביום השמיני עצרת תהיה לכם ר יודה בר סימו פתר בשם ר מאיר קריה בנרה תן חלק ל שבעה וום לשמנה אלו שמנת ימי מילה אמ הקבה אם שמרת שבעת ימי נדה כראוי הריני נותן לך בן ואתה מוט לח ימים שנ וביום השמיני ימול בשר ערלתי ר טי אמ תן חלק לשבעה אלו שמנת ימי החג וגם לשמונה שנ וביום השמיני עצרת כי רוצה יי בעמו יפאר ענוים בישועה ר יהושע דסכנין בשם ר לוי אמ ריצה הוא הקבה בקרבנו של"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_81v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_81v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_81v_1"
   }
  ]
 },
 {
