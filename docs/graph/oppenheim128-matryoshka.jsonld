 {
  "@id": "http://example.org/oppenheim128#unit_fol_132v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אליך ייינפשי אשא כתוב אחד או אמ דוד לפני הקבה רבונו של עולם תשוק נפשיעל אלו שהן עתידא ליתן ולמסור את נפשם בלב טיוב ובאהבתך את נפשם על קדוש שמיך ואי זה זה זהדורו של שמד אמ לו הקבה דוד כלום הפסידו ואין חלקם בחיים חלקם בחיים שנ ורצפונך תמלא בטנם ירו ישבעו בנים והניחו יתרם לעולליהם אמ דוד לפני הקבה יהה לי חלק עמהם אמ לו הקבה וצפונב תמלא בטנם וצפים אין כתיב כאן אלא וצפינך תמלא בטנם דידך ודידהון אמ דוד לפני הקבה אלו באים מכחתודה ומעשים טובים אבל אני בצדק אחזה פניך אמ ר חייא בראבא אם יאמר לך אדם תן נפשך על קדוש השם אני נותנה ובלבד שיתיהו את ראשו כ מיד כדודו של שמד שהיו נותנים כדוריות של אש תחת שיחיהם וקרומיות שלקנה תחת צפרניהם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_132v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_132v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_132v_1"
   }
  ]
 },
