   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר חזקה בשם ר ירמיה כך היה ר שמעון בן יוחאי אומ קרב אברקם מן גביה ועד גבאי ואנא מקריב מן גבאי ועד דייתי מלכא משיחא ואין לא יצרף עימיה אחיה השילוני ואנא מקרבין כל עמא עאל תליתאה ודרש ויאמר לה לכי מכרי את השמן ושלמי זהנשיך ית בניך תחיביוהי רינא ר שמעון בן יוחאי ור אלעזר עבדין טמירין תלת עשרה שנין בהדא מערתא דבקע אכלין חירובין דתרומן עד שהעלה גופן חלדות חלדות לסוף יג שנין נפקר שמע בן יוחאי ויתיב ליה פל תרע מערתא וחמא לחד בר נשפרים מצדתיה למצד עופין פרסה זמן קדמאי שמע ברת קלא דאמרת דימים ואשתזבת פרסה זמן תנין ושמע ברת קלא אמ סכק לה ואתפיסת אמ אפי צפר מבלעדי שמא לא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_133r_2#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_133r_2_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_133r_2"
   }
  ]
 },
