   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_198v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Eichah_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Eichah_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "על שהיומשעבדים בעבד עברי לעז ודיא ישבה בגוים לא מצאה מנוח וכת ובעים ההם לא תרגיע כל רודפיה השיגוה בין המצרים ילא מצאה מנוחה לא היתה חוזרת דכת ולא מצצאה ההיונה מנוח ביומי עקא מיז בתמון עד ט באב שבם קטב מרירי מצוי ואינו מהלך לא בחמה ולא בצל אלא בנל הכמוך בחמה ר יוחנן הוה מפקיד לספריא ולמתניאכא ולמתניאתא דלא יטרחון תינוקיא ביומיא האינון דרכי ציון אבלות מבלי באי מועד י לפי שגלו עולי רגלים שאפי הדרכים מבקשים תפקידם כל שעריה שוממין שאין יוצא ואין בא כהניה נאנחים על בית המקדש ואין מי יתן מתנות כהונה בתולויתיה נוגות והיא מר לה אלו תלמידי חכמים שהם דומים בשכם כבתולות ונעשו נוגות ודרך צריה לראש זה נבוכד כצר דכת ביה אנת הוא רישא דידהבא י לפי שכל המיצר לישראל נעשה ראש משום שנ היו צדיה לראש אמ רבא אמ ר יוחנן כל המיצר לישראל אינו עיף שנ כילא מועף כאשר מובק לה י כי יי הוגה על רוב פשעיה אמ ר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
