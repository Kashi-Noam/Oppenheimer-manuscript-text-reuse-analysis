 {
  "@id": "http://example.org/oppenheim128#unit_fol_160r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר אלער בשם ר חנינא תלמידי חכמים מרבים שלום בעולם וכו לכי ואנושה אגכי אגכי הואמנחמכם חדכה שברה על חרפה שחרפו אותנו עמונים ומואבים הכת מדבר אתה מוצא כיון שגרמו עונות ונכנסו גוים לירושלם נבנסו עמם עמונים ומואבים ונכנסו לבית קדשי הקדשים ונטלו את הכרובים ונתנום בכליבה והיו מחזירין בכל חוצות ירושלם והיך אומ והלא ישראל היו אומ שאנו עובדין עז ראו מה היו הם עובדים ההד יען אמר מואב ושעיר הנה ככל הגוים בית יהודה ומה היו אומ יוי יוי בלא חדוה באותה שעה אמ הקבה שמעתי חרפתמואב וגדופי בני עמח לכן חי אני נאם יי צבאות כי מואב כסדום תהיה ובני עממ כעמורה ואנושה באה מכה על מכה גברתנית ומתישה ואקוה לנוד ואין ולחנחמים ולא מצאתי אמ הקבה אנכי אנכי הוא מנחמרם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_160r_1#u1"
   }
  ],
