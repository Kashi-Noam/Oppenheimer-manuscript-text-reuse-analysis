 {
  "@id": "http://example.org/oppenheim128#unit_fol_168v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "וההיום עשה יי נגילה ונשמחה בו אמ ר אבין אין אנו יודעים במי נשמה אליביום אם בהקבה עד שבא דוד ופירש אשמחה ואעלבה בך אמ בך ברב אותיות שכתבת לנו את התורה ב תרי כ עשרים תמן תנינן נשא אשה ושהת עמו עשר שנים ולא ילדה אינו רשאי לבטל פריה ורביה גרשה מותרת לה גשא לאחר ורשאישכי לשהות עמה עשל שנים אם הפילה מונה לה משעה שהפיכה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_168v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_168v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_168v_1"
   }
  ]
 },
