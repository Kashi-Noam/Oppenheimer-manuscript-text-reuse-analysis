  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מיכה לנחמה אומ לו מה בידך מי אלכמוך נושא עון ועובר על פשע אמ שאמרת בכשע יעקב איזו מהן לאמין ילך נחום לנחמה אומ לו מה בידך כי לאיוסיף לעבר בד עיד בליעל כלה נכרת אומ לו אמש אמרת ממך צאמושב על יי רעה יועץ בליעל איזה מהן נאמין ילך חבקוק לנחמה אומ לו מה בידך יצאת לישע עמך אומ ל אמש אמרת עד אנה יי שועתי ולא תשמע איזה נאמין הלך בפניה אומ לו מה בידך אמ לו"
   }
  ],
