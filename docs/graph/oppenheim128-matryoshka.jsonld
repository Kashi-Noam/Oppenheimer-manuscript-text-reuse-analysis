 {
  "@id": "http://example.org/oppenheim128#unit_fol_79v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "להדין כדין עד דמדכי מחשר פרוטוי וכיון דאתפשר פריטוי אמ ליה קום אזיל לחבריה דההוא גברא דהגה סופיה ביש ההד ודע לי על כל אלה יביאך האלהים במשפט ר אליעזר בנו שלר יוסי הגלילי אמ אמרו ישראל לפני הקבה רבונו של עולם אם עושים אנו תשובה לפניך מי מעיד עלינו אמ להם לרעה אני נעשה עד וכת וקרבתי אלינם אליכם למשפט והייתי עד ממהר במכשפים ובמנאפים ובטובר לא אהיה לכם עד לאחב בן קוליה ולצדקיה בן מעשיה נעשיתי עד ולכם בטובה איני נעש עד אלו היו נביאי שקר והיו מנאפים נשירעיהם שנ יען אשר עשו נבלה בישראל וינאפו את נשי רעיהם וידברו דבר בשמי אשר לאצויתים ואנכי היודע ועד מה הוה עביד כל חד מנהון אזיל לגבי אתתא אמ לה חמיתי בנבואתי דא דיהוה חברי אתי לגבך ואת מיקמא נביאייא בישראל"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_79v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_79v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_79v_1"
   }
  ]
 },
