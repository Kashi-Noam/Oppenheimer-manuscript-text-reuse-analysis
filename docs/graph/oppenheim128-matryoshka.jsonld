 {
  "@id": "http://example.org/oppenheim128#unit_fol_182v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מאי פירענותיהו דרשרבא בדרעולא והיה תחת בשם מק יהיה מקום שהיו מתבשמות בו נעשה נמקים נמקים ותחת חגורה נקפה מקום שהיוחוגרות בורבצלבילל נעשה נקפים נקפים ותחת מעשה מקשה קרחה מקום שהיו מתקשטות בו לעשה קרחים קרחים ותאנ פתיגיל מחגורת שק פתחים הבאים לידי גילה כעשים למחגורת שק כי תחת יופי אמ רבא היינו דאמרי אינשי חלופי שופרא כיבא ושפח יי קדקד בנות ציון אמר יוםי בר חנינא מלמד שפרחה צרעת כתוב הכא ושפח וכת התם ולשאת ולספחת ולבהרת ויי פתהן יערה רב ושמואל חדאמ שנשפכו כקיתון וחד אמ שנעשו פתחיהן כיער אמ רב יהודה אמ רב"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_182v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_182v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_182v_1"
   }
  ]
 },
