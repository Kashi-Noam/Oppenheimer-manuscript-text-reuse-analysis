   {
    "@id": "http://example.org/oppenheim128#unit_fol_31r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_31r_1"
   }
  ]
 },
