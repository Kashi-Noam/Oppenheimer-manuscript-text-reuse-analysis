 {
  "@id": "http://example.org/oppenheim128#unit_fol_197v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אף אני עושה כן שנ ראיתי את הארץ והנה תהו ראיתיההרים והנה רועשים וכל הגבעות התקלרלו ראיתי והנה אין האדם וכל עוף השמים נדרו ואין אדם אלא ישראל שנ ואתן צאני צאן מרעיתי אדם אתם המתאבל תולה שק על פתחו אף אני עושה כן שנ אלביש שמים קדרות המתאבל בוכה ביום ובלילה אף אני אעשה כן שנ ואבכה יומם ולילה את חללי בת עמי מי בכה הקבה בכה דומה לחכם שהיו לו שני בנים משכים ומוליכם לבית הספר מעריב מוליכם לבית הספר לאחר ימים מתו שניהם והיה משכים לבית הספר ובוכה מערב לבית המשתה ובוכה כך הקבה כיון שחרבה ביון זירושלם היה משכים לציון ומבקש אחד מישראל ולאהיה מוצא מעדיב לירושלם ומבקש אחד מישראל ולא היה מצא לכך ואננה יומם ולילה את הקבה נתתיתירה לישר ל שמני שיעסרו בה יומם ולילה שלוהגית בו יומם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_197v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_197v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_197v_1"
   }
  ]
 },
