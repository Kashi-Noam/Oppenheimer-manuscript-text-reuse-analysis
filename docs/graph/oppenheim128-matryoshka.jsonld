 {
  "@id": "http://example.org/oppenheim128#unit_fol_41r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "וכן דניאל אומ חזה הוית עד די התגזרת אב ןדי לא בידין ומחת לצלמא על רגלוהי די פרזלא וחספא והדקק המון חןחן לה שהואנותן חן ותחנונים לישראל כמה דתימא ושפכתי על בית דוד ועל יושבי ירושלם רוח חן ותקנונים ואחד שמשיח פורע מן עשו הוא נעשה מלך גדול ההד ואבנא די מחת לצלמא הות לטוררב ומלאת כל ארעא ומהו לטוררב כדא מי אתה הר הגדול דא למה קורא למשיח הר שהוא בא דרך הרים כד מה נאוו על ההרים רגלי מבשר באותה שעה ישראל מסתכלין על ההרים ההד אשא עיני על ההרים מאין יבא עזרי זה משיח שנקרא עזר כד ישלח עזרך מקדש ומאיכן הואבא מן הקבה ההד עזרי מעם יי עושה שמים וארץ"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_41r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
