  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "עשה להם כמן טגן שלנחשת ועשה אותם נקבים נקבים ות ונתנם לתוכו והתחילו לחמם תחתיהם כיון שראו בצרתן צעקו שינתן עמהם יהושע בן יהוברק שלישו אמרו בדד זכותיה נשתזיב הם נשרפו והוא ניצול ועליו הכת אומ הלא זה אוד מוצל מאש ההד ולקח מהם קללה לכל גלות יהודה אשר בבבל לאמר ישימך יי כאפ לצדקיהו וכאחב אשר קלם מלך בבל באש מהו קלם כקליות"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_80r_1#u1"
   }
  ],
