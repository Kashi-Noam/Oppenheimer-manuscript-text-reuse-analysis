  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "איכה היתה לזונה ר אבהו בשם ר יוסי בר חנינא כתח והמה כאדם עברו בריק שם בגדו בי והמה כאדם וה אדם הראשון הרנסתי אותו לגן עדן וצויתיו ועבר על צוויי ודנתי אותו בגירושין ודנתיאותו בשליחין וקוננתי עליו אינה הרנסתיו לגן עדן שנ ויקח יישלרים את הארם ויניחהו בנן עדן ובויתיו שנ ויצו יי אלהים על האימ ועבר על צוויי שנ המן העץ אשרצויתיך ודנתי אותו בגירושין שנ ויגרש את האדם ודנתי אותו בשלוחים שנ וישלחהו יי אלהים וקוננתי עליו איכה שנ ויקרא יי אלהים אל האום ויאמר לו איכה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_145r_2#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
