 {
  "@id": "http://example.org/oppenheim128#unit_fol_147r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Eichah_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר אבא בר כהנא לא עמדו פילופוסים באומות העולם כבלעם בן בעור וכאבני מוס הגרדי אמ להם יכולים אתם להזדגו להזדווו לאומה זו אמרו להם לכו חזרו על כל בתי כעסיות ועל כל בתי מדרשות שלהם אם מצאתם שם תינוקות מצפצפים בקוכם אין אתם יכולים להזדווג להם ואם ראו אתם יכולים להזדווג להם שכך הבטיחם אביהם הקול קול יעקב והידים ידי עשו כשיעקב מצפצף בבתיכנסיות ובבתי מדרשות אין הידים ידי עשו וכל אמן שאן קולו של יעקב מצכבף בבתי כנסחת ובבתי מדרשות הידים ידי עשו שמואל אמ וצבא תנתן על התמיד בפשע בפשעה שלתורה אימתי כשישרל משלכין דברי תורה לארץ מלכות הרשעה הזאת גוזרת ומצלחת ומאי טעמיה ותשלך אמת ארצה ואין אמת אלא דברי תורה כדא אמת קנה ואל תמכור אמ ר יודה בר סימון זנח ישראל טוב אויב ירדפו ואין טוב אלא דברי תורה כדא כי לקחטוב נתתי לכם וכן הוא או לכן כאכול קש לשון אש וכ יש קש אוכלת אש אלא דרכה של אב להיות אוכלת קש ואתה אומ כאכול קשל שון אש אלא קש זו ביתו של עשו שהוא נמשל בקש דכת ובית עשו לקש"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_147r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_147r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_147r_1"
   }
  ]
 },
