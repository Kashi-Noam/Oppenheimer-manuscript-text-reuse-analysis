  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "כי לא נחש ביעקב אמ בלעם לבלק הרי אתה מחזר ומנחש ומקכם באי זה מקום תשלוט בהם והם אינם כן כשהם צריכים לה לחם בשונא עומד כהן גדול ולובש אורים ותומים ושואנ בהקבה כל הגוים מנחשים ומקסמים וישראל מבדין אותם בתשובה ומבטלין קסמיהם שנ מפר אותות בדים וקוסמים יהוללו כעת יאמר ל עקב ולישראל מה פעלל ראתה עינו של בלעם שישראל יושבים לפני הקבה לעתיד לבא כתלמיד היושב לפני רבו ושואלין אותו כל פרשה ופרשה למה נכתבה וכן הוא אומר ליושבים לפני יי יהיה סחרה ואומ לא יכנ עוד מוריך והיו עיניך רואות את מוריך ומלאכי השרת רואין אותם ושואלין לום מה הורה לכם הקבה לפי שאינן יכולין"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_47r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_47r_1_u2_selector"
   }
  ],
