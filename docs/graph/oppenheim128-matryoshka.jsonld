 {
  "@id": "http://example.org/oppenheim128#unit_fol_185r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מעשה בבנו ובתו שלר ישמעאל בן זלישע כהן גדול שנשבו לפנ אדנים הבן לאדון אחד והלת לאדון אחד אמרו זה לזה ישלי עבד שהוא יפה ביותר ואיז כמותי בעולם אמ לו חבירו יש לי שפחה אחת שאין כמות בעולם נת יעצו להשיאם זה לזה מה עשו זיווגום היה יושב וה דהרוז אחד וזה בקכץ איזד זה בוכה ואומר אני כהן בן הפם בדולים אנשא לשפחה וזו בוכה ואומרת אני בת להז גדול ואנשא לעבד והיו בוכים כל הלילה כיון שעל ה נמוד השחר הכירו והצתזה וגעו בבכיה גדולה וחבהו זה את יה עד שיצאה נשמית וטל הן מקונן ירמיה על אלה לבוכיה אמ רב יהודה אמרב"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_185r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_185r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_185r_1"
   }
  ]
 },
