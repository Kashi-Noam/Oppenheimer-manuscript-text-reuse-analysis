  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "עינים מראות ברע ומהו יוסיף אמץ שמעצים בחן של צדיקים לעשות רצונו דא ויאחז צדיק דדכו זה משה דכת ביה צדקת יי עשה וטהר ידים יוסיף אמץ דכת לא חמור אחד מהם נשאתי יוסיף אמש שהעצים כח המקום שנ ועתה יגדל נא כח י ר יניקב בר אחא בשם ר יוסי בר חנינא אמ ורבנן בשם ר יוחנן יתקף חייליהון דרחמך הגביר מדת רחמים על מדת הדא כדא ועתה צדל נא כח יי אמ ר משל לגבור שהוא מתנו מתנוסם באבן של מסית ועבר אחד וראה אותה ואמ לו ייפה כחך יפה כחך בנכורה כתוב ביום השמיני עצרת תהיה לכם ר יודה בר סימו פתר בשם ר מאיר קריה בנרה תן חלק ל שבעה וום לשמנה אלו שמנת ימי מילה אמ הקבה אם שמרת שבעת ימי נדה כראוי הריני נותן לך בן ואתה מוט לח ימים שנ וביום השמיני ימול בשר ערלתי ר טי אמ תן חלק לשבעה אלו שמנת ימי החג וגם לשמונה שנ וביום השמיני עצרת כי רוצה יי"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_81v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_81v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_81v_1"
   }
  ]
 },
