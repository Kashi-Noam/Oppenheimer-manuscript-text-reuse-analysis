 {
  "@id": "http://example.org/oppenheim128#unit_fol_171r_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר יהושע בן לוי עד כאן שמעתי מכאן ואילך צא ופרוש לעצמך איש האלהים בשעה שעלה למרום איש האלתים ובשעה שירד למטה איש שנ וירא אהרן וכל בנ ישראל כי קרן עור פני משה בשעה שברח מפליפרעה איש האלהים בשעה ששקע מצריים לים רא איש האלהים בשעה שנסתלק הארון ובשעני ששכן לקיים מה שנ קומה יי למנוחתך ובשעה ששכן ובנחה יאמר שובה יי רבבות אלפי ישראל מלמד שבירך כל ישראל כאחד כענין שנאתם נצבים היום כלבם אמ ר אבין כל ימיו של משה היה מבקש לברך את ישראל ומה ברכה בירכם הושיעה את עמך וברך את נחלתך תנו רבנן מהו שנ אני אמית ואחיה יכול תהא מיתה באחד וחיים באחד כדרך שהעולם נוהג תל מחצתי ואני ארפא מה מחצה ורפואה בארחה אף מיתה וחיים באחד מכאן תשנבה לאומרים אין תחיית המתים מן התורה וכן אח ישיר משה שר לא נאמר אלא ישיר מכאן לתחיית המתים מן התורה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_171r_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_171r_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_171r_2"
   }
  ]
 },
