 {
  "@id": "http://example.org/oppenheim128#unit_fol_154r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר יהודה בר סימון נ זוכרת אני שירים שאמרתי לפניך בלילות כדא ונגינותי גנגןכל ימי חיינו על בית יי בלילה זו לילה וליכוי של פרעה לילה אותו שכתו בו ייהי בחצי הלילה ויי הכה כל בכור בארץ מצרים זו לילה ולילו של גדעון לילה אותו שנתוב כו ויהיבלילה ההוא ויאמר יי אליו קום רד במחנה זה לילה ואותו של סנחריכ כילה שכתוב בו ויהי בלילה ההוא ויצא מלאך יי ויך במחנה אשור אזכרה נגינתי בלילה עם לבבי אשיחה משתעיא אנא עם לבבי ומכשפשה בעובדי ואמ הלעולמים יזנח יי חם ושלום לאשבק ולאשביק ההד כילא יזנחלפולם יי ולאיוסיף לרביתעוד י לשעבר לרצות ולאלרבות לשעבר היזת מרצה אחרים בשבילי ועכשו לא לרצות ולא לרצות משה כעס ואתה אמרת לו לך שוב אל המחנה אליהו כעס ואתה אמרת לו לך שוב לדרכך מדברה דמשק ועכשו לא לרצת ולאלרצות א האפס לנצח חסדו גמר אמר לדור ודור האפס לנצח קסרו מהו האפס אמ ר ראובן לשון יוני הוא כדא האפכ הניח גמר אמר לדור ודור ר חננא בר פפא ור סימון ר חיננכא אמ נגמר אותו דבר שאמרת למשה בסיכי וחנותי את אשר אחון ורחמתי את אשר ארחם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_154r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_154r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_154r_1"
   }
  ]
 },
