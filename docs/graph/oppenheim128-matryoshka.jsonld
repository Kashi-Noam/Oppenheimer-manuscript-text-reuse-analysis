 {
  "@id": "http://example.org/oppenheim128#unit_fol_152r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "דא אמ להם אם הורג אני אתכם עכשויהיו המצריים אומ כת של בחוריםראה ואמ אלו אחי ואחד כך מצא עליהם עלה והדגן דא אמ להם אם הורג אני אתכם עכשו יהיו המצריים אומ עם אחיו לא שמר אמונה ועמנו ישמור אמונה לפיכך וינחם אותם וידבר על לבם והרי הדברים קל וחומר ומה אם יוס שדבר על לבם שלאחיו דברים טובים דברים נחומים נתיישב לבם כשיבא הקבה לנחם את ירושלם על אחת כמה וכמה שאמ נחמי נחמי עמי"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_152r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_152r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_152r_1"
   }
  ]
 },
