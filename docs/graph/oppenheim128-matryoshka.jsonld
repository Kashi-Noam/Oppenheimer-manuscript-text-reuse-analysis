 {
  "@id": "http://example.org/oppenheim128#unit_fol_104v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "את אפר הכרה אלו גליותיהם של ישראל והניח מחוץ למחנה במקום טהור זה ירושלם שהיא טהורה והיתה לעדת בני ישראל למשמרת לפי שבעולם הזה יש מטמאין ומטהרין על פיכהן אבל לעתיד לבא הקבה עתיד לטהרן מאי טעמ שנ וזרקתי עליכם מים טהורים וטהרתם הקץ הזה לכם עשה ירח למועדים שמש ידע מבאו אמר יוחנן לא נברא להאיר אלא גלגל חמה שנ יהי מאויות מארת כת אם כן למה נבראת לבנה אלא לחדש בו חדשי וראשי שנים ר שילא אמ דככר תמרתא בשם ר יוחנן אעפנ שמי רנמכאויי מיכא שאן מונין ללסה ילו זם נ ש שקעה החמה יום טיחברא בשם ר ברכיה אמ כת ויסעו מר עמסס בחדש הראשון בחמשה עשריום אם ללבנה אתה מונה עד כאן לית לן בה אלא ארבעה עשר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_104v_1#u1"
   }
  ],
