 {
  "@id": "http://example.org/oppenheim128#unit_fol_74v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "הן אל ישגיב בכחו ומי כמהו מורה אמ ר ברכיה לשון יוני הוא ומהו ישגיב בכחו שהוא מעצים כחן של צדיקים שיעשו רצונו ומי כמהו מורה שהוא מורה לחטאים דרך שיעשו תשובה לפיכך הושע מזהיר את ישראל ואומ להם שובה ישראל עד יי אלהיך נווב וישר יי על כן יוכה חטאים בדרך שאלו לנבואה החוטא מה הוא עונשו אמרה להם הנפש החו החוטאת היא תמות שאלו לתורה החוטא מה הוא עונש אמרה להם יביא אשם ייתכפר לו שאלו להקבה החוטא מהו עונשו אמ להם עושה תשנבה ומתכפרר לו ההד טוב וישר יי על כן יורה חטאים בדרך אמ ר פנחס למה הוא טוב שהוא ישר ולמה הוא ישר שהוא טוב על כן יורה חטאים בדרך שהוא מורה לחטאים דרך שיעשו תשובה לפיכך הושע מזהיר לישראל ואומלהם שובה ישראל"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_74v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_74v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_74v_1"
   }
  ]
 },
