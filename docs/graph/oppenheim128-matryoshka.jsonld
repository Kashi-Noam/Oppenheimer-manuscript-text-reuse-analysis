   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "דא במלך שלמה במלך שהיא שעושה שלום לבריותיו אמ ר יוחנן כת המשר ופחד עמו עושה שלום במרומיו אמ ר יעקב דכפר חנן המשל זה מיכאל ופחד זה גבריאל עמי י מושלמים לו פא זה מזיק את זה ולא זה מזיק אתזה אמ ר יוחנן מימיה לא ראתה חמה פגימתה של לבנה ולית מזל קדים לחבריה ולית מזלחזי מאי דקמוי אמ ר לוי כלהון סלקיכהדין דסליק בסולמא הפיך כת המקרה במים עליותיי תאני ר שמעין בן יוחאי הרקיע של מים והכוכבים שלאש והם דרים זה לום זה ואינן מזיקין זה את זה אמ ר אבין לאסוף דבר אין בין מלאך למלאך אלא אפי במלאך עצמו הוא עשה שלים בו ואית בו חמש אפין ההד וגויתו כתרשיש כתוב ויהי ברד ואש מתלקחת ר יהודה ור נחמיה ד יהודה של צרלוחיתשלביד מלאותאש"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_85r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_85r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_85r_1"
   }
  ]
 },
