 {
  "@id": "http://example.org/oppenheim128#unit_fol_95v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   },
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Torah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "זה כת בו נער וזה כת יצו יקטן זריכת בו נער שנ והוא נער את בני בנהה וזה כת בוקנן שנ הנה קנון קטן נתתיך בגוים בזוי אתה מחד זה גדל בין שניב ולא עשה כמעשיהם וזה גדל בין שני רשעים ול עשה כמעשיהם יבא זה ויפול ביד זה זה חס עלל כבוד קונו וזה בזה כבוד קונו יבא זה ויפל על זה כ זה כת בו ולא ירא אלהים וזה כת בו את האלהים אני ירא יבא זה ויפול ביד זה והיה בהניח יי אלהיך לך מכל אויביך מסביב אמ ר עז ור יודן בר סימון בשם ר יהודה בר אלעאי עלג דברים נשצטוו ישראל בכניסתן לארץ למנות עליהם מלך ולבנות להם בית הבחירה שנ ועשו לי מקדש ונמחו את זכר עמלק שנ תמחה את זכר עמלק מתחת השמים ר יהושע בן לוי בשם ר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_95v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_95v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_95v_1"
   }
  ]
 },
