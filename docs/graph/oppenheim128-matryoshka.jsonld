 {
  "@id": "http://example.org/oppenheim128#unit_fol_30v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אלה בני עשו ואלה אלופיהם את מוצא שלשה עשר אלופים כתובים כאן כנגד שלשה עשר שבטים בני יעקב שכן כתוב אפרים ומנשה כראובן ושמעון יהיו לי וכשם שאתה מוצא בבני יעקב שהם ארבעה עשר עם יוסף ואינן עולין אלא למנין שלשה עשר שבטים כן אתה מוצא באלופי בני עשו שהם ארבעה עשר ואינן עולין אלא למנין שלישה עשר שאותו קרח אלוף אליפז הוא אלוף קרח שלבני עשו ללמדך כמה שכד גדול פרע הקבה לעשו על שכבד אביו ואלמלא לא יצא לתרבות רעה היה שוה ליעקב בכל הוא אדום הוא ברשעו מתחלה ועד סוף וימת בלע וימלוך תאתיו יובב בן זרח מבצרה ההד מי זה בא מאדום חמוץ בגדים מבצרה מהו מי זה לעתיד לבא הולך הקבה לעשות נקמה באדום הוא בעצמו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_30v_1#u1"
   }
