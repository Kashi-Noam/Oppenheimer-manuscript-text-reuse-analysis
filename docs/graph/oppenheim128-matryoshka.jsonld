 {
  "@id": "http://example.org/oppenheim128#unit_fol_148v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "שמנים אלף פרחי כהונה והרגם עליו עד שהגיע דמן לקברו שלזכריה ההד פרצו ודמים בדמים נגעו ועדין הדם תוסס בההיא שעתא נזף ביה נבוזר ארן אמ ליה מה את בעי דתיבד כל אומתך עלך באותה שעה נתמלא הקבה רחמים ואמ ומה אם זה שהוא בשר ודם אכזרי נתמלא ראמים על בני אני שכתוב בי כיםל רחום יי אלהיך על אחת כמה וכמה באותה שעה כמז הקבה לדם ונבלע במקול ככסך היה לסצים בראשונה היו משתמשי י במטבעות שלכסף משרבו הרמאים התחילו שהיו משתמשן במנובנת של נחשת מחופים כסף והוה חד מנהון אזיל לגבי צרפא ושמע קללה אמר לברי בייתיה הנחש ליה אף הוא אזל למזבן קסנ דחמר מן גו קפילא ושמרג קלא אמר לברבייתיה המהד ליה ההד כספך היה לסיגים סבאך מהלבמים"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_148v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_148v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_148v_1"
   }
  ]
 },
