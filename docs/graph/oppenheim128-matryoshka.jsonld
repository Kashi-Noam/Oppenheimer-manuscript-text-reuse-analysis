 {
  "@id": "http://example.org/oppenheim128#unit_fol_102r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ומי יודע כשר דבר שפשר דבריתירה לישראל חכמת אדם תאיר פניו ר מני דשאב ור יהושע דסכני בשם ר לו יאמ על כל דבר ודבר שהיה הקבה אומר למשת היה אומ לו טהרתו וטומאתו וכיון שהגיע לפרשת אמוראל הכהנים אמ לפני הקבה רבונו של עולם אם נטמא במה טהרתו ולא השיבו באותה שעה נתכדכמי פניו של משה ההד ועח פניו ישנא וכיון שהגיע לפרשה הזאת של פרה אמ לו הקבה משה אותה האמירה שאמרתי לך ולא השיביתיך והיא פרשת אמיר אל הכהנים ואמ לפני רבונו שלעולם אם נטמא במה היא טהרתו אלא זו היא טהרתו שנ ולקחו לטמא מעפר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_102r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_102r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_102r_1"
   }
  ]
 },
