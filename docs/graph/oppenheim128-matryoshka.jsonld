 {
  "@id": "http://example.org/oppenheim128#unit_fol_4v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Mishnat_Rabbi_Eliezer"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Mishnat_Rabbi_Eliezer"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "שבאללמד ונמצא ו כיצד כחדוח אש המסים מים תבינק עדק לא שמענו במעשה םאשי שליהטה האש אי יפני הרקיע וכשרואגא במחן תורה יקינת שמים בשם שעשית הנשה בדאשית כך עשיהי נשדצומה מלמד שב שבשעה שאמ הקבה יהי רקיע בתיך המים וכבר נבראו מיום ראשון אלא שלאהיו מצוחצחות עד שיצאה האש מלמעלה וליחנה את פני הרקיע בא מעשה ברא בראשית ללמד על מתזתורה ונמצא למבממנו כיוצא בו אתה אומ קולה כנמש ילך כשם שמהלך הולו שלנחש מהלך קולה שלמצרים מלמד שכשאמ הקבה לנחש על גחולך תלך ידדג מלאכים בקצצו ידיו ורגליו והיה קולו הולך מסלף העולם ועד סופו בא נחש ללמד על מפלתה שלמצרים ונמצא למד ממנה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_4v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_4v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_4v_1"
   }
  ]
 },
