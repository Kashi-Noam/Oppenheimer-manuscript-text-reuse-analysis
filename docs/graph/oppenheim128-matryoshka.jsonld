 {
  "@id": "http://example.org/oppenheim128#unit_fol_59v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמרו חכמים הוירך כקנה ואל תהי קשה כארז כיצד מכבד אדם את רבו בזמן ששניהם מהלכין בדרך יותנו לימין ואיזנותנו נסמם היו שלשה תלמיד וחכם והרב ביניהם הרב הולך באמצע והגדול בימינו והקטן לשמאלו וכן מצינו בשלשה מלאכים שבאו אצל אברהם אבינו ואלו הן גבריאל ומיכאל ורפאל גבריאל בא להפוך אתסצום ואת עמורה רפאל בא לרפאת את אברהם מיכאל בא לבשר את שרה והיה מיכאל באמצע וגבריאל בימינו ורפאל בשמאלו וכיון שראה אברהם אבינו את מלאכי השרת באתה שכינה ועמדה למעלה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_59v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_59v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_59v_1"
   }
  ]
 },
