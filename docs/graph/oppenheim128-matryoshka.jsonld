  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-12"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Midrashim, Smaller' (M. D. Herr), on Jewish Virtual Library: Midrash Aggadah was 'compiled apparently in the 12th century' and published from the Aleppo manuscript by S. Buber (1894)."
   },
   {
    "@value": "Wikipedia (English), 'Midrash Aggadah': Dated to around 1020–1220 CE and associated with R. Moses ha-Darshan (Provence); found in a unique Aleppo manuscript."
   },
   {
    "@value": "Sefaria, 'Midrash Aggadah' (About This Text): Composed 'c.1020 – c.1220 CE', most likely in the 12th or 13th century, in medieval France."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "The 12th-century date (EJ) is broadly accepted, though Sefaria gives a range of c. 1020–1220 and suggests the 12th–13th century; the place of composition (Provence/France, through the Moses ha-Darshan link, or elsewhere) is not settled."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "קשור לחוג ר' משה הדרשן (נרבונה); ספריא: צרפת של ימי הביניים; כתב היד היחיד נמצא בחלב"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Aggadah_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Aggadah_end"
   }
  ]
 },
