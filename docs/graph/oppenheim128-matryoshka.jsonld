 {
  "@id": "http://example.org/oppenheim128#unit_fol_168v_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "בגדי ישע בזכותו של יעקב י דנת ביה ואת עורות עורות גדי העזים הלבישה על ידיו מעעיל בדקה יעטני בזכותו שלאברהם דכת ביה כי ידעתיו למען אשריצוה את בניו ואת ביתו אחריו כחתן יכהן פאר וככלה תעדה כליה בעשרה מקומות נקראו ישראל כלה ששה על ידי שנמ וא על ידי ירמיה וג על ידי ישעיהו ששה על ידי שלמה דכת אתי מלבנון כלה באתי לגני אחתיכלה גן נעול אחתי כלה לבבתיני אחתי כלה מה יפו דודיך אחתי כלה נפת תטפנה שפתיתיך כלה ואחת על ידי ירמיה קול ששון וקול שמחה קול חתן וקולכלה וגעל ידי ישעיה כי כדם כעדי תלכשי ותקשרים בכלה ומשוש חתן על כלה והדין וכבלה תעדה כליה כנגד מי נאמרו כנגד עשרת הדברות ששמעו ישראל בסיני והיו מצמצבמין את עצמם ככלה וכנגדן לבש הקבה עשרה לבושין כדי להפרע מאומות העולם שהם מעכבין את ישראל מלקיים עשרת הדברות לבוש הראשון נשלבש בשעה שברא את עולמו בה דר שמו שנ הוד והדר לבשת לבוש השני שלבש גאות שמו כדי להפרע מז דור המבול שנ יי מלך גאות לכש לבוש השליש שלבש בשעת מתא תורה לישראל עוז שמו שנ לבש יי עון התאזר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_168v_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_168v_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_168v_2"
   }
  ]
 },
