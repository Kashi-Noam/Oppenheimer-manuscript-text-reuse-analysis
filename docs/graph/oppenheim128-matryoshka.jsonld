   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "לא ישלח אדם לחברו חבית שליין ויתן על פיה שמן שוו דרך המיתה ומעשה באדם אחוד שעשה משתה לבנו כיון שבאו בני חבורה והסבו נכנס להביא יין ראה את החבית שהיא מלאה שמן וחנק את עצמו מכאן אמרו חכמים אל ישלח אדם לחברו חביה שליין ויתן עלפיה שמן שזו דדך המיתה לא אמר אדל לחברו טול שמן מפך ריקן מפני שמהנהו טובת חנם ולא יסרב אדם לחב לסעוד ויודע בו שאינו סועד ולא ירבה לו בתקרובת ויודע בו שאינו מקבל לא ישקה אדם יין ישן לשום חדש שזו דרקך גזל היה משקה יין לחמיים אל יאמר להם סלקו את זה ותנו לזה שחה דרך הגזל היה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_63r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_63r_1_u1_selector"
   }
  ],
