 {
  "@id": "http://example.org/oppenheim128#unit_fol_178v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Lekach_Tov_on_Lamentations"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Lekach_Tov_on_Lamentations"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "משנכנס אב ממעטק בשמחה ט באב שרל להיות בשבת אסורין לספרד ולכבס ובחמשי מותרין מפני בבוד השבת קודם תענית אסור לאחר תענית מותר ערב טבאב לא יאכל אדם ב תבשילין ולא יאכל בשר ולא ישתה יין אמ רב יהודה אמ רב כך היה מנהגוי שלר יהודה בר אלעאי ערב ט באב היה צשב בין הנור וכירים ומביאין לו פת חריבה ואוכלה במלח ושותה עליה קיתון שלמים ודומה כמי שמתו מוטל לחננו והלכה ט באב שחל להיות בשבת אוכל ושי ושותה כל צרכו ומעלה על שלחנו אפי כס עודת שלמה בשעתה תנו רבנן מקום שנהגו לעשות מלאכה בט באב עושן ומקום שנהגו שלא לעשות אין עושין בכל מקום תלמידי חכמים בטלים רבן שמעון בן גמליאל אומ יעשו כל אדם ערצמם כתלמידי חכמים וכל העושה מלאכה בט באב אינו רואה ממנה סימן ברכה לעולם וכל האוכל ושותה בט באב"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_178v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_178v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_178v_1"
   }
  ]
 },
