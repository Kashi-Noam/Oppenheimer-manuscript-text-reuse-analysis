 {
  "@id": "http://example.org/oppenheim128#unit_fol_55r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "זו שאלה שאל ר יוסי בן תדאי איש טבריא את רבן גמליאל מה אשתי שאני מותר בה אני אסור בבתה אשת איש שאני אסור בה אינו דין שאהא אסור בבתה אמ לו צא ופרנס לי כהן גדול שכהוב בו כי אם בתולה מעמיו יקח אשה ואני אפרנס לך כל ישראל דבר אחר אין דנין לעקור דבר מן התורה ונדהו רג כל האסורות לו איסור ערוה ובא עליהן לא פסלן מן הכהנה נדה אעפ שחייב על ביאתה הולד כשר להיות עומד ומקריב על גבי המזבח הנבעלת ממי שאינו איש אעפ שחייבת כרת לא פסלה מן הכהנה אמ ר יוסי מעשה בריבה אחת שהיתה מכבדת הבית ובא הקוף ובעלה מאחריה ובא מעשה לפני חכמים ולא פסלוה מן הכהנה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_55r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_55r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_55r_1"
   }
  ]
 },
