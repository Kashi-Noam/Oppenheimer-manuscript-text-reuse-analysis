 {
  "@id": "http://example.org/oppenheim128#unit_fol_90v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Torah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Torah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "את ישראל בכל שעה אמ ר יהודה בר סימין משל לאחד שהיה יושב ועושה עטרה עבר אחד וראה חותו ואמ לו מה אתה עושה אמ לו עטרה למלך אמ לו כל מהד שאתה יכול לקבוע בה קבע אזמרגדים אבנים טובות ומרגליות שהיא עתידה להנתן בראשו של מלך כך אמ הקבה למשה משה כל מה שאתה יכול לשבח את ישרש לפני שבח לפארן פאר שאני עתיד להתפאר בם שנ ויאמר אלי עבדי אתה ישראל אשר בך אתפאר לפקודיהם אמ ר יהושע בר נחמיה אמ הקבה למשה מנה את ישראל אמ משה לפני הקבה רבונו של עולם כת והיה זרעך כעל הארץ והרביתי את זרעך ככוכבי השמים ואומ והיה מספר בני ישראל כחול הים אשר לח ימד ולא יספר ואתה אומר לי מנה את ישראל אמ לו הקבה משה לא כשם שאתה סבור אלא אם בקשת לעמוד על מנינם של ישראל טול ראשי חותיות של שבטים ואתה עומד על מניינם ר דראובן"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_90v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_90v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_90v_1"
   }
  ]
 },
