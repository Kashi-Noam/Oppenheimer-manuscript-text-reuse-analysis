  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-3 (זלוטניק) או אמצע המאה ה-8 (ברי\"ל)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Yale University Press, D. Zlotnick, The Tractate 'Mourning' (Semahot) – book description: The tractate is 'dating probably from the third century'."
   },
   {
    "@value": "Wikipedia (English), 'Evel Rabbati' (citing Brüll): Originated in the Land of Israel; took its present form probably in the mid-8th century, if not later; expanded in Babylonia in the Geonic period."
   },
   {
    "@value": "Jewish Encyclopedia (1906), 'Semaḥot' / 'Ebel Rabbati': Originated in Palestine; took its present form probably in the middle of the 8th century (Brüll), if not later."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Zlotnick (Yale Judaica) dates it probably to the 3rd century, while Brüll (followed by the Jewish Encyclopedia) holds it took its present form in the mid-8th century or later and was further expanded in Babylonia."
