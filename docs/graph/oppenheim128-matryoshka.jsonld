 {
  "@id": "http://example.org/oppenheim128#unit_fol_29v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma_Buber"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma_Buber"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מנשמת אלוה יאבדו איבד הקבה את כלן במצריים אומ נשפת ברוחך כסמו ים שאגת אריה וק שחל אף כל הרשעים העתידים לעמוד כן יאבדם הקבה אמ לו איוב אם כן הסתכל בעשו אביך אמ לו אין לי עמו עסק שנ בן לא ישא בעון האב ההד ליש אובד מבלי טרף ובני לביא יתפרדו לו אלופיו אמ לו איוב ואת מה אמ לו ואלי דבר יגמב ותקח אזני גו אני נציא אני אין לי עסק עמו אכא להוכיחך בסעפים מחזיונות ההד בסעפים מחזיונות לילה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_29v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_29v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_29v_1"
   }
  ]
 },
