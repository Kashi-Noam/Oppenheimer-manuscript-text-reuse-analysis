 {
  "@id": "http://example.org/oppenheim128#unit_fol_144r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ואיני מקבלת שכד אלא על אחת מי גרם לי שאהא משמרת שני ימים טובים בסוריא על שלא שמרתי יום טוב אחד כתקונו בארץ ישראל סבוהה הייתי שאני מקבלת שכר על שנים ואיני מקבלת שכר אלא על אחד ר יוחנן הוה קר עליהון וגם אני נתתי להם חקים לא טובים ומשפטים לא יחיו בהם הה אמר יי מה מצאו אבותיכם בי עול אמ הבה לישראל אבותיכם לא מצאובי עול ואתם מציתם ביעל אום החשן לא ימצח בי על ואתם יצאת ביעיל למה היה אדם הראשון דומה לחחולה שנכנס אצכו רופא אמ לו דבר פלכי אכול ודבר פלני לא תאכל וכיון שעובר על דבריו גורם מיתה לעצמי נכנסו קרוביו אצלו אמרו לו תאמר שהרופא עבר עליך מדת הדין אמ להם חס ושלום אני הוא שגרמתי מיתה לעצמי כך וכך צוני הרופא ואמ לי דברפלני אכול ודבר פלני לא תאכל וכיון שעברת על דבריו גרמתי מיתה לעצמי"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_144r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_144r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_144r_1"
   }
  ]
 },
