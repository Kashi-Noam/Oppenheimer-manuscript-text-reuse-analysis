  "@id": "http://example.org/oppenheim128#unit_fol_4r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Mishnat_Rabbi_Eliezer"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Mishnat_Rabbi_Eliezer"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מדבר שהא שנוי כיצד אמ ר יוסי בר חנינא ארבעי ושתים שנה היה הרעב כאוי לבא במצרים שכין פרעה רואה שבע פרות ושבע שבלים הרי יד והוא אומר וליוסף שבעפכות ישבע שבלים הרי לח וייסף חוזר ואות שבעפרות ושבע שבלים ודי שם קרער אלא שתי שנים שכ מב ולח על עיהב נמצרים בלה היוב שירד הרלכאוי ואמתי הורו אינן מב שנה ביהי יאזקאל יונד כי זה שנתם נתתי ארן מוצרים שחמה יארבעים שנההיתה כך ולא עשתה אלא לצורך כינוצא בר בר איבה אומי א תבטחו לכם גו לי רנאמ שלשפעמים אמ להם אל בניחו שלש פעמים שזם אנכ עישים רצונו שלמע אין שלש חגיכם כלום וכן הואאומ חדשיכם ומועדיכל שלאה נפשי ואומ שנאתי מאסתי חגיכם דבר חחר אמ להם דאו שלש פעמים מקדשנם שחרב נב וגבעון שילה הזהרו שלא יארב גם זה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_4r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_4r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_4r_1"
   }
  ]
 },
