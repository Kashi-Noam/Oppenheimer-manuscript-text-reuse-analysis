  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica, 'Leviticus Rabbah' (Joseph Heinemann), on Encyclopedia.com: 'Probably composed in the fifth century in Palestine'; Margulies holds that it is contemporary with Pesikta de-Rav Kahana and Albeck that it is somewhat later."
   },
   {
    "@value": "Wikipedia (English), 'Leviticus Rabbah': Originated in the Land of Israel; Zunz dates it to the mid-7th century, while the EJ and Neusner date it to the 5th century."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Most scholars (EJ, Neusner) put it in the 5th century and Zunz in the mid-7th; Margulies holds that it is contemporary with Pesikta de-Rav Kahana and perhaps by the same author, while Albeck puts it somewhat later."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "מדרש אמוראי ארץ-ישראלי"
   }
  ],
