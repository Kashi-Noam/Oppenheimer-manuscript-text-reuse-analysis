 {
  "@id": "http://example.org/oppenheim128#dating_Jerusalem_Talmud",
  "@type": [
   "http://example.org/oppenheim128#DatingAssertion",
   "http://www.w3.org/2006/time#ProperInterval"
  ],
  "http://example.org/oppenheim128#confidence": [
   {
    "@id": "http://example.org/oppenheim128#conf_high"
   }
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@value": "0370/0450"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_c6b40b05d4"
   },
   {
    "@id": "http://example.org/oppenheim128#source_8a8cc8bba2"
   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_02"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "סוף המאה ה-4 – מחצית ראשונה של המאה ה-5 (כ-400)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Talmud, Jerusalem', on Jewish Virtual Library: Redacted at about the time of the latest amoraim, about 400 CE, usually assumed in Tiberias; Lieberman: Nezikin compiled in Caesarea c. mid-4th century; the Tiberias school ended with the patriarchate in 421."
   },
   {
    "@value": "Wikipedia (English), 'Jerusalem Talmud': Compiled between the late fourth century and the first half of the fifth century, probably in Tiberias, with teachings of the schools of Tiberias, Caesarea and Sepphoris."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Redaction is generally put c. 400 in Tiberias, but Lieberman argued that tractate Nezikin was compiled in Caesarea about 350; Sussmann sees it instead as an earlier stage of the same tradition."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "כנראה טבריה (עם חומר מציפורי וקיסריה); נזיקין אולי בקיסריה, אמצע המאה ה-4 (ליברמן)"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Jerusalem_Talmud_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Jerusalem_Talmud_end"
   }
  ]
 },
