 {
  "@id": "http://example.org/oppenheim128#unit_fol_170r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "והנה הכושי בא ויאמר הכושי יתבשר אדני המלך ויאמר המלך השלום לנער לאבשכום ויאמר הכושי יהיו כנעד אייבי אדני המלך וירגז המלך ויעל על עלית השער אמ ר חננא בד יצחק ומן לטוביירים ודקרו אותו והרי דברים קל וחומר ומה אחימעץ בן בדוק שלא על בן המלך לא טובה ולא רעה ר זכה לכל הכבוד הזה מי שהוא עלמד סניגוריא על ישראל על אחת כמה וכמה תדע לך שהוא כן שכל ימיו שלמשה לא נקרא איש האלהים עד שבי רך לישראל שנוזאת הברכה אשרברך משה איש האלהים מגע בר ירבוהו לאם וברכה לראש משביר מונע בר בעת צרה יקבוהו לאם יעשה ארירה לאומות וברכה לראש משבר זהו המשביר בעת צרה דא מונעבר זהו שמונע ברה שלתורה ירבוהו לאם יעשה אריכה לאומות וברכה לראש משביר זה המלמד תורה בעין יפה דא מונעבר זה בלעם הרשע שמנע ברכות לברך את"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_170r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_170r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_170r_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#dating_Ein_Yaakov_Glick_Edition_end",
