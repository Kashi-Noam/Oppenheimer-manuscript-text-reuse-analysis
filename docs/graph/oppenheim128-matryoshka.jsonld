 {
  "@id": "http://example.org/oppenheim128#unit_fol_131v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ר יוסי אומ ונ וחמשים עלו בני ישראל לה דורות עלו שנ ובני ישראל פרו וישרצו וירבו ויעצמו במאד מאד תרין אמיראין חד אמ אם לגדול שבשרצים אתה מדמה אותם הא עכברא ילדה שתא ואם לקנן שבשרצים אתה מדמה אותם הא עקרבא ילדה שתין רקק משה חת עצמית יוסף עמו להודיע בבזה ומשה היה עסוק בעצמות יוסף ההד ויקחמשה שבחו של משה שכל ישראל היו עסוקים את עצמרת יוסף עמו מהו עמו עמו למחנה לויה ומי הודיע למשה היכן יוסף קבור אמרו רבותינו סרח בת בת אשר היתה שם באותו הדור אמרה למשה בנילום הנהר יוסף קבור הלך משה מיד ועמד על שפת נילום ואמ יוסף יוסף הגיעה השעה שהקבה טאל את בניו השכינה מעכבת לך וכל ישראל"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_131v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_131v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_131v_1"
   }
  ]
 },
