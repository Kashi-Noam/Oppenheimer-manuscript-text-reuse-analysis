   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מבטח כל קצוי ארץ אתה הוא בטחונם שלכל העולם וזרועותם בשמך הם בוטחים יוצחי דרכים בשמך הם בוטחים יורדי הים בשמךהם בוטחים שנ יים רחוקים ר חננא ברפפא אמ שאל את רשמאל בר נחמן אמליה מרו רין דכת וים רחוקים אמ ליה נמשלה תשובה בים מה הים לינלם פתיא כך תשובה לעולם פתוא נמשלה תפלה במקוה מה המקוה הזה פעמים פתור ופעמים נעול כך שערי תפלה פעמים פתוחים ופעמים נעולים מה המקוה הזה אדם מבקש לטבול בו ומצא אביו או רבו שם מתבייש והולך לו אבל הים מפליג קימעיא ויורד וטובל ר ברכיה ור חלבו בשם רב ענן בר יוסי אמ שערי תפלה לעולם פתוחין ואתיא כי האי דמרי ר יוסי בר חלפתא שאמ עתים הם לתפלה ובא דויד ופירש דכת ואני תפלתי לך יי עת רצון אלהים ברב חסדך ענני באמת ינ ישעך תאנה בשם ר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_73r_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_73r_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_73r_2"
   }
  ]
 },
