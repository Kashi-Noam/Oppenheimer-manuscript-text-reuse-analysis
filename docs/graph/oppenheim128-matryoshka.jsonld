  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "אמצע המאה ה-6 בערך"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Song of Songs Rabbah', on Jewish Virtual Library: 'The work was apparently redacted in Ereẓ Israel about the middle of the sixth century C.E.'"
   },
   {
    "@value": "Wikipedia (English), 'Song of Songs Rabbah' (Jewish Encyclopedia-based): The date cannot be fixed exactly; it is later than Pesikta de-Rav Kahana (Theodor) and older than Pesikta Rabbati, hence 'around the end of the 8th century'; Simon Duran calls it a 'Judean aggadic collection'."
   },
   {
    "@value": "Posen Library, 'What Is Song of Songs Rabbah?': 'Final redaction sometime between the sixth and eighth centuries CE', with a largely Palestinian perspective."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "EJ dates it to about the mid-6th century (its table: 500–640), the Posen Library to between the 6th and 8th centuries, and the Jewish Encyclopedia-based Wikipedia article to the end of the 8th century (reasoning that it predates Pesikta Rabbati, c. 845)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "מדרש אמוראי ארץ-ישראלי"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Shir_HaShirim_Rabbah_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Shir_HaShirim_Rabbah_end"
   }
  ]
 },
 {
