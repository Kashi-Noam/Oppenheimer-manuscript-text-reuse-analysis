   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "לעולם תהא נאה בכניסתך ונאה ביציאתך ותהא ממעט בעסה ועסוק בתורה מעשה בר שמעון בן אלעזר שבא ממגדל עדר מבית רבו והיה רכוב על החמור ומטייל על שפתהים ומצאו אדם אחד שהיה מכוער ביותר אמ לו ריקה כמה מכוערין בניו של אברהם אבינו אמ לו ומה אעשה לך לך ואמור לאומן שעשאני מיד ירד רשמעין בן אל עזר מן החמיר ונשתלוח לפניו ואמ לו נעניתיל מחול לי אמ לו אין אני מוחל לך עד שתלך לאומן שעשאני ותאמר לו כמה מכועגר כלי זה שעשית הלך אחריו חצי מיל שמעו בני עירו ויצאו לקראתו אמיו לו שלום עליך ר אמ להם למי אתם קורין ר אמרו לו לזה שמטייל אחריך אמ להם אם זה ד ל ירבו נ וותה בישראל אמרו לו חס ושלום ומה עשה לך אמ להם כןך וכך אמ לי אמרו לו אעככ מחול לו אמ להם מהול לו הריני מוחל לו ובלבד שלא יהא רגיל לומר כן"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_59r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_59r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_59r_1"
   }
  ]
 },
