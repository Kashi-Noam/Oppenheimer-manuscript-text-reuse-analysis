 {
  "@id": "http://example.org/oppenheim128#activity_matryoshka_2026_11",
  "@type": [
   "http://www.w3.org/ns/prov#Activity"
  ],
  "http://www.w3.org/2000/01/rdf-schema#comment": [
   {
    "@language": "he",
    "@value": "מבחנים: תוספות/השמטות, סדר יחידות סמוכות, הסכמה בנוסחאות, גבולות יחידה. ציון ישיר = מילים באופנהיימר ובישן שחסרות בחדש + 3×סדר + 2×גבולות + 0.5×נוסחאות. ציון דרך החדש = מילים באופנהיימר ובחדש שחסרות בישן + 0.25×השמטה משותפת + 3×סדר + 2×גבולות + 0.5×נוסחאות. הכרעה: ציון ≥4, כפול מהשני, ולפחות ראיה חיובית אחת."
   }
  ],
  "http://www.w3.org/ns/prov#used": [
   {
    "@id": "http://example.org/oppenheim128#act_report_288c1011"
   }
  ]
 },
