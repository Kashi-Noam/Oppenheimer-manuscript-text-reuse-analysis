 {
  "@id": "http://example.org/oppenheim128#unit_fol_195v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "איכה היתה לזונה ירמי אמ בכה תבכה בלילה ורוח הקדש אומ הנה שם יושבות מבכות את התמוז ירמיה אמ גלתה יהרה מענ ורוח הקדש אימ ותגל אינתזנותיה ירמיה אמ דרכי ציק אבלות ורוח הקדש אומרת על דרכים ישבת להם כערבי במדבי ירמיה אמ היו צריה ליאש ורוח הקדש אומ להם ואת למדת אותם עליך אלופים לראש לדתי עם אמ רבא אמר יוחנן שהיו משאזקטנה לגדל לגדול וגדולה לקנן כדילרבות העם היתה כאלמנה יאמי רב יהורה כאלמנה ולא אלמנה ממש כאשה שהלך בנכה למדינת הים ודעתו לחזור עליה ועוד אמ משל למלך שכע על מטרונה וכתב לה גינה ועמד וחטפ ממנה וכל זמן שהיתה מבקשת להנשא אומ לה היסן ביטיך שגרשתיך וכל זמן שהיקה מבקשת ותובעת בתכתה אומר לה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_195v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_195v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_195v_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_199v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Torah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "זה יי קוינו לו נגילה ונשמחה בישועתו ות ברך שמי של מלך מלכי המלכים קבה שבחר בישראל מע אומות ועשאם סגולה לעצמו וקראם בנים לעצמי וקראם עבדים לעצמו וכל זמן שעושין רצונו נקראו לו בנים שנ בנים אתם ליי אלהיכם ובזמן שאק עושין רצונו של מקום נקראו אחרים שנ כיהם לא עמי ולא עוד אלא כל זמן שעושין רצונו מלאכתן נעשית על ידי אחרים שנ ועמדו זרים ורעו צאנכם ובזמן שאין עושין רצונושל מקום מלאכתא נעשית על ידי עצמן של ואספת דגנך ולא עוד אלא שמלאכת אחרים כעשית על ידם שנ ועבדת את איביך"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_199v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_199v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_199v_1"
   }
  ]
 },
