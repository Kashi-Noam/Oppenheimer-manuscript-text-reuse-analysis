  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Jerusalem_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר זעירא בא וראה מה חצויפה היא ארץ ישראל שהיא עושה פירות גדולה תדין אמוראין חד אמ שהם מזבלים אותה וחרנה אמ שהן הופכין את עפרה בהדין רמה עיר סאתה מה דלעיל בחתליה לידע מה דלרע סליק ליה נרובדא הוה בחד בר נש והוה קים רדה בהדא בקעאתא דארבל ועשק סכתא ונפק חדא עפרא יקידא ואוקיד זרעיה אמ ר חיגנא בר פפא א מאות מיני דגים טהורים ושמנה מאות מיני חגבים ולעופות אין מספר וכלם גלו עם ישראל בבבל וכשחזרו כלם חזרו עמהם חוץ מן הדג הנקרא שיבוטא ודגים היאך גלו ר הונא בשם ר יוסף אמ דרך התהום חזרו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_141r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_141r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_141r_1"
   }
  ]
 },
