   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ויתן לשבי עזו זה ארון הבהת ותפארתו ביד צר אלו בגדי כהונה גדולה שנ ועשית בגדי קדש לאהרן אחיך לכבוד ולתפארת ר יהושע דסכני בשם ר לוי אחרי אתה נתת להם שבע כבשות חייך שהן עתידין להחריב מבניך זצדיקים לו הן שאול וג בניו ועלי וחפני וכנחם ואית ואמרי שמשון ולאעל אמ ר יהי בשם דסכני בשם ר חייא אמ לו הקבה לאברהם אתה נתת להם א כבשות חייך שהן עתידין להחריב מבניך ו עולמו ואלו הן אהל מועד וגלגר ושילה ונוב וגבעון ובית הע העולמים שנים אמר אלהים פן ינחם העם בראותם מלחמה ושבו מצרימה מה היית אמ על בני אפרים שעל שטיעו את הקץ כ שנה נפלו מה מאה ושמנים אלף ההד בני אפרים נושקי רומי קשת הפכו ביום קרב"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_131r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_131r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_131r_1"
   }
  ]
 },
