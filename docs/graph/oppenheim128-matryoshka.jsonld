   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "he",
    "@value": "ישיר: אופנהיימר קרוב יותר לעד הישן"
   },
   {
    "@language": "en",
    "@value": "Direct: Oppenheim closer to the older witness"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_179v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "תנו רבנן כשחכב הבית בראשונה פרחי כהונה שבאתו הדור נטלו מפתחות של בית המקדש בידם ועלו לינ ההיכל ואמרו לפני הקבה רבונו של עולם הואיל ולא זכינו להיות לפניך גזברים נאמנים הרי המפתחות מסורים לך וזרקום כלם מעלה ועאה נאנא נסתידי ונאולתא מנהל ומי הם קפינו וננא נתב לתוך האור ונשרפו ועליהם קונן ישעיה משא גיאחזיון מה לך איפה כי עלית כלך לונת תשואות מלאה עיד הומה ואף הקבה מקרקר עליהם כתרנוגלים של מקרקר קיר ושוע אל ההר תנו רבנן כשחרב הבית"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_179v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_179v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_179v_1"
   }
  ]
 },
