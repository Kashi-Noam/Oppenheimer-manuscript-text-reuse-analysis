 {
  "@id": "http://example.org/oppenheim128#unit_fol_104v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   },
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereishit_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "הזה לכם עשה ירח למועדים שמש ידע מבאו אמר יוחנן לא נברא להאיר אלא גלגל חמה שנ יהי מאויות מארת כת אם כן למה נבראת לבנה אלא לחדש בו חדשי וראשי שנים ר שילא אמ דככר תמרתא בשם ר יוחנן אעפנ שמי רנמכאויי מיכא שאן מונין ללסה ילו זם נ ש שקעה החמה יום טיחברא בשם ר ברכיה אמ כת ויסעו מר עמסס בחדש הראשון בחמשה עשריום אם ללבנה אתה מונה עד כאן לית לן בה אלא ארבעה עשר משתשקע החמה מכאן שזין מונין ללבנה אלא אם כן שקעה החמה ר עזריה בשם ר חנינא אמ לאנברא להאיר אנא גלגר חמה בלבד שנ יהי מאורות מארת כת אם כן למה נבראת לבנה אלא צפה הקבה שאומות העולם עתיד לעמו ולעשותן אליהות"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_104v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_104v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_104v_1"
   }
  ]
 },
