 {
  "@id": "http://example.org/oppenheim128#unit_fol_3r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "וחומד מפיוש כצד כיאת רגלים רצת וילאיך קל וחומה ואיב תתחרה את הסיסים כוצא בו ויאמר המלך לאכת המלכה בשישן הבירה הרגו גו קל וחומר בשאר מדינוה המלך מה עשו מק וחומר סתום ביצם נשבע להרע ולא ימי להרע הוא דלא יחליף אבל נשבעלה טיב יחליף וכר מה קשה על בני אדלי לעשות להרע ליגצמו או להיטב ום להרע לעגצמי אינו מנליף קל וחימר ליטיב לעצמו איזהו להרע לעצמו שמינר לו ענשות אמ ר"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_3r_1#u1"
   }
  ],
