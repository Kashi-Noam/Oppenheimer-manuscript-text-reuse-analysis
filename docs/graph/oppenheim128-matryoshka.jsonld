 {
  "@id": "http://example.org/oppenheim128#unit_fol_26r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_Rabbati"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_Rabbati"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ביניהם ר יוחנן אמ כותל ר חנינא אמ טפח ורבנין אמרין שתיהן שוות אמ ר לוי אמ הקבה לישראל בני אותן הקרבנות שכתבתי לכם בתורה הוו זהירין בהן שאין לכם פרקליט טוב לירידת גשמים יותר מן הק הקרבנות לפיכך הוצרך הכת לומר ביום השמיני עצרת תהיה לכם תם ונשלם תל עד אשר אבא אל אדני שעירה ההד ועלו מושיעים בהר ציון גו תני ר שמעון בן יוחאי מאי דכת וצים מיד כתי אלו אדומיים שעתידין לעמד באחרית הימים וכשהם יוצאין כגנבים הם באין והם עושים מלחמה עם בני ישמ עאל והורגין מהם הרבה וכד את חמי שלמאה מתכניש למישרא דעכו דע דאדק פרזלא לחספא ושקייה תברין לאצבעתא ומתחלטין במלכותא מנהון פטסקא מלכותא ורשיעתא תברת מן שעבידא וכד תחמי רומייה נפק בתקוף לאלכסנדריא דע די מטא קץ שלמאה מיתמסרא בידוהי דתורכייא ערט ערטילאין מן עכו ערקין בלא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_26r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_26r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_26r_1"
   }
  ]
 },
