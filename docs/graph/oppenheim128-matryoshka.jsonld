 {
  "@id": "http://example.org/oppenheim128#unit_fol_150v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ור נתן אמ שני נביאים בשחרית ושני נביאים בערבית השכם ושלוא בבקר השכם ושלוח בין הערבים דא מה אעידך כמה קשוטים קשנותי אתכם דאמר יוחנן ביום שירד הקבה לסיני ליתא תורה לישראל ירדו עמו םרבוא שכ מלאכי השרת וכל אחד ואחד מהם עטרה בידו לנטר לכל אחד ואח מישראל אמ ר אבא ברכהנא בשם ר יוחנן קכ רבוא כדי להלבישאן ענוה ענדה ואחד לאסרו זינו ר חננא רבא דמצנתרין אמ חינם כדא מוסר מלכים פתח ויאסר אזור במתניהם דא מה אעידך כמה בזות נתתי לכם בזת מצרים ובזת הים ובזת סיחון ועוג ובזת לא מלכים דא מה אעידך ויעודים ויעדתי לכם אהל מועד וגלגל ושילה ונב וגבעון ובית העולמים שנים ומה אדמה לך לאי זו אומה דמיתיאתכם איזו אומה גאלתי ככם ביד חזקה והבאתי על אויב עשר מכות ולאי זו אומה קרעציאת הים ולחיזו אומה הורדתי את המן ולאיזו אומה הגזתי את השלו ולאיזו אומה הקפתי ענני כבוד ולאיזו אומה קרבתי לכני הרסיני ונתכי להם את"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_150v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_150v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_150v_1"
   }
  ]
 },
