 {
  "@id": "http://example.org/oppenheim128#unit_fol_186r_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ועתיד הקבה להפכו לש לשמחה שנ כה אמר יי צבאות צום הרביעי וצום החמשי וצום השביעי וצום העשירי יהיה לבית יהודה לששון ולשמחה ולמועדים טובים ועתיד להכנים גליות שלישראל לתוך ירושלם שנ בונה ירושלם יי נדחי ישראל יכנס אמ ר אלעזר עתיד הקבה לעשות מחול לצדיקים בגן עדן וכל אחד ואחד מראה באצבעו שנ ואמרתם ביום ההוא הודו ליי קראו בשמו הודיעו בעמים עלילותיו כתו יפתיתני יי ואפת בשעה שאמ לירמיהו לך הנבא על ירוש ירושלם אמ לפניו רבונו של עולם הנה לא ידעתי דבר כל כך למה שלא היה רוציד להנבא על ישראל נבוא קשה אמ לו הקבה בטרם אצרך בבטן ידעתיך וליון שאמ לו נביא לגוים נתתיך נתיישבה דעתו ואמ מוטב לגוים ולא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_186r_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_186r_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_186r_2"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_80v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "כיכשלת בעוניך אמ ר סימון משל להר גבוה שעימד על פרשת דרכים והיו נכשלים בו בני אדם אמ המלך סתמו אותו קימ עא קימעא עד שיבא עתו ואני מעבירו מן הכגולם ההד והסירותי את לב האבן מבשרכם בך יצת הרע הוא מכשול בעולם הזה אמ הקבה בנוהג שבעולם אדם נבשל בעבירה והוא מתחייב עליה מיתה לשמים מת שורו או חמורו אבדה תרנ גולתו נשברה צליחיתו ניקף באצבעו מקצת הנפש חושב לו הקבה ככל הנפש לכך אמ שלמה אחת לאחת למצא חשבון מרובעראחת וה חשבון מתמלא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_80v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_80v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_80v_1"
   }
  ]
 },
