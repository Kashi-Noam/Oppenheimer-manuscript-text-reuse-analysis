 {
  "@id": "http://example.org/oppenheim128#unit_fol_127r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   },
   {
    "@id": "http://example.org/oppenheim128#work_Sifrei_Aggadah_on_Esther"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Vayikra_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "יי אלהי שועתי אליך ותרפאני יי העלית מן שאול נפשי חיתני מירדיבור תלמידו מה היו אומ זמרו ליי חסידיו והודו לזכר קדשו כי רגע באפו חיים בר צונו בערב ילין בכיולבחר רנה אותותני מה היה אומ ואני אמרתי בשלוי בל אמוט לעולם יי ברצונך העמדת להרריעא הסתרת פניך הייתי נבהל אסתר מה היתה אומ אליך י אקרא ואל יזיאתחנו מה בצע בדמי בר דתי אל שחת היודך עפר היגיד אמתך ישראל מה היו אומ שמעג יי וחנני יי היה עוזרלי הפכת מספדי למחול לי פתחת שקי ותארני שמחה אמ ר פנחט בקרית עמע היה עסוק ולא הפסיק שנ למעז יזמיך כבוד ולא ידום יי אלהי כעולם אודך ויהי דשלק פרעה את העם ברצות יי דרכי איש גם אויביו ישלים אתו ר מאיר אומ זה הכלך ור יהנשע בןלוי אמ זה הנחש ור מאיר אומ זה הכלב רעוא חלבון אתא חויא דאכל מיניה חמתיה כלבא יתבין למיכל שר נבח בהון ולא אותבינון אתא קם ואכל מיניה ומית וקברוניה ועברון ליה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_127r_1#u1"
   }
  ],
