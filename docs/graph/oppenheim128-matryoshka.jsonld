 {
  "@id": "http://example.org/oppenheim128#unit_fol_148v_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "בר קפרא אמ ארכי בן יונס דהוו זינים אטאקיא אטאקטיא וחברי גנבים שהיו מתחברים לגנבים אמ ר ברכיה מעשה באשה אחת שנגנב מיחם שלה ובאה לקבול לפני הדיין ומצאתו שפות על גבי כירתי ועיד מעשה באיש אחד שנגנבה לו טליתו ובא רבאלקבול לפני הדיין ומצאה מוצעת על בי מטתו אמ ר לוי מעשה באשה אחת שכבדה לדיין מנורה אחת שלכסף והלך אנדיק אנדיטקיס שלה וכבד שיח של זהב למחם אתת ואשכחת דינה הפוך אמרה ליה מאריינהר דיני בההוא מנרתא דכספא אמ ומה אעשה וכפה השיח את המנורה ההד כלו אוהב שחד ורודף שלמונים היו אומ שכים לי ואנא אשכם לך יתום לא ישפוטו ר אלעזר ור יוחנן ר אלעזר אמ בראשונה היה אדם מת בירושלם והיה ממנה אפטרופוס על היתומים והיתה אלמנה תובעת כתובתה אצל היתומים והם הולכים אצל הדיין ומיצאים אותו חשוד"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_148v_2#u1"
   }
  ],
