 {
  "@id": "http://example.org/oppenheim128#unit_fol_112r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_Rabbati"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "שביעית בןדוד בא בו אמ אביי כמאן שבועין אתון כהדא ולא אתתן אתיא אלא כי האי דאמ ר יוחנן דור שבן דודבא בו תלמידי חכמים מתים והנשארים עיניהם כלות ביגון ובאנחה וצרות רבות ורעות על הצבור וגזרות קשות מתחדשות עד שהראשונה קיימת באה האחי ואסמכה ליה אמ ר אבין דור שבן דוד בא בו בית ועד יהיה לזנות והגליל יחרב ואנשי הגליל יסובבו מעיר לעד ולא יתחוננו אנשיאמת וחסד נאספים והאמת נעדרת והולכת לה והיכן היא הולכת לה דביר ינאי אמרי הונלכת ויושבי עדרים עדרים במדבר כדא ותהי האמת נעדרת וסר מרע משתולל אמ ר נהוראי דוד שבן דוד בא בו נערים ילבינו זקנים וזקנים יעמדו מפני נערים בת קמה באמה כלה בחמותה אויבי איש אנשיביתי בן לא ייבוש מאביו חכמת סופרים תסרח והגפן תתן פריה והין ביוקר אמ ר חבא בר נהנא רור שבן דוד"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_112r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_112r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_112r_1"
   }
  ]
 },
