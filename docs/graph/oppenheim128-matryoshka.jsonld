 {
  "@id": "http://example.org/oppenheim128#unit_fol_24v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "והלווה ואינו משלם שנ לווה רשע ולא ישלם ומי שהוא בעל מחלקת שנ סורו נא מעל אהלי האנשים הרשעים האלה גו דבר אחר לווה רשע ולא ישלם אלו אומות העולם שהם אוכלים ואין מברכין וצדיק חונן ונותן אלו יש שהן אוכלין ומברכין אמ דיש לקיש את מוצא כשהקבה נותן לביק מה שמבקש לו בידו הוא חוזר וחונן משלו שנאמ וצריק חונן ונותן דבר אחר וצריק חונן ונותן חי העולם חונן ונותן אמר לויכך עלה בדעתו של הקבה לעשות רגל אחד בכל חדש וחדש שבקיץ בניסן פסח באייר פסח שני בסיון עצרת ועל ידי עבירות ומעשים רעים שהיו בידם נטל מהם שלשה תמוז אב ואלול בא תשרי ופרע שלשתן ריש שתא לקביל תמוז צומא רבא לקביל אב שבעת ימי החג לק ביל אלול אמ הקבה של אחרים פורע ושלו אינו פרע תנו לו משלו ויבא ויטול את שלו לפיכך הוצרך הכת לומר ביום השמיני"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_24v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_24v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_24v_1"
   }
  ]
 },
