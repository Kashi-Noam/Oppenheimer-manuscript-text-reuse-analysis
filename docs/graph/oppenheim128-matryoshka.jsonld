 {
  "@id": "http://example.org/oppenheim128#unit_fol_48v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma_Buber"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "וכן אתה מוצא בשעה שהלך יעקב לארם נהרים לייך אצל לבן עשה אצלו עשרים שנה שנ זה לי עשרים שנה בביתיך וכל אותן הימים לא דבר הבה עם יעקב והיה מהרהר ואומר שמא הניחני הקבה לא כך אמ לי הנה אנכי עמך ידע הקבה מה הרהר יעקב אמ לו הקבה אם אתה מבקש שאהיה עמך כשם שאמר לך הכיש עצמך מביתו של לבן הרשע ואהיה עמך ההד ויאמר יי אל יעקב שוב אל ארץ אבותיך ולמולותו ואהיה עמך"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_48v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_48v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_48v_1"
   }
  ]
 },
