 {
  "@id": "http://example.org/oppenheim128#unit_fol_88r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמרבן יוחנן בן זכאי רואה אני את דברי ר אלעזר בן ערך מדבריכם שהוא מדבר בנותן צדקה וחסר לישראל וחטאים לחומות העולם ר יהודה בר יהודה אמ צדקה תרומם גוי לו ישראל וחסד לאמים חטאת מקבלין הן ישראל חסידים מאומות העולם שכן רב שקה הוא אומ ליחזקיהו ועתה המלבעדי יי עליתי וכן נבוזר אדן אומ לירמיהו ויבא ויעש יי כאשר דבר והיה לכם הדבר הזה דבר כתו ר נחוניא בן הקנה או צדקה תכומם גוי אלוישראל וחסד לאומים חטאת חסד שאומות העולם עושים חטאת הוא לישראל ממי אתה למד ממישעמלך מואב שהיה נוקד שנ ומישע מלך מואב היה נוקד מהו נוקדרועה והשיב למלך ישראל מאה אלף כרים ומאה אלם אילים במר מהו אלים צמר ר אבא בר כהנא אמ"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_88r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_88r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_88r_1"
   }
  ]
 },
