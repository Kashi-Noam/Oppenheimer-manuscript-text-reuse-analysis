 {
  "@id": "http://example.org/oppenheim128#unit_fol_181v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Ein_Yaakov_Glick_Edition"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "לא אהני ליה אמ ר חייא בר אבין אמ ל יהושע בן קרחא שחלי זקן אחד בבקעה זו הרג נבוזר אדץ מאתים ויא רבוא ובירושלם הרג צד רבוא עד שהלך דמם ונגעבדמו שלזכריה שנ פרצו ודמים בדמים נגעו חזייה לדמיה דזכריה דקא רתח וסליק אמ להו מאי האי אמרו ליה דם זבחים דאשתפיך אמ להו אייתו לי דמא דדבחיכון אייתו ליה ולא אדמי אמ להו אי אמריתו לי מיטב ואי לא סריקנא לבשרייכו במסריקי דפרזלא אמרו ליה נביא הוק וקא מזכח לן ולא קבילנא מיניה והשתא קא מפיסינן ליה ולא קאמפיים אייתירבנן קטל עילויה ולא נח אייתי בחורים ובתולות קטל עלויה ולא נ קטל עד טדנבוא ולאנח קרב לובה אמ ליה זניה כל נ טובים שבהם הרגתי ניחאלך רנבדינהו לכלהו מיד נח הרהר בתשובה בדעתו ואמ מה ישראל שלא הרגו חלא כפש אחת כך הוא שהרג נפשות"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_181v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_181v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_181v_1"
   }
  ]
 },
