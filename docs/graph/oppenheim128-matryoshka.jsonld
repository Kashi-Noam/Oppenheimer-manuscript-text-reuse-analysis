  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "רימנו אמ להם רבותי המתיט לי עד שאפטר משכינה שהא גדולה מכם שנאמ ויאמר יי אם נא מצאתי חז בעיניך אל נא תעבור מעל עבדך וכיון שופטר אל ית אבינו מן השכינה בא והשתחוה להם והכניסם תאת האילן שנא יוקח נא מעט מים ואחרכך ואקחה פת לחם אבל לוט מה אמ להם לינו ורחצו ל רגרירם אחרים אומ לא אמ להם לוט אלא חכמה אמ אלו הויו רואין אותם אנשיסדום רוחצין ידיהם ורגליהם נמצאו הורגין אותי ואת אשתי ואת בנותי אלא יראו אותם באבק שעל רגליהם ויאמרו לא באו מן הדרך אלא עכשו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_60r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_60r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_60r_1"
   }
  ]
 },
