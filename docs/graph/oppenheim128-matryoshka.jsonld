 {
  "@id": "http://example.org/oppenheim128#unit_fol_29r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma_Buber"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tanchuma_Buber"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "הנה יסרת רבים אתה היית מנחם כל בעלי ייסורין כשהיה סומא בא אצלך ואמ לך כבר היה הקבה יו דע מה עתיד לעשות שסימא נאותי האיש היית מנחמו ואומר ל בני אם אתה בונה בית ולא בקשת לעשוה לך חלונות מי ימחה בידך כך עתיד הקבה להשתבח אז תפקחנה עיני עורים אם בא אצלך פסח היית מנחמו ואומר לו בני אם עשי לך קיתון ושלא בקשת לעשות לו אזנים מי ימחה בידך בך עתיד הקבה להשתבח אז ידלג כאיל פסח הוי כושל יק ימון מליך כי עתה תבא אליך ותלא ועכשו כשבאו ייסוין עליך נלאית נשוא תגע עדיך ותבהל לפי שנגעה בך מדת הדין נבהלת הלא יראתך כסלתך על שאמרת אדם צדיק אני ולמה הוא מייסרני וכי איזה צדיק אבד מימיו זכר נא מי הוא נקי אבד נח שלא שהיה צדיק לא נמלט מכל דורו וכן אברהם לא נמלט מן הכבשן יצחק לא נמל מן המאכלת יעקב לא נמלט מן המלאך משה לא נמלט מחרב פרעה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_29r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_29r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_29r_1"
   }
  ]
 },
