 {
  "@id": "http://example.org/oppenheim128#unit_fol_133r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "תנינא ודרש ונראתה הקשת בענן אמ ר שמעון בן יוראי הוא סימניה דעלמא אמ ר חזקיה בשם ר ירמיה כל ימיו של ר שמעון בן יוחאי לא נראתה הקשת בענן ר חזקיה בשם ר ירמיה אמ כך היה ר שמעין בן יוראי אומ בקעה בקעה המלאי דינרי זהב והיא נתמלאת ר חזקיה אמ בשם ר ירמיה אליהו זל ור יהושע בן לוי הוו יתיבין פשטין מטון חדא שמיעה משמיה דר שמעון בן יוחאי עבר ר שמעון בן יוחאי אמרין הא אתא מריה דשמעתא ניקום ונישייליה קמון ושאלון ליה אמ ליה מאן הוא דין דעמך אמ ליה ר יהושע בן לוי הוא וגדול הדור הואי אמ לו אם נר ותה הקשת בימיו לית הוא כדאי סבר למחזי אפי אמ ר חזקיה בשם ר ירמיה כך היה ר שמעין בן יוחאי אומ נשבע הקבה לאברהם אבינו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_133r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_133r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_133r_1"
   }
  ]
 },
