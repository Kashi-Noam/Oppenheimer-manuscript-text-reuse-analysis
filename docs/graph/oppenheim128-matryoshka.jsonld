 {
  "@id": "http://example.org/oppenheim128#unit_fol_196v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר עקיבא בלילט באב היה אברהם אבי בבית המקדש מטייל בין ארוכות וקצרות אחזו הקבה ואמ לו מה לידידי בביתי אמ לו היכן בני אמ לו גלו בחטאם אמ לפניו רבונו של עו ולא היה בם צדיקים אמ ליה סוגייהו בישין דכת עשותה המזמתה הרבים אמ לו ולא היו מקיימין את המילה אמ ובשר קדש יעברו מעליך ולא עוד אלא שהיו שמחים במפלתן אל ו שלאלו שנ כי רערני אז תעלחי וכת שמח לאוד לא ינקה בכה תבכה בלילה שתי בכיות הללו למה אחת בגלות יכניה ואחת בגלה צדקיהו י דא אחת על מקדש ראשון ואחת על מקדששני בלילה על עסקו לילה שנויבכו העם בלילה ההוא אמ להם הקבה אתם בכיתם בכיה שלחנם אני אקבע לכם בכיה לדורות ויבכו שבכו על לוחות הראשו שאלמלא לא נשתב אין כל בריה יכולה לשלוט בם שנ והמכתב מכתב אלהים הוא חרות על הלוחות י אל תיקריחרות אלא חירות יחירות ממלאך המית חירות מן המלכיות דא בכה תבכה שבנו עד שלא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_196v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_196v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_196v_1"
   }
  ]
 },
