 {
  "@id": "http://example.org/oppenheim128#unit_fol_161r_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ר יהושע בר נחמיה פתר קרא ביעקב אבינו שנ והיא עבר לפניהם מהו והוא עבר הואהוה בעקא אמ מוטב שיפגע בי ולא בבני מה עשה זיינם מבפנים והלבישם בגדים לבנים מבחוץ והתקין עצמו לג דברים לתכלה ולרורין למלקמהי לתכלה שנ הצילני נא מיד אחי מיד עשו ולדורון שנ ותעבר המנחה על פניו ולמלחמה שנאהו אם יבא עשואל המחנה האחת והכהו אמ מכאן ולהלן אנא עבד עימיה קרבא אמ ר שמואל בד ח נחמכר דרכו של אב לרחם ודרבה של אם לדחם רדכו שר אב לרחם שנ כרחם אב על בכפים ודרכה שלאם לנחם שנ כאיש אשך אמו תנחמנו אמ הקבה אנא אעביד דאב ודאם אנא עביד כאב שנ כרחם אב על בנים רחם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_161r_2#u1"
   }
  ],
