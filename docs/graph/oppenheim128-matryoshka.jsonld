 {
  "@id": "http://example.org/oppenheim128#unit_fol_66r_1_u3",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Zuta"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Zuta"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ואל אכשל בדבר הלכה ולא בשום דבר בעולם ותצילנר מכל מיני מזיקים מכל מיני פורעניות המתרגשות לבא בעולם שלא יזיקו בי בין ביום בין במלילה אמן יהי רצון מלפניך יי להי שתראלי בשמחתה של ירושלם ונחמותיה אמן חסלת מדת דרך ארץ תל דרך ארץ זוטא בעה דרכן של הלמידי חכמים ענו ושכל רוח אריה וממולא עלוב ואהוב לכל אדם שפל לא נשיביתו ירא חטא ודורש את האדם לפי מעשיו ואומ כל מה שיש בעולם הזה אין לו חפץ בהם יושה ומשנה ומטנף כסותו לפני רגלי תלמידי חכמים ואין איש רואה בו דבר רע שואל כענין ומשיב כהלכה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_66r_1#u3"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_66r_1_u3_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_66r_1"
   }
  ]
 },
