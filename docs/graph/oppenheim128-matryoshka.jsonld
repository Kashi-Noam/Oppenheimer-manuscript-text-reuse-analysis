 {
  "@id": "http://example.org/oppenheim128#unit_fol_182v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ושפח יי קדקד בנות ציון אמר יוםי בר חנינא מלמד שפרחה צרעת כתוב הכא ושפח וכת התם ולשאת ולספחת ולבהרת ויי פתהן יערה רב ושמואל חדאמ שנשפכו כקיתון וחד אמ שנעשו פתחיהן כיער אמ רב יהודה אמ רב אנשי ירושלם אנשי שיץ היו היה אדם אומר לחבירו במה סעדת היום בפת עמילה או בפת שאינה עמילה בח גודלין בין חרדלין במסב רחב או במסב קבר בחבר טוב או בחבר רע אמ רב וכולם לשום זנות"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_182v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_182v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_182v_1"
   }
  ]
 },
