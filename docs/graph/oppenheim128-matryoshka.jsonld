   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#dating_Aggadat_Bereshit",
  "@type": [
   "http://example.org/oppenheim128#DatingAssertion",
   "http://www.w3.org/2006/time#ProperInterval"
  ],
  "http://example.org/oppenheim128#confidence": [
   {
    "@id": "http://example.org/oppenheim128#conf_medium"
   }
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@value": "0850/1000"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_8239990695"
   },
   {
    "@id": "http://example.org/oppenheim128#source_47166be992"
   },
   {
    "@id": "http://example.org/oppenheim128#source_65d22f2ca2"
   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_01"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-9–ה-10"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica, 'Aggadat Bereshit' (M. D. Herr), on Encyclopedia.com: The evidence 'would appear to place its date of editing at about the tenth century'; no place is given."
   },
   {
    "@value": "Herzog College, 'Midrash Aggadat Bereshit' (research page): The midrash 'was probably created in the ninth century in southern Italy'."
   },
   {
    "@value": "Teugels, 'The Provenance of Aggadat Bereshit: A reassessment of the origins of the work as a Tanchuma satellite' (Brill 2021), PThU record: Record only, with no abstract; keywords include 'Byzantium'. The chapter reassesses its origin as a Tanhuma satellite."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Herr (EJ) dates the editing to about the 10th century on grounds of style and anti-Christian polemic, while others (Herzog College, Sefaria) say the 9th century; its provenance (southern Italy or Byzantium, as a 'Tanhuma satellite') is under reassessment (Teugels 2021)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "לפי פרויקט מכללת הרצוג: כנראה דרום איטליה; Teugels (2021) בוחנת מחדש את מוצאו (הקשר ביזנטי)"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Aggadat_Bereshit_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Aggadat_Bereshit_end"
   }
  ]
 },
