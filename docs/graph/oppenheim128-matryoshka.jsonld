 {
  "@id": "http://example.org/oppenheim128#unit_fol_157r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "הקבה יודע אני שאין אומות העולם בדלין מן הזיבה ומן הצרעת מה עשה להן הקבה שנ ויי פתהן יערה ים מהו פתהן יערה רמז למעגיינות שלהן והיו פוקחות דם והיה ממלאה דם כל קרונין שלו והקרונין עוברת עליה ומפסקתה והיו אומר אלו לאלו סורומהן טמאותי הן הוא שהנביא מקנת ואומ להן סורו טמא קרא כמו ר איננא ברפפא ור סימון ר חיננא בר פפא אמ לא גכו עד שנאבו בהקבה שנ ואת קדוש ישראל נאבו אמ רסימון לא גלו עד שנעשו בעלי מצות להקבה והתתשרק אשה עולה שכחת אותן קתבנות שהיינו מק מקריבח לפניך ר הונא בשם ר אחא את אמ הקכה קרעדת אני שוכח והטובות אני שוכח הרעות אני שוכ שאמרתם אלה אלהיך ישראל והטובות איני שוכח שאמי שאמרתם לפני כל אשר דבר יי נעשה ונשמע אמ ר אבהו שני דברים שאלו שראל לפני הקבה ואמרו להם קנביאים לא שאלתם כראוי שאלו ישראל ואמרו ויבא כגש לנו כמלקוש יורה ארץ ואמרו להם הנביאים לא שאלתם כר אוי שהגשם הזה יוצאי דרכים מצרים בד נוטעי גנות ופרדסים ודורכי גתוה מצרים בו וכן דורכי גרנות אלא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_157r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_157r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_157r_1"
   }
  ]
 },
