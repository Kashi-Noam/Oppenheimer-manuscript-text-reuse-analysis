 {
  "@id": "http://example.org/oppenheim128#unit_fol_44v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "הים כיון שזרח השמש נסתלק הענן ועמו האש והמשיך הקבה לפניהם נחל אחד שמו סבטיון וסגר בפניהם כדי שלא יוכל אדם לעבור עליהם הים סובב עליהם מהלך שלשה ימים חדשים מרובע ומצד האחד לא הים סובב כל הרוח והמשיך הקבה אול נהנ וסגר בפניהם ותחחום אותו נהר מאתים אמה והנהר מלא חול ואבנים ומושך חול ואבנים וקולך רעש קולו בלילה מהלך חצי יום והנהר מושך חול ואבנים כל ששת ימי המעשה ובשבת ני נוח ומיד תעלה אש מערב שבת עד מוצאי שבת מצד הנחל והאש לוקטת ולא יוכל אדם לנגוע אל הנחל המהכך מיל ומלחכת האש כל מה שישריש סביבות הנחל עד"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_44v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
