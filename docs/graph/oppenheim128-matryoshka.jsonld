 {
  "@id": "http://example.org/oppenheim128#unit_fol_138r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ירמיהו בן חלקיהו ר אבא בר כהנא פתח צהלי קולך בת גלים צהלי קולך ליצלי בקכיך בתגכים מה קגלים הללו מסוימים בים כך היו אבתיכם מסוימים בעולם דא בת גלים בת גולים ברתהון דגלולאי בתו של אברהם מה כת בו ויאמר יי אל אברם לך לך מארצך בתו של יצחק מה כתוב בו וילך יצחק אל אבימלך מלך פלשתים גררה בתו של יערב מה כתוב בו וישמע יעקב אל אביו ואל אמו וילך פדנה ארם הקשיבי לישה הקשיבי למצותי הקשיבי לדבדיתורה הקשיבי לררי נבואה ואם לאו לישה הא אריה סליק עלך זה נבוכד נצר שנ עלה אריה מסבכו עניה מן הצריקים יעניה מדבריתורה עניה ממצות ומעשים טובים ואם לאו ענתות י הא ענתותי אתי ויתנבי עלך דברי תוכחו לפיכך צרך הכת לומ דברי דמיהו בן חלקיהו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_138r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_138r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_138r_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_183r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר יוחנן בכל מקום שהיו הולכים נטשו שרים לארוניהם בכה תבכה בלילה אמ ר אבא אמ ר יוחנן שתי בכיות הכלו למה אחת על מקדש ראשון ואחת על מקדש שני בלילה על עסקי הלילה וכד הביכה בלילה קולו נשמעי וכוכבים ומזלות בוכים עמו דא כל השומע קולו ביכה עמו מכושה בשכנתו של רבן גמליאל שמת בנה והיתה בוכה בלילה והיה רבן שמעון שומעג את קולה ובוכה כנגדיה עד שנשרו גבות עיניו הכירו בה עבדיו והוציאוה משכונתו ורמינתה על לחיה אמ ר אבא אמ ר יוחנן כאשה שכוכה על בים יעיריה שנ אלי כנתונה חנירתשק על גבעל נעוריה אין מנחם לה מכל אהביה אלו נביאיהשקר שאים מני חים את ישראל שיעשו תשובה כל רעיה בגדו בה לו מיכאל וגבדיאל שהיו מלמדין זכות על ישראל אמ להם הקבה מיחביב עליכם אמרו לפניו רבונו של עולם שמך חביב עלינו ואחריו מי אמרו ישראל ואחריהם מי אמרו בית המקדש אמ להם כבר נשבעתי בשמי הגדול שאתם בעצמכם תציתו בה את האור באותה שעה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_183r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_183r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_183r_1"
   }
  ]
 },
