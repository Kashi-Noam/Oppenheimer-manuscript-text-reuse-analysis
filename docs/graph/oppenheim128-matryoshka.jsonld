   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_70v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מרדע שהוא מורה דעה לפרה דרבן שהוא מדיר בינה בפרה אמ ק הבה לפרתו אדם ענשה דרבן וליצר הרע אינו עושה דרבן מדריכך בדרך תלך אמר לוי בשם רחמא בר חנינא אמ משל לבן מלכים שהיה לו דין אצל אביו אמ לו אביו בני אם אתה מבקש לזכות לפני בדין מנה לך גקיא לוגוס פנני ואת זוכה ליני בדין כך אמ הקבה לישמל בני אם מבקטים אתם לזכותלפני בדין תהיו מזכירים לפני זכו אבית ואתם זוכין לפני בדין אחד זה אבינו אברהם דנה ביה אחד היה אברהם וירשית הארץ זכרון נחתי תרועה זה אבינו יצחק וירא והנה איל אחר נאחז בסבד בקרניו מקרא קדש זהיעקב אבינו שמע אלי יעקב עבדי וישראל מקוראי אמ הקבה תהיו מזכירין לפני זכות אבות ואתם זכין לפני בדין ואימתי בחדש השביעי באחד לחדש ר חייא בר מריא פתח אך הבל בני אדם כזב בני איש במאונים לעלות המה מהבל יחד בנוהג שבעולם הבריות אומרות פלני ישאפרנית ופלנית ישא פלני במאזנים לעלות המה מהבל יחד אמ ר"
   }
  ],
