 {
  "@id": "http://example.org/oppenheim128#unit_fol_144r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מי גרם לי שאהא מפרשת שתי חלות בסוריא על שלא הפרשתי חלה אחת כתקנה בארץ ישראל סבורה הייתי שאני מקבלת שכר על שתים ואיני מקבלת שכד אלא על אחת מי גרם לי שאהא משמרת שני ימים טובים בסוריא על שלא שמרתי יום טוב אחד כתקונו בארץ ישראל סבוהה הייתי שאני מקבלת שכר על שנים ואיני מקבלת שכר אלא על אחד ר יוחנן הוה קר עליהון וגם אני נתתי להם חקים לא טובים"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_144r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_144r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_144r_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_196v_2_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ומבכה אחרים עמה דא בלילה שכל הבוכה בלילה קולו נשמע אמ ר אבא לילה היה מושך עמהם קייה דא כל הבוכה בלילה אפי מזלו לונין ענמו דח בלירה הבוכה בלכה רל השומע קולו בונה בוכה כנגדו מעשה באשה אחת שהיתה בשכונתו שלרבן גמליאל והיה לה בן תשחורת ומת והיתה בוכה עליו בליכות והיה רבן גמליאל שומע קולו ונזכר חורבן בית המקדש ועומד ובוכה כנגדה עד שנשרו ריסי עיניו והרגישו בו תלמד והוציאוה משכונתו דא מי יתן ראשימים ועיני מקור דמעה ואבכה יומם ולילה וירמיה מקונן ברוח הקדש ואומ בכה תבכה בלילה מי בכה ישראל בכו ויש אומ ירמה בכה אמ ר אחא כיון שחרבה ציון וירושלם ובית המקדש ונשרף ההיכל וגלו בקולרין ובשלשלאות היו ישראל מברשי לבכות ולא היו מניחין אותם אלא היו רודפים ומכים אותם על צואריהם שנ על צוארנו נרדפנו וכיון שיצאו יום ראשון אלו נפנו לקכילה ושתיה ולו נפנו לבכיה וכן נבוזר אדן מצוהו על ירמיהו גבוכד נצר קחנו ועינך שים עליו ואל תעש לו מאומה רע אמרו ישראל לירמיה נעשה התנאי בינינו את נתון ברוחה הוי את בוכה ביום ואנו נבכה בלילה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_196v_2#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_196v_2_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_196v_2"
   }
  ]
 },
