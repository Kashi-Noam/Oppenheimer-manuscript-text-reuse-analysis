 {
  "@id": "http://example.org/oppenheim128#unit_fol_165r_2_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "לי המקום גשה לי ואשבה ר יוםי בר ירמיה דוסתא בשם ר לוי ואין אתה מה היח שכחה של ירושנם מן הדין קרא דכת ואני אהיה לה נאם יי חומת אש סביב ולכבוד אהיה בתוכה מכאן אתה יודע מה היא שבחה של ירושכם קומי אורי כי בא אורך על כן באורים כבדו יי במה מכבדים אותו אמ ר אבא ברכהם באלין פנסייא ר איבו אמ מאורות שנ ויעש אלהים את שני המאורות הגדו הא כאי זה צדחמה זורחת ומברכיו עליה לבנה זורחת ומברכין עליה ורבנן אמ אמ הבה לישראל בני הואיל ואוריהוא אורכם ואורכם הוא אורי אני ואתם נלך ונאור לציון קומי אורי ר אחא אתח אני יי הוא שמי הוא שמי שקרא לי אדם הראשין הוא שמי שהתניתי ביני לבין מלאכי השרת וכבודי לאחר לא אתן ר מנחם בשם ר אבין השארים ותהלתי לפסילים אמ הקבה כבידי איני נותן לאחר ואתם נותנים תהלתי לפסילים ולמי אני נותנו לביון קומי אורי כי עמך מקורחיים באורך נראה אור"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_165r_2#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_165r_2_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_165r_2"
   }
  ]
 },
