 {
  "@id": "http://example.org/oppenheim128#unit_fol_121r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   },
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_Rabbati"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ר יהושע בר נחמיה שמע לה מן הדא גם חשך לא יחשיך ממך ולילה כיום יאיר כחשכה כאורה חשכה שהיא אורה לפני ולילה לתשמישן שלבריות היו בה ביום מתו בכוריה של מצרים האכיצד לקו מכת מיתה מבערב והיו מפרפרים כל הלילה ומתו ביום מאי טעמא כלר כלנו מתנו אין כת כאן אלא כלנו מתים מיתין ואזלין הכא את אמ בים הכותי כל בכור בארץ מצרים ולהלן הוא אומ הקדשתי אותם לי אמור מיגתה בו ביום שמתו בכוריהם של מצרים הקדשתי לי כל בכור בארץ מצרים ויי הכה כל בכור כל בכור בכר לאיש בכור לאשה בכור לזכר י בכור לנקבה הא כיצד איש אחדבא על עשר נשיםוהן יולדות עשרה בנים נמצאו כלם ברורינשים עשרה אנשים באים על אשה והיא יולדת עשרה בנים נמצאו כלם בכורי אנשים הגע עצמך שאין שםבכוד לא לאיש לא לאשה ולא לזכר ולאלנקבה והא מה אני מקיים כיחין בית אשי אין שם מת אמ ר אבא בראחא אפטרופום שלבית היה מת כדא שמה הראש כי לא היה בכור וישימהו אביהו לראש תניא בשם ר נתן ביום שהיה בכורו של אחד מהם מת היו צרין איקונין שלו בכותל בביתו ואותו היום היה נדוקת ונדחקת וטרית והיה זה קשה עליהם כאלו אותו מת"
   }
  ],
