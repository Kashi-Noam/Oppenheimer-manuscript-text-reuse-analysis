 {
  "@id": "http://example.org/oppenheim128#unit_fol_110r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אשרי המחכה ויגיעי כימים אלף שנש מאות שלשים וחמשה אלין מיתליא דהכא מן אנון אלו מה יום שמלך המשיח נגלה להם וחוזר ונכסה מהם והיכן הוא מוליכן אית דאמרי למדבר יהודה ואית דאמרי למדבר סיחון ועוגההד לכן הצה חנכי מפתיה והולכתיה המדבר מי שהוא מאמין אוכל מלוחים ושתש רתמים וחיה ההד הקטפים מלוח עלי נאיח ושרש רתמים לחמם ומי שאינו מאמין בו והולך לו אצל אומות העולם הם הורגין אותו אמ ר יצחק בר מריון לסוף מה יום הקבה נגלה להם ויוריד להם המן למא והכת אין כל חדש תחת השמש מאי טעמיה אנכי יי ילהיך המעלך מיורץ מצרים ואומ עוד אושיבך באהלים כימי מועד ענה דודי ואמר לי קומי לך רעיתי יפתי ולכי לך אמ ר עזריה לא היא עניה ולא היא אמירה ארא ענה לי עלידי משה ואמ לי על ידי אהרן ומה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_110r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_110r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_110r_1"
   }
  ]
 },
