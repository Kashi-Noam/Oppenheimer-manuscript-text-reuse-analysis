 {
  "@id": "http://example.org/oppenheim128#unit_fol_91v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Jerusalem_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "גרמסין אמ ר יהושע בר נחמיה בשם רבן יוחנן בן זכאי לפי שעברו על עשרת הדברות לפיכך יהא כל אחד ואחד מהם מביא עשרים גרה ר ברכיה ור לוי אמ בשם ר שמעון בן לקיש לפי שמכרו בכורה שלרחל בעשרים כסף לפילך יהא כל אחד ואחד פודה בנו בכור בעשרים כסף ר פנחס בשם ר ליי אמ לפי שמכרו בכורה של רחל בעשרים כסף ונפל לכל אחד מהם טבע לפיכך יהא כל אחד מהם מביא שקלו טבע אמ ר יה ודה בר סימון בשם ר יוחנן גדברים שמע משה מפי הגבורה ונרתע ונבהל לחחוריו א בשעה שאמ לו ועשו לי מקדש אמי משה לפני הבה דבונו של עולם כת הנה השמים ושמי השמים לא יכלכלוך אף כי הבית הזה אשר בניתי ואתה אומ ועשו לי מקדש אמ לו הקבה משה לא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_91v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_91v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_91v_1"
   }
  ]
 },
