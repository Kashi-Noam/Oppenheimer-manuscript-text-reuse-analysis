 {
  "@id": "http://example.org/oppenheim128#unit_fol_31v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מיד הולך הקבה אחריו לבצרה ואומר לו רשע טעית בין בצר לבצרה ועוד דכת וכי יזיד איש על רעהו להרגו בערמה מעם מזבחי תקחנו למות ואתה מזיד היית מיד ימסרנו הקבה ביד מיכאל שר של ישראל ומביאו בשלשלאות של ברזל וימסרנו ביד ישראל ועושים בו כרצונם שנ ונתתי נקמתי באדום ביד עמי ישראל לפי שאין הקבה פורע מכל אומה ולשון עד שיפרע משר שקה תחלה שנ יפקוד יי על צבא המרום במרום ועל מלכי האדמה יבאדמה הוי מבצרה זה הדור בלבושו זוה לבוש נקם כד וילבש בגדי נקם אמ הקבה הלבוש הזה נאה מכל מלבושים שלבשתי שלבשתי מעולם צועה ברב כחו כד כי זבח לי בבצרה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_31v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
