 {
  "@id": "http://example.org/oppenheim128#unit_fol_143r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמ ר סימאי בנוהג שבעולם חתן דר אצל חמיו ועובר לצאת מבית חמיו אפשר שלא ימצא בידו אפי דבר קל חה אפי מחט אפי סכין לא נמצא בידו ההד כי מששת את כל כלי מה מצאת מכל כלי ביתיך אמ הקבה חייך בל שון שהונחת את חמיך בו בלשון אני מיכיח את בניך שנא כה אמר יי מה מצאו אבותיכם בי עול ושומנ לי ישכן בטח ארבעה שומעים הם שמעג והפסיד י שמע ונשכר שלא שמיג ונשנר שלא שמע והפסד שמעג והפסיד זה אדם הראשון שנ ולאדם אמד כי שמעת לקול אשתך ומה הפסיד כי עפר אתה ואל עפר תשוב שמע ונשכר זה אבינו אברהם שנ כל אשר תאמר אליך שרה שמינ בקולה ומה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_143r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_143r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_143r_1"
   }
  ]
 },
