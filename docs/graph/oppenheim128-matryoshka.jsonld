   {
    "@id": "http://example.org/oppenheim128#unit_fol_126v_2_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_126v_2"
   }
  ]
 },
