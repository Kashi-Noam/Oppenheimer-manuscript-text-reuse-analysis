 {
  "@id": "http://example.org/oppenheim128#unit_fol_190v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "רוח סערה באה מן הצפון להיכן אזל אמ רביהודה אמ רב שהלך לכבוש את כל העולם כרו ביד נבוכד נשצר הרשע וכל כך למה כדי שלא יאמרו ביד אומה שפלה מסר את בניו אמ הקבה מי גרם לי שאהיה שמש לעובדי פסילים עונותיהן של ישראל גרמו לי דכת ורבו יתירא הוספת לי אמ רבא בר ירמיה מלמד שרכב ארי וקשר תנין בראשו לקיים מה שטוגם את חית השדה נתתי לו לעבדו אמרו בשעה שבקש הקבה להחריב את ירושלם אמ כל זמן שעיני בביתי אין אומות העולם יכולין ל אלא אעלים עיני ולתי ממנו ואשבע שלא אזקק לו עד עת קץ ויבאו בו זרים ויחריבוהו באותה שעה נשבע הקבה בימינו והחזירה לאחור שנ השיב אחוד ימינו מחלי אויב באותה שעה נכנסוגוים ליהיכל ועשו בו כר טונם נכנס נבוזר אדץ ותפש את צדקיהו והיאך תפש אותו והוא ברח במחלה תחת הארץ מלמד שירד מלאך בדמות צדקיהו והיה מהליך מלמעלה וצדקיהו מהלך מלמטה וכיון שהגיע לערבות יריחו יצא מן המחלה ותכשוהו עבדי נבוכד נצר שנ בחדש הרביעי בתשעה לחדש ויחזרך הרעב בעיר ולא היה לחם לעם הארץ ותבקע העיר וכל אנש המלחמה יברחו ויצאו מז העיר לילה דרך שער בין החומותים וכת וירדפו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_190v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_190v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_190v_1"
   }
  ]
 },
