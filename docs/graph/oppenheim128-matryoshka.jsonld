 {
  "@id": "http://example.org/oppenheim128#unit_fol_48r_2_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "לה בתי מה טבו של אותי נער אמרה לו ר לא אמרתי לך גורלו שבו ביום שנולד בו ציום נחרב בית המקדש ולא עוד אלא אפי רגלים יש לו ואינו מהלך עינים יש לו ואינו רואה אזנים יש לו ואינו שומע פה ישלו ואינו מדבר והרי הורד מוטל כאבן עד שקוא מדבר נשבה עליו רוח מארב פנות העולם והטילהו לים הגדול קרע בגדיו ותלש בשערו וצעק ואמר ווי אבדה ישועת ישראל יצתה בת קול ואמרה אליהו לא כשאתה סבור אלא ארבע מאות שנה יגור בים הגדול ושמנים שנה במעלה עשן אצל בני קרח ושמנים שנה בפתחה של רומי ושארהשנים מחזר על כל מדינות גדולות עד עתקץ"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_48r_2#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_48r_2_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_48r_2"
   }
  ]
 },
