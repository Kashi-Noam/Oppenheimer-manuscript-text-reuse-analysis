 {
  "@id": "http://example.org/oppenheim128#unit_fol_134v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ר אלעזר בר שמעון אתמני אנגדא בטים מפיק עבורא חד זמן אתא לגביה בדמית חדסב אמ ליה אתקין לי בעירא אמ ליה מה אית גבך למטען אמ ליה חדא שחיק חפסאטי והדא גולטי ומרכות אמ ליה אתון חמיין להדין סבא דאנא טעין לי ומאזיל ליה לסופא דעלמא ואת אמ התקףן לי התקין לי בעירא ארכביה והוו מלקין טורין ומחיק ליה גלמן מעביר ליה חקלין דכובין וחכלין דדכדרין לקופא שרי מנאטל גרמיה ערוי אמ יליה סבא ג קליל וגירמך ואלא אתא מקלח לך אמ ליה בעי את"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_134v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_134v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_134v_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#verdict_direct",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
