 {
  "@id": "http://example.org/oppenheim128#unit_fol_152r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "מאהביך שכחוך אותך לא ידרושו כי מכת אויב הכיתיך באיוב בת כשדים שמו שלשה ראשים ובירושלם כת והעיר נתנה ביד הכשדים באיוב כת אש אלהים נפלה מזהשמים ובירומלם כתוב ממרום שלחאש בעצמותי וירדנה באיוב כתו ויקחלוחרש להתגרדבו ובירושלם כתוב איכה נחשבו לנבלי חרש באיוב כתיב וישבו אתילארץ ובירושלם כתוב ישבו לאירץ ידמי באיוב כתוב שק תפרתי עליגלדי ובירושלם כתוב העלו עפר על ראשם באוב כתוב חנוני חנוני אתם רעי ובירושלם כתוב אשר לא אתזככם חנינה באיוב כתוב כייד אלה טעה בי ובירושלם כתוב כי לקחה מיד יי כפלים בכל חטאתיה אמ ר יהושע בר נחמיה מה אם איוב שחטא בכפלים ניתא לו שכד בכפלים וכן ירושלם מקנחמת בכפלים שנ נחמו נחמו עמי"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_152r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_152r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_152r_1"
   }
  ]
 },
