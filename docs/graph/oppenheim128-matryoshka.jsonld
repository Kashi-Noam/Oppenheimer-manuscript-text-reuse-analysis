 {
  "@id": "http://example.org/oppenheim128#unit_fol_152v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ואיך תנחמוני הבל ותשובותיכם נשאר מעל אמ ר אבאבר כהנא נםייידבריכם צריכים מרוק ורבנן אמרי ואיך תנחמוני הבל דדריכם סותרין זהאת זה לעתיד אמ הקבה לנביאים לנחם את דושלם ילך הושע לנחמה אומר רת הקבה שלחני לנחמך אומרת לו מה בידך אהיה כטל לישראל אומרת לו אתה אמרת הכה אפרים שרשם יבשפרי בל יעשון והיום אתה אומ לי אהיה כטל אי איזה מהם נקגבל ילך אל לנחמה אמלו מה בידך היה ביום ההוא יטפו ההרים עסיס אומ לו אמש אמרת הקיצו שכורים ובכו איזה מהם נאמין ילך עמוס לוחמה אומרנ לו מה בידך בים ההוא אקים את סכת דוד הנוכלת אומ לו אמשאמרת נפלה ולא תוסיף קום אי זה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_152v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_152v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_152v_1"
   }
  ]
 },
