 {
  "@id": "http://example.org/oppenheim128#unit_fol_118r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אנו אוכלין וקריתי עליו ובנן רשעים החסר באברק אוכל לשובע ופשו זה חזקיהו מלך הודה שהיה קונה שתי אגודות של ירק וליטרא של בשר והיו מעלין לפניו בכל יום והיו ישראל מלין מליזין עליו ואומ זה מלך ומשוש את רצין ובן רמליתו אית מלכותא לרצין ולבן רמליהו ההד יען כי מאס העם הזה את מי השילוח התולכים לאט מהו לאט בר קפרא חזרנו על כל המקרא ולא מצינו מקום ששמו לאט אלא זה חזקיהו מלך יהודה שהיה מטהר את ישראל כמקוה שלמ סאה מנין לאט אמ להם הבה אכלים אתון בעיי שנ ולכן הנה יי מעלה עליכם את מי הנע הנהר העצומים והרבים ובטן דשעים תחסר זה מישע שנ ומישע מלך מואב היה נוקד מהו נוקד רועה ונאמ והשיב למלך ישראל מאה אלף כרים ומאה אלף אלים צמר מהו אלים צמר אמ ר אבא בר כהנא פרובטא דא צדיק אוכל לשובע נפשו אלו מלכי בית דוד ובטן רשעים תחסר אלו מלכי מזרח ר יודן ור הונא ר יודן אמ מאה צאן היה עולה לכל אחד"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_118r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_118r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_118r_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_73v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
