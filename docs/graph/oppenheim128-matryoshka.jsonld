 {
  "@id": "http://example.org/oppenheim128#dating_Yalkut_Shimoni_on_Torah",
  "@type": [
   "http://example.org/oppenheim128#DatingAssertion",
   "http://www.w3.org/2006/time#ProperInterval"
  ],
  "http://example.org/oppenheim128#confidence": [
   {
    "@id": "http://example.org/oppenheim128#conf_medium"
   }
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@value": "1200/1308"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_ebe4a5484e"
   },
   {
    "@id": "http://example.org/oppenheim128#source_c9c1ca295d"
   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_04"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-13 (לפני כ\"י אוקספורד משנת 1308)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Yalkut Shimoni', on Jewish Virtual Library: Dates it to the 13th century (Zunz's dating 'prevails'; Gaster's 14th-c. Spain and Aptowitzer's mid-12th c. not convincing); author Simeon ha-Darshan (Epstein), possibly of Frankfurt (Prinz); mentions an Oxford manuscript copied in 1308 and Azariah de' Rossi's manuscript written in 1310."
   },
   {
    "@value": "Wikipedia (English), 'Yalkut Shimoni' (based on the Jewish Encyclopedia): Author uncertain; Rapoport's 11th-century dating 'untenable'; Epstein inclines to agree with Zunz that the author flourished in the early 13th century; a manuscript known to Azariah dei Rossi existed in 1310."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "The 13th-century dating (Zunz, Epstein) prevails, but Rapoport put it in the 11th century, Aptowitzer in the mid-12th, and Gaster in 14th-century Spain; the author's identity (Simeon ha-Darshan vs. Simeon Kara) and his Frankfurt origin are also uncertain."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "מיוחס לר' שמעון הדרשן; לפי Prinz ומסורת יהודי פרנקפורט – מפרנקפורט; צונץ: דרום גרמניה"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Yalkut_Shimoni_on_Torah_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Yalkut_Shimoni_on_Torah_end"
   }
  ]
 },
