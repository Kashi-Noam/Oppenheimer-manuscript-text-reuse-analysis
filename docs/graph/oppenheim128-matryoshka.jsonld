  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tehillim"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_Tehillim"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמר יי התבוננו וקראו למקוננות ותבואילה ואל החכמות שלחו ותבאנה אמרו בשעה שהגלה נבוכד נצר הישע את ישראל לבבל לא הניחום הרודפים לשוב עד שהויעיי שרגיעו לנהרוה בכל שנ על נהרות בבר שם ישבנו גם בכינו ללמדך שהיו רודפים אותם בעל כרחם לקיים מה שנאמ קלים היו רודפינו כיון שהגיעו לפרת היה נבוכד נר הרשע יושב בספינה וכל גדול כשדים מימינו ומשמיכו וכל מיני זמר לפניהם שנ וכשדים באניות רנתם כיון שנשא עיניו אותו רשע וראה את שרי יהודה הולכים ערומים ושלשלאות בצוארם על שפת הנהר אמ מפני מה הכל הולכים בלי משוי אין לכם משא שתתנו עליכם מיד הביאו שקים ועשו אותם בחמת ומלאו אותם חול והניחו על צוא צואריהם וכפפו את קומתם לקיים מה שנ על צארנו נרדפ באותה שעה געו כלם בבניה עד שעלתה בכייתם במרום"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_191r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_191r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_191r_1"
   }
  ]
 },
