 {
  "@id": "http://example.org/oppenheim128#unit_fol_54r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אשת אביו וממנו את למד ערות אבות עד סוף כל הדורות ופרט בבהמה לפי שאינה קרובה אלא רחוקה ומן אחותו את למד קירוב בשר כמו אשת אח ומן חורבה חותנתו את למד קורבת אישות החלק החמשי ארור מכה רעהו ולוקח שחד ומשם את למד דיני קנסות החובל בחברו והריגה ומלשינות ושחד אפלו שוחד דברים זרת דרך ארץ בעה המקדש את האשה הרי זה אוסר עליו שבע עריות לו הן אמה ואם אמה ואם אביה בתה ובת בנה ובת בתה ואחותה בזמן שהיא קיימת וכלן שנאסרו על יו אין להן היתר לאיסורן חוץ מאחות אשתו שאינה אסורה אלא בחייה ול עוכם אינו כאסל את אשתו על אמה ועל בתה על אחותה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_54r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_54r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_54r_1"
   }
  ]
 },
