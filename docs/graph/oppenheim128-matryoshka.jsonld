 {
  "@id": "http://example.org/oppenheim128#unit_fol_186r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Ein_Yaakov_Glick_Edition"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Eichah_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "היה רבן גמליאל ור יהושע ור אלעזר בן נסריה ור עקיבא מהלכין בררך שמעו קול המונה של רומני ברחוק קכ מיל התחילו הם בוכים ד עקיבא משחק אמ להם ומפני מה אתם בוכים אמרו לו ומפני מה אתה משחק אמ להם ומפני מה אתם בוכים אמרו לו גוים שעמד עלינו בחטאתינו משתחוים לאלילים ומקטרים לעצבים והם יושבים בשלוה ובהשקט ואנו בית הרום רגלי אדננו נשרף ולא נבכה אמ להם לכך אני משיק ומה אם לעוברי רצונו כך לעושירצונו על אחת כמה ונמה שובפעם אחת היו עולין לירושלם כיון שהגיעו לצופים קרעו את בגדיהם כיח שעלו להר הבית ראו שועל שהיה יוצא מבית קדשי הקדשים התחילו הם בוכים והיא משאק אמרו לו מפני מה אתה משחק אמ להם ומפני מ אתם בוכים אמרו לו מקום שכתוב בו והזר הקרב יומת ועכשו שועלים הלכו בו ולא נבכה אמ להם ורכך אני משחק נית ואעידה לי עדים נאמנים את אוריה הכהן ואת זכריהו בן יבדכיהו וכי מה ענין אוריה אצל זכריה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_186r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_186r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_186r_1"
   }
  ]
 },
