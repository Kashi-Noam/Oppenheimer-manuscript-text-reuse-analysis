   }
  ],
  "http://purl.org/dc/terms/spatial": [
   {
    "@id": "http://example.org/oppenheim128#region_02"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-10–ה-11"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Midrash Samuel', on Jewish Virtual Library: 'Zunz's assumption that the work is to be dated no earlier than the 11th century appears probable'; 'overwhelming evidence … that it was edited in Palestine'."
   },
   {
    "@value": "Wikipedia (English), 'Midrash Shmuel (aggadah)' (cites Strack & Stemberger 1991): The compiler lived in the Land of Israel; Zunz put him in the first half of the 11th century, which Buber refuted; Strack & Stemberger argue for composition well before the 11th century with later revision."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Zunz (followed by EJ) dated it no earlier than the 11th century, but Buber refuted Zunz's arguments, and Strack & Stemberger (via English Wikipedia) hold that it was composed well before the 11th century and later revised, since Samuel b. Hofni and Nissim Gaon cite it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "נערך בארץ ישראל (מקורות, אמוראים ותנאים ארץ-ישראליים)"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Shmuel_begin"
   }
  ],
  "http://www.w3.org/2006/time#hasEnd": [
   {
    "@id": "http://example.org/oppenheim128#dating_Midrash_Shmuel_end"
   }
  ]
 },
