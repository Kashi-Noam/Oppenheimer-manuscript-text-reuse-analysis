 {
  "@id": "http://example.org/oppenheim128#unit_fol_49v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Otzar_Midrashim"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "כד שמע יואב לדוד דאמ כן תמה ואמ כלים אבא מרחם על בנוי טפי מאמהון והלא ם אמא רחמא עליהון סגי דהיא מצטייפא על הון בעבורה ועל מתברא והיא מרבייה להון בביתא והוא מר לן לא מר יאות איזיל ואחמי מה ברייתא דבריין ואידע אם מר קושטא עטר בכל תחום ישראל לחכה כלא כן מטא לחד אתר ואתאכסן גבחד גבר סד מכוכן דהוו ליה תרין עשר בנין וההוא גברא טריד כל יומא בעבידתיה בדברא ולעידן רמשא הוה הני מאגריה לחמא והוה זיין גרמיה ואנתתיה ובנוי בדוחקא ואענ דהוה סב ומסכן לא שביק לבנוי למיניל בעבידתיה אלא הוא טרח עליהון וזיין להון וכך הוה ינביד כל ליליא הוה פריס ללחמא אר בסר ביצועין והור יהיב לכל חד וחד פרוסתיה ולאנתיה פרוסתא יזדא והוא היה חתי לחדא כד חמא יואב שרי תמה אמ לית"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_49v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_49v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_49v_1"
   }
  ]
 },
