 {
  "@id": "http://example.org/oppenheim128#unit_fol_166v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ר חייא בברייתו של עולם צפה הקבה בית המקדש בנוי וחרב ובנוי שנ בראשית ברא אלהים הריבנוי והארץ היתה תהו ובהו הרי חרב ויאמר אלהים יהי אור הרי בנוי ומשוכלל לעתיד לבא אמ ר שמואל בר נחמז לפי שבעולם הזה מהלכין לאור החמה ביום ולאור הלבנה בלילה ומה טעם לא יהיה לך עוד השמש לאור יומם ולנוגה הירח לא יאיר לך ונאור מי הים הולכים לאורו של הקבה שנ והיה לך יי ראור עולם ואלהיך לתפארתך אמ ר חנינא חלונות היו בביה המקדש ובהם היתה אורה יוצאה לעולם מה טעם ויעש לבית חלוני שקופים אטומים שקופות היו ואטומות שהיו קטנות מבפנים ורחבות מבחוץ כדי להוציא אורה לעולם אמ ר לוי בנוהג שבעולם אדם בונה טרקלין חלונותיו מקטינוה מבחוץ ומרחיבו מבפנים כדי להכפס אורה לתוכה אבל חלונות שר בית המקדש לא כך היו אלא מקטינות מבפנים ומרחיבו מבחוץ כדי שיצא מהן אורה לעולם אמר ברכיה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_166v_1#u1"
   }
  ],
