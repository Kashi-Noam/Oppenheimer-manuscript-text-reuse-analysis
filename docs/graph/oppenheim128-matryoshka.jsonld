 {
  "@id": "http://example.org/oppenheim128#unit_fol_184v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "כל אחד ואחד מהם במקומו מה עשה נטל אצבעו של בנו הגדול והניחה בעינו אמ אצבע שלא הנחתי לגרוף אותה ר טפה תנקראת עינו ועוד מעשה באשה אחת שהיולהג בנים הלכו שני בניה למלחמה ונטלה את בכה שהיא מניקה ובשלתו בקדרה כשהן אוכלין הכירו את ידי אחיהן כיון שראו כך עלו לגג והפילו עצמן לארץ ומתו עליהם מקונן ירמיה טובים היו חללי חרב מחללי רעב ואף ירושלם צועקת וארמרת אללי לי כי הייתי כאספיקיץ הקוצר מכיח ספיחים והבוצר מניח עוכלות אבל אני רא נשתיר כי כלום ונמסרתי ביד נבוכד לצר הרשע כרחל ביד ארי וכגדי ביד הטבח"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_184v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_184v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_184v_1"
   }
  ]
 },
