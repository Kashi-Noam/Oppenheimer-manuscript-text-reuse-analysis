 {
  "@id": "http://example.org/oppenheim128#unit_fol_62v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אדם כוסו בבת אחת ואם שתה הרי זה גרגרן ורעבתן וכמה ישהא וישתה שנים מדרך ארץ שלשלה מגסי הרוח ולא יאכל אדם שום ובצל מראשו אלא מעליו ואם אכל הרי זה רעבתן וגרגרן ולא ישתה שתיכוסות ויברך ברנת המזון מפני שנראה כגרגרן סליק פרקא שנים שהיו יושבין על שלחן אחד הגדול שבהן שולח יד תחלה ואחרכך הקטן ואם שרח הרי זה גרגרן ומעשה בר עקיבא שעשה סעודה לתלמידיו הביא לפניהם שני תבשילין אחד נא ואחד מבושל בתחלה הביא לפניהם נא הפקח שבהם אחז את הקלח בידו אחת ולש ותלשו בידו אחת לא בא אחריו משך ידו ממנו ואכל פתי ריקן הטפש שבהם אחח את הקלח בידו אחת ונשכו בשניו אמ לו ר עקיבא לאכך כנל אלא הנח עקבך עליו בתוך הקערה ואחר כך תביי לפניהם מרושל אכלו ושתו ונסתפקו אחרכך אמ להם בני לא עשיתי לכם כל כך אלא לבדוהק אתכם אם יש בידכם דרך ארץ אם לאו לא יאכל אדם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_62v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_62v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
