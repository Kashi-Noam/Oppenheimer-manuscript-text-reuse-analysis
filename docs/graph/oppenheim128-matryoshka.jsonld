 {
  "@id": "http://example.org/oppenheim128#unit_fol_140r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "והיה ירמיהו רואה כת של בחורים שלולים בקולרות של ברזל והולך ומכניס אתיה ביניהם וחוזר אחרים ועושהכן אמ ליה נבוזר אדן חדא מן תלת מלין אית בך אונביא של שקר אתה או מבעיט בייסורון את או שופך ודמים את או נביא של שקראתה את הוא דהא כמה שנין את קאים ומתנבא על הרא קרתא ועל הדא זויתא רתחרב ולדון דדיני חרבא באש לך אומבעיט בייסורין את אנא לית אנא בעי מעיק לך ולית ייסורין חשובין עלך כלום או שופך דמים את דאי מלכא שמע מה הא מתעביד בך ואנא לית אנא עביד לך כלום הוא משלח ומרים ראשי אלא אם טוב בעיניך לבא אתי בבל בא ועודנו לא ישוב עד שגלה לו הקבה ההד הדבר אשר היה אל ירמיהו מאת יי אחר שלוח אותו נבוזר אדן רב טבחים הרמה בקחתו אותו והוא אסור"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_140r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_140r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_140r_1"
   }
  ]
 },
