 {
  "@id": "http://example.org/oppenheim128#unit_fol_161r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "הקבה רבונו של עולם לא אתה הוא שנישית כי הלא אתה הוא שכתבת לנו בתורה לא תתאתן בם לו נסבנו מנהון או אנסיבנון להון הדין מנהון הוה מחמי בריה או ברתיה קיים על תרעיה ולא הוה מקבלה יתיה הוי כי אתה עשית הבאת יום קראת ויהיו כמוני כמוני בצרה ולא כמוני ברוחה אין מנחם לי אמ הקבה אנכי אנכי הוא מנחמכם י רקםם אב על בנים רחם יי על יראיו כאיזה אב תני רחייא כרחמן שבאבות ואיזהו רחמן שבאבות ר עזריה אמ בשם ר אחא זה אברהם אבינו אתה מוצא קודם שלא הביא הקבה מבול על הכדומיים אמ אברהם אבינו לפני קבה רבונו של עולם נשבעת שאין אתה מביא מבול לעולם ומה תעשה מן השבועה שנאמ אשר נשבעתי מעבר מינח וכו אם מבול של אש אתה מביא מה אתה מערים על השבועה חלילה לך מעשות כדבר הזה להמית צדיק עם רשע אמ ר לוי השופט כל הארץ לא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_161r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_161r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_161r_1"
   }
  ]
 },
