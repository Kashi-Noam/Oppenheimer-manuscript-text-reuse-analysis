  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereshit_Rabbati"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "והעביר בניו בתוכו שוב לא ראיתיו הולכין אצל סיני אומרין לו נראה לך הקבה שנאמ יי מסיני בא אמ להם מיום שנגלה עלי ונתן תורה כיבניו והיה הוא חתן ומשה שושבין ותורה כלה שוב לא ראיתיו הולכין אצל ציון נראה לך הקבה שנאמ כי בחר יי בציון אומר להם מיום שחילק שבי ממני והחריב ביתו ושרף היכלו שוב לא ראיתיו פוגע בהם ישעיה אומר להם ישעיה את מי אתם מבקשים אומרין לו הקבה אנו מבקשין אומר להם עכשו יבא ויצא מאדום ההד מי זהבא מאדום חמוץ הקבה יפרע מהם על שגזלו ממונם של ישראל ואין חמוץ אלא לשון גזל כד מכף מעול וחומץ מהו שאמ דכת חמוץ כביכול כל הגוזל ישראל כאלו גוזל את השכינה שכן כת עמו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_31r_1#u1"
   }
  ],
