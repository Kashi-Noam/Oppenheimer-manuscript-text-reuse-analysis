 {
  "@id": "http://example.org/oppenheim128#unit_fol_185v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "אמרה לו אמו תנהו לי ואנשקהו קודם הריגת לחשר לה באודניה ואתרה ליה זיל אימא כליה לאברהם אבוך אלת ווחדעיתך עלי אתה עקדת בן אחד וכיא התתי ואם עקדתי שבעה ונהרגו לחדושת השם אפקוה וקטכה זיהיא ענתה לגג יהפילה עצמה עליהם ומנחה יבתה בזת קול ואמריה לה אם תבצים שמסה תנו רב עשה בר יהושע בז חנניה שרו ילכדך גדול של נוינו איי ט תינק אחד ישיבית האסורים יניה עינים וטור קווצתיו םדוחותלותל תלים הלך ופמד על פתח ביתהאכו יימ מי נתן למשסה יעקב וישראל לבוזזים וענה אורבו תינוק ואמ הלא יי זוחטאנו לו אמ מובטח אני בזה שיוקה הוראות בישראל העבודה שאיני זזמכאן עד שאפדנו בכל"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_185v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_185v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_185v_1"
   }
  ]
 },
