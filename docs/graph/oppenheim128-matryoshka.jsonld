 {
  "@id": "http://example.org/oppenheim128#unit_fol_36v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereishit_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Bereishit_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "יותר ממשאוי אמ ליה לא תיהוי אמרכן אלא הוי אמר ברוך האל הנאמן כד הוה צערא קשה עלוי יתר מזצרכה הוה סליק ר חנינא ואמ עלוי מילה והוה נייח בתר יומין איבאש ר חנינא סלקר אנ יוחנין מבקדא יתיה אמ ליה מה אית לך אמ לו מה קשים הייסורין אמ לו ומה הוית אמר עלאי אמ ליה כד הוינא לברא הוינא הוינא עריב אוחרנין וכדון דאנא לגאו אנא בעי מאן דיערבני אמ לו אין שרביטו של הקבה ממשמש ובא אלא בבני אדם שליבן כך כשושן הוי הרועה בשושנים אמ ר אלעזר לבעל הבית שהי לו שתי פרות אחת כחה יפה ואחת כחה רע על אי זהמהם הואמטריח על זו שכחה יפה כך אין הקבה מנסה את הרשעים שאיזן ירונין לטמוד שנ והרשעים כים נגרש ואת מי הוא מנסה את הצדיקים שנ יי צדיק יבחן וכן הוא אומ והאלהים נסה את אברהם ויהי אחר הדברים האלה ותשא אשת אדני את עיניה על מי"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_36v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_36v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_36v_1"
   }
  ]
 },
