  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ההולך אחרי רבו אינו רשאי ליפטר מאחריו עד שיטול ממנו רשות היו שניהם תלמידים שקולים זה כזה בעל הבית נכנס תחלה ואחרכך אורח וכשהן יוצאין אורח יוצא תחלה ובעל הבית יוצא אחריו והנמ והנפטר מרבו בין שהוא גדול מרבו ובין שרבו גדול ממנו אומר לו הריני נפטר ברשותך סליק פרץא לעולם לא יפטר אדם מאצל חבכו אלא אם כן נוטל הימנו רשות וילמד כל אדם דרך ארץ מן המקום שאמ לו לאברהם כלום אברהם אנם צריך לך אמ לפניו רבונו שלעולם הן"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_60r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_60r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_60r_1"
   }
  ]
 },
