 {
  "@id": "http://example.org/oppenheim128#unit_fol_145v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "וכן איכה ישבה בדד ר קפרא פתח ויקרא יי אלהים צבאות ביום ההוא לבכי ולמספד ולקרחה ולחגיר שק אמ הקבה למלאכים מלך בשר גדם כשהוא אבל מה הוא עושה אמרו לוי תולה לו שק על כיתחו אמ להם אף אני עושה כן שנ אלביש שמים קדרו ושק אשים כסותם ועוד שאל להם מלך בשר גדם אבל מה הוא עושה אמ לו מכבה את הפנסין אמ להם אף אני אעשה כן שנ שמש וירח קדרו וכוכבים אספו נגהם"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_145v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_145v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_145v_1"
   }
  ]
 },
