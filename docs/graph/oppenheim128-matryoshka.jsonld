 {
  "@id": "http://example.org/oppenheim128#unit_fol_164r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "עליסה פצקה רנה צהלה חדוה הריעה ואית דמפקין הריעה ומעלין דיצה שנ ולפניו תדוץ דאבה כ רבים בני שוממה אמר אבא בר כהנא כתוב ומדברך נאוה אפי מדבר נאוה וחייבין על מחיצתו והוא חרב כשם שחייבין על מחיצתו והוא בנדי אמ ר ליי אמ הקבה בבניה העמידה לי רשעים כגון אחז מנשה אמין בחורבנה העמיד לי צדיקים כגון דניל וחבורתו מרדכי וחבורתי ר אתא בשם ר יוחנן אמ אמ הקבה הרבה צדיקים העמידה לי בחורבנה מצדיקים שהעמידה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_164r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_164r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_164r_1"
   }
  ]
 },
