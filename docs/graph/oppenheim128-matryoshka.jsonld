 {
  "@id": "http://example.org/oppenheim128#unit_fol_147r_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "קולו של יעקב מצכבף בבתי כנסחת ובבתי מדרשות הידים ידי עשו שמואל אמ וצבא תנתן על התמיד בפשע בפשעה שלתורה אימתי כשישרל משלכין דברי תורה לארץ מלכות הרשעה הזאת גוזרת ומצלחת ומאי טעמיה ותשלך אמת ארצה ואין אמת אלא דברי תורה כדא אמת קנה ואל תמכור אמ ר יודה בר סימון זנח ישראל טוב אויב ירדפו ואין טוב אלא דברי תורה כדא כי לקחטוב נתתי לכם וכן הוא או לכן כאכול קש לשון אש וכ יש קש אוכלת אש אלא דרכה של אב להיות אוכלת קש ואתה אומ כאכול קשל שון אש אלא קש זו ביתו של עשו שהוא נמשל בקש דכת ובית עשו לקש"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_147r_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_147r_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_147r_1"
   }
  ]
 },
