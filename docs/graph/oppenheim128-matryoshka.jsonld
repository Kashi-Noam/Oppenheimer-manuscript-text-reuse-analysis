 {
  "@id": "http://example.org/oppenheim128#unit_fol_192v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Yalkut_Shimoni_on_Nach"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "משה הלך אבל מלאכי השרת שהיה מכיר משעת מתז תורה אמ להם שמא אתם יודעים למה אני מתבקש לפני הקבה אמרו לו וכי אין אתה יודע שבית המקדש חרב וישראל גלו מעל ואתה מתבקש לבכות ולספוד מיד קרע משה את בגדיו והניח ידו על ראשו והיה הולך ובוכה עד שהגיע אצל אבות העולם וכיון שראוהו אברהם ועגקב אמרו לו בן עמרם מה היה לך אמ להם וכי אין אתם יודעים שבית המקדש חרב וישראל גלו ואנו מתבקשים לספוד ולבכות באותה שעה אף הם קרעו בגדיהם והניחו ידיהם על ראשיהם והלכו הלוך ובכו עדשהגיעו לשערי ירושלם מיד קרא הקבה לבכי ולמספד ואלמלי מקרא כתו אי איפשר לאמרו שנאמ ויררא יי אלהים צבאות ביום ההוא לבכי ולמספד והיו הודפים משער זה לשער זה ומספידים וביכים כאדם שמתו מוטל לפניו באותה שעה פתח אברהם ואמ רבונו של עולם גלוי וידוע לפני כסא כבודך שבן קשנה הייתי כשנתת לי אתיצחק בנ וכשעמד על פרקו אמרת לי"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_192v_1#u1"
   }
  ],
