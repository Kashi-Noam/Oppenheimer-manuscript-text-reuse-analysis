  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "את זכר עמלק שנ תמחה את זכר עמלק מתחת השמים ר יהושע בן לוי בשם ר אלכסנדרי אמ כתו אחד או תמחה את זכר עמלק וכת אחר אומ כי מחה אמחה את זכר עמלק הא כאיזה צד יתקיימו שני כתובים הללו עד שלא פשטה ידו בכים תמחה את זכר עמ עמלק ומשפשט ידו בכיס כי מחה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
