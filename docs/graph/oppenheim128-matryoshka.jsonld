    "@value": "0400/0550"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "http://example.org/oppenheim128#source_f53bd2cc9a"
   },
   {
    "@id": "http://example.org/oppenheim128#source_b5de5de300"
