 {
  "@id": "http://example.org/oppenheim128#unit_fol_179r_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Jerusalem_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ה דברים ארעו את אבותינו בי בתמוז וה בט באב ביז בתמוז נשתברו הלוחות ובטל התמיד והובקעה העים ושרף אפוסטומוס את התורה והועמד צלם בהיכל בט באב נגזר על אבותינו שלא יכנסו לארץ וחרב הבית בראשונה ובשניה ונלכדה ביתר ונחרשה העיר חרב הבית בראשונה מנלא דכת ותשא כל העדה ויתיו את קולרי ואמי ואמ רבא ואיתימא ר יוחנן אותו הלילה ט באב היה אמ להם הקבה לישראל אתם בכיתם בכיה של חנם אני אקבע לכם בכיה לדורות חרב הבית בראשוכה מנא לן שנ בחדש החמשי בתשעה לחדש היא שנת תשע עשרה שנה וכת וישרף את בית יי ואת בית המלך וכת בחמשי בשבעה לחדש אי איפשר לומ שבעה שכבר נאמר תשעה הא כיצר בא בחדש נכנסו גוים להיכל ואכרו ושתו ויקלקלו שביעי ושמיני ותשיעי סמוך לחשיכה הציתו בו את האור והיה"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_179r_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_179r_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_179r_1"
   }
  ]
 },
