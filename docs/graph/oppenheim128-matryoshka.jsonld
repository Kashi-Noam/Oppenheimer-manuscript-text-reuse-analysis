  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "he",
    "@value": "המאה ה-13 (לפני כ\"י אוקספורד משנת 1308)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@value": "Encyclopaedia Judaica (2007), 'Yalkut Shimoni', on Jewish Virtual Library: The whole Yalkut (Torah and Nach) is dated to the 13th century; Oxford manuscript copied 1308; author Simeon ha-Darshan, possibly of Frankfurt."
   },
   {
    "@value": "Wikipedia (English), 'Yalkut Shimoni': Early 13th century per Zunz/Epstein; manuscript known to Azariah dei Rossi existed in 1310."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Same as Yalkut Shimoni on Torah: 13th century is the majority view (Zunz, Epstein), with outlier datings from the 11th to the 14th century; no source seen dates the Nach part separately."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@value": "אותו חיבור כמו ילקוט שמעוני על התורה; מיוחס לר' שמעון הדרשן (פרנקפורט?)"
   }
  ],
  "http://www.w3.org/2006/time#hasBeginning": [
   {
    "@id": "http://example.org/oppenheim128#dating_Yalkut_Shimoni_on_Nach_begin"
   }
  ],
