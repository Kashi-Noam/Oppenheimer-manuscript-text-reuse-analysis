 {
  "@id": "http://example.org/oppenheim128#unit_fol_58v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "בשעת פטירתי של ר אלעזר בן עזריה נכנסו תלמידין לבקרו וישבו לפנו אמרו לו רבינו למדנו דבר אחד בלבד אמ להם בני מה אלמד אתכם צאו והזהרו כל אחד בכבוד חברו ובשעה שאתה עומדים להתפלל היו יודעין לפני מי אתם עימדון ומתפללין ובשביל דבר זה תכנסו לחיי העולם הבא חמשה דברים למדנו מר אלעזר בשעת מיתתו ושמחנו בהן שמחה גדולה יותר ממה ששמחנו בחייו ואלו הן הנדור והאימום והקמיע ותפלין וכסת ענלה שמקבל ין טומאה ומטבילין אותן במה שהן צאו והזהיו בהן שהלכות גדוליתהן שנאמרו לו למשה בסיני"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_58v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_58v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_58v_1"
   }
  ]
 },
