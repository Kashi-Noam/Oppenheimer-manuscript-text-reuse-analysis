 {
  "@id": "http://example.org/oppenheim128#unit_fol_58v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Derekh_Eretz_Rabbah"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ומי הוא דיינה ידע שאין דיינו בשר ודם אלא אדון כל המעשים ברוך הוא שאין לפניו לא עולהד ולא ישכחה לא משואכנים ולא מקח שוחד ומה עתיד להיות עפר רמה ותולעה שנ אף כי אנו רמה ובין אדם תולעה ר שמעון אומ רמה בחייו ותולעה במותו רמה בחייו אלו הכנים ותולעהה במיתו זהו שמרחיש במותו ר אליעזר בן יעה אומ אדם צאה ומשובח ומוציא דבר מגונה מעיו משל למה הדבר דומה לטרקלין גדולה וביב של בורסקי קבוע בתונה כך אדם נאה ומשיבח ומוציא דבר מצונה מפיו אם מוציא ממעיו פוליטון או אנה אפרסמון או אחד מכל מינ בשמים עלאחת כמה וכמד שהיה מתגאה על"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_58v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_58v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_58v_1"
   }
  ]
 },
