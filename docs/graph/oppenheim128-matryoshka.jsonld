 {
  "@id": "http://example.org/oppenheim128#unit_fol_86v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   },
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Pesikta_DRav_Kahanna"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "נתן להן הריובשיהיו קיימת לעולם ר יודן בשם שמואל ברכאמן ור הוניא בשם בר קפיא אמ עד היכן סיו קימות עד בגלגל שורים זבחו והיכן הקריבום אמר אבא בר כהנא בנוב הקריבום ר אבהו איד בגבעון הקריבום ר חמא בר חנינא אמ בב ת עולמי הקיבום אמ ר לוי טעמיה דר חמא בר חנינא שנ ויזבח שלמה את זבח השלמים אשר זבח ליי דקר עשרים ושנים אלף יתני בשם ר מאיר עד עכשו הזקיימות ולא החמו ולא הזקייא ולא התרפו והלא דברים קו מה אם העגלות שניידקו במלא ים ביהל מיעד ניתנ להם הוייה שיהיו קיימות לעולם ין בה בה על אחת כמה וכמה שנ בהם ואתם צכם ויים כלכם היום רי שא את ראשכני א ז שועתי לו"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_86v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_86v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_86v_1"
   }
  ]
 },
