 {
  "@id": "http://example.org/oppenheim128#unit_fol_4v_1_u2",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Midrash_HaGadol"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "ללמד על מתזתורה ונמצא למבממנו כיוצא בו אתה אומ קולה כנמש ילך כשם שמהלך הולו שלנחש מהלך קולה שלמצרים מלמד שכשאמ הקבה לנחש על גחולך תלך ידדג מלאכים בקצצו ידיו ורגליו והיה קולו הולך מסלף העולם ועד סופו בא נחש ללמד על מפלתה שלמצרים ונמצא למד ממנה מכלל שאחריו מעשה והוא פרטו של ראשון כיצב ויברא אלהים אתהאדם בצלמו הרי זהכלל ואחר כך פירט את המעשה ויצר יי אלהים ויפל יי אלהים תרדמה גו ויבן יי אלהים גו והשומע סבור שהוא מעשה אחר ואינו אלא פרטו שלראשון"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_4v_1#u2"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_4v_1_u2_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_4v_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_52v_1_u2_selector",
  "@type": [
   "http://example.org/oppenheim128#TokenPositionSelector"
  ],
  "http://www.w3.org/ns/oa#end": [
   {
