 {
  "@id": "http://example.org/oppenheim128#unit_fol_203v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Babylonian_Talmud"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "שהמדו ישראל על הים אמרו כשם שאלו עולים מצד אחד כך מצריים עולים מצד אחר ואינם מתים מיד אמ הקבה לשר של ים שיכנא אותם ליבשה בעוד שהן חיים ויראו ישראל ויאמינו בנ שהם מתים אמ הים לפני הקבה רבר של עו כלום יש אדון נוכן מתנה לעבדו ואחרכך נוטלה ממנו ולאעוד אלא שאני נל חמתי עם משריים ועכשו יבא עופות ויאכלום אמ לו הקבה אני אתזלך בשבילם אחד ומחצה בהם אמלפניו רבו של עו יש עבד שתובע אתרבו אמ לו נחל קישון יהא ערב מיד פלט אותם הים ליבשה ובאין ישראל ורואין אותם כשהם חיים והיו מכירין כל אחד ואחד את שונאו ואחר כך היו מתים שנוירא ישראל את מצרים מת על שפת הים מיד הושיען הקבה מידם שנ ויושע יי ביום ההוא וכ והאמינו ביי ובמשה שנ ויאמינו ביי ובמשה עביו יתברך שמי שלמלך מלכי רמלכים הקבה שהוא ראשק ראשון ושהוא אחרון ומבלעדיו אין אלהים כדכת אני"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_203v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_203v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_203v_1"
   }
  ]
 },
 {
  "@id": "http://example.org/oppenheim128#unit_fol_51v_1_u1",
  "@type": [
   "http://example.org/oppenheim128#TextUnit"
  ],
  "http://example.org/oppenheim128#closestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Gerim"
   }
  ],
  "http://example.org/oppenheim128#earliestWitness": [
   {
    "@id": "http://example.org/oppenheim128#work_Tractate_Gerim"
   }
  ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
   {
    "@language": "he",
    "@value": "חביבה ארץ ישראל שהיא מכשרת את הגרים האומר בארץ שראל גר אני מקבלין אותו מיד ובחוצה לארץ אין מקגלין אותו אלא אם כן היו עידיו עמו חביבה ארץ ישראל שהיא מכפרת את העונות ואת הפשעים שנאמ ובל יאמר שכן חליתי העם היושבים בה נשוא עון ונן אתה מוצא כארבעה כתים העומדים לפני המקום שנ זה יאמר ליי אנני וזה יקרא בשם יעקב וזה יכתוב ידו ליי ובשם ישראל יכנה זה יאמר ליי אני הוא כלו כלו למקום ולא נתערב בו שום חטא וזה יקרא בשם יעקב אלו גיריהצדק וזה יכתיב ליי אלו בעלי תשובה ובשם ישראל יכנה אלו יראישמים סליקא לה מסכת גרים תל מסכת כותיים בעה דרכי כותיים פעמים כגוים פעמים כישראל ורובי כישראל אין מביאין מהן לא קני זבות ולא קני יולדות לא חטאות ולא אשמות אין מקנין אותן במחובר לקרקע ואין מוכרין להם צמר לגזוז ולא תבואה לקצור ולא"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@value": "fol_51v_1#u1"
   }
  ],
  "http://www.w3.org/ns/oa#hasSelector": [
   {
    "@id": "http://example.org/oppenheim128#unit_fol_51v_1_u1_selector"
   }
  ],
  "http://www.w3.org/ns/oa#hasSource": [
   {
    "@id": "http://example.org/oppenheim128#passage_fol_51v_1"
   }
  ]
 },
